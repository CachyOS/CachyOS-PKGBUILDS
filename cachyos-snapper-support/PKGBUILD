# Maintainer: Nekoh

pkgname=cachyos-snapper-support
pkgver=1.0.3
pkgrel=1
pkgdesc='CachyOS package that handles snapper configs.'
arch=(any)
url='https://github.com/CachyOS/CachyOS-PKGBUILDS/cachyos-snapper-support'
license=(GPL-3.0-or-later)
depends=(snapper snap-pac polkit btrfs-progs arch-install-scripts)
optdepends=('kdialog: dialogs for restoring the fresh installation on KDE'
            'zenity: dialogs for restoring the fresh installation on other desktops')
makedepends=(git)
conflicts=(timeshift)
source=('snapper-template-root-cachyos'
        'cachyos-restore-installation'
        'cachyos-restore-installation-finish'
        'cachyos-restore-installation-finish.service'
        'cachyos-restore-installation-ui'
        'cachyos-restore-installation.desktop'
        'org.cachyos.restore-installation.policy')
sha512sums=('44b2027a7e772fbe5f499d1a387d68ec873747774b89b0dfd0967a9bb5b4991c917e2be341da123b7c40c712c15dc8e02f2172a83155ec40ed866e8ae4e0027a'
            '7fefb951030ec3fcb2cd5fa34caa6089188481d8d9395cb9a38643366f8473eb8bbc07a62cfaa046316f5c931161f50468b9e08c3a63b4bb87cd63e4781e141a'
            '5787a17fd03bd6279da42c95de4be6eacc64ba64695a7ecd65e56755fa639824c9976aec3c0c7857d493a1984638dba6a7f3d2dcbe32a7f5a0707830c79537fc'
            'ecf6aa4bc073a5ea756e056ae2265b422760e161c529d63aeb8de253a623165904301247d012d1de4d99bb4b78d68ab01da76b82ae1a1f11b2cabbc4eca1c408'
            '21e61a379e9d14aa96c49ecdc941c50a2fb43042500267780edc1989aaf6df5e38b4650732522d5b477c0cd6ec4e6caf33021e8ffe4421fe33e538b67285d59d'
            'ef4cf9dc5a3791503a0ae8f469015d81354f2f88959e9ef9d952b710f5092a77870f3730d82f338cdaa729fafefbc110795c3b51e8b70042538e83a1e18359d0'
            '3cfa67a5490c4e115d762239681afc42e76bb2bc9f2c8de8e7936596c87f7e45b311b5477e98670b417f02f57e22b63ed7f031dd65d3f4053cedc81bed1d4942')
install="$pkgname".install

package() {
	install -Dm644 snapper-template-root-cachyos "$pkgdir/etc/snapper/config-templates/cachyos-root"
	install -Dm755 cachyos-restore-installation "$pkgdir/usr/lib/cachyos/restore-installation"
	# Copied into the restored system by restore-installation, not enabled here.
	install -Dm644 cachyos-restore-installation-finish "$pkgdir/usr/lib/cachyos/restore-installation-finish"
	install -Dm644 cachyos-restore-installation-finish.service "$pkgdir/usr/lib/cachyos/cachyos-restore-installation-finish.service"
	install -Dm755 cachyos-restore-installation-ui "$pkgdir/usr/bin/cachyos-restore-installation"
	install -Dm644 cachyos-restore-installation.desktop "$pkgdir/usr/share/applications/cachyos-restore-installation.desktop"
	install -Dm644 org.cachyos.restore-installation.policy "$pkgdir/usr/share/polkit-1/actions/org.cachyos.restore-installation.policy"
}
