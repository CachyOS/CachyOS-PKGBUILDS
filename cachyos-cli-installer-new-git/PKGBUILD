# Maintainer: Vladislav Nepogodin <nepogodin.vlad@gmail.com>

pkgbase=cachyos-cli-installer-new-git
pkgname=(cachyos-cli-installer-new-git cachyos-installer-libs-git)
_pkgname=New-Cli-Installer
pkgver=0.11.0.r103.g32bfd03
pkgrel=1
pkgdesc='New CLI installer for CachyOS'
arch=('x86_64')
license=(GPL-3.0-or-later)
url="https://github.com/cachyos/new-cli-installer"
makedepends=('cmake' 'ninja' 'git' 'lld' 'clang' 'llvm' 'qt6-tools'
             'curl' 'openssl' 'fmt' 'qt6-base' 'qt6-declarative')
source=("${pkgbase}::git+$url.git#branch=feat/qml-gui")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgbase}"
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "${srcdir}/${pkgbase}"

  CFLAGS=${CFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS}
  CXXFLAGS=${CXXFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS}

  # we are building with llvm stack here
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  cmake -S . -Bbuild \
        -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DENABLE_DEVENV=OFF \
        -DBUILD_GUI=ON \
        -DGUCC_BUILD_TOOLS=ON \
        -DCOS_INSTALL_DEVEL=ON
  cmake --build build

  # both packages are split out of one staged install
  rm -rf "${srcdir}/stage"
  DESTDIR="${srcdir}/stage" cmake --install build
}

package_cachyos-installer-libs-git() {
  pkgdesc='CachyOS installer libraries'
  depends=('curl' 'libcurl.so' 'openssl' 'libssl.so' 'fmt' 'libfmt.so'
           'gawk' 'chwd' 'cachyos-rate-mirrors' 'coreutils' 'util-linux' 'gptfdisk' 'cryptsetup')
  provides=('cachyos-installer-libs' 'libgucc.so' 'libcachyos-installer-lib.so')
  conflicts=('cachyos-installer-libs')

  install -d "${pkgdir}/usr/lib"
  mv "${srcdir}"/stage/usr/lib/lib{gucc,cachyos-installer-lib}.so* "${pkgdir}/usr/lib/"
  mv "${srcdir}/stage/usr/lib/cmake" "${pkgdir}/usr/lib/"
  mv "${srcdir}/stage/usr/include" "${pkgdir}/usr/"
}

package_cachyos-cli-installer-new-git() {
  depends=('cachyos-installer-libs-git' 'fzf'
           'qt6-imageformats' 'qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland')
  provides=('cachyos-cli-installer-new')
  conflicts=('cachyos-cli-installer-new')

  install -d "${pkgdir}/usr"
  mv "${srcdir}/stage/usr/bin" "${pkgdir}/usr/"
  install -Dm644 "${srcdir}/${pkgbase}/net-profiles.toml" "${pkgdir}/var/lib/cachyos-installer/net-profiles.toml"
}

