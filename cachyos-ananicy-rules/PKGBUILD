pkgname=cachyos-ananicy-rules
_gitname=ananicy-rules
pkgver=1.1.49
pkgrel=1
epoch=1
pkgdesc='CachyOS - ananicy-rules'
arch=('any')
url='https://github.com/CachyOS/ananicy-rules'
license=(GPL-3.0-or-later)
makedepends=('git')
groups=(cachyos)
source=("${_gitname}::git+$url.git#tag=${pkgver}")
sha256sums=('d9663994b9f7d6fd7f688d1755697eacff74be1d4971dfefd3b6d4f53a5be415')
replaces=(ananicy-rules-git)
provides=(ananicy-rules-git)
conflicts=(ananicy-rules-git)

prepare() {
  cd "${_gitname}"
  rm -f README.md
}

package() {
  cd "${_gitname}"
  install -d "$pkgdir/etc/ananicy.d"
  cp -rf "$srcdir/$_gitname"/* "$pkgdir/etc/ananicy.d"
  rm -f "$pkgdir/etc/ananicy.d"/{sort-games.sh,ananicy-cgroups.schema.json,ananicy.schema.json,lint.py,Makefile}
}

