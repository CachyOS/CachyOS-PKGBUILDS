+{
+  MetaCrtcKms *crtc_kms = META_CRTC_KMS (onscreen_native->crtc);
+  MetaKmsCrtc *kms_crtc = meta_crtc_kms_get_kms_crtc (crtc_kms);
+  MetaKmsDevice *kms_device = meta_kms_crtc_get_device (kms_crtc);
+  MetaRenderer *renderer =
+    META_RENDERER (onscreen_native->renderer_native);
+  MetaBackend *backend = meta_renderer_get_backend (renderer);
+
+  if (onscreen_native->is_tearing_allowed &&
+      meta_kms_device_supports_async_page_flip (kms_device))
+    {
+      /* Only toggle cursor inhibition if state actually changes */
+      if (tearing_requested && !onscreen_native->hw_cursor_inhibited)
+        {
+          meta_backend_inhibit_hw_cursor (backend);
+          onscreen_native->hw_cursor_inhibited = TRUE;
+        }
+      else if (!tearing_requested && onscreen_native->hw_cursor_inhibited)
+        {
+          meta_backend_uninhibit_hw_cursor (backend);
+          onscreen_native->hw_cursor_inhibited = FALSE;
+        }
