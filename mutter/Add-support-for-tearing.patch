From 4800f81622f2a6c4ddf43d5522296e7e3dec6e3b Mon Sep 17 00:00:00 2001
From: Sultech <6282-Sultech@users.noreply.gitlab.gnome.org>
Date: Wed, 4 Feb 2026 00:00:00 +0000
Subject: [PATCH 07/11] Add unlocked frame clock mode for tearing support

Adds CLUTTER_FRAME_CLOCK_MODE_UNLOCKED which provides true unlocked
frame rate for tearing/async presentation by presenting immediately
without timing calculations.

Signed-off-by: Vasiliy Stelmachenok <ventureo@cachyos.org>
---
 clutter/clutter/clutter-frame-clock.c      | 28 ++++++++++++++++++++++
 clutter/clutter/clutter-frame-clock.h      |  1 +
 src/backends/native/meta-onscreen-native.c | 10 ++++----
 3 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/clutter/clutter/clutter-frame-clock.c b/clutter/clutter/clutter-frame-clock.c
index d00c414712..50dc66f5ba 100644
--- a/clutter/clutter/clutter-frame-clock.c
+++ b/clutter/clutter/clutter-frame-clock.c
@@ -991,6 +991,7 @@ maybe_want_triple_buffering (ClutterFrameClock *frame_clock)
     {
     case CLUTTER_FRAME_CLOCK_MODE_FIXED:
     case CLUTTER_FRAME_CLOCK_MODE_VARIABLE:
+    case CLUTTER_FRAME_CLOCK_MODE_UNLOCKED:
       break;
     case CLUTTER_FRAME_CLOCK_MODE_PASSIVE:
       return FALSE;
@@ -1385,6 +1386,16 @@ want_triple_buffering (ClutterFrameClock *frame_clock)
   if (!maybe_want_triple_buffering (frame_clock))
     return FALSE;
 
+  switch (frame_clock->mode)
+    {
+    case CLUTTER_FRAME_CLOCK_MODE_FIXED:
+    case CLUTTER_FRAME_CLOCK_MODE_VARIABLE:
+    case CLUTTER_FRAME_CLOCK_MODE_UNLOCKED:
+      break;
+    case CLUTTER_FRAME_CLOCK_MODE_PASSIVE:
