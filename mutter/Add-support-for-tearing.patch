From 82999440964f7d15ad0eee2d751e3eeb48ba0e71 Mon Sep 17 00:00:00 2001
From: Naveen Kumar <naveen1.kumar@intel.com>
Date: Wed, 17 Jun 2026 09:29:19 +0000
Subject: [PATCH 08/11] kms/atomic: pre-test async and fallback to sync

Run an async TEST_ONLY commit before real async commits.
If the test fails, clear PAGE_FLIP_ASYNC and retry as sync for this frame.

Signed-off-by: Vasiliy Stelmachenok <ventureo@cachyos.org>
---
 .../native/meta-kms-impl-device-atomic.c      | 26 ++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/src/backends/native/meta-kms-impl-device-atomic.c b/src/backends/native/meta-kms-impl-device-atomic.c
index 3cdfcc7e5f..ee579db818 100644
--- a/src/backends/native/meta-kms-impl-device-atomic.c
+++ b/src/backends/native/meta-kms-impl-device-atomic.c
@@ -1285,11 +1285,35 @@ meta_kms_impl_device_atomic_process_update (MetaKmsImplDevice *impl_device,
   if (meta_kms_update_get_async (update))
     commit_flags |= DRM_MODE_PAGE_FLIP_ASYNC;
 
+  fd = meta_kms_impl_device_get_fd (impl_device);
+
+  /*
+   * Validate async commits first and fall back to sync when needed.
+   * This avoids repeated EINVAL failures when toggling sync <-> async and the
+   * first async attempts still carry plane state changes not valid for async.
+   */
+  if ((commit_flags & DRM_MODE_PAGE_FLIP_ASYNC) &&
+      !(commit_flags & DRM_MODE_ATOMIC_TEST_ONLY))
+    {
+      uint32_t test_commit_flags;
+
+      test_commit_flags = commit_flags | DRM_MODE_ATOMIC_TEST_ONLY;
+      test_commit_flags &= ~DRM_MODE_PAGE_FLIP_EVENT;
+
+      ret = drmModeAtomicCommit (fd, req, test_commit_flags, impl_device);
+      if (ret < 0)
+        {
+          meta_topic (META_DEBUG_KMS,
+                      "[atomic] Async test commit failed, retrying sync: %s",
+                      g_strerror (errno));
+          commit_flags &= ~DRM_MODE_PAGE_FLIP_ASYNC;
+        }
+    }
+
   meta_topic (META_DEBUG_KMS,
               "[atomic] Committing update flags: %s",
               commit_flags_string (commit_flags));
 
-  fd = meta_kms_impl_device_get_fd (impl_device);
   ret = drmModeAtomicCommit (fd, req, commit_flags, impl_device);
   if (ret < 0)
     {
