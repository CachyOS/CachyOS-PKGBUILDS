From c94964f3e10bf2e8815ac5d57f64c35d84f0908a Mon Sep 17 00:00:00 2001
From: Sultech <6282-Sultech@users.noreply.gitlab.gnome.org>
Date: Wed, 4 Feb 2026 00:00:00 +0000
Subject: [PATCH 10/11] Fix tearing crash with weak references

Replaces signal handlers with weak references to prevent crashes when
surfaces are destroyed. Uses g_object_weak_ref/unref instead of
destroy signal handlers to avoid accessing freed memory.

Signed-off-by: Vasiliy Stelmachenok <ventureo@cachyos.org>
---
 src/wayland/meta-wayland-tearing-control.c | 47 +++++++++++++---------
 1 file changed, 29 insertions(+), 18 deletions(-)

diff --git a/src/wayland/meta-wayland-tearing-control.c b/src/wayland/meta-wayland-tearing-control.c
index 3e7c0b602f..ce96675074 100644
--- a/src/wayland/meta-wayland-tearing-control.c
+++ b/src/wayland/meta-wayland-tearing-control.c
@@ -40,7 +40,6 @@ typedef struct _MetaWaylandTearingSurface
 
   struct wl_resource *resource;
   MetaWaylandSurface *surface;
-  gulong destroy_handler_id;
 } MetaWaylandTearingSurface;
 
 #define META_TYPE_WAYLAND_TEARING_SURFACE (meta_wayland_tearing_surface_get_type ())
@@ -96,6 +95,17 @@ static const struct wp_tearing_control_v1_interface tearing_surface_interface =
   wp_tearing_control_destroy,
 };
 
+static void
+on_surface_weak_notify (gpointer  data,
+                        GObject  *where_the_object_was)
+{
+  MetaWaylandTearingSurface *tearing_surface = data;
+  
+  /* Surface has been destroyed - just clear our pointer.
+   * Called AFTER destruction, so we can't access the surface. */
+  tearing_surface->surface = NULL;
+}
+
 static void
 wp_tearing_control_manager_destroy (struct wl_client   *client,
                                     struct wl_resource *resource)
@@ -110,11 +120,13 @@ clear_tearing_surface_data (MetaWaylandTearingSurface *tearing_surface)
 
   if (tearing_surface->surface)
     {
-      g_object_set_qdata (G_OBJECT (tearing_surface->surface),
-                          quark_tearing_surface_data, NULL);
-      g_clear_signal_handler (&tearing_surface->destroy_handler_id,
-                              tearing_surface->surface);
+      /* Remove weak reference to prevent notification */
+      g_object_weak_unref (G_OBJECT (tearing_surface->surface),
+                           on_surface_weak_notify,
+                           tearing_surface);
 
+      /* Safe to access surface since we're cleaning up explicitly,
+       * not being called during surface destruction */
       pending = meta_wayland_surface_get_pending_state (tearing_surface->surface);
       pending->allow_tearing = FALSE;
       pending->has_new_allow_tearing = FALSE;
@@ -122,13 +134,6 @@ clear_tearing_surface_data (MetaWaylandTearingSurface *tearing_surface)
     }
 }
 
-static void
-on_surface_destroyed (MetaWaylandSurface        *surface,
-                      MetaWaylandTearingSurface *tearing_surface)
-{
-  clear_tearing_surface_data (tearing_surface);
-}
-
 static void
 tearing_control_surface_destructor (struct wl_resource *resource)
 {
@@ -144,8 +149,13 @@ meta_wayland_tearing_surface_dispose (GObject *object)
 {
   MetaWaylandTearingSurface *tearing_surface = META_WAYLAND_TEARING_SURFACE (object);
 
-  g_clear_signal_handler (&tearing_surface->destroy_handler_id,
-                          tearing_surface->surface);
+  /* Clean up weak reference if surface still exists */
+  if (tearing_surface->surface)
+    {
+      g_object_weak_unref (G_OBJECT (tearing_surface->surface),
+                           on_surface_weak_notify,
+                           tearing_surface);
+    }
 
   G_OBJECT_CLASS (meta_wayland_tearing_surface_parent_class)->dispose (object);
 }
@@ -171,10 +181,11 @@ meta_wayland_tearing_surface_new (MetaWaylandSurface *surface)
   tearing_surface = g_object_new (META_TYPE_WAYLAND_TEARING_SURFACE, NULL);
   tearing_surface->surface = surface;
 
-  tearing_surface->destroy_handler_id =
-    g_signal_connect (tearing_surface->surface, "destroy",
-                      G_CALLBACK (on_surface_destroyed),
-                      tearing_surface);
+  /* Use weak reference instead of signal handler.
+   * Called AFTER surface destruction, not during. */
+  g_object_weak_ref (G_OBJECT (tearing_surface->surface),
+                     on_surface_weak_notify,
+                     tearing_surface);
   return tearing_surface;
 }
 
