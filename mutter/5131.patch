From 2253a698b8d227294c307d2e27e9b86539cd146a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michel=20D=C3=A4nzer?= <mdaenzer@redhat.com>
Date: Wed, 10 Jun 2026 18:57:51 +0200
Subject: [PATCH 5/9] clutter/frame-clock: Use minimum update duration time
 estimate

When there's not enough time to hit a display refresh cycle according
to the maximum estimate, but there is according to the minimum estimate,
we attempt to hit that cycle by starting dispatch ASAP.

This is vaguely similar to the previous min_render_time_allowed_us, but
dynamic based on measurements instead of a static number.
---
 clutter/clutter/clutter-frame-clock.c | 62 +++++++++++++++++++++------
 1 file changed, 48 insertions(+), 14 deletions(-)

diff --git a/clutter/clutter/clutter-frame-clock.c b/clutter/clutter/clutter-frame-clock.c
index 81d507ab8fa..18ab7521b04 100644
--- a/clutter/clutter/clutter-frame-clock.c
+++ b/clutter/clutter/clutter-frame-clock.c
@@ -915,6 +915,23 @@ maybe_want_triple_buffering (ClutterFrameClock *frame_clock)
   return TRUE;
 }
 
+static gboolean
+clutter_frame_clock_estimate_min_update_time_us (ClutterFrameClock *frame_clock,
+                                                 int64_t           *min_update_time_estimate_us)
+{
+  if (!frame_clock->ever_got_measurements ||
+      G_UNLIKELY (clutter_paint_debug_flags &
+                  CLUTTER_DEBUG_DISABLE_DYNAMIC_MAX_RENDER_TIME))
+    return FALSE;
+
+  /* Estimate the minimum total update duration */
+  *min_update_time_estimate_us =
+    frame_clock->min_update_duration_us +
+    frame_clock->vblank_duration_us;
+
+  return TRUE;
+}
+
 static gboolean
 clutter_frame_clock_estimate_max_update_time_us (ClutterFrameClock *frame_clock,
                                                  int64_t           *max_update_time_estimate_us)
@@ -1102,26 +1119,43 @@ calculate_next_update_time_us (ClutterFrameClock *frame_clock,
     }
   else
     {
-      if (next_presentation_time_us - max_update_time_estimate_us < now_us)
+      next_update_time_us =
+        next_presentation_time_us - max_update_time_estimate_us;
+
+      if (next_update_time_us < now_us)
         {
-          int64_t min_update_time_estimate_us =
-            (int64_t) (refresh_interval_us * SYNC_DELAY_FALLBACK_FRACTION);
+          int64_t min_update_time_estimate_us;
 
-          if (maybe_want_triple_buffering (frame_clock))
-            min_update_time_estimate_us += refresh_interval_us;
+          if (clutter_frame_clock_estimate_min_update_time_us (frame_clock,
+                                                               &min_update_time_estimate_us))
+            {
+              next_update_time_us =
