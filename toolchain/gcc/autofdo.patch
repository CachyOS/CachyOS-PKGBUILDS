+#ifndef GCC_AFDO_ASSERT_H
+#define GCC_AFDO_ASSERT_H
+
+/* Host tools abort on failure.  When linked into cc1, use gcc_assert.  */
+#ifdef IN_GCC
+#define afdo_assert(EXPR) gcc_assert (EXPR)
+#else
+#include <cstdio>
+#include <cstdlib>
+#define afdo_assert(EXPR) \
+  ((void) (!(EXPR) \
+	   ? (std::fprintf (stderr, \
+			    "%s:%d: afdo_assert failed: %s\n", \
+			    __FILE__, __LINE__, #EXPR), \
+	      std::abort (), 0) \
+	   : 0))
+#endif
