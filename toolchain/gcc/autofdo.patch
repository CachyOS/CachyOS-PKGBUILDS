+<http://www.gnu.org/licenses/>.  */
+
+#include "autofdo_profiler.h"
+#include "autofdo_correlator.h"
+#include "autofdo_debug_dump.h"
+#include "dwarf_reader.h"
+#include "perf_file_reader.h"
+#include "profile_reader.h"
+#include "profile_timer.h"
+
+#include <cstdio>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace autofdo {
+
+autofdo_profiler::autofdo_profiler (const std::string &binary_path,
+				    const profiler_run_options &run_opts,
+				    const std::string &perf_data_path,
+				    perf_data::sampling_mode sampling_mode)
+  : binary_path_ (binary_path), run_opts_ (run_opts)
+{
+  profile_source_ = perf_data::create_perf_reader (
+    perf_data_path, binary_path, sampling_mode);
+}
+
+autofdo_profiler::~autofdo_profiler () = default;
+
+bool
+autofdo_profiler::generate_profile ()
+{
+  profile_timer::mark ();
+
+  /* 1. Load samples.  */
+  fprintf (stderr, "Loading profile...\n");
+  if (profile_source_ == nullptr)
+    {
+      fprintf (stderr, "Error: no profile reader is available\n");
+      return false;
+    }
+  if (!profile_source_->load_and_prepare (run_opts_.use_branch_stack))
+    return false;
+  if (!run_opts_.dump_perf_maps.empty ())
+    dump_ingested_perf_maps (*profile_source_, run_opts_.dump_perf_maps);
+  {
+    std::string detail
+      = std::to_string (profile_source_->get_total_samples ()) + " samples";
+    if (const auto *ranges = profile_source_->range_counts ())
+      detail += ", " + std::to_string (ranges->size ()) + " ranges";
+    profile_timer::log_stage ("profile load", detail);
+  }
+
+  /* 2. Load DWARF for the sampled address scope.  */
+  std::vector<std::pair<uint64_t, uint64_t>> sampled_ranges
+    = profile_source_->sample_ranges_for_dwarf ();
+  if (sampled_ranges.empty ())
+    {
+      fprintf (stderr, "Error: No profile sample scope for DWARF load\n");
+      return false;
+    }
+  dwarf_reader_ = std::make_unique<dwarf_debug::dwarf_reader> (
+    binary_path_, std::move (sampled_ranges));
+  dwarf_reader_->set_parse_threads (run_opts_.correlate_threads);
+  if (!dwarf_reader_->load ())
+    {
+      fprintf (
+	stderr, "Error: Failed to load DWARF from %s\n", binary_path_.c_str ());
+      return false;
+    }
+  {
+    const dwarf_debug::dwarf_load_summary &s = dwarf_reader_->load_summary ();
+    std::string detail = std::to_string (s.touch_cus) + " CUs, "
+			 + std::to_string (s.dwarf_functions) + " DWARF funcs, "
+			 + std::to_string (s.symtab_functions) + " symtab, "
+			 + std::to_string (s.line_segments) + " line segments, "
+			 + std::to_string (s.touch_pcs) + " touch PCs";
+    profile_timer::log_stage ("DWARF load", detail);
+  }
+
+  profile_source_->fold_sample_timestamps_by_function (*dwarf_reader_);
+
+  /* 3. Correlate samples into the profile tree.  */
+  if (!correlate_samples_to_source (
+	profile_, *profile_source_, *dwarf_reader_, run_opts_))
+    return false;
+
+  /* 4. Finalize and emit GCOV.  */
+  profile_.finalize_after_correlate (*profile_source_);
+  profile_.materialize_alias_profiles (
+    dwarf_reader_->symtab_functions (), dwarf_reader_->symtab_aliases ());
+  profile_timer::log_stage ("finalize");
+
+  if (!profile_.build_gcov_profile (gcov_out_))
+    {
+      fprintf (stderr, "Error: Failed to build gcov profile\n");
+      return false;
+    }
+  profile_timer::log_stage ("build gcov");
+  return true;
+}
+
+} /* namespace autofdo.  */
