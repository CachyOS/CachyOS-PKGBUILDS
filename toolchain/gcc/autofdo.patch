+#ifndef GCC_LIVE_BRANCH_STACK_READER_H
+#define GCC_LIVE_BRANCH_STACK_READER_H
+
+#include "branch_stack_reader_base.h"
+#include "profile_reader.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace perf_data {
+
+class live_mapping_reader;
+
+/* Live LBR/BRBE runs a command under perf and ingests its branch stacks.  */
+class live_branch_stack_reader : public profile_reader,
+				 public branch_stack_reader_base
+{
+  std::string binary_path;
+  std::vector<std::string> command_argv;
+  uint64_t processed_samples = 0;
+  uint64_t total_profile_mass = 0;
+  address_frequency_map address_frequencies;
+
+  branch_stack_edge_count_map range_count_map;
+  branch_stack_edge_count_map branch_count_map;
+
+  pid_mmap_map target_mmaps_by_pid;
+  uint64_t sample_period;
+  /* Ring buffer size to request per CPU.  */
+  size_t ring_buffer_kb;
+  /* Follow the workload's threads, which costs one buffer per CPU.  */
+  bool inherit_threads;
+  uint64_t sample_type = 0;
+  uint64_t branch_sample_type = 0;
+  /* Records the kernel dropped because the ring buffer was full.  */
+  uint64_t lost_records = 0;
+  /* Times the kernel throttled the event (PERF_RECORD_THROTTLE).  */
+  uint64_t throttle_records = 0;
+  /* True when producer head lapped the consumer tail.  */
+  bool ring_overwrite = false;
+
+  bool process_sample_record (const uint8_t *payload, size_t payload_size);
+  void process_ring_buffer (void *mmap_base, uint64_t data_offset,
+			    uint64_t data_size, live_mapping_reader &mappings,
+			    FILE *samples, bool &write_failed);
+  void finalize_profile_after_capture ();
+
+public:
+  live_branch_stack_reader (const std::string &_binary_path,
+			    const std::vector<std::string> &_command_argv,
+			    uint64_t _sample_period, size_t _ring_buffer_kb,
+			    bool _inherit_threads);
+
+  ~live_branch_stack_reader () override;
+
+  bool load () override;
+  const address_frequency_map &get_address_frequencies () const override
+  {
+    return address_frequencies;
+  }
+  uint64_t get_total_mass () const override { return total_profile_mass; }
+
+  branch_stack_reader_base *as_branch_stack_reader () override { return this; }
+  const branch_stack_reader_base *as_branch_stack_reader () const override
+  {
+    return this;
+  }
+};
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_LIVE_BRANCH_STACK_READER_H.  */
