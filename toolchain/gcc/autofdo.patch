+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-create -D } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot recursive_sum } */
+/* { dg-afdo-requires python3 perf } */
+
+volatile long sink;
+
+long __attribute__((noinline)) recursive_sum(long n)
+{
+  if (n <= 0) return 0;
+  for (int i = 0; i < 500; i++)
+    sink += n + i;
+  return n + recursive_sum(n - 1);
+}
+
+int main(void)
+{
+  for (int i = 0; i < 200; i++)
+    recursive_sum(500);
+  return 0;
+}
