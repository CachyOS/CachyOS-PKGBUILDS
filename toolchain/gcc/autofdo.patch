index 00000000000..ad29b423546
--- /dev/null
+++ b/afdo_tools/configure.ac
@@ -0,0 +1,93 @@
+AC_INIT([afdo_tools], [1.0])
+AC_CONFIG_SRCDIR([src/afdo_create.cc])
