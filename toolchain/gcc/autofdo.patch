+/* Move this worker's cached symbolizations into DEST.  */
+void
+correlate_session::drain_symbolize_snapshot_into (correlate_symbolize_map &dest)
+{
+  for (auto &kv : symbolize_cache_)
+    dest[kv.first] = std::move (kv.second);
+  symbolize_cache_.clear ();
+}
