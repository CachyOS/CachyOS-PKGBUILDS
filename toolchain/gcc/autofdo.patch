+
+/* Offline perf.data loader; subclasses ingest samples.  */
+class perf_file_reader : public profile_reader
+{
+public:
+  perf_file_reader (const std::string &_perf_data_path,
+		    const std::string &_binary_path)
+    : perf_data_path (_perf_data_path), binary_path (_binary_path),
+      total_samples (0), header{},
+      sample_type (DEFAULT_BRANCH_STACK_SAMPLE_TYPE)
+  {}
+
+  ~perf_file_reader () override;
+
+  bool load () override;
+  const std::unordered_map<uint64_t, uint64_t> &
+  get_address_frequencies () const override
+  {
+    return address_frequencies;
+  }
+  uint64_t get_total_samples () const override { return total_samples; }
+  uint64_t translate_address (uint64_t runtime_addr) const override;
+
+protected:
+  /* Lifecycle / I/O.  */
+  bool open_and_map_file ();
+  void cleanup ();
+  bool parse_header ();
+  virtual bool parse_perf_data_section () = 0;
+  virtual void finalize_profile_maps_impl ();
+  bool finalize_profile_to_file_offsets ();
+  void finalize_address_frequencies_to_file_offsets ();
+  void clear_runtime_translation_state ();
+
+  /* Record scan.  */
+  void for_each_mapped_perf_data_record (
+    const std::function<
+      void (size_t record_index, size_t data_section_bytes_remaining,
+	    const perf_event_header &hdr, const uint8_t *payload,
+	    size_t payload_size, size_t skip_whole)> &fn);
+  size_t perf_record_skip_bytes (const perf_event_header &record_header,
+				 const uint8_t *payload,
+				 size_t data_remaining) const;
+  bool parse_mmap_record (const uint8_t *record_data, size_t record_size);
+  bool parse_mmap2_record (const uint8_t *record_data, size_t record_size,
+			   uint16_t misc);
+  void add_target_mmap (const std::string &mmap_filename, uint64_t start,
+			uint64_t end, uint64_t pgoff);
+
+  /* Target binary / address filters.  */
+  bool is_target_binary (const std::string &mmap_filename,
+			 const std::string &build_id) const;
+  bool is_valid_user_address (uint64_t addr) const;
+  bool rebuild_target_address_ranges () const;
+  bool is_target_address (uint64_t address) const;
+  /* Merged intervals for O(log n) target checks; nullptr if one mmap.  */
+  const std::vector<std::pair<uint64_t, uint64_t>> *
+  sorted_target_address_ranges_for_branch_stack () const;
+  void parse_build_id_table () const;
+
+  const uint8_t *mapped_bytes () const { return mapped_file_.data (); }
+  size_t mapped_size () const { return mapped_file_.size (); }
+
+  /* Paths and sample mass.  */
+  std::string perf_data_path;
+  std::string binary_path;
+  uint64_t total_samples;
+  std::unordered_map<uint64_t, uint64_t> address_frequencies;
+  std::vector<simple_mmap> target_mmaps;
+
+  /* Lazy address-range index over target_mmaps.  */
+  mutable std::vector<std::pair<uint64_t, uint64_t>> target_address_ranges_;
+  mutable bool target_address_ranges_valid_ = false;
+
+  /* Build-id cache and HEADER_BUILD_ID table.  */
+  mutable std::string cached_target_build_id_;
+  mutable bool cached_target_build_id_valid_ = false;
+  mutable std::map<std::string, std::string, std::less<>> buildid_table_;
+  mutable bool buildid_table_valid_ = false;
+
+  /* Mapped perf.data and sample attributes.  */
+  afdo_tools::file_mmap mapped_file_;
+  perf_file_header header;
+  uint64_t sample_type;
+  uint64_t read_format = 0;
+  uint64_t branch_sample_type = 0;
+  uint64_t sample_regs_user = 0;
+  uint64_t sample_regs_intr = 0;
+};
+
+std::unique_ptr<profile_reader>
+create_perf_reader (const std::string &perf_data_path,
+		    const std::string &binary_path, sampling_mode mode);
+
+bool get_elf_segment_vaddr_for_pgoff (const std::string &binary_path,
+				      uint64_t pgoff, uint64_t &out);
+
+bool get_elf_is_pie (const std::string &binary_path);
+
+} /* namespace perf_data.  */
+
