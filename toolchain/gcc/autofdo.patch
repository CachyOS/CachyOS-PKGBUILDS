@@ -0,0 +1,38 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-extra-src duplicate-static-symbol-names-b.c } */
+/* { dg-afdo-dump-hot run_a } */
+/* { dg-afdo-dump-hot run_b } */
+/* { dg-afdo-dump-hot-in-file helper:duplicate-static-symbol-names.c } */
+/* { dg-afdo-dump-hot-in-file helper:duplicate-static-symbol-names-b.c } */
+/* { dg-afdo-requires python3 perf } */
+
+volatile int sink_a;
+
+__attribute__((noinline)) static int helper(int x)
