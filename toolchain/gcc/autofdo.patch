+function_inst_map
+function_inst_map::make (uint64_t start, uint64_t end)
+{
+  function_inst_map map;
+  if (end > start && end - start <= DENSE_ADDR_MASS_MAX_SPAN)
+    {
+      map.base = start;
+      map.dense.resize (static_cast<size_t> (end - start));
+    }
+  return map;
+}
+
+instruction_map_entry &
+function_inst_map::operator[] (uint64_t addr)
+{
+  if (dense_p ())
+    {
+      const uint64_t offset = addr - base;
+      if (offset < dense.size ())
+	return dense[static_cast<size_t> (offset)];
+    }
+  return sparse[addr];
+}
