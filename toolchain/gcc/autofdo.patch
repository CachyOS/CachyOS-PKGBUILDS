+static std::unique_ptr<autofdo::autofdo_profiler>
+make_profiler (const program_options &options)
+{
+  return std::make_unique<autofdo::autofdo_profiler> (options.binary_file,
+						      options.run,
+						      options.perf_data_file,
+						      options.sampling_mode);
+}
