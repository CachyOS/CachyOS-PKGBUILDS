+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# Shared helpers for the afdo-tools DejaGnu suite.
+
+#
+# afdo_tools_xgcc.  Locate the sibling in-tree xgcc.
+#
+# TOOL_BIN_DIR is the afdo-tools build directory.  Xgcc lives in ../gcc.
+# Returns {xgcc_path gcc_build_dir}, or "".
+#
+proc afdo_tools_xgcc {} {
+    global env
+    if { ![info exists env(TOOL_BIN_DIR)] } {
+	return ""
+    }
+    set ext ""
+    if { [info exists env(EXEEXT)] } {
+	set ext $env(EXEEXT)
+    }
+    set gcc_dir [file normalize "$env(TOOL_BIN_DIR)/../gcc"]
+    set xgcc "$gcc_dir/xgcc$ext"
+    if { ![file executable $xgcc] } {
+	return ""
+    }
+    return [list $xgcc $gcc_dir]
+}
diff --git a/afdo-tools/testsuite/unit/file-mmap-test.cc b/afdo-tools/testsuite/unit/file-mmap-test.cc
new file mode 100644
index 00000000000..e0576685d15
--- /dev/null
+++ b/afdo-tools/testsuite/unit/file-mmap-test.cc
@@ -0,0 +1,80 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "file_mmap.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unistd.h>
+#include <vector>
+
+static void
+expect (bool condition, const char *message)
+{
+  if (!condition)
+    {
+      std::fprintf (stderr, "file-mmap-test: %s\n", message);
+      std::exit (1);
+    }
+}
+
+int
+main ()
+{
+  char path[] = "/tmp/file-mmap-test-XXXXXX";
+  const int fd = mkstemp (path);
+  expect (fd >= 0, "create test file");
+  const unsigned char bytes[] = {0, '\r', '\n', 0x1a, 0xff};
+  expect (write (fd, bytes, sizeof (bytes))
+	  == static_cast<ssize_t> (sizeof (bytes)), "write data");
+  expect (close (fd) == 0, "close test file");
+
+  afdo_tools::file_mmap file;
+  expect (file.map (path), "read test file");
+  expect (file.size () == sizeof (bytes)
+	  && std::memcmp (file.data (), bytes, sizeof (bytes)) == 0,
+	  "preserve binary data");
+  expect (file.map (path), "replace previous data");
+  expect (unlink (path) == 0, "remove test file");
+  expect (!file.map (path), "reject missing file");
+  expect (!file && file.data () == nullptr && file.size () == 0,
+	  "clear data after failure");
+
+  char empty_path[] = "/tmp/file-mmap-empty-XXXXXX";
+  const int empty_fd = mkstemp (empty_path);
+  expect (empty_fd >= 0 && close (empty_fd) == 0, "create empty file");
+  expect (!file.map (empty_path), "reject empty file");
+  expect (unlink (empty_path) == 0, "remove empty file");
+
+  char large_path[] = "/tmp/file-mmap-large-XXXXXX";
+  const int large_fd = mkstemp (large_path);
+  expect (large_fd >= 0, "create large file");
+  std::vector<unsigned char> large (2 * 65536 + 37);
+  for (size_t i = 0; i < large.size (); ++i)
+    large[i] = static_cast<unsigned char> (i);
+  expect (write (large_fd, large.data (), large.size ())
+	  == static_cast<ssize_t> (large.size ()), "write large file");
+  expect (close (large_fd) == 0, "close large file");
+  expect (file.map (large_path), "read large file");
+  expect (file.size () == large.size ()
+	  && std::memcmp (file.data (), large.data (), large.size ()) == 0,
+	  "preserve large file contents");
+  expect (unlink (large_path) == 0, "remove large file");
+  return 0;
+}
diff --git a/afdo-tools/testsuite/unit/gcov-summary-test.cc b/afdo-tools/testsuite/unit/gcov-summary-test.cc
