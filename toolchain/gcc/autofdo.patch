+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "autofdo_correlator.h"
+
+#include "autofdo_correlate_detail.h"
+#include "autofdo_debug_dump.h"
+#include "autofdo_options.h"
+#include "branch_stack_reader_base.h"
+#include "profile_timer.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <string>
+
+namespace autofdo {
+
+bool
+correlate_samples_to_source (profile_builder &profile,
+			     const perf_data::profile_reader &perf,
+			     dwarf_debug::dwarf_reader &dw,
+			     const profiler_run_options &run_opts)
+{
+  correlate_detail::correlate_context ctx (dw);
+  if (!correlate_detail::bucket_and_select_targets (ctx, perf, run_opts))
+    return false;
+  if (const perf_data::branch_stack_reader_base *branch_stack
+      = perf.as_branch_stack_reader ())
+    ctx.range_mass_addr_step = branch_stack->range_mass_addr_step ();
+  profile_timer::log_stage (
+    "correlate bucket", std::to_string (ctx.targets.size ()) + " targets");
+
+  correlate_detail::materialize_correlate_targets (ctx, profile);
+  profile_timer::log_stage ("correlate materialize",
+			    std::to_string (ctx.targets.size ()) + " builders");
+
+  for (correlate_detail::correlate_target &target : ctx.targets)
+    target.estimated_work = correlate_detail::estimate_correlate_target_work (
+      target, ctx.range_mass_addr_step);
+  std::sort (ctx.targets.begin (),
+	     ctx.targets.end (),
+	     [] (const correlate_detail::correlate_target &a,
+		 const correlate_detail::correlate_target &b) {
+	       if (a.estimated_work != b.estimated_work)
+		 return a.estimated_work > b.estimated_work;
+	       if (a.start_addr != b.start_addr)
+		 return a.start_addr < b.start_addr;
+	       return dwarf_debug::string_value (a.func_name)
+		      < dwarf_debug::string_value (b.func_name);
+	     });
+
+  dwarf_debug::correlate_symbolize_map symbolize_snapshot;
+  dwarf_debug::correlate_symbolize_map *symbolize_out
+    = run_opts.dump_address_mapping.empty () ? nullptr : &symbolize_snapshot;
+  fprintf (stderr,
+	   "AFDO: correlating %zu functions (%u threads)...\n",
+	   ctx.targets.size (),
+	   ctx.num_threads);
+  const size_t functions_done
+    = correlate_detail::run_correlate_target_workers (ctx, symbolize_out);
+  profile_timer::log_stage ("correlate workers",
+			    std::to_string (functions_done) + " functions, "
+			      + std::to_string (ctx.num_threads) + " threads");
+
+  if (symbolize_out != nullptr
+      && !write_address_mapping_dump (
+	run_opts.dump_address_mapping, dw, symbolize_snapshot))
+    fprintf (stderr,
+	     "Warning: failed to write address mapping to %s (continuing)\n",
+	     run_opts.dump_address_mapping.c_str ());
+  return true;
+}
+
+} /* namespace autofdo.  */
