diff --git a/afdo_tools/testsuite/afdo-test/dwarf-sym-perf-large.c b/afdo_tools/testsuite/afdo-test/dwarf-sym-perf-large.c
new file mode 100644
index 00000000000..66f083b15dc
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/dwarf-sym-perf-large.c
@@ -0,0 +1,48 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-create -m } */
+/* { dg-afdo-validate addr2line } */
+/* { dg-afdo-requires addr2line python3 perf } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+#define R2(m,p)    m(p##0) m(p##1)
+#define R4(m,p)    R2(m,p##0) R2(m,p##1)
+#define R8(m,p)    R4(m,p##0) R4(m,p##1)
+#define R16(m,p)   R8(m,p##0) R8(m,p##1)
+#define R32(m,p)   R16(m,p##0) R16(m,p##1)
+#define R64(m,p)   R32(m,p##0) R32(m,p##1)
+#define R128(m,p)  R64(m,p##0) R64(m,p##1)
+#define R256(m,p)  R128(m,p##0) R128(m,p##1)
+#define R512(m,p)  R256(m,p##0) R256(m,p##1)
+#define R1024(m,p) R512(m,p##0) R512(m,p##1)
+#define R2048(m,p) R1024(m,p##0) R1024(m,p##1)
+
+#ifndef DWARF_SYM_LADDER
+#define DWARF_SYM_LADDER R2048
+#endif
+
+#define GENFN(id) \
+  __attribute__((noinline)) long fn_##id(long x) \
+  { long s = 0; for (int k = 0; k < 64; ++k) s += (x * 7 + k) ^ (x >> 1); return s; }
+
+#define CALLFN(id) acc += fn_##id(acc + seed);
+
+DWARF_SYM_LADDER(GENFN, z)
+
+int main(void)
+{
+  long acc = 1;
+
+  for (long r = 0; r < 12000; ++r)
+    {
+      DWARF_SYM_LADDER(CALLFN, z)
+    }
+
+  printf("%ld\n", acc);
+  return 0;
+}
diff --git a/afdo_tools/testsuite/afdo-test/function-cloning-attribution.c b/afdo_tools/testsuite/afdo-test/function-cloning-attribution.c
new file mode 100644
index 00000000000..7e2638c84f2
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/function-cloning-attribution.c
@@ -0,0 +1,58 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O3 -g" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot specialize.constprop.0 } */
+/* { dg-afdo-dump-hot specialize.constprop.1 } */
+/* { dg-afdo-dump-hot run_hot } */
+/* { dg-afdo-dump-hot run_cold } */
+/* { dg-afdo-requires python3 perf } */
+
+#include <stdlib.h>
+
+volatile long sink;
+
+__attribute__((noinline))
+static long specialize(long x, int mode)
+{
+  long acc = 0;
+  for (int i = 0; i < 64; i++)
+    {
+      if (mode)
+	acc += x * 3 + i;
+      else
+	acc += x + i * 2;
+    }
+  return acc;
+}
+
+__attribute__((noinline))
+static long run_hot(long n)
+{
+  long s = 0;
+  for (long i = 0; i < n; i++)
+    s += specialize(i, 1);
+  return s;
+}
+
+__attribute__((noinline))
+static long run_cold(long n)
+{
+  long s = 0;
+  for (long i = 0; i < n; i++)
+    s += specialize(i, 0);
+  return s;
+}
+
+int main(int argc, char **argv)
+{
+  long hot  = argc > 1 ? atol(argv[1]) : 30000000;
+  long cold = argc > 2 ? atol(argv[2]) : 12000000;
+  long s = 0;
+  s += run_hot(hot);
+  s += run_cold(cold);
+  sink = s;
+  return 0;
+}
