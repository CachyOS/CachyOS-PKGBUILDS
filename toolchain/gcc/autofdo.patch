diff --git a/afdo_tools/testsuite/afdo-test/addr-mapping-basic.c b/afdo_tools/testsuite/afdo-test/addr-mapping-basic.c
new file mode 100644
index 00000000000..998e6059a80
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/addr-mapping-basic.c
@@ -0,0 +1,52 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-create -m } */
+/* { dg-afdo-validate addr2line } */
+/* { dg-afdo-requires addr2line python3 perf } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+static inline __attribute__((always_inline))
+int leaf(int x)
+{
+  int y = x + seed;
+  return (y * 3) + 1;
+}
+
+static inline __attribute__((always_inline))
+int middle(int x)
+{
+  return leaf(x) + 11;
+}
+
+__attribute__((noinline))
+int hot_loop(int n)
+{
+  int sum = 0;
+
+  for (int i = 0; i < n; ++i)
+    if (seed > 0 && (i & 1) == 0) sum += middle(i); else sum += leaf(i);
+
+  return sum;
+}
+
+__attribute__((noinline))
+int cold_path(int x)
+{
+  return x - 17;
+}
+
+int main(void)
+{
+  int result = hot_loop(50000000);
+
+  if (result == 12345)
+    result += cold_path(result);
+
+  printf("%d\n", result);
+  return 0;
+}
diff --git a/afdo_tools/testsuite/afdo-test/afdo-dump-tree.c b/afdo_tools/testsuite/afdo-test/afdo-dump-tree.c
new file mode 100644
index 00000000000..eff298a9da2
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/afdo-dump-tree.c
@@ -0,0 +1,55 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot hot_loop } */
+/* { dg-afdo-dump-inline leaf middle } */
+/* { dg-afdo-dump-nested-branch-stack leaf } */
+/* { dg-afdo-requires python3 perf } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+static inline __attribute__((always_inline))
+int leaf(int x)
+{
+  int y = x + seed;
+  return (y * 3) + 1;
+}
+
+static inline __attribute__((always_inline))
+int middle(int x)
+{
+  return leaf(x) + 11;
+}
+
+__attribute__((noinline))
+int hot_loop(int n)
+{
+  int sum = 0;
+
+  for (int i = 0; i < n; ++i)
+    if (seed > 0 && (i & 1) == 0) sum += middle(i); else sum += leaf(i);
+
+  return sum;
+}
+
+__attribute__((noinline))
+int cold_path(int x)
+{
+  return x - 17;
+}
+
+int main(void)
+{
+  int result = hot_loop(50000000);
+
+  if (result == 12345)
+    result += cold_path(result);
+
+  printf("%d\n", result);
+  return 0;
+}
diff --git a/afdo_tools/testsuite/afdo-test/afdo-fauto-profile-opt-dump.c b/afdo_tools/testsuite/afdo-test/afdo-fauto-profile-opt-dump.c
new file mode 100644
index 00000000000..11f2d8c1665
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/afdo-fauto-profile-opt-dump.c
@@ -0,0 +1,56 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources lbr brbe spe } */
+/* { dg-afdo-post dump opt-dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot hot_loop } */
+/* { dg-afdo-requires python3 perf } */
+/* { dg-afdo-opt-dump-flags -fdump-passes -fdump-ipa-inline-optimized-missed -fdump-tree-einline-optimized-missed -fopt-info-inline-optimized-missed } */
+/* { dg-afdo-scan-opt-info "missed:.*will not early inline.*hot_callee" } */
+/* { dg-afdo-scan-opt-info "optimized:.*hot_callee" } */
+/* { dg-afdo-scan-opt-info "ipa-afdo.*ON" } */
+/* { dg-afdo-scan-tree "will not early inline.*hot_callee" einline } */
+/* { dg-afdo-scan-tree "Inlining using auto-profile.*hot_callee" einline } */
+/* { dg-afdo-scan-ipa "hot_loop.*hot" inline } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+int hot_callee(int x)
+{
+  int a = (x + seed) * 3 + 1;
+  int b = a ^ (a >> 7);
+  int c = b * 31 + (b << 3);
+  int d = c - (seed * 5);
+  int e = d | (d >> 4);
+  int f = e * 7 - (e >> 2);
+  int g = f + (seed ^ 0x5A5A5A5A);
+  int h = g * 13 + (g << 1);
+  return h;
+}
+
+__attribute__((noinline))
+int hot_loop(int n)
+{
+  int sum = 0;
+  for (int i = 0; i < n; ++i)
+    sum += hot_callee(i);
+  return sum;
+}
+
+__attribute__((noinline))
+int cold_path(int x)
+{
+  return x - 17;
+}
+
+int main(void)
+{
+  int result = hot_loop(50000000);
+  if (result == 12345)
+    result += cold_path(result);
+  printf("%d\n", result);
+  return 0;
+}
