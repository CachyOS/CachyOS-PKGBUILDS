From c841f1912c445e24b8106db32cfda1a171df9f1f Mon Sep 17 00:00:00 2001
From: Peter Jung <admin@ptr1337.dev>
Date: Mon, 9 Nov 2026 11:21:12 +0100
Subject: [PATCH 45/45] [AutoFDO] Do not read a renamed callsite after erasing
 it

function_instance::remove_external_functions renames callsites by
erasing the old map entry and then storing ITER->second under the new
key.  ITER is invalid after the erase, so the callee is read from freed
memory.

This went unnoticed while the callsite key was a pair of unsigned
values: the callee pointer sits in a part of the map node that glibc's
free leaves alone.  With the file index added to the key, the pointer
moves to the last word of the node's malloc chunk, which free reuses
as the next chunk's prev_size.  The renamed callsite then points to
0x40 and autoprofiledbootstrap crashes in offline_if_not_realized
while compiling ggc-page.cc in stageautofeedback.

gcc/ChangeLog:

	* auto-profile.cc (function_instance::remove_external_functions):
	Read the callee before erasing its callsite.

Signed-off-by: Peter Jung <admin@ptr1337.dev>
---
 gcc/auto-profile.cc | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/gcc/auto-profile.cc b/gcc/auto-profile.cc
index fc7305fd1f0..c238dc71cd4 100644
--- a/gcc/auto-profile.cc
+++ b/gcc/auto-profile.cc
@@ -2223,9 +2223,10 @@ function_instance::remove_external_functions
       auto iter = callsites.find (key);
       callsite key2 = key;
       key2.second = *to_symbol_name.get (key.second);
-      iter->second->set_symbol_name (key2.second);
+      function_instance *inlined_fn = iter->second;
+      inlined_fn->set_symbol_name (key2.second);
       callsites.erase (iter);
-      callsites[key2] = iter->second;
+      callsites[key2] = inlined_fn;
     }
   auto_vec <int, 20> target_to_rename;
   for (auto &iter : pos_counts)
-- 
