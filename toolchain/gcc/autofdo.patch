From 85a47eda8a81c878dc94ae825e5079731fb2bce2 Mon Sep 17 00:00:00 2001
From: Peter Jung <admin@ptr1337.dev>
Date: Sat, 26 Sep 2026 11:07:19 +0200
Subject: [PATCH 38/38] [AFDO-TOOLS] Accept a reordered exec COMM for the
 target task

perf writes each CPU's ring buffer to perf.data separately, so records
are not in time order.  When a task migrates between CPUs during exec,
the PERF_RECORD_COMM with PERF_RECORD_MISC_COMM_EXEC that starts the
target binary can be written after the target's MMAP2.  afdo_create
then treats the exec as a later change of executable image and rejects
the whole profile:

  Error: perf.data changes the executable mapping lifetime for a target
  process; this is not supported

This was seen during autoprofiledbootstrap on the libatomic perf.data,
where the exec COMM for one cc1 process was timestamped before its
MMAP2 but stored after it.

The kernel always emits the exec COMM before mapping the new image, so
an exec into a task named like the target is the one that started it.
Ignore such an exec; an exec into a different build under the same name
maps over the target range and is still caught by
observe_executable_mmap.

afdo_tools/ChangeLog:

	* src/perf_file_reader.cc (PERF_TASK_COMM_LEN): New constant.
	(perf_file_reader::note_process_lifetime_record): Ignore an exec
	COMM whose name matches the target binary.
---
 afdo_tools/src/perf_file_reader.cc | 28 ++++++++++++++++++++++++++--
 1 file changed, 26 insertions(+), 2 deletions(-)

diff --git a/afdo_tools/src/perf_file_reader.cc b/afdo_tools/src/perf_file_reader.cc
index 1c49ec24a15..c9b8353811a 100644
--- a/afdo_tools/src/perf_file_reader.cc
+++ b/afdo_tools/src/perf_file_reader.cc
@@ -76,6 +76,8 @@ constexpr uint16_t PERF_RECORD_MISC_MMAP_DATA = 1U << 13;
 constexpr uint16_t PERF_RECORD_MISC_COMM_EXEC = 1U << 13;
 constexpr uint16_t PERF_RECORD_MISC_MMAP_BUILD_ID = 1U << 14;
 constexpr uint16_t PERF_RECORD_MISC_BUILD_ID_SIZE = 1U << 15;
+/* The kernel's TASK_COMM_LEN, including the terminating NUL.  */
+constexpr size_t PERF_TASK_COMM_LEN = 16;
 constexpr size_t PERF_EVENT_ATTR_TYPE_OFF = 0;
 constexpr size_t PERF_EVENT_ATTR_CONFIG_OFF = 8;
 constexpr size_t PERF_EVENT_ATTR_MIN_BYTES_THROUGH_CONFIG = 16;
@@ -809,8 +811,30 @@ perf_file_reader::note_process_lifetime_record (
       && (record_header.misc & PERF_RECORD_MISC_COMM_EXEC) != 0)
     {
       const uint32_t pid = read_u32 (payload);
-      if (target_mapping_pids_.count (pid) != 0)
-	unstable_target_pids_.insert (pid);
+      if (target_mapping_pids_.count (pid) == 0)
+	return;
+
+      /* perf writes each CPU's ring buffer separately, so the exec that
+	 started the target can land in the file after the target's MMAP when
+	 the task migrated during exec.  The kernel always emits that COMM
+	 before the MMAP, so an exec into a task named like the target is not
+	 a later change of image.  An exec into a different build under the
+	 same name maps over the target range and is caught by
+	 observe_executable_mmap.  */
+      const char *comm
+	= reinterpret_cast<const char *> (payload + 2 * sizeof (uint32_t));
+      const std::string exec_comm
+	= perf_mmap_filename_view (comm, payload_size - 2 * sizeof (uint32_t));
+      size_t slash = binary_path.find_last_of ("/\\");
+      std::string target_comm = (slash != std::string::npos)
+				  ? binary_path.substr (slash + 1)
+				  : binary_path;
+      if (target_comm.size () > PERF_TASK_COMM_LEN - 1)
+	target_comm.resize (PERF_TASK_COMM_LEN - 1);
+      if (exec_comm == target_comm)
+	return;
+
+      unstable_target_pids_.insert (pid);
     }
 }
 
-- 
