+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_summary.h"
+
+#include <cstdint>
+#include <functional>
+#include <map>
+
+namespace gcov {
+namespace {
+
+/* Cumulative profile-count targets in millionths of the total count;
+   for example, 10000 denotes 1 percent.  */
+constexpr uint32_t SUMMARY_CUTOFFS[] = {10000,
+					100000,
+					200000,
+					300000,
+					400000,
+					500000,
+					600000,
+					700000,
+					800000,
+					900000,
+					950000,
+					990000,
+					999000,
+					999900,
+					999990,
+					999999};
+
+/* Count -> number of positions with that count.  */
+using count_histogram = std::map<uint64_t, uint64_t, std::greater<uint64_t>>;
+
+/* Fold every leaf position count of F (recursing into inline subtrees) into the
+   histogram FREQ and the running aggregates.  */
+void
+accumulate (const gcov_function &f, count_histogram &freq, uint64_t &total,
+	    uint64_t &max_count, uint64_t &num_counts)
+{
+  for (const auto &loc : f.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	{
+	  accumulate (
+	    static_cast<const gcov_location_inline *> (loc.get ())->inlined_sym,
+	    freq,
+	    total,
+	    max_count,
+	    num_counts);
+	  continue;
+	}
+      const uint64_t c = loc->total_count ();
+      if (c == 0)
+	continue;
+      total += c;
+      if (c > max_count)
+	max_count = c;
+      ++num_counts;
+      ++freq[c];
+    }
+}
+
+} /* anonymous namespace.  */
+
+void
+compute_summary (const std::vector<gcov_function> &functions, gcov_summary &out)
+{
+  count_histogram freq;
+  uint64_t total = 0, max_count = 0, num_counts = 0, max_function_count = 0;
+  for (const auto &f : functions)
+    {
+      if (f.head_count > max_function_count)
+	max_function_count = f.head_count;
+      accumulate (f, freq, total, max_count, num_counts);
+    }
+
+  out.total_count = total;
+  out.max_count = max_count;
+  out.max_function_count = max_function_count;
+  out.num_counts = num_counts;
+  out.num_functions = static_cast<uint64_t> (functions.size ());
+
+  const unsigned n = sizeof (SUMMARY_CUTOFFS) / sizeof (SUMMARY_CUTOFFS[0]);
+  out.num_detailed_entries = n;
+  out.detailed_entries.assign (n, {});
+
+  auto it = freq.begin ();
+  const auto end = freq.end ();
+  uint64_t curr_sum = 0, counts_seen = 0, count = 0;
+  for (unsigned i = 0; i < n; ++i)
+    {
+      const uint32_t cutoff = SUMMARY_CUTOFFS[i];
+      const unsigned __int128 desired
+	= (unsigned __int128) total * cutoff / 1000000u;
+      while (curr_sum < desired && it != end)
+	{
+	  count = it->first;
+	  curr_sum += it->first * it->second;
+	  counts_seen += it->second;
+	  ++it;
+	}
+      out.detailed_entries[i].cutoff = cutoff;
+      out.detailed_entries[i].min_count = count;
+      out.detailed_entries[i].num_counts = counts_seen;
+    }
+}
+
+} /* namespace gcov.  */
