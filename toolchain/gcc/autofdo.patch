+/* num_locs, then each location.  Builds gcov_location_{normal,call,inline} into
+   FUNC.LOCATIONS.  */
+void
+gcov_reader_v4::read_locations (const uint8_t *&cur, const uint8_t *end,
+				gcov_function &func, unsigned depth)
+{
+  if (depth >= MAX_INLINE_DEPTH)
+    {
+      v4::set_decode_error ("v4: inline callsites nested too deeply");
+      return;
+    }
+  const uint32_t num_locs = read_varint32 (cur, end);
+  /* A location is at least its type byte and a one-byte line offset.  */
