+#ifndef GCC_BRANCH_STACK_READER_BASE_H
+#define GCC_BRANCH_STACK_READER_BASE_H
+
+#include "perf.h"
+
+#include <cstdint>
+#include <unordered_map>
+#include <vector>
+
+namespace perf_data {
+
+class profile_reader;
+
+/* Shared branch-stack and range ingestion for profile readers.  */
+class branch_stack_reader_base
+{
+public:
+  virtual ~branch_stack_reader_base () = default;
+
+  virtual void set_accumulate_sample_ips (bool accumulate) = 0;
+
+  virtual void materialize_address_frequencies_for_per_pc_correlate () {}
+
+  /* Instruction granularity for expanding branch-stack range mass.  */
+  virtual unsigned range_mass_addr_step () const { return 1; }
+
+  void materialize_address_frequencies_from_ranges (
+    std::unordered_map<uint64_t, uint64_t> &address_frequencies) const
+  {
+    if (!address_frequencies.empty () || sorted_ranges_.empty ())
+      return;
+    materialize_address_frequencies_from_range_counts (address_frequencies);
+  }
+
+  bool has_finalized_profile () const { return branch_stack_finalized_; }
+
+  const std::vector<profile_range> &sorted_ranges () const
+  {
+    return sorted_ranges_;
+  }
+
+  const std::vector<profile_branch> &sorted_branches () const
+  {
+    return sorted_branches_;
+  }
+
+protected:
+  bool branch_stack_finalized_ = false;
+  std::vector<profile_range> sorted_ranges_;
+  std::vector<profile_branch> sorted_branches_;
+
+  void reset_branch_stack_profile ()
+  {
+    branch_stack_finalized_ = false;
+    sorted_ranges_.clear ();
+    sorted_branches_.clear ();
+  }
+
+  void finalize_branch_stack_to_file_offsets (
+    branch_stack_edge_count_map &range_count_map,
+    branch_stack_edge_count_map &branch_count_map,
+    const std::vector<simple_mmap> &target_mmaps);
+
+  void
+  build_sorted_touch_pcs_from_ranges (std::vector<uint64_t> *touch_pcs) const;
+
+  /* Common finalize_profile_maps_impl body for perf-file-backed
+     branch-stack readers: no-op when no ranges were accumulated.  */
+  void
+  finalize_branch_stack_maps (branch_stack_edge_count_map &range_count_map,
+			      branch_stack_edge_count_map &branch_count_map,
+			      const std::vector<simple_mmap> &target_mmaps,
+			      std::vector<uint64_t> *touch_pcs_out)
+  {
+    if (range_count_map.empty ())
+      return;
+    finalize_branch_stack_to_file_offsets (
+      range_count_map, branch_count_map, target_mmaps);
+    build_sorted_touch_pcs_from_ranges (touch_pcs_out);
+  }
+
+  void materialize_address_frequencies_from_range_counts (
+    std::unordered_map<uint64_t, uint64_t> &address_frequencies,
+    uint64_t addr_step = 1, bool skip_existing_pcs = false) const;
+
+  bool accumulate_branch_stack_sample (
+    const perf_branch_stack_entry *entries, uint64_t num_branches,
+    uint64_t period, profile_reader &timestamps, uint64_t sample_time,
+    const std::vector<simple_mmap> &target_mmaps,
+    const std::vector<std::pair<uint64_t, uint64_t>> *sorted_ranges,
+    branch_stack_edge_count_map &range_count_map,
+    branch_stack_edge_count_map &branch_count_map) const;
+};
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_BRANCH_STACK_READER_BASE_H.  */
