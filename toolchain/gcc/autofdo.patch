-    set cc_cmd [concat $cc $opts $extra \
+    set cc_cmd [concat $cc $opts $profile_options $extra \
 	[list -fauto-profile=$gcov \
 	      -dumpbase $dumpbase \
 	      $src -o $bin2]]
