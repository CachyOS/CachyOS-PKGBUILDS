+<http://www.gnu.org/licenses/>.  */
+
+#include "perf_file_reader.h"
+#include "perf_branch_stack_reader.h"
+#include "file_mmap.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <cstring>
+#include <cerrno>
+#include <unordered_map>
+#include <vector>
+
+#include <cstdlib>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <elf.h>
+#include <gelf.h>
+#include <libelf.h>
+
+namespace perf_data {
+namespace {
+#ifndef NT_GNU_BUILD_ID
+#define NT_GNU_BUILD_ID 3
+#endif
+
+/* Perf file format constants.  */
+constexpr uint64_t PERF_MAGIC = 0x32454c4946524550ULL; /* "PERFILE2".  */
+
+/* Lowercase hexadecimal digits for build IDs.  */
+constexpr char HEX_DIGITS[] = "0123456789abcdef";
+
+/* User-space address validation constants.  */
+constexpr uint64_t MIN_USER_ADDRESS = 0x1000;
+constexpr uint64_t KERNEL_ADDRESS_MASK = 0xFFFF000000000000ULL;
+
+/* Linux perf_event_attr field offsets.  */
+constexpr size_t PERF_EVENT_ATTR_SAMPLE_TYPE_OFF = 24;
+constexpr size_t PERF_EVENT_ATTR_SIZE_FIELD_OFF = 4;
+constexpr size_t PERF_EVENT_ATTR_MIN_BYTES_FOR_SAMPLE_TYPE = 32;
+constexpr size_t PERF_EVENT_ATTR_READ_FORMAT_OFF = 32;
+constexpr size_t PERF_EVENT_ATTR_MIN_BYTES_THROUGH_READ_FORMAT = 40;
+constexpr size_t PERF_EVENT_ATTR_BRANCH_SAMPLE_TYPE_OFF = 72;
+constexpr size_t PERF_EVENT_ATTR_MIN_BYTES_THROUGH_BRANCH_SAMPLE_TYPE = 80;
+constexpr size_t PERF_EVENT_ATTR_SAMPLE_REGS_USER_OFF = 80;
+constexpr size_t PERF_EVENT_ATTR_MIN_BYTES_THROUGH_SAMPLE_REGS_USER = 88;
+constexpr size_t PERF_EVENT_ATTR_SAMPLE_REGS_INTR_OFF = 96;
+constexpr size_t PERF_EVENT_ATTR_MIN_BYTES_THROUGH_SAMPLE_REGS_INTR = 104;
+constexpr uint16_t PERF_RECORD_MISC_MMAP_BUILD_ID = 1U << 14;
+
+struct segment_info
+{
+  uint64_t p_offset;
+  uint64_t p_filesz;
+  uint64_t p_vaddr;
+};
+
+struct elf_segment_cache
+{
+  std::vector<segment_info> segments;
+  bool is_pie = false;
+};
+
+std::unordered_map<std::string, elf_segment_cache> segment_cache;
+
+/* PT_LOAD table from ELF; empty on failure.  */
+std::vector<segment_info>
+build_segment_table (Elf *elf)
+{
+  std::vector<segment_info> segments;
+  size_t phnum = 0;
+  if (elf_getphdrnum (elf, &phnum) != 0)
+    return segments;
+  for (size_t i = 0; i < phnum; ++i)
+    {
+      GElf_Phdr phdr;
+      if (gelf_getphdr (elf, static_cast<int> (i), &phdr) != &phdr)
+	continue;
+      if (phdr.p_type != PT_LOAD)
+	continue;
+      segments.push_back ({static_cast<uint64_t> (phdr.p_offset),
+			   static_cast<uint64_t> (phdr.p_filesz),
+			   static_cast<uint64_t> (phdr.p_vaddr)});
+    }
+  return segments;
+}
+
+/* p_vaddr for pgoff from the segment table.  */
+bool
+lookup_vaddr (const std::vector<segment_info> &segments, uint64_t pgoff,
+	      uint64_t &out)
+{
+  if (segments.empty ())
+    return false;
+
+  uint64_t fallback = 0;
+  bool have_fallback = false;
+  uint64_t first_nonzero_p_vaddr = 0;
+  bool have_first_nonzero = false;
+
+  for (const auto &s : segments)
+    {
+      if (!have_first_nonzero && s.p_vaddr != 0)
+	{
+	  first_nonzero_p_vaddr = s.p_vaddr;
+	  have_first_nonzero = true;
+	}
+
+      if (s.p_offset == pgoff)
+	{
+	  out = s.p_vaddr;
+	  return true;
+	}
+
+      if (s.p_offset <= pgoff && pgoff - s.p_offset < s.p_filesz)
+	{
+	  const uint64_t offset = pgoff - s.p_offset;
+	  if (!have_fallback && offset <= UINT64_MAX - s.p_vaddr)
+	    {
+	      fallback = s.p_vaddr + offset;
+	      have_fallback = true;
+	    }
+	}
+    }
+  if (have_fallback)
+    {
+      out = fallback;
+      return true;
+    }
+  /* pgoff 0 fallback: first nonzero PT_LOAD p_vaddr.  */
+  if (pgoff == 0 && have_first_nonzero)
+    {
+      out = first_nonzero_p_vaddr;
+      return true;
+    }
+  return false;
+}
+
+std::string
+hex_encode_build_id (const uint8_t *build_id, size_t build_id_len)
+{
+  if (build_id == nullptr || build_id_len > SIZE_MAX / 2)
+    return {};
+  std::string encoded (build_id_len * 2, '\0');
+  for (size_t i = 0; i < build_id_len; i++)
+    {
+      encoded[2 * i] = HEX_DIGITS[build_id[i] >> 4];
+      encoded[2 * i + 1] = HEX_DIGITS[build_id[i] & 0x0f];
+    }
+  return encoded;
+}
+
+/* Parse .note.gnu.build-id from SHT_NOTE section payload.  */
+bool
+gnu_build_id_from_note_data (Elf_Data *data, std::string &out)
+{
+  size_t offset = 0;
+  GElf_Nhdr nhdr;
+  size_t name_off, desc_off;
+  while ((offset = gelf_getnote (data, offset, &nhdr, &name_off, &desc_off))
+	 != 0)
+    {
+      if (nhdr.n_type != NT_GNU_BUILD_ID)
+	continue;
+      const char *note_name
+	= static_cast<const char *> (data->d_buf) + name_off;
+      if (nhdr.n_namesz < 4 || memcmp (note_name, "GNU", 4) != 0)
+	continue;
+
+      const uint8_t *build_id
+	= static_cast<const uint8_t *> (data->d_buf) + desc_off;
+      size_t build_id_len = nhdr.n_descsz;
+      out = hex_encode_build_id (build_id, build_id_len);
+      return true;
+    }
+  return false;
+}
+
+/* ELF .note.gnu.build-id as hex.  */
+std::string
+get_buildid_from_binary (const std::string &binary_path)
+{
+  if (elf_version (EV_CURRENT) == EV_NONE)
+    return {};
+
+  int fd = open (binary_path.c_str (), O_RDONLY);
+  if (fd < 0 && !binary_path.empty () && binary_path[0] != '/')
+    {
+      char *resolved = realpath (binary_path.c_str (), nullptr);
+      if (resolved)
+	{
+	  fd = open (resolved, O_RDONLY);
+	  std::free (resolved);
+	}
+    }
+  if (fd < 0)
+    return {};
+
+  Elf *elf = elf_begin (fd, ELF_C_READ, nullptr);
+  if (!elf)
+    {
+      close (fd);
+      return {};
+    }
+
+  if (elf_kind (elf) != ELF_K_ELF)
+    {
+      elf_end (elf);
+      close (fd);
+      return {};
+    }
+
+  Elf_Scn *scn = nullptr;
+  while ((scn = elf_nextscn (elf, scn)) != nullptr)
+    {
+      GElf_Shdr shdr;
+      if (gelf_getshdr (scn, &shdr) == nullptr)
+	continue;
+      if (shdr.sh_type != SHT_NOTE)
+	continue;
+
+      Elf_Data *data = elf_getdata (scn, nullptr);
+      if (data == nullptr || data->d_size == 0)
+	continue;
+
+      std::string decrypted;
+      if (gnu_build_id_from_note_data (data, decrypted))
+	{
+	  elf_end (elf);
+	  close (fd);
+	  return decrypted;
+	}
+    }
+
+  elf_end (elf);
+  close (fd);
+  return {};
+}
+
+} /* anonymous namespace.  */
+
+std::unique_ptr<profile_reader>
+create_perf_reader (const std::string &perf_data_path,
+		    const std::string &binary_path, sampling_mode mode)
+{
+  switch (mode)
+    {
+    case sampling_mode::BRANCH_STACK:
+      return std::make_unique<perf_branch_stack_reader> (
+	perf_data_path, binary_path);
+
+    default:
+      fprintf (stderr, "Error: Unknown sampling mode\n");
+      return nullptr;
+    }
+}
+
+/* PT_LOAD p_vaddr for pgoff; false if not ELF or no match.  */
+bool
+get_elf_segment_vaddr_for_pgoff (const std::string &binary_path, uint64_t pgoff,
+				 uint64_t &out)
+{
+  if (elf_version (EV_CURRENT) == EV_NONE)
+    return false;
+
+  auto it = segment_cache.find (binary_path);
+  if (it == segment_cache.end ())
+    {
+      int fd = open (binary_path.c_str (), O_RDONLY);
+      if (fd < 0 && !binary_path.empty () && binary_path[0] != '/')
+	{
+	  char *resolved = realpath (binary_path.c_str (), nullptr);
+	  if (resolved)
+	    {
+	      fd = open (resolved, O_RDONLY);
+	      std::free (resolved);
+	    }
+	}
+      if (fd < 0)
+	return false;
+
+      Elf *elf = elf_begin (fd, ELF_C_READ, nullptr);
+      close (fd);
+      if (!elf)
+	return false;
+
+      if (elf_kind (elf) != ELF_K_ELF)
+	{
+	  elf_end (elf);
+	  return false;
+	}
+
+      elf_segment_cache cache;
+      cache.segments = build_segment_table (elf);
+      GElf_Ehdr ehdr;
+      if (gelf_getehdr (elf, &ehdr) == &ehdr)
+	cache.is_pie = (ehdr.e_type == ET_DYN);
+      elf_end (elf);
+      it = segment_cache.emplace (binary_path, std::move (cache)).first;
+    }
+
+  return lookup_vaddr (it->second.segments, pgoff, out);
+}
+
+/* True if binary is PIE (ET_DYN); requires prior segment cache fill.  */
+bool
+get_elf_is_pie (const std::string &binary_path)
+{
+  auto it = segment_cache.find (binary_path);
+  return it != segment_cache.end () && it->second.is_pie;
+}
+
+perf_file_reader::~perf_file_reader () { cleanup (); }
+
+bool
+perf_file_reader::load ()
+{
+  cleanup ();
+  if (!open_and_map_file ())
+    return false;
+
+  if (!parse_header ())
+    return false;
+
+  if (!parse_perf_data_section ())
+    return false;
+
+  if (target_mmaps.empty ())
+    {
+      std::string base
+	= binary_path.substr (binary_path.find_last_of ("/\\") + 1);
+      fprintf (stderr,
+	       "Error: No memory mappings found for '%s'. perf.data may be "
+	       "from a different binary. Ensure it was collected while "
+	       "running: %s\n",
+	       base.c_str (),
+	       binary_path.c_str ());
+      return false;
+    }
+
+  finalize_profile_to_file_offsets ();
+  return true;
+}
+
+uint64_t
+perf_file_reader::translate_address (uint64_t runtime_addr) const
+{
+  if (profile_addresses_are_file_offsets_)
+    return runtime_addr;
+  return translate_runtime_with_mmaps (target_mmaps, runtime_addr);
+}
+
+bool
+perf_file_reader::open_and_map_file ()
+{
+  if (!mapped_file_.map (perf_data_path))
+    {
+      fprintf (stderr,
+	       "Failed to mmap perf.data file: %s (errno: %d)\n",
+	       perf_data_path.c_str (),
+	       errno);
+      return false;
+    }
+  return true;
+}
+
+void
+perf_file_reader::cleanup ()
+{
+  mapped_file_.unmap ();
+  reset_profile_state ();
+  address_frequencies.clear ();
+  target_mmaps.clear ();
+  target_address_ranges_.clear ();
+  target_address_ranges_valid_ = false;
+  buildid_table_.clear ();
+  buildid_table_valid_ = false;
+  cached_target_build_id_.clear ();
+  cached_target_build_id_valid_ = false;
+  total_samples = 0;
+  header = {};
+  sample_type = DEFAULT_BRANCH_STACK_SAMPLE_TYPE;
+  read_format = 0;
+  branch_sample_type = 0;
+  sample_regs_user = 0;
+  sample_regs_intr = 0;
+}
+
+/* Parse perf.data file header.  */
+bool
+perf_file_reader::parse_header ()
+{
+  if (mapped_file_.size () < sizeof (header))
+    {
+      fprintf (stderr, "File too small to contain perf header\n");
+      return false;
+    }
+
+  std::memcpy (&header, mapped_file_.data (), sizeof (header));
+
+  if (header.magic != PERF_MAGIC)
+    {
+      fprintf (stderr,
+	       "Invalid perf.data magic number: 0x%" PRIx64 "\n",
+	       header.magic);
+      return false;
+    }
+
+  const uint8_t *const base = mapped_file_.data ();
+  if (header.attrs_size > 0 && header.attrs_offset > 0
+      && header.attrs_offset < mapped_file_.size ()
+      && header.attrs_size <= mapped_file_.size () - header.attrs_offset)
+    {
+      const uint8_t *const attrs = base + header.attrs_offset;
+
+      uint32_t first_attr_sz = 0;
+      if (header.attrs_size >= sizeof (uint32_t) * 2)
+	first_attr_sz = read_u32 (attrs + PERF_EVENT_ATTR_SIZE_FIELD_OFF);
+
+      const uint64_t published
+	= first_attr_sz > 0 ? first_attr_sz : header.attr_size;
+      const uint64_t eff_attr
+	= std::min (header.attrs_size, std::min (header.attr_size, published));
+
+      if (eff_attr >= PERF_EVENT_ATTR_MIN_BYTES_FOR_SAMPLE_TYPE)
+	{
+	  sample_type = read_u64 (attrs + PERF_EVENT_ATTR_SAMPLE_TYPE_OFF);
+	}
+
+      if (eff_attr >= PERF_EVENT_ATTR_MIN_BYTES_THROUGH_READ_FORMAT)
+	read_format = read_u64 (attrs + PERF_EVENT_ATTR_READ_FORMAT_OFF);
+      if (eff_attr >= PERF_EVENT_ATTR_MIN_BYTES_THROUGH_BRANCH_SAMPLE_TYPE)
+	branch_sample_type
+	  = read_u64 (attrs + PERF_EVENT_ATTR_BRANCH_SAMPLE_TYPE_OFF);
+      if (eff_attr >= PERF_EVENT_ATTR_MIN_BYTES_THROUGH_SAMPLE_REGS_USER)
+	sample_regs_user
+	  = read_u64 (attrs + PERF_EVENT_ATTR_SAMPLE_REGS_USER_OFF);
+      if (eff_attr >= PERF_EVENT_ATTR_MIN_BYTES_THROUGH_SAMPLE_REGS_INTR)
+	sample_regs_intr
+	  = read_u64 (attrs + PERF_EVENT_ATTR_SAMPLE_REGS_INTR_OFF);
+    }
+
+  return true;
+}
+
+void
+perf_file_reader::finalize_profile_maps_impl ()
+{}
+
+bool
+perf_file_reader::finalize_profile_to_file_offsets ()
+{
+  if (profile_addresses_are_file_offsets_)
+    return true;
+
+  finalize_profile_maps_impl ();
+  finalize_address_frequencies_to_file_offsets ();
+  clear_runtime_translation_state ();
+  profile_addresses_are_file_offsets_ = true;
+  return true;
+}
+
+void
+perf_file_reader::finalize_address_frequencies_to_file_offsets ()
+{
+  finalize_address_frequencies_with_mmaps (
+    address_frequencies, target_mmaps, &sorted_touch_pcs_);
+}
+
+void
+perf_file_reader::clear_runtime_translation_state ()
+{
+  target_mmaps.clear ();
+  target_mmaps.shrink_to_fit ();
+  target_address_ranges_.clear ();
+  target_address_ranges_.shrink_to_fit ();
+  target_address_ranges_valid_ = false;
+  buildid_table_.clear ();
+  buildid_table_valid_ = false;
+  cached_target_build_id_.clear ();
+  cached_target_build_id_valid_ = false;
+}
+
+void
+perf_file_reader::for_each_mapped_perf_data_record (
+  const std::function<
+    void (size_t record_index, size_t data_section_bytes_remaining,
+	  const perf_event_header &hdr, const uint8_t *payload,
+	  size_t payload_size, size_t skip_whole)> &fn)
+{
+  const uint8_t *const mapped = mapped_file_.data ();
+  size_t logical = 0;
+  if (header.data_offset > mapped_file_.size ())
+    return;
+  const size_t data_offset = static_cast<size_t> (header.data_offset);
+  const size_t available = mapped_file_.size () - data_offset;
+  if (header.data_size > available)
+    logical = available;
+  else
+    logical = static_cast<size_t> (header.data_size);
+
+  const uint8_t *local_ptr = mapped + data_offset;
+  size_t local_rem = logical;
+  size_t total_records = 0;
+
+  while (local_rem >= sizeof (perf_event_header))
+    {
+      total_records++;
+      perf_event_header record_header;
+      std::memcpy (&record_header, local_ptr, sizeof (perf_event_header));
+      if (record_header.size == 0)
+	break;
+      if (record_header.size < sizeof (perf_event_header)
+	  || record_header.size > local_rem)
+	{
+	  fprintf (stderr,
+		   "%s: Invalid record size (%u) at record %zu. Stopping.\n",
+		   "PERF",
+		   (unsigned) record_header.size,
+		   total_records);
+	  break;
+	}
+
+      const uint8_t *payload_ptr = local_ptr + sizeof (perf_event_header);
+      const size_t payload_size
+	= record_header.size - sizeof (perf_event_header);
+
+      const size_t skip
+	= perf_record_skip_bytes (record_header, payload_ptr, local_rem);
+      if (skip == 0)
+	{
+	  fprintf (stderr,
+		   "%s: Invalid record advance at record %zu (type %u). "
+		   "Stopping.\n",
+		   "PERF",
+		   total_records,
+		   (unsigned) record_header.type);
+	  break;
+	}
+
+      local_ptr += skip;
+      local_rem -= skip;
+      fn (total_records,
+	  local_rem,
+	  record_header,
+	  payload_ptr,
+	  payload_size,
+	  skip);
+    }
+}
+
+size_t
+perf_file_reader::perf_record_skip_bytes (
+  const perf_event_header &record_header, const uint8_t *payload,
+  size_t _data_remaining) const
+{
+  if (record_header.size < sizeof (perf_event_header))
+    return 0;
+  if (record_header.size > _data_remaining)
+    return 0;
+
+  if (record_header.type != static_cast<uint32_t> (perf_record_type::AUXTRACE))
+    return record_header.size;
+
+  const size_t payload_size = record_header.size - sizeof (perf_event_header);
+  if (payload_size < sizeof (uint64_t))
+    return record_header.size;
+
+  uint64_t inline_tail = read_u64 (payload);
+  const size_t base = record_header.size;
+  if (inline_tail > SIZE_MAX - base)
+    return 0;
+  const size_t total = base + static_cast<size_t> (inline_tail);
+  if (total > _data_remaining)
+    return 0;
+  return total;
+}
+
+void
+perf_file_reader::add_target_mmap (const std::string &mmap_filename,
+				   uint64_t start, uint64_t end, uint64_t pgoff)
+{
+  if (!try_merge_target_mmap (target_mmaps, start, end, pgoff))
+    {
+      std::string elf_path = mmap_filename;
+      const size_t deleted = elf_path.find (" (deleted)");
+      if (deleted != std::string::npos)
+	elf_path.erase (deleted);
+      if (elf_path.empty ())
+	elf_path = binary_path;
+
+      uint64_t vaddr = 0;
+      bool have_vaddr
+	= get_elf_segment_vaddr_for_pgoff (elf_path, pgoff, vaddr);
+      if (!have_vaddr && elf_path != binary_path)
+	have_vaddr
+	  = get_elf_segment_vaddr_for_pgoff (binary_path, pgoff, vaddr);
+      const bool is_pie
+	= get_elf_is_pie (elf_path) || get_elf_is_pie (binary_path);
+      target_mmaps.emplace_back (start, end, pgoff, vaddr, is_pie);
+    }
+  target_address_ranges_valid_ = false;
+}
+
+bool
+perf_file_reader::parse_mmap_record (const uint8_t *record_data,
+				     size_t record_size)
+{
+  if (record_size < sizeof (perf_mmap_record))
+    return false; /* Record too small.  */
+
+  perf_mmap_record mmap;
+  std::memcpy (&mmap, record_data, sizeof (mmap));
+
+  /* Filename follows the fixed-size header; copy its bounded record bytes.  */
+  const char *filename
+    = reinterpret_cast<const char *> (record_data + sizeof (perf_mmap_record));
+  const size_t filename_max_len = record_size - sizeof (perf_mmap_record);
+  const std::string mmap_filename
+    = perf_mmap_filename_view (filename, filename_max_len);
+
+  if (!is_valid_user_address (mmap.addr))
+    return true;
+
+  uint64_t end = 0;
+  if (!try_compute_mmap_end (mmap.addr, mmap.len, &end))
+    return true;
+  if (!is_target_binary (mmap_filename, ""))
+    return true;
+
+  add_target_mmap (mmap_filename, mmap.addr, end, mmap.pgoff);
+  return true;
+}
+
+bool
+perf_file_reader::parse_mmap2_record (const uint8_t *record_data,
+				      size_t record_size, uint16_t misc)
+{
+  if (record_size < sizeof (perf_mmap2_record))
+    return false; /* Record too small.  */
+
+  perf_mmap2_record mmap2;
+  std::memcpy (&mmap2, record_data, sizeof (mmap2));
+
+  const char *filename
+    = reinterpret_cast<const char *> (record_data + sizeof (perf_mmap2_record));
+  const size_t filename_max_len = record_size - sizeof (perf_mmap2_record);
+  const std::string mmap_filename
+    = perf_mmap_filename_view (filename, filename_max_len);
+
+  if (!is_valid_user_address (mmap2.addr))
+    return true;
+
+  uint64_t end = 0;
+  if (!try_compute_mmap_end (mmap2.addr, mmap2.len, &end))
+    return true;
+
+  std::string build_id;
+  if (misc & PERF_RECORD_MISC_MMAP_BUILD_ID)
+    {
+      const size_t build_id_size = std::min<size_t> (
+	mmap2.id.build.build_id_size, sizeof (mmap2.id.build.build_id));
+      build_id = hex_encode_build_id (mmap2.id.build.build_id, build_id_size);
+    }
+  if (!is_target_binary (mmap_filename, build_id))
+    return true;
+
+  add_target_mmap (mmap_filename, mmap2.addr, end, mmap2.pgoff);
+  return true;
+}
+
+bool
+perf_file_reader::is_target_binary (const std::string &mmap_filename,
+				    const std::string &build_id) const
+{
+  if (mmap_filename.empty ())
+    return false;
+
+  if (!cached_target_build_id_valid_)
+    {
+      cached_target_build_id_ = get_buildid_from_binary (binary_path);
+      cached_target_build_id_valid_ = true;
+    }
+  if (!buildid_table_valid_)
+    parse_build_id_table ();
+
+  /* First try with Build IDs.  */
+  if (build_id != "" && cached_target_build_id_ == build_id)
+    return true;
+
+  /* Match via HEADER_BUILD_ID table (renamed/relocated binaries).  */
+  if (!cached_target_build_id_.empty () && !buildid_table_.empty ())
+    {
+      auto it = buildid_table_.find (mmap_filename);
+      if (it != buildid_table_.end () && it->second == cached_target_build_id_)
+	return true;
+    }
+
+  const std::string &target_path = binary_path;
+  size_t tp = target_path.find_last_of ("/\\");
+  std::string target_basename
+    = (tp != std::string::npos) ? target_path.substr (tp + 1) : target_path;
+  size_t mp = mmap_filename.find_last_of ("/\\");
+  std::string mmap_basename
+    = (mp != std::string::npos) ? mmap_filename.substr (mp + 1) : mmap_filename;
+  return mmap_basename == target_basename;
+}
+
+/* Reject kernel and very low addresses.  */
+bool
+perf_file_reader::is_valid_user_address (uint64_t addr) const
+{
+  const bool is_kernel = (addr & KERNEL_ADDRESS_MASK) == KERNEL_ADDRESS_MASK;
+  return addr >= MIN_USER_ADDRESS && !is_kernel;
+}
+
+bool
+perf_file_reader::rebuild_target_address_ranges () const
+{
+  target_address_ranges_.clear ();
+  target_address_ranges_.reserve (target_mmaps.size ());
+  for (const auto &m : target_mmaps)
+    target_address_ranges_.emplace_back (m.start_addr, m.end_addr);
+  std::sort (target_address_ranges_.begin (), target_address_ranges_.end ());
+  if (target_address_ranges_.empty ())
+    return false;
+  size_t w = 0;
+  for (size_t i = 1; i < target_address_ranges_.size (); ++i)
+    {
+      if (target_address_ranges_[i].first <= target_address_ranges_[w].second)
+	target_address_ranges_[w].second = std::max (
+	  target_address_ranges_[w].second, target_address_ranges_[i].second);
+      else
+	target_address_ranges_[++w] = target_address_ranges_[i];
+    }
+  target_address_ranges_.resize (w + 1);
+  target_address_ranges_valid_ = true;
+  return true;
+}
+
+bool
+perf_file_reader::is_target_address (uint64_t address) const
+{
+  if (target_mmaps.empty ())
+    return false;
+  if (target_mmaps.size () == 1)
+    return target_mmaps[0].contains (address);
+  if (!target_address_ranges_valid_ && !rebuild_target_address_ranges ())
+    return false;
+  return target_address_ranges_contain (target_address_ranges_, address);
+}
+
+const std::vector<std::pair<uint64_t, uint64_t>> *
+perf_file_reader::sorted_target_address_ranges_for_branch_stack () const
+{
+  if (target_mmaps.size () <= 1)
+    return nullptr;
+  if (!target_address_ranges_valid_ && !rebuild_target_address_ranges ())
+    return nullptr;
+  return &target_address_ranges_;
+}
+
+/* Parse HEADER_BUILD_ID into a filename-to-hex-build-id map.  */
+void
+perf_file_reader::parse_build_id_table () const
+{
+  buildid_table_valid_ = true;
+  if (!mapped_file_)
+    return;
+
+  constexpr int BUILD_ID_FEATURE_BIT = 2;
+  const uint64_t feats = header.features;
+  if (!((feats >> BUILD_ID_FEATURE_BIT) & 1ULL))
+    return;
+
+  const uint8_t *const base = mapped_file_.data ();
+  const size_t file_size = mapped_file_.size ();
+  if (header.data_offset > file_size
+      || header.data_size > file_size - header.data_offset)
+    return;
+  const uint64_t sec_table = header.data_offset + header.data_size;
+  /* Section index = number of feature bits set below bit 2.  */
+  int index = 0;
+  for (int b = 0; b < BUILD_ID_FEATURE_BIT; ++b)
+    if ((feats >> b) & 1ULL)
+      ++index;
+  const uint64_t entry_off
+    = sec_table + static_cast<uint64_t> (index) * 16; /* {u64 off; u64 size;} */
+  if (entry_off > file_size || 16 > file_size - entry_off)
+    return;
+  uint64_t bid_off = read_u64 (base + entry_off);
+  uint64_t bid_size = read_u64 (base + entry_off + 8);
+  if (bid_size == 0 || bid_off > file_size || bid_size > file_size - bid_off)
+    return;
+
+  const uint8_t *p = base + bid_off;
+  const uint8_t *const end = p + bid_size;
+  /* build_id_event: hdr(8) + pid(4) + build_id[24] + filename.  */
+  constexpr size_t BUILD_ID_NAME_OFF = sizeof (perf_event_header) + 4 + 24;
+  constexpr size_t BUILD_ID_OFF = sizeof (perf_event_header) + 4;
+  constexpr size_t BUILD_ID_LEN = 20;
+  while (static_cast<size_t> (end - p) >= sizeof (perf_event_header))
+    {
+      perf_event_header h;
+      std::memcpy (&h, p, sizeof h);
+      if (h.size < sizeof (perf_event_header)
+	  || h.size > static_cast<size_t> (end - p))
+	break;
+      if (h.size > BUILD_ID_NAME_OFF)
+	{
+	  std::string hex
+	    = hex_encode_build_id (p + BUILD_ID_OFF, BUILD_ID_LEN);
+	  const char *fname
+	    = reinterpret_cast<const char *> (p + BUILD_ID_NAME_OFF);
+	  const size_t maxlen = h.size - BUILD_ID_NAME_OFF;
+	  const size_t flen = ::strnlen (fname, maxlen);
+	  if (flen != 0)
+	    buildid_table_.emplace (std::string (fname, flen), std::move (hex));
+	}
+      p += h.size;
+    }
+}
+
+} /* namespace perf_data.  */
