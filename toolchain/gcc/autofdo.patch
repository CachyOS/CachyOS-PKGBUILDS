+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_PERF_BRANCH_STACK_READER_H
+#define GCC_PERF_BRANCH_STACK_READER_H
+
+#include "branch_stack_reader_base.h"
+#include "perf_file_reader.h"
+
+#include <cstdint>
+#include <string>
+
+namespace perf_data {
+
+/* Offline LBR/BRBE converts SAMPLE + BRANCH_STACK into range/branch maps.  */
+class perf_branch_stack_reader : public perf_file_reader,
+				 public branch_stack_reader_base
+{
+public:
+  perf_branch_stack_reader (const std::string &_perf_data_path,
+			    const std::string &_binary_path);
+  ~perf_branch_stack_reader () override = default;
+
+  branch_stack_reader_base *as_branch_stack_reader () override { return this; }
+  const branch_stack_reader_base *as_branch_stack_reader () const override
+  {
+    return this;
+  }
+
+private:
+  /* Bind the target mappings, then ingest the branch-stack samples.  */
+  bool parse_perf_data_section () override;
+
+  /* Ingest one sample.  Returns true when it contributed mass.  */
+  bool parse_sample_record (const uint8_t *record_data, size_t record_size);
+
+  /* As PARSE_SAMPLE_RECORD, for the common sample layout whose field offsets
+     are known up front, so the record needs no field-by-field walk.  */
+  bool
+  parse_sample_record_fixed_branch_stack_layout (const uint8_t *record_data,
+						 size_t record_size);
+
+  /* Report range mass when there is any, else per-PC mass.  */
+  void compute_profile_mass ();
+
+  /* One malformed sample usually means the rest are too.  Print MESSAGE for
+     the first and count the others.  */
+  void warn_bad_sample (const char *message);
+
+  branch_stack_edge_count_map range_count_map;
+  branch_stack_edge_count_map branch_count_map;
+
+  size_t bad_samples_ = 0;
+  bool use_fixed_layout_branch_stack_parse_ = false;
+};
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_BRANCH_STACK_READER_H.  */
