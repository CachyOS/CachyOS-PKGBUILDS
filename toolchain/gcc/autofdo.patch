diff --git a/afdo_tools/src/dwarf_types.h b/afdo_tools/src/dwarf_types.h
new file mode 100644
index 00000000000..ef11bf6ae90
--- /dev/null
+++ b/afdo_tools/src/dwarf_types.h
@@ -0,0 +1,181 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_DWARF_TYPES_H
+#define GCC_DWARF_TYPES_H
+
+#include "hash_util.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace dwarf_debug {
+
+using interned_string = const std::string *;
+
+/* Empty interned values are represented by nullptr.  */
+inline const std::string &
+string_value (interned_string value)
+{
+  static const std::string empty;
+  return value == nullptr ? empty : *value;
+}
+
+inline bool
+string_empty (interned_string value)
+{
+  return value == nullptr || value->empty ();
+}
+
+struct function_instance_key
+{
+  interned_string name = nullptr;
+  uint64_t start_addr = 0;
+
+  bool operator== (const function_instance_key &o) const noexcept
+  {
+    return start_addr == o.start_addr && name == o.name;
+  }
+};
+
+struct function_instance_key_hash
+{
+  size_t operator() (const function_instance_key &key) const noexcept
+  {
+    size_t hash = std::hash<interned_string>{}(key.name);
+    autofdo::hash_combine (hash, std::hash<uint64_t>{}(key.start_addr));
+    return hash;
+  }
+};
+
+/* ELF symbol range with DWARF export anchors.  */
+struct function_metadata
+{
+  interned_string name = nullptr;
+  interned_string file_path = nullptr;
+  uint64_t start_addr = 0;
+  uint64_t end_addr = 0;
+  uint32_t start_line = 0;
+
+  function_metadata () = default;
+  function_metadata (interned_string n, interned_string file, uint64_t start,
+		     uint64_t end, uint32_t sl = 0)
+    : name (n), file_path (file), start_addr (start), end_addr (end),
+      start_line (sl)
+  {}
+};
+
+struct function_alias_metadata
+{
+  function_metadata function;
+  size_t primary_index = 0;
+};
+
+struct inline_frame
+{
+  interned_string function_name = nullptr;
+  interned_string file_path = nullptr;
+  interned_string caller_file_path = nullptr;
+  uint32_t line_number = 0;
+  uint32_t call_line = 0;
+  uint32_t discriminator = 0;
+};
+
+struct source_location
+{
+  interned_string file_path = nullptr;
+  uint32_t line_number = 0;
+  uint32_t discriminator = 0;
+};
+
+struct symbolized_result
+{
+  const function_metadata *function = nullptr;
+  const std::vector<source_location> *locations = nullptr;
+  /* Inline stack (reader-owned when set).  */
+  const std::vector<inline_frame> *inline_stack = nullptr;
+};
+
+struct inline_function_identity
+{
+  std::string file_path;
+  uint32_t decl_line = 0;
+};
+
+struct dwarf_load_summary
+{
+  size_t touch_cus = 0;
+  size_t dwarf_functions = 0;
+  size_t symtab_functions = 0;
+  size_t line_segments = 0;
+  /* Unique profile-touch PCs (range endpoints); not a symbolize cache size.  */
+  size_t touch_pcs = 0;
+};
+
+inline uint64_t
+hash_inline_frame_stack (const std::vector<inline_frame> &stack)
+{
+  uint64_t h = 0;
+  for (const inline_frame &frame : stack)
+    {
+      autofdo::hash_combine (
+	h,
+	static_cast<uint64_t> (
+	  std::hash<interned_string>{}(frame.function_name)));
+      autofdo::hash_combine (
+	h,
+	static_cast<uint64_t> (std::hash<interned_string>{}(frame.file_path)));
+      autofdo::hash_combine (
+	h,
+	static_cast<uint64_t> (
+	  std::hash<interned_string>{}(frame.caller_file_path)));
+      autofdo::hash_combine (
+	h, static_cast<uint64_t> (std::hash<uint32_t>{}(frame.line_number)));
+      autofdo::hash_combine (
+	h, static_cast<uint64_t> (std::hash<uint32_t>{}(frame.call_line)));
+      autofdo::hash_combine (
+	h, static_cast<uint64_t> (std::hash<uint32_t>{}(frame.discriminator)));
+    }
+  return h;
+}
+
+inline bool
+inline_stacks_equal (const std::vector<inline_frame> &a,
+		     const std::vector<inline_frame> &b)
+{
+  if (a.size () != b.size ())
+    return false;
+  for (size_t i = 0; i < a.size (); ++i)
+    {
+      const inline_frame &fa = a[i];
+      const inline_frame &fb = b[i];
+      if (fa.function_name != fb.function_name || fa.file_path != fb.file_path
+	  || fa.caller_file_path != fb.caller_file_path
+	  || fa.line_number != fb.line_number || fa.call_line != fb.call_line
+	  || fa.discriminator != fb.discriminator)
+	return false;
+    }
+  return true;
+}
+
+} /* namespace dwarf_debug.  */
+
+#endif /* GCC_DWARF_TYPES_H.  */
diff --git a/afdo_tools/src/function_metadata_util.h b/afdo_tools/src/function_metadata_util.h
new file mode 100644
index 00000000000..85d62c0f86a
--- /dev/null
+++ b/afdo_tools/src/function_metadata_util.h
@@ -0,0 +1,150 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_FUNCTION_METADATA_UTIL_H
+#define GCC_FUNCTION_METADATA_UTIL_H
+
+#include "dwarf_types.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace dwarf_debug {
+
+inline bool
+function_has_valid_range (const function_metadata &func)
+{
+  return func.end_addr > func.start_addr;
+}
+
+inline bool
+address_in_function_range (const function_metadata &func, uint64_t address)
+{
+  return address >= func.start_addr && address < func.end_addr;
+}
+
+/* PC containment via sorted [start,end) function list (symtab or DWARF).  */
+inline const function_metadata *
+function_containing_address (const std::vector<function_metadata> &funcs,
+			     uint64_t address)
+{
+  if (funcs.empty ())
+    return nullptr;
+  auto it
+    = std::upper_bound (funcs.begin (),
+			funcs.end (),
+			address,
+			[] (uint64_t addr, const function_metadata &func) {
+			  return addr < func.start_addr;
+			});
+  if (it == funcs.begin ())
+    return nullptr;
+  const function_metadata *candidate = &*std::prev (it);
+  if (address_in_function_range (*candidate, address))
+    return candidate;
+  return nullptr;
+}
+
+/* Monotonic sweep hint for sorted profile ranges (O(1) amortized per step).  */
+inline const function_metadata *
+function_containing_address (const std::vector<function_metadata> &funcs,
+			     uint64_t address, size_t &hint)
+{
+  if (funcs.empty ())
+    return nullptr;
+  if (hint >= funcs.size ())
+    hint = funcs.size () - 1;
+  while (hint + 1 < funcs.size () && funcs[hint + 1].start_addr <= address)
+    ++hint;
+  while (hint > 0 && address < funcs[hint].start_addr)
+    --hint;
+  const function_metadata &candidate = funcs[hint];
+  if (address_in_function_range (candidate, address))
+    return &candidate;
+  const function_metadata *found = function_containing_address (funcs, address);
+  if (found != nullptr)
+    hint = static_cast<size_t> (found - funcs.data ());
+  return found;
+}
+
+inline size_t
+function_index_from_ptr (const function_metadata *func,
+			 const std::vector<function_metadata> &funcs)
+{
+  if (func == nullptr || funcs.empty ())
+    return static_cast<size_t> (-1);
+  const function_metadata *const base = funcs.data ();
+  const function_metadata *const end = base + funcs.size ();
+  if (func >= base && func < end)
+    return static_cast<size_t> (func - base);
+  return static_cast<size_t> (-1);
+}
+
+/* Resolve callees only at an exact symtab entry PC.  Do not use
+   function_containing_address: another overlapping symbol range may contain
+   the same PC (for example, with ICF, COMDAT, or .cold partitions).  */
+inline const function_metadata *
+function_at_entry_pc (const std::vector<function_metadata> &funcs, uint64_t pc)
+{
+  if (funcs.empty ())
+    return nullptr;
+  auto it
+    = std::lower_bound (funcs.begin (),
+			funcs.end (),
+			pc,
+			[] (const function_metadata &func, uint64_t addr) {
+			  return func.start_addr < addr;
+			});
+  for (; it != funcs.end () && it->start_addr == pc; ++it)
+    {
+      if (!string_empty (it->name) && function_has_valid_range (*it))
+	return &*it;
+    }
+  return nullptr;
+}
+
+/* Sort merged subprogram rows for binary search; drop exact duplicates only. */
+inline void
+sort_dedupe_function_metadata (std::vector<function_metadata> &funcs)
+{
+  if (funcs.empty ())
+    return;
+  std::sort (funcs.begin (),
+	     funcs.end (),
+	     [] (const function_metadata &a, const function_metadata &b) {
+	       if (a.start_addr != b.start_addr)
+		 return a.start_addr < b.start_addr;
+	       if (a.end_addr != b.end_addr)
+		 return a.end_addr < b.end_addr;
+	       return a.name < b.name;
+	     });
+  funcs.erase (
+    std::unique (funcs.begin (),
+		 funcs.end (),
+		 [] (const function_metadata &a, const function_metadata &b) {
+		   return a.start_addr == b.start_addr
+			  && a.end_addr == b.end_addr && a.name == b.name;
+		 }),
+    funcs.end ());
+}
+
+} /* namespace dwarf_debug.  */
+
+#endif /* GCC_FUNCTION_METADATA_UTIL_H.  */
