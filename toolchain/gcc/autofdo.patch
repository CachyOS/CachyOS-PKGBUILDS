new file mode 100644
index 00000000000..eef09ec4b12
--- /dev/null
+++ b/afdo_tools/src/autofdo_debug_dump.cc
@@ -0,0 +1,254 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "autofdo_debug_dump.h"
+
+#include "dwarf_reader.h"
+#include "profile_reader.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <vector>
+
+namespace autofdo {
+namespace {
+
+struct count_row
+{
+  uint64_t a = 0;
+  uint64_t b = 0;
+  uint64_t count = 0;
+};
+
+bool
+count_descending (const count_row &left, const count_row &right)
+{
+  return left.count > right.count;
+}
+
+void
+print_address (FILE *out, const count_row &row)
+{
+  fprintf (out, "  0x%" PRIx64 " count=%" PRIu64 "\n", row.a, row.count);
+}
+
+void
+print_range (FILE *out, const count_row &row)
+{
+  const uint64_t span = row.b >= row.a ? row.b - row.a + 1 : 0;
+  fprintf (out,
+	   "  0x%" PRIx64 "-0x%" PRIx64 " (span=%" PRIu64 ") count=%" PRIu64
+	   "\n",
+	   row.a,
+	   row.b,
+	   span,
+	   row.count);
+}
+
+void
+print_branch (FILE *out, const count_row &row)
+{
+  fprintf (out,
+	   "  0x%" PRIx64 "->0x%" PRIx64 " count=%" PRIu64 "\n",
+	   row.a,
+	   row.b,
+	   row.count);
+}
+
+void
+dump_rows (FILE *out, const char *title, const std::vector<count_row> &rows,
+	   void (*print_row) (FILE *, const count_row &))
+{
+  fprintf (out, "%s", title);
+  for (const count_row &row : rows)
+    print_row (out, row);
+}
+
+void
+format_source_location (
+  FILE *out, const dwarf_debug::source_location &loc,
+  const std::vector<dwarf_debug::inline_frame> *inline_stack)
+{
+  if (dwarf_debug::string_empty (loc.file_path) && loc.line_number == 0)
+    fprintf (out, "??:?");
+  else
+    {
+      const std::string &file = dwarf_debug::string_value (loc.file_path);
+      fprintf (out,
+	       "%.*s:%u:%u",
+	       static_cast<int> (file.size ()),
+	       file.data (),
+	       static_cast<unsigned> (loc.line_number),
+	       static_cast<unsigned> (loc.discriminator));
+    }
+  if (inline_stack == nullptr)
+    return;
+  for (const dwarf_debug::inline_frame &frame : *inline_stack)
+    {
+      const std::string &name = dwarf_debug::string_value (frame.function_name);
+      fprintf (out,
+	       "\t%.*s:%u",
+	       static_cast<int> (name.size ()),
+	       name.data (),
+	       static_cast<unsigned> (frame.call_line));
+      if (frame.discriminator != 0)
+	fprintf (out, ".%u", static_cast<unsigned> (frame.discriminator));
+    }
+}
+
+bool
+symbolize_entries_equal (const dwarf_debug::correlate_symbolize_entry &a,
+			 const dwarf_debug::correlate_symbolize_entry &b)
+{
+  if (a.function_index != b.function_index
+      || a.locations.size () != b.locations.size ())
+    return false;
+  for (size_t i = 0; i < a.locations.size (); ++i)
+    {
+      const dwarf_debug::source_location &left = a.locations[i];
+      const dwarf_debug::source_location &right = b.locations[i];
+      if (left.file_path != right.file_path
+	  || left.line_number != right.line_number
+	  || left.discriminator != right.discriminator)
+	return false;
+    }
+  if (a.locations.empty ())
+    return true;
+  static const std::vector<dwarf_debug::inline_frame> empty;
+  return dwarf_debug::inline_stacks_equal (
+    a.inline_stack != nullptr ? *a.inline_stack : empty,
+    b.inline_stack != nullptr ? *b.inline_stack : empty);
+}
+
+} /* anonymous namespace.  */
+
+void
+dump_ingested_perf_maps (const perf_data::profile_reader &source,
+			 const std::string &path)
+{
+  FILE *out = fopen (path.c_str (), "w");
+  if (out == nullptr)
+    {
+      fprintf (
+	stderr, "Error: Cannot open perf maps dump: %s\n", path.c_str ());
+      return;
+    }
+
+  std::vector<count_row> addresses;
+  const auto &address_frequencies = source.get_address_frequencies ();
+  addresses.reserve (address_frequencies.size ());
+  for (const auto &entry : address_frequencies)
+    addresses.push_back ({entry.first, 0, entry.second});
+  std::sort (addresses.begin (), addresses.end (), count_descending);
+  dump_rows (
+    out, "All addresses (file offset, count):\n", addresses, print_address);
+
+  std::vector<count_row> ranges;
+  if (const auto *profile_ranges = source.range_counts ())
+    {
+      ranges.reserve (profile_ranges->size ());
+      for (const perf_data::profile_range &row : *profile_ranges)
+	ranges.push_back ({row.beg, row.end, row.count});
+    }
+  std::sort (ranges.begin (), ranges.end (), count_descending);
+  dump_rows (out, "\nAll ranges (begin-end, count):\n", ranges, print_range);
+
+  std::vector<count_row> branches;
+  if (const auto *profile_branches = source.branch_counts ())
+    {
+      branches.reserve (profile_branches->size ());
+      for (const perf_data::profile_branch &row : *profile_branches)
+	branches.push_back ({row.from, row.to, row.count});
+    }
+  std::sort (branches.begin (), branches.end (), count_descending);
+  dump_rows (
+    out, "\nAll branches (from->to, count):\n", branches, print_branch);
+
+  fclose (out);
+  fprintf (stderr, "Wrote perf ingest maps to %s\n", path.c_str ());
+}
+
+bool
+write_address_mapping_dump (
+  const std::string &path, dwarf_debug::dwarf_reader &reader,
+  const dwarf_debug::correlate_symbolize_map &symbolize)
+{
+  if (path.empty ())
+    return true;
+  if (symbolize.empty ())
+    return false;
+
+  FILE *out = fopen (path.c_str (), "w");
+  if (out == nullptr)
+    return false;
+  fprintf (out,
+	   "# addr\tfunc\tfile:line:dw_disc\tinline1:call_line\t..."
+	   "addr is start of maximal run of identical consecutive "
+	   "mappings\n"
+	   "dw_disc = last DWARF LNE row at this PC (same as GNU addr2line); "
+	   "not the is_stmt deposit row, not llvm-symbolizer :column\n");
+
+  std::vector<uint64_t> pcs;
+  pcs.reserve (symbolize.size ());
+  for (const auto &entry : symbolize)
+    pcs.push_back (entry.first);
+  std::sort (pcs.begin (), pcs.end ());
+
+  const std::vector<dwarf_debug::function_metadata> &functions
+    = reader.symtab_functions ();
+  size_t i = 0;
+  while (i < pcs.size ())
+    {
+      const uint64_t run_start = pcs[i];
+      const dwarf_debug::correlate_symbolize_entry &entry
+	= symbolize.at (run_start);
+      if (entry.function_index >= functions.size () || entry.locations.empty ())
+	{
+	  ++i;
+	  continue;
+	}
+      uint64_t next_pc = run_start + 1;
+      size_t j = i + 1;
+      while (j < pcs.size () && pcs[j] == next_pc
+	     && symbolize_entries_equal (entry, symbolize.at (pcs[j])))
+	{
+	  ++next_pc;
+	  ++j;
+	}
+
+      const dwarf_debug::function_metadata &function
+	= functions[entry.function_index];
+      const std::string &name = dwarf_debug::string_value (function.name);
+      fprintf (out,
+	       "0x%" PRIx64 "\t%.*s\t",
+	       run_start,
+	       static_cast<int> (name.size ()),
+	       name.data ());
+      const size_t line_idx
+	= std::min (entry.dwarf_line_index, entry.locations.size () - 1);
+      format_source_location (
+	out, entry.locations[line_idx], entry.inline_stack);
+      fprintf (out, "\n");
+      i = j;
+    }
+  fclose (out);
+  return true;
+}
+
+} /* namespace autofdo.  */
