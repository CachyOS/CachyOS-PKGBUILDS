+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_merge.h"
+
+#include <cstdio>
+#include <getopt.h>
+#include <string>
+#include <vector>
+
+static void
+print_usage (const char *prog, FILE *stream)
+{
+  fprintf (stream,
+	   "Usage:\n"
+	   "  %s [OPTIONS] <a.gcov> [<b.gcov> ...]\n"
+	   "\n"
+	   "Merge AutoFDO profiles (sum counts).  With -o, a single input is\n"
+	   "allowed.\n"
+	   "Options:\n"
+	   "  -o, --output_file FILE   Write merged profile to FILE\n"
+	   "  -h, --help  Show this help\n",
+	   prog);
+}
+
+int
+main (int argc, char *argv[])
+{
+  std::string output_path;
+  static option longopts[] = {{"output_file", required_argument, nullptr, 'o'},
+			      {"help", no_argument, nullptr, 'h'},
+			      {nullptr, 0, nullptr, 0}};
+
+  int c;
+  while ((c = getopt_long (argc, argv, "o:h", longopts, nullptr)) != -1)
+    {
+      switch (c)
+	{
+	case 'o':
+	  output_path = optarg;
+	  break;
+	case 'h':
+	  print_usage (argv[0], stdout);
+	  return 0;
+	default:
+	  print_usage (argv[0], stderr);
+	  return 1;
+	}
+    }
+
+  std::vector<std::string> inputs;
+  for (int i = optind; i < argc; ++i)
+    inputs.emplace_back (argv[i]);
+
+  if (output_path.empty ())
+    {
+      /* An explicit output file is required: never treat a positional
+	 argument as the output (that would silently overwrite an input).  */
+      fprintf (stderr, "error: no output file; use -o FILE\n");
+      print_usage (argv[0], stderr);
+      return 1;
+    }
+  else if (inputs.empty ())
+    {
+      /* With -o, a single input is allowed: a faithful version conversion.  */
+      print_usage (argv[0], stderr);
+      return 1;
+    }
+
+  gcov::gcov_merger merger;
+  if (!merger.merge (inputs, output_path))
+    return 1;
+
+  fprintf (
+    stderr, "Successfully wrote merged profile to %s\n", output_path.c_str ());
+  return 0;
+}
