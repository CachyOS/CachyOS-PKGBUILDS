+/* Combine profiles for separate instances with the same name and file.  */
+bool
+function_builder::merge_profile (const function_builder &other)
+{
+  if (start_line != other.start_line || file_path != other.file_path)
+    return false;
+  if (other.head_count_measured)
+    {
+      if (!head_count_measured)
+	head_count = 0;
+      head_count += other.head_count;
+      head_count_measured = true;
+    }
+  for (const auto &kv : other.position_count_values)
+    position_count_values[kv.first] += kv.second;
+  for (const auto &kv : other.position_target_values)
+    for (const auto &target : kv.second)
+      position_target_values[kv.first][target.first] += target.second;
+  for (const auto &kv : other.callsite_nodes)
+    {
+      auto it = callsite_nodes.find (kv.first);
+      if (it == callsite_nodes.end ())
+	callsite_nodes.emplace (
+	  kv.first, std::make_unique<function_builder> (*kv.second));
+      else if (!it->second->merge_profile (*kv.second))
+	return false;
+    }
+  return true;
+}
+
 /* Total count of this builder and everything inlined beneath it.  */
 uint64_t
 function_builder::compute_total_count ()
