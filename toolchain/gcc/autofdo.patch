+namespace {
+
+constexpr size_t CORRELATE_PROGRESS_REPORT_DIVISOR = 40;
+
+enum class callsite_disc_match
+{
+  exact,
+  frame
+};
+
+bool
+frame_matches_name (const dwarf_debug::inline_frame &frame,
+		    const std::string &name)
+{
+  if (name.empty () || dwarf_debug::string_empty (frame.function_name))
+    return false;
+  if (dwarf_debug::string_value (frame.function_name) == name)
+    return true;
+  return gcc_symbol::name_equivalent (
+    dwarf_debug::string_value (frame.function_name), name);
+}
+
+function_builder *
+find_callsite_child (function_builder &parent,
+		     const dwarf_debug::inline_frame &frame, uint32_t call_line,
+		     callsite_disc_match match)
+{
+  if (call_line == 0 || dwarf_debug::string_empty (frame.function_name))
+    return nullptr;
+  const uint32_t frame_disc = get_base_discriminator (frame.discriminator);
+  const function_builder::callsite_map &callsites = parent.callsites ();
+  const callsite_key key{call_line, frame_disc, frame.function_name};
+  auto it = callsites.find (key);
+  if (it != callsites.end ())
+    return it->second.get ();
+
+  const callsite_key same_disc{call_line, frame_disc, nullptr};
+  function_builder *candidate = nullptr;
+  for (it = callsites.lower_bound (same_disc);
+       it != callsites.end () && it->first.call_line == call_line
+       && it->first.call_disc == frame_disc;
+       ++it)
+    if (frame_matches_name (frame, it->second->name))
+      {
+	if (candidate != nullptr)
+	  return nullptr;
+	candidate = it->second.get ();
+      }
+  if (candidate != nullptr || match == callsite_disc_match::exact)
+    return candidate;
+
+  const callsite_key line_start{call_line, 0, nullptr};
+  candidate = nullptr;
+  for (it = callsites.lower_bound (line_start);
+       it != callsites.end () && it->first.call_line == call_line;
+       ++it)
+    {
+      if (it->second == nullptr
+	  || !frame_matches_name (frame, it->second->name))
+	continue;
+      const uint32_t child_disc
+	= it->first.call_disc != 0
+	    ? it->first.call_disc
+	    : get_base_discriminator (it->second->discriminator);
+      if (frame_disc == 0 || frame_disc == child_disc)
+	{
+	  if (candidate != nullptr)
+	    return nullptr;
+	  candidate = it->second.get ();
+	}
+    }
+  return candidate;
+}
+
+void
+fill_callsite_child_from_frame (function_builder &child,
+				const dwarf_debug::inline_frame &frame,
+				const dwarf_debug::dwarf_reader &reader,
+				const std::string &caller_file)
+{
+  if (child.name.empty ())
+    child.name = dwarf_debug::string_value (frame.function_name);
+  if (!child.file_path.empty () && child.start_line != 0)
+    return;
+  const dwarf_debug::inline_function_identity identity
+    = reader.resolve_inline_frame_identity (frame, caller_file);
+  if (child.file_path.empty ())
+    child.file_path = identity.file_path;
+  if (child.start_line == 0)
+    child.start_line = identity.decl_line;
+}
+
+function_builder *
+get_or_create_callsite_child (function_builder &parent,
+			      const dwarf_debug::inline_frame &frame,
+			      uint32_t callsite_line,
+			      const dwarf_debug::dwarf_reader &reader)
+{
+  if (callsite_line == 0 || dwarf_debug::string_empty (frame.function_name))
+    return &parent;
+  function_builder *child = find_callsite_child (
+    parent, frame, callsite_line, callsite_disc_match::exact);
+  if (child == nullptr)
+    {
+      const uint32_t frame_disc = get_base_discriminator (frame.discriminator);
+      const callsite_key key{callsite_line, frame_disc, frame.function_name};
+      child = &parent.create_callsite (key);
+    }
+  fill_callsite_child_from_frame (*child, frame, reader, parent.file_path);
+  return child;
+}
+
+function_builder *
+build_inline_path (function_builder &root,
+		   const std::vector<dwarf_debug::inline_frame> &inline_stack,
+		   const dwarf_debug::dwarf_reader &reader,
+		   std::vector<function_builder *> *path)
+{
+  function_builder *node = &root;
+  if (path != nullptr)
+    {
+      path->clear ();
+      path->reserve (inline_stack.size () + 1);
+      path->push_back (node);
+    }
+  for (const dwarf_debug::inline_frame &frame : inline_stack)
+    {
+      /* Skip frames without a callsite.  */
+      if (frame.call_line == 0)
+	continue;
+      function_builder *child = find_callsite_child (
+	*node, frame, frame.call_line, callsite_disc_match::frame);
+      if (child == nullptr)
+	child = get_or_create_callsite_child (
+	  *node, frame, frame.call_line, reader);
+      node = child;
+      if (path != nullptr)
+	path->push_back (node);
+    }
+  return node;
+}
+
+function_builder *
+source_owner_along_inline_path (
+  const std::vector<function_builder *> &path,
+  const std::vector<dwarf_debug::inline_frame> &stack,
+  const dwarf_debug::source_location &loc)
+{
+  afdo_assert (!path.empty ());
+  size_t caller_index = 0;
+  for (const dwarf_debug::inline_frame &frame : stack)
+    {
+      if (frame.call_line == 0)
+	continue;
+      if (caller_index >= path.size ())
+	break;
+      if (loc.line_number == frame.call_line)
+	{
+	  dwarf_debug::interned_string call_file = frame.caller_file_path;
+	  if (dwarf_debug::string_empty (call_file))
+	    call_file = frame.file_path;
+	  const bool same_file
+	    = dwarf_debug::string_empty (loc.file_path)
+	      || dwarf_debug::string_empty (call_file)
+	      || source_path::equivalent (
+		   dwarf_debug::string_value (loc.file_path),
+		   dwarf_debug::string_value (call_file));
+	  const uint32_t frame_disc
+	    = get_base_discriminator (frame.discriminator);
+	  const uint32_t loc_disc = get_base_discriminator (loc.discriminator);
+	  if (same_file
+	      && (frame_disc == 0 || loc_disc == 0 || frame_disc == loc_disc))
+	    return path[caller_index];
+	}
+      ++caller_index;
+    }
+
+  function_builder *best = nullptr;
+  for (function_builder *node : path)
+    if (node->start_line != 0 && loc.line_number >= node->start_line
+	&& !dwarf_debug::string_empty (loc.file_path)
+	&& !node->file_path.empty ()
+	&& source_path::equivalent (
+	     dwarf_debug::string_value (loc.file_path), node->file_path)
+	&& (best == nullptr || node->start_line >= best->start_line))
+      best = node;
+  return best;
+}
+
+void
+record_call_edge (function_builder &builder,
+		  const dwarf_debug::source_location &location,
+		  dwarf_debug::interned_string callee_name, uint64_t count)
+{
+  if (count == 0 || dwarf_debug::string_empty (callee_name)
+      || location.line_number == 0)
+    return;
+  builder.record_call_target_max (
+    location.line_number, location.discriminator, callee_name, count);
+}
+
+inline_path_cache_entry &
+resolve_inline_path_for_inst (const correlate_context &ctx,
+			      function_profile &func_profile,
+			      instruction_map_entry &inst,
+			      inline_path_cache &cache)
+{
+  afdo_assert (func_profile.builder != nullptr);
+  static const std::vector<dwarf_debug::inline_frame> empty;
+  const std::vector<dwarf_debug::inline_frame> &stack
+    = inst.inline_stack != nullptr ? *inst.inline_stack : empty;
+  if (inst.inline_path == nullptr)
+    {
+      const inline_path_cache_key key{stack, inst.inline_stack_hash};
+      inline_path_cache_entry &entry = cache[key];
+      if (entry.leaf_builder == nullptr)
+	entry.leaf_builder = build_inline_path (
+	  *func_profile.builder, stack, ctx.reader, &entry.path);
+      inst.inline_path = &entry;
+    }
+  return *inst.inline_path;
+}
+
+bool
+symbolize_pc_entry (const dwarf_debug::dwarf_reader &reader, uint64_t addr,
+		    instruction_map_entry &entry,
+		    const dwarf_debug::function_metadata &func_hint,
+		    dwarf_debug::correlate_session &session)
+{
+  if (entry.valid)
+    return true;
+  const dwarf_debug::symbolized_result result
+    = reader.symbolize (addr, session, &func_hint);
+  if (result.function == nullptr
+      || result.locations == nullptr
+      || result.locations->empty ())
+    return false;
+  entry.valid = true;
+  entry.loc = (*result.locations)[0];
+  entry.locations = result.locations;
+  entry.inline_stack = result.inline_stack;
+  static const std::vector<dwarf_debug::inline_frame> empty;
+  const std::vector<dwarf_debug::inline_frame> &stack
+    = entry.inline_stack != nullptr ? *entry.inline_stack : empty;
+  entry.inline_stack_hash = dwarf_debug::hash_inline_frame_stack (stack);
+  return true;
+}
+
+void
+apply_source_counts (const correlate_context &ctx,
+		     function_profile &func_profile,
+		     instruction_map_entry &inst, uint64_t count,
+		     inline_path_cache &path_cache)
+{
+  inline_path_cache_entry &inline_path
+    = resolve_inline_path_for_inst (ctx, func_profile, inst, path_cache);
+  if (inst.locations == nullptr)
+    return;
+
+  static const std::vector<dwarf_debug::inline_frame> empty;
+  const std::vector<dwarf_debug::inline_frame> &resolved_stack
+    = inst.inline_stack != nullptr ? *inst.inline_stack : empty;
+  for (size_t i = 0; i < inst.locations->size (); ++i)
+    {
+      const dwarf_debug::source_location &loc = (*inst.locations)[i];
+      if (loc.line_number == 0)
+	continue;
+      function_builder *owner
+	= source_owner_along_inline_path (
+	  inline_path.path, resolved_stack, loc);
+      if (owner == nullptr && i == 0)
+	owner = inline_path.leaf_builder;
+      if (owner != nullptr)
+	{
+	  const uint64_t weighted
+	    = count * static_cast<uint64_t> (
+		get_multiplicity (loc.discriminator));
+	  owner->deposit_position_max (
+	    loc.line_number, loc.discriminator, weighted);
+	}
+    }
+}
+
+void
+correlate_body_count_at_pc (const correlate_context &ctx,
+			    function_profile &func_profile,
+			    const dwarf_debug::function_metadata &func_meta,
+			    uint64_t addr, uint64_t count,
+			    function_inst_map &inst_map,
+			    inline_path_cache &path_cache,
+			    dwarf_debug::correlate_session &session)
+{
+  instruction_map_entry &inst = inst_map[addr];
+  if (symbolize_pc_entry (ctx.reader, addr, inst, func_meta, session))
+    apply_source_counts (ctx, func_profile, inst, count, path_cache);
+}
+
+uint64_t
+hash_source_locations (
+  const std::vector<dwarf_debug::source_location> &locations)
+{
+  uint64_t hash = 0;
+  for (const dwarf_debug::source_location &loc : locations)
+    {
+      hash_combine (
+	hash, std::hash<dwarf_debug::interned_string>{}(loc.file_path));
+      hash_combine (hash, std::hash<uint32_t>{}(loc.line_number));
+      hash_combine (hash, std::hash<uint32_t>{}(loc.discriminator));
+    }
+  return hash;
+}
+
+bool
+source_locations_equal (const std::vector<dwarf_debug::source_location> &a,
+			const std::vector<dwarf_debug::source_location> &b)
+{
+  if (a.size () != b.size ())
+    return false;
+  for (size_t i = 0; i < a.size (); ++i)
+    if (a[i].file_path != b[i].file_path || a[i].line_number != b[i].line_number
+	|| a[i].discriminator != b[i].discriminator)
+      return false;
+  return true;
+}
+
+range_mass_coalesce_key
+make_range_mass_coalesce_key (const instruction_map_entry &inst)
+{
+  afdo_assert (inst.locations != nullptr);
+  return {inst.locations,
+	  inst.inline_stack,
+	  hash_source_locations (*inst.locations),
+	  inst.inline_stack_hash};
+}
+
+void
+deposit_range_mass (const correlate_context &ctx,
+		    function_profile &func_profile,
+		    const dwarf_debug::function_metadata &func_meta,
+		    const correlate_target &target, function_inst_map &inst_map,
+		    inline_path_cache &path_cache,
+		    dwarf_debug::correlate_session &session)
+{
+  std::unordered_map<range_mass_coalesce_key,
+		     std::pair<uint64_t, uint64_t>,
+		     range_mass_coalesce_key_hash>
+    coalesced;
+  for_each_branch_stack_mass_pc (
+    target.maps.range_count_map,
+    ctx.range_mass_addr_step,
+    [&] (uint64_t addr, uint64_t mass) {
+      instruction_map_entry &inst = inst_map[addr];
+      if (!symbolize_pc_entry (ctx.reader, addr, inst, func_meta, session))
+	return;
+      const range_mass_coalesce_key key = make_range_mass_coalesce_key (inst);
+      const auto inserted
+	= coalesced.emplace (key, std::make_pair (addr, mass));
+      if (!inserted.second && mass > inserted.first->second.second)
+	inserted.first->second = std::make_pair (addr, mass);
+    });
+  for (const auto &entry : coalesced)
+    {
+      instruction_map_entry &inst = inst_map[entry.second.first];
+      afdo_assert (inst.valid);
+      apply_source_counts (
+	ctx, func_profile, inst, entry.second.second, path_cache);
+    }
+}
+
+void
+correlate_function_body_counts (const correlate_context &ctx,
+				function_profile &func_profile,
+				const dwarf_debug::function_metadata &func_meta,
+				const correlate_target &target,
+				function_inst_map &inst_map,
+				inline_path_cache &path_cache,
+				dwarf_debug::correlate_session &session)
+{
+  if (!target.maps.range_count_map.empty ())
+    {
+      deposit_range_mass (
+	ctx, func_profile, func_meta, target, inst_map, path_cache, session);
+      return;
+    }
+  for (const auto &entry : target.maps.addr_counts)
+    if (entry.first >= target.start_addr && entry.first < target.end_addr)
+      correlate_body_count_at_pc (ctx,
+				  func_profile,
+				  func_meta,
+				  entry.first,
+				  entry.second,
+				  inst_map,
+				  path_cache,
+				  session);
+}
+
+void
+deposit_call_edges (const correlate_context &ctx,
+		    function_profile &func_profile,
+		    const dwarf_debug::function_metadata &func_meta,
+		    const correlate_target &target, function_inst_map &inst_map,
+		    inline_path_cache &path_cache,
+		    dwarf_debug::correlate_session &session)
+{
+  static const std::vector<dwarf_debug::inline_frame> empty;
+  for (const auto &entry : target.maps.branch_count_map)
+    {
+      const uint64_t from = entry.first.first;
+      if (from < target.start_addr || from >= target.end_addr)
+	continue;
+      instruction_map_entry &inst = inst_map[from];
+      if (!symbolize_pc_entry (ctx.reader, from, inst, func_meta, session))
+	continue;
+      const dwarf_debug::function_metadata *callee
+	= dwarf_debug::function_at_entry_pc (
+	  ctx.reader.symtab_functions (), entry.first.second);
+      if (callee == nullptr
+	  || ctx.emitted_hot_symbols.count ({callee->name, callee->start_addr})
+	       == 0)
+	continue;
+      inline_path_cache_entry &inline_path
+	= resolve_inline_path_for_inst (
+	  ctx, func_profile, inst, path_cache);
+      const std::vector<dwarf_debug::inline_frame> &stack
+	= inst.inline_stack != nullptr ? *inst.inline_stack : empty;
+      function_builder *owner
+	= source_owner_along_inline_path (
+	  inline_path.path, stack, inst.loc);
+      if (owner == nullptr)
+	owner = inline_path.leaf_builder;
+      record_call_edge (*owner, inst.loc, callee->name, entry.second);
+    }
+}
+
+void
+correlate_per_function_profile (const correlate_context &ctx,
+				correlate_target &target,
+				dwarf_debug::correlate_session &session)
+{
+  afdo_assert (target.func_profile != nullptr);
+  function_profile &profile = *target.func_profile;
+  afdo_assert (profile.builder != nullptr);
+  const dwarf_debug::function_metadata &metadata
+    = ctx.reader.symtab_functions ()[target.symtab_index];
+  function_inst_map inst_map
+    = function_inst_map::make (target.start_addr, target.end_addr);
+  inline_path_cache path_cache;
+  path_cache.reserve (target.line_span_anchor_pcs.size ()
+		      + target.maps.addr_counts.size ()
+		      + target.maps.branch_count_map.size ()
+		      + target.maps.range_count_map.size ());
+  static const std::vector<dwarf_debug::inline_frame> empty;
+  /* Complete the callsite tree before caching paths through it.  */
+  for (uint64_t addr : target.line_span_anchor_pcs)
+    {
+      instruction_map_entry &inst = inst_map[addr];
+      if (symbolize_pc_entry (ctx.reader, addr, inst, metadata, session))
+	{
+	  const std::vector<dwarf_debug::inline_frame> &stack
+	    = inst.inline_stack != nullptr ? *inst.inline_stack : empty;
+	  build_inline_path (*profile.builder, stack, ctx.reader, nullptr);
+	}
+    }
+  correlate_function_body_counts (
+    ctx, profile, metadata, target, inst_map, path_cache, session);
+  if (!target.maps.branch_count_map.empty ())
+    deposit_call_edges (
+      ctx, profile, metadata, target, inst_map, path_cache, session);
+}
+
+} /* anonymous namespace.  */
+
+bool
+range_mass_coalesce_key::operator== (
+  const range_mass_coalesce_key &o) const noexcept
+{
+  if (locations_hash != o.locations_hash
+      || inline_stack_hash != o.inline_stack_hash)
+    return false;
+  if (locations != o.locations
+      && !source_locations_equal (*locations, *o.locations))
+    return false;
+  if (inline_stack == o.inline_stack)
+    return true;
+  if (inline_stack == nullptr || o.inline_stack == nullptr)
+    return inline_stack == nullptr ? o.inline_stack->empty ()
+				   : inline_stack->empty ();
+  return dwarf_debug::inline_stacks_equal (*inline_stack, *o.inline_stack);
+}
+
+size_t
+run_correlate_target_workers (
+  correlate_context &ctx, dwarf_debug::correlate_symbolize_map *symbolize_out)
+{
+  std::vector<correlate_target> &targets = ctx.targets;
+  const size_t target_count = targets.size ();
+  const size_t progress_interval
+    = std::max<size_t> (1, target_count / CORRELATE_PROGRESS_REPORT_DIVISOR);
+  std::atomic<size_t> next_target{0};
+  std::atomic<size_t> functions_done{0};
+  std::mutex progress_mutex;
+  std::vector<dwarf_debug::correlate_symbolize_map> worker_snapshots;
+  if (symbolize_out != nullptr)
+    worker_snapshots.resize (ctx.num_threads);
+
+  const auto run_worker = [&] (unsigned worker_id) {
+    dwarf_debug::correlate_session session;
+    for (size_t i = next_target.fetch_add (1); i < target_count;
+	 i = next_target.fetch_add (1))
+      {
+	correlate_target &target = targets[i];
+	afdo_assert (target.func_profile != nullptr);
+	correlate_per_function_profile (ctx, target, session);
+	const size_t done
+	  = functions_done.fetch_add (1, std::memory_order_relaxed) + 1;
+	if (done % progress_interval == 0 || done == target_count)
+	  {
+	    std::lock_guard<std::mutex> lock (progress_mutex);
+	    fprintf (stderr,
+		     "AFDO: correlate %zu/%zu functions...\n",
+		     done,
+		     target_count);
+	  }
+      }
+    if (symbolize_out != nullptr)
+      session.drain_symbolize_snapshot_into (worker_snapshots[worker_id]);
+  };
+
+  if (ctx.num_threads == 1)
+    run_worker (0);
+  else
+    {
+      std::vector<std::thread> threads;
+      threads.reserve (ctx.num_threads);
+      for (unsigned i = 0; i < ctx.num_threads; ++i)
+	threads.emplace_back (run_worker, i);
+      for (std::thread &thread : threads)
+	thread.join ();
+    }
+  if (symbolize_out != nullptr)
+    for (dwarf_debug::correlate_symbolize_map &snapshot : worker_snapshots)
+      for (auto &entry : snapshot)
+	symbolize_out->emplace (entry.first, std::move (entry.second));
+  return functions_done.load (std::memory_order_relaxed);
+}
