diff --git a/afdo_tools/src/afdo_dump.cc b/afdo_tools/src/afdo_dump.cc
new file mode 100644
index 00000000000..d4b1f76d9a7
--- /dev/null
+++ b/afdo_tools/src/afdo_dump.cc
@@ -0,0 +1,233 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov.h"
+#include "gcov_reader.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <getopt.h>
+#include <memory>
+#include <string>
+#include <vector>
+
+/* Dump an AutoFDO profile in the standard dump_gcov text layout.  */
+
+namespace {
+
+/* Returned by name/file lookups when the id is out of range.  */
+const std::string empty_string;
+
+const std::string &
+file_for_id (const gcov::gcov_profile &p, uint32_t id)
+{
+  const auto &map = p.get_file_name_map ();
+  if (id >= map.size ())
+    return empty_string;
+  const uint32_t fidx = map[id];
+  const auto &files = p.get_file_names ();
+  if (fidx >= files.size ())
+    return empty_string;
+  return files[fidx];
+}
+
+const std::string &
+name_for_id (const gcov::gcov_profile &p, uint32_t id)
+{
+  const auto &names = p.get_function_names ();
+  return id < names.size () ? names[id] : empty_string;
+}
+
+void
+print_location_prefix (uint32_t rel_line, uint32_t discriminator)
+{
+  if (discriminator > 0)
+    printf ("%u.%u: ", rel_line, discriminator);
+  else
+    printf ("%u: ", rel_line);
+}
+
+/* Indirect-call suffix uses the execution site's file, falling back to the
+   callee's declaration file (or the sole TU file).  */
+void
+print_indirect_targets (const gcov::gcov_location_call &call,
+			const gcov::gcov_profile &p,
+			const std::string &caller_file)
+{
+  std::vector<std::pair<uint64_t, uint64_t>> targets (
+    call.callee_map.begin (), call.callee_map.end ());
+  std::sort (
+    targets.begin (), targets.end (), [] (const auto &a, const auto &b) {
+      return a.second > b.second || (a.second == b.second && a.first > b.first);
+    });
+  for (const auto &target : targets)
+    {
+      const uint64_t name_id = target.first;
+      const uint64_t tgt_count = target.second;
+      std::string file = caller_file;
+      if (file.empty ())
+	file = file_for_id (p, static_cast<uint32_t> (name_id));
+      if (file.empty () && p.get_file_names ().size () == 1)
+	file = p.get_file_names ()[0];
+      printf (
+	"  %s:", name_for_id (p, static_cast<uint32_t> (name_id)).c_str ());
+      if (!file.empty ())
+	printf ("%s:", file.c_str ());
+      printf ("%" PRIu64, tgt_count);
+    }
+}
+
+bool
+location_less (const gcov::gcov_location *a, const gcov::gcov_location *b)
+{
+  return a->offset < b->offset
+	 || (a->offset == b->offset && a->discriminator < b->discriminator);
+}
+
+void
+dump_body (const gcov::gcov_function &fn, const gcov::gcov_profile &p,
+	   int indent)
+{
+  const std::string body_indent (indent + 2, ' ');
+  const std::string caller_file = file_for_id (p, fn.id);
+
+  std::vector<const gcov::gcov_location *> positions;
+  std::vector<const gcov::gcov_location_inline *> inlines;
+  positions.reserve (fn.locations.size ());
+  inlines.reserve (fn.locations.size ());
+  for (const auto &loc : fn.locations)
+    {
+      if (loc->type == gcov::gcov_location::kind::inlined)
+	inlines.push_back (
+	  static_cast<const gcov::gcov_location_inline *> (loc.get ()));
+      else
+	positions.push_back (loc.get ());
+    }
+  std::sort (positions.begin (), positions.end (), location_less);
+  std::sort (
+    inlines.begin (),
+    inlines.end (),
+    [] (const gcov::gcov_location_inline *a,
+	const gcov::gcov_location_inline *b) { return location_less (a, b); });
+
+  /* Pass 1: position counts, emitted before the child callsites.  */
+  for (const gcov::gcov_location *loc : positions)
+    {
+      printf ("%s", body_indent.c_str ());
+      print_location_prefix (loc->offset, loc->discriminator);
+      printf ("%" PRIu64, loc->total_count ());
+      if (loc->type == gcov::gcov_location::kind::call)
+	print_indirect_targets (
+	  static_cast<const gcov::gcov_location_call &> (*loc), p, caller_file);
+      printf ("\n");
+    }
+
+  /* Pass 2: inline callsites (always after position counts).  */
+  for (const gcov::gcov_location_inline *inl : inlines)
+    {
+      const gcov::gcov_function &callee = inl->inlined_sym;
+      const std::string &callee_file = file_for_id (p, callee.id);
+      printf ("%s", body_indent.c_str ());
+      print_location_prefix (inl->offset, inl->discriminator);
+      printf ("%s:", name_for_id (p, callee.id).c_str ());
+      if (!callee_file.empty ())
+	printf ("%s", callee_file.c_str ());
+      printf (" total:%" PRIu64 "\n", callee.total_count);
+      dump_body (callee, p, indent + 2);
+    }
+}
+
+void
+dump_root (const gcov::gcov_function &fn, const gcov::gcov_profile &p,
+	   bool show_timestamp)
+{
+  std::string path = file_for_id (p, fn.id);
+  if (path.empty () && p.get_file_names ().size () == 1)
+    path = p.get_file_names ()[0];
+  printf ("%s:%s total:%" PRIu64 " head:%" PRIu64,
+	  name_for_id (p, fn.id).c_str (),
+	  path.c_str (),
+	  fn.total_count,
+	  fn.head_count);
+  if (show_timestamp)
+    printf (" timestamp: %" PRIu64, fn.timestamp);
+  printf ("\n");
+  dump_body (fn, p, 0);
+}
+
+} /* anonymous namespace.  */
+
+int
+main (int argc, char *argv[])
+{
+  static option long_options[]
+    = {{"help", no_argument, nullptr, 'h'}, {nullptr, 0, nullptr, 0}};
+  int c;
+  while ((c = getopt_long (argc, argv, "h", long_options, nullptr)) != -1)
+    {
+      if (c == 'h')
+	{
+	  printf ("Usage: %s <profile.gcov>\n", argv[0]);
+	  return 0;
+	}
+      return 1;
+    }
+
+  if (optind >= argc)
+    {
+      fprintf (stderr, "Usage: %s <profile.gcov>\n", argv[0]);
+      return 1;
+    }
+  const char *path = argv[optind];
+
+  std::unique_ptr<gcov::gcov_reader_base> reader
+    = gcov::make_gcov_reader (path);
+  if (!reader)
+    {
+      fprintf (stderr, "Error: unsupported profile format: %s\n", path);
+      return 1;
+    }
+
+  if (!reader->read ())
+    {
+      fprintf (stderr, "Error: Failed to read %s\n", path);
+      return 1;
+    }
+  const gcov::gcov_profile &p = *reader->get_profile ();
+  const bool show_timestamp
+    = reader->get_version () == gcov::v3::format::GCOV_VERSION;
+
+  /* Roots ordered by descending total, then name.  */
+  std::vector<size_t> root_order;
+  root_order.reserve (p.get_functions ().size ());
+  for (size_t i = 0; i < p.get_functions ().size (); ++i)
+    root_order.push_back (i);
+  std::sort (root_order.begin (), root_order.end (), [&] (size_t a, size_t b) {
+    const gcov::gcov_function &fa = p.get_functions ()[a];
+    const gcov::gcov_function &fb = p.get_functions ()[b];
+    if (fa.total_count != fb.total_count)
+      return fa.total_count > fb.total_count;
+    return name_for_id (p, fa.id) < name_for_id (p, fb.id);
+  });
+  for (size_t root_idx : root_order)
+    dump_root (p.get_functions ()[root_idx], p, show_timestamp);
+
+  return 0;
+}
