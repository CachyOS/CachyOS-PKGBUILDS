From a1b3e65feae7c1b8c6ce57dc56401c97fb929fad Mon Sep 17 00:00:00 2001
From: Kugan Vivekanandarajah <kvivekananda@nvidia.com>
Date: Thu, 17 Sep 2026 10:39:06 +1000
Subject: [PATCH 10/38] Add symbol, source-path and function lookup helpers

Add the symbol-name, source-path and function-lookup helpers shared by
the DWARF reader and the two correlation passes.

A profile must be keyed on the names a later compilation looks up, so
clone suffixes (.isra.N, .constprop.N, .cold, ...) are stripped, and
source paths are canonicalized when interned and compared component-wise
because DWARF spells one file differently between compilation units.
Merging a name into its parent is a separate, narrower rule, so a
specialized clone keeps its own counts rather than being absorbed by a
sibling.

Address lookup allows for the overlapping ranges that aliases, ICF and
.cold partitioning produce; callees resolve only at an exact entry PC.

afdo_tools/ChangeLog:

	* src/symbol_util.cc: New file.
	* src/symbol_util.h: New file.

Signed-off-by: Kugan Vivekanandarajah <kvivekananda@nvidia.com>
Co-authored-by: Dhruv Chawla <dhruvc@nvidia.com>
Co-authored-by: Rahul Shinde <rashinde@nvidia.com>
---
 afdo_tools/src/symbol_util.cc | 260 ++++++++++++++++++++++++++++++++++
 afdo_tools/src/symbol_util.h  |  69 +++++++++
 2 files changed, 329 insertions(+)
 create mode 100644 afdo_tools/src/symbol_util.cc
 create mode 100644 afdo_tools/src/symbol_util.h

diff --git a/afdo_tools/src/symbol_util.cc b/afdo_tools/src/symbol_util.cc
new file mode 100644
index 00000000000..6929594e154
--- /dev/null
+++ b/afdo_tools/src/symbol_util.cc
@@ -0,0 +1,260 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "symbol_util.h"
+
+#include <algorithm>
+
+namespace gcc_symbol {
+
+namespace {
+
+const char *const GCC_GENERATED_SUFFIX_TAGS[] = {
+  ".isra", ".constprop", ".part", ".__part", ".lto_priv", ".clone",
+  ".cold", ".hot"
+};
+
+const char *const GCC_SPLIT_PART_TAGS[] = {".cold", ".hot"};
+const char *const GCC_DOTTED_COPY_TAGS[] = {".llvm.", ".__part."};
+
+bool
+is_digit_suffix (const std::string &s)
+{
+  if (s.empty ())
+    return false;
+  for (unsigned char c : s)
+    if (c < '0' || c > '9')
+      return false;
+  return true;
+}
+
+bool
+is_gcc_generated_suffix_tag (const std::string &tag)
+{
+  for (const char *candidate : GCC_GENERATED_SUFFIX_TAGS)
+    if (tag == candidate)
+      return true;
+  return false;
+}
+
+bool
+erase_terminal_tag (std::string &name, const std::string &tag)
+{
+  const size_t at = name.rfind (tag);
+  if (at == std::string::npos)
+    return false;
+
+  const size_t suffix = at + tag.size ();
+  if (suffix != name.size ()
+      && (name[suffix] != '.'
+	  || !is_digit_suffix (name.substr (suffix + 1))))
+    return false;
+
+  name.erase (at);
+  return true;
+}
+
+bool
+erase_numbered_tag (std::string &name, const std::string &tag)
+{
+  const size_t at = name.rfind (tag);
+  if (at == std::string::npos)
+    return false;
+  const size_t app = at + tag.size ();
+  const size_t next = name.find ('.', app);
+  const size_t app_end = next == std::string::npos ? name.size () : next;
+  if (app == app_end
+      || !is_digit_suffix (name.substr (app, app_end - app)))
+    return false;
+  name.erase (at, app_end - at);
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+std::string
+symbol_base_name (std::string name)
+{
+  for (;;)
+    {
+      const size_t dot = name.rfind ('.');
+      if (dot == std::string::npos || dot + 1 >= name.size ())
+	break;
+
+      const std::string tail = name.substr (dot + 1);
+      if (tail == "cold" || tail == "hot")
+	{
+	  name.erase (dot);
+	  continue;
+	}
+
+      if (dot == 0 || !is_digit_suffix (tail))
+	break;
+
+      const size_t prev = name.rfind ('.', dot - 1);
+      if (prev == std::string::npos
+	  || !is_gcc_generated_suffix_tag (name.substr (prev, dot - prev)))
+	break;
+
+      name.erase (prev);
+    }
+  return name;
+}
+
+std::string
+symbol_split_part_parent (std::string name)
+{
+  bool changed;
+  do
+    {
+      changed = false;
+      for (const char *tag : GCC_SPLIT_PART_TAGS)
+	if (erase_terminal_tag (name, tag))
+	  changed = true;
+      for (const char *tag : GCC_DOTTED_COPY_TAGS)
+	if (erase_numbered_tag (name, tag))
+	  changed = true;
+    }
+  while (changed);
+  return name;
+}
+
+bool
+name_equivalent (const std::string &a, const std::string &b)
+{
+  if (a.empty () || b.empty ())
+    return false;
+  if (a == b)
+    return true;
+  const std::string a_part = symbol_split_part_parent (a);
+  const std::string b_part = symbol_split_part_parent (b);
+  if (a_part == b_part)
+    return true;
+  const std::string a_base = symbol_base_name (a_part);
+  const std::string b_base = symbol_base_name (b_part);
+  return a_base == b_base && (a_part == a_base || b_part == b_base);
+}
+
+bool
+has_suffix (const std::string &name, const std::string &suffix)
+{
+  return name.size () >= suffix.size ()
+	 && name.compare (name.size () - suffix.size (), suffix.size (), suffix)
+	      == 0;
+}
+
+} /* namespace gcc_symbol.  */
+
+namespace source_path {
+
+bool
+equivalent (const std::string &a, const std::string &b)
+{
+  if (a == b)
+    return true;
+  if (a.empty () || b.empty ())
+    return false;
+  const auto is_separator = [] (char c) { return c == '/' || c == '\\'; };
+  const std::string &longer = a.size () > b.size () ? a : b;
+  const std::string &shorter = a.size () > b.size () ? b : a;
+  if (is_separator (shorter[0])
+      || longer.compare (longer.size () - shorter.size (),
+			 shorter.size (), shorter)
+	   != 0)
+    return false;
+  const size_t start = longer.size () - shorter.size ();
+  return start != 0 && is_separator (longer[start - 1]);
+}
+
+} /* namespace source_path.  */
+
+namespace dwarf_debug {
+
+namespace {
+
+bool
+function_has_valid_range (const function_metadata &func)
+{
+  return func.end_addr > func.start_addr;
+}
+
+bool
+address_in_function_range (const function_metadata &func, uint64_t address)
+{
+  return address >= func.start_addr && address < func.end_addr;
+}
+
+} /* anonymous namespace.  */
+
+const function_metadata *
+function_containing_address (const std::vector<function_metadata> &funcs,
+			     uint64_t address)
+{
+  if (funcs.empty ())
+    return nullptr;
+  auto it
+    = std::upper_bound (funcs.begin (),
+			funcs.end (),
+			address,
+			[] (uint64_t addr, const function_metadata &func)
+			{
+			  return addr < func.start_addr;
+			});
+  if (it == funcs.begin ())
+    return nullptr;
+  size_t last = static_cast<size_t> (it - funcs.begin ()) - 1;
+  while (true)
+    {
+      const function_metadata &func = funcs[last];
+      if (address_in_function_range (func, address))
+	{
+	  const function_metadata *best = &func;
+	  while (last > 0 && funcs[last - 1].start_addr == func.start_addr)
+	    {
+	      --last;
+	      if (address_in_function_range (funcs[last], address))
+		best = &funcs[last];
+	    }
+	  return best;
+	}
+      if (last == 0)
+	return nullptr;
+      --last;
+    }
+}
+
+const function_metadata *
+function_at_entry_pc (const std::vector<function_metadata> &funcs, uint64_t pc)
+{
+  if (funcs.empty ())
+    return nullptr;
+  auto it
+    = std::lower_bound (funcs.begin (),
+			funcs.end (),
+			pc,
+			[] (const function_metadata &func, uint64_t addr)
+			{
+			  return func.start_addr < addr;
+			});
+  for (; it != funcs.end () && it->start_addr == pc; ++it)
+    if (!string_empty (it->name) && function_has_valid_range (*it))
+      return &*it;
+  return nullptr;
+}
+
+} /* namespace dwarf_debug.  */
