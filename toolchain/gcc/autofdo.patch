+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_GCOV_WRITER_H
+#define GCC_GCOV_WRITER_H
+
+#include "gcov.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace gcov {
+
+/* Writer-only named constants.  */
+
+/* Trie node header byte: the high bit flags a terminal node and the low seven
+   bits hold the child count, so a node may have at most 127 children.  */
+constexpr uint8_t TRIE_TERMINAL_FLAG = 0x80;
+constexpr size_t TRIE_MAX_CHILDREN = 0x7f;
+
+class gcov_writer_base
+{
+protected:
+  const gcov_profile *profile = nullptr;
+  FILE *file = nullptr;
+
+  /* Flush and close FILE.  Returns true only if the stream had no prior
+     error and fclose succeeded.  */
+  bool close ();
+
+public:
+  gcov_writer_base (const std::string &path, const gcov_profile *profile_);
+  virtual ~gcov_writer_base ();
+
+  virtual bool write () = 0;
+};
+
+struct gcov_writer_options
+{
+  int version = 3;
+};
+
+class gcov_writer_v3 : public gcov_writer_base
+{
+  void write_summary ();
+  void write_file_names ();
+  void write_function_names ();
+  void write_pos_count (const gcov_location *loc);
+  void write_inline_callsite (const gcov_location_inline &callsite);
+  void write_function (const gcov_function &func);
+  void write_functions ();
+
+public:
+  gcov_writer_v3 (const std::string &path, const gcov_profile *profile_)
+    : gcov_writer_base (path, profile_)
+  {}
+  bool write () override;
+};
+
+/* Construct a writer for OPTIONS, or return nullptr when the requested format
+   is unsupported by this build.  */
+std::unique_ptr<gcov_writer_base>
+make_gcov_writer (const std::string &path, const gcov_profile *profile,
+		  const gcov_writer_options &options);
+
+} /* namespace gcov.  */
+
+#endif /* GCC_GCOV_WRITER_H.  */
diff --git a/afdo_tools/src/gcov_writer_v3.cc b/afdo_tools/src/gcov_writer_v3.cc
new file mode 100644
index 00000000000..66966f37957
--- /dev/null
+++ b/afdo_tools/src/gcov_writer_v3.cc
@@ -0,0 +1,232 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_writer.h"
+#include "gcov.h"
+#include "gcov_io.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <unordered_map>
+#include <vector>
+
+namespace gcov {
+/* SUMMARY record: tag + payload, no length word.  */
+void
+gcov_writer_v3::write_summary ()
+{
+  const gcov_summary &s = profile->get_summary ();
+  gcov_write_uint32 (file, v3::format::GCOV_TAG_AFDO_SUMMARY);
+  gcov_write_uint64 (file, s.total_count);
+  gcov_write_uint64 (file, s.max_count);
+  gcov_write_uint64 (file, s.max_function_count);
+  gcov_write_uint64 (file, s.num_counts);
+  gcov_write_uint64 (file, s.num_functions);
+  gcov_write_uint64 (file, static_cast<uint64_t> (s.num_detailed_entries));
+  for (const auto &e : s.detailed_entries)
+    {
+      gcov_write_uint32 (file, e.cutoff);
+      gcov_write_uint64 (file, e.min_count);
+      gcov_write_uint64 (file, e.num_counts);
+    }
+}
+
+/* num_functions, then (name, file_index) per entry with no tag.  Emitted inside
+   the FILE_NAMES record.  */
+void
+gcov_writer_v3::write_function_names ()
+{
+  const std::vector<std::string> &function_names
+    = profile->get_function_names ();
+  const std::vector<uint32_t> &file_name_map = profile->get_file_name_map ();
+  gcov_write_uint32 (file, static_cast<uint32_t> (function_names.size ()));
+  for (size_t i = 0; i < function_names.size (); ++i)
+    {
+      gcov_write_string (file, function_names[i]);
+      const uint32_t file_idx
+	= (i < file_name_map.size ()) ? file_name_map[i] : INVALID_INDEX;
+      gcov_write_uint32 (file, file_idx);
+    }
+}
+
+/* FILE_NAMES record: tag + length word + file table + function-name table.  */
+void
+gcov_writer_v3::write_file_names ()
+{
+  gcov_write_uint32 (file, v3::format::GCOV_TAG_AFDO_FILE_NAMES);
+  gcov_write_uint32 (file, 0); /* Unused record length.  */
+
+  const std::vector<std::string> &file_names = profile->get_file_names ();
+  gcov_write_uint32 (file, static_cast<uint32_t> (file_names.size ()));
+  for (const auto &path : file_names)
+    gcov_write_string (file, path);
+
+  write_function_names ();
+}
+
+/* Re-encode the location offset as (offset << 16) | discriminator.  */
+void
+gcov_writer_v3::write_pos_count (const gcov_location *loc)
+{
+  const uint32_t encoded = (loc->offset << 16) | (loc->discriminator & 0xffffu);
+  gcov_write_uint32 (file, encoded);
+
+  if (loc->type == gcov_location::kind::call)
+    {
+      const gcov_location_call *call
+	= static_cast<const gcov_location_call *> (loc);
+      /* Canonical order is targets sorted by function id.  */
+      std::vector<std::pair<uint64_t, uint64_t>> targets (
+	call->callee_map.begin (), call->callee_map.end ());
+      std::sort (targets.begin (),
+		 targets.end (),
+		 [] (const std::pair<uint64_t, uint64_t> &a,
+		     const std::pair<uint64_t, uint64_t> &b) {
+		   return a.first < b.first;
+		 });
+      gcov_write_uint32 (file, static_cast<uint32_t> (targets.size ()));
+      gcov_write_uint64 (file, call->count);
+      for (const auto &t : targets)
+	{
+	  gcov_write_uint32 (
+	    file,
+	    static_cast<uint32_t> (v3::hist_type::HIST_TYPE_INDIR_CALL_TOPN));
+	  gcov_write_uint64 (file, t.first);  /* Function id (name index).  */
+	  gcov_write_uint64 (file, t.second); /* Target count.  */
+	}
+    }
+  else
+    {
+      const gcov_location_normal *normal
+	= static_cast<const gcov_location_normal *> (loc);
+      gcov_write_uint32 (file, 0); /* num_targets.  */
+      gcov_write_uint64 (file, normal->count);
+    }
+}
+
+void
+gcov_writer_v3::write_inline_callsite (const gcov_location_inline &callsite)
+{
+  const uint32_t encoded
+    = (callsite.offset << 16) | (callsite.discriminator & 0xffffu);
+  gcov_write_uint32 (file, encoded);
+  gcov_write_uint32 (file, callsite.inlined_sym.id);
+
+  std::vector<const gcov_location *> pos;
+  std::vector<const gcov_location_inline *> nested;
+  pos.reserve (callsite.inlined_sym.locations.size ());
+  nested.reserve (callsite.inlined_sym.locations.size ());
+  for (const auto &loc : callsite.inlined_sym.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	nested.push_back (
+	  static_cast<const gcov_location_inline *> (loc.get ()));
+      else
+	pos.push_back (loc.get ());
+    }
+
+  gcov_write_uint32 (file, static_cast<uint32_t> (pos.size ()));
+  gcov_write_uint32 (file, static_cast<uint32_t> (nested.size ()));
+  for (const gcov_location *loc : pos)
+    write_pos_count (loc);
+  for (const gcov_location_inline *cs : nested)
+    write_inline_callsite (*cs);
+}
+
+/* Locations split into pos counts (normal/call) and inline callsites.  */
+void
+gcov_writer_v3::write_function (const gcov_function &func)
+{
+  gcov_write_uint64 (file, func.head_count);
+  gcov_write_uint64 (file, func.timestamp);
+  gcov_write_uint32 (file, func.id);
+
+  std::vector<const gcov_location *> pos;
+  std::vector<const gcov_location_inline *> inl;
+  pos.reserve (func.locations.size ());
+  inl.reserve (func.locations.size ());
+  for (const auto &loc : func.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	inl.push_back (static_cast<const gcov_location_inline *> (loc.get ()));
+      else
+	pos.push_back (loc.get ());
+    }
+
+  gcov_write_uint32 (file, static_cast<uint32_t> (pos.size ()));
+  gcov_write_uint32 (file, static_cast<uint32_t> (inl.size ()));
+  for (const gcov_location *loc : pos)
+    write_pos_count (loc);
+  for (const gcov_location_inline *cs : inl)
+    write_inline_callsite (*cs);
+}
+
+/* FUNCTION record: tag + length word + num_functions + records.  */
+void
+gcov_writer_v3::write_functions ()
+{
+  gcov_write_uint32 (file, v3::format::GCOV_TAG_AFDO_FUNCTION);
+  gcov_write_uint32 (file, 0); /* Unused record length.  */
+
+  const std::vector<gcov_function> &functions = profile->get_functions ();
+  gcov_write_uint32 (file, static_cast<uint32_t> (functions.size ()));
+  for (const auto &func : functions)
+    write_function (func);
+}
+
+bool
+gcov_writer_v3::write ()
+{
+  if (!file)
+    {
+      fprintf (stderr, "Error: failed to create output file\n");
+      return false;
+    }
+  if (profile == nullptr)
+    {
+      fprintf (stderr, "Error: no profile data to write\n");
+      return false;
+    }
+
+  gcov_write_uint32 (file, v3::format::GCOV_DATA_MAGIC);
+  gcov_write_uint32 (file, v3::format::GCOV_VERSION);
+  gcov_write_uint32 (file, 0); /* Checksum (not used).  */
+
+  write_summary ();
+  write_file_names (); /* Also emits the function-name table.  */
+  write_functions ();
+
+  /* MODULE_GROUPING.  */
+  gcov_write_uint32 (file, v3::format::GCOV_TAG_MODULE_GROUPING);
+  gcov_write_uint32 (file, 1); /* Payload length in words.  */
+  gcov_write_uint32 (file, 0); /* num_modules = 0.  */
+
+  /* WORKING_SET: GCC's auto-profile reader does not consume this, but emit a
+     zero-filled record so the v3 file stays structurally complete.  */
+  gcov_write_uint32 (file, v3::format::GCOV_TAG_AFDO_WORKING_SET);
+  gcov_write_uint32 (file, v3::format::GCOV_WORKING_SET_BUCKETS * 3);
+  for (uint32_t i = 0; i < v3::format::GCOV_WORKING_SET_BUCKETS; ++i)
+    {
+      gcov_write_uint32 (file, 0); /* num_counters.  */
+      gcov_write_uint64 (file, 0); /* min_counter.  */
+    }
+
+  return close ();
+}
+
+} /* namespace gcov.  */
