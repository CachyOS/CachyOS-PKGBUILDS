+void
+check_round_trip (bool text)
+{
+  const std::string caller_name = quoted_name ("caller");
+  const std::string callee_name = quoted_name ("callee");
+  const std::string inline_name = quoted_name ("inlined");
+  const std::string file_name = quoted_name ("caller.cc");
+  const std::string inline_file = quoted_name ("inlined.cc");
+
+  gcov::gcov_profile profile;
+  profile.set_names ({file_name, inline_file},
+		     {"", caller_name, callee_name, inline_name},
+		     {gcov::INVALID_INDEX, 0, 0, 1});
+
+  gcov::gcov_function function;
+  function.id = 1;
+  function.desc.name_index = 1;
+  function.desc.file_index = 0;
+  function.head_count = 10;
+  auto call = std::make_unique<gcov::gcov_location_call> (10);
+  call->offset = 3;
+  call->discriminator = 2;
+  call->callee_map[2] = 7;
+  function.locations.push_back (std::move (call));
+
+  auto inlined = std::make_unique<gcov::gcov_location_inline> ();
+  inlined->offset = 4;
+  inlined->inlined_sym.id = 3;
+  inlined->inlined_sym.desc.name_index = 3;
+  inlined->inlined_sym.desc.file_index = 1;
+  auto inlined_count = std::make_unique<gcov::gcov_location_normal> (5);
+  inlined_count->offset = 1;
+  inlined->inlined_sym.locations.push_back (std::move (inlined_count));
+  inlined->inlined_sym.total_count
+    = gcov::gcov_function_subtree_count (inlined->inlined_sym);
+  function.locations.push_back (std::move (inlined));
+  function.total_count = gcov::gcov_function_subtree_count (function);
+  std::vector<gcov::gcov_function> functions;
+  functions.push_back (std::move (function));
+  profile.set_functions (std::move (functions));
+
+  gcov::gcov_summary summary;
+  summary.total_count = 15;
+  summary.max_count = 10;
+  summary.max_function_count = 10;
+  summary.num_counts = 1;
+  summary.num_functions = 1;
+  profile.set_summary (std::move (summary));
+
+  const std::string path = temporary_path ();
+  gcov::gcov_writer_options options;
+  options.version = 4;
+  options.text = text;
+  std::unique_ptr<gcov::gcov_writer_base> writer
+    = gcov::make_gcov_writer (path, &profile, options);
+  expect (writer != nullptr && writer->write (), "write v4 profile");
+  writer.reset ();
+  if (!text)
+    check_binary_header (path);
+
+  std::unique_ptr<gcov::gcov_reader_base> reader
+    = gcov::make_gcov_reader (path);
+  expect (reader != nullptr && reader->read (), "read v4 profile");
+  const gcov::gcov_profile *round_trip = reader->get_profile ();
+  expect (round_trip->get_functions ().size () == 1,
+	  "preserve function count");
+  const gcov::gcov_function &read_function
+    = round_trip->get_functions ()[0];
+  expect (read_function.locations.size () == 2, "preserve location count");
+  expect (round_trip->get_function_names ()[read_function.desc.name_index]
+	    == caller_name,
+	  "preserve quoted function name");
+  expect (round_trip->get_file_names ()[read_function.desc.file_index]
+	    == file_name,
+	  "preserve quoted file name");
+
+  const gcov::gcov_location_call *read_call = nullptr;
+  const gcov::gcov_location_inline *read_inline = nullptr;
+  for (const auto &location : read_function.locations)
+    if (location->type == gcov::gcov_location::kind::call)
+      read_call
+	= static_cast<const gcov::gcov_location_call *> (location.get ());
+    else if (location->type == gcov::gcov_location::kind::inlined)
+      read_inline
+	= static_cast<const gcov::gcov_location_inline *> (location.get ());
+  expect (read_call != nullptr, "preserve call location");
+  expect (read_call->count == 10, "preserve independent call count");
+
+  uint32_t callee_id = gcov::INVALID_INDEX;
+  for (uint32_t i = 0; i < round_trip->get_function_names ().size (); ++i)
+    if (round_trip->get_function_names ()[i] == callee_name)
+      callee_id = i;
+  const auto target = read_call->callee_map.find (callee_id);
+  expect (callee_id != gcov::INVALID_INDEX
+	  && target != read_call->callee_map.end () && target->second == 7,
+	  "preserve call target count");
+  const uint32_t callee_file = round_trip->get_file_name_map ()[callee_id];
+  expect (callee_file < round_trip->get_file_names ().size ()
+	  && round_trip->get_file_names ()[callee_file] == file_name,
+	  "preserve indirect-call-only target file");
+  expect (read_inline != nullptr, "preserve inline location");
+  expect (round_trip->get_function_names ()
+	    [read_inline->inlined_sym.desc.name_index]
+	    == inline_name,
+	  "preserve quoted inline name");
+  expect (read_function.total_count == 15, "preserve function total");
+
+  if (!text)
+    {
+      gcov::gcov_reader_v4 partial_reader (path);
+      expect (partial_reader.read (inline_file, true), "partially read v4");
+      expect (partial_reader.get_profile ()->get_functions ().size () == 1,
+	      "load cross-file inliner");
+      gcov::gcov_reader_v4 basename_reader (path);
+      expect (basename_reader.read ("/other/" + inline_file, false),
+	      "partially read v4 by basename");
+      expect (basename_reader.get_profile ()->get_functions ().size () == 1,
+	      "match a basename with an embedded NUL");
+      gcov::gcov_reader_v4 file_list_reader (path);
+      file_list_reader.set_partial_files ({file_name, inline_file});
+      expect (file_list_reader.read (), "partially read v4 file list");
+      expect (file_list_reader.get_profile ()->get_functions ().size () == 1,
+	      "deduplicate multi-file partial read");
+      gcov::gcov_reader_v4 source_files_reader (path);
+      expect (source_files_reader.read_files ({"/other/" + inline_file},
+					      false),
+	      "partially read source files by basename");
+      expect (source_files_reader.get_profile ()->get_functions ().size () == 1,
+	      "load inliner for source file list");
+      expect (source_files_reader.read_files ({"missing-file.c"}, false),
+	      "partially read missing source file");
+      expect (source_files_reader.get_profile ()->get_functions ().empty (),
+	      "missing source file has no functions");
+      expect (source_files_reader.read (), "full read after partial file list");
+      expect (source_files_reader.get_profile ()->get_functions ().size () == 1,
+	      "full read restores all functions");
+      check_invalid_binary_sections (path);
+      check_unknown_binary_records (path);
+    }
+  else
+    expect (!reader->supports_partial_read (),
+	    "text profiles do not support partial reads");
+
+  reader.reset ();
+  expect (unlink (path.c_str ()) == 0, "remove temporary profile");
+}
+
+void
+check_v3_header ()
+{
+  const std::string path = temporary_path ();
+  FILE *file = std::fopen (path.c_str (), "wb");
+  expect (file != nullptr, "open v3 header");
+  const uint32_t words[] = {gcov::v3::format::AFDO_GCOV_DATA_MAGIC,
+			    gcov::v3::format::AFDO_GCOV_VERSION};
+  expect (std::fwrite (words, sizeof (words), 1, file) == 1,
+	  "write native v3 header");
+  expect (std::fclose (file) == 0, "close v3 header");
+  expect (gcov::detect_format (path) == gcov::profile_format::v3_binary,
+	  "detect native v3 header");
+
+  file = std::fopen (path.c_str (), "wb");
+  expect (file != nullptr, "open invalid v3 header");
+  const uint32_t invalid[] = {words[0], words[1] + 1};
+  expect (std::fwrite (invalid, sizeof (invalid), 1, file) == 1,
+	  "write invalid v3 header");
+  expect (std::fclose (file) == 0, "close invalid v3 header");
+  expect (gcov::detect_format (path) == gcov::profile_format::unknown,
+	  "reject invalid v3 version");
+
+  gcov::gcov_profile profile;
+  profile.set_names ({"file.c"}, {"", "f"}, {gcov::INVALID_INDEX, 0});
+  gcov::gcov_function function;
+  function.id = 1;
+  function.head_count = 7;
+  function.locations.push_back (
+    std::make_unique<gcov::gcov_location_normal> (7));
+  std::vector<gcov::gcov_function> functions;
+  functions.push_back (std::move (function));
+  profile.set_functions (std::move (functions));
+  gcov::gcov_writer_v3 writer (path, &profile);
+  expect (writer.write (), "write native v3 profile");
+  std::unique_ptr<gcov::gcov_reader_base> reader
+    = gcov::make_gcov_reader (path);
+  expect (reader != nullptr && reader->read (), "read native v3 profile");
+  expect (reader->get_profile ()->get_functions ().size () == 1
+	  && reader->get_profile ()->get_functions ()[0].head_count == 7,
+	  "preserve native v3 function");
+  expect (unlink (path.c_str ()) == 0, "remove v3 header");
+}
+
+void
+check_varint_overflow ()
+{
+  const uint8_t wide64[] = {0x80, 0x80, 0x80, 0x80, 0x80,
+			    0x80, 0x80, 0x80, 0x80, 0x02};
+  const uint8_t *cur = wide64;
+  gcov::v4::clear_decode_error ();
+  (void) gcov::v4::read_varint (cur, wide64 + sizeof (wide64));
+  expect (gcov::v4::decode_failed (), "reject 64-bit varint overflow");
+
+  const uint8_t wide32[] = {0x80, 0x80, 0x80, 0x80, 0x10};
+  cur = wide32;
+  gcov::v4::clear_decode_error ();
+  (void) gcov::v4::read_varint32 (cur, wide32 + sizeof (wide32));
+  expect (gcov::v4::decode_failed (), "reject 32-bit varint overflow");
+}
+
+/* Construct small v3 profiles to exercise the table and target checks.  */
+void
+check_v3_input (unsigned empty_files, unsigned empty_names,
+		uint32_t target_type, uint64_t target_id, bool valid)
+{
+  const std::string path = temporary_path ();
+  FILE *file = std::fopen (path.c_str (), "wb");
+  expect (file != nullptr, "open v3 input");
+  gcov::gcov_write_uint32 (file, gcov::v3::format::AFDO_GCOV_DATA_MAGIC);
+  gcov::gcov_write_uint32 (file, gcov::v3::format::AFDO_GCOV_VERSION);
+  gcov::gcov_write_uint32 (file, 0);
+  gcov::gcov_write_uint32 (file, gcov::v3::format::GCOV_TAG_AFDO_SUMMARY);
+  for (unsigned i = 0; i < 6; ++i)
+    gcov::gcov_write_uint64 (file, 0);
+  gcov::gcov_write_uint32 (file, gcov::v3::format::GCOV_TAG_AFDO_FILE_NAMES);
+  gcov::gcov_write_uint32 (file, 0);
+  gcov::gcov_write_uint32 (file, empty_files);
+  for (unsigned i = 0; i < empty_files; ++i)
+    gcov::gcov_write_uint32 (file, 0);
+  gcov::gcov_write_uint32 (file, empty_names);
+  for (unsigned i = 0; i < empty_names; ++i)
+    {
+      gcov::gcov_write_uint32 (file, 0);
+      gcov::gcov_write_uint32 (file, gcov::INVALID_INDEX);
+    }
+  gcov::gcov_write_uint32 (file, gcov::v3::format::GCOV_TAG_AFDO_FUNCTION);
+  gcov::gcov_write_uint32 (file, 0);
+  const bool has_target = target_type != 0;
+  gcov::gcov_write_uint32 (file, has_target ? 1 : 0);
+  if (has_target)
+    {
+      gcov::gcov_write_uint64 (file, 1);
+      gcov::gcov_write_uint64 (file, 0);
+      gcov::gcov_write_uint32 (file, 0);
+      gcov::gcov_write_uint32 (file, 1);
+      gcov::gcov_write_uint32 (file, 0);
+      gcov::gcov_write_uint32 (file, 0);
+      gcov::gcov_write_uint32 (file, 1);
+      gcov::gcov_write_uint64 (file, 1);
+      gcov::gcov_write_uint32 (file, target_type);
+      gcov::gcov_write_uint64 (file, target_id);
+      gcov::gcov_write_uint64 (file, 1);
+    }
+  expect (std::fclose (file) == 0, "close v3 input");
+  gcov::gcov_reader_v3 reader (path);
+  expect (reader.read () == valid, "validate v3 input");
+  expect (unlink (path.c_str ()) == 0, "remove v3 input");
+}
+
+void
+check_v3_location_limits ()
+{
+  for (unsigned i = 0; i < 3; ++i)
+    {
+      const std::string path = temporary_path ();
+      gcov::gcov_profile profile;
+      profile.set_names ({}, {"", "f"}, {gcov::INVALID_INDEX,
+					  gcov::INVALID_INDEX});
+      std::vector<gcov::gcov_function> functions (1);
+      functions[0].id = 1;
+      auto inl = std::make_unique<gcov::gcov_location_inline> ();
+      auto loc = std::make_unique<gcov::gcov_location_normal> (1);
+      if (i == 0)
+	loc->discriminator = 0x10000;
+      else if (i == 1)
+	loc->offset = 0x10000;
+      else
+	loc->offset = UINT32_MAX;
+      inl->inlined_sym.locations.emplace_back (std::move (loc));
+      functions[0].locations.emplace_back (std::move (inl));
+      profile.set_functions (std::move (functions));
+      gcov::gcov_writer_v3 writer (path, &profile);
+      expect (writer.write () == (i == 2), "check nested v3 location range");
+      expect (unlink (path.c_str ()) == 0, "remove v3 output");
+    }
+}
+
+void
+check_v4_to_v3_location_limit ()
+{
+  static const char text[] =
+    "filenames = { \"file.cc\" }\n"
+    "summary = { total_count = 1, max_count = 1, max_fn_count = 1, "
+    "num_counts = 1, num_functions = 1, num_detailed_entries = 0, "
+    "detailed_entries = { } }\n"
+    "\"f\":0(1:1:1:0) = { locations = { 1.65536 = 1 } }\n";
+  const std::string input = temporary_path ();
+  const std::string output = temporary_path ();
+  FILE *file = std::fopen (input.c_str (), "wb");
+  expect (file != nullptr, "open v4 input for conversion");
+  expect (std::fwrite (text, 1, sizeof (text) - 1, file) == sizeof (text) - 1,
+	  "write v4 input for conversion");
+  expect (std::fclose (file) == 0, "close v4 input for conversion");
+  auto reader = gcov::make_gcov_reader (input);
+  expect (reader != nullptr && reader->read (), "read v4 conversion input");
+  gcov::gcov_writer_v3 writer (output, reader->get_profile ());
+  expect (!writer.write (), "reject v4 discriminator outside v3 range");
+  expect (unlink (input.c_str ()) == 0, "remove v4 conversion input");
+  expect (unlink (output.c_str ()) == 0, "remove v3 conversion output");
+}
+
+} /* anonymous namespace.  */
+
+int
+main ()
+{
+  check_round_trip (false);
+  check_round_trip (true);
+  check_partial_unknown_file ();
+  check_unknown_text_sections ();
+  check_duplicate_text_symbol ();
+  check_long_trie_label ();
+  check_v3_header ();
+  check_v3_input (100, 0, 0, 0, true);
+  check_v3_input (0, 100, 0, 0, true);
+  check_v3_input (0, 1, gcov::v3::HIST_TYPE_INDIR_CALL_TOPN, 0, true);
+  check_v3_input (0, 1, gcov::v3::HIST_TYPE_INDIR_CALL_TOPN, 1, false);
+  check_v3_input (0, 1, 42, 0, false);
+  check_v3_location_limits ();
+  check_v4_to_v3_location_limit ();
+  check_varint_overflow ();
+  return 0;
+}
