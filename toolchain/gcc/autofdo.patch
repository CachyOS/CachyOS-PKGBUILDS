+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_AUTOFDO_MODEL_H
+#define GCC_AUTOFDO_MODEL_H
+
+#include "dwarf_types.h"
+#include "gcov.h"
+#include "hash_util.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace dwarf_debug {
+class dwarf_reader;
+struct function_alias_metadata;
+struct function_metadata;
+} // namespace dwarf_debug
+
+namespace perf_data {
+class profile_reader;
+}
+
+namespace autofdo {
+
+/* Key for inline callsites.  */
+struct callsite_key
+{
+  uint32_t call_line = 0;
+  uint32_t call_disc = 0;
+  dwarf_debug::interned_string function_name = nullptr;
+
+  bool operator< (const callsite_key &o) const noexcept
+  {
+    if (call_line != o.call_line)
+      return call_line < o.call_line;
+    if (call_disc != o.call_disc)
+      return call_disc < o.call_disc;
+    return dwarf_debug::string_value (function_name)
+	   < dwarf_debug::string_value (o.function_name);
+  }
+};
+
+struct interned_string_less
+{
+  bool operator() (dwarf_debug::interned_string a,
+		   dwarf_debug::interned_string b) const noexcept
+  {
+    return dwarf_debug::string_value (a) < dwarf_debug::string_value (b);
+  }
+};
+
+using pos_target_map
+  = std::map<dwarf_debug::interned_string, uint64_t, interned_string_less>;
+
+class function_builder
+{
+public:
+  using callsite_map
+    = std::map<callsite_key, std::unique_ptr<function_builder>>;
+  using position_count_map = std::map<uint64_t, uint64_t>;
+  using position_target_map = std::map<uint64_t, pos_target_map>;
+
+  function_builder () = default;
+  function_builder (const function_builder &);
+
+  std::string name;
+  std::string file_path;
+  uint32_t start_line = 0;
+  uint32_t discriminator = 0;
+  uint64_t total_count = 0;
+  uint64_t head_count = 0;
+
+  uint64_t compute_total_count ();
+  void collapse_copy_ids ();
+  void estimate_head_count (bool toplevel);
+  uint64_t profile_offset (uint32_t line, uint32_t disc_full) const;
+  function_builder &create_callsite (const callsite_key &key);
+  void add_incoming_entry_count (uint64_t count) { head_count += count; }
+  void deposit_position_max (uint32_t line, uint32_t disc, uint64_t count);
+  void record_call_target_max (uint32_t line, uint32_t disc,
+			       dwarf_debug::interned_string callee_name,
+			       uint64_t count);
+
+  const callsite_map &callsites () const { return callsite_nodes; }
+  const position_count_map &position_counts () const
+  {
+    return position_count_values;
+  }
+  const position_target_map &position_targets () const
+  {
+    return position_target_values;
+  }
+
+private:
+  friend class profile_builder;
+
+  bool has_sampled_mass () const;
+  void materialize_callsite_entry_counts ();
+
+  callsite_map callsite_nodes;
+  position_count_map position_count_values;
+  position_target_map position_target_values;
+};
+
+using function_profile_key = std::pair<std::string, uint64_t>;
+
+struct function_profile_key_hash
+{
+  size_t operator() (const function_profile_key &k) const noexcept
+  {
+    size_t h = std::hash<std::string>{}(k.first);
+    hash_combine (h, std::hash<uint64_t>{}(k.second));
+    return h;
+  }
+};
+
+struct function_profile
+{
+  uint64_t start_addr = 0;
+  uint64_t total_samples = 0;
+  uint64_t head_count = 0;
+  uint64_t timestamp = 0;
+  std::unique_ptr<function_builder> builder;
+
+  function_profile () = default;
+};
+
+class profile_builder
+{
+public:
+  using function_profile_map
+    = std::unordered_map<function_profile_key, function_profile,
+			 function_profile_key_hash>;
+
+  void reserve_profiles (size_t n) { function_profiles.reserve (n); }
+  const function_profile_map &profiles () const { return function_profiles; }
+
+  function_profile &get_or_create_function_profile (const std::string &name,
+						    uint64_t start_addr);
+
+  void init_function_builder (function_profile &func_profile,
+			      const dwarf_debug::function_metadata &func);
+
+  bool build_gcov_profile (gcov::gcov_profile &out);
+
+  void finalize_after_correlate (const perf_data::profile_reader &perf);
+  void materialize_alias_profiles (
+    const std::vector<dwarf_debug::function_metadata> &functions,
+    const std::vector<dwarf_debug::function_alias_metadata> &aliases);
+
+  profile_builder () = default;
+
+private:
+  function_profile_map function_profiles;
+};
+
+} /* namespace autofdo.  */
+
+#endif /* GCC_AUTOFDO_MODEL_H.  */
