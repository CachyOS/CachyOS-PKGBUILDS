diff --git a/afdo-tools/testsuite/afdo-test/addr-mapping-basic.c b/afdo-tools/testsuite/afdo-test/addr-mapping-basic.c
new file mode 100644
index 00000000000..998e6059a80
--- /dev/null
+++ b/afdo-tools/testsuite/afdo-test/addr-mapping-basic.c
@@ -0,0 +1,52 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-create -m } */
+/* { dg-afdo-validate addr2line } */
+/* { dg-afdo-requires addr2line python3 perf } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+static inline __attribute__((always_inline))
+int leaf(int x)
+{
+  int y = x + seed;
+  return (y * 3) + 1;
+}
+
+static inline __attribute__((always_inline))
+int middle(int x)
+{
+  return leaf(x) + 11;
+}
+
+__attribute__((noinline))
+int hot_loop(int n)
+{
+  int sum = 0;
+
+  for (int i = 0; i < n; ++i)
+    if (seed > 0 && (i & 1) == 0) sum += middle(i); else sum += leaf(i);
+
+  return sum;
+}
+
+__attribute__((noinline))
+int cold_path(int x)
+{
+  return x - 17;
+}
+
+int main(void)
+{
+  int result = hot_loop(50000000);
+
+  if (result == 12345)
+    result += cold_path(result);
+
+  printf("%d\n", result);
+  return 0;
+}
