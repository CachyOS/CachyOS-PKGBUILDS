+GCOVREADERLIB = libgcovreader.a
+GCOVREADER_OBJS = afdo-file-mmap.o afdo-gcov-io.o afdo-gcov-reader.o \
+	afdo-gcov-reader-v3.o afdo-gcov-reader-v4.o
+GCOVREADERINC = -I$(srcdir)/../afdo_tools/src
+
 # Where to find decNumber
 enable_decimal_float = @enable_decimal_float@
 DECNUM = $(srcdir)/../libdecnumber
@@ -1198,7 +1203,7 @@ BUILD_ERRORS = build/errors.o
 INCLUDES = -I. -I$(@D) -I$(srcdir) -I$(srcdir)/$(@D) \
 	   -I$(srcdir)/../include $(INCINTL) \
 	   $(CPPINC) $(CODYINC) $(GMPINC) $(DECNUMINC) $(BACKTRACEINC) \
-	   $(ISLINC)
+	   $(ISLINC) $(GCOVREADERINC)
 
 COMPILE.base = $(COMPILER) -c $(ALL_COMPILERFLAGS) $(ALL_CPPFLAGS) -o $@
 ifeq ($(CXXDEPMODE),depmode=gcc3)
@@ -1970,7 +1975,7 @@ endif
 EXTRA_BACKEND_OBJS = simple-diagnostic-path.o diagnostics/lazy-paths.o
 
 BACKEND = $(EXTRA_BACKEND_OBJS) libbackend.a main.o libcommon-target.a \
-	libcommon.a $(CPPLIB) $(LIBDECNUMBER)
+	libcommon.a $(CPPLIB) $(LIBDECNUMBER) $(GCOVREADERLIB)
 
 # This is defined to "yes" if Tree checking is enabled, which roughly means
 # front-end checking.
@@ -1996,7 +2001,7 @@ MOSTLYCLEANFILES = insn-flags.h insn-config.h insn-codes.h \
  genversion$(build_exeext) gcov$(exeext) gcov-dump$(exeext) \
  gcov-tool$(exeect) \
  gengtype$(exeext) *.[0-9][0-9].* *.[si] *-checksum.cc libbackend.a \
- libcommon-target.a libcommon.a libgcc.mk perf.data
+ libcommon-target.a libcommon.a $(GCOVREADERLIB) libgcc.mk perf.data
 
 # This symlink makes the full installation name of the driver be available
 # from within the *build* directory, for use when running the JIT library
@@ -2326,6 +2331,27 @@ SELFTEST_FLAGS = -nostdinc $(DEVNULL) -S -o $(DEVNULL) \
 SELFTEST_TARGETS = @selftest_languages@
 selftest: $(SELFTEST_TARGETS)
 
+# AutoFDO reader objects: afdo_tools sources archived into $(GCOVREADERLIB) for
+# cc1.
+GCOVREADER_COMPILE = $(COMPILER) -c $(CXXFLAGS) -fno-exceptions -fno-rtti \
+	-include auto-host.h $(GCOVREADERINC)
+
+afdo-file-mmap.o: $(srcdir)/../afdo_tools/src/file_mmap.cc
+	$(GCOVREADER_COMPILE) $< $(OUTPUT_OPTION)
+afdo-gcov-io.o: $(srcdir)/../afdo_tools/src/gcov_io.cc
+	$(GCOVREADER_COMPILE) $< $(OUTPUT_OPTION)
+afdo-gcov-reader.o: $(srcdir)/../afdo_tools/src/gcov_reader.cc
+	$(GCOVREADER_COMPILE) $< $(OUTPUT_OPTION)
+afdo-gcov-reader-v3.o: $(srcdir)/../afdo_tools/src/gcov_reader_v3.cc
+	$(GCOVREADER_COMPILE) $< $(OUTPUT_OPTION)
+afdo-gcov-reader-v4.o: $(srcdir)/../afdo_tools/src/gcov_reader_v4.cc
+	$(GCOVREADER_COMPILE) $< $(OUTPUT_OPTION)
+
+$(GCOVREADERLIB): $(GCOVREADER_OBJS)
+	-rm -f $@
+	$(AR) $(AR_FLAGS) $@ $(GCOVREADER_OBJS)
+	$(RANLIB) $@
+
 # Recompile all the language-independent object files.
 # This is used only if the user explicitly asks for it.
 compilations: $(BACKEND)
diff --git a/gcc/auto-profile.cc b/gcc/auto-profile.cc
