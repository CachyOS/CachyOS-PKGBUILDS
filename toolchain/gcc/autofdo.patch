+constexpr uint64_t AARCH64_INSN_SIZE = 4;
+
+/* Filled from SPE AUXTRACE.  Callbacks borrow CTX for address filtering and
+   timestamp recording; taken edges go in branch_counts and conditional
+   not-taken branch PCs in not_taken_counts.  */
+struct arm_spe_profile_accumulator
+{
+  bool (*accept_addr) (uint64_t runtime_addr, void *ctx) = nullptr;
+  void (*note_timestamp) (uint64_t runtime_addr, uint64_t timestamp, void *ctx)
+    = nullptr;
+  void *ctx = nullptr;
+  branch_stack_edge_count_map *branch_counts = nullptr;
+  std::unordered_map<uint64_t, uint64_t> *not_taken_counts = nullptr;
+};
+
+/* Decode one AUXTRACE SPE buffer.  Trailing truncated packets are ignored;
+   mid-stream corruption returns false.  */
+bool arm_spe_aux_accumulate_profile (const uint8_t *spe_buf, size_t spe_len,
+				     arm_spe_profile_accumulator *acc);
+
+/* Profiled binary executable bytes, keyed by static vaddr.  */
+class arm_text_image
+{
+  struct segment
+  {
+    uint64_t vaddr;
+    std::vector<uint8_t> bytes;
+  };
+  std::vector<segment> segments_;
+
+public:
+  bool load (const std::string &binary_path);
+
+  /* False only for an AArch64 unconditional transfer; unknown addrs stay
+     true.  */
+  bool can_fall_through (uint64_t addr) const;
+};
+
+/* LBR-style fall-through ranges; stop where TEXT cannot fall through.  */
+void arm_spe_synthesize_ranges (
+  const branch_stack_edge_count_map &branch_counts,
+  const std::unordered_map<uint64_t, uint64_t> &not_taken_counts,
+  const arm_text_image &text, branch_stack_edge_count_map *range_counts);
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_ARM_SPE_AUX_DECODE_H.  */
