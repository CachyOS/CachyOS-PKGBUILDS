+
+#include "dwarf_reader_impl.h"
+#include "function_metadata_util.h"
+#include "symbol_util.h"
+#include "afdo_assert.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <dwarf.h>
+#include <elf.h>
+#include <elfutils/libdw.h>
+#include <gelf.h>
+#include <fcntl.h>
+#include <iterator>
+#include <libelf.h>
+#include <thread>
+#include <unordered_set>
+#include <unistd.h>
+
+namespace dwarf_debug {
+namespace {
+
+constexpr unsigned CU_PARSE_DEFAULT_THREADS = 8;
+
+/* DW_AT_GNU_discriminator (GCC vendor attr; not in elfutils dwarf.h).  */
+constexpr Dwarf_Half DW_AT_CALL_DISCRIMINATOR_EXT = 0x2136;
+
+using cu_die_pc_ranges = std::vector<std::pair<uint64_t, uint64_t>>;
+
+/* DW_AT_call_line / call_file / call_discriminator decoded from an inline
+   scope DIE; line is zero when the DIE carries no call_line.  */
+struct die_call_site
+{
+  uint32_t line = 0;
+  uint32_t disc = 0;
+  /* Borrowed from libdw's CU file table; valid while its Dwarf handle lives. */
+  const char *file = nullptr;
+};
+
+struct decoded_inline_die
+{
+  /* Both pointers are borrowed from libdw and interned before being stored.  */
+  const char *function_name = nullptr;
+  die_call_site call;
+};
+
+/* Definition-site decl_line / decl_file for a subprogram or
+   inlined_subroutine DIE.  decl_file points into the libdw CU file table
+   (borrowed).  */
+struct subprogram_decl_info
+{
+  uint32_t decl_line = 0;
+  const char *decl_file = nullptr;
+};
+
+bool
+primary_locations_equal (const source_location &a, const source_location &b)
+{
+  return a.file_path == b.file_path && a.line_number == b.line_number
+	 && a.discriminator == b.discriminator;
+}
+
+/* Build prefix maximum ends for overlap lookup.  */
+template <typename Range>
+void
+build_range_max_ends (const std::vector<Range> &ranges,
+		      std::vector<uint64_t> &max_ends)
+{
+  max_ends.clear ();
+  max_ends.reserve (ranges.size ());
+  uint64_t maximum = 0;
+  for (const Range &range : ranges)
+    {
+      maximum = std::max (maximum, range.end);
+      max_ends.push_back (maximum);
+    }
+}
+
+template <typename Range>
+void
+build_range_max_tree (const std::vector<Range> &ranges,
+		      range_max_tree_index &index)
+{
+  index.leaf_base = 1;
+  while (index.leaf_base < ranges.size ())
+    index.leaf_base *= 2;
+  index.max_ends.assign (index.leaf_base * 2, 0);
+  for (size_t i = 0; i < ranges.size (); ++i)
+    index.max_ends[index.leaf_base + i] = ranges[i].end;
+  for (size_t i = index.leaf_base; i-- > 1;)
+    index.max_ends[i]
+      = std::max (index.max_ends[i * 2], index.max_ends[i * 2 + 1]);
+}
+
+template <typename Visitor>
+void
+visit_range_max_tree (const range_max_tree_index &index, size_t node,
+		      size_t node_begin, size_t node_end, size_t query_end,
+		      uint64_t query_start, Visitor &visitor)
+{
+  if (node_begin >= query_end || index.max_ends[node] <= query_start)
+    return;
+  if (node >= index.leaf_base)
+    {
+      visitor (node - index.leaf_base);
+      return;
+    }
+  const size_t middle = node_begin + (node_end - node_begin) / 2;
+  visit_range_max_tree (
+    index, node * 2, node_begin, middle, query_end, query_start, visitor);
+  visit_range_max_tree (
+    index, node * 2 + 1, middle, node_end, query_end, query_start, visitor);
+}
+
+template <typename Range, typename Visitor>
+void
+visit_overlapping_ranges (const std::vector<Range> &ranges,
+			  const range_max_tree_index &index, uint64_t start,
+			  uint64_t end, Visitor visitor)
+{
+  if (start >= end || ranges.empty ())
+    return;
+  const auto limit
+    = std::lower_bound (ranges.begin (),
+			ranges.end (),
+			end,
+			[] (const Range &range, uint64_t address)
+			{
+			  return range.start < address;
+			});
+  const size_t query_end = static_cast<size_t> (limit - ranges.begin ());
+  visit_range_max_tree (
+    index, 1, 0, index.leaf_base, query_end, start, visitor);
+}
+
+struct identity_candidates
+{
+  interned_string file = nullptr;
+  uint32_t line = 0;
+  bool file_ambiguous = false;
+  bool line_ambiguous = false;
+
+  void add (const function_metadata &function)
+  {
+    if (!string_empty (function.file_path))
+      {
+	if (file == nullptr)
+	  file = function.file_path;
+	else if (!source_path::equivalent (
+		   string_value (file), string_value (function.file_path)))
+	  file_ambiguous = true;
+      }
+    if (function.start_line != 0)
+      {
+	if (line == 0)
+	  line = function.start_line;
+	else if (line != function.start_line)
+	  line_ambiguous = true;
+      }
+  }
+
+  inline_function_identity identity () const
+  {
+    inline_function_identity result;
+    if (!file_ambiguous && !string_empty (file))
+      result.file_path = string_value (file);
+    if (!line_ambiguous)
+      result.decl_line = line;
+    return result;
+  }
+};
+
+void
+add_identity_candidate (const function_metadata &function,
+			const std::string &name, const std::string &file_hint,
+			identity_candidates &all,
+			identity_candidates &contextual)
+{
+  if (!gcc_symbol::name_equivalent (string_value (function.name), name))
+    return;
+  all.add (function);
+  if (!file_hint.empty () && !string_empty (function.file_path)
+      && source_path::equivalent (
+	string_value (function.file_path), file_hint))
+    contextual.add (function);
+}
+
+/* Return the slice that may overlap LO through HI_EXCL.  */
+template <typename Range>
+address_range_index_span
+overlapping_range_index_span (const std::vector<Range> &ranges,
+			      const std::vector<uint64_t> &max_ends,
+			      uint64_t lo, uint64_t hi_excl)
+{
+  address_range_index_span span;
+  if (hi_excl <= lo || ranges.empty ())
+    return span;
+  afdo_assert (ranges.size () == max_ends.size ());
+
+  const auto end_it
+    = std::lower_bound (ranges.begin (),
+			ranges.end (),
+			hi_excl,
+			[] (const Range &range, uint64_t address)
+			{
+			  return range.start < address;
+			});
+  span.end = static_cast<size_t> (end_it - ranges.begin ());
+  const auto begin_it
+    = std::upper_bound (max_ends.begin (), max_ends.begin () + span.end, lo);
+  span.begin = static_cast<size_t> (begin_it - max_ends.begin ());
+  return span;
+}
+
+/* A DWARF file-table entry usable as a profile source file.  GCC also emits
+   pseudo-files (<built-in>, <artificial>) that name no source.  */
+bool
+dwarf_source_file_is_usable (const char *file)
+{
+  return file != nullptr && file[0] != '\0' && file[0] != '<';
+}
+
+/* ELF symtab entries treated as correlatable function ranges: STT_FUNC,
+   trailing .cold blocks, and .__part.N splits; reject @plt and size 0.  */
+bool
+symtab_accepts_function_symbol (const char *name, uint64_t size, int sym_type)
+{
+  if (name == nullptr || name[0] == '\0' || size == 0)
+    return false;
+
+  std::string sv (name);
+  if (sym_type != STT_FUNC && !source_path::ends_with (sv, ".cold"))
+    {
+      while (!sv.empty ()
+	     && std::isdigit (static_cast<unsigned char> (sv.back ())))
+	sv.pop_back ();
+      if (!source_path::ends_with (sv, ".__part."))
+	return false;
+    }
+
+  return !source_path::ends_with (sv, "@plt");
+}
+
+const char *
+read_die_attr_linkage_name (Dwarf_Die *die)
+{
+  if (die == nullptr)
+    return nullptr;
+  Dwarf_Attribute attr_mem;
+  Dwarf_Attribute *attr = dwarf_attr (die, DW_AT_linkage_name, &attr_mem);
+  if (attr == nullptr)
+    return nullptr;
+  return dwarf_formstring (attr);
+}
+
+bool
+die_is_declaration (Dwarf_Die *die)
+{
+  Dwarf_Attribute decl_mem;
+  Dwarf_Attribute *decl_attr = dwarf_attr (die, DW_AT_declaration, &decl_mem);
+  if (decl_attr == nullptr)
+    return false;
+  bool flag = false;
+  return dwarf_formflag (decl_attr, &flag) == 0 && flag;
+}
+
+/* Keep defining subprograms with real code addresses.  */
+bool
+should_record_subprogram_die (Dwarf_Die *die)
+{
+  if (die == nullptr)
+    return false;
+
+  if (die_is_declaration (die))
+    return false;
+
+  afdo_assert (dwarf_tag (die) == DW_TAG_subprogram);
+
+  /* Present-but-zero low_pc/entry_pc == eliminated COMDAT copy; treat as no
+     code.  */
+  Dwarf_Addr lowpc = 0;
+  if (dwarf_lowpc (die, &lowpc) == 0 && lowpc != 0)
+    return true;
+
+  Dwarf_Attribute entry_mem;
+  Dwarf_Attribute *entry_attr = dwarf_attr (die, DW_AT_entry_pc, &entry_mem);
+  if (entry_attr != nullptr)
+    {
+      Dwarf_Addr entry = 0;
+      if (dwarf_formaddr (entry_attr, &entry) == 0 && entry != 0)
+	return true;
+    }
+
+  /* Non-contiguous code (e.g. -ffunction-sections / hot-cold split): accept
+     if any DW_AT_ranges entry is non-empty (a zeroed [0,0) COMDAT range
+     fails).  */
+  Dwarf_Addr base = 0;
+  Dwarf_Addr start = 0;
+  Dwarf_Addr end = 0;
+  ptrdiff_t roff = 0;
+  while (true)
+    {
+      const ptrdiff_t next = dwarf_ranges (die, roff, &base, &start, &end);
+      if (next <= 0)
+	break;
+      if (next <= roff)
+	break;
+      roff = next;
+      if (end > start)
+	return true;
+    }
+
+  return false;
+}
+
+/* Resolve gcov symbol name: prefer linkage name, else DW_AT_name via
+   spec/abstract-origin chain.  */
+const char *
+resolve_die_symbol_name (Dwarf_Die *die)
+{
+  if (die == nullptr)
+    return nullptr;
+
+  const char *first_diename = nullptr;
+  Dwarf_Die cur = *die;
+  /* Cycle guard: a spec/abstract-origin reference must never revisit a DIE
+     we already walked (malformed/looping DWARF).  Well-formed chains are
+     1-3 deep, so this set stays tiny.  */
+  std::vector<Dwarf_Off> seen;
+  for (;;)
+    {
+      const Dwarf_Off off = dwarf_dieoffset (&cur);
+      if (std::find (seen.begin (), seen.end (), off) != seen.end ())
+	break;
+      seen.push_back (off);
+
+      /* Linkage name is the gcov key; the first one on the chain is the
+	 one.  */
+      const char *link = read_die_attr_linkage_name (&cur);
+      if (link != nullptr && link[0] != '\0')
+	return link;
+
+      const char *diename = dwarf_diename (&cur);
+      if (diename != nullptr && diename[0] != '\0' && first_diename == nullptr)
+	first_diename = diename;
+
+      /* Follow DW_AT_specification, else DW_AT_abstract_origin, to the next
+	 DIE in the chain (dwarf_formref_die rewrites cur); stop when
+	 neither.  */
+      Dwarf_Attribute attr_mem;
+      const bool advanced
+	= (dwarf_attr (&cur, DW_AT_specification, &attr_mem) != nullptr
+	   && dwarf_formref_die (&attr_mem, &cur) != nullptr)
+	  || (dwarf_attr (&cur, DW_AT_abstract_origin, &attr_mem) != nullptr
+	      && dwarf_formref_die (&attr_mem, &cur) != nullptr);
+      if (!advanced)
+	break;
+    }
+
+  return first_diename;
+}
+
+/* True if every child PC range lies inside some parent range.  */
+bool
+pc_ranges_subset_of (const cu_die_pc_ranges &child,
+		     const cu_die_pc_ranges &parent)
+{
+  if (child.empty ())
+    return false;
+  return std::all_of (child.begin (), child.end (), [&] (const auto &cr) {
+    const uint64_t clo = cr.first;
+    const uint64_t chi = cr.second;
+    if (chi <= clo)
+      return true;
+    return std::any_of (parent.begin (), parent.end (), [&] (const auto &pr) {
+      return pr.first <= clo && chi <= pr.second;
+    });
+  });
+}
+
+Dwarf_Word
+die_udata_attr (Dwarf_Die *die, Dwarf_Half attr_name)
+{
+  if (die == nullptr)
+    return 0;
+  Dwarf_Attribute attr_mem;
+  Dwarf_Attribute *attr = dwarf_attr (die, attr_name, &attr_mem);
+  Dwarf_Word value = 0;
+  if (attr == nullptr || dwarf_formudata (attr, &value) != 0)
+    return 0;
+  return value;
+}
+
+/* CU path for DW_AT_call_file, or null.  libdw's table is already indexed by
+   the raw attribute value (DWARF 5 from 0; earlier versions keep a dummy
+   row 0).  */
+const char *
+die_call_file_path (Dwarf_Die *die)
+{
+  Dwarf_Attribute attr_mem;
+  if (die == nullptr || dwarf_attr (die, DW_AT_call_file, &attr_mem) == nullptr)
+    return nullptr;
+  Dwarf_Word file_idx = 0;
+  if (dwarf_formudata (&attr_mem, &file_idx) != 0)
+    return nullptr;
+  Dwarf_Die cu_mem;
+  Dwarf_Die *cu = dwarf_diecu (die, &cu_mem, nullptr, nullptr);
+  Dwarf_Files *files = nullptr;
+  size_t nfiles = 0;
+  if (cu == nullptr || dwarf_getsrcfiles (cu, &files, &nfiles) != 0
+      || files == nullptr || file_idx >= nfiles)
+    return nullptr;
+  const char *path
+    = dwarf_filesrc (files, static_cast<size_t> (file_idx), nullptr, nullptr);
+  if (path == nullptr || path[0] == '\0')
+    return nullptr;
+  return path;
+}
+
+die_call_site
+read_die_call_site (Dwarf_Die *die)
+{
+  const Dwarf_Word line = die_udata_attr (die, DW_AT_call_line);
+  if (line == 0)
+    return {};
+  const uint32_t discriminator = static_cast<uint32_t> (
+    die_udata_attr (die, DW_AT_CALL_DISCRIMINATOR_EXT));
+  return {
+    static_cast<uint32_t> (line), discriminator, die_call_file_path (die)};
+}
+
+decoded_inline_die
+decode_inline_die (Dwarf_Die *die)
+{
+  return {resolve_die_symbol_name (die), read_die_call_site (die)};
+}
+
+/* Decl line/file from the DIE, or its enclosing class/struct for artificial
+   members (e.g. lambda operator()) that omit DW_AT_decl_*.  */
+subprogram_decl_info
+resolve_subprogram_decl_info (Dwarf_Die *die)
+{
+  subprogram_decl_info info;
+  if (die == nullptr)
+    return info;
+
+  int ln = 0;
+  if (dwarf_decl_line (die, &ln) == 0 && ln > 0)
+    info.decl_line = static_cast<uint32_t> (ln);
+  const char *file = dwarf_decl_file (die);
+  if (file != nullptr && file[0] != '\0')
+    info.decl_file = file;
+  if (info.decl_line != 0
+      || (info.decl_file != nullptr && info.decl_file[0] != '\0'))
+    return info;
+
+  Dwarf_Die origin_mem;
+  Dwarf_Die *origin = die;
+  Dwarf_Attribute attr_mem;
+  if (dwarf_attr_integrate (die, DW_AT_abstract_origin, &attr_mem) != nullptr
+      || dwarf_attr_integrate (die, DW_AT_specification, &attr_mem) != nullptr)
+    {
+      Dwarf_Die *ref = dwarf_formref_die (&attr_mem, &origin_mem);
+      if (ref != nullptr)
+	origin = ref;
+    }
+
+  Dwarf_Die *scopes = nullptr;
+  const int nscopes = dwarf_getscopes_die (origin, &scopes);
+  for (int i = 0; i < nscopes; ++i)
+    {
+      const int tag = dwarf_tag (&scopes[i]);
+      if (tag != DW_TAG_class_type && tag != DW_TAG_structure_type
+	  && tag != DW_TAG_union_type)
+	continue;
+      ln = 0;
+      if (dwarf_decl_line (&scopes[i], &ln) == 0 && ln > 0)
+	info.decl_line = static_cast<uint32_t> (ln);
+      file = dwarf_decl_file (&scopes[i]);
+      if (file != nullptr && file[0] != '\0')
+	info.decl_file = file;
+      break;
+    }
+  free (scopes);
+  return info;
+}
+
+/* Open per-thread libdw session (handles are not thread-safe).  */
+bool
+open_thread_libdw_session (const std::string &binary_path,
+			   libdw_file_session &session)
+{
+  session.fd = open (binary_path.c_str (), O_RDONLY);
+  if (session.fd < 0)
+    return false;
+  session.dwarf = dwarf_begin (session.fd, DWARF_C_READ);
+  if (!session.dwarf)
+    {
+      close (session.fd);
+      session.fd = -1;
+      return false;
+    }
+  return true;
+}
+
+void
+close_thread_libdw_session (libdw_file_session &session)
+{
+  if (session.dwarf)
+    {
+      dwarf_end (session.dwarf);
+      session.dwarf = nullptr;
+    }
+  if (session.fd >= 0)
+    {
+      close (session.fd);
+      session.fd = -1;
+    }
+}
+
+symbolized_result
+store_correlate_symbolize_cache_entry (
+  correlate_session_scratch &session, uint64_t file_offset, size_t fidx,
+  std::vector<source_location> &&locs, size_t dwarf_line_index,
+  const std::vector<inline_frame> *inline_stack,
+  const std::vector<function_metadata> &functions)
+{
+  symbolized_result result;
+  correlate_symbolize_entry entry;
+  entry.function_index = fidx;
+  entry.locations = std::move (locs);
+  entry.dwarf_line_index = dwarf_line_index;
+  entry.inline_stack = inline_stack;
+  const auto inserted
+    = session.symbolize_cache.emplace (file_offset, std::move (entry));
+  result.function = &functions[fidx];
+  result.locations = &inserted.first->second.locations;
+  result.inline_stack = inline_stack;
+  return result;
+}
+
+/* Decode DW_AT_high_pc for a DIE with the given DW_AT_low_pc: either an
+   absolute address (DW_FORM_addr) or an offset from low_pc (DW_FORM_data*).
+   Returns low
+   when the attribute is absent or unusable (caller drops the empty range).  */
+uint64_t
+read_die_high_pc (Dwarf_Die *d, uint64_t low)
+{
+  Dwarf_Attribute attr_mem;
+  Dwarf_Attribute *const attr = dwarf_attr (d, DW_AT_high_pc, &attr_mem);
+  if (attr == nullptr)
+    return low;
+  Dwarf_Addr addr = 0;
+  if (dwarf_formaddr (attr, &addr) == 0)
+    return static_cast<uint64_t> (addr);
+  Dwarf_Word offset = 0;
+  if (low != 0 && dwarf_formudata (attr, &offset) == 0 && offset != 0)
+    return low + static_cast<uint64_t> (offset);
+  return low;
+}
+
+/* Decode DIE PC ranges from low_pc/high_pc and ranges.
+   Returns true if the DIE declared its own extent (even if empty).  */
+bool
+collect_die_pc_ranges (Dwarf_Die *d, cu_die_pc_ranges &out)
+{
+  out.clear ();
+  if (d == nullptr)
+    return false;
+
+  bool declared_pc_extent = false;
+
+  Dwarf_Addr lowpc = 0;
+  if (dwarf_lowpc (d, &lowpc) == 0)
+    {
+      declared_pc_extent = true;
+      const uint64_t low = static_cast<uint64_t> (lowpc);
+      const uint64_t high = read_die_high_pc (d, low);
+      if (high > low)
+	out.emplace_back (low, high);
+    }
+
+  if (dwarf_hasattr (d, DW_AT_ranges))
+    declared_pc_extent = true;
+
+  Dwarf_Addr base = 0, start = 0, end = 0;
+  Dwarf_Off offset = 0;
+  ptrdiff_t next;
+  while ((next = dwarf_ranges (d, offset, &base, &start, &end)) > 0)
+    {
+      const Dwarf_Off next_off = static_cast<Dwarf_Off> (next);
+      if (next_off <= offset)
+	break;
+      offset = next_off;
+      if (end > start)
+	out.emplace_back (
+	  static_cast<uint64_t> (start), static_cast<uint64_t> (end));
+    }
+  return declared_pc_extent;
+}
+
+/* Source file the line table records at PC (the definition file for a
+   function's entry PC), or nullptr when the CU line table has no row there.  */
+const char *
+line_table_source_file_at_pc (Dwarf_Die *cudie, uint64_t pc)
+{
+  if (cudie == nullptr)
+    return nullptr;
+  Dwarf_Line *const line
+    = dwarf_getsrc_die (cudie, static_cast<Dwarf_Addr> (pc));
+  if (line == nullptr)
+    return nullptr;
+  return dwarf_linesrc (line, nullptr, nullptr);
+}
