+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_GCOV_H
+#define GCC_GCOV_H
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace gcov {
+/* All-ones sentinel for an absent name, file, section, or symbol index.  */
+constexpr uint32_t INVALID_INDEX = UINT32_MAX;
+
+/* Unknown timestamps sort after every value representable by GCC's signed
+   gcov_type.  */
+constexpr uint64_t UNKNOWN_TIMESTAMP = static_cast<uint64_t> (INT64_MAX);
+
+struct gcov_location
+{
+  uint32_t offset = 0;
+  uint32_t discriminator = 0;
+  enum class kind
+  {
+    normal,
+    call,
+    inlined
+  } type;
+  gcov_location (kind type_) : type (type_) {}
+  virtual ~gcov_location () = default;
+  uint64_t encoded_offset () const
+  {
+    return (static_cast<uint64_t> (offset) << 32) | discriminator;
+  }
+  uint64_t total_count () const;
+};
+
+struct gcov_function
+{
+  struct descriptor
+  {
+    /* Indices into gcov_profile::function_names / file_names (file_index
+       is INVALID_INDEX when the function has no source file).  */
+    uint32_t name_index = 0;
+    uint32_t file_index = INVALID_INDEX;
+  } desc;
+  uint32_t id = 0;
+  uint64_t timestamp = 0;
+  uint64_t head_count = 0;
+  uint64_t total_count = 0;
+  std::vector<std::unique_ptr<gcov_location>> locations;
+};
+} /* namespace gcov.  */
+
+namespace gcov {
+struct gcov_summary_detailed_entry
+{
+  uint32_t cutoff = 0;
+  uint64_t min_count = 0;
+  uint64_t num_counts = 0;
+};
+
+struct gcov_summary
+{
+  uint64_t total_count = 0;
+  uint64_t max_count = 0;
+  uint64_t max_function_count = 0;
+  uint64_t num_counts = 0;
+  uint64_t num_functions = 0;
+  size_t num_detailed_entries = 0;
+  std::vector<gcov_summary_detailed_entry> detailed_entries;
+};
+
+class gcov_profile
+{
+  friend class gcov_merger;
+  friend class gcov_reader_v3;
+  friend class gcov_writer_v3;
+  std::vector<std::string> file_names;
+  std::vector<std::string> function_names;
+  /* Function-name index -> file-name index.  */
+  std::vector<uint32_t> file_name_map;
+  std::unordered_map<uint32_t /* function_id */, const gcov_function *>
+    function_map;
+  std::vector<gcov_function> functions;
+  gcov_summary summary;
+
+  void build_file_name_table (const std::vector<std::string> &symbol_paths)
+  {
+    file_names.clear ();
+    file_names.push_back ("");
+    std::unordered_map<std::string, uint32_t> path_to_file_idx;
+    file_name_map.assign (symbol_paths.size (), INVALID_INDEX);
+    for (size_t i = 1; i < symbol_paths.size (); ++i)
+      {
+	const std::string &path = symbol_paths[i];
+	if (path.empty ())
+	  continue;
+	auto inserted = path_to_file_idx.emplace (path, 0u);
+	if (inserted.second)
+	  {
+	    inserted.first->second = static_cast<uint32_t> (file_names.size ());
+	    file_names.push_back (path);
+	  }
+	file_name_map[i] = inserted.first->second;
+      }
+  }
+
+public:
+  gcov_profile () = default;
+  /* Immovable and non-copyable.  */
+  gcov_profile (const gcov_profile &) = delete;
+  gcov_profile (gcov_profile &&) = delete;
+  gcov_profile &operator= (const gcov_profile &) = delete;
+  gcov_profile &operator= (gcov_profile &&) = delete;
+
+  const std::vector<gcov_function> &get_functions () const { return functions; }
+
+  const std::vector<std::string> &get_function_names () const
+  {
+    return function_names;
+  }
+
+  const std::vector<std::string> &get_file_names () const { return file_names; }
+
+  /* Function id -> index into get_file_names () (INVALID_INDEX if none).  */
+  const std::vector<uint32_t> &get_file_name_map () const
+  {
+    return file_name_map;
+  }
+
+  const gcov_summary &get_summary () const { return summary; }
+
+  void clear ()
+  {
+    file_names.clear ();
+    function_names.clear ();
+    file_name_map.clear ();
+    function_map.clear ();
+    functions.clear ();
+    summary = gcov_summary ();
+  }
+
+  void rebuild_function_map ()
+  {
+    function_map.clear ();
+    function_map.reserve (functions.size ());
+    for (const auto &func : functions)
+      function_map[func.id] = &func;
+  }
+};
+
+struct gcov_location_normal : gcov_location
+{
+  uint64_t count = 0;
+  gcov_location_normal () : gcov_location (kind::normal) {}
+  gcov_location_normal (uint64_t count_) : gcov_location_normal ()
+  {
+    count = count_;
+  }
+};
+
+struct gcov_location_call : gcov_location
+{
+  uint64_t count = 0;
+  std::unordered_map<uint64_t /* function_id */, uint64_t /* count */>
+    callee_map;
+  gcov_location_call () : gcov_location (kind::call) {}
+  gcov_location_call (uint64_t count_) : gcov_location_call ()
+  {
+    count = count_;
+  }
+};
+
+struct gcov_location_inline : gcov_location
+{
+  gcov_function inlined_sym;
+  gcov_location_inline () : gcov_location (kind::inlined) {}
+};
+
+inline uint64_t
+gcov_location::total_count () const
+{
+  if (type == kind::normal)
+    return static_cast<const gcov_location_normal *> (this)->count;
+  else if (type == kind::call)
+    return static_cast<const gcov_location_call *> (this)->count;
+  else
+    return static_cast<const gcov_location_inline *> (this)
+      ->inlined_sym.total_count;
+}
+
+/* A function's total_count: the sum of its position counts plus the totals of
+   its inline subtrees.  Canonical definition of gcov_function::total_count;
+   callers that build or mutate a function's locations recompute it via
+   this.  */
+inline uint64_t
+gcov_function_subtree_count (const gcov_function &func)
+{
+  uint64_t total = 0;
+  for (const auto &loc : func.locations)
+    total += loc->total_count ();
+  return total;
+}
+
+/* AutoFDO v3 on-disk format constants (magic, tags, version).  */
+namespace v3 {
+/* GCC value-profile histogram type written per indirect-call target in the v3
+   format.  Only the top-N indirect-call type is emitted; keep its fixed GCC
+   value.  */
+enum hist_type : uint32_t
+{
+  HIST_TYPE_INDIR_CALL_TOPN = 7
+};
+
+/* GCOV file format constants.  */
+struct format
+{
+  enum : uint32_t
+  {
+    /* Magic numbers.  */
+    GCOV_DATA_MAGIC = 0x67636461, /* "gcda" */
+    /* AutoFDO-specific tags.  */
+    GCOV_TAG_AFDO_SUMMARY = 0xa8000000,
+    GCOV_TAG_AFDO_FILE_NAMES = 0xaa000000,
+    GCOV_TAG_AFDO_FUNCTION = 0xac000000,
+    GCOV_TAG_MODULE_GROUPING = 0xae000000,
+    GCOV_TAG_AFDO_WORKING_SET = 0xaf000000,
+    GCOV_WORKING_SET_BUCKETS = 128,
+    /* Profile version word.  */
+    GCOV_VERSION = 3
+  };
+};
+
+} /* namespace v3.  */
+
+} /* namespace gcov.  */
+
+#endif /* GCC_GCOV_H.  */
