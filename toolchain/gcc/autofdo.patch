+
+#include "gcov_writer.h"
+
+#include <cstdio>
+#include <string>
+
+namespace gcov {
+
+/* Open PATH for writing.  Keep FILE null after failure.  */
+gcov_writer_base::gcov_writer_base (const std::string &path,
+				    const gcov_profile *profile_)
+  : profile (profile_)
+{
+  file = fopen (path.c_str (), "wb");
+  if (!file)
+    {
+      fprintf (stderr, _("Error: Cannot open file %s\n"), path.c_str ());
+    }
+}
+
+gcov_writer_base::~gcov_writer_base ()
+{
+  if (file)
+    fclose (file);
+}
+
+bool
+gcov_writer_base::close ()
+{
+  if (!file)
+    return false;
+
+  const bool had_error = ferror (file) != 0;
+  const int rc = fclose (file);
+  file = nullptr;
+  if (had_error || rc != 0)
+    {
+      fprintf (stderr, _("Error: failed to close profile output file\n"));
+      return false;
+    }
+  return true;
+}
+
+std::unique_ptr<gcov_writer_base>
+make_gcov_writer (const std::string &path, const gcov_profile *profile,
+		  const gcov_writer_options &options)
+{
+  if (options.version == 3)
+    return std::make_unique<gcov_writer_v3> (path, profile);
+  return nullptr;
+}
+
+} /* namespace gcov.  */
