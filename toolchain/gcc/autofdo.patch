+{
+  if (cur > end || nbytes > (size_t) (end - cur))
+    {
+      set_decode_error ("v4: truncated big-endian value");
+      return 0;
+    }
+  uint64_t val = 0;
+  for (unsigned i = 0; i < nbytes; i++)
+    val = (val << 8) | *cur++;
+  return val;
