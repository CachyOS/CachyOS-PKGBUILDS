+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "profile_reader.h"
+
+#include "branch_stack_reader_base.h"
+#include "dwarf_reader.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <utility>
+
+namespace perf_data {
+
+void
+profile_reader::reset_profile_state ()
+{
+  profile_addresses_are_file_offsets_ = false;
+  sorted_touch_pcs_.clear ();
+  first_sample_time_by_pc_.clear ();
+  function_timestamps_.clear ();
+}
+
+void
+profile_reader::finalize_address_frequencies_with_mmaps (
+  std::unordered_map<uint64_t, uint64_t> &address_frequencies,
+  const std::vector<simple_mmap> &target_mmaps,
+  std::vector<uint64_t> *sorted_touch_pcs_out)
+{
+  if (address_frequencies.empty ())
+    return;
+
+  /* Translate runtime PCs to file offsets, merging aliases.  */
+  std::unordered_map<uint64_t, uint64_t> file_map;
+  file_map.reserve (address_frequencies.size ());
+  for (const auto &entry : address_frequencies)
+    {
+      const uint64_t runtime_addr = entry.first;
+      const uint64_t count = entry.second;
+      uint64_t file_off = 0;
+      if (!try_translate_runtime_with_mmaps (
+	    target_mmaps, runtime_addr, &file_off))
+	continue;
+      file_map[file_off] += count;
+    }
+  address_frequencies.swap (file_map);
+
+  if (sorted_touch_pcs_out == nullptr || !sorted_touch_pcs_out->empty ())
+    return;
+
+  sorted_touch_pcs_out->reserve (address_frequencies.size ());
+  for (const auto &entry : address_frequencies)
+    sorted_touch_pcs_out->push_back (entry.first);
+  std::sort (sorted_touch_pcs_out->begin (), sorted_touch_pcs_out->end ());
+  sorted_touch_pcs_out->erase (
+    std::unique (sorted_touch_pcs_out->begin (), sorted_touch_pcs_out->end ()),
+    sorted_touch_pcs_out->end ());
+}
+
+void
+profile_reader::note_sample_timestamp (uint64_t runtime_ip, uint64_t time)
+{
+  if (time == 0 || runtime_ip == 0)
+    return;
+  /* Callers stamp only target IPs; offset 0 is valid (PIE).  */
+  const uint64_t pc = translate_address (runtime_ip);
+  auto inserted = first_sample_time_by_pc_.emplace (pc, time);
+  if (!inserted.second && time < inserted.first->second)
+    inserted.first->second = time;
+}
+
+void
+profile_reader::fold_sample_timestamps_by_function (
+  const dwarf_debug::dwarf_reader &dwarf)
+{
+  if (first_sample_time_by_pc_.empty ())
+    {
+      function_timestamps_.clear ();
+      return;
+    }
+
+  function_timestamp_map folded;
+  std::unordered_map<dwarf_debug::function_instance_key,
+		     uint64_t *,
+		     dwarf_debug::function_instance_key_hash>
+    folded_cache;
+  for (const auto &entry : first_sample_time_by_pc_)
+    {
+      const uint64_t file_off = entry.first;
+      const uint64_t time = entry.second;
+      const dwarf_debug::function_metadata *meta
+	= dwarf.containing_function_at_pc (file_off);
+      if (meta == nullptr || dwarf_debug::string_empty (meta->name))
+	continue;
+
+      const dwarf_debug::function_instance_key view_key{
+	meta->name, meta->start_addr};
+      auto cached = folded_cache.find (view_key);
+      uint64_t *first_time;
+      if (cached != folded_cache.end ())
+	first_time = cached->second;
+      else
+	{
+	  auto inserted = folded.emplace (
+	    std::make_pair (
+	      dwarf_debug::string_value (meta->name), meta->start_addr),
+	    time);
+	  first_time = &inserted.first->second;
+	  folded_cache.emplace (
+	    dwarf_debug::function_instance_key{meta->name, meta->start_addr},
+	    first_time);
+	}
+      if (time < *first_time)
+	*first_time = time;
+    }
+
+  first_sample_time_by_pc_.clear ();
+  first_sample_time_by_pc_.rehash (0);
+  function_timestamps_.swap (folded);
+}
+
+const std::vector<profile_range> *
+profile_reader::range_counts () const
+{
+  const branch_stack_reader_base *bs = as_branch_stack_reader ();
+  if (bs == nullptr || !bs->has_finalized_profile ())
+    return nullptr;
+  const std::vector<profile_range> &ranges = bs->sorted_ranges ();
+  return ranges.empty () ? nullptr : &ranges;
+}
+
+const std::vector<profile_branch> *
+profile_reader::branch_counts () const
+{
+  const branch_stack_reader_base *bs = as_branch_stack_reader ();
+  if (bs == nullptr || !bs->has_finalized_profile ())
+    return nullptr;
+  const std::vector<profile_branch> &branches = bs->sorted_branches ();
+  return branches.empty () ? nullptr : &branches;
+}
+
+bool
+profile_reader::has_sample_mass () const
+{
+  if (range_counts () != nullptr || branch_counts () != nullptr)
+    return true;
+  return !get_address_frequencies ().empty ();
+}
+
+bool
+profile_reader::load_and_prepare (bool use_branch_stack)
+{
+  if (branch_stack_reader_base *bs = as_branch_stack_reader ())
+    {
+      /* Branch-stack correlate uses ranges/edges, not sample-IP mass.  */
+      if (use_branch_stack)
+	bs->set_accumulate_sample_ips (false);
+    }
+
+  if (!load ())
+    {
+      fprintf (stderr, "Error: Failed to load profile data\n");
+      return false;
+    }
+
+  if (use_branch_stack && range_counts () == nullptr)
+    fprintf (stderr,
+	     "Warning: branch-stack mode is enabled but the range "
+	     "profile is empty\n");
+
+  if (!use_branch_stack)
+    {
+      if (branch_stack_reader_base *bs = as_branch_stack_reader ())
+	bs->materialize_address_frequencies_for_per_pc_correlate ();
+    }
+
+  if (!has_sample_mass ())
+    {
+      fprintf (stderr,
+	       "Error: profile has no sample mass (ranges, branches, "
+	       "or per-PC counts)\n");
+      return false;
+    }
+  return true;
+}
+
+std::vector<std::pair<uint64_t, uint64_t>>
+profile_reader::sample_ranges_for_dwarf () const
+{
+  std::vector<std::pair<uint64_t, uint64_t>> ranges;
+  if (const auto *profile_ranges = range_counts ())
+    {
+      ranges.reserve (profile_ranges->size ());
+      for (const profile_range &row : *profile_ranges)
+	if (row.end >= row.beg)
+	  ranges.emplace_back (row.beg, row.end + 1);
+    }
+  if (const auto *profile_branches = branch_counts ())
+    {
+      ranges.reserve (ranges.size () + profile_branches->size ());
+      for (const profile_branch &row : *profile_branches)
+	ranges.emplace_back (row.from, row.from + 1);
+    }
+  if (ranges.empty ())
+    {
+      const std::vector<uint64_t> &touch_pcs = sorted_touch_pcs ();
+      ranges.reserve (touch_pcs.size ());
+      for (uint64_t pc : touch_pcs)
+	ranges.emplace_back (pc, pc + 1);
+    }
+  return ranges;
+}
+
+} /* namespace perf_data.  */
