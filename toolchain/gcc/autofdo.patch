+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_PERF_EVENT_SAMPLE_UTIL_H
+#define GCC_PERF_EVENT_SAMPLE_UTIL_H
+
+#include "perf.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace perf_data {
+namespace perf_event_sample_util {
+
+/* Sample payload walkers in sample_type field order.  False on invalid or
+   truncated input.  */
+
+constexpr unsigned BRANCH_STACK_U64_PER_ENTRY = 3;
+constexpr size_t BRANCH_ENTRY_BYTES
+  = static_cast<size_t> (BRANCH_STACK_U64_PER_ENTRY) * sizeof (uint64_t);
+static_assert (sizeof (perf_branch_stack_entry) == BRANCH_ENTRY_BYTES,
+	       "unexpected perf branch entry size");
+
+/* Non-owning branch-stack payload.  DATA must outlive the view.  Entries are
+   copied out because DATA may be unaligned and contains no C++ objects.  */
+class branch_stack_view
+{
+public:
+  branch_stack_view () = default;
+  branch_stack_view (const uint8_t *data, size_t size)
+    : data_ (data), size_ (size)
+  {}
+
+  bool empty () const { return size_ == 0; }
+  size_t size () const { return size_; }
+
+  perf_branch_stack_entry operator[] (size_t index) const
+  {
+    perf_branch_stack_entry entry;
+    std::memcpy (&entry, data_ + index * BRANCH_ENTRY_BYTES,
+		 sizeof (entry));
+    return entry;
+  }
+
+private:
+  const uint8_t *data_ = nullptr;
+  size_t size_ = 0;
+};
+
+/* Consume fields before PERF_SAMPLE_BRANCH_STACK and return selected
+   values.  */
+bool walk_sample_before_branch (const uint8_t *&ptr, const uint8_t *end,
+				uint64_t sample_ty, uint64_t read_format,
+				uint64_t *out_ip, bool *out_have_ip,
+				uint32_t *out_pid, uint32_t *out_tid,
+				uint64_t *out_period, uint64_t *out_time);
+
+/* Consume the branch stack and remaining sample fields.  */
+bool walk_sample_branch_and_suffix (const uint8_t *&ptr, const uint8_t *end,
+				    uint64_t branch_sample_type,
+				    uint64_t sample_ty,
+				    uint64_t sample_regs_user,
+				    uint64_t sample_regs_intr,
+				    branch_stack_view &branch_stack);
+
+} /* namespace perf_event_sample_util.  */
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_EVENT_SAMPLE_UTIL_H */
