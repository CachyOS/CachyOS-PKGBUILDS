+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_AUTOFDO_OPTIONS_H
+#define GCC_AUTOFDO_OPTIONS_H
+
+#include <cstdint>
+#include <string>
+
+namespace autofdo {
+
+constexpr unsigned DEFAULT_CORRELATE_THREADS = 8;
+/* Ring buffer per CPU.  Records are drained as they arrive, so it only has
+   to hold what one poll collects.  */
+constexpr unsigned DEFAULT_LIVE_RING_BUFFER_KB = 128;
+/* Fewest samples a function group needs to enter the profile.  */
+constexpr uint64_t DEFAULT_MIN_SAMPLES = 10;
+/* Default cycles between samples during live capture.  */
+constexpr uint64_t DEFAULT_SAMPLE_PERIOD = 100003;
+
+/* CLI configuration for profile generation and correlation.  */
+struct profiler_run_options
+{
+  bool use_branch_stack = true;
+  unsigned correlate_threads = DEFAULT_CORRELATE_THREADS;
+  double sample_threshold_frac = 0.0;
+  uint64_t min_samples = DEFAULT_MIN_SAMPLES;
+  uint64_t live_sample_period = DEFAULT_SAMPLE_PERIOD;
+  unsigned live_ring_buffer_kb = DEFAULT_LIVE_RING_BUFFER_KB;
+  /* Follow the workload's threads, which costs one buffer per CPU.  */
+  bool live_inherit = true;
+  std::string dump_address_mapping;
+  std::string dump_perf_maps;
+};
+
+} /* namespace autofdo.  */
+
+#endif /* GCC_AUTOFDO_OPTIONS_H.  */
