+static long
+sys_perf_event_open (perf_event_attr *attr, pid_t pid, int cpu, int group_fd,
+		     unsigned long flags)
+{
+  return syscall (PERF_EVENT_OPEN_NR, attr, pid, cpu, group_fd, flags);
+}
+
+/* Wait for PID, retrying when a signal interrupts the wait, and store its wait
+   status in *STATUS when STATUS is non-null.  Returns false when PID could not
+   be reaped, in which case *STATUS is left alone.  A wait status of zero is
+   indistinguishable from a clean exit and must not be reported as one.  */
+static bool
+reap_child (pid_t pid, int *status = nullptr)
+{
+  int wait_status = 0;
+  while (waitpid (pid, &wait_status, 0) < 0)
+    if (errno != EINTR)
+      return false;
+  if (status != nullptr)
+    *status = wait_status;
+  return true;
+}
