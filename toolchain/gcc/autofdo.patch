+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "profile_timer.h"
+#include <chrono>
+#include <cstdio>
+
+namespace profile_timer {
+
+static std::chrono::steady_clock::time_point s_start;
+static std::chrono::steady_clock::time_point s_mark;
+static bool s_started = false;
+
+void
+start ()
+{
+  auto now = std::chrono::steady_clock::now ();
+  s_start = s_mark = now;
+  s_started = true;
+}
+
+void
+mark ()
+{
+  if (s_started)
+    s_mark = std::chrono::steady_clock::now ();
+}
+
+static std::string
+elapsed_str ()
+{
+  if (!s_started)
+    return "";
+  auto now = std::chrono::steady_clock::now ();
+  const double sec = std::chrono::duration<double> (now - s_start).count ();
+  char buf[64];
+  snprintf (buf, sizeof buf, " [%.1fs]", sec);
+  return std::string (buf);
+}
+
+static std::string
+elapsed_since_mark_str ()
+{
+  if (!s_started)
+    return "";
+  auto now = std::chrono::steady_clock::now ();
+  const double sec = std::chrono::duration<double> (now - s_mark).count ();
+  s_mark = now;
+  char buf[64];
+  snprintf (buf, sizeof buf, "%.1fs", sec);
+  return std::string (buf);
+}
+
+void
+log_stage (const char *label, const std::string &detail)
+{
+  fprintf (stderr,
+	   "Stage: %s%s (+%s)",
+	   label,
+	   elapsed_str ().c_str (),
+	   elapsed_since_mark_str ().c_str ());
+  if (!detail.empty ())
+    fprintf (stderr, "  %s", detail.c_str ());
+  fprintf (stderr, "\n");
+  mark ();
+}
+
+} /* namespace profile_timer.  */
