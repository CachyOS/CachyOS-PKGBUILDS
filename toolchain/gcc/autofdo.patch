+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "gcov_io.h"
+
+#include <cstdio>
+#include <cstring>
+
+namespace gcov {
+
+void
+gcov_write_uint32 (FILE *file, uint32_t value)
+{
+  fwrite (&value, 1, sizeof (value), file);
+}
+
+void
+gcov_write_uint64 (FILE *file, uint64_t value)
+{
+  gcov_write_uint32 (file, static_cast<uint32_t> (value));
+  gcov_write_uint32 (file, static_cast<uint32_t> (value >> 32));
+}
+
+void
+gcov_write_string (FILE *file, const std::string &str)
+{
+  const size_t alloc = str.size () + 1; /* Include NUL.  */
+  gcov_write_uint32 (file, static_cast<uint32_t> (alloc));
+  fwrite (str.c_str (), 1, alloc, file);
+}
+
+bool
+gcov_read_uint32 (const uint8_t *&cur, const uint8_t *end, uint32_t &value)
+{
+  if (cur + sizeof (value) > end)
+    return false;
+
+  std::memcpy (&value, cur, sizeof (value));
+  cur += sizeof (value);
+  return true;
+}
+
+bool
+gcov_read_uint64 (const uint8_t *&cur, const uint8_t *end, uint64_t &value)
+{
+  uint32_t lo = 0, hi = 0;
+  if (!gcov_read_uint32 (cur, end, lo) || !gcov_read_uint32 (cur, end, hi))
+    return false;
+  value = (static_cast<uint64_t> (hi) << 32) | lo;
+  return true;
+}
+
+bool
+gcov_read_string (const uint8_t *&cur, const uint8_t *end, std::string &out)
+{
+  uint32_t byte_len = 0;
+  if (!gcov_read_uint32 (cur, end, byte_len) || byte_len == 0
+      || byte_len > (uint32_t) (end - cur))
+    return false;
+
+  out.assign (reinterpret_cast<const char *> (cur), byte_len - 1);
+  cur += byte_len;
+  return true;
+}
+
+} /* namespace gcov.  */
