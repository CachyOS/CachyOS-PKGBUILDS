+<http://www.gnu.org/licenses/>.  */
+
+/* AutoFDO GCOV version 4 writer.
+
+   A version 4 profile is a little-endian header and section directory
+   followed by self-describing sections.  It has one binary encoding, with no
+   compact variant.  Below, "N bytes" is a fixed-width little-endian field on
+   every host.  "varint" is a base-128 varint, low seven bits first, high bit
+   set on every byte but the last.  "string" is a varint length including the
+   trailing NUL, then that many bytes.  A "symbol id" is the id a symbol is
+   given in SYMBOL_NAMES.  0xffffffff (INVALID_INDEX) stands for an absent
+   index or id throughout.
+
+   Header format.
+
+   GCOV_MAGIC: 4 bytes ("gcov")
+   GCOV_VERSION: 4 bytes (4)
+   RESERVED: 1 byte (0)
+   NUM_SECTIONS: 7 bytes
+   SECTION_1:
+     OFFSET: 8 bytes (from the start of the file)
+     SIZE: 7 bytes
+     TYPE: 1 byte (one of the SECTION_* values, with bit 7 reserved as 0)
+   SECTION_2
+   ...
+   SECTION_N
+
+   SIZE includes the TYPE byte at the start of the section body.  This byte
+   must match the directory TYPE.  The defined section types are:
+
+     1 STRING_TABLE
+     2 SUMMARY_INFO
+     3 FILE_NAMES
+     4 SYMBOL_NAMES
+     5 SYMBOL_INFO
+     6 INLINE_INDEX_TABLE
+     7 INLINE_INDICES
+
+   Types 8 through 127 are available for extensions.  Bit 7 is reserved and
+   must be zero.  Readers may skip an unknown extension using OFFSET and SIZE,
+   so such an extension must not be needed to decode the base profile.
+   SUMMARY_INFO, FILE_NAMES and INLINE_INDEX_TABLE occur exactly once.
+
+   Sections are referred to by their index in this directory.  Every section
+   body starts with 1 byte repeating its TYPE, then the format given before
+   the function that builds it.  As written, section 0 is SUMMARY_INFO, 1 is
+   FILE_NAMES, then STRING_TABLE and SYMBOL_NAMES for each file group, one
+   SYMBOL_INFO per top-level function, the INLINE_INDICES sections and finally
+   INLINE_INDEX_TABLE.  Readers should go through the directory and FILE_NAMES
+   rather than rely on this order.
+
+   Symbols are grouped by defining source file.  Group 0 holds the symbols
+   without a known file.  Group g > 0 holds the symbols of entry g - 1 of the
+   profile's file table (entry 0 of that table is the reserved empty name, so
+   group 1 owns no symbols).  Each group owns a contiguous range of symbol
+   ids, so an id identifies its group, and has its own string table, so a
+   reader can decode one translation unit's names without touching the rest
+   of the file.
+
+   The text form of a version 4 profile is described at write_text.  */
+
+#include "gcov_writer.h"
+#include "afdo_assert.h"
+#include "gcov.h"
+#include "gcov_io.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace gcov {
+
+using v4::write_int16;
+using v4::write_int32;
+using v4::write_str;
+using v4::write_int8;
+using v4::write_varint;
+using v4::section_directory_entry;
+
+namespace {
+
+/* Append SEC to FILE at the current offset, recording its directory entry in
+   DIR.  Returns false (recording nothing) when the file position cannot be
+   read, so the caller can abort.  */
+bool
+emit_section (FILE *file, const std::vector<uint8_t> &sec,
+	      std::vector<section_directory_entry> &dir)
+{
+  const long pos = ftell (file);
+  if (pos < 0)
+    return false;
+  dir.push_back ({static_cast<uint64_t> (pos), sec.size (), sec[0]});
+  fwrite (sec.data (), 1, sec.size (), file);
+  return true;
+}
+
+/* "line[.disc]" for LOC's offset and (16-bit) discriminator.  */
+std::string
+fmt_loc (const gcov_location *loc)
+{
+  const uint32_t disc = loc->discriminator & 0xffffu;
+  std::string s = std::to_string (loc->offset);
+  if (disc)
+    s += "." + std::to_string (disc);
+  return s;
+}
+
+/* Write S as one quoted v4 text string.  */
+void
+write_text_quoted (FILE *out, const std::string &s)
+{
+  fputc ('"', out);
+  for (unsigned char ch : s)
+    switch (ch)
+      {
+      case '\\':
+	fputs ("\\\\", out);
+	break;
+      case '"':
+	fputs ("\\\"", out);
+	break;
+      case '\n':
+	fputs ("\\n", out);
+	break;
+      case '\r':
+	fputs ("\\r", out);
+	break;
+      case '\t':
+	fputs ("\\t", out);
+	break;
+      default:
+	if (ch < 0x20 || ch == 0x7f)
+	  fprintf (out, "\\x%02x", static_cast<unsigned> (ch));
+	else
+	  fputc (ch, out);
+	break;
+      }
+  fputc ('"', out);
+}
+
+/* Sum of F's position-location counts (not inline subtrees).  */
+uint64_t
+text_position_count (const gcov_function &f)
+{
+  uint64_t t = 0;
+  for (const auto &loc : f.locations)
+    if (loc->type != gcov_location::kind::inlined)
+      t += loc->total_count ();
+  return t;
+}
+
+} /* Anonymous namespace.  */
+
+uint32_t
+gcov_writer_v4::trie::intern (const std::string &s)
+{
+  uint32_t idx = 0;
+  for (unsigned char ch : s)
+    {
+      auto it = nodes[idx].children.find (ch);
+      if (it == nodes[idx].children.end ())
+	{
+	  const uint32_t new_idx = static_cast<uint32_t> (nodes.size ());
+	  nodes[idx].children[ch] = new_idx;
+	  nodes.emplace_back ();
+	  idx = new_idx;
+	}
+      else
+	idx = it->second;
+    }
+  trie_node &node = nodes[idx];
+  if (!node.is_terminal)
+    {
+      node.is_terminal = true;
+      node.terminal_id = next_id++;
+    }
+  return node.terminal_id;
+}
+
+/* Group the name pool by source file.  Put the "unknown" group first, then
+   one group for each file table entry, for deterministic translation unit
+   section ordering.  */
+void
+gcov_writer_v4::build_file_groups ()
+{
+  file_groups.clear ();
+
+  file_group unknown;
+  unknown.filename = "";
+
+  std::vector<file_group> by_file (profile->get_file_names ().size ());
+  for (size_t i = 0; i < profile->get_file_names ().size (); ++i)
+    by_file[i].filename = profile->get_file_names ()[i];
+
+  for (uint32_t i = 0; i < profile->get_function_names ().size (); ++i)
+    {
+      const uint32_t file_idx
+	= (i < profile->get_file_name_map ().size ())
+	    ? profile->get_file_name_map ()[i]
+	    : INVALID_INDEX;
+      if (file_idx == INVALID_INDEX
+	  || file_idx >= profile->get_file_names ().size ())
+	unknown.symbol_indices.push_back (i);
+      else
+	by_file[file_idx].symbol_indices.push_back (i);
+    }
+
+  file_groups.push_back (std::move (unknown));
+  for (auto &g : by_file)
+    file_groups.push_back (std::move (g));
+}
+
+/* Trie node format, depth first from the root.
+
+   HEADER: 1 byte (TRIE_TERMINAL_FLAG | number of children, at most 127)
+   STRING_INDEX: 4 bytes (only when TRIE_TERMINAL_FLAG is set)
+   CHILD_1:
+     LABEL_LENGTH: 2 bytes
+     LABEL: LABEL_LENGTH bytes (a run of single-child non-terminal nodes is
+			       folded into one label)
+     TRIE_NODE (nested)
+   CHILD_2
+   ...
+   CHILD_N
+
+   Children are in increasing order of the first label byte.  String i is the
+   concatenation of the labels from the root to the node carrying
+   STRING_INDEX i.  */
+void
+gcov_writer_v4::serialize_trie_node (std::vector<uint8_t> &buf,
+				     const trie &trie, uint32_t node_idx) const
+{
+  const trie_node &node = trie.nodes[node_idx];
+  /* The child count shares its header byte with the terminal flag, so it must
+     fit in seven bits.  */
+  afdo_assert (node.children.size () <= TRIE_MAX_CHILDREN);
+  write_int8 (buf,
+	     static_cast<uint8_t> ((node.is_terminal ? TRIE_TERMINAL_FLAG : 0)
+				   | node.children.size ()));
+  if (node.is_terminal)
+    write_int32 (buf, node.terminal_id);
+
+  for (const auto &child : node.children)
+    {
+      const unsigned char ch = child.first;
+      uint32_t cur = child.second;
+      /* Path-compress single-child non-terminal chains into one edge label.
+	 The common case is a single-character edge.  Emit it directly and only
+	 build the LABEL string when the compressed edge is longer.  */
+      if (trie.nodes[cur].children.size () != 1 || trie.nodes[cur].is_terminal)
+	{
+	  write_int16 (buf, 1);
+	  buf.push_back (static_cast<uint8_t> (ch));
+	}
+      else
+	{
+	  std::string label (1, static_cast<char> (ch));
+	  do
+	    {
+	      const auto &next = *trie.nodes[cur].children.begin ();
+	      label += static_cast<char> (next.first);
+	      cur = next.second;
+	    }
+	  while (trie.nodes[cur].children.size () == 1
+		 && !trie.nodes[cur].is_terminal);
+	  size_t pos = 0;
+	  while (label.size () - pos > UINT16_MAX)
+	    {
+	      write_int16 (buf, UINT16_MAX);
+	      buf.insert (buf.end (), label.begin () + pos,
+			  label.begin () + pos + UINT16_MAX);
+	      write_int8 (buf, 1);
+	      pos += UINT16_MAX;
+	    }
+	  write_int16 (buf,
+		       static_cast<uint16_t> (label.size () - pos));
+	  buf.insert (buf.end (), label.begin () + pos, label.end ());
+	}
+      serialize_trie_node (buf, trie, cur);
+    }
+}
+
+/* SUMMARY_INFO section format (type 0x02).
+
+   TYPE: 1 byte
+   TOTAL_COUNT: varint
+   MAX_COUNT: varint
+   MAX_FUNCTION_COUNT: varint
+   NUM_COUNTS: varint
+   NUM_FUNCTIONS: varint
+   NUM_DETAILED_ENTRIES: varint
+   DETAILED_ENTRY_1:
+     CUTOFF: varint
+     MIN_COUNT: varint
+     NUM_COUNTS: varint
+   DETAILED_ENTRY_2
+   ...
+   DETAILED_ENTRY_N.  */
+std::vector<uint8_t>
+gcov_writer_v4::build_summary_section () const
+{
+  std::vector<uint8_t> buf;
+  const gcov_summary &s = profile->get_summary ();
+  write_int8 (buf, v4::SECTION_SUMMARY_INFO);
+  write_varint (buf, s.total_count);
+  write_varint (buf, s.max_count);
+  write_varint (buf, s.max_function_count);
+  write_varint (buf, s.num_counts);
+  write_varint (buf, s.num_functions);
+  write_varint (buf, s.num_detailed_entries);
+  for (const auto &e : s.detailed_entries)
+    {
+      write_varint (buf, e.cutoff);
+      write_varint (buf, e.min_count);
+      write_varint (buf, e.num_counts);
+    }
+  return buf;
+}
+
+/* FILE_NAMES section format (type 0x03).
+
+   TYPE: 1 byte
+   NUM_GROUPS: varint
+   GROUP_1:
+     FILE_NAME: string ("" for group 0)
+     STRING_TABLE_SECTION: varint (directory index)
+     SYMBOL_NAMES_SECTION: varint (directory index)
+     SYMBOL_ID_BEGIN: varint
+     SYMBOL_ID_END: varint (the group owns [SYMBOL_ID_BEGIN, SYMBOL_ID_END))
+   GROUP_2
+   ...
+   GROUP_N.  */
+std::vector<uint8_t>
+gcov_writer_v4::build_file_names_section () const
+{
+  std::vector<uint8_t> buf;
+  write_int8 (buf, v4::SECTION_FILE_NAMES);
+  write_varint (buf, static_cast<uint32_t> (file_groups.size ()));
+  for (const auto &fg : file_groups)
+    {
+      write_str (buf, fg.filename);
+      write_varint (buf, fg.string_table_section);
+      write_varint (buf, fg.symbol_names_section);
+      write_varint (buf, fg.symbol_id_begin);
+      write_varint (buf, fg.symbol_id_end);
+    }
+  return buf;
+}
+
+/* SYMBOL_NAMES section format (type 0x04), one per group.
+
+   TYPE: 1 byte
+   NUM_SYMBOLS: varint
+   SYMBOL_1:
+     STRING_INDEX: varint (into the group's STRING_TABLE)
+     SYMBOL_ID: varint
+     INFO_SECTION: varint (directory index of the symbol's SYMBOL_INFO, or
+			   INVALID_INDEX for a symbol that only appears as a
+			   call target or an inlined instance)
+   SYMBOL_2
+   ...
+   SYMBOL_N
+
+   Interns each name into the group's trie, so this must run before
+   build_string_table_section for the same group.  */
+std::vector<uint8_t>
+gcov_writer_v4::build_symbol_names_section (size_t group_idx)
+{
+  std::vector<uint8_t> buf;
+  file_group &fg = file_groups[group_idx];
+  write_int8 (buf, v4::SECTION_SYMBOL_NAMES);
+  write_varint (buf, static_cast<uint32_t> (fg.symbol_indices.size ()));
+  for (uint32_t name_idx : fg.symbol_indices)
+    {
+      const std::string &name = profile->get_function_names ()[name_idx];
+      write_varint (buf, fg.string_trie.intern (name));
+      write_varint (buf, old_to_new_id[name_idx]);
+      auto it = symbol_to_section.find (name_idx);
+      write_varint (
+	buf, it != symbol_to_section.end () ? it->second : INVALID_INDEX);
+    }
+  return buf;
+}
+
+/* STRING_TABLE section format (type 0x01), one per group.
+
+   TYPE: 1 byte
+   NUM_STRINGS: varint
+   TRIE_NODE (the root described by serialize_trie_node)
+
+   String indices are local to the group.  */
+std::vector<uint8_t>
+gcov_writer_v4::build_string_table_section (size_t group_idx) const
+{
+  std::vector<uint8_t> buf;
+  const file_group &fg = file_groups[group_idx];
+  write_int8 (buf, v4::SECTION_STRING_TABLE);
+  write_varint (buf, fg.string_trie.next_id);
+  serialize_trie_node (buf, fg.string_trie, 0);
+  return buf;
+}
+
+/* SYMBOL_INFO section format (type 0x05), one per top-level function.
+
+   TYPE: 1 byte
+   FUNCTION_INSTANCE_PROFILE (see write_symbol_info_body)  */
+std::vector<uint8_t>
+gcov_writer_v4::build_symbol_info_section (const gcov_function &func) const
+{
+  std::vector<uint8_t> buf;
+  write_int8 (buf, v4::SECTION_SYMBOL_INFO);
+  write_symbol_info_body (buf, func);
+  return buf;
+}
+
+void
+gcov_writer_v4::collect_cross_group_inliners
+  (const gcov_function &f, uint32_t top_new_id, uint32_t top_group,
+   const std::unordered_map<uint32_t, uint32_t> &group_of,
+   std::vector<std::set<uint32_t>> &inliners) const
+{
+  for (const auto &loc : f.locations)
+    if (loc->type == gcov_location::kind::inlined)
+      {
+	const auto *inl
+	  = static_cast<const gcov_location_inline *> (loc.get ());
+	auto git = group_of.find (inl->inlined_sym.id);
+	uint32_t g = git != group_of.end () ? git->second : 0;
+	if (g != top_group)
+	  inliners[g].insert (top_new_id);
+	collect_cross_group_inliners (inl->inlined_sym, top_new_id, top_group,
+				      group_of, inliners);
+      }
+}
+
+/* Reverse inline index.  Per file group, the new symbol ids of top-level
+   functions in OTHER groups whose inline tree contains a symbol of this group.
+   Lets a partial read pull exactly the cross-module inliners of a TU.  */
+std::vector<std::pair<uint32_t, std::vector<uint32_t>>>
+gcov_writer_v4::compute_inline_groups () const
+{
+  std::unordered_map<uint32_t, uint32_t> group_of;
+  for (uint32_t g = 0; g < file_groups.size (); ++g)
+    for (uint32_t old_idx : file_groups[g].symbol_indices)
+      group_of[old_idx] = g;
+
+  std::vector<std::set<uint32_t>> inliners (file_groups.size ());
+  for (const auto &func : profile->get_functions ())
+    {
+      auto nit = old_to_new_id.find (func.id);
+      auto git = group_of.find (func.id);
+      const uint32_t new_id
+	= nit != old_to_new_id.end () ? nit->second : INVALID_INDEX;
+      const uint32_t group = git != group_of.end () ? git->second : 0;
+      collect_cross_group_inliners (func, new_id, group, group_of, inliners);
+    }
+
+  /* One entry per file that has cross-group inliners (sparse).  std::set keeps
+     the ids sorted.  */
+  std::vector<std::pair<uint32_t, std::vector<uint32_t>>> groups;
+  for (uint32_t g = 0; g < inliners.size (); ++g)
+    if (!inliners[g].empty ())
+      groups.emplace_back (g, std::vector<uint32_t> (inliners[g].begin (),
+						     inliners[g].end ()));
+  return groups;
+}
+
+/* INLINE_INDICES section format (type 0x07), one per group that has
+   cross-group inliners.
+
+   TYPE: 1 byte
+   NUM_IDS: varint
+   SYMBOL_ID_1: varint
+   SYMBOL_ID_2
+   ...
+   SYMBOL_ID_N
+
+   Sorted.  These are the top-level functions of other groups whose inline
+   tree contains a symbol of this group, so that a reader loading one group
+   can also load the functions that inline from it.  */
+std::vector<uint8_t>
+gcov_writer_v4::build_inline_index_section
+  (const std::vector<uint32_t> &ids) const
+{
+  std::vector<uint8_t> buf;
+  write_int8 (buf, v4::SECTION_INLINE_INDICES);
+  write_varint (buf, static_cast<uint32_t> (ids.size ()));
+  for (uint32_t id : ids)
+    write_varint (buf, id);
+  return buf;
+}
+
+/* INLINE_INDEX_TABLE section format (type 0x06), one per profile.
+
+   TYPE: 1 byte
+   NUM_ENTRIES: varint
+   ENTRY_1:
+     GROUP: varint
+     SECTION: varint (directory index of the group's INLINE_INDICES)
+   ENTRY_2
+   ...
+   ENTRY_N.  */
+std::vector<uint8_t>
+gcov_writer_v4::build_inline_index_table_section
+  (const std::vector<std::pair<uint32_t, uint32_t>> &entries) const
+{
+  std::vector<uint8_t> buf;
+  write_int8 (buf, v4::SECTION_INLINE_INDEX_TABLE);
+  write_varint (buf, static_cast<uint32_t> (entries.size ()));
+  for (const auto &entry : entries)
+    {
+      write_varint (buf, entry.first);
+      write_varint (buf, entry.second);
+    }
+  return buf;
+}
+
+/* Location prefix format, shared by every location kind.
+
+   KIND: 1 byte (LOCATION_* | LOCATION_DISC_FLAG when a discriminator follows)
+   LINE_OFFSET: varint (from the function's declaration line)
+   DISCRIMINATOR: varint (only when LOCATION_DISC_FLAG is set)  */
+void
+gcov_writer_v4::write_location_prefix (std::vector<uint8_t> &buf, uint8_t type,
+				       uint32_t line, uint32_t disc) const
+{
+  const uint8_t prefix
+    = static_cast<uint8_t> (type | (disc ? v4::LOCATION_DISC_FLAG : 0));
+  write_int8 (buf, prefix);
+  write_varint (buf, line);
+  if (disc)
+    write_varint (buf, disc);
+}
+
+/* Position format for a location that is not an inlined callsite.
+
+   LOCATION_PREFIX
+   The remaining fields depend on KIND.
+     LOCATION_ZERO (0x01): nothing, the count is 0
+     LOCATION_NORMAL (0x02):
+       COUNT: varint (fits in 32 bits)
+     LOCATION_WIDE (0x03):
+       COUNT: varint (does not fit in 32 bits)
+     LOCATION_CALLED_FN (0x04):
+       COUNT: varint
+       TARGET_IDX: varint (symbol id)
+       TARGET_COUNT: varint
+     LOCATION_CALLED_FNS (0x05):
+       COUNT: varint
+       NUM_TARGETS: varint
+       TARGET_1:
+	 TARGET_IDX: varint (symbol id)
+	 TARGET_COUNT: varint
+       TARGET_2
+       ...
+       TARGET_N
+   For any other KIND.
+       SIZE: varint
+       SIZE bytes to skip (forward compatibility)
+
+   Targets are sorted by TARGET_IDX.  */
+void
+gcov_writer_v4::write_position_location (std::vector<uint8_t> &buf,
+					 const gcov_location *loc) const
+{
+  const uint32_t line = loc->offset;
+  const uint32_t disc = loc->discriminator & 0xffffu;
+
+  std::vector<std::pair<uint64_t, uint64_t>> targets;
+  if (loc->type == gcov_location::kind::call)
+    {
+      const auto *call = static_cast<const gcov_location_call *> (loc);
+      targets.assign (call->callee_map.begin (), call->callee_map.end ());
+      std::sort (targets.begin (),
+		 targets.end (),
+		 [] (const std::pair<uint64_t, uint64_t> &a,
+		     const std::pair<uint64_t, uint64_t> &b)
+		 {
+		   return a.first < b.first;
+		 });
+    }
+
+  if (targets.empty ())
+    {
+      const uint64_t count = loc->total_count ();
+      if (count == 0)
+	write_location_prefix (buf, v4::LOCATION_ZERO, line, disc);
+      else if (count <= UINT32_MAX)
+	{
+	  write_location_prefix (buf, v4::LOCATION_NORMAL, line, disc);
+	  write_varint (buf, static_cast<uint32_t> (count));
+	}
+      else
+	{
+	  write_location_prefix (buf, v4::LOCATION_WIDE, line, disc);
+	  write_varint (buf, count);
+	}
+      return;
+    }
+
+  auto new_id = [this] (uint64_t old_id) -> uint32_t {
+    afdo_assert (old_id <= UINT32_MAX);
+    auto it = old_to_new_id.find (static_cast<uint32_t> (old_id));
+    afdo_assert (it != old_to_new_id.end ());
+    return it->second;
+  };
+
+  if (targets.size () == 1)
+    {
+      write_location_prefix (buf, v4::LOCATION_CALLED_FN, line, disc);
+      write_varint (buf, loc->total_count ());
+      write_varint (buf, new_id (targets[0].first));
+      write_varint (buf, targets[0].second);
+    }
+  else
+    {
+      write_location_prefix (buf, v4::LOCATION_CALLED_FNS, line, disc);
+      write_varint (buf, loc->total_count ());
+      write_varint (buf, static_cast<uint32_t> (targets.size ()));
+      for (const auto &t : targets)
+	{
+	  write_varint (buf, new_id (t.first));
+	  write_varint (buf, t.second);
+	}
+    }
+}
+
+/* Body shared by top-level and inlined functions.  num_locs, then each position
+   (non-inline) location, then each inlined callsite.  */
+static void
+split_locations (const gcov_function &func,
+		 std::vector<const gcov_location *> *positions,
+		 std::vector<const gcov_location_inline *> *inlines)
+{
+  positions->reserve (positions->size () + func.locations.size ());
+  inlines->reserve (inlines->size () + func.locations.size ());
+  for (const auto &loc : func.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	inlines->push_back
+	  (static_cast<const gcov_location_inline *> (loc.get ()));
+      else
+	positions->push_back (loc.get ());
+    }
+}
+
+/* Function body format, shared by top-level functions and inlined instances.
+
+   NUM_LOCATIONS: varint (positions and callsites together)
+   POSITION_1
+   POSITION_2
+   ...
+   POSITION_N
+   CALLSITE_1:
+     LOCATION_PREFIX (KIND is LOCATION_INLINED_FN, 0x06)
+     CALLEE: varint (symbol id of the inlined function)
+     FUNCTION_BODY (nested)
+   CALLSITE_2
+   ...
+   CALLSITE_N.  */
+void
+gcov_writer_v4::write_inlined_body (std::vector<uint8_t> &buf,
+				    const gcov_function &func) const
+{
+  std::vector<const gcov_location *> positions;
+  std::vector<const gcov_location_inline *> inlines;
+  split_locations (func, &positions, &inlines);
+
+  write_varint (
+    buf, static_cast<uint32_t> (positions.size () + inlines.size ()));
+  for (const gcov_location *loc : positions)
+    write_position_location (buf, loc);
+  for (const gcov_location_inline *cs : inlines)
+    {
+      write_location_prefix (buf, v4::LOCATION_INLINED_FN, cs->offset,
+			     cs->discriminator & 0xffffu);
+      auto it = old_to_new_id.find (cs->inlined_sym.id);
+      write_varint (
+	buf, it != old_to_new_id.end () ? it->second : INVALID_INDEX);
+      write_inlined_body (buf, cs->inlined_sym);
+    }
+}
+
+/* Function instance profile format.
+
+   ENTRY_COUNT: varint
+   TIMESTAMP: varint (first execution, 0 if unknown)
+   FUNCTION_BODY.  */
+void
+gcov_writer_v4::write_symbol_info_body (std::vector<uint8_t> &buf,
+					const gcov_function &func) const
+{
+  write_varint (buf, func.head_count);
+  write_varint (buf, func.timestamp);
+  write_inlined_body (buf, func);
+}
+
+bool
+gcov_writer_v4::write_binary ()
+{
+  build_file_groups ();
+
+  /* Assign global section indices (0=SUMMARY, 1=FILE_NAMES, then per-group
+     STRING_TABLE/SYMBOL_NAMES, then one SYMBOL_INFO per top-level function),
+     contiguous symbol ids per group, and the old->new id map.  */
+  uint32_t next_section = 2;
+  uint32_t next_id = 0;
+  for (auto &fg : file_groups)
+    {
+      fg.string_table_section = next_section++;
+      fg.symbol_names_section = next_section++;
+      fg.symbol_id_begin = next_id;
+      for (uint32_t old_idx : fg.symbol_indices)
+	old_to_new_id[old_idx] = next_id++;
+      fg.symbol_id_end = next_id;
+    }
+  for (const auto &func : profile->get_functions ())
+    symbol_to_section[func.id] = next_section++;
+
+  /* Section count is known from the groups/functions up front.  With the
+     fixed-width table the header size is too.  Stream each section straight to
+     the file (build -> write -> free) and record only a small {offset, size,
+     bitmask} directory, then seek back and write the header.  No section bytes
+     are held beyond the one being written.  */
+
+  /* One SECTION_INLINE_INDICES sub-section per file with cross-group inliners,
+     plus the SECTION_INLINE_INDEX_TABLE directory.  */
+  const std::vector<std::pair<uint32_t, std::vector<uint32_t>>> inline_groups
+    = compute_inline_groups ();
+  const uint64_t total_sections = 2 + file_groups.size () * 2
+				  + profile->get_functions ().size ()
+				  + inline_groups.size () + 1;
+  const uint64_t header_size = 4 + 4 + 1 + 7 + total_sections * 16;
+
+  std::vector<section_directory_entry> dir;
+  dir.reserve (total_sections);
+
+  if (fseek (file, (long) header_size, SEEK_SET) != 0)
+    return false;
+  bool io_ok = true;
+
+  io_ok &= emit_section (file, build_summary_section (), dir);
+  io_ok &= emit_section (file, build_file_names_section (), dir);
+  for (size_t i = 0; i < file_groups.size (); ++i)
+    {
+      /* Build SYMBOL_NAMES first (interns strings into the trie), then the
+	 STRING_TABLE.  Emit STRING_TABLE before SYMBOL_NAMES (index order).  */
+      std::vector<uint8_t> sym_names = build_symbol_names_section (i);
+      io_ok &= emit_section (file, build_string_table_section (i), dir);
+      io_ok &= emit_section (file, sym_names, dir);
+    }
+  for (const auto &func : profile->get_functions ())
+    io_ok &= emit_section (file, build_symbol_info_section (func), dir);
+  /* Per-file inline-index sub-sections.  Record each one's section index, then
+     emit the directory mapping file id -> that index.  */
+  std::vector<std::pair<uint32_t, uint32_t>> ii_table;
+  ii_table.reserve (inline_groups.size ());
+  for (const auto &group : inline_groups)
+    {
+      ii_table.emplace_back (group.first, static_cast<uint32_t> (dir.size ()));
+      io_ok
+	&= emit_section (file, build_inline_index_section (group.second), dir);
+    }
+  io_ok
+    &= emit_section (file, build_inline_index_table_section (ii_table), dir);
+
+  /* Write the magic, version, reserved byte and section count, then a
+     fixed-width 16-byte entry for each section.  All values are
+     little-endian.  */
+  std::vector<uint8_t> header;
+  header.push_back ('g');
+  header.push_back ('c');
+  header.push_back ('o');
+  header.push_back ('v');
+  write_int32 (header, v4::format::AFDO_GCOV_VERSION);
+  write_int8 (header, 0); /* Reserved, must be 0.  */
+  v4::write_int56 (header, total_sections);
+  for (const section_directory_entry &e : dir)
+    {
+      v4::write_int64 (header, e.offset);
+      v4::write_int56 (header, e.size);
+      write_int8 (header, e.bitmask);
+    }
+
+  if (!io_ok || fseek (file, 0, SEEK_SET) != 0)
+    return false;
+  fwrite (header.data (), 1, header.size (), file);
+
+  return file && !ferror (file);
+}
+
+bool
+gcov_writer_v4::write ()
+{
+  if (!file)
+    {
+      fprintf (stderr, "Error: failed to create output file\n");
+      return false;
+    }
+  if (profile == nullptr)
+    {
+      fprintf (stderr, "Error: no profile data to write\n");
+      return false;
+    }
+  if (!(is_text ? write_text () : write_binary ()))
+    return false;
+  return close ();
+}
+
+int32_t
+gcov_writer_v4::file_id_for (uint32_t id) const
+{
+  if (id < profile->get_file_name_map ().size ())
+    {
+      const uint32_t idx = profile->get_file_name_map ()[id];
+      if (idx < profile->get_file_names ().size ())
+	return static_cast<int32_t> (idx);
+    }
+  return -1;
+}
+
+/* Emit FUNC's locations/callsites/inlined sub-sections (text format), each
+   indented by INDENT levels.  INLINED nodes recurse through
+   write_text_inlined.  */
+void
+gcov_writer_v4::write_text_sections (FILE *out, const gcov_function &func,
+				     int indent) const
+{
+  const std::string pad (static_cast<size_t> (indent) * 2, ' ');
+
+  std::vector<const gcov_location *> locs, calls;
+  std::vector<const gcov_location_inline *> inls;
+  for (const auto &loc : func.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	inls.push_back (static_cast<const gcov_location_inline *> (loc.get ()));
+      else if (loc->type == gcov_location::kind::call
+	       && !static_cast<const gcov_location_call *> (loc.get ())
+		     ->callee_map.empty ())
+	calls.push_back (loc.get ());
+      else
+	locs.push_back (loc.get ());
+    }
+
+  bool need_comma = false;
+  if (!locs.empty ())
+    {
+      fprintf (out, "%slocations = {\n", pad.c_str ());
+      for (size_t i = 0; i < locs.size (); ++i)
+	{
+	  if (i)
+	    fprintf (out, ",\n");
+	  fprintf (out,
+		   "%s  %s = %" PRIu64,
+		   pad.c_str (),
+		   fmt_loc (locs[i]).c_str (),
+		   locs[i]->total_count ());
+	}
+      fprintf (out, "\n%s}", pad.c_str ());
+      need_comma = true;
+    }
+  if (!calls.empty ())
+    {
+      if (need_comma)
+	fprintf (out, ",\n");
+      fprintf (out, "%scallsites = {\n", pad.c_str ());
+      for (size_t i = 0; i < calls.size (); ++i)
+	{
+	  if (i)
+	    fprintf (out, ",\n");
+	  const auto *call = static_cast<const gcov_location_call *> (calls[i]);
+	  fprintf (out, "%s  %s = %" PRIu64 " -> {", pad.c_str (),
+		   fmt_loc (calls[i]).c_str (), call->count);
+	  std::vector<std::pair<uint64_t, uint64_t>> tg
+	    (call->callee_map.begin (), call->callee_map.end ());
+	  std::sort (tg.begin (), tg.end ());
+	  for (size_t t = 0; t < tg.size (); ++t)
+	    {
+	      if (t)
+		fprintf (out, ",");
+	      /* "name":id = count.  The name keeps ICP targets (callee-only
+		 symbols with no header of their own) recoverable from text.  */
+	      const std::string tname
+		= tg[t].first < profile->get_function_names ().size ()
+		    ? profile->get_function_names ()[tg[t].first]
+		    : std::string ();
+	      fputc (' ', out);
+	      write_text_quoted (out, tname);
+	      fprintf (out, ":%" PRIu64 " = %" PRIu64,
+		       tg[t].first, tg[t].second);
+	    }
+	  fprintf (out, " }");
+	}
+      fprintf (out, "\n%s}", pad.c_str ());
+      need_comma = true;
+    }
+  if (!inls.empty ())
+    {
+      if (need_comma)
+	fprintf (out, ",\n");
+      fprintf (out, "%sinlined = {\n", pad.c_str ());
+      for (size_t i = 0; i < inls.size (); ++i)
+	{
+	  if (i)
+	    fprintf (out, ",\n");
+	  write_text_inlined (out, inls[i], indent);
+	}
+      fprintf (out, "\n%s}", pad.c_str ());
+      need_comma = true;
+    }
+  if (need_comma)
+    fprintf (out, "\n");
+}
+
+/* Emit one inlined callsite CS (text format) at INDENT.  INLINED nodes carry
+   only (id:total) plus their own nested sub-sections.  */
+void
+gcov_writer_v4::write_text_inlined (FILE *out, const gcov_location_inline *cs,
+				    int indent) const
+{
+  const gcov_function &nested = cs->inlined_sym;
+  const std::string pad (static_cast<size_t> (indent + 1) * 2, ' ');
+  const uint64_t total = text_position_count (nested);
+  const std::vector<std::string> &names = profile->get_function_names ();
+  const std::string nm
+    = nested.desc.name_index < names.size ()
+	? names[nested.desc.name_index]
+	: std::string ();
+  fprintf (out, "%s%s = ", pad.c_str (), fmt_loc (cs).c_str ());
+  write_text_quoted (out, nm);
+  fprintf (out, ":%d(%u:%" PRIu64 ") = {\n", file_id_for (nested.id),
+	   (unsigned) nested.id, total);
+  write_text_sections (out, nested, indent + 2);
+  fprintf (out, "%s}", pad.c_str ());
+}
+
+/* Human-readable v4 text format.  Unlike the binary format, it keys symbols by
+   their name-pool index (no per-TU grouping / contiguous ids).  Layout, with
+   N for a decimal count, FILE for a file-table index or -1 when unknown and
+   LOC for "line" or "line.discriminator".
+
+     filenames = {
+       "path",
+       ...
+     }
+
+     summary = {
+       total_count = N,
+       max_count = N,
+       max_fn_count = N,
+       num_counts = N,
+       num_functions = N,
+       num_detailed_entries = N,
+       detailed_entries = {
+	 {cutoff = N, min_count = N, num_counts = N},
+	 ...
+       }
+     }
+
+     "name":FILE(id:total:head_count:timestamp) = {
+       locations = {
+	 LOC = count,
+	 ...
+       },
+       callsites = {
+	 LOC = count -> { "name":id = count, ... },
+	 ...
+       },
+       inlined = {
+	 LOC = "name":FILE(id:total) = {
+	   the same three optional sections, recursively
+	 },
+	 ...
+       }
+     }
+
+     symbol_files = { id = FILE, ... }
+
+   symbol_files records the source file of each symbol with a known file,
+   including symbols that appear only as indirect-call targets.
+
+   One such block per top-level function.  total is the sum of the
+   function's own position counts, not of its inlined instances.  The three
+   sections are omitted when empty and separated by commas when present.
+
+   A section name starts with a lowercase ASCII letter, followed by lowercase
+   ASCII letters, digits or underscores.  Readers skip unknown top-level and
+   function sections by matching balanced braces.  Braces in quoted strings
+   do not affect nesting.  */
+bool
+gcov_writer_v4::write_text ()
+{
+  FILE *out = file;
+
+  fprintf (out, "filenames = {\n");
+  for (size_t i = 0; i < profile->get_file_names ().size (); ++i)
+    {
+      fputs ("  ", out);
+      write_text_quoted (out, profile->get_file_names ()[i]);
+      fprintf (out, "%s\n",
+	       i + 1 < profile->get_file_names ().size () ? "," : "");
+    }
+  fprintf (out, "}\n");
+
+  const gcov_summary &s = profile->get_summary ();
+  fprintf (out, "\nsummary = {\n");
+  fprintf (out, "  total_count = %" PRIu64 ",\n", s.total_count);
+  fprintf (out, "  max_count = %" PRIu64 ",\n", s.max_count);
+  fprintf (out, "  max_fn_count = %" PRIu64 ",\n", s.max_function_count);
+  fprintf (out, "  num_counts = %" PRIu64 ",\n", s.num_counts);
+  fprintf (out, "  num_functions = %" PRIu64 ",\n", s.num_functions);
+  fprintf (out, "  num_detailed_entries = %" PRIu64 ",\n",
+	   s.num_detailed_entries);
+  fprintf (out, "  detailed_entries = {\n");
+  for (size_t i = 0; i < s.detailed_entries.size (); ++i)
+    {
+      const auto &e = s.detailed_entries[i];
+      fprintf (out,
+	       "    {cutoff = %u, min_count = %" PRIu64
+	       ", num_counts = %" PRIu64 "}%s\n",
+	       (unsigned) e.cutoff,
+	       e.min_count,
+	       e.num_counts,
+	       (i + 1 < s.detailed_entries.size () ? "," : ""));
+    }
+  fprintf (out, "  }\n");
+  fprintf (out, "}\n");
+
+  for (const auto &func : profile->get_functions ())
+    {
+      fputc ('\n', out);
+      write_text_quoted (
+	out, profile->get_function_names ()[func.desc.name_index]);
+      fprintf (out, ":%d(%u:%" PRIu64 ":%" PRIu64 ":%" PRIu64 ") = {\n",
+	       file_id_for (func.id), (unsigned) func.id,
+	       text_position_count (func), func.head_count, func.timestamp);
+      write_text_sections (out, func, 1);
+      fprintf (out, "}\n");
+    }
+
+  fprintf (out, "\nsymbol_files = {\n");
+  for (size_t id = 0; id < profile->get_function_names ().size (); ++id)
+    {
+      const int32_t file_id = file_id_for (id);
+      if (file_id >= 0)
+	fprintf (out, "  %zu = %d,\n", id, file_id);
+    }
+  fprintf (out, "}\n");
+
+  return out && !ferror (out);
+}
+
+} /* namespace gcov.  */
