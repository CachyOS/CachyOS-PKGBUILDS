diff --git a/afdo-tools/testsuite/afdo-test/process-fork-exec.c b/afdo-tools/testsuite/afdo-test/process-fork-exec.c
new file mode 100644
index 00000000000..8b59d290639
--- /dev/null
+++ b/afdo-tools/testsuite/afdo-test/process-fork-exec.c
@@ -0,0 +1,44 @@
+/* Samples from forked children and from the program after it execs itself
+   go to the target.  */
+/* { dg-options "-O2 -g -Wl,--build-id" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources lbr brbe spe } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot work } */
+/* { dg-afdo-requires python3 perf } */
+
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+volatile unsigned long sink;
+
+__attribute__((noinline))
+unsigned long work (unsigned long n)
+{
+  unsigned long s = 0;
+  for (unsigned long i = 0; i < n; i++)
+    s += (i & 7) ? i * 3 : i >> 1;
+  return s;
+}
+
+int main (int argc, char **argv)
+{
+  const unsigned long n = 100000000UL;
+  if (argc > 1 && strcmp (argv[1], "again") == 0)
+    {
+      sink = work (n);
+      return 0;
+    }
+  for (int c = 0; c < 2; c++)
+    if (fork () == 0)
+      {
+	sink = work (n);
+	_exit (0);
+      }
+  while (wait (NULL) > 0)
+    ;
+  execl ("/proc/self/exe", argv[0], "again", (char *) NULL);
+  return 1;
+}
