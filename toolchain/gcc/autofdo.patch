+
+# Shared helpers for the afdo_tools DejaGnu suite.
+
+#
+# afdo_tools_xgcc -- locate the sibling in-tree xgcc.
+#
+# TOOL_BIN_DIR is the afdo_tools build directory; xgcc lives in ../gcc.
+# Returns {xgcc_path gcc_build_dir}, or "".
+#
+proc afdo_tools_xgcc {} {
+    global env
+    if { ![info exists env(TOOL_BIN_DIR)] } {
+	return ""
+    }
+    set ext ""
+    if { [info exists env(EXEEXT)] } {
+	set ext $env(EXEEXT)
+    }
+    set gcc_dir [file normalize "$env(TOOL_BIN_DIR)/../gcc"]
+    set xgcc "$gcc_dir/xgcc$ext"
+    if { ![file executable $xgcc] } {
+	return ""
+    }
+    return [list $xgcc $gcc_dir]
+}
