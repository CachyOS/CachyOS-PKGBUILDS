+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# AFDO-TOOLS testsuite that uses the `afdo.exp' driver.
+
+# Load support procs.
+load_lib afdo.exp
+
+if { ![info exists GCC_UNDER_TEST] || $GCC_UNDER_TEST eq "" } {
+    unresolved "afdo-test: no in-tree xgcc (build gcc next to afdo_tools)"
+    return
+}
+
+# Initialize `dg'.
+dg-init
+
+# Make assigns one test stem to each parallel runtest worker.
+set afdo_test_stem ""
+if { [info exists env(AFDO_TEST_STEM)] && $env(AFDO_TEST_STEM) ne "" } {
+    set afdo_test_stem $env(AFDO_TEST_STEM)
+}
+
+# Main loop.
+foreach file [lsort \
+	[concat \
+	    [glob -nocomplain $srcdir/$subdir/*.c] \
+	    [glob -nocomplain $srcdir/$subdir/*.cc]]] {
+    if { ![runtest_file_p $runtests $file] } {
+	continue
+    }
+    set fields [afdo_parse_directives $file]
+    # Secondary sources (e.g. *-tu2.c) have no dg-afdo-entry.
+    if { ![dict exists $fields entry] } {
+	continue
+    }
+    set stem [file rootname [file tail $file]]
+    foreach src [afdo_expand_sources $fields] {
+	set label $stem
+	if { $src ne "-" && $src ne "auto" } {
+	    set label "$stem.$src"
+	}
+	if { $afdo_test_stem ne "" && $afdo_test_stem ne $stem
+	     && $afdo_test_stem ne $label } {
+	    continue
+	}
+	afdo_run_instance $file $src
+    }
+}
+
+# All done.
+dg-finish
diff --git a/afdo_tools/testsuite/afdo-test/cse-inline-stacks.c b/afdo_tools/testsuite/afdo-test/cse-inline-stacks.c
new file mode 100644
index 00000000000..73691fe4b07
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/cse-inline-stacks.c
@@ -0,0 +1,58 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -fno-ipa-icf -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot hot_driver } */
+/* { dg-afdo-dump-inline first_value second_value third_value } */
+/* { dg-afdo-requires python3 perf } */
+
+#include <stdio.h>
+
+volatile unsigned int marks[3];
+volatile int input;
+
+static inline __attribute__((always_inline))
+int
+first_value (int x, int value)
+{
+  marks[0] += x & 1;
+  return (x * 33) ^ value;
+}
+
+static inline __attribute__((always_inline))
+int
+second_value (int x, int value)
+{
+  marks[1] += x & 1;
+  return (x * 33) ^ value;
+}
+
+static inline __attribute__((always_inline))
+int
+third_value (int x, int value)
+{
+  marks[2] += x & 1;
+  return (x * 33) ^ value;
+}
+
+__attribute__((noinline))
+int
+hot_driver (int n, int value)
+{
+  int sum = 0;
+  for (int i = 0; i < n; ++i)
+    sum += (first_value (i, value)
+	    + second_value (i, value)
+	    + third_value (i, value));
+  return sum;
+}
+
+int
+main (void)
+{
+  int result = hot_driver (50000000, input);
+  printf ("%d %u\n", result, marks[0] + marks[1] + marks[2]);
+  return 0;
+}
