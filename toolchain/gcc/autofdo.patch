+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_SYMBOL_UTIL_H
+#define GCC_SYMBOL_UTIL_H
+
+#include "dwarf_types.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace gcc_symbol {
+
+enum class suffix_number
+{
+  none,
+  optional,
+  required
+};
+
+/* True when NAME ends in TAG with the specified numeric suffix.  NAME and
+   TAG must be nonnull.  */
+bool has_terminal_suffix (const char *name, const char *tag,
+			  suffix_number number);
+
+/* NAME with recognized clone and split part suffixes that share a profile
+   stripped.  */
+std::string symbol_base_name (std::string name);
+
+/* Name shared by a function and its split parts for emit accounting.  */
+std::string symbol_split_part_parent (std::string name);
+
+/* Match split parts or a generated variant with its unsuffixed function.  */
+bool name_equivalent (const std::string &a, const std::string &b);
+
+} /* namespace gcc_symbol.  */
+
+namespace source_path {
+
+/* Normalize source path components without accessing the filesystem.  */
+std::string normalize (std::string path);
+
+/* True when nonempty paths are equal or one is a relative component suffix
+   of the other.  An empty path is unknown and is never equivalent.  Inputs
+   must already have canonical separators and components.  */
+bool equivalent (const std::string &a, const std::string &b);
+
+} /* namespace source_path.  */
+
+namespace dwarf_debug {
+
+using intern_string_set = std::set<std::string, std::less<>>;
+
+/* Thread-safe interned-string pool (stable pointer identity).  */
+class StringPool
+{
+public:
+  static constexpr size_t SHARD_COUNT = 32;
+
+  interned_string intern (const std::string &str)
+  {
+    if (str.empty ())
+      return nullptr;
+    const size_t index = shard (str);
+    std::lock_guard<std::mutex> lock (shard_mus_[index]);
+    return &*shards_[index].insert (str).first;
+  }
+
+  /* As above, tolerating the null that DWARF and ELF readers hand back.  */
+  interned_string intern (const char *str)
+  {
+    if (str == nullptr || str[0] == '\0')
+      return nullptr;
+    return intern (std::string (str));
+  }
+  interned_string lookup (const std::string &str) const
+  {
+    if (str.empty ())
+      return nullptr;
+    const size_t index = shard (str);
+    std::lock_guard<std::mutex> lock (shard_mus_[index]);
+    const intern_string_set &shard_set = shards_[index];
+    const auto it = shard_set.find (str);
+    return it != shard_set.end () ? &*it : nullptr;
+  }
+
+private:
+  static size_t shard (const std::string &str)
+  {
+    return std::hash<std::string> {} (str) % SHARD_COUNT;
+  }
+
+  std::array<intern_string_set, SHARD_COUNT> shards_{};
+  mutable std::array<std::mutex, SHARD_COUNT> shard_mus_{};
+};
+
+/* FUNCS is sorted by start address and has one entry per start.  A lookup
+   checks the nearest preceding entry, including when ranges overlap.  */
+const function_metadata *
+function_containing_address (const std::vector<function_metadata> &funcs,
+			     uint64_t address);
+
+const function_metadata *
+function_at_entry_pc (const std::vector<function_metadata> &funcs,
+		      uint64_t pc);
+
+} /* namespace dwarf_debug.  */
+
+#endif /* GCC_SYMBOL_UTIL_H.  */
