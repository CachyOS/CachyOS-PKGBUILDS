diff --git a/afdo_tools/testsuite/lib/afdo.exp b/afdo_tools/testsuite/lib/afdo.exp
new file mode 100644
index 00000000000..9b7ddd4ad4a
--- /dev/null
+++ b/afdo_tools/testsuite/lib/afdo.exp
@@ -0,0 +1,1606 @@
+# Copyright The GNU Toolchain Authors.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3 of the License, or
+# (at your option) any later version.
+#
+# This program is distributed in the hope that it will be useful,
+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# Define afdo callbacks for dg.exp.
+
+# Pull GCC testsuite libs from the sibling gcc tree.
+global libdirs
+lappend libdirs [file normalize "$srcdir/../../gcc/testsuite/lib"]
+
+# Load dg and target-supports only (not full gcc-dg.exp).
+load_lib dg.exp
+load_lib target-supports.exp
+load_lib target-supports-dg.exp
+load_lib afdo_tools.exp
+
+if { ![info exists tool] } {
+    set tool gcc
+}
+
+# This file may be sourced, so don't override a previously set compiler.
+global GCC_UNDER_TEST
+if { ![info exists GCC_UNDER_TEST] || $GCC_UNDER_TEST eq "" } {
+    set xg [afdo_tools_xgcc]
+    if { $xg eq "" } {
+	perror "afdo.exp: no in-tree xgcc (build gcc next to afdo_tools)"
+	set GCC_UNDER_TEST ""
+    } else {
+	set GCC_UNDER_TEST "[lindex $xg 0] -B[lindex $xg 1]/"
+    }
+}
+
+# afdo_perf_wrapper -- path to gcc-auto-profile under gcc/config, or "".
+proc afdo_perf_wrapper {} {
+    global srcdir
+    set cfg [file normalize "$srcdir/../../gcc/config"]
+    if { [check_effective_target_x86] } {
+	set w "$cfg/i386/gcc-auto-profile"
+	if { [file executable $w] } { return "$w -m8" }
+    }
+    if { [istarget aarch64*-*-*] } {
+	set w "$cfg/aarch64/gcc-auto-profile"
+	if { [file executable $w] } { return "$w -m8" }
+    }
+    return ""
+}
+proc profopt-perf-wrapper {} {
+    return [afdo_perf_wrapper]
+}
+
+# afdo_profiling_available -- return 1 if AutoFDO profiling can run here.
+# Avoids check_profiling_available, which needs full gcc.exp.
+proc afdo_profiling_available {} {
+    if { ![check_effective_target_autofdo] } { return 0 }
+    if { ![isnative] } { return 0 }
+    set wrapper [afdo_perf_wrapper]
+    if { $wrapper eq "" } { return 0 }
+    set status [remote_exec host "$wrapper true -v >/dev/null"]
+    if { [lindex $status 0] != 0 } { return 0 }
+    return 1
+}
+
+# Directive parsers.  dg-get-options evaluates these into ::afdo_dg_fields.
+
+# dg-afdo-entry -- pipeline kind (live, merge, live-negative, live-reject,
+# or live-parity).
+proc dg-afdo-entry { args } {
+    dict set ::afdo_dg_fields entry [lindex $args 1]
+}
+
+# dg-afdo-sources -- profile sources (lbr/brbe/spe/auto/ip); one instance each.
+proc dg-afdo-sources { args } {
+    dict set ::afdo_dg_fields sources [lrange $args 1 end]
+}
+
+# dg-afdo-create -- extra flags forwarded to afdo_create (-m, -D, ...).
+proc dg-afdo-create { args } {
+    dict set ::afdo_dg_fields create [lrange $args 1 end]
+}
+
+# dg-afdo-validate -- validator: addr2line, dump-tree, or merge-dump-tree.
+proc dg-afdo-validate { args } {
+    dict set ::afdo_dg_fields validate [lindex $args 1]
+}
+
+# dg-afdo-post -- post-steps after create: dump, recompile, and/or opt-dump.
+proc dg-afdo-post { args } {
+    dict set ::afdo_dg_fields post [lrange $args 1 end]
+}
+
+# dg-afdo-requires -- tools/features required; missing means unsupported.
+proc dg-afdo-requires { args } {
+    dict set ::afdo_dg_fields requires [lrange $args 1 end]
+}
+
+# dg-afdo-extra-src -- additional TUs linked into the live binary.
+proc dg-afdo-extra-src { args } {
+    dict set ::afdo_dg_fields extra-src [lrange $args 1 end]
+}
+
+# dg-afdo-opt-dump-flags -- extra -fdump-* flags for the opt-dump recompile.
+proc dg-afdo-opt-dump-flags { args } {
+    dict set ::afdo_dg_fields opt-dump-flags [lrange $args 1 end]
+}
+
+# dg-afdo-scan-opt-info -- pattern expected in opt-dump compile output.
+proc dg-afdo-scan-opt-info { args } {
+    set cur {}
+    if { [dict exists $::afdo_dg_fields scan-opt-info] } {
+	set cur [dict get $::afdo_dg_fields scan-opt-info]
+    }
+    dict set ::afdo_dg_fields scan-opt-info [lappend cur [lindex $args 1]]
+}
+
+# afdo_add_dump_scan -- record a tree/IPA dump scan.
+proc afdo_add_dump_scan { kind pattern count suffix } {
+    set cur {}
+    if { [dict exists $::afdo_dg_fields scan-dump] } {
+	set cur [dict get $::afdo_dg_fields scan-dump]
+    }
+    dict set ::afdo_dg_fields scan-dump \
+	[lappend cur [list $kind $pattern $count $suffix]]
+}
+
+proc dg-afdo-scan-tree { args } {
+    afdo_add_dump_scan tree [lindex $args 1] "" [lindex $args 2]
+}
+
+proc dg-afdo-scan-tree-times { args } {
+    afdo_add_dump_scan tree [lindex $args 1] [lindex $args 2] \
+	[lindex $args 3]
+}
+
+proc dg-afdo-scan-ipa { args } {
+    afdo_add_dump_scan ipa [lindex $args 1] "" [lindex $args 2]
+}
+
+proc dg-afdo-scan-ipa-times { args } {
+    afdo_add_dump_scan ipa [lindex $args 1] [lindex $args 2] \
+	[lindex $args 3]
+}
+
+# dg-afdo-profile-driven-lto -- CALLER CALLEE [MINFREQ]; assert WPA cross-TU
+# inline with profile frequency (live entry, needs -flto in dg-options).
+proc dg-afdo-profile-driven-lto { args } {
+    dict set ::afdo_dg_fields profile-driven-lto [lrange $args 1 end]
+}
+
+# dg-afdo-determinism-runs -- run afdo_create N times; gcov must match modulo
+# the export timestamp (see validate_determinism.py).
+proc dg-afdo-determinism-runs { args } {
+    dict set ::afdo_dg_fields determinism-runs [lindex $args 1]
+}
+
+# dg-afdo-aslr-verify -- require MMAP2 load addr != PT_LOAD p_vaddr (value: yes).
+proc dg-afdo-aslr-verify { args } {
+    dict set ::afdo_dg_fields aslr-verify 1
+}
+
+# dg-afdo-invalid-perf -- live-negative: synthesize empty or corrupt perf.data.
+proc dg-afdo-invalid-perf { args } {
+    dict set ::afdo_dg_fields invalid-perf [lindex $args 1]
+}
+
+# dg-afdo-strip-variants -- live-reject variants: no-g, strip-debug, strip-all.
+proc dg-afdo-strip-variants { args } {
+    dict set ::afdo_dg_fields strip-variants [lrange $args 1 end]
+}
+
+# dg-afdo-system-wide -- record with perf -a; afdo_create must ignore foreign PIDs.
+proc dg-afdo-system-wide { args } {
+    dict set ::afdo_dg_fields system-wide 1
+}
+
+# dg-afdo-system-wide-verify -- assert the capture has samples from >1 process.
+proc dg-afdo-system-wide-verify { args } {
+    dict set ::afdo_dg_fields system-wide-verify 1
+}
+
+# dg-afdo-companions -- N busy-loops during system-wide record.
+proc dg-afdo-companions { args } {
+    dict set ::afdo_dg_fields companions [lindex $args 1]
+}
+
+# dg-afdo-dump-hot -- function(s) expected as top-level hot headers.
+proc dg-afdo-dump-hot { args } {
+    dict set ::afdo_dg_fields dump-hot [lrange $args 1 end]
+}
+
+# dg-afdo-dump-hot-in-file -- FUNC:FILEFRAG hot header (disambiguate same names).
+proc dg-afdo-dump-hot-in-file { args } {
+    dict set ::afdo_dg_fields dump-hot-in-file [lrange $args 1 end]
+}
+
+# dg-afdo-dump-inline -- expected direct inline child name(s).
+proc dg-afdo-dump-inline { args } {
+    dict set ::afdo_dg_fields dump-inline [lrange $args 1 end]
+}
+
+# dg-afdo-dump-nested -- expected nested inline name(s).
+proc dg-afdo-dump-nested { args } {
+    dict set ::afdo_dg_fields dump-nested [lrange $args 1 end]
+}
+
+# dg-afdo-dump-call -- CALLER CALLEE edge expected in the dump (repeatable).
+proc dg-afdo-dump-call { args } {
+    dict lappend ::afdo_dg_fields dump-call [lrange $args 1 end]
+}
+
+# dg-afdo-dump-line-hot -- FUNC:OFFSET must have count>0 in FUNC's dump block.
+proc dg-afdo-dump-line-hot { args } {
+    dict set ::afdo_dg_fields dump-line-hot [lrange $args 1 end]
+}
+
+# dg-afdo-dump-nested-branch-stack -- like dump-nested, only for brbe/lbr.
+proc dg-afdo-dump-nested-branch-stack { args } {
+    dict set ::afdo_dg_fields dump-nested-branch-stack [lrange $args 1 end]
+}
+
+# dg-afdo-workloads -- args for each merge profiling run.
+proc dg-afdo-workloads { args } {
+    dict set ::afdo_dg_fields workloads [lrange $args 1 end]
+}
+
+# dg-afdo-merge-hot -- hot headers expected in the merged dump.
+proc dg-afdo-merge-hot { args } {
+    dict set ::afdo_dg_fields merge-hot [lrange $args 1 end]
+}
+
+# dg-afdo-workload-dsos -- per-workload DSO sources (parallel to workloads).
+proc dg-afdo-workload-dsos { args } {
+    dict set ::afdo_dg_fields workload-dsos [lrange $args 1 end]
+}
+
+# dg-afdo-workload-drivers -- per-workload driver sources (needs workload-dsos).
+proc dg-afdo-workload-drivers { args } {
+    dict set ::afdo_dg_fields workload-drivers [lrange $args 1 end]
+}
+
+# afdo_parse_directives -- harvest dg-* / dg-afdo-* into a fields dict.
+# FILE is the test source path.
+proc afdo_parse_directives { file } {
+    set fields [dict create]
+    set ::afdo_dg_fields [dict create]
+    set dg-extra-tool-flags ""
+    set dg-do-what [list "compile" "" P]
+
+    foreach op [dg-get-options $file] {
+	set cmd [lindex $op 0]
+	switch -glob -- $cmd {
+	    dg-options - dg-additional-options { catch { eval $op } }
+	    dg-require-profiling { dict set fields gate profiling }
+	    dg-require-* - dg-skip-if { catch { eval $op } }
+	    dg-afdo-* { catch { eval $op } }
+	    default { }
+	}
+    }
+    set fields [dict merge $fields $::afdo_dg_fields]
+    if { ${dg-extra-tool-flags} ne "" } {
+	dict set fields options [string trim ${dg-extra-tool-flags}]
+    }
+    if { [lindex ${dg-do-what} 1] eq "N" } {
+	dict set fields gate_failed "skipped by dg-require/dg-skip-if"
+    }
+    return $fields
+}
+
+# afdo_expand_sources -- sources list to instance tags (-, auto, or explicit).
+# FIELDS is the dict from afdo_parse_directives.
+proc afdo_expand_sources { fields } {
+    if { ![dict exists $fields sources] } { return [list "-"] }
+    set s [dict get $fields sources]
+    switch -- $s {
+	"" - "none" { return [list "-"] }
+	"auto"      { return [list "auto"] }
+	default     { return $s }
+    }
+}
+
+# Tool / compiler location.
+
+# afdo_tool_find -- resolve CMD on PATH via auto_execok.
+proc afdo_tool_find { cmd } {
+    return [lindex [auto_execok $cmd] 0]
+}
+
+# afdo_build_dir -- <build>/afdo_tools next to xgcc, or "".
+proc afdo_build_dir {} {
+    set cc [afdo_tool_compiler]
+    if { $cc eq "" } { return "" }
+    set gccbin [lindex $cc 0]                       ;# ".../<build>/gcc/xgcc"
+    if { $gccbin eq "" } { return "" }
+    return [file normalize "[file dirname $gccbin]/../afdo_tools"]
+}
+
+# afdo_tool_named -- resolve NAME via ENVVAR, TOOL_BIN_DIR, build dir, or PATH.
+proc afdo_tool_named { name envvar } {
+    global env
+    if { [info exists env($envvar)] && $env($envvar) ne "" \
+	     && [file executable $env($envvar)] } {
+	return $env($envvar)
+    }
+    if { [info exists env(TOOL_BIN_DIR)] && $env(TOOL_BIN_DIR) ne "" } {
+	set ext ""
+	if { [info exists env(EXEEXT)] } { set ext $env(EXEEXT) }
+	set p "$env(TOOL_BIN_DIR)/$name$ext"
+	if { [file executable $p] } { return $p }
+    }
+    set bd [afdo_build_dir]
+    if { $bd ne "" && [file executable "$bd/$name"] } {
+	return "$bd/$name"
+    }
+    return [afdo_tool_find $name]
+}
+
+proc afdo_tool_locate {} {
+    return [afdo_tool_named afdo_create AFDO_CREATE]
+}
+
+proc afdo_tool_dump {} {
+    return [afdo_tool_named afdo_dump AFDO_DUMP]
+}
+
+proc afdo_tool_merge {} {
+    return [afdo_tool_named afdo_merge AFDO_MERGE]
+}
+
+# afdo_tool_compiler -- GCC_UNDER_TEST, or "".
+proc afdo_tool_compiler {} {
+    global GCC_UNDER_TEST
+    if { [info exists GCC_UNDER_TEST] } { return $GCC_UNDER_TEST }
+    return ""
+}
+
+# Profile-source to perf / afdo_create flags.
+
+# afdo_source_record_args -- perf record args for lbr/brbe/spe/ip.
+proc afdo_source_record_args { src } {
+    switch -- $src {
+	lbr  { return [list -b -e br_inst_retired.near_taken:pp] }
+	brbe { return [list -b -e br_retired] }
+	spe  { return [list --event arm_spe_0// -c 10000] }
+	ip   { return [list -e cycles] }
+    }
+    return {}
+}
+
+# afdo_source_mode_args -- afdo_create mode flags (-s for spe).
+proc afdo_source_mode_args { src } {
+    if { $src eq "spe" } { return [list -s] }
+    return {}
+}
+
+# afdo_pick_source -- resolve auto: BRBE, else SPE, else LBR (or $AFDO_FORCE_PERF_MODE).
+proc afdo_pick_source {} {
+    global env
+    if { [info exists env(AFDO_FORCE_PERF_MODE)] && $env(AFDO_FORCE_PERF_MODE) ne "" } {
+	return [string tolower $env(AFDO_FORCE_PERF_MODE)]
+    }
+    # Prefer BRBE when the kernel advertises the sysfs capability.
+    foreach c [glob -nocomplain \
+		   /sys/bus/event_source/devices/armv8_pmuv3*/caps/branches] {
+	if { [catch { open $c r } fd] } { continue }
+	set v [string trim [read $fd]]
+	close $fd
+	if { $v ne "" && $v ne "0" } { return "brbe" }
+    }
+    set perf [afdo_tool_find perf]
+    if { $perf eq "" } { return "" }
+    if { [catch { exec $perf --no-pager list 2>@1 } perflist] } { set perflist "" }
+    if { [string first "arm_spe" $perflist] >= 0 } { return "spe" }
+    set arch ""
+    catch { set arch [string trim [exec uname -m]] }
+    if { $arch eq "x86_64" || $arch eq "i686" || $arch eq "i386" } { return "lbr" }
+    return ""
+}
+
+# afdo_host_live_branch_stack_supported -- probe live PERF_SAMPLE_BRANCH_STACK.
+proc afdo_host_live_branch_stack_supported {} {
+    global afdo_live_brstack_probe
+    if { [info exists afdo_live_brstack_probe] } { return $afdo_live_brstack_probe }
+    set afdo_live_brstack_probe 0
+    set perf [afdo_tool_find perf]
+    if { $perf ne "" } {
+	set probe "[pwd]/afdo-brstack-probe.data"
+	file delete -force $probe
+	set rc [catch { exec $perf record --no-buildid-cache -j any,u \
+			    -o $probe -- /bin/true 2>@1 } out]
+	file delete -force $probe
+	if { $rc == 0 && ![string match "*branch stack sampling*" $out] } {
+	    set afdo_live_brstack_probe 1
+	}
+	verbose "live branch-stack probe: rc=$rc out=$out" 2
+    }
+    return $afdo_live_brstack_probe
+}
+
+# Gating and validators.
+
+# afdo_require -- check required tools; "aslr" checks /proc.
+# LABEL is the DejaGnu test name.  TOOLS is the dg-afdo-requires list.
+proc afdo_require { label tools } {
+    foreach t $tools {
+	if { $t eq "aslr" } {
+	    set f "/proc/sys/kernel/randomize_va_space"
+	    if { [catch { open $f r } fd] } {
+		unsupported "$label: cannot read $f (not Linux?)"
+		return 0
+	    }
+	    set val [string trim [read $fd]]
+	    close $fd
+	    if { $val eq "0" } {
+		unsupported "$label: ASLR disabled (randomize_va_space=0)"
+		return 0
+	    }
+	} elseif { [afdo_tool_find $t] eq "" } {
+	    unsupported "$label: $t not in PATH"
+	    return 0
+	}
+    }
+    return 1
+}
+
+# afdo_validate -- run the Python validator named by dg-afdo-validate.
+# LABEL is the DejaGnu test name.  STEM is the test basename.
+# SRC is the resolved profile source.  FIELDS is the directive dict.
+# BIN is the profiled binary.  PRODUCED is an optional create side file.
+# DUMPOUT is afdo_dump text when post dump ran.
+proc afdo_validate { label stem src fields bin produced dumpout {srcdumps {}} } {
+    global srcdir subdir
+    set here "$srcdir/$subdir"
+    set py [afdo_tool_find python3]
+    set kind [dict get $fields validate]
+
+    switch -- $kind {
+	dump-tree {
+	    set v "$here/validate_dump_tree.py"
+	    set vcmd [list $py $v --dump $dumpout]
+	    if { [dict exists $fields dump-hot] } {
+		foreach n [dict get $fields dump-hot] { lappend vcmd --hot $n }
+	    }
+	    if { [dict exists $fields dump-hot-in-file] } {
+		foreach spec [dict get $fields dump-hot-in-file] {
+		    lappend vcmd --hot-in-file $spec
+		}
+	    }
+	    if { [dict exists $fields dump-call] } {
+		foreach pair [dict get $fields dump-call] {
+		    lappend vcmd --call "[lindex $pair 0]:[lindex $pair 1]"
+		}
+	    }
+	    if { [dict exists $fields dump-line-hot] } {
+		foreach spec [dict get $fields dump-line-hot] { lappend vcmd --line-hot $spec }
+	    }
+	    if { [dict exists $fields dump-inline] } {
+		foreach n [dict get $fields dump-inline] { lappend vcmd --inline $n }
+	    }
+	    if { [dict exists $fields dump-nested] } {
+		foreach n [dict get $fields dump-nested] { lappend vcmd --nested $n }
+	    }
+	    if { [dict exists $fields dump-nested-branch-stack] \
+		     && ($src eq "brbe" || $src eq "lbr") } {
+		foreach n [dict get $fields dump-nested-branch-stack] {
+		    lappend vcmd --nested $n
+		}
+	    }
+	    verbose "Running $vcmd" 1
+	    if { [catch { eval exec $vcmd 2>@1 } out] } {
+		fail "$label: dump tree does not match expected structure:\n$out"
+		return
+	    }
+	    pass "$label: dump tree has expected hot/inline/nested structure"
+	}
+	addr2line {
+	    set v "$here/validate_addr_mapping.py"
+	    set vcmd [list $py $v -b $bin -m $produced]
+	    verbose "Running $vcmd" 1
+	    set rc [catch { eval exec $vcmd 2>@1 } out]
+	    if { $rc == 0 } {
+		pass "$label: address mapping matches addr2line -i -f"
+	    } elseif { [string match "*SKIP:*" $out] } {
+		unsupported "$label: $out"
+	    } else {
+		fail "$label: address mapping disagrees with addr2line:\n$out"
+	    }
+	}
+	merge-dump-tree {
+	    if { $dumpout eq "" } {
+		unsupported "$label: merge-dump-tree requires 'post dump'"
+		return
+	    }
+	    set v "$here/validate_merge.py"
+	    set vcmd [list $py $v --dump $dumpout]
+	    if { [dict exists $fields merge-hot] } {
+		foreach fn [dict get $fields merge-hot] { lappend vcmd --hot $fn }
+	    }
+	    if { [catch { eval exec $vcmd 2>@1 } out] } {
+		fail "$label: merged dump does not have expected hot functions:\n$out"
+		return
+	    }
+	    pass "$label: merged dump has hot functions from all workloads"
+	}
+	default {
+	    unsupported "$label: validator '$kind' not implemented in prototype"
+	}
+    }
+}
+
+# afdo_verify_aslr -- check ASLR load bias via validate_aslr_mmap.py.
+proc afdo_verify_aslr { label bin perfdata } {
+    global srcdir subdir
+    set py [afdo_tool_find python3]
+    set v "$srcdir/$subdir/validate_aslr_mmap.py"
+    set rc [catch { exec $py $v -b $bin -p $perfdata 2>@1 } out]
+    if { $rc == 0 } {
+	pass "$label: ASLR load bias is non-zero"
+	return 1
+    } elseif { [string match "*SKIP:*" $out] } {
+	unsupported "$label: $out"
+	return 1
+    } else {
+	fail "$label: ASLR verification failed:\n$out"
+	return 0
+    }
+}
+
+# afdo_verify_system_wide -- check multi-PID samples via validate_system_wide.py.
+proc afdo_verify_system_wide { label bin perfdata } {
+    global srcdir subdir
+    set py [afdo_tool_find python3]
+    set v "$srcdir/$subdir/validate_system_wide.py"
+    set rc [catch { exec $py $v -b $bin -p $perfdata 2>@1 } out]
+    if { $rc == 0 } {
+	pass "$label: perf.data contains system-wide (multi-process) samples"
+	return 1
+    } elseif { [string match "*SKIP:*" $out] } {
+	unsupported "$label: $out"
+	return 1
+    } else {
+	fail "$label: system-wide verification failed:\n$out"
+	return 0
+    }
+}
+
+# Live-path runners.
+
+# afdo_echo_cmd -- log a harness command at verbose level 0.
+proc afdo_echo_cmd { kind cmd } {
+    verbose -log -- "afdo \[$kind\]: $cmd" 0
+}
+
+# afdo_compile -- compile SRC (+ optional extra TUs) to BIN.
+# LABEL is the DejaGnu test name.  CC is the compiler command.
+# OPTS are compile flags.  EXTRA_SRCS are additional TUs to link.
+proc afdo_compile { label cc opts src bin {extra_srcs {}} } {
+    file delete -force $bin
+    # Word-split $cc and $opts; $extra_srcs are additional TUs (dg-afdo-extra-src).
+    set cc_cmd [concat $cc $opts [list $src] $extra_srcs [list -o $bin]]
+    afdo_echo_cmd compile $cc_cmd
+    if { [catch { eval exec $cc_cmd 2>@1 } out] || ![file executable $bin] } {
+	fail "$label: compile failed: $out"
+	return 0
+    }
+    pass "$label: compile"
+    return 1
+}
+
+# afdo_recompile_with_profile -- recompile with -fauto-profile=GCOV.
+proc afdo_recompile_with_profile { label cc opts src gcov } {
+    set bin2 "[pwd]/$label.profile.exe"
+    file delete -force $bin2
+    set cc_cmd [concat $cc $opts [list -fauto-profile=$gcov $src -o $bin2]]
+    verbose "Running $cc_cmd" 1
+    if { [catch { eval exec $cc_cmd 2>@1 } out] || ![file executable $bin2] } {
+	fail "$label: recompile with -fauto-profile failed: $out"
+	return 0
+    }
+    pass "$label: recompile with -fauto-profile"
+    return 1
+}
+
+# afdo_recompile_opt_dump -- recompile with opt-dump flags and scan patterns.
+proc afdo_recompile_opt_dump { label cc opts src gcov fields } {
+    set extra {}
+    if { [dict exists $fields opt-dump-flags] } {
+	set extra [dict get $fields opt-dump-flags]
+    }
+    set dumpdir [pwd]
+    # Absolute -dumpbase: avoid driver -dumpdir=<path> that confuses cc1.
+    set dumpbase "$dumpdir/$label.optdump"
+    set bin2 "$dumpdir/$label.optdump.exe"
+    file delete -force $bin2
+    set cc_cmd [concat $cc $opts $extra \
+	[list -fauto-profile=$gcov \
+	      -dumpbase $dumpbase \
+	      $src -o $bin2]]
+    verbose "Running $cc_cmd" 1
+    if { [catch { eval exec $cc_cmd 2>@1 } out] || ![file executable $bin2] } {
+	fail "$label: opt-dump recompile failed: $out"
+	return 0
+    }
+    pass "$label: opt-dump recompile"
+
+    # Save compile output for opt-info inspection.
+    set opt_info_file "$dumpbase.opt-info"
+    set fh [open $opt_info_file w]
+    puts $fh $out
+    close $fh
+
+    # Scan compile output for dg-afdo-scan-opt-info patterns.
+    if { [dict exists $fields scan-opt-info] } {
+	foreach pattern [dict get $fields scan-opt-info] {
+	    if { [regexp -- $pattern $out] } {
+		pass "$label: opt-info contains '$pattern'"
+	    } else {
+		fail "$label: opt-info missing '$pattern'"
+	    }
+	}
+    }
+
+    # Scan tree and IPA dumps requested by source directives.
+    if { [dict exists $fields scan-dump] } {
+	set srctail [file tail $src]
+	foreach scan [dict get $fields scan-dump] {
+	    lassign $scan kind pattern count suffix
+	    set scan_name "scan-$kind-dump"
+	    set matches [glob -nocomplain "$dumpbase-$srctail.*.$suffix"]
+	    if { [llength $matches] == 0 } {
+		fail "$label: $scan_name: no dump file with suffix '$suffix'"
+		continue
+	    }
+	    set content ""
+	    foreach f $matches {
+		set fh [open $f r]
+		append content [read $fh]
+		close $fh
+	    }
+	    set matches [regexp -all -- $pattern $content]
+	    if { $count eq "" && $matches > 0 } {
+		pass "$label: $scan_name '$suffix' contains '$pattern'"
+	    } elseif { $count ne "" && $matches == $count } {
+		pass "$label: $scan_name '$suffix' contains '$pattern' $count times"
+	    } elseif { $count eq "" } {
+		fail "$label: $scan_name '$suffix': '$pattern' not found"
+	    } else {
+		fail "$label: $scan_name '$suffix': '$pattern' found $matches times, expected $count"
+	    }
+	}
+    }
+    return 1
+}
+
+# afdo_recompile_lto_apply -- two-step -flto -fauto-profile link; check WPA inline.
+proc afdo_recompile_lto_apply { label cc opts srcs gcov spec } {
+    lassign $spec caller callee minfreq
+    if { $minfreq eq "" } { set minfreq 100 }
+    set dumpdir [pwd]
+    # Absolute -dumpbase: same as afdo_recompile_opt_dump.
+    set dumpbase "$dumpdir/$label.lto"
+    set exe "$dumpbase.exe"
+    file delete -force $exe
+
+    # Compile each TU to an LTO object with the profile applied.
+    set objs {}
+    set i 0
+    foreach s $srcs {
+	set o "$dumpbase.[incr i].o"
+	file delete -force $o
+	set ccmd [concat $cc $opts \
+		      [list -flto -fauto-profile=$gcov -c $s -o $o]]
+	afdo_echo_cmd compile $ccmd
+	if { [catch { eval exec $ccmd 2>@1 } out] || ![file exists $o] } {
+	    fail "$label: LTO-apply compile of [file tail $s] failed: $out"
+	    return
+	}
+	lappend objs $o
+    }
+
+    # Link/WPA: apply profile and drive cross-TU inlining.
+    set lcmd [concat $cc $opts \
+		  [list -flto -fauto-profile=$gcov \
+		        -fdump-ipa-inline-details -fopt-info-inline-optimized \
+		        -dumpbase $dumpbase] $objs [list -o $exe]]
+    afdo_echo_cmd compile $lcmd
+    set rc [catch { eval exec $lcmd 2>@1 } lout]
+    if { $rc != 0 || ![file executable $exe] } {
+	fail "$label: LTO-apply link (WPA) failed: $lout"
+	return
+    }
+    pass "$label: LTO-apply two-step -flto -fauto-profile rebuild"
+
+    # Require a cross-TU inline (WPA opt-info); allow .constprop/.isra suffixes.
+    if { [regexp "Inlined\[^\n\]*$callee\[^\n\]*into\[^\n\]*$caller\[^\n\]*cross module" $lout] } {
+	pass "$label: WPA inlined $callee into $caller cross-module"
+    } else {
+	fail "$label: WPA did not report cross-module inline of $callee into\
+	      $caller:\n$lout"
+    }
+
+    # Require a profile-scale frequency on the cross-module edge in the dump.
+    set dumps [glob -nocomplain "$dumpbase.wpa.*.inline"]
+    if { [llength $dumps] == 0 } {
+	fail "$label: no WPA ipa-inline dump produced (LTO WPA did not run?)"
+	return
+    }
+    set content ""
+    foreach f $dumps {
+	set fh [open $f r]
+	append content [read $fh]
+	close $fh
+    }
+    set best 0
+    foreach line [split $content "\n"] {
+	if { [regexp {freq:([0-9]+)(?:\.[0-9]+)?[^\n]*cross module} $line -> f] } {
+	    if { $f > $best } { set best $f }
+	}
+    }
+    if { $best >= $minfreq } {
+	pass "$label: WPA cross-module edge carries profile freq $best (>= $minfreq)"
+    } else {
+	fail "$label: WPA cross-module edge freq $best < $minfreq -- profile not\
+	      applied at WPA (dropped through LTO serialization?)"
+    }
+}
+
+# afdo_check_determinism -- re-run afdo_create; compare gcovs modulo timestamp.
+proc afdo_check_determinism { label create bin perfdata gcov0 effsrc nruns extra_flags } {
+    global srcdir subdir
+    set adump [afdo_tool_dump]
+    if { $adump eq "" } {
+	unsupported "$label: afdo_dump not found (needed to read timestamps)"
+	return
+    }
+    set py [afdo_tool_find python3]
+    set modeargs [afdo_source_mode_args $effsrc]
+    set gcovs [list $gcov0]
+    for {set i 2} {$i <= $nruns} {incr i} {
+	set g "[pwd]/$label.det$i.gcov"
+	file delete -force $g
+	set ccmd [concat [list $create] $modeargs $extra_flags \
+		      [list -b $bin -p $perfdata -o $g]]
+	afdo_echo_cmd afdo_create $ccmd
+	set id [remote_spawn "" $ccmd]
+	if { $id < 0 } {
+	    unsupported "$label: cannot run afdo_create (determinism run $i)"
+	    return
+	}
+	set result [remote_wait "" 300]
+	if { [lindex $result 0] != 0 || ![file exists $g] } {
+	    fail "$label: afdo_create failed on determinism run $i:\
+		  [lindex $result 1]"
+	    return
+	}
+	lappend gcovs $g
+    }
+    set v "$srcdir/$subdir/validate_determinism.py"
+    set vcmd [concat [list $py $v --afdo-dump $adump] $gcovs]
+    verbose "Running $vcmd" 1
+    set rc [catch { eval exec $vcmd 2>@1 } out]
+    if { $rc == 0 } {
+	pass "$label: $nruns-run gcov output is byte-deterministic (modulo timestamp)"
+	verbose -log -- "afdo \[determinism\]: $out" 0
+    } elseif { [string match "*SKIP:*" $out] } {
+	unsupported "$label: $out"
+    } else {
+	fail "$label: gcov output not reproducible across $nruns runs:\n$out"
+    }
+}
+
+# afdo_compile_dso -- build a shared library from SRC_NAME.
+proc afdo_compile_dso { label src_name dso_path } {
+    global srcdir subdir GCC_UNDER_TEST
+    set full_src "$srcdir/$subdir/$src_name"
+    if { ![file exists $full_src] } {
+	unresolved "$label: DSO source not found: $full_src"
+	return 0
+    }
+    file delete -force $dso_path
+    # Invoke the compiler directly; ${tool}_target_compile cannot build DSOs.
+    set cmd [concat $GCC_UNDER_TEST \
+	[list -O2 -g -fPIC -shared -Wl,--build-id $full_src -o $dso_path]]
+    verbose "afdo_compile_dso: $cmd" 1
+    if { [catch { eval exec $cmd 2>@1 } out] || ![file exists $dso_path] } {
+	fail "$label: DSO compile ($src_name) failed: $out"
+	return 0
+    }
+    pass "$label: DSO compile ($src_name)"
+    return 1
+}
+
+# afdo_lbr_taskset_prefix -- pin to P-cores on hybrid x86 when needed for LBR.
+proc afdo_lbr_taskset_prefix {} {
+    set pcores {}
+    foreach f [glob -nocomplain /sys/devices/system/cpu/cpu*/topology/core_type] {
+	if { [catch { open $f r } fd] } { continue }
+	set t [string trim [read $fd]]
+	close $fd
+	if { $t eq "core" } {
+	    regexp {cpu(\d+)$} [file dirname $f] -> n
+	    lappend pcores $n
+	}
+    }
+    if { [llength $pcores] == 0 } { return {} }
+    return [list taskset -c [join $pcores ,]]
+}
+
+# afdo_spawn_companions -- start N background busy-loops; return pids.
+proc afdo_spawn_companions { n } {
+    set pids {}
+    for {set i 0} {$i < $n} {incr i} {
+	if { [catch { exec sh -c {while :; do :; done} & } pid] } { continue }
+	lappend pids $pid
+    }
+    return $pids
+}
+
+# afdo_kill_companions -- kill companion pids (best-effort).
+proc afdo_kill_companions { pids } {
+    foreach p $pids {
+	catch { exec kill -9 $p }
+    }
+    foreach p $pids {
+	catch { exec wait $p }
+    }
+}
+
+# afdo_perf_sample_count -- SAMPLE count from perf report --stats, or -1.
+proc afdo_perf_sample_count { perfdata } {
+    set perf [afdo_tool_find perf]
+    if { $perf eq "" } { return -1 }
+    if { [catch { exec $perf report -i $perfdata --stats 2>@1 } out] } {
+	return -1
+    }
+    set total 0
+    set found 0
+    foreach ln [split $out "\n"] {
+	if { [regexp {SAMPLE events:\s*(\d+)} $ln -> n] } {
+	    incr total $n
+	    set found 1
+	}
+    }
+    if { !$found } { return -1 }
+    return $total
+}
+
+# afdo_perf_record -- run perf record into PERFDATA; set EFFSRCVAR.
+# LABEL is the DejaGnu test name.  SRC is the requested profile source.
+# BIN is the binary to run.  BINARGS are argv after BIN.
+# SYSTEMWIDE enables perf -a.  COMPANIONS is the number of busy-loops.
+proc afdo_perf_record { label src perfdata bin effsrcvar {binargs {}} {systemwide 0} {companions 0} } {
+    upvar 1 $effsrcvar effsrc
+    file delete -force $perfdata
+    set companion_pids {}
+    if { $systemwide && $companions > 0 } {
+	set companion_pids [afdo_spawn_companions $companions]
+    }
+    set auto_branchless 0
+    if { $src eq "auto" } {
+	set effsrc [afdo_pick_source]
+	set wrapper [afdo_perf_wrapper]
+	if { $wrapper eq "" } {
+	    afdo_kill_companions $companion_pids
+	    unsupported "$label: no afdo_perf_wrapper for this target"
+	    return 0
+	}
+	set rc [catch { eval exec $wrapper -o $perfdata $bin 2>@1 } out]
+	# Prefer the resolved `perf record` line from the wrapper (-x) when present.
+	set shown 0
+	set resolved ""
+	foreach ln [split $out "\n"] {
+	    if { [string match {*perf record*--inherit*} $ln] } {
+		afdo_echo_cmd record [string trimleft $ln "+ "]
+		set resolved $ln
+		set shown 1
+	    }
+	}
+	if { !$shown } { afdo_echo_cmd record "$wrapper -o $perfdata $bin" }
+	# Detect wrapper downgrade to branch-less sampling (no BRBE/SPE/LBR).
+	if { ($resolved ne "" && ![string match {*-j *} $resolved] \
+		  && ![string match {*-b *} $resolved] \
+		  && ![string match {*arm_spe*} $resolved]) \
+		 || [string match {*may not be functional without BRBE*} $out] } {
+	    set auto_branchless 1
+	}
+    } else {
+	set effsrc $src
+	set perf [afdo_tool_find perf]
+	set rargs [afdo_source_record_args $effsrc]
+	# System-wide (-a) still bounds collection to the workload command.
+	if { $systemwide } { set rargs [concat [list -a] $rargs] }
+	# Pin to P-cores on hybrid x86 when needed for LBR.
+	set taskpfx {}
+	if { $effsrc eq "lbr" } { set taskpfx [afdo_lbr_taskset_prefix] }
+	set rcmd [concat [list $perf record --no-buildid-cache] $rargs \
+		      [list -o $perfdata --] $taskpfx [list $bin] $binargs]
+	afdo_echo_cmd record $rcmd
+	set rc [catch { eval exec $rcmd 2>@1 } out]
+    }
+    afdo_kill_companions $companion_pids
+    set srcdisp [expr {$effsrc eq "" ? "auto" : $effsrc}]
+    if { $rc || ![file exists $perfdata] } {
+	unsupported "$label: perf record ($srcdisp) failed\
+		     (perms/PMU access?): $out"
+	return 0
+    }
+    # Branch-less capture is useless for afdo_create; report unsupported.
+    if { $auto_branchless } {
+	unsupported "$label: perf record ($srcdisp) has no branch-stack support\
+		     (no BRBE/SPE on host)"
+	return 0
+    }
+    # Empty capture (zero samples): unsupported, not FAIL.  Ignore count -1.
+    if { [afdo_perf_sample_count $perfdata] == 0 } {
+	unsupported "$label: perf record ($srcdisp) produced no samples\
+		     (no usable PMU counter?)"
+	return 0
+    }
+    pass "$label: perf record ($srcdisp)"
+    return 1
+}
+
+# afdo_dump_gcov -- run afdo_dump; store tree text in DUMPOUTVAR.
+proc afdo_dump_gcov { label gcov dumpoutvar } {
+    upvar 1 $dumpoutvar dumpout
+    set adump [afdo_tool_dump]
+    if { $adump eq "" } {
+	unsupported "$label: afdo_dump not found (set \$AFDO_DUMP or add to PATH)"
+	return 0
+    }
+    set dumpout "[pwd]/$label.dump.txt"
+    file delete -force $dumpout
+    afdo_echo_cmd afdo_dump "$adump $gcov"
+    if { [catch { exec $adump $gcov 2>@1 } out] } {
+	fail "$label: afdo_dump failed: $out"
+	return 0
+    }
+    set fh [open $dumpout w]
+    puts $fh $out
+    close $fh
+    pass "$label: afdo_dump"
+    return 1
+}
+
+# afdo_create runners.
+
+# afdo_create_gcov -- offline afdo_create -b/-p/-o; optional -m/-D side dump.
+# LABEL is the DejaGnu test name.  CREATE is the afdo_create binary.
+# BIN, PERFDATA, and GCOV are paths.  EFFSRC is the resolved profile source.
+# DUMPFLAG is -m or -D, or "".  PRODUCED is the side-dump path when set.
+# EXTRA_FLAGS are additional afdo_create arguments.
+proc afdo_create_gcov { label create bin perfdata gcov effsrc dumpflag produced {extra_flags {}} } {
+    set modeargs [afdo_source_mode_args $effsrc]
+    set ccmd [concat [list $create] $modeargs $extra_flags [list -b $bin -p $perfdata]]
+    if { $dumpflag ne "" } { lappend ccmd $dumpflag $produced }
+    lappend ccmd -o $gcov
+
+    afdo_echo_cmd afdo_create $ccmd
+    set id [remote_spawn "" $ccmd]
+    if { $id < 0 } {
+	unsupported "$label: cannot run afdo_create"
+	return 0
+    }
+    set result [remote_wait "" 300]
+    set rc [lindex $result 0]
+    set out [lindex $result 1]
+    if { $rc != 0 || ($produced ne "" && ![file exists $produced]) } {
+	fail "$label: afdo_create $dumpflag failed (rc=$rc): $out"
+	return 0
+    }
+    pass "$label: afdo_create $dumpflag"
+    return 1
+}
+
+# afdo_create_live -- live/PMU afdo_create (tool forks and profiles BIN).
+proc afdo_create_live { create bin gcov outvar } {
+    upvar 1 $outvar out
+    file delete -force $gcov
+    set ccmd [list $create -b $bin -o $gcov -- $bin]
+    verbose "Running $ccmd" 1
+    set rc [catch { eval exec $ccmd 2>@1 } out]
+    if { $rc != 0 || ![file exists $gcov] } { return 0 }
+    return 1
+}
+
+# afdo_live_branch_stack_unsupported -- true if create output shows no BRBE/LBR.
+proc afdo_live_branch_stack_unsupported { out } {
+    return [expr {
+	[string match "*Branch stack not supported*" $out]
+	|| [string match "*Live profiling requires branch-stack*" $out]
+	|| [string match "*live capture requires LBR/BRBE branch-stack support*" $out]
+	|| [string match "*perf_event_open failed: Operation not supported*" $out]
+	|| [string match "*perf_event_open failed: Function not implemented*" $out]
+    }]
+}
+
+# afdo_dumptree_has_hot -- dump-tree check for dg-afdo-dump-hot names.
+proc afdo_dumptree_has_hot { dumpfile fields } {
+    global srcdir subdir
+    set py [afdo_tool_find python3]
+    set v "$srcdir/$subdir/validate_dump_tree.py"
+    set vcmd [list $py $v --dump $dumpfile]
+    if { [dict exists $fields dump-hot] } {
+	foreach n [dict get $fields dump-hot] { lappend vcmd --hot $n }
+    }
+    if { [catch { eval exec $vcmd 2>@1 } out] } { return [list 0 $out] }
+    return [list 1 ""]
+}
+
+# Per-instance pipelines.
+
+# afdo_run_instance -- generic per-(file, source) pipeline.
+# FILE is the test source.  SRC is the profile-source instance tag.
+proc afdo_run_instance { file src } {
+    global srcdir subdir
+
+    set fields [afdo_parse_directives $file]
+    if { ![dict exists $fields entry] } { return }
+    set entry [dict get $fields entry]
+    set stem [file rootname [file tail $file]]
+    set label [expr {($src eq "-" || $src eq "auto") ? $stem : "$stem.$src"}]
+
+    # Skip if dg-require-* / dg-skip-if marked the test unsupported.
+    if { [dict exists $fields gate_failed] } {
+	unsupported "$label: [dict get $fields gate_failed]"
+	return
+    }
+
+    set reqs [expr {[dict exists $fields requires] ? [dict get $fields requires] : ""}]
+    if { ![afdo_require $label $reqs] } { return }
+
+    set create [afdo_tool_locate]
+    if { $create eq "" } {
+	unsupported "$label: afdo_create not found (set \$AFDO_CREATE or add to PATH)"
+	return
+    }
+
+    # Dispatch specialized pipelines early.
+    if { $entry eq "merge" } {
+	afdo_run_merge_instance $file $src $fields $label $stem $create
+	return
+    }
+    # live-negative: synthesized bad perf.data must be rejected cleanly.
+    if { $entry eq "live-negative" } {
+	afdo_run_negative_instance $file $fields $label $stem $create
+	return
+    }
+    # live-reject: strip variants must be rejected cleanly.
+    if { $entry eq "live-reject" } {
+	afdo_run_reject_instance $file $src $fields $label $stem $create
+	return
+    }
+    # live-parity: offline vs live profiles must share the same hot set.
+    if { $entry eq "live-parity" } {
+	afdo_run_live_parity_instance $file $src $fields $label $stem $create
+	return
+    }
+
+    # Split dg-afdo-create into dump flag (-m/-D) and extra create flags.
+    set dumpflag ""
+    set extra_create_flags {}
+    if { [dict exists $fields create] } {
+	foreach t [dict get $fields create] {
+	    if { $t eq "-m" || $t eq "-D" } { set dumpflag $t } else { lappend extra_create_flags $t }
+	}
+    }
+
+    set gcov "[pwd]/$label.gcov"
+    file delete -force $gcov
+
+    # $effsrc is resolved for auto; otherwise equals $src.
+    set effsrc $src
+
+    # Defaults for post-steps when entry is not live.
+    set cc ""
+    set opts "-O2 -g"
+
+    switch -- $entry {
+	live {
+	    if { [dict exists $fields gate] \
+		     && [dict get $fields gate] eq "profiling" \
+		     && ![afdo_profiling_available] } {
+		unsupported "$label: no AutoFDO profiling support on this target"
+		return
+	    }
+	    set cc [afdo_tool_compiler]
+	    if { $cc eq "" } {
+		unsupported "$label: no compiler under test"
+		return
+	    }
+
+	    set opts "-O2 -g"
+	    if { [dict exists $fields options] } { set opts [dict get $fields options] }
+	    set bin "[pwd]/$label.exe"
+	    set perfdata "[pwd]/$label.perf.data"
+
+	    set extra_srcs {}
+	    if { [dict exists $fields extra-src] } {
+		foreach s [dict get $fields extra-src] {
+		    lappend extra_srcs "$srcdir/$subdir/$s"
+		}
+	    }
+	    if { ![afdo_compile $label $cc $opts $file $bin $extra_srcs] } { return }
+	    # afdo_perf_record resolves auto into $effsrc.
+	    set systemwide [expr { [dict exists $fields system-wide] \
+					&& [dict get $fields system-wide] }]
+	    set companions 0
+	    if { [dict exists $fields companions] } {
+		set companions [dict get $fields companions]
+	    }
+	    if { ![afdo_perf_record $label $src $perfdata $bin effsrc {} \
+		       $systemwide $companions] } { return }
+	}
+	default {
+	    unresolved "$label: unsupported entry '$entry' in prototype"
+	    return
+	}
+    }
+
+    # Optional ASLR / system-wide checks before afdo_create.
+    if { [dict exists $fields aslr-verify] } {
+	if { ![afdo_verify_aslr $label $bin $perfdata] } { return }
+    }
+    if { [dict exists $fields system-wide-verify] } {
+	if { ![afdo_verify_system_wide $label $bin $perfdata] } { return }
+    }
+
+    set produced ""
+    if { $dumpflag eq "-m" } { set produced "[pwd]/$label.addr_map.txt" }
+    if { $dumpflag eq "-D" } { set produced "[pwd]/$label.addr_perf_freq.txt" }
+    if { $produced ne "" } { file delete -force $produced }
+
+    if { ![afdo_create_gcov $label $create $bin $perfdata $gcov \
+	       $effsrc $dumpflag $produced $extra_create_flags] } {
+	return
+    }
+
+    # post dump: render gcov for dump-tree validation.
+    set dumpout ""
+    if { [dict exists $fields post] \
+	     && [lsearch -exact [dict get $fields post] "dump"] >= 0 } {
+	if { ![afdo_dump_gcov $label $gcov dumpout] } { return }
+    }
+
+    # post recompile: accept -fauto-profile=<gcov> (live only).
+    if { [dict exists $fields post] \
+	     && [lsearch -exact [dict get $fields post] "recompile"] >= 0 } {
+	if { $entry ne "live" || $cc eq "" } {
+	    unsupported "$label: recompile post-step requires live entry"
+	} else {
+	    if { ![afdo_recompile_with_profile $label $cc $opts $file $gcov] } {
+		return
+	    }
+	}
+    }
+
+    # post opt-dump: recompile and scan opt-info / dump patterns (live only).
+    if { [dict exists $fields post] \
+	     && [lsearch -exact [dict get $fields post] "opt-dump"] >= 0 } {
+	if { $entry ne "live" || $cc eq "" } {
+	    unsupported "$label: opt-dump post-step requires live entry"
+	} else {
+	    afdo_recompile_opt_dump $label $cc $opts $file $gcov $fields
+	}
+    }
+
+    # dg-afdo-profile-driven-lto: WPA cross-TU inline check (live only).
+    if { [dict exists $fields profile-driven-lto] } {
+	if { $entry ne "live" || $cc eq "" } {
+	    unsupported "$label: lto-apply post-step requires live entry"
+	} else {
+	    set lto_srcs [list $file]
+	    if { [dict exists $fields extra-src] } {
+		foreach s [dict get $fields extra-src] {
+		    lappend lto_srcs "$srcdir/$subdir/$s"
+		}
+	    }
+	    afdo_recompile_lto_apply $label $cc $opts $lto_srcs $gcov \
+		[dict get $fields profile-driven-lto]
+	}
+    }
+
+    # dg-afdo-determinism-runs: re-run create; gcov must match modulo timestamp.
+    if { [dict exists $fields determinism-runs] } {
+	afdo_check_determinism $label $create $bin $perfdata $gcov $effsrc \
+	    [dict get $fields determinism-runs] $extra_create_flags
+    }
+
+    # Validate with $effsrc (resolved source for auto).
+    if { [dict exists $fields validate] } {
+	afdo_validate $label $stem $effsrc $fields $bin $produced $dumpout
+    }
+}
+
+# afdo_run_live_parity_instance -- offline vs live profiles; same hot set.
+proc afdo_run_live_parity_instance { file src fields label stem create } {
+    global srcdir subdir
+
+    if { [dict exists $fields gate] \
+	     && [dict get $fields gate] eq "profiling" \
+	     && ![afdo_profiling_available] } {
+	unsupported "$label: no AutoFDO profiling support on this target"
+	return
+    }
+    if { ![afdo_host_live_branch_stack_supported] } {
+	unsupported "$label: host lacks LBR/BRBE support for live profiling"
+	return
+    }
+    set cc [afdo_tool_compiler]
+    if { $cc eq "" } {
+	unsupported "$label: no compiler under test"
+	return
+    }
+    set opts "-O2 -g"
+    if { [dict exists $fields options] } { set opts [dict get $fields options] }
+
+    set bin "[pwd]/$label.exe"
+    if { ![afdo_compile $label $cc $opts $file $bin] } { return }
+
+    # Offline half: perf record then afdo_create -p.
+    set perfdata "[pwd]/$label.offline.perf.data"
+    set effsrc $src
+    if { ![afdo_perf_record $label $src $perfdata $bin effsrc] } { return }
+    # ip has no branch stack; branch-stack sources use their default mode
+    # (afdo_create_gcov adds -s for spe via afdo_source_mode_args).
+    set off_extra {}
+    if { $effsrc eq "ip" } { set off_extra [list --no-branch-stack] }
+    set off_gcov "[pwd]/$label.offline.gcov"
+    if { ![afdo_create_gcov $label $create $bin $perfdata $off_gcov \
+	       $effsrc "" "" $off_extra] } { return }
+    if { ![afdo_dump_gcov "$label.offline" $off_gcov off_dump] } { return }
+    lassign [afdo_dumptree_has_hot $off_dump $fields] off_ok off_out
+    if { !$off_ok } {
+	fail "$label: offline profile missing expected hot function(s):\n$off_out"
+	return
+    }
+    pass "$label: offline profile has expected hot function(s)"
+
+    # Live half: afdo_create self-profiles the binary.
+    set live_gcov "[pwd]/$label.live.gcov"
+    if { ![afdo_create_live $create $bin $live_gcov live_out] } {
+	if { [afdo_live_branch_stack_unsupported $live_out] } {
+	    unsupported "$label: host kernel lacks branch-stack support for live profiling"
+	    return
+	}
+	fail "$label: live PMU profiling produced no profile\
+	      (afdo_create live mode; see afdo_tools bug #5): $live_out"
+	return
+    }
+    pass "$label: afdo_create live PMU mode"
+    if { ![afdo_dump_gcov "$label.live" $live_gcov live_dump] } { return }
+    lassign [afdo_dumptree_has_hot $live_dump $fields] live_ok live_out2
+    if { !$live_ok } {
+	fail "$label: live profile missing expected hot function(s):\n$live_out2"
+	return
+    }
+    pass "$label: live profile has expected hot function(s)"
+
+    # Both halves already checked; report parity.
+    pass "$label: live/offline parity on hot function set"
+}
+
+# afdo_run_merge_instance -- multi-workload create + afdo_merge pipeline.
+proc afdo_run_merge_instance { file src fields label stem create } {
+    global srcdir subdir
+
+    # Same AutoFDO gate as live entries.
+    if { [dict exists $fields gate] \
+	     && [dict get $fields gate] eq "profiling" \
+	     && ![afdo_profiling_available] } {
+	unsupported "$label: no AutoFDO profiling support on this target"
+	return
+    }
+    set cc [afdo_tool_compiler]
+    if { $cc eq "" } {
+	unsupported "$label: no compiler under test"
+	return
+    }
+
+    set opts "-O2 -g"
+    if { [dict exists $fields options] } { set opts [dict get $fields options] }
+
+    # Merge entries require dg-afdo-workloads.
+    if { ![dict exists $fields workloads] } {
+	unresolved "$label: merge entry requires dg-afdo-workloads"
+	return
+    }
+    set workloads [dict get $fields workloads]
+
+    # Locate afdo_merge.
+    set amerge [afdo_tool_merge]
+    if { $amerge eq "" } {
+	unsupported "$label: afdo_merge not found (set \$AFDO_MERGE or add to PATH)"
+	return
+    }
+
+    # Optional DSO / per-workload-driver directives.
+    set dso_srcs {}
+    set use_dsos 0
+    if { [dict exists $fields workload-dsos] } {
+	set dso_srcs [dict get $fields workload-dsos]
+	if { [llength $dso_srcs] != [llength $workloads] } {
+	    unresolved \
+		"$label: dg-afdo-workload-dsos count ([llength $dso_srcs])\
+		 must equal dg-afdo-workloads count ([llength $workloads])"
+	    return
+	}
+	set use_dsos 1
+    }
+
+    set drv_srcs {}
+    set use_indep_drivers 0
+    if { [dict exists $fields workload-drivers] } {
+	if { !$use_dsos } {
+	    unresolved "$label: dg-afdo-workload-drivers requires dg-afdo-workload-dsos"
+	    return
+	}
+	set drv_srcs [dict get $fields workload-drivers]
+	if { [llength $drv_srcs] != [llength $workloads] } {
+	    unresolved \
+		"$label: dg-afdo-workload-drivers count ([llength $drv_srcs])\
+		 must equal dg-afdo-workloads count ([llength $workloads])"
+	    return
+	}
+	set use_indep_drivers 1
+    }
+
+    # Compile DSOs before any driver is linked.
+    if { $use_dsos } {
+	for {set i 0} {$i < [llength $workloads]} {incr i} {
+	    set wl [lindex $workloads $i]
+	    set dso_src [lindex $dso_srcs $i]
+	    set dso_so "[pwd]/$label.$wl.so"
+	    if { ![afdo_compile_dso "$label.$wl" $dso_src $dso_so] } { return }
+	}
+    }
+
+    # Compile drivers: independent, shared, or single-binary.
+    set bin ""
+    if { $use_indep_drivers } {
+	# Independent driver: link only this workload's DSO.
+	for {set i 0} {$i < [llength $workloads]} {incr i} {
+	    set wl [lindex $workloads $i]
+	    set drv_src "$srcdir/$subdir/[lindex $drv_srcs $i]"
+	    set drv_bin "[pwd]/$label.$wl.driver.exe"
+	    set lflags [list "-L[pwd]" "-Wl,-rpath,[pwd]" "-l:$label.$wl.so"]
+	    if { ![file exists $drv_src] } {
+		unresolved "$label.$wl: driver source not found: $drv_src"
+		return
+	    }
+	    if { ![afdo_compile "$label.$wl driver" $cc \
+		       [concat $opts $lflags] $drv_src $drv_bin] } { return }
+	}
+	# Placeholder $bin for validate; merge-dump-tree does not use it.
+	set bin "[pwd]/$label.[lindex $workloads 0].driver.exe"
+    } elseif { $use_dsos } {
+	# Shared driver links all DSOs; workload selected by argv[1].
+	set lflags [list "-L[pwd]" "-Wl,-rpath,[pwd]"]
+	foreach wl $workloads {
+	    lappend lflags "-l:$label.$wl.so"
+	}
+	set bin "[pwd]/$label.exe"
+	if { ![afdo_compile $label $cc [concat $opts $lflags] $file $bin] } { return }
+    } else {
+	# Single binary, no DSOs.
+	set bin "[pwd]/$label.exe"
+	if { ![afdo_compile $label $cc $opts $file $bin] } { return }
+    }
+
+    # Per-workload: perf record + afdo_create.
+    set gcov_inputs {}
+    set effsrc $src
+    for {set i 0} {$i < [llength $workloads]} {incr i} {
+	set wl [lindex $workloads $i]
+	set wl_label "$label.$wl"
+	set wl_perfdata "[pwd]/$wl_label.perf.data"
+	set wl_gcov "[pwd]/$wl_label.gcov"
+	file delete -force $wl_perfdata $wl_gcov
+
+	# Independent drivers take no args; shared binary gets argv[1]=workload.
+	if { $use_indep_drivers } {
+	    set run_bin "[pwd]/$label.$wl.driver.exe"
+	    set binargs {}
+	} else {
+	    set run_bin $bin
+	    set binargs [list $wl]
+	}
+
+	if { ![afdo_perf_record $wl_label $src $wl_perfdata $run_bin effsrc \
+		   $binargs] } { return }
+
+	set create_bin [expr {$use_dsos ? "[pwd]/$label.$wl.so" : $run_bin}]
+	if { ![afdo_create_gcov $wl_label $create $create_bin $wl_perfdata \
+		   $wl_gcov $effsrc "" ""] } { return }
+	lappend gcov_inputs $wl_gcov
+    }
+
+    # Merge workload profiles into one gcov.
+    set gcov "[pwd]/$label.merged.gcov"
+    file delete -force $gcov
+    set mcmd [concat [list $amerge] $gcov_inputs [list -o $gcov]]
+    verbose "Running $mcmd" 1
+    if { [catch { eval exec $mcmd 2>@1 } out] || ![file exists $gcov] } {
+	fail "$label: afdo_merge failed: $out"
+	return
+    }
+    pass "$label: afdo_merge"
+
+    # post dump.
+    set dumpout ""
+    if { [dict exists $fields post] \
+	     && [lsearch -exact [dict get $fields post] "dump"] >= 0 } {
+	if { ![afdo_dump_gcov $label $gcov dumpout] } { return }
+    }
+
+    # post recompile: skip for DSO-workload merges.
+    if { [dict exists $fields post] \
+	     && [lsearch -exact [dict get $fields post] "recompile"] >= 0 } {
+	if { $use_dsos } {
+	    unsupported "$label: recompile post-step not supported for DSO workloads"
+	} elseif { ![afdo_recompile_with_profile $label $cc $opts $file $gcov] } {
+	    return
+	}
+    }
+
+    # Validate merged profile.
+    if { [dict exists $fields validate] } {
+	afdo_validate $label $stem $effsrc $fields $bin "" $dumpout
+    }
+}
+
+# afdo_run_negative_instance -- synthesized bad perf.data must be rejected.
+proc afdo_run_negative_instance { file fields label stem create } {
+    set cc [afdo_tool_compiler]
+    if { $cc eq "" } {
+	unsupported "$label: no compiler under test"
+	return
+    }
+
+    set opts "-O2 -g"
+    if { [dict exists $fields options] } { set opts [dict get $fields options] }
+    set bin "[pwd]/$label.exe"
+    if { ![afdo_compile $label $cc $opts $file $bin] } { return }
+
+    if { ![dict exists $fields invalid-perf] } {
+	unresolved "$label: live-negative entry requires dg-afdo-invalid-perf"
+	return
+    }
+    set kind [dict get $fields invalid-perf]
+    set perfdata "[pwd]/$label.perf.data"
+    file delete -force $perfdata
+    switch -- $kind {
+	empty {
+	    set fh [open $perfdata w]
+	    close $fh
+	}
+	corrupt {
+	    set fh [open $perfdata w]
+	    fconfigure $fh -translation binary
+	    puts -nonewline $fh \
+		"PERFILE2\x00\xde\xad\xbe\xefnot a real perf.data payload -- garbage bytes"
+	    close $fh
+	}
+	default {
+	    unresolved "$label: unknown dg-afdo-invalid-perf kind '$kind'"
+	    return
+	}
+    }
+    pass "$label: synthesized $kind perf.data"
+
+    set gcov "[pwd]/$label.gcov"
+    file delete -force $gcov
+    set ccmd [concat [list $create] [list -b $bin -p $perfdata -o $gcov]]
+    verbose "Running $ccmd" 1
+    set rc [catch { eval exec $ccmd 2>@1 } out]
+    set errcode {}
+    if { $rc != 0 } { set errcode $::errorCode }
+
+    if { [lindex $errcode 0] eq "CHILDKILLED" } {
+	fail "$label: afdo_create crashed on $kind perf.data instead of\
+	      exiting cleanly: $out"
+	return
+    }
+    if { $rc == 0 } {
+	fail "$label: afdo_create unexpectedly succeeded on $kind perf.data"
+	return
+    }
+    if { [file exists $gcov] && [file size $gcov] > 0 } {
+	fail "$label: afdo_create produced a non-empty gcov from $kind perf.data"
+	return
+    }
+    pass "$label: afdo_create rejected $kind perf.data cleanly\
+	  (rc!=0, no crash, no gcov)"
+}
+
+# afdo_run_reject_instance -- strip variants must be rejected cleanly.
+proc afdo_run_reject_instance { file src fields label stem create } {
+    if { [dict exists $fields gate] \
+	     && [dict get $fields gate] eq "profiling" \
+	     && ![afdo_profiling_available] } {
+	unsupported "$label: no AutoFDO profiling support on this target"
+	return
+    }
+    set cc [afdo_tool_compiler]
+    if { $cc eq "" } {
+	unsupported "$label: no compiler under test"
+	return
+    }
+
+    if { ![dict exists $fields strip-variants] } {
+	unresolved "$label: live-reject entry requires dg-afdo-strip-variants"
+	return
+    }
+    set variants [dict get $fields strip-variants]
+
+    # dg-options carries the base (release) flags WITHOUT -g; the strip-* variants
+    # add -g themselves so there is debug info to strip.
+    set base_opts "-O2"
+    if { [dict exists $fields options] } { set base_opts [dict get $fields options] }
+    set strip [afdo_tool_find strip]
+
+    foreach variant $variants {
+	set vlabel "$label.$variant"
+	set bin "[pwd]/$vlabel.exe"
+	file delete -force $bin
+
+	switch -- $variant {
+	    no-g {
+		if { ![afdo_compile $vlabel $cc $base_opts $file $bin] } { return }
+	    }
+	    strip-debug - strip-all {
+		if { $strip eq "" } {
+		    unsupported "$vlabel: strip not in PATH"
+		    continue
+		}
+		if { ![afdo_compile $vlabel $cc [concat $base_opts -g] $file $bin] } {
+		    return
+		}
+		set sflag [expr {$variant eq "strip-debug" ? "--strip-debug" \
+				     : "--strip-all"}]
+		afdo_echo_cmd strip "$strip $sflag $bin"
+		if { [catch { exec $strip $sflag $bin 2>@1 } sout] } {
+		    fail "$vlabel: strip $sflag failed: $sout"
+		    continue
+		}
+		pass "$vlabel: strip $sflag"
+	    }
+	    default {
+		unresolved "$vlabel: unknown strip variant '$variant'"
+		continue
+	    }
+	}
+
+	set perfdata "[pwd]/$vlabel.perf.data"
+	set effsrc $src
+	if { ![afdo_perf_record $vlabel $src $perfdata $bin effsrc] } { continue }
+
+	set gcov "[pwd]/$vlabel.gcov"
+	file delete -force $gcov
+	afdo_assert_clean_reject $vlabel $create $bin $perfdata $gcov $effsrc \
+	    "$variant binary (no usable DWARF)"
+    }
+}
+
+# afdo_assert_clean_reject -- non-zero exit, no crash, no gcov, with diagnostic.
+# LABEL is the DejaGnu test name.  WHAT describes the reject case.
+proc afdo_assert_clean_reject { label create bin perfdata gcov effsrc what {extra_flags {}} } {
+    set modeargs [afdo_source_mode_args $effsrc]
+    set ccmd [concat [list $create] $modeargs $extra_flags [list -b $bin -p $perfdata -o $gcov]]
+    afdo_echo_cmd afdo_create $ccmd
+    set rc [catch { eval exec $ccmd 2>@1 } out]
+    set errcode {}
+    if { $rc != 0 } { set errcode $::errorCode }
+
+    if { [lindex $errcode 0] eq "CHILDKILLED" } {
+	fail "$label: afdo_create crashed on $what instead of exiting cleanly: $out"
+	return
+    }
+    if { $rc == 0 } {
+	fail "$label: afdo_create unexpectedly succeeded on $what\
+	      (silent empty profile?)"
+	return
+    }
+    if { [file exists $gcov] && [file size $gcov] > 0 } {
+	fail "$label: afdo_create produced a non-empty gcov from $what"
+	return
+    }
+    if { ![regexp {(?i)error|fail|cannot|unable|no such|invalid} $out] } {
+	fail "$label: afdo_create exited non-zero on $what but printed no\
+	      diagnostic (silent failure): $out"
+	return
+    }
+    pass "$label: afdo_create rejected $what cleanly\
+	  (rc!=0, no crash, no gcov, diagnostic)"
+}
