+/* afdo_create ? build an AutoFDO profile from a binary plus perf samples.  */
+
+namespace {
+
+struct program_options
+{
+  std::string perf_data_file;
+  std::string binary_file;
+  std::string output_file;
+  autofdo::profiler_run_options run;
+  perf_data::sampling_mode sampling_mode
+    = perf_data::sampling_mode::BRANCH_STACK;
+  bool print_help = false;
+  bool print_version = false;
+};
+
+static void
+absolute_binary_path (program_options &options)
+{
+  char *resolved = realpath (options.binary_file.c_str (), nullptr);
+  if (resolved == nullptr)
+    return;
+  options.binary_file.assign (resolved);
+  free (resolved);
+}
+
+static void
+print_usage (const char *program_name)
+{
+  // clang-format off
+  printf (
+    "Usage:\n"
+    "  %s -p <perf.data> -b <binary> -o <output> [OPTIONS]\n\n"
+    "  -b, --binary FILE        Binary with DWARF (and command to run)\n"
+    "  -o, --output FILE        Output profile path\n"
+    "  --                       Separator; following args are the command\n\n"
+    "Perf.data mode (optional): build profile from existing perf.data.\n"
+    "  -p, --perf FILE          Path to perf.data (branch-stack: x86 LBR, ARM BRBE)\n"
+    "  -b, --binary FILE        Binary with DWARF\n"
+    "  -o, --output FILE        Output profile path\n\n"
+    "Profile options:\n"
+    "      --sample-threshold-frac F  Skip below F * total profile mass\n"
+    "                           (create_gcov --sample_threshold_frac;\n"
+    "                           default 0 = MIN_SAMPLES_FOR_GCOV_EMIT floor only).\n"
+    "  -j, --jobs N             Parallel DWARF parse + correlate threads\n"
+    "                           (default 8).\n"
+    "      --no-branch-stack    Per-PC counts only (create_gcov use_branch_stack=false).\n"
+    "      --no-lbr             Alias for --no-branch-stack.\n"
+    "                           Default: branch-stack range expansion.\n\n"
+    "Validation:\n"
+    "  -m, --dump-addr-mapping FILE\n"
+    "                           One line per correlated PC: file offset, STT_FUNC\n"
+    "                           name, file:line:discriminator, inline stack.\n"
+    "  -D, --dump-perf-maps FILE\n"
+    "                           After perf load, dump address_count, range_count,\n"
+    "                           and branch_count maps (file offsets).\n\n"
+    "General:\n"
+    "  -h, --help               Show this help\n"
+    "  --version                Show version\n\n"
+    "create_gcov compatibility options:\n"
+    "  --gcov FILE              Output GCOV file\n"
+    "  --profile FILE           Path to perf.data\n",
+    program_name);
+  // clang-format on
+}
+
+static void
+print_version ()
+{
+  printf ("afdo_create version %s\n", __VERSION__);
+  printf ("AutoFDO profile generator for GCC\n");
+}
+
+static bool
+parse_arguments (int argc, char *argv[], program_options &options)
+{
+  static option long_options[]
+    = {{"perf", required_argument, nullptr, 'p'},
+       {"binary", required_argument, nullptr, 'b'},
+       {"output", required_argument, nullptr, 'o'},
+       {"dump-addr-mapping", required_argument, nullptr, 'm'},
+       {"dump-perf-maps", required_argument, nullptr, 'D'},
+       {"no-branch-stack", no_argument, nullptr, 'L'},
+       {"no-lbr", no_argument, nullptr, 'L'},
+       {"gcov", required_argument, nullptr, 0},
+       {"profile", required_argument, nullptr, 0},
+       {"sample-threshold-frac", required_argument, nullptr, 'F'},
+       {"jobs", required_argument, nullptr, 'j'},
+       {"help", no_argument, nullptr, 'h'},
+       {"version", no_argument, nullptr, 'v'},
+       {nullptr, 0, nullptr, 0}};
+
+  int c;
+  int option_index = 0;
+
+  /* create_gcov and SPEC pass long options with one dash.  */
+  while ((c = getopt_long_only (
+	    argc, argv, "p:b:o:m:D:LF:j:hv", long_options, &option_index))
+	 != -1)
+    {
+      switch (c)
+	{
+	case 'p':
+	  options.perf_data_file = optarg;
+	  break;
+	case 'b':
+	  options.binary_file = optarg;
+	  break;
+	case 'o':
+	  options.output_file = optarg;
+	  break;
+	case 'm':
+	  options.run.dump_address_mapping = optarg;
+	  break;
+	case 'D':
+	  options.run.dump_perf_maps = optarg;
+	  break;
+	case 'F':
+	  {
+	    char *end = nullptr;
+	    const double v = std::strtod (optarg, &end);
+	    if (end == optarg || v < 0.0)
+	      {
+		fprintf (
+		  stderr, "Invalid --sample-threshold-frac: %s\n", optarg);
+		return false;
+	      }
+	    options.run.sample_threshold_frac = v;
+	  }
+	  break;
+	case 'j':
+	  {
+	    char *end = nullptr;
+	    const long n = std::strtol (optarg, &end, 10);
+	    if (end == optarg || n < 1)
+	      {
+		fprintf (
+		  stderr, "Invalid -j/--jobs (need N >= 1): %s\n", optarg);
+		return false;
+	      }
+	    options.run.correlate_threads = static_cast<unsigned> (n);
+	  }
+	  break;
+	case 'L':
+	  options.run.use_branch_stack = false;
+	  break;
+	case 'v':
+	  options.print_version = true;
+	  return false;
+	case 'h':
+	  options.print_help = true;
+	  return false;
+	case '?':
+	  fprintf (stderr, "Try '%s --help' for more information.\n", argv[0]);
+	  return false;
+	default:
+	  if (c != 0)
+	    return false;
+
+	  if (!strcmp (long_options[option_index].name, "profile"))
+	    options.perf_data_file = optarg;
+	  else if (!strcmp (long_options[option_index].name, "gcov"))
+	    options.output_file = optarg;
+	}
+    }
+
+  if (options.binary_file.empty ())
+    {
+      fprintf (stderr, "Error: binary is required (-b option)\n");
+      return false;
+    }
+  if (options.output_file.empty ())
+    {
+      fprintf (stderr, "Error: output is required (-o option)\n");
+      return false;
+    }
+  if (options.perf_data_file.empty ())
+    {
+      fprintf (stderr, "Error: perf.data is required (-p option)\n");
+      return false;
+    }
+
+  return true;
+}
