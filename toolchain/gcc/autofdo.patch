+/* AutoFDO v4 on-disk format constants.  */
+namespace v4 {
+
+/* GCOV file format constants.  */
+struct format
+{
+  enum : uint32_t
+  {
+    GCOV_MAGIC = 0x67636F76, /* "gcov" */
+    GCOV_VERSION = 4
+  };
+};
+
+/* Section types.  */
+enum section_type : uint8_t
+{
+  SECTION_STRING_TABLE = 0x01,
+  SECTION_SUMMARY_INFO = 0x02,
+  SECTION_FILE_NAMES = 0x03,
+  SECTION_SYMBOL_NAMES = 0x04,
+  SECTION_SYMBOL_INFO = 0x05,
+  SECTION_INLINE_INDEX_TABLE = 0x06,
+  SECTION_INLINE_INDICES = 0x07,
+  /* Bit 7: the section body uses compact (varint) encoding.  */
+  SECTION_COMPACT_FLAG = 0x80,
+};
+
+/* Location types (bits 0-6 of the location bitmask).  */
+enum location_kind : uint8_t
+{
+  LOCATION_ZERO = 0x01,
+  LOCATION_NORMAL = 0x02,
+  LOCATION_WIDE = 0x03,
+  LOCATION_CALLED_FN = 0x04,
+  LOCATION_CALLED_FNS = 0x05,
+  LOCATION_INLINED_FN = 0x06,
+  /* Bit 7: a discriminator word follows the line offset.  */
+  LOCATION_DISC_FLAG = 0x80,
+};
+
+} /* namespace v4.  */
 } /* namespace gcov.  */
 
 #endif /* GCC_GCOV_H.  */
diff --git a/afdo_tools/src/gcov_io.cc b/afdo_tools/src/gcov_io.cc
index 7f6dd656f1c..e907b23963a 100644
--- a/afdo_tools/src/gcov_io.cc
+++ b/afdo_tools/src/gcov_io.cc
@@ -82,4 +82,244 @@ gcov_read_string (const uint8_t *&cur, const uint8_t *end, std::string &out)
   return true;
 }
 
+namespace v4 {
+
+static bool g_decode_failed = false;
+static const char *g_decode_msg = "";
+
+void
+clear_decode_error ()
+{
+  g_decode_failed = false;
+  g_decode_msg = "";
+}
+
+void
+set_decode_error (const char *msg)
+{
+  /* Keep only the first error as cascading failures are less informative.  */
+  if (g_decode_failed)
+    return;
+  g_decode_failed = true;
+  g_decode_msg = msg;
+}
+
+bool
+decode_failed ()
+{
+  return g_decode_failed;
+}
+
+const char *
+decode_message ()
+{
+  return g_decode_msg;
+}
+
+void
+write_be8 (std::vector<uint8_t> &buf, uint8_t value)
+{
+  buf.push_back (value);
+}
+
+/* Append the low NBYTES of VALUE in big-endian form.  */
+static inline void
+write_be_bytes (std::vector<uint8_t> &buf, uint64_t value, unsigned nbytes)
+{
+  for (unsigned i = nbytes; i-- > 0;)
+    buf.push_back ((value >> (i * 8)) & 0xFF);
+}
+
+void
+write_be16 (std::vector<uint8_t> &buf, uint16_t value)
+{
+  write_be_bytes (buf, value, 2);
+}
+
+void
+write_be32 (std::vector<uint8_t> &buf, uint32_t value)
+{
+  write_be_bytes (buf, value, 4);
+}
+
+void
+write_be56 (std::vector<uint8_t> &buf, uint64_t value)
+{
+  write_be_bytes (buf, value, 7);
+}
+
+void
+write_be64 (std::vector<uint8_t> &buf, uint64_t value)
+{
+  write_be_bytes (buf, value, 8);
+}
+
+void
+write_varint (std::vector<uint8_t> &buf, uint64_t value)
+{
+  do
+    {
+      uint8_t byte = static_cast<uint8_t> (value & 0x7F);
+      value >>= 7;
+      if (value)
+	byte = static_cast<uint8_t> (byte | 0x80);
+      buf.push_back (byte);
+    }
+  while (value);
+}
+
+void
+write_str (std::vector<uint8_t> &buf, const std::string &str, bool compact)
+{
+  const uint32_t len
+    = static_cast<uint32_t> (str.size () + 1); /* Include NUL.  */
+  write_int32 (buf, len, compact);
+  buf.insert (buf.end (), str.begin (), str.end ());
+  buf.push_back ('\0');
+}
+
+void
+write_line_offset (std::vector<uint8_t> &buf, uint32_t value, bool compact)
+{
+  if (compact)
+    write_varint (buf, value);
+  else
+    write_be_bytes (buf, value, 3);
+}
+
+void
+write_int (std::vector<uint8_t> &buf, uint64_t value, bool compact)
+{
+  if (compact)
+    write_varint (buf, value);
+  else
+    write_be64 (buf, value);
+}
+
+void
+write_int32 (std::vector<uint8_t> &buf, uint32_t value, bool compact)
+{
+  if (compact)
+    write_varint (buf, value);
+  else
+    write_be32 (buf, value);
+}
+
+uint8_t
+read_be8 (const uint8_t *&cur, const uint8_t *end)
+{
+  if (cur + 1 > end)
+    {
+      set_decode_error ("v4: truncated uint8");
+      return 0;
+    }
+  return *cur++;
+}
+
+/* Read the low NBYTES as a big-endian value, advancing CUR.  On truncation
+   record the decode error and return 0.  */
+static inline uint64_t
+read_be_bytes (const uint8_t *&cur, const uint8_t *end, unsigned nbytes)
+{
+  if (cur + nbytes > end)
+    {
+      set_decode_error ("v4: truncated big-endian value");
+      return 0;
+    }
+  uint64_t val = 0;
+  for (unsigned i = 0; i < nbytes; i++)
+    val = (val << 8) | *cur++;
+  return val;
+}
+
+uint16_t
+read_be16 (const uint8_t *&cur, const uint8_t *end)
+{
+  return static_cast<uint16_t> (read_be_bytes (cur, end, 2));
+}
+
+uint32_t
+read_be32 (const uint8_t *&cur, const uint8_t *end)
+{
+  return static_cast<uint32_t> (read_be_bytes (cur, end, 4));
+}
+
+uint64_t
+read_be56 (const uint8_t *&cur, const uint8_t *end)
+{
+  return read_be_bytes (cur, end, 7);
+}
+
+uint64_t
+read_be64 (const uint8_t *&cur, const uint8_t *end)
+{
+  return read_be_bytes (cur, end, 8);
+}
+
+uint64_t
+read_varint (const uint8_t *&cur, const uint8_t *end)
+{
+  uint64_t result = 0;
+  unsigned shift = 0;
+  while (cur < end)
+    {
+      uint8_t byte = *cur++;
+      result |= uint64_t (byte & 0x7F) << shift;
+      if ((byte & 0x80) == 0)
+	return result;
+      shift += 7;
+      if (shift >= 64)
+	{
+	  set_decode_error ("v4: varint too long");
+	  return result;
+	}
+    }
+  set_decode_error ("v4: truncated varint");
+  return result;
+}
+
+uint64_t
+read_wide_int (const uint8_t *&cur, const uint8_t *end, bool compact)
+{
+  return compact ? read_varint (cur, end) : read_be64 (cur, end);
+}
+
+uint32_t
+read_int32 (const uint8_t *&cur, const uint8_t *end, bool compact)
+{
+  return compact ? static_cast<uint32_t> (read_varint (cur, end))
+		 : read_be32 (cur, end);
+}
+
+uint16_t
+read_disc (const uint8_t *&cur, const uint8_t *end, bool compact)
+{
+  return compact ? static_cast<uint16_t> (read_varint (cur, end))
+		 : read_be16 (cur, end);
+}
+
+uint32_t
+read_line_offset (const uint8_t *&cur, const uint8_t *end, bool compact)
+{
+  if (compact)
+    return static_cast<uint32_t> (read_varint (cur, end));
+  return static_cast<uint32_t> (read_be_bytes (cur, end, 3));
+}
+
+std::string
+read_str (const uint8_t *&cur, const uint8_t *end, bool compact)
+{
+  uint32_t len = read_int32 (cur, end, compact);
+  if (len == 0)
+    return "";
+  if (len > (uint32_t) (end - cur))
+    {
+      set_decode_error ("v4: string past end of buffer");
+      return "";
+    }
+  std::string result (reinterpret_cast<const char *> (cur), len - 1);
+  cur += len;
+  return result;
+}
+} /* namespace v4.  */
 } /* namespace gcov.  */
