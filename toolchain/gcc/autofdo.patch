index 00000000000..a6782c59940
--- /dev/null
+++ b/afdo_tools/src/perf_event_sample_util.cc
@@ -0,0 +1,371 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "perf_event_sample_util.h"
+
+#include <climits>
+
+namespace perf_data {
+namespace perf_event_sample_util {
+namespace {
+
+constexpr size_t READ_GROUP_BYTES_PER_EVENT = 2 * sizeof (uint64_t);
+constexpr size_t READ_GROUP_BYTES_PER_EVENT_WITH_LOST = 3 * sizeof (uint64_t);
+
+inline int
+popcount64 (uint64_t x)
+{
+  return __builtin_popcountll (x);
+}
+
+size_t
+sample_read_value_bytes (uint64_t rf)
+{
+  if (rf & perf_read_format::LOST)
+    return READ_GROUP_BYTES_PER_EVENT_WITH_LOST;
+  return READ_GROUP_BYTES_PER_EVENT;
+}
+
+bool
+bytes_available (const uint8_t *ptr, const uint8_t *end,
+		 uint64_t bytes) noexcept
+{
+  return ptr <= end && bytes <= static_cast<uint64_t> (end - ptr);
+}
+
+bool
+skip_sample_read (const uint8_t *&ptr, const uint8_t *end, uint64_t rf)
+{
+  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+    return false;
+  uint64_t first = read_u64 (ptr);
+  ptr += sizeof (uint64_t);
+  if (rf & perf_read_format::TOTAL_TIME_ENABLED)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (rf & perf_read_format::TOTAL_TIME_RUNNING)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (rf & perf_read_format::GROUP)
+    {
+      const uint64_t nr = first;
+      const size_t vb = sample_read_value_bytes (rf);
+      if (nr > SIZE_MAX / vb)
+	return false;
+      const size_t sz = static_cast<size_t> (nr) * vb;
+      if (!bytes_available (ptr, end, sz))
+	return false;
+      ptr += sz;
+    }
+  else
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+      if (rf & perf_read_format::LOST)
+	{
+	  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	    return false;
+	  ptr += sizeof (uint64_t);
+	}
+    }
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+bool
+walk_sample_before_branch (const uint8_t *&ptr, const uint8_t *end,
+			   uint64_t sample_ty, uint64_t read_format,
+			   uint64_t *out_ip, bool *out_have_ip,
+			   uint64_t *out_period, uint64_t *out_time)
+{
+  uint64_t ip = 0;
+  uint64_t period = 0;
+  uint64_t time = 0;
+  bool have_ip = false;
+  if (out_ip)
+    *out_ip = 0;
+  if (out_have_ip)
+    *out_have_ip = false;
+  if (out_period)
+    *out_period = period;
+  if (out_time)
+    *out_time = 0;
+
+  if (sample_ty & perf_sample_type::IDENTIFIER)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::IP)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ip = read_u64 (ptr);
+      have_ip = true;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::TID)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::TIME)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      time = read_u64 (ptr);
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::ADDR)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::ID)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::STREAM_ID)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::CPU)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::PERIOD)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      period = read_u64 (ptr);
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::READ)
+    {
+      if (!skip_sample_read (ptr, end, read_format))
+	return false;
+    }
+  if (sample_ty & perf_sample_type::CALLCHAIN)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t nr = read_u64 (ptr);
+      ptr += sizeof (uint64_t);
+      if (nr > SIZE_MAX / sizeof (uint64_t))
+	return false;
+      const size_t sz = static_cast<size_t> (nr) * sizeof (uint64_t);
+      if (!bytes_available (ptr, end, sz))
+	return false;
+      ptr += sz;
+    }
+  if (sample_ty & perf_sample_type::RAW)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint32_t)))
+	return false;
+      uint32_t raw_size = read_u32 (ptr);
+      ptr += sizeof (uint32_t);
+      if (!bytes_available (ptr, end, raw_size))
+	return false;
+      ptr += raw_size;
+    }
+
+  if (out_ip)
+    *out_ip = ip;
+  if (out_have_ip)
+    *out_have_ip = have_ip;
+  if (out_period)
+    *out_period = period;
+  if (out_time)
+    *out_time = time;
+  return true;
+}
+
+bool
+walk_sample_branch_stack (const uint8_t *&ptr, const uint8_t *end,
+			  uint64_t branch_sample_type, uint64_t sample_ty,
+			  uint64_t *out_nr,
+			  const perf_branch_stack_entry **out_entries)
+{
+  if (!(sample_ty & perf_sample_type::BRANCH_STACK))
+    {
+      if (out_nr)
+	*out_nr = 0;
+      if (out_entries)
+	*out_entries = nullptr;
+      return true;
+    }
+  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+    return false;
+  uint64_t nr = read_u64 (ptr);
+  ptr += sizeof (uint64_t);
+  if (branch_sample_type & perf_branch_stack_format::HW_INDEX)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (nr > SIZE_MAX / BRANCH_ENTRY_BYTES)
+    return false;
+  const size_t esz = static_cast<size_t> (nr) * BRANCH_ENTRY_BYTES;
+  if (!bytes_available (ptr, end, esz))
+    return false;
+  const perf_branch_stack_entry *entries
+    = nr > 0 ? reinterpret_cast<const perf_branch_stack_entry *> (ptr)
+	     : nullptr;
+  ptr += esz;
+  if (branch_sample_type & perf_branch_stack_format::COUNTERS)
+    {
+      if (nr > SIZE_MAX / sizeof (uint64_t))
+	return false;
+      const size_t csz = static_cast<size_t> (nr) * sizeof (uint64_t);
+      if (!bytes_available (ptr, end, csz))
+	return false;
+      ptr += csz;
+    }
+  if (out_nr)
+    *out_nr = nr;
+  if (out_entries)
+    *out_entries = entries;
+  return true;
+}
+
+bool
+walk_sample_after_branch (const uint8_t *&ptr, const uint8_t *end,
+			  uint64_t sample_ty, uint64_t sample_regs_user,
+			  uint64_t sample_regs_intr)
+{
+  if (sample_ty & perf_sample_type::REGS_USER)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t abi = read_u64 (ptr);
+      ptr += sizeof (uint64_t);
+      if (abi != 0)
+	{
+	  const size_t rsz = static_cast<size_t> (popcount64 (sample_regs_user))
+			     * sizeof (uint64_t);
+	  if (!bytes_available (ptr, end, rsz))
+	    return false;
+	  ptr += rsz;
+	}
+    }
+  if (sample_ty & perf_sample_type::STACK_USER)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t stack_sz = read_u64 (ptr);
+      ptr += sizeof (uint64_t);
+      if (stack_sz != 0)
+	{
+	  if (!bytes_available (ptr, end, stack_sz))
+	    return false;
+	  ptr += static_cast<size_t> (stack_sz);
+	  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	    return false;
+	  ptr += sizeof (uint64_t);
+	}
+    }
+  if (sample_ty & perf_sample_type::WEIGHT_TYPE)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::DATA_SRC)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::TRANSACTION)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::REGS_INTR)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t abi = read_u64 (ptr);
+      ptr += sizeof (uint64_t);
+      if (abi != 0)
+	{
+	  const size_t rsz = static_cast<size_t> (popcount64 (sample_regs_intr))
+			     * sizeof (uint64_t);
+	  if (!bytes_available (ptr, end, rsz))
+	    return false;
+	  ptr += rsz;
+	}
+    }
+  if (sample_ty & perf_sample_type::PHYS_ADDR)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::CGROUP)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::DATA_PAGE_SIZE)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::CODE_PAGE_SIZE)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & perf_sample_type::AUX)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t aux_sz = read_u64 (ptr);
+      ptr += sizeof (uint64_t);
+      if (!bytes_available (ptr, end, aux_sz))
+	return false;
+      ptr += static_cast<size_t> (aux_sz);
+    }
+  return true;
+}
+
+} /* namespace perf_event_sample_util.  */
+} /* namespace perf_data.  */
