From 59aab744b8d2e9a524cba7de1771301997694be3 Mon Sep 17 00:00:00 2001
From: Kugan Vivekanandarajah <kvivekananda@nvidia.com>
Date: Thu, 17 Sep 2026 10:39:27 +1000
Subject: [PATCH 31/38] Configure and build the afdo_tools module

Add the afdo_tools configure script and module Makefile now that all
source backends are present.  This is the first patch that compiles and
links the three host tools afdo_create, afdo_dump and afdo_merge; it also
carries the DejaGnu check rules used by the tests added later in the
series.

afdo_tools/ChangeLog:

	* Makefile.in: New file.
	* aclocal.m4: New file.
	* config.h.in: New file.
	* configure: New file.
	* configure.ac: New file.

Signed-off-by: Kugan Vivekanandarajah <kvivekananda@nvidia.com>
Co-authored-by: Dhruv Chawla <dhruvc@nvidia.com>
Co-authored-by: Rahul Shinde <rashinde@nvidia.com>
---
 afdo_tools/Makefile.in  |  221 ++
 afdo_tools/aclocal.m4   |   19 +
 afdo_tools/config.h.in  |  143 +
 afdo_tools/configure    | 7744 +++++++++++++++++++++++++++++++++++++++
 afdo_tools/configure.ac |   93 +
 afdo_tools/version.h.in |   10 +
 6 files changed, 8230 insertions(+)
 create mode 100644 afdo_tools/Makefile.in
 create mode 100644 afdo_tools/aclocal.m4
 create mode 100644 afdo_tools/config.h.in
 create mode 100755 afdo_tools/configure
 create mode 100644 afdo_tools/configure.ac
 create mode 100644 afdo_tools/version.h.in

diff --git a/afdo_tools/Makefile.in b/afdo_tools/Makefile.in
new file mode 100644
index 00000000000..378cd470dc6
--- /dev/null
+++ b/afdo_tools/Makefile.in
@@ -0,0 +1,221 @@
+# Makefile for afdo_tools
+
+srcdir := @srcdir@
+prefix := @prefix@
+bindir := @bindir@
+datarootdir := @datarootdir@
+localedir := @localedir@
+INSTALL := @INSTALL@
+INSTALL_PROGRAM := @INSTALL_PROGRAM@
+INSTALL_STRIP_PROGRAM := $(srcdir)/../install-sh -c -s
+CXX := @CXX@
+CXXFLAGS := @CXXFLAGS@
+CXXOPTS := $(CXXFLAGS) -std=c++14 -fno-exceptions -fno-rtti \
+	   -DHAVE_CONFIG_H -include config.h -DLOCALEDIR=\"$(localedir)\"
+LDFLAGS := @LDFLAGS@
+exeext := @EXEEXT@
+
+RUNTEST := runtest
+
+# Use AFDO_TOOLS_RUNTESTFLAGS instead of inherited top-level RUNTESTFLAGS.
+AFDO_TOOLS_RUNTESTFLAGS ?=
+
+INCLUDES = -I. -I$(srcdir) -I$(srcdir)/src -I../gcc @INCINTL@
+AFDO_TOOLS_LIBS := @AFDO_TOOLS_LIBS@
+LIBINTL := @LIBINTL@
+LIBINTL_DEP := @LIBINTL_DEP@
+
+PROFILER_SRCS = src/dwarf_reader.cc \
+		src/dwarf_types.cc \
+		src/symbol_util.cc \
+		src/profile_reader.cc \
+		src/branch_stack_reader_base.cc \
+		src/arm_spe_aux_decode.cc \
+		src/perf_event_sample_util.cc \
+		src/file_mmap.cc \
+		src/perf_file_reader.cc \
+		src/perf_branch_stack_reader.cc \
+		src/perf_spe_reader.cc \
+		src/live_branch_stack_reader.cc \
+		src/autofdo_profiler.cc \
+		src/autofdo_debug_dump.cc \
+		src/autofdo_model.cc \
+		src/autofdo_gcov_export.cc \
+		src/autofdo_correlate_bucket.cc \
+		src/autofdo_correlate_deposit.cc \
+		src/autofdo_correlator.cc \
+		src/gcov_writer.cc \
+		src/gcov_writer_v3.cc \
+		src/gcov_io.cc \
+		src/gcov_summary.cc \
+		src/profile_timer.cc
+
+PROFILER_OBJS = $(PROFILER_SRCS:.cc=.o)
+
+GCOV_RDWR_SRCS = src/gcov_reader.cc src/gcov_writer.cc \
+		 src/gcov_reader_v3.cc src/gcov_writer_v3.cc \
+		 src/gcov_io.cc src/file_mmap.cc
+
+
+GCOV_RDWR_OBJS = $(GCOV_RDWR_SRCS:.cc=.o)
+
+TARGETS = afdo_create$(exeext) afdo_dump$(exeext) afdo_merge$(exeext)
+
+.PHONY: all clean distclean install install-strip check installcheck \
+	dvi pdf html info install-info install-pdf install-dvi \
+	install-man install-html mostlyclean maintainer-clean \
+	check-afdo-tests check-afdo-report
+
+all: $(TARGETS)
+
+afdo_create$(exeext): src/afdo_create.o $(PROFILER_OBJS) | $(LIBINTL_DEP)
+	$(CXX) $(CXXOPTS) $(LDFLAGS) -o $@ $^ $(AFDO_TOOLS_LIBS) $(LIBINTL)
+
+afdo_dump$(exeext): src/afdo_dump.o $(GCOV_RDWR_OBJS) | $(LIBINTL_DEP)
+	$(CXX) $(CXXOPTS) $(LDFLAGS) -o $@ $^ $(LIBINTL)
+
+afdo_merge$(exeext): src/afdo_merge.o src/gcov_merge.o src/gcov_summary.o \
+	$(GCOV_RDWR_OBJS) | $(LIBINTL_DEP)
+	$(CXX) $(CXXOPTS) $(LDFLAGS) -o $@ $^ $(LIBINTL)
+
+src/%.o: $(srcdir)/src/%.cc
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXOPTS) $(INCLUDES) -MMD -MP -MF $(@:.o=.d) -c $< -o $@
+
+src/afdo_create.o src/afdo_dump.o src/afdo_merge.o: version.h
+
+# Auto-dependency tracking (like gcc/Makefile.in): each object writes a
