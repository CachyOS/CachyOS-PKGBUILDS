+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+/* Hierarchical discriminator encoding for AutoFDO.  */
+
+#ifndef GCC_GCOV_DISCRIMINATOR_ENCODING_H
+#define GCC_GCOV_DISCRIMINATOR_ENCODING_H
+
+#include <cstdint>
+
+namespace autofdo {
+
+/* Format: [Base:8][Multiplicity:7][CopyID:11][Unused:6].  */
+
+inline constexpr uint32_t
+get_base_discriminator (uint32_t discriminator)
+{
+  return discriminator & 0xFFu;
+}
+
+/* A Multiplicity field of 0 encodes multiplicity 1.  */
+inline constexpr uint32_t
+get_multiplicity (uint32_t discriminator)
+{
+  uint32_t mult = (discriminator >> 8) & 0x7Fu;
+  return (mult == 0) ? 1u : mult;
+}
+
+inline constexpr uint32_t
+get_copy_id (uint32_t discriminator)
+{
+  return (discriminator >> 15) & 0x7FFu;
+}
+
+/* Strip multiplicity and keep base + copy_id (Pass-1 aggregation key).  */
+inline constexpr uint32_t
+strip_multiplicity (uint32_t discriminator)
+{
+  uint32_t base = get_base_discriminator (discriminator);
+  uint32_t copy_id = get_copy_id (discriminator);
+  return base | (copy_id << 15);
+}
+
+/* Have (rel_line, disc) as uint64_t which matches autofdo's SourceInfo.  */
+inline constexpr uint64_t
+gcov_pack_line_disc (uint32_t rel_line, uint32_t discriminator)
+{
+  return (static_cast<uint64_t> (rel_line) << 32)
+	 | static_cast<uint64_t> (discriminator);
+}
+
+/* Written to the GCOV AFDO_FUNCTION pos_counts and callsite offsets.  */
+inline constexpr uint32_t
+gcov_compress_offset (uint64_t packed)
+{
+  return static_cast<uint32_t> ((packed >> 16) | (packed & 0xffffu));
+}
+
+inline constexpr uint32_t
+gcov_rel_line_from_packed (uint64_t packed)
+{
+  return static_cast<uint32_t> ((packed >> 32) & 0xffffu);
+}
+
+inline constexpr uint32_t
+gcov_disc_from_packed (uint64_t packed)
+{
+  return static_cast<uint32_t> (packed & 0xffffffffu);
+}
+
+/* Used to drop samples GCC cannot represent in this encoding.  */
+inline constexpr bool
+gcov_offset_fields_representable (uint32_t rel_line)
+{
+  return rel_line <= 0xFFFFu;
+}
+
+} /* namespace autofdo.  */
+
+#endif /* GCC_GCOV_DISCRIMINATOR_ENCODING_H.  */
