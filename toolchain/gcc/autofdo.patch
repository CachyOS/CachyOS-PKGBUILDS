+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_PERF_H
+#define GCC_PERF_H
+
+#include "hash_util.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <utility>
+#include <vector>
+#include <string>
+#include <unordered_map>
+
+namespace perf_data {
+
+/* Common scalar loaders for perf binary payloads (host-endian on the recording
+   machine; LE on AArch64/x86).  memcpy into a native integer.  */
+/* TODO(afdo): on big-endian hosts, byte-swap or use le{16,32,64}toh.  */
+
+inline uint16_t
+read_u16 (const uint8_t *p)
+{
+  uint16_t v;
+  std::memcpy (&v, p, sizeof (v));
+  return v;
+}
+
+inline uint32_t
+read_u32 (const uint8_t *p)
+{
+  uint32_t v;
+  std::memcpy (&v, p, sizeof (v));
+  return v;
+}
+
+inline uint64_t
+read_u64 (const uint8_t *p)
+{
+  uint64_t v;
+  std::memcpy (&v, p, sizeof (v));
+  return v;
+}
+
+struct perf_record_type
+{
+  enum : unsigned
+  {
+    MMAP = 1,
+    LOST = 2,
+    COMM = 3,
+    EXIT = 4,
+    THROTTLE = 5,
+    UNTHROTTLE = 6,
+    FORK = 7,
+    READ = 8,
+    SAMPLE = 9,
+    MMAP2 = 10,
+    AUXTRACE = 71 /* PERF_RECORD_AUXTRACE (user); inline tail after struct */
+  };
+};
+
+/* Bit layout matches Linux `PERF_SAMPLE_*` (include/uapi/linux/perf_event.h).
+   perf.data attrs.sample_type uses these values.  */
+struct perf_sample_type
+{
+  enum : uint64_t
+  {
+    IP = 1ULL << 0,
+    TID = 1ULL << 1,
+    TIME = 1ULL << 2,
+    ADDR = 1ULL << 3,
+    READ = 1ULL << 4,
+    CALLCHAIN = 1ULL << 5,
+    ID = 1ULL << 6,
+    CPU = 1ULL << 7,
+    PERIOD = 1ULL << 8,
+    STREAM_ID = 1ULL << 9,
+    RAW = 1ULL << 10,
+    BRANCH_STACK = 1ULL << 11,
+    REGS_USER = 1ULL << 12,
+    STACK_USER = 1ULL << 13,
+    WEIGHT = 1ULL << 14,
+    DATA_SRC = 1ULL << 15,
+    IDENTIFIER = 1ULL << 16,
+    TRANSACTION = 1ULL << 17,
+    REGS_INTR = 1ULL << 18,
+    PHYS_ADDR = 1ULL << 19,
+    AUX = 1ULL << 20,
+    CGROUP = 1ULL << 21,
+    DATA_PAGE_SIZE = 1ULL << 22,
+    CODE_PAGE_SIZE = 1ULL << 23,
+    WEIGHT_STRUCT = 1ULL << 24,
+  };
+  static constexpr uint64_t WEIGHT_TYPE = WEIGHT | WEIGHT_STRUCT;
+};
+
+constexpr uint64_t DEFAULT_BRANCH_STACK_SAMPLE_TYPE
+  = perf_sample_type::IP | perf_sample_type::TID | perf_sample_type::TIME
+    | perf_sample_type::ADDR | perf_sample_type::CPU | perf_sample_type::PERIOD
+    | perf_sample_type::BRANCH_STACK;
+
+/* Linux `PERF_SAMPLE_BRANCH_*` bits affecting branch stack payload layout.  */
+struct perf_branch_stack_format
+{
+  enum : uint64_t
+  {
+    HW_INDEX = 1ULL << 17,
+    COUNTERS = 1ULL << 19,
+  };
+};
+
+#pragma pack(push, 1)
+struct perf_branch_stack_entry
+{
+  uint64_t from;
+  uint64_t to;
+  uint64_t flags;
+};
+
+/* Branch-stack speculation (Linux perf_event.h PERF_BR_SPEC_* in flags).
+   The speculation outcome is a 2-bit field at offset 24 of the flags word.  */
+struct perf_branch_spec
+{
+  enum : uint64_t
+  {
+    MASK = 3ULL << 24,	     /* Both speculation bits.  */
+    WRONG_PATH = 1ULL << 24, /* PERF_BR_SPEC_WRONG_PATH.  */
+  };
+};
+#pragma pack(pop)
+
+/* perf_event_read_format bits (PERF_FORMAT_*).  */
+struct perf_read_format
+{
+  enum : unsigned
+  {
+    TOTAL_TIME_ENABLED = 1ULL << 0,
+    TOTAL_TIME_RUNNING = 1ULL << 1,
+    GROUP = 1ULL << 3,
+    LOST = 1ULL << 4,
+  };
+};
+
+struct simple_mmap
+{
+  uint64_t start_addr;
+  uint64_t end_addr;
+  uint64_t file_offset;	  /* p_offset of the segment in the ELF file.  */
+  uint64_t segment_vaddr; /* p_vaddr (link-time address) for DWARF lookup.  */
+  bool is_pie = false;	  /* ET_DYN: DWARF uses 0-based addresses.  */
+
+  simple_mmap (uint64_t start, uint64_t end, uint64_t offset,
+	       uint64_t vaddr = 0, bool pie = false)
+    : start_addr (start), end_addr (end), file_offset (offset),
+      segment_vaddr (vaddr), is_pie (pie)
+  {}
+
+  bool contains (uint64_t addr) const
+  {
+    return addr >= start_addr && addr < end_addr;
+  }
+
+  /* Return link-time address for DWARF lookup.
+     - Non-PIE (segment_vaddr != 0): pass segment_vaddr + offset.
+     - PIE (is_pie or segment_vaddr == 0): DWARF uses 0-based, pass offset.
+     - Non-PIE with failed ELF lookup (segment_vaddr == 0, !is_pie): pass
+       runtime address.  */
+  uint64_t to_dwarf_address (uint64_t runtime_addr) const
+  {
+    if (!contains (runtime_addr))
+      return runtime_addr;
+    uint64_t offset_in_segment = runtime_addr - start_addr;
+    if (segment_vaddr != 0)
+      return segment_vaddr + offset_in_segment;
+    if (is_pie)
+      return file_offset + offset_in_segment;
+    return start_addr + offset_in_segment;
+  }
+};
+
+#pragma pack(push, 1)
+struct perf_file_header
+{
+  uint64_t magic;
+  uint64_t size;
+  uint64_t attr_size;
+  uint64_t attrs_offset;
+  uint64_t attrs_size;
+  uint64_t data_offset;
+  uint64_t data_size;
+  uint64_t event_types_offset;
+  uint64_t event_types_size;
+  uint64_t features;
+};
+
+struct perf_event_header
+{
+  uint32_t type;
+  uint16_t misc;
+  uint16_t size;
+};
+
+struct perf_mmap_record
+{
+  uint32_t pid;
+  uint32_t tid;
+  uint64_t addr;
+  uint64_t len;
+  uint64_t pgoff;
+};
+
+struct perf_mmap2_record
+{
+  uint32_t pid;
+  uint32_t tid;
+  uint64_t addr;
+  uint64_t len;
+  uint64_t pgoff;
+  union
+  {
+    struct
+    {
+      uint32_t maj;
+      uint32_t min;
+      uint64_t ino;
+      uint64_t ino_generation;
+    } mmap;
+    struct
+    {
+      uint8_t build_id_size;
+      uint8_t __reserved_1;
+      uint16_t __reserved_2;
+      uint8_t build_id[20];
+    } build;
+  } id;
+  uint32_t prot;
+  uint32_t flags;
+};
+#pragma pack(pop)
+
+/* Helpers using the structs above (MMAP records, simple_mmap lists).  */
+
+inline bool
+try_compute_mmap_end (uint64_t start, uint64_t length, uint64_t *end)
+{
+  if (end == nullptr || length == 0 || length > UINT64_MAX - start)
+    return false;
+  *end = start + length;
+  return true;
+}
+
+inline std::string
+perf_mmap_filename_view (const char *filename, size_t filename_max)
+{
+  size_t len = 0;
+  while (len < filename_max && filename[len] != '\0')
+    ++len;
+  return std::string (filename, len);
+}
+
+using branch_stack_edge = std::pair<uint64_t, uint64_t>;
+
+struct branch_stack_edge_hash
+{
+  size_t operator() (const branch_stack_edge &e) const noexcept
+  {
+    size_t hash = std::hash<uint64_t>{}(e.first);
+    autofdo::hash_combine (hash, std::hash<uint64_t>{}(e.second));
+    return hash;
+  }
+};
+
+/* Aggregated from perf branch-stack samples (x86 LBR, ARM BRBE, etc.).  */
+using branch_stack_edge_count_map
+  = std::unordered_map<branch_stack_edge, uint64_t, branch_stack_edge_hash>;
+
+/* Sorted range/branch count rows after load finalize.  */
+struct profile_range
+{
+  uint64_t beg = 0;
+  uint64_t end = 0;
+  uint64_t count = 0;
+
+  bool operator< (const profile_range &other) const { return beg < other.beg; }
+};
+
+struct profile_branch
+{
+  uint64_t from = 0;
+  uint64_t to = 0;
+  uint64_t count = 0;
+
+  bool operator< (const profile_branch &other) const
+  {
+    if (from != other.from)
+      return from < other.from;
+    return to < other.to;
+  }
+};
+
+inline uint64_t
+total_mass_from_range_counts (const std::vector<profile_range> &ranges)
+{
+  uint64_t total = 0;
+  for (const profile_range &row : ranges)
+    {
+      if (row.end >= row.beg)
+	total += row.count * (row.end - row.beg + 1);
+    }
+  return total;
+}
+
+inline uint64_t
+total_mass_from_runtime_range_map (const branch_stack_edge_count_map &ranges)
+{
+  uint64_t total = 0;
+  for (const auto &entry : ranges)
+    {
+      const branch_stack_edge &range = entry.first;
+      const uint64_t count = entry.second;
+      if (range.second >= range.first)
+	total += count * (1 + (range.second - range.first));
+    }
+  return total;
+}
+
+inline uint64_t
+total_mass_from_address_frequencies (
+  const std::unordered_map<uint64_t, uint64_t> &address_frequencies)
+{
+  uint64_t total = 0;
+  for (const auto &entry : address_frequencies)
+    total += entry.second;
+  return total;
+}
+
+inline bool
+target_mmaps_contain (const std::vector<simple_mmap> &mmaps, uint64_t address)
+{
+  if (mmaps.empty ())
+    return false;
+  if (mmaps.size () == 1)
+    return mmaps[0].contains (address);
+  for (const auto &m : mmaps)
+    if (m.contains (address))
+      return true;
+  return false;
+}
+
+/* Sorted, merged [start, end) intervals for O(log n) containment checks.  */
+inline bool
+target_address_ranges_contain (
+  const std::vector<std::pair<uint64_t, uint64_t>> &ranges, uint64_t address)
+{
+  if (ranges.empty ())
+    return false;
+  auto it = std::upper_bound (
+    ranges.begin (),
+    ranges.end (),
+    address,
+    [] (uint64_t addr, const std::pair<uint64_t, uint64_t> &r) {
+      return addr < r.first;
+    });
+  if (it == ranges.begin ())
+    return false;
+  --it;
+  return address < it->second;
+}
+
+/* Test the range index when available, otherwise scan the mappings.  */
+inline bool
+target_address_contained (
+  const std::vector<simple_mmap> &mmaps,
+  const std::vector<std::pair<uint64_t, uint64_t>> *sorted_ranges,
+  uint64_t address)
+{
+  if (sorted_ranges != nullptr && !sorted_ranges->empty ())
+    return target_address_ranges_contain (*sorted_ranges, address);
+  return target_mmaps_contain (mmaps, address);
+}
+
+/* Translate RUNTIME_ADDR through MMAPS.  The return value indicates success
+   because a valid PIE address may translate to zero.  */
+inline bool
+try_translate_runtime_with_mmaps (const std::vector<simple_mmap> &mmaps,
+				  uint64_t runtime_addr, uint64_t *out)
+{
+  if (out == nullptr)
+    return false;
+  for (const auto &m : mmaps)
+    if (m.contains (runtime_addr))
+      {
+	*out = m.to_dwarf_address (runtime_addr);
+	return true;
+      }
+  return false;
+}
+
+inline uint64_t
+translate_runtime_with_mmaps (const std::vector<simple_mmap> &mmaps,
+			      uint64_t runtime_addr)
+{
+  uint64_t out = 0;
+  if (try_translate_runtime_with_mmaps (mmaps, runtime_addr, &out))
+    return out;
+  return runtime_addr;
+}
+
+/* Merge into an overlapping mapping with the same pgoff (same ELF segment).  */
+inline bool
+try_merge_target_mmap (std::vector<simple_mmap> &mmaps, uint64_t start,
+		       uint64_t end, uint64_t pgoff)
+{
+  for (auto &existing : mmaps)
+    {
+      if (existing.file_offset != pgoff)
+	continue;
+      if (start > existing.end_addr || end < existing.start_addr)
+	continue;
+      existing.start_addr = std::min (existing.start_addr, start);
+      existing.end_addr = std::max (existing.end_addr, end);
+      return true;
+    }
+  return false;
+}
+
+/* Branch-stack ranges use inclusive runtime endpoints; both in one mmap.  */
+inline bool
+mmap_contains_runtime_range_inclusive (const simple_mmap &m,
+				       uint64_t runtime_start,
+				       uint64_t runtime_end)
+{
+  return runtime_end >= runtime_start && runtime_start >= m.start_addr
+	 && runtime_end < m.end_addr;
+}
+
+/* Translate [runtime_start, runtime_end] when both ends share one mapping.
+   HINT_INDEX, when provided, is tried first and updated on success.  */
+inline bool
+translate_runtime_range_with_mmaps (const std::vector<simple_mmap> &mmaps,
+				    uint64_t runtime_start,
+				    uint64_t runtime_end, uint64_t *file_start,
+				    uint64_t *file_end,
+				    size_t *hint_index = nullptr)
+{
+  if (file_start == nullptr || file_end == nullptr
+      || runtime_end < runtime_start)
+    return false;
+
+  const auto try_one = [&] (const simple_mmap &m) -> bool {
+    if (!mmap_contains_runtime_range_inclusive (m, runtime_start, runtime_end))
+      return false;
+    *file_start = m.to_dwarf_address (runtime_start);
+    *file_end = m.to_dwarf_address (runtime_end);
+    return true;
+  };
+
+  if (hint_index != nullptr && *hint_index < mmaps.size ())
+    {
+      if (try_one (mmaps[*hint_index]))
+	return true;
+    }
+
+  if (mmaps.size () == 1)
+    {
+      if (try_one (mmaps[0]))
+	{
+	  if (hint_index != nullptr)
+	    *hint_index = 0;
+	  return true;
+	}
+      return false;
+    }
+
+  for (size_t i = 0; i < mmaps.size (); ++i)
+    {
+      if (!try_one (mmaps[i]))
+	continue;
+      if (hint_index != nullptr)
+	*hint_index = i;
+      return true;
+    }
+  return false;
+}
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_H.  */
