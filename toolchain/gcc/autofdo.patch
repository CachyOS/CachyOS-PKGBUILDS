index 0e373f39742..bd29876009b 100644
--- a/afdo_tools/Makefile.in
+++ b/afdo_tools/Makefile.in
@@ -14,6 +14,11 @@ LDFLAGS := @LDFLAGS@
 NO_PIE_FLAG := -no-pie
