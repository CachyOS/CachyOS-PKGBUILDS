+void
+check_partial_unknown_file ()
+{
+  gcov::gcov_profile profile;
+  profile.set_names ({"source.c", "other.c"},
+		     {"", "known", "unknown", "other"},
+		     {gcov::INVALID_INDEX, 0, gcov::INVALID_INDEX, 1});
+  std::vector<gcov::gcov_function> functions;
+  for (uint32_t id = 1; id <= 3; ++id)
+    {
+      gcov::gcov_function func;
+      func.id = id;
+      func.desc.name_index = id;
+      if (id == 1)
+	func.desc.file_index = 0;
+      else if (id == 3)
+	func.desc.file_index = 1;
+      functions.push_back (std::move (func));
+    }
+  profile.set_functions (std::move (functions));
+  const std::string path = temporary_path ();
+  gcov::gcov_writer_options options;
+  options.version = 4;
+  auto writer = gcov::make_gcov_writer (path, &profile, options);
+  expect (writer && writer->write (), "write unknown-file profile");
+  writer.reset ();
+  gcov::gcov_reader_v4 reader (path);
+  expect (reader.read_files ({"source.c"}), "read partial unknown-file profile");
+  expect (reader.get_profile ()->get_functions ().size () == 2,
+	  "retain unknown-file functions and omit other files");
+  expect (unlink (path.c_str ()) == 0, "remove unknown-file profile");
+}
