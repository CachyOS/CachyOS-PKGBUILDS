+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <vector>
+
+#ifndef __NR_perf_event_open
+#if defined(__x86_64__)
+#define PERF_EVENT_OPEN_NR 298
+#elif defined(__aarch64__)
+#define PERF_EVENT_OPEN_NR 241
+#else
+#error "Unsupported architecture for perf_event_open"
+#endif
+#else
+#define PERF_EVENT_OPEN_NR __NR_perf_event_open
+#endif
+
+namespace perf_data {
+
+static long
+sys_perf_event_open (perf_event_attr *attr, pid_t pid, int cpu, int group_fd,
+		     unsigned long flags)
+{
+  return syscall (PERF_EVENT_OPEN_NR, attr, pid, cpu, group_fd, flags);
+}
+
+static std::string
+path_basename (const std::string &path)
+{
+  size_t slash = path.find_last_of ("/\\");
+  return slash != std::string::npos ? path.substr (slash + 1) : path;
+}
+
+live_branch_stack_reader::live_branch_stack_reader (
+  const std::string &_binary_path,
+  const std::vector<std::string> &_command_argv, uint64_t _sample_period)
+  : binary_path (_binary_path), command_argv (_command_argv),
+    sample_period (_sample_period)
+{}
+
+live_branch_stack_reader::~live_branch_stack_reader () = default;
+
+bool
+live_branch_stack_reader::is_target_binary (
+  const std::string &mmap_filename) const
+{
+  if (mmap_filename.empty ())
+    return false;
+
+  /* The kernel reports unlinked files as "<path> (deleted)".  */
+  std::string mmap_path = mmap_filename;
+  size_t del = mmap_path.find (" (deleted)");
+  if (del != std::string::npos)
+    mmap_path.erase (del);
+
+  if (mmap_path == binary_path
+      || (!binary_path_resolved.empty () && mmap_path == binary_path_resolved))
+    return true;
+
+  /* Fall back to the basename: the child may be exec'd through a different
+     path (symlink, $PATH lookup) than the one named on the command line.  */
+  const std::string mmap_base = path_basename (mmap_path);
+  return mmap_base == path_basename (binary_path)
+	 || (!binary_path_resolved.empty ()
+	     && mmap_base == path_basename (binary_path_resolved));
+}
+
+void
+live_branch_stack_reader::add_target_mapping_if_accepted (
+  const std::string &mmap_filename, uint64_t start, uint64_t end,
+  uint64_t pgoff)
+{
+  const bool accept = is_target_binary (mmap_filename);
+  if (!accept)
+    return;
+  if (try_merge_target_mmap (target_mmaps, start, end, pgoff))
+    return;
+  const std::string &path
+    = binary_path_resolved.empty () ? binary_path : binary_path_resolved;
+  uint64_t vaddr = 0;
+  get_elf_segment_vaddr_for_pgoff (path, pgoff, vaddr);
+  bool is_pie = get_elf_is_pie (path);
+  target_mmaps.emplace_back (start, end, pgoff, vaddr, is_pie);
+}
+
+void
+live_branch_stack_reader::process_mmap_record (const uint8_t *payload,
+					       size_t payload_size)
+{
+  if (payload_size < sizeof (perf_mmap_record))
+    return;
+  perf_mmap_record mmap;
+  std::memcpy (&mmap, payload, sizeof (mmap));
+  std::string name = perf_mmap_filename_view (
+    reinterpret_cast<const char *> (payload + sizeof (perf_mmap_record)),
+    payload_size - sizeof (perf_mmap_record));
+  uint64_t end = 0;
+  if (try_compute_mmap_end (mmap.addr, mmap.len, &end))
+    add_target_mapping_if_accepted (name, mmap.addr, end, mmap.pgoff);
+}
+
+void
+live_branch_stack_reader::process_mmap2_record (const uint8_t *payload,
+						size_t payload_size)
+{
+  if (payload_size < sizeof (perf_mmap2_record))
+    return;
+  perf_mmap2_record mmap2;
+  std::memcpy (&mmap2, payload, sizeof (mmap2));
+  std::string name = perf_mmap_filename_view (
+    reinterpret_cast<const char *> (payload + sizeof (perf_mmap2_record)),
+    payload_size - sizeof (perf_mmap2_record));
+  uint64_t end = 0;
+  if (try_compute_mmap_end (mmap2.addr, mmap2.len, &end))
+    add_target_mapping_if_accepted (name, mmap2.addr, end, mmap2.pgoff);
+}
+
+bool
+live_branch_stack_reader::process_sample_record (const uint8_t *payload,
+						 size_t payload_size)
+{
+  if (payload_size == 0)
+    return false;
+
+  const uint8_t *ptr = payload;
+  const uint8_t *const end = payload + payload_size;
+  uint64_t ip = 0;
+  bool have_ip = false;
+  uint64_t sample_time = 0;
+
+  if (!perf_event_sample_util::walk_sample_before_branch (
+	ptr, end, sample_type, 0, &ip, &have_ip, nullptr, &sample_time))
+    return false;
+
+  uint64_t nr = 0;
+  const perf_branch_stack_entry *entries = nullptr;
+  if (!perf_event_sample_util::walk_sample_branch_stack (
+	ptr, end, branch_sample_type, sample_type, &nr, &entries))
+    return false;
+
+  if (!perf_event_sample_util::walk_sample_after_branch (
+	ptr, end, sample_type, 0, 0)
+      || ptr != end)
+    return false;
+
+  /* Primary path: LBR branch stack.  Sample IP fallbacks improve coverage
+     when the stack is empty or has no target branches.  */
+  const bool ip_is_target
+    = have_ip && ip != 0 && target_mmaps_contain (target_mmaps, ip);
+  bool recorded = record_sample_ip (
+    ip, ip_is_target, sample_time, accumulate_sample_ips_, address_frequencies);
+  const bool branch_stack_enabled
+    = (sample_type & perf_sample_type::BRANCH_STACK) && use_branch_stack;
+  if (branch_stack_enabled && nr > 0
+      && accumulate_branch_stack_sample (entries,
+					 nr,
+					 1,
+					 *this,
+					 sample_time,
+					 target_mmaps,
+					 nullptr,
+					 range_count_map,
+					 branch_count_map))
+    recorded = true;
+
+  return recorded;
+}
+
+void
+live_branch_stack_reader::process_ring_buffer (void *mmap_base,
+					       uint64_t data_offset,
+					       uint64_t data_size)
+{
+  if (mmap_base == nullptr || data_size == 0)
+    return;
+  char *base = static_cast<char *> (mmap_base);
+  perf_event_mmap_page *meta = reinterpret_cast<perf_event_mmap_page *> (base);
+  char *data = base + data_offset;
+  uint64_t ring_size = data_size;
+
+  for (;;)
+    {
+      uint64_t head = __atomic_load_n (&meta->data_head, __ATOMIC_ACQUIRE);
+      uint64_t tail = __atomic_load_n (&meta->data_tail, __ATOMIC_RELAXED);
+      if (tail == head)
+	break;
+      const uint64_t initial_tail = tail;
+      while (tail != head)
+	{
+	  if (tail > head || head - tail < sizeof (perf_event_header)
+	      || ring_size < sizeof (perf_event_header))
+	    break;
+	  uint64_t offset = tail % ring_size;
+	  perf_event_header header;
+	  const size_t header_first
+	    = std::min<uint64_t> (sizeof (header), ring_size - offset);
+	  std::memcpy (&header, data + offset, header_first);
+	  if (header_first < sizeof (header))
+	    std::memcpy (reinterpret_cast<uint8_t *> (&header) + header_first,
+			 data,
+			 sizeof (header) - header_first);
+	  uint32_t size = header.size;
+	  if (size < sizeof (perf_event_header) || size > ring_size)
+	    {
+	      tail += sizeof (
+		perf_event_header); /* skip bad size to avoid infinite loop.  */
+	      continue;
+	    }
+	  if (size > head - tail)
+	    break;
+
+	  std::vector<uint8_t> wrap_buf;
+	  const uint8_t *payload = nullptr;
+	  if (size > ring_size - offset)
+	    {
+	      wrap_buf.resize (size);
+	      const size_t first = ring_size - offset;
+	      std::memcpy (wrap_buf.data (), data + offset, first);
+	      std::memcpy (wrap_buf.data () + first, data, size - first);
+	      payload = wrap_buf.data () + sizeof (perf_event_header);
+	    }
+	  else
+	    payload = reinterpret_cast<const uint8_t *> (data + offset)
+		      + sizeof (perf_event_header);
+	  size_t payload_size = size - sizeof (perf_event_header);
+
+	  switch (header.type)
+	    {
+	    case perf_record_type::SAMPLE:
+	      if (process_sample_record (payload, payload_size))
+		total_samples++;
+	      break;
+	    case perf_record_type::MMAP:
+	      process_mmap_record (payload, payload_size);
+	      break;
+	    case perf_record_type::MMAP2:
+	      process_mmap2_record (payload, payload_size);
+	      break;
+	    case perf_record_type::LOST:
+	      /* Payload is { u64 id; u64 lost; }.  */
+	      if (payload_size >= 2 * sizeof (uint64_t))
+		{
+		  uint64_t lost = read_u64 (payload + sizeof (uint64_t));
+		  lost_records += lost;
+		}
+	      break;
+	    default:
+	      break;
+	    }
+	  tail += size;
+	}
+      __atomic_store_n (&meta->data_tail, tail, __ATOMIC_RELEASE);
+      if (tail == initial_tail)
+	break;
+    }
+}
+
+bool
+live_branch_stack_reader::load ()
+{
+  range_count_map.clear ();
+  branch_count_map.clear ();
+  address_frequencies.clear ();
+  reset_branch_stack_profile ();
+  reset_profile_state ();
+  target_mmaps.clear ();
+  total_samples = 0;
+  lost_records = 0;
+  if (command_argv.empty ())
+    {
+      fprintf (stderr, "Error: No command to run for direct profiling\n");
+      return false;
+    }
+  if (sample_period == 0)
+    {
+      fprintf (stderr, "Error: Live sample period must be nonzero\n");
+      return false;
+    }
+
+  /* Resolve binary path so we can match kernel MMAP paths (often absolute).  */
+  char *resolved = realpath (binary_path.c_str (), nullptr);
+  if (resolved)
+    {
+      binary_path_resolved = resolved;
+      free (resolved);
+    }
+  else
+    binary_path_resolved.clear ();
+
+  /* Prepare attr before fork so the parent can call perf_event_open immediately
+   * (child may exit quickly).  Live capture requires LBR/BRBE; no IP fallback.
+   */
+  perf_event_attr attr = {};
+  attr.type = PERF_TYPE_HARDWARE;
+  attr.size = sizeof (attr);
+  attr.config = PERF_COUNT_HW_CPU_CYCLES;
+  attr.sample_period = sample_period;
+  attr.sample_type = DEFAULT_BRANCH_STACK_SAMPLE_TYPE;
+  attr.branch_sample_type = PERF_SAMPLE_BRANCH_ANY;
+  attr.exclude_kernel = 1;
+  attr.exclude_hv = 1;
+  attr.mmap = 1;
+  attr.mmap2 = 1;
+
+  int sync_pipe[2];
+  if (pipe (sync_pipe) != 0)
+    {
+      fprintf (stderr, "Error: pipe failed: %s\n", strerror (errno));
+      return false;
+    }
+
+  pid_t pid = fork ();
+  if (pid < 0)
+    {
+      fprintf (stderr, "Error: fork failed: %s\n", strerror (errno));
+      close (sync_pipe[0]);
+      close (sync_pipe[1]);
+      return false;
+    }
+
+  if (pid == 0)
+    {
+      /* We start the command here; we block in read() until parent attaches
+       * perf, then exec.  */
+      close (sync_pipe[1]);
+      char ignore;
+      if (read (sync_pipe[0], &ignore, 1) != 1)
+	_exit (126);
+      close (sync_pipe[0]);
+      std::vector<char *> argv;
+      for (auto &s : command_argv)
+	argv.push_back (const_cast<char *> (s.c_str ()));
+      argv.push_back (nullptr);
+      execvp (argv[0], argv.data ());
+      fprintf (
+	stderr, "Error: execvp %s failed: %s\n", argv[0], strerror (errno));
+      _exit (127);
+    }
+
+  /* Parent: attach perf to child (child is blocked in read(), so it cannot
+   * exit).  */
+  close (sync_pipe[0]);
+  int fd = static_cast<int> (sys_perf_event_open (&attr, pid, -1, -1, 0));
+  if (fd < 0)
+    {
+      close (sync_pipe[1]);
+      waitpid (pid, nullptr, 0);
+      fprintf (stderr,
+	       "Error: live capture requires LBR/BRBE branch-stack support"
+	       " (perf_event_open failed: %s)\n",
+	       strerror (errno));
+      fprintf (stderr,
+	       "  Try: sudo afdo_create ... or echo 0 | sudo tee "
+	       "/proc/sys/kernel/perf_event_paranoid\n");
+      fprintf (stderr,
+	       "  Offline mode (-p <perf.data>) still works without live"
+	       " branch-stack.\n");
+      return false;
+    }
+  use_branch_stack = true;
+  sample_type = DEFAULT_BRANCH_STACK_SAMPLE_TYPE;
+  branch_sample_type = attr.branch_sample_type;
+
+  const long system_page_size = sysconf (_SC_PAGESIZE);
+  if (system_page_size <= 0)
+    {
+      fprintf (stderr, "Error: unable to determine system page size\n");
+      close (fd);
+      close (sync_pipe[1]);
+      waitpid (pid, nullptr, 0);
+      return false;
+    }
+  const size_t page_size = static_cast<size_t> (system_page_size);
+  size_t mmap_len = page_size * (1 + 256); /* 1 meta + 256 data pages.  */
+  void *mmap_base
+    = mmap (nullptr, mmap_len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (mmap_base == MAP_FAILED)
+    {
+      fprintf (
+	stderr, "Error: mmap perf buffer failed: %s\n", strerror (errno));
+      close (fd);
+      close (sync_pipe[1]);
+      waitpid (pid, nullptr, 0);
+      return false;
+    }
+
+  perf_event_mmap_page *meta = static_cast<perf_event_mmap_page *> (mmap_base);
+  uint64_t data_offset = meta->data_offset;
+  uint64_t data_size = meta->data_size;
+  if (data_size == 0)
+    {
+      data_offset = page_size;
+      data_size = mmap_len - page_size;
+    }
+  /* Ensure we never read past the mmap (kernel may return layout past our
+   * mapping).  */
+  if (data_offset >= mmap_len || data_size > mmap_len - data_offset)
+    {
+      data_offset = page_size;
+      data_size = (mmap_len > page_size) ? (mmap_len - page_size) : 0;
+    }
+  if (data_size == 0)
+    {
+      fprintf (stderr, "Error: no room for perf data buffer\n");
+      munmap (mmap_base, mmap_len);
+      close (fd);
+      close (sync_pipe[1]);
+      waitpid (pid, nullptr, 0);
+      return false;
+    }
+
+  if (ioctl (fd, PERF_EVENT_IOC_ENABLE, 0) < 0)
+    {
+      fprintf (
+	stderr, "Error: PERF_EVENT_IOC_ENABLE failed: %s\n", strerror (errno));
+      munmap (mmap_base, mmap_len);
+      close (fd);
+      close (sync_pipe[1]);
+      waitpid (pid, nullptr, 0);
+      return false;
+    }
+  /* Unblock child only after perf is enabled.  */
+  {
+    char one = 1;
+    if (write (sync_pipe[1], &one, 1) != 1)
+      {
+	/* Best-effort unblock before closing the write end.  */
+      }
+    close (sync_pipe[1]);
+  }
+
+  fprintf (stderr,
+	   "Profiling %s (PID %d, branch-stack)...\n",
+	   command_argv[0].c_str (),
+	   pid);
+  int status = 0;
+  pollfd pfd = {fd, POLLIN, 0};
+  for (;;)
+    {
+      const pid_t reaped = waitpid (pid, &status, WNOHANG);
+      if (reaped == pid)
+	break;
+      if (reaped < 0 && errno != EINTR)
+	break;
+      const int r = poll (&pfd, 1, 100);
+      if (r > 0 && (pfd.revents & POLLIN))
+	process_ring_buffer (mmap_base, data_offset, data_size);
+    }
+  process_ring_buffer (mmap_base, data_offset, data_size);
+
+  ioctl (fd, PERF_EVENT_IOC_DISABLE, 0);
+  munmap (mmap_base, mmap_len);
+  close (fd);
+
+  if (lost_records != 0)
+    fprintf (stderr,
+	     "Warning: kernel dropped %" PRIu64 " perf records; raise"
+	     " --sample-period to sample less often\n",
+	     lost_records);
+
+  if (WIFEXITED (status))
+    fprintf (stderr, "Process exited with code %d\n", WEXITSTATUS (status));
+  else if (WIFSIGNALED (status))
+    fprintf (stderr,
+	     "Process killed by signal %d (e.g. SIGSEGV); profile may be "
+	     "incomplete.\n",
+	     WTERMSIG (status));
+
+  if (target_mmaps.empty ())
+    {
+      std::string target_basename
+	= binary_path.substr (binary_path.find_last_of ("/\\") + 1);
+      fprintf (stderr,
+	       "Error: No memory mappings found for target binary '%s'\n",
+	       target_basename.c_str ());
+      return false;
+    }
+
+  if (range_count_map.empty () && branch_count_map.empty ()
+      && address_frequencies.empty ())
+    {
+      fprintf (stderr,
+	       "Error: No branch-stack samples collected (binary "
+	       "may not match or workload too short)\n");
+      return false;
+    }
+
+  fprintf (stderr,
+	   "Collected %" PRIu64 " samples, %zu ranges, %zu branches",
+	   total_samples,
+	   range_count_map.size (),
+	   branch_count_map.size ());
+  if (!address_frequencies.empty ())
+    fprintf (stderr, ", %zu sample IPs", address_frequencies.size ());
+  fprintf (stderr, "\n");
+  finalize_profile_after_capture ();
+  /* Report mass like offline, not raw record count.  */
+  if (!sorted_ranges_.empty ())
+    total_samples = total_mass_from_range_counts (sorted_ranges_);
+  else
+    total_samples = total_mass_from_address_frequencies (address_frequencies);
+  return true;
+}
+
+void
+live_branch_stack_reader::
+  materialize_address_frequencies_for_per_pc_correlate ()
+{
+  materialize_address_frequencies_from_ranges (address_frequencies);
+}
+
+void
+live_branch_stack_reader::finalize_profile_after_capture ()
+{
+  if (profile_addresses_are_file_offsets_)
+    return;
+
+  finalize_branch_stack_maps (
+    range_count_map, branch_count_map, target_mmaps, &sorted_touch_pcs_);
+
+  finalize_address_frequencies_with_mmaps (
+    address_frequencies, target_mmaps, &sorted_touch_pcs_);
+  target_mmaps.clear ();
+  target_mmaps.shrink_to_fit ();
+  profile_addresses_are_file_offsets_ = true;
+}
+
+uint64_t
+live_branch_stack_reader::translate_address (uint64_t runtime_addr) const
+{
+  if (profile_addresses_are_file_offsets_)
+    return runtime_addr;
+  return translate_runtime_with_mmaps (target_mmaps, runtime_addr);
+}
+
+} /* namespace perf_data.  */
