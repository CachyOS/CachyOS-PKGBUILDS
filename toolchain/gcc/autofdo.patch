+# but WITHOUT ANY WARRANTY; without even the implied warranty of
+# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+# GNU General Public License for more details.
+#
+# You should have received a copy of the GNU General Public License
+# along with GCC; see the file COPYING3.  If not see
+# <http://www.gnu.org/licenses/>.
+
+# AFDO-TOOLS testsuite that uses the `afdo.exp' driver.
+
+# Load support procs.
+load_lib afdo.exp
+
+if { ![info exists GCC_UNDER_TEST] || $GCC_UNDER_TEST eq "" } {
+    unresolved "afdo-test: no in-tree xgcc (build gcc next to afdo_tools)"
+    return
+}
+
+# Initialize `dg'.
+dg-init
+
+# Make assigns one test stem to each parallel runtest worker.
+set afdo_test_stem ""
+if { [info exists env(AFDO_TEST_STEM)] && $env(AFDO_TEST_STEM) ne "" } {
+    set afdo_test_stem $env(AFDO_TEST_STEM)
+}
+
+# Main loop.
+foreach file [lsort \
+	[concat \
+	    [glob -nocomplain $srcdir/$subdir/*.c] \
+	    [glob -nocomplain $srcdir/$subdir/*.cc]]] {
+    if { ![runtest_file_p $runtests $file] } {
+	continue
+    }
+    set fields [afdo_parse_directives $file]
+    # Secondary sources (e.g. *-tu2.c) have no dg-afdo-entry.
+    if { ![dict exists $fields entry] } {
+	continue
+    }
+    set stem [file rootname [file tail $file]]
+    foreach src [afdo_expand_sources $fields] {
+	set label $stem
+	if { $src ne "-" && $src ne "auto" } {
+	    set label "$stem.$src"
+	}
+	if { $afdo_test_stem ne "" && $afdo_test_stem ne $stem
+	     && $afdo_test_stem ne $label } {
+	    continue
+	}
+	afdo_run_instance $file $src
+    }
+}
+
+# All done.
+dg-finish
