+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_reader.h"
+#include "gcov.h"
+#include "gcov_io.h"
+#include "file_mmap.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <map>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace gcov {
+
+using v4::read_be16;
+using v4::read_be32;
+using v4::read_be56;
+using v4::read_be64;
+using v4::read_be8;
+using v4::read_disc;
+using v4::read_int32;
+using v4::read_line_offset;
+using v4::read_str;
+using v4::read_wide_int;
+
+namespace {
+
+struct section_directory_entry
+{
+  uint64_t offset = 0;
+  uint64_t size = 0;
+  uint8_t bitmask = 0;
+};
+
+/* Rebuild a per-TU string table (index -> string) from a serialized
+   path-compressed trie.  TABLE is pre-sized by the caller to the section's
+   declared string count; the ids are consecutive, so a terminal id at or past
+   that size means the section is corrupt.  */
+void
+deserialize_trie (const uint8_t *&cur, const uint8_t *end,
+		  const std::string &prefix, std::vector<std::string> &table)
+{
+  const uint8_t flags = read_be8 (cur, end);
+  const bool is_terminal = (flags >> 7) & 1;
+  const uint8_t num_children = flags & 0x7F;
+
+  if (is_terminal)
+    {
+      const uint32_t tid = read_be32 (cur, end);
+      if (tid >= table.size ())
+	{
+	  v4::set_decode_error ("v4: trie terminal id past string count");
+	  return;
+	}
+      table[tid] = prefix;
+    }
+
+  for (uint8_t i = 0; i < num_children && !v4::decode_failed (); ++i)
+    {
+      const uint16_t label_len = read_be16 (cur, end);
+      if (cur + label_len > end)
+	{
+	  v4::set_decode_error ("v4: trie edge label past end");
+	  return;
+	}
+      std::string label (reinterpret_cast<const char *> (cur), label_len);
+      cur += label_len;
+      deserialize_trie (cur, end, prefix + label, table);
+    }
+}
+
+} /* anonymous namespace.  */
+
+/* num_locs, then each location.  Builds gcov_location_{normal,call,inline} into
+   FUNC.LOCATIONS.  */
+void
+gcov_reader_v4::read_locations (const uint8_t *&cur, const uint8_t *end,
+				bool compact, gcov_function &func)
+{
+  const uint32_t num_locs = read_int32 (cur, end, compact);
+  func.locations.reserve (num_locs);
+  for (uint32_t i = 0; i < num_locs && !v4::decode_failed (); ++i)
+    {
+      const uint8_t bitmask = read_be8 (cur, end);
+      const uint8_t type = bitmask & 0x7F;
+      const bool has_disc = (bitmask >> 7) & 1;
+      const uint32_t line = read_line_offset (cur, end, compact);
+      const uint32_t disc = has_disc ? read_disc (cur, end, compact) : 0;
+
+      std::unique_ptr<gcov_location> loc;
+      switch (type)
+	{
+	case v4::LOCATION_ZERO:
+	  loc = std::make_unique<gcov_location_normal> (0);
+	  break;
+	case v4::LOCATION_NORMAL:
+	  loc = std::make_unique<gcov_location_normal> (
+	    read_int32 (cur, end, compact));
+	  break;
+	case v4::LOCATION_WIDE:
+	  loc = std::make_unique<gcov_location_normal> (
+	    read_wide_int (cur, end, compact));
+	  break;
+	case v4::LOCATION_CALLED_FN:
+	  {
+	    const uint32_t idx = read_int32 (cur, end, compact);
+	    const uint64_t cnt = read_wide_int (cur, end, compact);
+	    if (lazy_resolve_)
+	      lazy_resolve_ (idx);
+	    auto call = std::make_unique<gcov_location_call> (cnt);
+	    call->callee_map[idx] = cnt;
+	    loc = std::move (call);
+	    break;
+	  }
+	case v4::LOCATION_CALLED_FNS:
+	  {
+	    const uint32_t n = read_int32 (cur, end, compact);
+	    auto call = std::make_unique<gcov_location_call> ();
+	    uint64_t sum = 0;
+	    for (uint32_t j = 0; j < n; ++j)
+	      {
+		const uint32_t idx = read_int32 (cur, end, compact);
+		const uint64_t cnt = read_wide_int (cur, end, compact);
+		if (lazy_resolve_)
+		  lazy_resolve_ (idx);
+		call->callee_map[idx] = cnt;
+		sum += cnt;
+	      }
+	    call->count = sum;
+	    loc = std::move (call);
+	    break;
+	  }
+	case v4::LOCATION_INLINED_FN:
+	  {
+	    const uint32_t idx = read_int32 (cur, end, compact);
+	    auto inl = std::make_unique<gcov_location_inline> ();
+	    inl->inlined_sym.id = idx;
+	    if (lazy_resolve_)
+	      lazy_resolve_ (idx);
+	    if (idx < profile.function_names.size ())
+	      inl->inlined_sym.desc.name_index = idx;
+	    read_locations (cur, end, compact, inl->inlined_sym);
+	    inl->inlined_sym.total_count
+	      = gcov_function_subtree_count (inl->inlined_sym);
+	    loc = std::move (inl);
+	    break;
+	  }
+	default:
+	  {
+	    /* Forward-compat: unknown types carry a trailing-size word.  */
+	    const uint32_t trailing = read_int32 (cur, end, compact);
+	    if (cur + trailing > end)
+	      {
+		v4::set_decode_error ("v4: unknown location trailing past end");
+		return;
+	      }
+	    cur += trailing;
+	    continue;
+	  }
+	}
+      loc->offset = line;
+      loc->discriminator = disc;
+      func.locations.push_back (std::move (loc));
+    }
+}
+
+/* SUMMARY section body, shared by the full and lazy readers.  */
+void
+gcov_reader_v4::parse_summary (const uint8_t *&cur, const uint8_t *end,
+			       bool compact, gcov_summary &s)
+{
+  s.total_count = read_wide_int (cur, end, compact);
+  s.max_count = read_wide_int (cur, end, compact);
+  s.max_function_count = read_wide_int (cur, end, compact);
+  s.num_counts = read_wide_int (cur, end, compact);
+  s.num_functions = read_wide_int (cur, end, compact);
+  s.num_detailed_entries = read_wide_int (cur, end, compact);
+  s.detailed_entries.resize (s.num_detailed_entries);
+  for (auto &e : s.detailed_entries)
+    {
+      e.cutoff = read_int32 (cur, end, compact);
+      e.min_count = read_wide_int (cur, end, compact);
+      e.num_counts = read_wide_int (cur, end, compact);
+    }
+}
+
+/* FILE_NAMES section body, shared by the full and lazy readers.  */
+void
+gcov_reader_v4::parse_file_entries (const uint8_t *&cur, const uint8_t *end,
+				    bool compact, std::vector<file_entry> &fes)
+{
+  const uint32_t n = read_int32 (cur, end, compact);
+  fes.resize (n);
+  for (auto &fe : fes)
+    {
+      fe.name = read_str (cur, end, compact);
+      fe.string_table_section = read_int32 (cur, end, compact);
+      fe.symbol_names_section = read_int32 (cur, end, compact);
+      fe.symbol_id_begin = read_int32 (cur, end, compact);
+      fe.symbol_id_end = read_int32 (cur, end, compact);
+    }
+}
+
+/* Parse a v4 binary profile.  With an empty WANT_PATH this is a full read: all
+   file groups are materialized and functions are emitted in section-index order
+   (the writer's order, so re-emission is byte-identical).  Otherwise it is a
+   partial, per-TU read: only the metadata plus the SYMBOL_INFO of the TU whose
+   file name matches WANT_PATH (by basename, or realpath when IS_REALPATH) and,
+   via the reverse inline index, its cross-module inliners.  The per-TU
+   STRING_TABLE / SYMBOL_NAMES groups are then deserialized on demand.
+   set_partial_files () selects an analogous partial read keyed by a list of
+   file names rather than a single path.  */
+bool
+gcov_reader_v4::read_binary (const uint8_t *base, size_t size,
+			     const std::string &want_path, bool is_realpath)
+{
+  const uint8_t *cur = base, *end = base + size;
+  if (size < 16 || read_be32 (cur, end) != v4::format::GCOV_MAGIC)
+    {
+      fprintf (stderr, "Error: invalid v4 magic\n");
+      return false;
+    }
+  magic = v4::format::GCOV_MAGIC;
+  version = read_be32 (cur, end);
+  if (version != v4::format::GCOV_VERSION)
+    {
+      fprintf (
+	stderr, "Error: unsupported v4 version %u\n", (unsigned) version);
+      return false;
+    }
+  read_be8 (
+    cur, end); /* Reserved byte; compactness is per-section (bitmask).  */
+  const uint64_t total_sections = read_be56 (cur, end);
+  std::vector<section_directory_entry> section_directory (total_sections);
+  for (uint64_t i = 0; i < total_sections; ++i)
+    {
+      section_directory[i].offset = read_be64 (cur, end);
+      section_directory[i].size = read_be56 (cur, end);
+      section_directory[i].bitmask = read_be8 (cur, end);
+    }
+
+  auto section_bounds = [&] (uint64_t section_index,
+			     const uint8_t *&section_body,
+			     const uint8_t *&section_end,
+			     bool &compact) -> bool {
+    if (section_index >= total_sections)
+      return false;
+    const section_directory_entry &section = section_directory[section_index];
+    if (section.offset > size || section.size == 0
+	|| section.size > size - section.offset)
+      return false;
+    const uint8_t *section_start = base + section.offset;
+    section_end = section_start + section.size;
+    compact = (section.bitmask & v4::SECTION_COMPACT_FLAG) != 0;
+    section_body = section_start + 1;
+    return true;
+  };
+
+  const bool partial = !want_path.empty () || partial_;
+
+  /* Phase A: the light metadata -- summary, file names, and the inline-index
+     directory.  Per-TU STRING_TABLE / SYMBOL_NAMES are read by load_group.  */
+  std::vector<file_entry> file_entries;
+  std::map<uint32_t, uint32_t> inline_index_sections;
+  for (uint64_t i = 0; i < total_sections; ++i)
+    {
+      const uint8_t *body, *section_end;
+      bool compact;
+      if (!section_bounds (i, body, section_end, compact))
+	continue;
+      const uint8_t section_type = section_directory[i].bitmask & 0x7F;
+      if (section_type == v4::SECTION_SUMMARY_INFO)
+	parse_summary (body, section_end, compact, profile.summary);
+      else if (section_type == v4::SECTION_FILE_NAMES)
+	parse_file_entries (body, section_end, compact, file_entries);
+      else if (section_type == v4::SECTION_INLINE_INDEX_TABLE)
+	{
+	  const uint32_t n = read_int32 (body, section_end, compact);
+	  for (uint32_t k = 0; k < n; ++k)
+	    {
+	      const uint32_t file_id = read_int32 (body, section_end, compact);
+	      const uint32_t section_index
+		= read_int32 (body, section_end, compact);
+	      inline_index_sections[file_id] = section_index;
+	    }
+	}
+    }
+
+  if (partial && file_entries.empty ())
+    {
+      fprintf (stderr, "Error: v4 partial read: no file names\n");
+      return false;
+    }
+
+  uint32_t total_symbols = 0;
+  for (const auto &fe : file_entries)
+    total_symbols = std::max (total_symbols, fe.symbol_id_end);
+  profile.function_names.assign (total_symbols, std::string ());
+  profile.file_name_map.assign (total_symbols, INVALID_INDEX);
+  if (!file_entries.empty ())
+    {
+      profile.file_names.resize (file_entries.size () - 1);
+      for (size_t g = 1; g < file_entries.size (); ++g)
+	profile.file_names[g - 1] = file_entries[g].name;
+    }
+  std::vector<uint32_t> info_section (total_symbols, INVALID_INDEX);
+
+  std::vector<uint32_t> id_to_group (total_symbols, INVALID_INDEX);
+  for (uint32_t g = 0; g < file_entries.size (); ++g)
+    for (uint32_t id = file_entries[g].symbol_id_begin;
+	 id < file_entries[g].symbol_id_end;
+	 ++id)
+      if (id < total_symbols)
+	id_to_group[id] = g;
+
+  std::vector<bool> group_loaded (file_entries.size (), false);
+  auto load_group = [&] (uint32_t g) {
+    if (g >= file_entries.size () || group_loaded[g])
+      return;
+    group_loaded[g] = true;
+    const file_entry &fe = file_entries[g];
+    std::vector<std::string> strings;
+    const uint8_t *body, *section_end;
+    bool compact;
+    if (section_bounds (fe.string_table_section, body, section_end, compact))
+      {
+	const uint32_t num_strings = read_int32 (body, section_end, compact);
+	strings.resize (num_strings);
+	deserialize_trie (body, section_end, "", strings);
+      }
+    if (section_bounds (fe.symbol_names_section, body, section_end, compact))
+      {
+	const uint32_t n = read_int32 (body, section_end, compact);
+	for (uint32_t k = 0; k < n; ++k)
+	  {
+	    const uint32_t nsi = read_int32 (body, section_end, compact);
+	    const uint32_t sid = read_int32 (body, section_end, compact);
+	    const uint32_t isec = read_int32 (body, section_end, compact);
+	    if (sid >= total_symbols)
+	      continue;
+	    if (nsi < strings.size ())
+	      profile.function_names[sid] = strings[nsi];
+	    profile.file_name_map[sid] = (g == 0) ? INVALID_INDEX : (g - 1);
+	    info_section[sid] = isec;
+	  }
+      }
+  };
+
+  lazy_resolve_ = [&] (uint32_t id) {
+    const uint32_t g
+      = id < id_to_group.size () ? id_to_group[id] : INVALID_INDEX;
+    if (g != INVALID_INDEX)
+      load_group (g);
+  };
+
+  /* Select which functions to parse.  */
+  std::vector<uint32_t> wanted_ids;
+  if (!partial)
+    {
+      /* Full read: materialize every group and take every top-level symbol.  */
+      for (uint32_t g = 0; g < file_entries.size (); ++g)
+	load_group (g);
+      for (uint32_t id = 0; id < total_symbols; ++id)
+	if (info_section[id] != INVALID_INDEX)
+	  wanted_ids.push_back (id);
+    }
+  else
+    {
+      /* Partial read: the wanted groups are those whose file name matches
+	 WANT_PATH (by basename, or realpath when IS_REALPATH), or -- when
+	 driven by set_partial_files () -- those named in partial_files_.  */
+      auto basename_of = [] (const std::string &s) -> std::string {
+	const size_t pos = s.find_last_of ('/');
+	return pos == std::string::npos ? s : s.substr (pos + 1);
+      };
+      const std::string want
+	= is_realpath ? want_path : basename_of (want_path);
+      auto group_wanted = [&] (const std::string &fn) -> bool {
+	if (!want_path.empty ())
+	  return (is_realpath ? fn : basename_of (fn)) == want;
+	for (const std::string &w : partial_files_)
+	  if (fn == w)
+	    return true;
+	return false;
+      };
+      for (uint32_t g = 1; g < file_entries.size (); ++g)
+	{
+	  if (!group_wanted (file_entries[g].name))
+	    continue;
+	  load_group (g);
+	  for (uint32_t id = file_entries[g].symbol_id_begin;
+	       id < file_entries[g].symbol_id_end;
+	       ++id)
+	    if (id < total_symbols && info_section[id] != INVALID_INDEX)
+	      wanted_ids.push_back (id);
+	  /* Pull this file's cross-module inliners via its INLINE_INDICES
+	     sub-section, read on demand.  */
+	  auto inline_index_it = inline_index_sections.find (g);
+	  const uint8_t *inline_body, *inline_end;
+	  bool inline_compact;
+	  if (inline_index_it != inline_index_sections.end ()
+	      && section_bounds (inline_index_it->second,
+				 inline_body,
+				 inline_end,
+				 inline_compact))
+	    {
+	      const uint32_t cnt
+		= read_int32 (inline_body, inline_end, inline_compact);
+	      for (uint32_t k = 0; k < cnt; ++k)
+		{
+		  const uint32_t inl
+		    = read_int32 (inline_body, inline_end, inline_compact);
+		  lazy_resolve_ (inl);
+		  if (inl < total_symbols && info_section[inl] != INVALID_INDEX)
+		    wanted_ids.push_back (inl);
+		}
+	    }
+	}
+    }
+
+  /* Emit in section-index order -- the writer's order -- for both the full and
+     partial reads, so re-emission is byte-identical and the two paths behave
+     identically.  Each symbol owns a distinct SYMBOL_INFO section, so this is a
+     total order; dedup first, as a partial read can reach an inliner twice.  */
+  std::sort (wanted_ids.begin (), wanted_ids.end ());
+  wanted_ids.erase (
+    std::unique (wanted_ids.begin (), wanted_ids.end ()), wanted_ids.end ());
+  std::sort (
+    wanted_ids.begin (), wanted_ids.end (), [&] (uint32_t a, uint32_t b) {
+      return info_section[a] < info_section[b];
+    });
+
+  profile.functions.reserve (wanted_ids.size ());
+  for (uint32_t id : wanted_ids)
+    {
+      const uint8_t *body, *section_end;
+      bool compact;
+      if (!section_bounds (info_section[id], body, section_end, compact))
+	continue;
+      lazy_resolve_ (id);
+      gcov_function func;
+      func.id = id;
+      func.desc.name_index = id;
+      const uint32_t fidx = profile.file_name_map[id];
+      func.desc.file_index
+	= (fidx < profile.file_names.size ()) ? fidx : INVALID_INDEX;
+      func.head_count = read_wide_int (body, section_end, compact);
+      func.timestamp = read_wide_int (body, section_end, compact);
+      read_locations (body, section_end, compact, func);
+      func.total_count = gcov_function_subtree_count (func);
+      profile.functions.push_back (std::move (func));
+    }
+  lazy_resolve_ = nullptr;
+
+  for (auto &func : profile.functions)
+    profile.function_map[func.id] = &func;
+
+  if (v4::decode_failed ())
+    {
+      fprintf (stderr, "Error: %s\n", v4::decode_message ());
+      return false;
+    }
+  return true;
+}
+
+bool
+gcov_reader_v4::read (std::string path_, bool is_realpath)
+{
+  afdo_tools::file_mmap fb;
+  if (!fb.map (path))
+    {
+      fprintf (stderr, "Error: cannot mmap %s\n", path.c_str ());
+      return false;
+    }
+  v4::clear_decode_error ();
+  return read_binary (fb.data (), fb.size (), path_, is_realpath);
+}
+
+bool
+gcov_reader_v4::read ()
+{
+  afdo_tools::file_mmap fb;
+  if (!fb.map (path))
+    {
+      fprintf (stderr, "Error: cannot mmap %s\n", path.c_str ());
+      return false;
+    }
+  const uint8_t *base = fb.data ();
+  const size_t size = fb.size ();
+
+  /* The format was already established by detect_format () / make_gcov_reader,
+     which sets is_text_ for a textual profile; no need to re-sniff here.  */
+  v4::clear_decode_error ();
+  if (is_text_)
+    return read_text (base, size);
+  return read_binary (base, size);
+}
+
+namespace {
+
+/* Minimal recursive-descent parser for the v4 textual format.  Symbols are
+   keyed by their name-pool index (the id in the header), so the parser fills
+   id -> name / id -> file maps and builds the gcov_function location trees;
+   the reader assembles the gcov_profile from those.  */
+struct text_parser
+{
+  const char *cur;
+  const char *end;
+  std::map<uint32_t, std::string> id_name;
+  std::map<uint32_t, int64_t> id_file; /* -1 => unknown  */
+
+  text_parser (const char *b, const char *e) : cur (b), end (e) {}
+
+  /* Every consuming method early-returns a default once !ok ().  */
+  void fail (const char *what) { v4::set_decode_error (what); }
+  bool ok () const { return !v4::decode_failed (); }
+  void skip_ws ()
+  {
+    while (cur < end
+	   && (*cur == ' ' || *cur == '\n' || *cur == '\t' || *cur == '\r'))
+      ++cur;
+  }
+  bool peek (char c)
+  {
+    skip_ws ();
+    return cur < end && *cur == c;
+  }
+  void expect (char c)
+  {
+    if (!ok ())
+      return;
+    skip_ws ();
+    if (cur >= end || *cur != c)
+      {
+	fail ("v4 text: unexpected character");
+	return;
+      }
+    ++cur;
+  }
+  void expect_word (const char *w)
+  {
+    if (!ok ())
+      return;
+    skip_ws ();
+    const size_t n = strlen (w);
+    /* The buffer is not NUL-terminated at the keyword, so compare a bounded
+       span with strncmp rather than strcmp.  */
+    if (static_cast<size_t> (end - cur) < n || strncmp (cur, w, n) != 0)
+      {
+	fail ("v4 text: expected keyword");
+	return;
+      }
+    cur += n;
+  }
+  uint64_t parse_uint ()
+  {
+    if (!ok ())
+      return 0;
+    skip_ws ();
+    if (cur >= end || *cur < '0' || *cur > '9')
+      {
+	fail ("v4 text: expected number");
+	return 0;
+      }
+    const char *start = cur;
+    while (cur < end && *cur >= '0' && *cur <= '9')
+      ++cur;
+    /* strtoull does not honour END and needs a NUL terminator, so convert the
+       bounded digit span from a temporary.  */
+    const std::string digits (start, cur);
+    return strtoull (digits.c_str (), nullptr, 10);
+  }
+  int64_t parse_int ()
+  {
+    if (!ok ())
+      return 0;
+    skip_ws ();
+    const char *start = cur;
+    if (cur < end && *cur == '-')
+      ++cur;
+    if (cur >= end || *cur < '0' || *cur > '9')
+      {
+	fail ("v4 text: expected number");
+	return 0;
+      }
+    while (cur < end && *cur >= '0' && *cur <= '9')
+      ++cur;
+    const std::string digits (start, cur);
+    return strtoll (digits.c_str (), nullptr, 10);
+  }
+  std::string parse_quoted ()
+  {
+    expect ('"');
+    if (!ok ())
+      return std::string ();
+    const char *s = cur;
+    while (cur < end && *cur != '"')
+      ++cur;
+    if (cur >= end)
+      {
+	fail ("v4 text: unterminated string");
+	return std::string ();
+      }
+    std::string r (s, cur);
+    ++cur; /* closing quote  */
+    return r;
+  }
+  std::string parse_word ()
+  {
+    if (!ok ())
+      return std::string ();
+    skip_ws ();
+    const char *s = cur;
+    while (cur < end && ((*cur >= 'a' && *cur <= 'z') || *cur == '_'))
+      ++cur;
+    return std::string (s, cur);
+  }
+  /* LOCATION = number (. number)?  */
+  void parse_loc (uint32_t *line, uint32_t *disc)
+  {
+    *line = static_cast<uint32_t> (parse_uint ());
+    *disc = 0;
+    if (ok () && cur < end && *cur == '.')
+      {
+	++cur;
+	*disc = static_cast<uint32_t> (parse_uint ());
+      }
+  }
+
+  /* Parse the section list of a function body into FUNC.LOCATIONS.  */
+  void parse_sections (gcov_function &func)
+  {
+    expect ('{');
+    while (!peek ('}') && ok ())
+      {
+	const std::string sect = parse_word ();
+	expect ('=');
+	expect ('{');
+	if (sect == "locations")
+	  {
+	    while (!peek ('}') && ok ())
+	      {
+		uint32_t line, disc;
+		parse_loc (&line, &disc);
+		expect ('=');
+		const uint64_t cnt = parse_uint ();
+		auto loc = std::make_unique<gcov_location_normal> (cnt);
+		loc->offset = line;
+		loc->discriminator = disc;
+		func.locations.push_back (std::move (loc));
+		if (peek (','))
+		  expect (',');
+	      }
+	    expect ('}');
+	  }
+	else if (sect == "callsites")
+	  {
+	    while (!peek ('}') && ok ())
+	      {
+		uint32_t line, disc;
+		parse_loc (&line, &disc);
+		expect ('-');
+		expect ('>');
+		expect ('{');
+		auto call = std::make_unique<gcov_location_call> ();
+		uint64_t sum = 0;
+		while (!peek ('}') && ok ())
+		  {
+		    /* "name":id = count.  Register the callee name so the pool
+		       covers ICP-only ids (else the name is lost and the id can
+		       exceed the name pool).  */
+		    const std::string tname = parse_quoted ();
+		    expect (':');
+		    const uint64_t id = parse_uint ();
+		    expect ('=');
+		    const uint64_t c = parse_uint ();
+		    if (id_name.find (id) == id_name.end ())
+		      id_name[id] = tname;
+		    call->callee_map[id] = c;
+		    sum += c;
+		    if (peek (','))
+		      expect (',');
+		  }
+		expect ('}');
+		call->count = sum;
+		call->offset = line;
+		call->discriminator = disc;
+		func.locations.push_back (std::move (call));
+		if (peek (','))
+		  expect (',');
+	      }
+	    expect ('}');
+	  }
+	else if (sect == "inlined")
+	  {
+	    while (!peek ('}') && ok ())
+	      {
+		uint32_t line, disc;
+		parse_loc (&line, &disc);
+		expect ('=');
+		auto inl = std::make_unique<gcov_location_inline> ();
+		parse_inlined_header (inl->inlined_sym);
+		parse_sections (inl->inlined_sym);
+		inl->inlined_sym.total_count
+		  = gcov_function_subtree_count (inl->inlined_sym);
+		inl->offset = line;
+		inl->discriminator = disc;
+		func.locations.push_back (std::move (inl));
+		if (peek (','))
+		  expect (',');
+	      }
+	    expect ('}');
+	  }
+	else
+	  {
+	    /* Forward-compat: skip an unknown section by brace matching.  */
+	    int depth = 1;
+	    while (cur < end && depth > 0)
+	      {
+		if (*cur == '{')
+		  ++depth;
+		else if (*cur == '}')
+		  --depth;
+		++cur;
+	      }
+	  }
+	if (peek (','))
+	  expect (',');
+      }
+    expect ('}');
+  }
+
+  /* "name":file_id(id:total) for an inlined callee.  */
+  void parse_inlined_header (gcov_function &func)
+  {
+    const std::string name = parse_quoted ();
+    expect (':');
+    const int64_t file_id = parse_int ();
+    expect ('(');
+    const uint32_t id = static_cast<uint32_t> (parse_uint ());
+    expect (':');
+    (void) parse_uint (); /* total (recomputed)  */
+    expect (')');
+    func.id = id;
+    id_name[id] = name;
+    id_file[id] = file_id;
+    expect ('=');
+  }
+
+  /* "name":file_id(id:total:head:ts) = { ... } for a top-level function.  */
+  bool parse_symbol (gcov_function &func)
+  {
+    skip_ws ();
+    if (cur >= end || *cur != '"')
+      return false;
+    const std::string name = parse_quoted ();
+    expect (':');
+    const int64_t file_id = parse_int ();
+    expect ('(');
+    const uint32_t id = static_cast<uint32_t> (parse_uint ());
+    expect (':');
+    (void) parse_uint (); /* total (recomputed)  */
+    expect (':');
+    const uint64_t head = parse_uint ();
+    expect (':');
+    const uint64_t ts = parse_uint ();
+    expect (')');
+    expect ('=');
+    func.id = id;
+    func.head_count = head;
+    func.timestamp = ts;
+    id_name[id] = name;
+    id_file[id] = file_id;
+    parse_sections (func);
+    return true;
+  }
+};
+
+} /* anonymous namespace.  */
+
+bool
+gcov_reader_v4::read_text (const uint8_t *base, size_t size)
+{
+  text_parser p (reinterpret_cast<const char *> (base),
+		 reinterpret_cast<const char *> (base) + size);
+
+  /* filenames = { "a", "b", ... }  */
+  p.expect_word ("filenames");
+  p.expect ('=');
+  p.expect ('{');
+  while (!p.peek ('}') && p.ok ())
+    {
+      profile.file_names.push_back (p.parse_quoted ());
+      if (p.peek (','))
+	p.expect (',');
+    }
+  p.expect ('}');
+
+  /* summary = { ... }  */
+  p.expect_word ("summary");
+  p.expect ('=');
+  p.expect ('{');
+  gcov_summary &s = profile.summary;
+  auto kv = [&] (const char *key) -> uint64_t {
+    p.expect_word (key);
+    p.expect ('=');
+    const uint64_t v = p.parse_uint ();
+    if (p.peek (','))
+      p.expect (',');
+    return v;
+  };
+  s.total_count = kv ("total_count");
+  s.max_count = kv ("max_count");
+  s.max_function_count = kv ("max_fn_count");
+  s.num_counts = kv ("num_counts");
+  s.num_functions = kv ("num_functions");
+  s.num_detailed_entries = kv ("num_detailed_entries");
+  p.expect_word ("detailed_entries");
+  p.expect ('=');
+  p.expect ('{');
+  while (!p.peek ('}') && p.ok ())
+    {
+      p.expect ('{');
+      gcov_summary_detailed_entry e{};
+      p.expect_word ("cutoff");
+      p.expect ('=');
+      e.cutoff = static_cast<uint32_t> (p.parse_uint ());
+      p.expect (',');
+      p.expect_word ("min_count");
+      p.expect ('=');
+      e.min_count = p.parse_uint ();
+      p.expect (',');
+      p.expect_word ("num_counts");
+      p.expect ('=');
+      e.num_counts = p.parse_uint ();
+      p.expect ('}');
+      s.detailed_entries.push_back (e);
+      if (p.peek (','))
+	p.expect (',');
+    }
+  p.expect ('}'); /* detailed_entries  */
+  p.expect ('}'); /* summary  */
+
+  /* Symbols.  */
+  std::vector<gcov_function> funcs;
+  while (p.ok ())
+    {
+      p.skip_ws ();
+      if (p.cur >= p.end)
+	break;
+      gcov_function func;
+      if (!p.parse_symbol (func))
+	break;
+      func.total_count = gcov_function_subtree_count (func);
+      funcs.push_back (std::move (func));
+    }
+
+  if (v4::decode_failed ())
+    {
+      fprintf (stderr, "Error: %s\n", v4::decode_message ());
+      return false;
+    }
+
+  /* Size the name/file pools from every id seen (top-level + inlined).  */
+  uint32_t max_id = 0;
+  for (const auto &kvp : p.id_name)
+    max_id = std::max (max_id, kvp.first);
+  profile.function_names.assign (max_id + 1, std::string ());
+  profile.file_name_map.assign (max_id + 1, INVALID_INDEX);
+  for (const auto &kvp : p.id_name)
+    profile.function_names[kvp.first] = kvp.second;
+  for (const auto &kvp : p.id_file)
+    profile.file_name_map[kvp.first]
+      = kvp.second < 0 ? INVALID_INDEX : static_cast<uint32_t> (kvp.second);
+
+  profile.functions = std::move (funcs);
+
+  /* Inlined nodes were built before the name pool existed.  Set their display
+     names now (the binary reader does this inline).  */
+  std::function<void (gcov_function &)> fixup_inlined_names
+    = [&] (gcov_function &f) {
+	for (auto &loc : f.locations)
+	  if (loc->type == gcov_location::kind::inlined)
+	    {
+	      auto *inl = static_cast<gcov_location_inline *> (loc.get ());
+	      if (inl->inlined_sym.id < profile.function_names.size ())
+		inl->inlined_sym.desc.name_index = inl->inlined_sym.id;
+	      fixup_inlined_names (inl->inlined_sym);
+	    }
+      };
+
+  for (auto &func : profile.functions)
+    {
+      fixup_inlined_names (func);
+      func.desc.name_index = func.id;
+      const uint32_t fidx = profile.file_name_map[func.id];
+      func.desc.file_index
+	= (fidx < profile.file_names.size ()) ? fidx : INVALID_INDEX;
+      profile.function_map[func.id] = &func;
+    }
+
+  version = v4::format::GCOV_VERSION;
+  return true;
+}
+
+} /* namespace gcov.  */
