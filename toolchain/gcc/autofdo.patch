+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+namespace autofdo {
+
+struct profiler_run_options;
+
+namespace correlate_detail {
+
+constexpr uint64_t DENSE_ADDR_MASS_MAX_SPAN = 1ull << 18;
+constexpr size_t NO_SYMTAB_INDEX = std::numeric_limits<size_t>::max ();
+
+using hot_symbol_set
+  = std::unordered_set<dwarf_debug::function_instance_key,
+		       dwarf_debug::function_instance_key_hash>;
+
+struct per_function_profile_maps
+{
+  uint64_t start_addr = 0;
+  uint64_t end_addr = 0;
+  uint64_t incoming_entry_count = 0;
+  perf_data::branch_stack_edge_count_map range_count_map;
+  perf_data::branch_stack_edge_count_map branch_count_map;
+  std::unordered_map<uint64_t, uint64_t> addr_counts;
+};
+
+struct correlate_target
+{
+  dwarf_debug::interned_string func_name = nullptr;
+  uint64_t start_addr = 0;
+  uint64_t end_addr = 0;
+  size_t symtab_index = NO_SYMTAB_INDEX;
+  per_function_profile_maps maps;
+  std::vector<uint64_t> line_span_anchor_pcs;
+  size_t estimated_work = 0;
+  function_profile *func_profile = nullptr;
+};
+
+struct correlate_context
+{
+  dwarf_debug::dwarf_reader &reader;
+  std::vector<correlate_target> targets;
+  hot_symbol_set emitted_hot_symbols;
+  unsigned num_threads = 0;
+  unsigned range_mass_addr_step = 1;
+
+  explicit correlate_context (dwarf_debug::dwarf_reader &dw) : reader (dw) {}
+};
+
+struct inline_path_cache_entry;
+
+struct instruction_map_entry
+{
+  bool valid = false;
+  dwarf_debug::source_location loc;
+  const std::vector<dwarf_debug::source_location> *locations = nullptr;
+  const std::vector<dwarf_debug::inline_frame> *inline_stack = nullptr;
+  uint64_t inline_stack_hash = 0;
+  inline_path_cache_entry *inline_path = nullptr;
+};
+
+struct function_inst_map
+{
+  uint64_t base = 0;
+  std::vector<instruction_map_entry> dense;
+  std::unordered_map<uint64_t, instruction_map_entry> sparse;
+
+  bool dense_p () const { return !dense.empty (); }
+  static function_inst_map make (uint64_t start, uint64_t end);
+  instruction_map_entry &operator[] (uint64_t addr);
+};
+
+struct inline_path_cache_key
+{
+  inline_path_cache_key (const std::vector<dwarf_debug::inline_frame> &stack,
+			 uint64_t stack_hash)
+    : inline_stack (&stack), inline_stack_hash (stack_hash)
+  {}
+
+  const std::vector<dwarf_debug::inline_frame> *inline_stack;
+  uint64_t inline_stack_hash;
+
+  bool operator== (const inline_path_cache_key &o) const noexcept
+  {
+    if (inline_stack_hash != o.inline_stack_hash)
+      return false;
+    if (inline_stack == o.inline_stack)
+      return true;
+    return dwarf_debug::inline_stacks_equal (*inline_stack, *o.inline_stack);
+  }
+};
+
+struct inline_path_cache_key_hash
+{
+  size_t operator () (const inline_path_cache_key &k) const noexcept
+  {
+    return static_cast<size_t> (k.inline_stack_hash);
+  }
+};
+
+struct inline_path_cache_entry
+{
+  function_builder *leaf_builder = nullptr;
+  std::vector<function_builder *> path;
+};
+
+using inline_path_cache
+  = std::unordered_map<inline_path_cache_key,
+		       inline_path_cache_entry,
+		       inline_path_cache_key_hash>;
+
+struct range_mass_coalesce_key
+{
+  const std::vector<dwarf_debug::source_location> *locations = nullptr;
+  const std::vector<dwarf_debug::inline_frame> *inline_stack = nullptr;
+  uint64_t locations_hash = 0;
+  uint64_t inline_stack_hash = 0;
+
+  bool operator== (const range_mass_coalesce_key &o) const noexcept;
+};
+
+struct range_mass_coalesce_key_hash
+{
+  size_t operator() (const range_mass_coalesce_key &k) const noexcept
+  {
+    size_t h = static_cast<size_t> (k.locations_hash);
+    hash_combine (h, static_cast<size_t> (k.inline_stack_hash));
+    return h;
+  }
+};
+
+using range_mass_visitor = std::function<void (uint64_t, uint64_t)>;
+
+bool bucket_and_select_targets (correlate_context &,
+				const perf_data::profile_reader &,
+				const profiler_run_options &);
+void materialize_correlate_targets (correlate_context &, profile_builder &);
+size_t estimate_correlate_target_work (const correlate_target &, unsigned);
+void
+for_each_branch_stack_mass_pc (const perf_data::branch_stack_edge_count_map &,
+			       unsigned, const range_mass_visitor &);
+size_t run_correlate_target_workers (correlate_context &,
+				     dwarf_debug::correlate_symbolize_map *);
+
+} /* namespace correlate_detail.  */
+} /* namespace autofdo.  */
+
+#endif /* GCC_AUTOFDO_CORRELATE_DETAIL_H.  */
