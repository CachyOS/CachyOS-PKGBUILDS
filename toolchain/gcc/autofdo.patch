@@ -0,0 +1,76 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_AUTOFDO_PROFILER_H
+#define GCC_AUTOFDO_PROFILER_H
+
+#include "autofdo_model.h"
+#include "autofdo_options.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace dwarf_debug {
+class dwarf_reader;
+}
+
+namespace perf_data {
+class profile_reader;
+enum class sampling_mode : uint8_t;
+} /* namespace perf_data.  */
+
+namespace autofdo {
+
+/* Drive sample load, DWARF, correlate, then GCOV.  Offline perf.data and live
+   capture differ only in how profile_source_ is constructed.  */
+class autofdo_profiler
+{
+public:
+  autofdo_profiler (const std::string &binary_path,
+		    const profiler_run_options &run_opts,
+		    const std::string &perf_data_path,
+		    perf_data::sampling_mode sampling_mode);
+
+  /* Live capture via perf_event_open (command after --).  */
+  autofdo_profiler (const std::string &binary_path,
+		    const profiler_run_options &run_opts,
+		    std::vector<std::string> command_argv);
+
+  ~autofdo_profiler ();
+  autofdo_profiler (const autofdo_profiler &) = delete;
+  autofdo_profiler &operator= (const autofdo_profiler &) = delete;
+  autofdo_profiler (autofdo_profiler &&) = delete;
+  autofdo_profiler &operator= (autofdo_profiler &&) = delete;
+
+  bool generate_profile ();
+  const gcov::gcov_profile &get_gcov_profile () const { return gcov_out_; }
+
+private:
+  std::string binary_path_;
+  profiler_run_options run_opts_;
+  std::unique_ptr<perf_data::profile_reader> profile_source_;
+  std::unique_ptr<dwarf_debug::dwarf_reader> dwarf_reader_;
+  profile_builder profile_;
+  gcov::gcov_profile gcov_out_;
+};
+
+} /* namespace autofdo.  */
+
+#endif /* GCC_AUTOFDO_PROFILER_H.  */
