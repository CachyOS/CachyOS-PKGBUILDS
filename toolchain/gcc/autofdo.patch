+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_AFDO_TOOLS_GCOV_IO_H
+#define GCC_AFDO_TOOLS_GCOV_IO_H
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+/* True when COUNT items of SIZE bytes fit in LIMIT bytes.  */
+#define COUNT_FITS(COUNT, SIZE, LIMIT)					\
+  __extension__								\
+  ({ uint64_t product_;							\
+     !__builtin_mul_overflow ((COUNT), (SIZE), &product_)		\
+     && product_ <= (LIMIT); })
+
+/* True when COUNT items of SIZE bytes fit in the buffer [CUR, END).  */
+#define COUNT_FITS_IN_BUFFER(CUR, END, COUNT, SIZE)			\
+  ((CUR) <= (END)							\
+   && COUNT_FITS (COUNT, SIZE, static_cast<size_t> ((END) - (CUR))))
+
+namespace gcov {
+/* GCOV v3 IO primitives.  Raw host-endian words, and strings prefixed by a
+   length that counts the trailing NUL.  */
+void gcov_write_uint32 (FILE *file, uint32_t value);
+void gcov_write_uint64 (FILE *file, uint64_t value);
+void gcov_write_string (FILE *file, const std::string &str);
+
+bool gcov_read_uint32 (const uint8_t *&cur, const uint8_t *end,
+		       uint32_t &value);
+bool gcov_read_uint64 (const uint8_t *&cur, const uint8_t *end,
+		       uint64_t &value);
+bool gcov_read_string (const uint8_t *&cur, const uint8_t *end,
+		       std::string &out);
+
+} /* namespace gcov.  */
+
+#endif /* GCC_AFDO_TOOLS_GCOV_IO_H.  */
diff --git a/afdo-tools/src/gcov_summary.cc b/afdo-tools/src/gcov_summary.cc
new file mode 100644
index 00000000000..f2cdc4692ce
--- /dev/null
+++ b/afdo-tools/src/gcov_summary.cc
@@ -0,0 +1,126 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_summary.h"
+
+#include <cstdint>
+#include <functional>
+#include <map>
+
+namespace gcov {
+namespace {
+
+/* Cumulative profile-count targets in millionths of the total count.
+   For example, 10000 denotes 1 percent.  A consumer takes the first entry
+   at or above the percentile it asks for, so the steps tighten past 99
+   percent, where the remaining count sits on few positions.  */
+constexpr uint32_t SUMMARY_CUTOFFS[] = {10000,
+					100000,
+					200000,
+					300000,
+					400000,
+					500000,
+					600000,
+					700000,
+					800000,
+					900000,
+					950000,
+					990000,
+					999000,
+					999900,
+					999990,
+					999999};
+
+/* Count -> number of positions with that count, hottest first.  The cutoffs
+   are walked in descending count order.  */
+using count_histogram = std::map<uint64_t, uint64_t, std::greater<uint64_t>>;
+
+/* Fold every leaf position count of F (recursing into inline subtrees) into the
+   histogram FREQ and the running aggregates.  */
+void
+accumulate (const gcov_function &f, count_histogram &freq, uint64_t &total,
+	    uint64_t &max_count, uint64_t &num_counts)
+{
+  for (const auto &loc : f.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	{
+	  const gcov_location_inline *inl
+	    = static_cast<const gcov_location_inline *> (loc.get ());
+	  accumulate (inl->inlined_sym, freq, total, max_count, num_counts);
+	  continue;
+	}
+      const uint64_t c = loc->total_count ();
+      if (c == 0)
+	continue;
+      total = gcov_add_count (total, c);
+      if (c > max_count)
+	max_count = c;
+      ++num_counts;
+      ++freq[c];
+    }
+}
+
+} /* anonymous namespace.  */
+
+void
+compute_summary (const std::vector<gcov_function> &functions, gcov_summary &out)
+{
+  count_histogram freq;
+  uint64_t total = 0, max_count = 0, num_counts = 0, max_function_count = 0;
+  for (const auto &f : functions)
+    {
+      if (f.head_count > max_function_count)
+	max_function_count = f.head_count;
+      accumulate (f, freq, total, max_count, num_counts);
+    }
+
+  out.total_count = total;
+  out.max_count = max_count;
+  out.max_function_count = max_function_count;
+  out.num_counts = num_counts;
+  out.num_functions = static_cast<uint64_t> (functions.size ());
+
+  const unsigned n = sizeof (SUMMARY_CUTOFFS) / sizeof (SUMMARY_CUTOFFS[0]);
+  out.num_detailed_entries = n;
+  out.detailed_entries.assign (n, {});
+
+  auto it = freq.begin ();
+  const auto end = freq.end ();
+  uint64_t curr_sum = 0, counts_seen = 0, count = 0;
+  for (unsigned i = 0; i < n; ++i)
+    {
+      const uint32_t cutoff = SUMMARY_CUTOFFS[i];
+      const uint64_t remainder = (total % 1000000) * cutoff;
+      const uint64_t desired
+	= total / 1000000 * cutoff + (remainder + 999999) / 1000000;
+      while (curr_sum < desired && it != end)
+	{
+	  count = it->first;
+	  curr_sum = gcov_add_count
+	    (curr_sum, gcov_multiply_count (it->first, it->second));
+	  counts_seen = gcov_add_count (counts_seen, it->second);
+	  ++it;
+	}
+      out.detailed_entries[i].cutoff = cutoff;
+      out.detailed_entries[i].min_count = count;
+      out.detailed_entries[i].num_counts = counts_seen;
+    }
+}
+
+} /* namespace gcov.  */
