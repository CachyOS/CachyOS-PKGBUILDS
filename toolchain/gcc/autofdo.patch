+#ifndef GCC_PERF_SPE_READER_H
+#define GCC_PERF_SPE_READER_H
+
+#include "branch_stack_reader_base.h"
+#include "perf_file_reader.h"
+
+#include <cstdint>
+#include <string>
+
+namespace perf_data {
+
+/* Offline ARM SPE combines AUXTRACE branches with synthesized ranges.  */
+class perf_spe_reader : public perf_file_reader, public branch_stack_reader_base
+{
+public:
+  perf_spe_reader (const std::string &_perf_data_path,
+		   const std::string &_binary_path);
+  ~perf_spe_reader () override = default;
+
+  /* AArch64 instructions are four bytes wide.  */
+  unsigned range_mass_addr_step () const override { return 4; }
+
+  branch_stack_reader_base *as_branch_stack_reader () override { return this; }
+  const branch_stack_reader_base *as_branch_stack_reader () const override
+  {
+    return this;
+  }
+
+private:
+  /* Decoder callbacks.  CTX is the perf_spe_reader.  */
+  static bool set_context_cb (uint64_t context_id, uint64_t timestamp,
+			      void *ctx);
+  static bool translate_target_addr_cb (uint64_t runtime_addr,
+					uint64_t timestamp,
+					uint64_t *dwarf_addr, void *ctx);
+  static void note_timestamp_cb (uint64_t dwarf_addr, uint64_t timestamp,
+				 void *ctx);
+
+  /* Point ACTIVE_MMAPS_ at the mappings of the process the record belongs to.
+     False when the record is not the target's.  */
+  bool select_context (uint64_t context_id, uint64_t timestamp);
+
+  /* Put an SPE record timestamp on perf's timestamp scale.  */
+  bool spe_timestamp_to_perf_time (uint64_t timestamp,
+				   uint64_t *out_time) const;
+
+  /* Decode the AUXTRACE SPE payloads and synthesize range mass from them.  */
+  bool parse_perf_data_section () override;
+
+  /* Spread range mass over the instructions covered, for per-PC scoring.  */
+  void seed_address_frequencies_from_ranges ();
+
+  /* Mappings of the process the record being decoded came from.  The decoder
+     callbacks translate through them and it is null outside that decode.  */
+  const std::vector<executable_mapping> *active_mmaps_ = nullptr;
+
+  /* The process SELECT_CONTEXT last resolved, so that a run of records from
+     one process costs a single lookup.  */
+  uint32_t active_pid_ = 0;
+
+  /* CPU of the AUXTRACE chunk being decoded, which is the CPU its records
+     were sampled on.  */
+  uint32_t active_cpu_ = 0;
+  bool active_cpu_valid_ = false;
+  /* The schedule of ACTIVE_CPU_ names a process other than the targets, as
+     in a system-wide recording.  */
+  bool active_cpu_shared_ = false;
+
+  /* Used when neither a context packet nor the schedule names the process.
+     Zero when there is no single target to fall back on, and then the
+     records are dropped.  */
+  uint32_t fallback_pid_ = 0;
+  uint64_t unattributed_records_ = 0;
+  /* Records dropped because they cannot be placed in the schedule of a
+     shared CPU.  */
+  uint64_t unplaced_records_ = 0;
+  branch_stack_edge_count_map range_count_map_;
+  branch_stack_edge_count_map branch_count_map_;
+};
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_SPE_READER_H.  */
