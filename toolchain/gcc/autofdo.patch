+    prod = (prod + seed_b) ^ (i & 0xFFFF);
+  return prod;
+}
diff --git a/afdo_tools/testsuite/afdo-test/afdo-merge-multi-dso-profiles.c b/afdo_tools/testsuite/afdo-test/afdo-merge-multi-dso-profiles.c
new file mode 100644
index 00000000000..ed16b52f880
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/afdo-merge-multi-dso-profiles.c
@@ -0,0 +1,16 @@
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry merge } */
+/* { dg-afdo-sources lbr brbe spe } */
+/* { dg-afdo-workloads a b } */
+/* { dg-afdo-workload-dsos afdo-merge-dso-a.c afdo-merge-dso-b.c } */
+/* { dg-afdo-workload-drivers afdo-merge-dso-a-main.c afdo-merge-dso-b-main.c } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate merge-dump-tree } */
+/* { dg-afdo-merge-hot hot_func_a hot_func_b } */
+/* { dg-afdo-requires python3 perf } */
+
+/* Directives carrier only.  Two truly independent DSOs are profiled:
+ *   workload "a": driver_a links ONLY dso_a.so (hot_func_a), dso_b.so absent
+ *   workload "b": driver_b links ONLY dso_b.so (hot_func_b), dso_a.so absent
+ * afdo_merge combines both DSO profiles; validation checks that hot_func_a
+ * and hot_func_b are both present as hot headers in the merged dump.  */
diff --git a/afdo_tools/testsuite/afdo-test/afdo-merge-multi-workload.c b/afdo_tools/testsuite/afdo-test/afdo-merge-multi-workload.c
new file mode 100644
index 00000000000..b25791e6113
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/afdo-merge-multi-workload.c
@@ -0,0 +1,60 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry merge } */
+/* { dg-afdo-sources lbr brbe spe } */
+/* { dg-afdo-workloads add multiply } */
+/* { dg-afdo-post dump recompile } */
+/* { dg-afdo-validate merge-dump-tree } */
+/* { dg-afdo-merge-hot add_workload multiply_workload } */
+/* { dg-afdo-requires python3 perf } */
+
+/* Two distinct hot functions exercised by separate perf record runs:
+ *   ./prog add       -> add_workload dominates
+ *   ./prog multiply  -> multiply_workload dominates
+ * afdo_merge must preserve both hotness profiles in the merged gcov.  */
+
+#include <stdio.h>
+#include <string.h>
+
+volatile int seed = 7;
+
+__attribute__((noinline))
+int add_op(int a, int b)
+{
+  return a + b + seed;
+}
+
+__attribute__((noinline))
+int mul_op(int a, int b)
+{
+  return (a * (b | 1)) + seed;
+}
+
+__attribute__((noinline))
+int add_workload(int n)
+{
+  int sum = 0;
+  for (int i = 0; i < n; ++i)
+    sum = add_op(sum, i);
+  return sum;
+}
+
+__attribute__((noinline))
+int multiply_workload(int n)
+{
+  int prod = 1;
+  for (int i = 1; i <= n; ++i)
+    prod = mul_op(prod, i & 0xFFF);
+  return prod;
+}
+
+int main(int argc, char **argv)
+{
+  int result;
+  if (argc > 1 && strcmp(argv[1], "multiply") == 0)
+    result = multiply_workload(5000000);
+  else
+    result = add_workload(5000000);
+  printf("%d\n", result);
+  return 0;
+}
diff --git a/afdo_tools/testsuite/afdo-test/afdo-test.exp b/afdo_tools/testsuite/afdo-test/afdo-test.exp
new file mode 100644
index 00000000000..abcf35dd175
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/afdo-test.exp
@@ -0,0 +1,64 @@
+# Copyright The GNU Toolchain Authors.
+#
+# This program is free software; you can redistribute it and/or modify
+# it under the terms of the GNU General Public License as published by
+# the Free Software Foundation; either version 3 of the License, or
+# (at your option) any later version.
+#
