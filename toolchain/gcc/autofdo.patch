+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "dwarf_reader_impl.h"
+#include "symbol_util.h"
+#include "afdo_assert.h"
+
+#include <algorithm>
+#include <atomic>
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <dwarf.h>
+#include <elf.h>
+#include <elfutils/libdw.h>
+#include <gelf.h>
+#include <fcntl.h>
+#include <iterator>
+#include <libelf.h>
+#include <limits>
+#include <thread>
+#include <unordered_set>
+#include <unistd.h>
+
+namespace dwarf_debug {
+namespace {
+
+/* DW_AT_GNU_discriminator (GCC vendor attr; not in elfutils dwarf.h).  */
+constexpr Dwarf_Half DW_AT_CALL_DISCRIMINATOR_EXT = 0x2136;
+
+/* Retain ELF binding only while choosing the owner of aliased ranges.  */
+struct elf_func_sym
+{
+  function_metadata meta;
+  unsigned char bind = 0;
+};
+
+/* Sort merged subprogram rows for binary search; drop exact duplicates
+   only.  */
+void
+sort_dedupe_function_metadata (std::vector<function_metadata> &funcs)
+{
+  if (funcs.empty ())
+    return;
+  std::sort (funcs.begin (),
+	     funcs.end (),
+	     [] (const function_metadata &a, const function_metadata &b)
+	     {
+	       if (a.start_addr != b.start_addr)
+		 return a.start_addr < b.start_addr;
+	       if (a.end_addr != b.end_addr)
+		 return a.end_addr < b.end_addr;
+	       /* By name text: interned_string is a pointer, so ordering it
+		  directly would follow intern order and vary between runs of
+		  the parallel CU parse.  */
+	       return string_value (a.name) < string_value (b.name);
+	     });
+  funcs.erase (
+    std::unique (funcs.begin (),
+		 funcs.end (),
+		 [] (const function_metadata &a, const function_metadata &b)
+		 {
+		   return a.start_addr == b.start_addr
+			  && a.end_addr == b.end_addr && a.name == b.name;
+		 }),
+    funcs.end ());
+}
+
+/* True when NAME ends in a GCC clone suffix that symbol_base_name strips.  */
+bool
+has_gcc_generated_suffix (const std::string &name)
+{
+  return gcc_symbol::symbol_base_name (name) != name;
+}
+
+/* Normalize path separators and redundant "." components.  */
+std::string
+canonical_source_path (std::string path)
+{
+  if (path.empty ())
+    return path;
+  for (char &c : path)
+    if (c == '\\')
+      c = '/';
+  while (path.size () >= 2 && path[0] == '.' && path[1] == '/')
+    path.erase (0, 2);
+  for (;;)
+    {
+      const size_t pos = path.find ("/./");
+      if (pos == std::string::npos)
+	break;
+      path.erase (pos, 2);
+    }
+  for (;;)
+    {
+      const size_t pos = path.find ("//");
+      if (pos == std::string::npos)
+	break;
+      path.erase (pos, 1);
+    }
+  return path;
+}
+
+/* Build INDEX for RANGES, which must be sorted by start.  Each leaf stores
+   one range's end, and each internal node stores the maximum end below it.  */
+template <typename Range>
+void
+build_range_max_tree (const std::vector<Range> &ranges,
+		      range_max_tree_index &index)
+{
+  index.leaf_base = 1;
+  while (index.leaf_base < ranges.size ())
+    index.leaf_base *= 2;
+  index.max_ends.assign (index.leaf_base * 2, 0);
+  for (size_t i = 0; i < ranges.size (); ++i)
+    index.max_ends[index.leaf_base + i] = ranges[i].end;
+  for (size_t i = index.leaf_base; i-- > 1;)
+    index.max_ends[i]
+      = std::max (index.max_ends[i * 2], index.max_ends[i * 2 + 1]);
+}
+
+/* Visit candidate leaf indices below NODE.  Ignore indices at or beyond
+   RANGE_LIMIT and subtrees whose ranges all end at or before QUERY_START.
+   NODE covers indices from NODE_BEGIN up to but not including NODE_END.  */
+template <typename Visitor>
+void
+visit_range_max_tree (const range_max_tree_index &index, size_t node,
+		      size_t node_begin, size_t node_end, size_t range_limit,
+		      uint64_t query_start, Visitor &visitor)
+{
+  if (node_begin >= range_limit || index.max_ends[node] <= query_start)
+    return;
+  if (node >= index.leaf_base)
+    {
+      visitor (node - index.leaf_base);
+      return;
+    }
+  const size_t middle = node_begin + (node_end - node_begin) / 2;
+  visit_range_max_tree (
+    index, node * 2, node_begin, middle, range_limit, query_start, visitor);
+  visit_range_max_tree (
+    index, node * 2 + 1, middle, node_end, range_limit, query_start, visitor);
+}
+
+/* Call VISITOR with the index of every range overlapping the half-open range
+   from START to END.  RANGES must be sorted by start and INDEX must have been
+   built from it.  */
+template <typename Range, typename Visitor>
+void
+visit_overlapping_ranges (const std::vector<Range> &ranges,
+			  const range_max_tree_index &index, uint64_t start,
+			  uint64_t end, Visitor visitor)
+{
+  if (start >= end || ranges.empty ())
+    return;
+  const auto limit
+    = std::lower_bound (ranges.begin (),
+			ranges.end (),
+			end,
+			[] (const Range &range, uint64_t address)
+			{
+			  return range.start < address;
+			});
+  const size_t range_limit = static_cast<size_t> (limit - ranges.begin ());
+  visit_range_max_tree (
+    index, 1, 0, index.leaf_base, range_limit, start, visitor);
+}
+
+/* A DWARF file-table entry usable as a profile source file.  GCC also emits
+   pseudo-files (<built-in>, <artificial>) that name no source.  */
+bool
+dwarf_source_file_is_usable (const char *file)
+{
+  return file != nullptr && file[0] != '\0' && file[0] != '<';
+}
+
+/* ELF symtab entries treated as correlatable function ranges: STT_FUNC,
+   trailing .cold blocks, and .__part.N splits; reject @plt and size 0.  */
+bool
+symtab_accepts_function_symbol (const char *name, uint64_t size, int sym_type)
+{
+  if (name == nullptr || name[0] == '\0' || size == 0)
+    return false;
+
+  std::string sv (name);
+  if (gcc_symbol::has_suffix (sv, "@plt"))
+    return false;
+  if (sym_type == STT_FUNC || gcc_symbol::has_suffix (sv, ".cold"))
+    return true;
+
+  while (!sv.empty ()
+	 && std::isdigit (static_cast<unsigned char> (sv.back ())))
+    sv.pop_back ();
+  return gcc_symbol::has_suffix (sv, ".__part.");
+}
+
+/* True for a DW_AT_declaration DIE, that is, a declaration without a body.  */
+bool
+die_is_declaration (Dwarf_Die *die)
+{
+  Dwarf_Attribute decl_mem;
+  Dwarf_Attribute *decl_attr = dwarf_attr (die, DW_AT_declaration, &decl_mem);
+  if (decl_attr == nullptr)
+    return false;
+  bool flag = false;
+  return dwarf_formflag (decl_attr, &flag) == 0 && flag;
+}
+
+/* Resolve gcov symbol name: prefer linkage name, else DW_AT_name via
+   spec/abstract-origin chain.  */
+const char *
+resolve_die_symbol_name (Dwarf_Die *die)
+{
+  if (die == nullptr)
+    return nullptr;
+
+  const char *first_diename = nullptr;
+  Dwarf_Die cur = *die;
+  /* Cycle guard: a spec/abstract-origin reference must never revisit a DIE
+     we already walked (malformed/looping DWARF).  Well-formed chains are
+     1-3 deep, so this set stays tiny.  */
+  std::vector<Dwarf_Off> seen;
+  for (;;)
+    {
+      const Dwarf_Off off = dwarf_dieoffset (&cur);
+      if (std::find (seen.begin (), seen.end (), off) != seen.end ())
+	break;
+      seen.push_back (off);
+
+      /* Linkage name is the gcov key; the first one on the chain is the
+	 one.  */
+      Dwarf_Attribute link_mem;
+      Dwarf_Attribute *const link_attr
+	= dwarf_attr (&cur, DW_AT_linkage_name, &link_mem);
+      const char *const link
+	= link_attr == nullptr ? nullptr : dwarf_formstring (link_attr);
+      if (link != nullptr && link[0] != '\0')
+	return link;
+
+      const char *diename = dwarf_diename (&cur);
+      if (diename != nullptr && diename[0] != '\0' && first_diename == nullptr)
+	first_diename = diename;
+
+      /* Follow DW_AT_specification, else DW_AT_abstract_origin, to the next
+	 DIE in the chain (dwarf_formref_die rewrites cur); stop when
+	 neither.  */
+      Dwarf_Attribute attr_mem;
+      const bool advanced
+	= (dwarf_attr (&cur, DW_AT_specification, &attr_mem) != nullptr
+	   && dwarf_formref_die (&attr_mem, &cur) != nullptr)
+	  || (dwarf_attr (&cur, DW_AT_abstract_origin, &attr_mem) != nullptr
+	      && dwarf_formref_die (&attr_mem, &cur) != nullptr);
+      if (!advanced)
+	break;
+    }
+
+  return first_diename;
+}
+
+/* True if every child PC range lies inside some parent range.  */
+bool
+pc_ranges_subset_of (const pc_range_list &child, const pc_range_list &parent)
+{
+  if (child.empty ())
+    return false;
+  return std::all_of (child.begin (), child.end (), [&] (const auto &cr)
+  {
+    const uint64_t clo = cr.first;
+    const uint64_t chi = cr.second;
+    if (chi <= clo)
+      return true;
+    return std::any_of (parent.begin (), parent.end (), [&] (const auto &pr)
+    {
+      return pr.first <= clo && chi <= pr.second;
+    });
+  });
+}
+
+/* Unsigned value of ATTR_NAME on DIE, or 0 if absent or not udata-form.  */
+Dwarf_Word
+die_udata_attr (Dwarf_Die *die, Dwarf_Half attr_name)
+{
+  if (die == nullptr)
+    return 0;
+  Dwarf_Attribute attr_mem;
+  Dwarf_Attribute *attr = dwarf_attr (die, attr_name, &attr_mem);
+  Dwarf_Word value = 0;
+  if (attr == nullptr || dwarf_formudata (attr, &value) != 0)
+    return 0;
+  return value;
+}
+
+/* CU path for DW_AT_call_file, or null.  libdw's table is already indexed by
+   the raw attribute value (DWARF 5 from 0; earlier versions keep a dummy
+   row 0).  */
+const char *
+die_call_file_path (Dwarf_Die *die)
+{
+  Dwarf_Attribute attr_mem;
+  if (die == nullptr || dwarf_attr (die, DW_AT_call_file, &attr_mem) == nullptr)
+    return nullptr;
+  Dwarf_Word file_idx = 0;
+  if (dwarf_formudata (&attr_mem, &file_idx) != 0)
+    return nullptr;
+  Dwarf_Die cu_mem;
+  Dwarf_Die *cu = dwarf_diecu (die, &cu_mem, nullptr, nullptr);
+  Dwarf_Files *files = nullptr;
+  size_t nfiles = 0;
+  if (cu == nullptr || dwarf_getsrcfiles (cu, &files, &nfiles) != 0
+      || files == nullptr || file_idx >= nfiles)
+    return nullptr;
+  const char *path
+    = dwarf_filesrc (files, static_cast<size_t> (file_idx), nullptr, nullptr);
+  if (path == nullptr || path[0] == '\0')
+    return nullptr;
+  return path;
+}
+
+/* Decl line/file from the DIE, or its enclosing class/struct for artificial
+   members (e.g.  lambda operator()) that omit DW_AT_decl_*.  Prefer the
+   enclosing-type index; dwarf_getscopes_die is last resort.  */
+die_decl_site
+resolve_die_decl_site (
+  Dwarf_Die *die,
+  const std::unordered_map<Dwarf_Off, die_decl_site> *enclosing_by_die)
+{
+  die_decl_site info;
+  if (die == nullptr)
+    return info;
+
+  int ln = 0;
+  if (dwarf_decl_line (die, &ln) == 0 && ln > 0)
+    info.line_number = static_cast<uint32_t> (ln);
+  /* <artificial> / <built-in> are not source files; skip them so origin
+     and enclosing-type fallbacks can still run.  */
+  const char *file = dwarf_decl_file (die);
+  if (dwarf_source_file_is_usable (file))
+    info.file_path = file;
+  if (info.line_number != 0 && info.file_path != nullptr)
+    return info;
+
+  /* Follow the semantic declaration chain before asking for lexical scopes.
+     An inlined DIE is nested in its caller, not in the callee's declaring
+     type.  Prefer abstract_origin at each step, as libdw integration does.  */
+  Dwarf_Die origin = *die;
+  bool advanced = false;
+  /* True if the start DIE has origin/spec.  Its lexical parent is the
+     caller, even when the reference does not resolve.  */
+  bool start_has_semantic_link = false;
+  std::vector<Dwarf_Off> seen;
+  for (;;)
+    {
+      const Dwarf_Off off = dwarf_dieoffset (&origin);
+      if (std::find (seen.begin (), seen.end (), off) != seen.end ())
+	break;
+      seen.push_back (off);
+
+      if (advanced)
+	{
+	  /* Integration can stop on a pseudo-file; a later DIE may have a
+	     real path.  */
+	  if (info.file_path == nullptr)
+	    {
+	      file = dwarf_decl_file (&origin);
+	      if (dwarf_source_file_is_usable (file))
+		info.file_path = file;
+	    }
+	  if (enclosing_by_die != nullptr)
+	    {
+	      const auto it = enclosing_by_die->find (off);
+	      if (it != enclosing_by_die->end ())
+		{
+		  if (info.file_path == nullptr
+		      && dwarf_source_file_is_usable (it->second.file_path))
+		    info.file_path = it->second.file_path;
+		  if (info.line_number == 0)
+		    info.line_number = it->second.line_number;
+		}
+	    }
+	  if (info.line_number != 0 && info.file_path != nullptr)
+	    return info;
+	}
+
+      Dwarf_Attribute attr_mem;
+      Dwarf_Attribute *attr
+	= dwarf_attr (&origin, DW_AT_abstract_origin, &attr_mem);
+      if (attr == nullptr)
+	attr = dwarf_attr (&origin, DW_AT_specification, &attr_mem);
+      if (attr == nullptr)
+	break;
+      if (!advanced)
+	start_has_semantic_link = true;
+
+      Dwarf_Die next;
+      if (dwarf_formref_die (attr, &next) == nullptr)
+	break;
+      origin = next;
+      advanced = true;
+    }
+
+  /* With no semantic indirection, the DIE's own lexical parent is relevant.
+     Otherwise the loop above deliberately skipped the caller-side entry.  */
+  if (!start_has_semantic_link && enclosing_by_die != nullptr)
+    {
+      const auto it = enclosing_by_die->find (dwarf_dieoffset (&origin));
+      if (it != enclosing_by_die->end ())
+	{
+	  if (info.file_path == nullptr
+	      && dwarf_source_file_is_usable (it->second.file_path))
+	    info.file_path = it->second.file_path;
+	  if (info.line_number == 0)
+	    info.line_number = it->second.line_number;
+	  if (info.line_number != 0 && info.file_path != nullptr)
+	    return info;
+	}
+    }
+
+  /* Broken origin/spec: ORIGIN is still the caller-nested start DIE.  */
+  if (start_has_semantic_link && !advanced)
+    return info;
+
+  Dwarf_Die *scopes = nullptr;
+  const int nscopes = dwarf_getscopes_die (&origin, &scopes);
+  /* scopes[0] is ORIGIN itself; enclosing scopes begin at index 1.  */
+  for (int i = 1; i < nscopes; ++i)
+    {
+      const int tag = dwarf_tag (&scopes[i]);
+      if (tag != DW_TAG_class_type && tag != DW_TAG_structure_type
+	  && tag != DW_TAG_union_type)
+	continue;
+      if (info.line_number == 0)
+	{
+	  ln = 0;
+	  if (dwarf_decl_line (&scopes[i], &ln) == 0 && ln > 0)
+	    info.line_number = static_cast<uint32_t> (ln);
+	}
+      if (info.file_path == nullptr)
+	{
+	  file = dwarf_decl_file (&scopes[i]);
+	  if (dwarf_source_file_is_usable (file))
+	    info.file_path = file;
+	}
+      break;
+    }
+  free (scopes);
+  return info;
+}
+
+/* Open a libdw session on BINARY_PATH; each thread needs its own, as handles
+   are not thread-safe.  */
+bool
+open_libdw_session (const std::string &binary_path, libdw_file_session &session)
+{
+  session.fd = open (binary_path.c_str (), O_RDONLY);
+  if (session.fd < 0)
+    return false;
+  session.dwarf = dwarf_begin (session.fd, DWARF_C_READ);
+  if (!session.dwarf)
+    {
+      close (session.fd);
+      session.fd = -1;
+      return false;
+    }
+  return true;
+}
+
+/* Release a libdw session; safe on a partial or already-closed open.  */
+void
+close_libdw_session (libdw_file_session &session)
+{
+  if (session.dwarf)
+    {
+      dwarf_end (session.dwarf);
+      session.dwarf = nullptr;
+    }
+  if (session.fd >= 0)
+    {
+      close (session.fd);
+      session.fd = -1;
+    }
+}
+
+enum class pc_range_decode_status
+{
+  no_extent,
+  valid,
+  invalid
+};
+
+/* Decode and merge the PC ranges that libdw reports for DIE.  Preserve the
+   first decoded range start in FIRST_START before sorting.  */
+pc_range_decode_status
+collect_die_pc_ranges (Dwarf_Die *d, pc_range_list &out,
+		       uint64_t *first_start = nullptr)
+{
+  out.clear ();
+  if (first_start != nullptr)
+    *first_start = 0;
+  if (d == nullptr)
+    return pc_range_decode_status::invalid;
+
+  const bool declared_pc_extent
+    = (dwarf_hasattr (d, DW_AT_low_pc)
+       || dwarf_hasattr (d, DW_AT_high_pc)
+       || dwarf_hasattr (d, DW_AT_ranges));
+
+  Dwarf_Addr base = 0, start = 0, end = 0;
+  ptrdiff_t offset = 0;
+  bool decoded_range = false;
+  while (true)
+    {
+      const ptrdiff_t next
+	= dwarf_ranges (d, offset, &base, &start, &end);
+      if (next < 0)
+	{
+	  out.clear ();
+	  return pc_range_decode_status::invalid;
+	}
+      if (next == 0)
+	break;
+      const ptrdiff_t next_off = next;
+      if (next_off <= offset)
+	{
+	  out.clear ();
+	  return pc_range_decode_status::invalid;
+	}
+      offset = next_off;
+      if (end > start)
+	{
+	  if (!decoded_range && first_start != nullptr)
+	    *first_start = static_cast<uint64_t> (start);
+	  decoded_range = true;
+	  out.emplace_back (
+	    static_cast<uint64_t> (start), static_cast<uint64_t> (end));
+	}
+    }
+
+  std::sort (out.begin (), out.end ());
+  size_t merged = 0;
+  for (const auto &range : out)
+    {
+      if (merged != 0 && range.first <= out[merged - 1].second)
+	out[merged - 1].second
+	  = std::max (out[merged - 1].second, range.second);
+      else
+	out[merged++] = range;
+    }
+  out.resize (merged);
+  if (!declared_pc_extent && !decoded_range)
+    return pc_range_decode_status::no_extent;
+  return pc_range_decode_status::valid;
+}
+
+/* Return DIE's entry PC when it lies in RANGES, otherwise their first decoded
+   address.  DWARF 5 permits DW_AT_entry_pc to be an address or a base-relative
+   unsigned constant.  */
+uint64_t
+subprogram_entry_pc (Dwarf_Die *die, uint64_t first_start,
+		     const pc_range_list &ranges)
+{
+  const auto contained = [&ranges] (uint64_t pc)
+  {
+    return std::any_of (ranges.begin (), ranges.end (),
+			[pc] (const std::pair<uint64_t, uint64_t> &range)
+			{
+			  return range.first <= pc && pc < range.second;
+			});
+  };
+
+  Dwarf_Attribute attr_mem;
+  Dwarf_Attribute *const attr
+    = dwarf_attr (die, DW_AT_entry_pc, &attr_mem);
+  if (attr != nullptr)
+    {
+      /* Address vs offset is the form, not whether the value is in RANGES.
+	 dwarf_formudata accepts addrx and returns the .debug_addr index.  */
+      const unsigned int form = dwarf_whatform (attr);
+      const bool constant_form
+	= (form == DW_FORM_data1 || form == DW_FORM_data2
+	   || form == DW_FORM_data4 || form == DW_FORM_data8
+	   || form == DW_FORM_udata || form == DW_FORM_sdata
+	   || form == DW_FORM_implicit_const);
+
+      if (!constant_form)
+	{
+	  Dwarf_Addr address = 0;
+	  if (dwarf_formaddr (attr, &address) == 0
+	      && contained (static_cast<uint64_t> (address)))
+	    return static_cast<uint64_t> (address);
+	}
+      else
+	{
+	  Dwarf_Word offset = 0;
+	  Dwarf_Addr lowpc = 0;
+	  const uint64_t base
+	    = dwarf_lowpc (die, &lowpc) == 0
+		? static_cast<uint64_t> (lowpc)
+		: first_start;
+	  if (dwarf_formudata (attr, &offset) == 0
+	      && offset <= UINT64_MAX - base && contained (base + offset))
+	    return base + offset;
+	}
+    }
+
+  if (contained (first_start))
+    return first_start;
+  return ranges.front ().first;
+}
