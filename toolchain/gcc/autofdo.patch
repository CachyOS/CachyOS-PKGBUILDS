diff --git a/afdo_tools/testsuite/afdo-test/validate_addr_mapping.py b/afdo_tools/testsuite/afdo-test/validate_addr_mapping.py
new file mode 100755
index 00000000000..40e1367f736
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/validate_addr_mapping.py
@@ -0,0 +1,310 @@
+#!/usr/bin/env python3
+"""Validate an afdo_create address-mapping dump against `addr2line -i -f`.
+
+Dump format (per autofdo_profiler.cc):
+  <hex_addr>\\t<func>\\t<file>:<line>:<disc>\\t<inline_func>:<call_line>\\t...
+
+The inline_stack in the dump is ordered outer-callee first (i.e. function
+called by the outer concrete func), innermost last.  addr2line -i emits
+innermost frame first, so we invert one when comparing.
+"""
+
+import argparse
+import os
+import platform
+import re
+import shutil
+import struct
+import subprocess
+import sys
+
+ADDR_RE = re.compile(r"^0x[0-9a-fA-F]+$")
+LOC_RE = re.compile(r"^(.*?):(\d+|\?)(?:\s+\(discriminator\s+(\d+)\))?$")
+
+EM_X86_64  = 62
+EM_AARCH64 = 183
+
+
+def elf_machine(path):
+    """Return the ELF e_machine value, or None if not an ELF."""
+    try:
+        with open(path, "rb") as f:
+            magic = f.read(4)
+            if magic != b"\x7fELF":
+                return None
+            f.seek(18)
+            return struct.unpack("<H", f.read(2))[0]
+    except OSError:
+        return None
+
+
+def _a2l_works(a2l, binary):
+    """Return True if addr2line can open and understand binary."""
+    try:
+        r = subprocess.run(
+            [a2l, "-e", binary, "0x0"],
+            capture_output=True, text=True, timeout=5,
+        )
+        bad = ("not an ELF file", "file format not recognized",
+               "No such file or directory")
+        combined = r.stdout + r.stderr
+        return not any(b in combined for b in bad)
+    except Exception:
+        return False
+
+
+def find_addr2line(binary):
+    """Return (path, None) for a working addr2line, or (None, reason_str)."""
+    machine = elf_machine(binary)
+
+    cross_map = {EM_AARCH64: "aarch64-linux-gnu-addr2line",
+                 EM_X86_64:  "x86_64-linux-gnu-addr2line"}
+
+    candidates = []
+    native = shutil.which("addr2line")
+    if native:
+        candidates.append(native)
+    cross = shutil.which(cross_map.get(machine, "")) if machine in cross_map else None
+    if cross and cross not in candidates:
+        candidates.append(cross)
+
+    for a2l in candidates:
+        if _a2l_works(a2l, binary):
+            return a2l, None
+
+    arch_name = {EM_X86_64: "x86_64", EM_AARCH64: "aarch64"}.get(
+        machine, f"ELF machine {machine}"
+    )
+    return None, (
+        f"no addr2line can read {arch_name} binary on "
+        f"{platform.machine()} host (tried: {candidates})"
+    )
+
+
+def norm_addr(s):
+    return int(s, 16)
+
+
+def parse_dump(path):
+    rows = []
+    with open(path) as f:
+        for raw in f:
+            line = raw.rstrip("\n")
+            if not line or line.startswith("#"):
+                continue
+            cols = line.split("\t")
+            if len(cols) < 3:
+                continue
+            addr, func, file_line_disc = cols[0], cols[1], cols[2]
+            # file:line:disc ? split from the right so paths with colons survive
+            try:
+                file_path, line_no, disc = file_line_disc.rsplit(":", 2)
+                line_no = int(line_no) if line_no.isdigit() else 0
+                disc = int(disc) if disc.isdigit() else 0
+            except ValueError:
+                file_path, line_no, disc = file_line_disc, 0, 0
+            inlines = []
+            for p in cols[3:]:
+                name, _, cl = p.rpartition(":")
+                # Inline call site is <func>:<line> or <func>:<line>.<disc>.
+                # The discriminator is informational; we only compare line.
+                cl_line = cl.split(".", 1)[0]
+                inlines.append((name, int(cl_line) if cl_line.isdigit() else 0))
+            rows.append(
+                {
+                    "addr": norm_addr(addr),
+                    "addr_str": addr,
+                    "func": func,
+                    "file": file_path,
+                    "line": line_no,
+                    "disc": disc,
+                    "inlines": inlines,
+                }
+            )
+    return rows
+
+
+def run_addr2line(a2l, binary, addrs):
+    """Returns {addr_lower: [{'func','file','line','disc'}, ...]} innermost first."""
+    if not addrs:
+        return {}
+    cmd = [a2l, "-a", "-i", "-f", "-C", "-e", binary] + addrs
+    out = subprocess.check_output(cmd, text=True)
+    results = {}
+    current_addr = None
+    current_frames = []
+    pending_func = None
+    for raw in out.splitlines():
+        line = raw.strip()
+        if not line:
+            continue
+        if ADDR_RE.match(line):
+            if current_addr is not None:
+                results[current_addr] = current_frames
+            current_addr = norm_addr(line)
+            current_frames = []
+            pending_func = None
+            continue
+        if pending_func is None:
+            pending_func = line
+            continue
+        m = LOC_RE.match(line)
+        if m:
+            file_path = m.group(1) if m.group(1) else ""
+            line_no = int(m.group(2)) if m.group(2).isdigit() else 0
+            disc = int(m.group(3)) if m.group(3) else 0
+        else:
+            file_path, line_no, disc = line, 0, 0
+        current_frames.append(
+            {"func": pending_func, "file": file_path, "line": line_no, "disc": disc}
+        )
+        pending_func = None
+    if current_addr is not None:
+        results[current_addr] = current_frames
+    return results
+
+
+def file_matches(a, b):
+    if not a or not b or a == "??" or b == "??":
+        return True
+    if a == b:
+        return True
+    return os.path.basename(a) == os.path.basename(b)
+
+
+# GCC emits specialized/partial clones with an assembler-name suffix
+# (foo.part.0, foo.isra.0, foo.constprop.0, foo.cold, foo.lto_priv.0, ...).
+# The address-mapping dump reports the real ELF symbol name (what the produced
+# gcov profile keys on and what actually lives in the binary), while
+# `addr2line -f` reports the DWARF DW_AT_name of the original function (the base
+# name).  Both denote the same code; compare function names modulo those
+# compiler-internal clone suffixes.
+_GCC_CLONE_SUFFIX_RE = re.compile(
+    r"\.(?:part|isra|constprop|cold|hot|clone|lto_priv|"
+    r"resolver|specialized|localalias|ipcp)(?:\.\d+)*"
+)
+
+
+def strip_clone_suffixes(name):
+    if not name:
+        return name
+    return _GCC_CLONE_SUFFIX_RE.sub("", name)
+
+
+def func_matches(a, b):
+    if a == b:
+        return True
+    return strip_clone_suffixes(a) == strip_clone_suffixes(b)
+
+
+def compare(row, frames):
+    """Return list of error strings (empty if everything matches)."""
+    errs = []
+    if not frames:
+        return ["no addr2line frames"]
+    inner = frames[0]
+    outer = frames[-1]
+
+    # Innermost source location (file/line/disc) should match dump file/line/disc.
+    if not file_matches(row["file"], inner["file"]):
+        errs.append(f"file: dump={row['file']} a2l={inner['file']}")
+    if row["line"] != inner["line"]:
+        errs.append(f"line: dump={row['line']} a2l={inner['line']}")
+    if row["disc"] != inner["disc"]:
+        errs.append(f"disc: dump={row['disc']} a2l={inner['disc']}")
+
+    # Outer concrete function name should match dump func.
+    if not func_matches(row["func"], outer["func"]):
+        errs.append(f"func: dump={row['func']} a2l={outer['func']}")
+
+    # Inline stack: dump.inlines is outer-callee-first (length = #inlined frames).
+    # addr2line frames count = #inlined frames + 1.  So dump.inlines should have
+    # len(frames) - 1 entries, except dump strips a leading inline whose name
+    # equals the outer function (rare; happens with recursion/self-inline).
+    expected_inline_count = len(frames) - 1
+    if len(row["inlines"]) > expected_inline_count:
+        errs.append(
+            f"inline-count: dump={len(row['inlines'])} a2l={expected_inline_count}"
+        )
+    elif len(row["inlines"]) < expected_inline_count:
+        # OK only if leading frames in addr2line match outer func (dump strip).
+        skipped = expected_inline_count - len(row["inlines"])
+        for i in range(skipped):
+            if not func_matches(frames[i]["func"], outer["func"]):
+                errs.append(
+                    f"inline-count: dump={len(row['inlines'])} "
+                    f"a2l={expected_inline_count}"
+                )
+                break
+
+    # Walk inline frames.  dump.inlines[0] = function called by outer (call_line
+    # = outer's line in addr2line), dump.inlines[-1] = innermost.
+    # In addr2line: outer is frames[-1], so dump.inlines[0].name == frames[-2].func
+    # and dump.inlines[0].call_line == frames[-1].line.
+    n = len(row["inlines"])
+    for i, (name, call_line) in enumerate(row["inlines"]):
+        f_idx = len(frames) - 2 - i  # outer-callee first
+        if f_idx < 0:
+            break
+        callee = frames[f_idx]
+        caller = frames[f_idx + 1]
+        if not func_matches(name, callee["func"]):
+            errs.append(
+                f"inline[{i}] name: dump={name} a2l={callee['func']}"
+            )
+        if caller["line"] != call_line:
+            errs.append(
+                f"inline[{i}] call_line: dump={call_line} a2l={caller['line']}"
+            )
+    return errs
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("-b", "--binary", required=True)
+    ap.add_argument("-m", "--mapping", required=True)
+    ap.add_argument("-v", "--verbose", action="store_true")
+    ap.add_argument("--ignore-disc", action="store_true",
+                    help="skip discriminator comparison (known BRBE/LBR bug)")
+    args = ap.parse_args()
+
+    a2l_path, skip_reason = find_addr2line(args.binary)
+    if a2l_path is None:
+        print(f"SKIP: {skip_reason}", file=sys.stderr)
+        sys.exit(77)
+
+    rows = parse_dump(args.mapping)
+    addrs = [r["addr_str"] for r in rows]
+    a2l = run_addr2line(a2l_path, args.binary, addrs)
+
+    n_match = 0
+    mismatches = []
+    for row in rows:
+        frames = a2l.get(row["addr"], [])
+        errs = compare(row, frames)
+        if errs:
+            mismatches.append((row, frames, errs))
+        else:
+            n_match += 1
+            if args.verbose:
+                print(
+                    f"OK  {row['addr_str']}  {row['func']}  "
+                    f"{row['file']}:{row['line']}:{row['disc']}  "
+                    f"inlines={row['inlines']}"
+                )
+
+    print(f"\nTotal: {len(rows)}   Match: {n_match}   Mismatch: {len(mismatches)}")
+    for row, frames, errs in mismatches:
+        print(f"\nMISMATCH {row['addr_str']}")
+        print(f"  dump : func={row['func']} "
+              f"loc={row['file']}:{row['line']}:{row['disc']} "
+              f"inlines={row['inlines']}")
+        print(f"  a2l  : {frames}")
+        for e in errs:
+            print(f"    - {e}")
+
+    sys.exit(0 if not mismatches else 1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/afdo_tools/testsuite/afdo-test/validate_aslr_mmap.py b/afdo_tools/testsuite/afdo-test/validate_aslr_mmap.py
new file mode 100644
index 00000000000..614355e8d3c
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/validate_aslr_mmap.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Verify that ASLR was in effect during perf recording of a PIE binary.
+
+Reads MMAP2 records from perf.data to find the runtime load address of the
+binary, reads the first PT_LOAD p_vaddr from the ELF, and asserts that the
+load bias (runtime addr - p_vaddr) is non-zero -- proving the kernel placed
+the binary at an ASLR-randomized address rather than at its link-time vaddr.
+
+Exit codes:
+  0  -- PASS: load bias is non-zero, ASLR was in effect
+  1  -- FAIL: load bias is zero, binary was not ASLR-relocated
+  77 -- SKIP: could not extract load address or p_vaddr (unsupported)
+"""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+
+
+def get_mmap2_load_addr(perfdata, binary):
+    """Return the MMAP2 load address for binary in perfdata, or None.
+
+    Tries perf script --show-mmap-events first (cleaner), falls back to
+    perf script -D.  Both produce lines of the form:
+      ... PERF_RECORD_MMAP2 pid/tid: [0xADDR(len) @ pgoff ...]: flags /path
+    """
+    basename = os.path.basename(binary)
+    cmds = [
+        ["perf", "script", "--show-mmap-events", "-i", perfdata],
+        ["perf", "script", "-D", "-i", perfdata],
+    ]
+    for cmd in cmds:
+        try:
+            out = subprocess.run(
+                cmd, capture_output=True, text=True, timeout=30
+            ).stdout
+        except Exception:
+            continue
+        for line in out.splitlines():
+            if "PERF_RECORD_MMAP2" not in line:
+                continue
+            if basename not in line:
+                continue
+            m = re.search(r"\[0x([0-9a-f]+)\(", line)
+            if m:
+                return int(m.group(1), 16)
+    return None
+
+
+def get_first_load_vaddr(binary):
+    """Return p_vaddr of the first PT_LOAD program header, or None."""
+    try:
+        out = subprocess.run(
+            ["readelf", "-l", "--wide", binary],
+            capture_output=True, text=True, timeout=10
+        ).stdout
+    except Exception:
+        return None
+    for line in out.splitlines():
+        m = re.match(r"\s+LOAD\s+0x[0-9a-f]+\s+0x([0-9a-f]+)", line)
+        if m:
+            return int(m.group(1), 16)
+    return None
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("-b", "--binary", required=True,
+                    help="path to the PIE executable")
+    ap.add_argument("-p", "--perf",   required=True,
+                    help="path to the perf.data file")
+    args = ap.parse_args()
+
+    p_vaddr = get_first_load_vaddr(args.binary)
+    if p_vaddr is None:
+        print("SKIP: could not read PT_LOAD p_vaddr from binary", file=sys.stderr)
+        sys.exit(77)
+
+    mmap2_addr = get_mmap2_load_addr(args.perf, args.binary)
+    if mmap2_addr is None:
+        print("SKIP: no MMAP2 record found for binary in perf.data", file=sys.stderr)
+        sys.exit(77)
+
+    load_bias = mmap2_addr - p_vaddr
+    print(f"PT_LOAD p_vaddr  : 0x{p_vaddr:016x}")
+    print(f"MMAP2 load addr  : 0x{mmap2_addr:016x}")
+    print(f"Load bias (ASLR) : 0x{load_bias:016x}")
+
+    if load_bias == 0:
+        print("FAIL: load bias is zero -- binary was not ASLR-relocated",
+              file=sys.stderr)
+        sys.exit(1)
+
+    print("PASS: load bias is non-zero, ASLR relocation confirmed")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/afdo_tools/testsuite/afdo-test/validate_determinism.py b/afdo_tools/testsuite/afdo-test/validate_determinism.py
new file mode 100644
index 00000000000..7505e25089c
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/validate_determinism.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+"""Verify afdo_create's gcov output is byte-reproducible across runs.
+
+The same {binary, perf.data} fed to afdo_create several times must yield
+byte-identical gcov files, so content-addressed build caches (ccache, Bazel)
+hit rather than miss.  The one documented exception is the export timestamp:
+autofdo_gcov_materialize.cc stamps std::chrono::system_clock::now() into each
+top-level function record whose profile carries no per-function timestamp, so
+those 8-byte fields change every run and full byte-identity is impossible today
+(a --reproducible / SOURCE_DATE_EPOCH flag would fix it).
+
+We therefore mask every timestamp VALUE -- obtained from afdo_dump's
+"timestamp: N" lines -- out of the raw gcov bytes (replacing the 8-byte
+little-endian encoding with zeros), then require the masked byte streams to be
+identical.  This still catches the real risk the test targets -- an
+unordered_map/unordered_set iteration-order change in serialization -- because
+that would perturb non-timestamp bytes (name indices, counts, offsets).
+afdo_dump itself cannot catch it: it sorts functions by (count, name) before
+printing, hiding any on-disk reordering.
+
+Exit 0 and print "OK: ..." on success; exit 1 and print "FAIL: ..." on a
+non-timestamp difference.  Print "SKIP: ..." (exit 0) when there is nothing to
+compare.
+"""
+
+import argparse
+import re
+import struct
+import subprocess
+import sys
+
+
+def timestamps(afdo_dump, gcov):
+    """Set of timestamp values afdo_dump reports for this gcov."""
+    out = subprocess.run([afdo_dump, gcov], capture_output=True, text=True)
+    text = out.stdout + out.stderr
+    return set(int(m) for m in re.findall(r"timestamp:\s*(\d+)", text))
+
+
+def mask(data, tstamps):
+    """Zero every 8-byte little-endian occurrence of each timestamp value."""
+    for t in tstamps:
+        data = data.replace(struct.pack("<Q", t), b"\x00" * 8)
+    return data
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--afdo-dump", required=True,
+                    help="path to the afdo_dump binary (to read timestamps)")
+    ap.add_argument("gcov", nargs="+", help="gcov files from repeated runs")
+    args = ap.parse_args()
+
+    if len(args.gcov) < 2:
+        print("SKIP: need >= 2 gcov files to compare")
+        return 0
+
+    raws = []
+    sizes = []
+    all_ts = set()
+    for g in args.gcov:
+        with open(g, "rb") as f:
+            raw = f.read()
+        raws.append(raw)
+        sizes.append(len(raw))
+        all_ts |= timestamps(args.afdo_dump, g)
+
+    # A size change is a determinism failure on its own (variable-length
+    # encoding would shift under reordering); report it before masking.
+    if len(set(sizes)) != 1:
+        print("FAIL: gcov sizes differ across runs: "
+              + ", ".join(f"{g}={s}" for g, s in zip(args.gcov, sizes)))
+        return 1
+
+    # Mask with the union of all timestamp values seen in any run, so each
+    # run's own stamp is zeroed regardless of which file it came from.
+    base_g = args.gcov[0]
+    base_m = mask(raws[0], all_ts)
+    for g, raw in zip(args.gcov[1:], raws[1:]):
+        m = mask(raw, all_ts)
+        if m != base_m:
+            n = min(len(m), len(base_m))
+            off = next((i for i in range(n) if m[i] != base_m[i]), n)
+            diffs = sum(1 for i in range(n) if m[i] != base_m[i])
+            print(f"FAIL: {g} differs from {base_g} after timestamp masking: "
+                  f"{diffs} byte(s), first at offset {off} -- non-timestamp "
+                  f"nondeterminism (serialization order?)")
+            return 1
+
+    print(f"OK: {len(args.gcov)} runs byte-identical after masking "
+          f"{len(all_ts)} timestamp value(s); raw files differ only in the "
+          f"export timestamp")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/afdo_tools/testsuite/afdo-test/validate_dump_tree.py b/afdo_tools/testsuite/afdo-test/validate_dump_tree.py
new file mode 100644
index 00000000000..b44025df3ab
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/validate_dump_tree.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Validate an afdo_dump profile-tree against declared structural expectations.
+
+The afdo_dump output is a tree:
+
+    hot_loop:/path/file.c total:15828 head:0 timestamp: 17804...
+      4.1: 502                       <- source line(.discriminator): count
+      5.4: leaf: total:3964          <- direct inline (2-space indent)
+        2: 991
+      5.2: middle: total:6002        <- direct inline
+        2: leaf: total:2010          <- nested inline (>=4-space indent)
+
+This script asserts the properties the driver's `dump-tree` validator forwards
+from the .c AFDO-TEST header (--hot / --inline / --nested / --call /
+--line-hot), plus that at least one source-line counter is present.  Exits
+non-zero with a diagnostic listing every unmet expectation.
+Regexes mirror the original Tcl proc afdo_dump_profile_tree so behavior is
+unchanged by the harness redesign.
+"""
+
+import argparse
+import re
+import sys
+
+
+def extract_function_block(text, func):
+    """Return the top-level block for FUNC: its header line plus all following
+    indented lines, up to (not including) the next non-indented line (the next
+    top-level function header) or EOF.  None if FUNC's header is absent."""
+    header = re.compile(r"^" + re.escape(func) + r":\S+\s+total:\d+")
+    lines = text.splitlines()
+    start = next((i for i, ln in enumerate(lines) if header.match(ln)), None)
+    if start is None:
+        return None
+    block = [lines[start]]
+    for ln in lines[start + 1:]:
+        if ln and not ln[0].isspace():
+            break
+        block.append(ln)
+    return "\n".join(block)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dump", help="afdo_dump output file (default: stdin)")
+    ap.add_argument("--hot", action="append", required=True,
+                    help="function expected as a top-level hot header (repeatable)")
+    ap.add_argument("--call", action="append", default=[],
+                    help="call-target edge CALLER:CALLEE expected in the dump "
+                         "(CALLEE recorded as a call target with count>0 inside "
+                         "CALLER's block); repeatable")
+    ap.add_argument("--line-hot", action="append", default=[],
+                    help="FUNC:OFFSET -- within FUNC's block the source-line "
+                         "OFFSET (summed over its discriminators) must have "
+                         "count>0; asserts callsite/line attribution where a "
+                         "named call-target edge is unavailable (repeatable)")
+    ap.add_argument("--hot-in-file", action="append", default=[],
+                    help="FUNC:FILEFRAG -- a top-level hot header for FUNC whose "
+                         "source path contains FILEFRAG must exist with total>0; "
+                         "distinguishes same-named functions from different TUs "
+                         "that a bare-name --hot cannot tell apart (repeatable)")
+    ap.add_argument("--inline", action="append", default=[],
+                    help="function expected as a direct inline child (repeatable)")
+    ap.add_argument("--nested", action="append", default=[],
+                    help="function expected nested (>=4-space indent) (repeatable)")
+    ap.add_argument("--no-require-counters", action="store_true",
+                    help="skip the 'at least one line:count entry' check")
+    args = ap.parse_args()
+
+    if args.dump:
+        with open(args.dump, "rb") as f:
+            text = f.read().decode("utf-8", errors="replace")
+    else:
+        text = sys.stdin.read()
+    errors = []
+
+    # Function header: "hot:<path> total:N head:N timestamp:[ ]N".
+    # total must be > 0 -- a "hot" function with zero recorded samples
+    # would otherwise still match total:\d+ and pass.
+    for hot in args.hot:
+        m = re.search(
+                r"^" + re.escape(hot)
+                + r":\S+\s+total:(\d+)\s+head:\d+\s+timestamp:\s*\d+",
+                text, re.MULTILINE)
+        if not m:
+            errors.append(f"hot function header '{hot}' not found")
+        elif int(m.group(1)) == 0:
+            errors.append(f"hot function '{hot}' has total:0 (no samples)")
+
+    # File-qualified hot headers: a header "FUNC:<path> total:N ..." whose path
+    # contains FILEFRAG, with N>0.  Detects duplicate-static-symbol collisions --
+    # afdo_create keying by bare name collapses two same-named statics into one
+    # entry under a single file, so the other file's header goes missing.
+    for spec in args.hot_in_file:
+        func, _, frag = spec.partition(":")
+        m = re.search(
+                r"^" + re.escape(func) + r":\S*" + re.escape(frag)
+                + r"\S*\s+total:(\d+)\s+head:\d+\s+timestamp:\s*\d+",
+                text, re.MULTILINE)
+        if not m:
+            errors.append(
+                f"hot header '{func}' in file matching '{frag}' not found")
+        elif int(m.group(1)) == 0:
+            errors.append(
+                f"hot header '{func}' in file '{frag}' has total:0 (no samples)")
+
+    # Call-target edges: within CALLER's top-level block, CALLEE must appear as
+    # a call target with count>0.  Call targets render with a count between the
+    # line-colon and the callee name:
+    #   "<line>(.<disc>)?: <count>  <callee>:<path>:<count>"
+    # which distinguishes them from an inline child ("<line>: <name>: total:N",
+    # no leading count).  Branch-stack sources populate these from sampled
+    # call/return branches, so this asserts edge attribution.
+    for spec in args.call:
+        caller, _, callee = spec.partition(":")
+        block = extract_function_block(text, caller)
+        if block is None:
+            errors.append(
+                f"call edge '{caller}' -> '{callee}': caller header not found")
+            continue
+        m = re.search(
+                r"^[ \t]+\d+(\.\d+)?:[ \t]+(\d+)[ \t]+" + re.escape(callee)
+                + r"\b",
+                block, re.MULTILINE)
+        if not m:
+            errors.append(f"call edge '{caller}' -> '{callee}' not found")
+        elif int(m.group(2)) == 0:
+            errors.append(f"call edge '{caller}' -> '{callee}' has count 0")
+
+    # Line-level hotness: within FUNC's block, the given source-line OFFSET must
+    # carry a nonzero sample count (summed across its discriminators, e.g. "4:"
+    # plus "4.1:").  Used to assert callsite attribution -- the source line of a
+    # call gets the samples -- where a named call-target edge is unavailable
+    # (e.g. a cross-DSO callee that afdo_create cannot symbolize per-binary).
+    for spec in args.line_hot:
+        func, _, off = spec.partition(":")
+        block = extract_function_block(text, func)
+        if block is None:
+            errors.append(f"line-hot '{func}:{off}': function header not found")
+            continue
+        total = None
+        for m in re.finditer(
+                r"^[ \t]+" + re.escape(off) + r"(?:\.\d+)?:[ \t]+(\d+)\b",
+                block, re.MULTILINE):
+            total = (total or 0) + int(m.group(1))
+        if total is None:
+            errors.append(f"line-hot '{func}:{off}': no entry at offset {off}")
+        elif total == 0:
+            errors.append(f"line-hot '{func}:{off}': offset present but count 0")
+
+    # At least one indented "<line>(.<disc>)?: <count>" counter entry.
+    if not args.no_require_counters:
+        if not re.search(r"^[ \t]+\d+(\.\d+)?:[ \t]+\d+$", text, re.MULTILINE):
+            errors.append("no source-line/discriminator counters found")
+
+    # Direct inline children: "<line>(.<disc>)?: <name>:?[<path>] total:N".
+    # <path> appears in --no-branch-stack dumps (header-style rendering of
+    # inline children); it's absent in branch-stack dumps -- accept both.
+    for name in args.inline:
+        if not re.search(
+                r"^[ \t]+\d+(\.\d+)?:[ \t]+" + re.escape(name)
+                + r":?\S*[ \t]+total:\d+",
+                text, re.MULTILINE):
+            errors.append(f"'{name}' not present as an inlined child")
+
+    # Nested inline: name at one-or-more deeper indent levels (>=4 spaces).
+    for name in args.nested:
+        if not re.search(
+                r"^[ \t]{4,}\d+(\.\d+)?:[ \t]+" + re.escape(name)
+                + r":?\S*[ \t]+total:\d+",
+                text, re.MULTILINE):
+            errors.append(f"nested inline '{name}' (>=4-space indent) not found")
+
+    if errors:
+        sys.stderr.write("dump-tree validation failed:\n")
+        for e in errors:
+            sys.stderr.write(f"  - {e}\n")
+        sys.stderr.write("\n--- dump ---\n" + text)
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/afdo_tools/testsuite/afdo-test/validate_merge.py b/afdo_tools/testsuite/afdo-test/validate_merge.py
new file mode 100644
index 00000000000..45715ce92ba
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/validate_merge.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""Validate a merged afdo_dump output contains hot function headers from all workloads.
+
+Each --hot <name> argument asserts that <name> appears as a top-level function
+header in the dump.  Used by the merge-dump-tree validator to confirm that
+afdo_merge preserved hotness from every input profile.
+"""
+
+import argparse
+import re
+import sys
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--dump", required=True,
+                    help="afdo_dump output file to validate")
+    ap.add_argument("--hot", action="append", default=[],
+                    help="function expected as a hot header (repeatable)")
+    ap.add_argument("--no-require-counters", action="store_true",
+                    help="skip the 'at least one line:count entry' check")
+    args = ap.parse_args()
+
+    text = open(args.dump).read()
+    errors = []
+
+    for fn in args.hot:
+        if not re.search(
+                r"^" + re.escape(fn)
+                + r":\S*\s+total:\d+\s+head:\d+\s+timestamp:\s*\d+",
+                text, re.MULTILINE):
+            errors.append(f"hot function header '{fn}' not found in merged dump")
+
+    if not args.no_require_counters:
+        if not re.search(r"^[ \t]+\d+(\.\d+)?:[ \t]+\d+$", text, re.MULTILINE):
+            errors.append("no source-line/discriminator counters found")
+
+    if errors:
+        sys.stderr.write("merge dump validation failed:\n")
+        for e in errors:
+            sys.stderr.write(f"  - {e}\n")
+        sys.stderr.write("\n--- dump ---\n" + text)
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/afdo_tools/testsuite/afdo-test/validate_system_wide.py b/afdo_tools/testsuite/afdo-test/validate_system_wide.py
new file mode 100644
index 00000000000..f0d0aeeefed
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/validate_system_wide.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""Verify a perf.data capture actually recorded system-wide (multi-process)
+samples, rather than being scoped to just the target binary.
+
+A `perf record -a` capture is only exercising the system-wide code path if
+the resulting perf.data contains samples from more than one process; this
+confirms that property so the scenario isn't silently a no-op on a quiet
+host.  Checks:
+  1. more than one distinct PID appears in the capture
+  2. at least one sample's comm does not belong to the target binary
+
+Exit codes:
+  0  -- PASS: perf.data contains samples from multiple processes
+  1  -- FAIL: perf.data looks scoped to a single process
+  77 -- SKIP: could not run perf script / no samples found (unsupported)
+"""
+
+import argparse
+import os
+import subprocess
+import sys
+
+
+def perf_script_field(perfdata, field):
+    """Return one line per sample for $field, or None on failure."""
+    try:
+        out = subprocess.run(
+            ["perf", "script", "-i", perfdata, "--no-header", "-F", field],
+            capture_output=True, text=True, timeout=60
+        ).stdout
+    except Exception:
+        return None
+    lines = [l.strip() for l in out.splitlines() if l.strip()]
+    return lines if lines else None
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("-p", "--perf", required=True,
+                    help="path to the perf.data file")
+    ap.add_argument("-b", "--binary", required=True,
+                    help="path to the profiled binary")
+    args = ap.parse_args()
+
+    pids = perf_script_field(args.perf, "pid")
+    if pids is None:
+        print("SKIP: could not run 'perf script -F pid'", file=sys.stderr)
+        sys.exit(77)
+
+    comms = perf_script_field(args.perf, "comm")
+    if comms is None:
+        print("SKIP: could not run 'perf script -F comm'", file=sys.stderr)
+        sys.exit(77)
+
+    total = len(comms)
+    if total == 0:
+        print("SKIP: no samples found in perf.data", file=sys.stderr)
+        sys.exit(77)
+
+    distinct_pids = set(pids)
+    # comm is truncated to 15 visible chars (kernel TASK_COMM_LEN=16); match
+    # by substring containment in either direction to tolerate truncation.
+    target_comm = os.path.basename(args.binary)[:15]
+    own = sum(1 for c in comms if target_comm in c or c in target_comm)
+    other = total - own
+
+    print(f"Total samples        : {total}")
+    print(f"Distinct PIDs        : {len(distinct_pids)}")
+    print(f"Samples from binary  : {own}")
+    print(f"Samples from others  : {other}")
+
+    if len(distinct_pids) <= 1:
+        print("FAIL: only one PID captured -- perf.data is not system-wide",
+              file=sys.stderr)
+        sys.exit(1)
+
+    if other == 0:
+        print("FAIL: every sample's comm matches the target binary -- "
+              "no unrelated-process samples were captured", file=sys.stderr)
+        sys.exit(1)
+
+    print("PASS: perf.data contains samples from multiple processes")
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
