diff --git a/afdo-tools/testsuite/afdo-test/afdo-fauto-profile-v4.c b/afdo-tools/testsuite/afdo-test/afdo-fauto-profile-v4.c
new file mode 100644
index 00000000000..db578eb37fc
--- /dev/null
+++ b/afdo-tools/testsuite/afdo-test/afdo-fauto-profile-v4.c
@@ -0,0 +1,45 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-create --gcov_version=4 --format=binary } */
+/* { dg-afdo-post dump recompile opt-dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot hot_loop } */
+/* { dg-afdo-requires python3 perf } */
+/* { dg-afdo-opt-profile-options -fauto-profile-format=v4 -fauto-profile-partial } */
+/* { dg-afdo-opt-dump-flags -fdump-passes -fdump-ipa-inline-optimized-missed -fdump-tree-einline-optimized-missed -fopt-info-inline-optimized-missed } */
+/* { dg-afdo-scan-opt-info "ipa-afdo.*ON" } */
+/* { dg-afdo-scan-tree "Inlining using auto-profile.*hot_callee" einline } */
+/* { dg-afdo-scan-ipa "hot_loop.*hot" inline } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+int
+hot_callee (int x)
+{
+  int a = (x + seed) * 3 + 1;
+  int b = a ^ (a >> 7);
+  int c = b * 31 + (b << 3);
+  int d = c - seed * 5;
+  int e = d | (d >> 4);
+  return e * 7 - (e >> 2);
+}
+
+__attribute__ ((noinline)) int
+hot_loop (int n)
+{
+  int sum = 0;
+  for (int i = 0; i < n; ++i)
+    sum += hot_callee (i);
+  return sum;
+}
+
+int
+main (void)
+{
+  printf ("%d\n", hot_loop (50000000));
+  return 0;
+}
