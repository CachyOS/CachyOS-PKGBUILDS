diff --git a/afdo-tools/src/file_mmap.cc b/afdo-tools/src/file_mmap.cc
new file mode 100644
index 00000000000..427a33a64a7
--- /dev/null
+++ b/afdo-tools/src/file_mmap.cc
@@ -0,0 +1,136 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "file_mmap.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdlib>
+#include <fcntl.h>
+#include <limits>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#if defined (HAVE_SYS_MMAN_H) \
+    && (!defined (IN_GCC) \
+	|| (defined (HAVE_MMAP_FILE) && defined (HAVE_MUNMAP)))
+#include <sys/mman.h>
+#define AFDO_USE_MMAP 1
+#else
+#define AFDO_USE_MMAP 0
+#endif
+
+#ifndef O_BINARY
+# ifdef _O_BINARY
+#  define O_BINARY _O_BINARY
+# else
+#  define O_BINARY 0
+# endif
+#endif
+
+namespace afdo_tools {
+
+file_mmap::~file_mmap ()
+{
+  unmap ();
+}
+
+void
+file_mmap::unmap ()
+{
+  if (addr_ != nullptr)
+    {
+#if AFDO_USE_MMAP
+      ::munmap (addr_, size_);
+#else
+      std::free (addr_);
+#endif
+      addr_ = nullptr;
+      size_ = 0;
+    }
+}
+
+bool
+file_mmap::map (const std::string &path)
+{
+  unmap ();
+
+  int fd = ::open (path.c_str (), O_RDONLY | O_BINARY);
+  if (fd < 0)
+    return false;
+
+  struct stat st;
+  if (::fstat (fd, &st) != 0 || st.st_size <= 0)
+    {
+      ::close (fd);
+      return false;
+    }
+
+  /* The tools require a 64-bit host, but this file also builds into cc1,
+     where off_t may be wider than size_t.  Refuse a file the cast below
+     would truncate rather than map a short buffer.  */
+  if (static_cast<uintmax_t> (st.st_size)
+      > static_cast<uintmax_t> (std::numeric_limits<size_t>::max ()))
+    {
+      ::close (fd);
+      return false;
+    }
+  const size_t len = static_cast<size_t> (st.st_size);
+#if AFDO_USE_MMAP
+  void *m = ::mmap (nullptr, len, PROT_READ, MAP_SHARED, fd, 0);
+  ::close (fd);
+  if (m == MAP_FAILED)
+    return false;
+
+#if defined (MADV_SEQUENTIAL) \
+    && (!defined (IN_GCC) || defined (HAVE_MADVISE))
+  ::madvise (m, len, MADV_SEQUENTIAL);
+#endif
+
+  addr_ = m;
+#else
+  void *buffer = std::malloc (len);
+  if (buffer == nullptr)
+    {
+      ::close (fd);
+      return false;
+    }
+  size_t offset = 0;
+  while (offset < len)
+    {
+      const size_t count = std::min (len - offset, size_t (65536));
+      const auto n = ::read (fd, static_cast<uint8_t *> (buffer) + offset,
+			     count);
+      if (n < 0 && errno == EINTR)
+	continue;
+      if (n <= 0)
+	{
+	  std::free (buffer);
+	  ::close (fd);
+	  return false;
+	}
+      offset += static_cast<size_t> (n);
+    }
+  ::close (fd);
+  addr_ = buffer;
+#endif
+  size_ = len;
+  return true;
+}
+
+} /* namespace afdo_tools.  */
