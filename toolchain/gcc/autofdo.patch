index 00000000000..8e3cc674f5f
--- /dev/null
+++ b/afdo_tools/src/gcov_reader_v3.cc
@@ -0,0 +1,451 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_reader.h"
+#include "gcov.h"
+#include "gcov_io.h"
+#include "file_mmap.h"
+
+#ifdef IN_GCC
+#include "intl.h"
+#endif
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+
+namespace gcov {
+
+/* On-disk size of one summary histogram row: cutoff, min_count,
+   num_counts.  */
+constexpr size_t DETAILED_ENTRY_BYTES
+  = sizeof (uint32_t) + 2 * sizeof (uint64_t);
+
+/* Hard cap on nested inline callsites.  Remaining-byte checks alone still
+   allow a deep spine of tiny records to overflow the C stack.  */
+constexpr unsigned MAX_INLINE_DEPTH = 64;
+
+/* Read a record length word and reject a record that cannot fit in the input.
+   The value is only a lower bound on the record: producers disagree on both
+   its unit and its coverage, as create_gcov counts 32-bit words and leaves
+   the file-name table out of the FILE_NAMES length and the v3 timestamps out
+   of the FUNCTION length.  Comparing it against the bytes left accepts either
+   unit while still rejecting a record that claims more than the file holds;
+   parsing itself stays bounded by END.  */
+static bool
+read_record_length (const uint8_t *&cur, const uint8_t *end)
+{
+  uint32_t record_length = 0;
+  if (!gcov_read_uint32 (cur, end, record_length))
+    return false;
+  return cur <= end && record_length <= (size_t) (end - cur);
+}
+
+/* Read a record tag and check it against EXPECTED.  NAME identifies the
+   record in the diagnostic emitted on a mismatch.  */
+static bool
+read_expected_tag (const uint8_t *&cur, const uint8_t *end, uint32_t expected,
+		   const char *name)
+{
+  uint32_t tag;
+  if (!gcov_read_uint32 (cur, end, tag))
+    return false;
+  if (tag != expected)
+    {
+      fprintf (stderr,
+	       _("Error: Expected %s tag (0x%x), got 0x%x\n"),
+	       name,
+	       (unsigned) expected,
+	       (unsigned) tag);
+      return false;
+    }
+  return true;
+}
+
+/* Read the AFDO summary record into the profile's summary.  */
+bool
+gcov_reader_v3::read_summary (gcov_summary &summary)
+{
+  if (!read_expected_tag
+	(cur_, end_, v3::format::GCOV_TAG_AFDO_SUMMARY, "AFDO_SUMMARY"))
+    return false;
+  if (!gcov_read_uint64 (cur_, end_, summary.total_count)
+      || !gcov_read_uint64 (cur_, end_, summary.max_count)
+      || !gcov_read_uint64 (cur_, end_, summary.max_function_count)
+      || !gcov_read_uint64 (cur_, end_, summary.num_counts)
+      || !gcov_read_uint64 (cur_, end_, summary.num_functions)
+      || !gcov_read_uint64 (cur_, end_, summary.num_detailed_entries))
+    return false;
+  /* Reject a count the rest of the record cannot hold; this also keeps the
+     value within size_t.  */
+  const size_t remaining = static_cast<size_t> (end_ - cur_);
+  if (summary.num_detailed_entries > remaining / DETAILED_ENTRY_BYTES)
+    return false;
+  summary.detailed_entries.resize (
+    static_cast<size_t> (summary.num_detailed_entries));
+  for (auto &entry : summary.detailed_entries)
+    {
+      if (!gcov_read_uint32 (cur_, end_, entry.cutoff)
+	  || !gcov_read_uint64 (cur_, end_, entry.min_count)
+	  || !gcov_read_uint64 (cur_, end_, entry.num_counts))
+	return false;
+    }
+  return true;
+}
+
+/* Read the file-name table into the profile.  */
+bool
+gcov_reader_v3::read_file_names (std::vector<std::string> &file_names)
+{
+  if (!read_expected_tag
+	(cur_, end_, v3::format::GCOV_TAG_AFDO_FILE_NAMES, "AFDO_FILE_NAMES"))
+    return false;
+
+  if (!read_record_length (cur_, end_))
+    return false;
+
+  uint32_t num_files = 0;
+  if (!gcov_read_uint32 (cur_, end_, num_files))
+    return false;
+  /* Length word plus trailing NUL.  */
+  if (cur_ > end_
+      || (num_files != 0
+	  && num_files > (size_t) (end_ - cur_) / (sizeof (uint32_t) + 1)))
+    return false;
+  file_names.reserve (num_files);
+  for (uint32_t i = 0; i < num_files; i++)
+    {
+      file_names.emplace_back ();
+      if (!gcov_read_string (cur_, end_, file_names.back ()))
+	return false;
+    }
+  return true;
+}
+
+/* Read the untagged function-name pool and its per-name file indices.  */
+bool
+gcov_reader_v3::read_function_names (std::vector<std::string> &function_names,
+				    std::vector<uint32_t> &file_name_map)
+{
+  uint32_t num_functions = 0;
+  if (!gcov_read_uint32 (cur_, end_, num_functions))
+    return false;
+  /* Name string (length + NUL) plus file-name index.  */
+  if (cur_ > end_
+      || (num_functions != 0
+	  && num_functions
+	       > (size_t) (end_ - cur_)
+		   / (sizeof (uint32_t) + 1 + sizeof (uint32_t))))
+    return false;
+  function_names.reserve (num_functions);
+  file_name_map.reserve (num_functions);
+  for (uint32_t i = 0; i < num_functions; i++)
+    {
+      function_names.emplace_back ();
+      if (!gcov_read_string (cur_, end_, function_names.back ()))
+	return false;
+      file_name_map.emplace_back ();
+      if (!gcov_read_uint32 (cur_, end_, file_name_map.back ()))
+	return false;
+    }
+  return true;
+}
+
+/* Read one position count into LOC: a plain count, or a call with its
+   indirect-call targets when the record carries any.  */
+bool
+gcov_reader_v3::read_pos_count (std::unique_ptr<gcov_location> &loc)
+{
+  uint32_t encoded_offset = 0, num_targets = 0;
+  uint64_t count = 0;
+  if (!gcov_read_uint32 (cur_, end_, encoded_offset)
+      || !gcov_read_uint32 (cur_, end_, num_targets)
+      || !gcov_read_uint64 (cur_, end_, count))
+    return false;
+
+  std::unique_ptr<gcov_location> location;
+  if (num_targets == 0)
+    location = std::make_unique<gcov_location_normal> (count);
+  else
+    {
+      auto call = std::make_unique<gcov_location_call> (count);
+      /* value_profile_type, function_id, target_count.  */
+      if (cur_ > end_
+	  || (num_targets != 0
+	      && num_targets
+		   > (size_t) (end_ - cur_)
+		       / (sizeof (uint32_t) + 2 * sizeof (uint64_t))))
+	return false;
+      call->callee_map.reserve (num_targets);
+      for (uint32_t target = 0; target < num_targets; target++)
+	{
+	  uint32_t value_profile_type = 0;
+	  uint64_t function_id = 0, target_count = 0;
+	  if (!gcov_read_uint32 (cur_, end_, value_profile_type)
+	      || !gcov_read_uint64 (cur_, end_, function_id)
+	      || !gcov_read_uint64 (cur_, end_, target_count))
+	    return false;
+	  call->callee_map[function_id] = target_count;
+	}
+      location = std::move (call);
+    }
+
+  location->offset = encoded_offset >> 16;
+  location->discriminator = encoded_offset & 0xffff;
+  loc = std::move (location);
+  return true;
+}
+
+/* Read an inline callsite and, recursively, the whole inline subtree below
+   it into CALLSITE.  DEPTH is the nesting level of this callsite.  */
+bool
+gcov_reader_v3::read_inline_callsite (gcov_location_inline &callsite,
+				      unsigned depth)
+{
+  if (depth >= MAX_INLINE_DEPTH)
+    return false;
+
+  uint32_t callsite_offset = 0, inline_func_name_idx = 0,
+	   inline_num_pos_counts = 0, inline_num_callsites = 0;
+
+  if (!gcov_read_uint32 (cur_, end_, callsite_offset)
+      || !gcov_read_uint32 (cur_, end_, inline_func_name_idx)
+      || !gcov_read_uint32 (cur_, end_, inline_num_pos_counts)
+      || !gcov_read_uint32 (cur_, end_, inline_num_callsites))
+    return false;
+
+  if (inline_func_name_idx >= profile.get_function_names ().size ())
+    {
+      fprintf (stderr,
+	       _("Error: v3 inline callsite name index out of range\n"));
+      return false;
+    }
+
+  callsite.offset = callsite_offset >> 16;
+  callsite.discriminator = callsite_offset & 0xffff;
+  callsite.inlined_sym.desc.name_index = inline_func_name_idx;
+  callsite.inlined_sym.id = inline_func_name_idx;
+
+  const size_t n_pos = inline_num_pos_counts;
+  const size_t n_cs = inline_num_callsites;
+  if (n_pos > ~(size_t) 0 - n_cs)
+    return false;
+  callsite.inlined_sym.locations.reserve (n_pos + n_cs);
+  for (uint32_t j = 0; j < inline_num_pos_counts; ++j)
+    {
+      std::unique_ptr<gcov_location> location = nullptr;
+      if (!read_pos_count (location))
+	return false;
+      callsite.inlined_sym.locations.emplace_back (std::move (location));
+    }
+
+  for (uint32_t j = 0; j < inline_num_callsites; ++j)
+    {
+      std::unique_ptr<gcov_location> nested
+	= std::make_unique<gcov_location_inline> ();
+      if (!read_inline_callsite (
+	    *static_cast<gcov_location_inline *> (nested.get ()),
+	    depth + 1))
+	return false;
+      callsite.inlined_sym.locations.emplace_back (std::move (nested));
+    }
+
+  callsite.inlined_sym.total_count
+    = gcov_function_subtree_count (callsite.inlined_sym);
+
+  return true;
+}
+
+/* Read one function record into FUNC, sorting its locations by offset and
+   discriminator.  */
+bool
+gcov_reader_v3::read_function (gcov_function &func)
+{
+  if (!gcov_read_uint64 (cur_, end_, func.head_count)
+      || !gcov_read_uint64 (cur_, end_, func.timestamp))
+    return false;
+  uint32_t name_idx = 0, num_pos = 0, num_inline_calls = 0;
+  if (!gcov_read_uint32 (cur_, end_, name_idx))
+    return false;
+  const std::vector<std::string> &function_names
+    = profile.get_function_names ();
+  const std::vector<uint32_t> &file_name_map = profile.get_file_name_map ();
+  const std::vector<std::string> &file_names = profile.get_file_names ();
+  if (name_idx >= function_names.size () || name_idx >= file_name_map.size ())
+    {
+      fprintf (stderr, _("Error: v3 function name index out of range\n"));
+      return false;
+    }
+  func.desc.name_index = name_idx;
+  func.id = name_idx;
+  const uint32_t file_idx = file_name_map[name_idx];
+  func.desc.file_index
+    = (file_idx < file_names.size ()) ? file_idx : INVALID_INDEX;
+  if (!gcov_read_uint32 (cur_, end_, num_pos)
+      || !gcov_read_uint32 (cur_, end_, num_inline_calls))
+    return false;
+  const size_t n_pos = num_pos;
+  const size_t n_cs = num_inline_calls;
+  if (n_pos > ~(size_t) 0 - n_cs)
+    return false;
+  func.locations.reserve (n_pos + n_cs);
+  for (uint32_t i = 0; i < num_pos; i++)
+    {
+      std::unique_ptr<gcov_location> location = nullptr;
+      if (!read_pos_count (location))
+	return false;
+      func.locations.emplace_back (std::move (location));
+    }
+
+  for (uint32_t i = 0; i < num_inline_calls; i++)
+    {
+      std::unique_ptr<gcov_location> location
+	= std::make_unique<gcov_location_inline> ();
+      if (!read_inline_callsite (
+	    *static_cast<gcov_location_inline *> (location.get ()), 0))
+	return false;
+      func.locations.emplace_back (std::move (location));
+    }
+
+  std::stable_sort (func.locations.begin (),
+		    func.locations.end (),
+		    [] (const std::unique_ptr<gcov_location> &one,
+			const std::unique_ptr<gcov_location> &two)
+		    {
+		      return one->offset < two->offset
+			     || (one->offset == two->offset
+				 && one->discriminator < two->discriminator);
+		    });
+
+  func.total_count = gcov_function_subtree_count (func);
+  return true;
+}
+
+/* Read the function records and index them by id.  */
+bool
+gcov_reader_v3::read_functions (std::vector<gcov_function> &functions)
+{
+  if (!read_expected_tag
+	(cur_, end_, v3::format::GCOV_TAG_AFDO_FUNCTION, "AFDO_FUNCTION"))
+    return false;
+
+  if (!read_record_length (cur_, end_))
+    return false;
+
+  uint32_t num_functions = 0;
+  if (!gcov_read_uint32 (cur_, end_, num_functions))
+    return false;
+  /* head_count, timestamp, name index, num_pos, num_inline_calls.  */
+  if (cur_ > end_
+      || (num_functions != 0
+	  && num_functions
+	       > (size_t) (end_ - cur_)
+		   / (2 * sizeof (uint64_t) + 3 * sizeof (uint32_t))))
+    return false;
+
+  functions.reserve (num_functions);
+  for (uint32_t i = 0; i < num_functions; i++)
+    {
+      functions.emplace_back ();
+      if (!read_function (functions.back ()))
+	return false;
+    }
+
+  return true;
+}
+
+/* Map the profile and read its header and the four AFDO records.  */
+bool
+gcov_reader_v3::read ()
+{
+  afdo_tools::file_mmap fb;
+  if (!fb.map (path))
+    {
+      fprintf (stderr, _("Error: cannot mmap %s\n"), path.c_str ());
+      return false;
+    }
+  cur_ = fb.data ();
+  end_ = fb.data () + fb.size ();
+
+  uint32_t magic = 0;
+  if (!gcov_read_uint32 (cur_, end_, magic))
+    {
+      fprintf (stderr, _("Error: Failed to read magic number\n"));
+      return false;
+    }
+
+  if (magic != v3::format::AFDO_GCOV_DATA_MAGIC)
+    {
+      fprintf (stderr, _("Error: Invalid magic number\n"));
+      return false;
+    }
+
+  uint32_t checksum = 0;
+  if (!gcov_read_uint32 (cur_, end_, version)
+      || !gcov_read_uint32 (cur_, end_, checksum))
+    {
+      fprintf (stderr, _("Error: Failed to read version/checksum\n"));
+      return false;
+    }
+  (void) checksum;
+
+  if (version != v3::format::AFDO_GCOV_VERSION)
+    {
+      fprintf (stderr, _("Error: unsupported v3 version %u\n"),
+	       (unsigned) version);
+      return false;
+    }
+
+  gcov_summary summary;
+  if (!read_summary (summary))
+    {
+      fprintf (stderr, _("Error: Unable to read summary information\n"));
+      return false;
+    }
+  profile.set_summary (std::move (summary));
+
+  std::vector<std::string> file_names;
+  if (!read_file_names (file_names))
+    {
+      fprintf (stderr, _("Error: Unable to read file names\n"));
+      return false;
+    }
+
+  std::vector<std::string> function_names;
+  std::vector<uint32_t> file_name_map;
+  if (!read_function_names (function_names, file_name_map))
+    {
+      fprintf (stderr, _("Error: Unable to read function names\n"));
+      return false;
+    }
+  profile.set_names (std::move (file_names), std::move (function_names),
+		     std::move (file_name_map));
+
+  std::vector<gcov_function> functions;
+  if (!read_functions (functions))
+    {
+      fprintf (stderr, _("Error: Unable to read function information\n"));
+      return false;
+    }
+  profile.set_functions (std::move (functions));
+
+  return true;
+}
+
+} /* namespace gcov.  */
