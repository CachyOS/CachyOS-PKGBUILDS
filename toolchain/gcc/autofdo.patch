+#include <memory>
+#include <string>
+#include <sys/stat.h>
+#include <vector>
+
+/* afdo_create -- build an AutoFDO profile from a binary plus perf samples.  */
+
+namespace {
+
+/* Reject a numeric option argument unless it is the whole of TEXT.  strto*
+   skips leading blanks and stops at the first unconvertible character, so
+   both have to be rejected explicitly for "12abc" and " 12" to fail.  */
+bool
+parse_uint64_option (const char *text, uint64_t min_value, uint64_t max_value,
+		     uint64_t &out)
+{
+  if (text == nullptr || *text == '\0'
+      || isspace (static_cast<unsigned char> (*text))
+      || *text == '-' || *text == '+')
+    return false;
+  errno = 0;
+  char *end = nullptr;
+  const unsigned long long value = std::strtoull (text, &end, 10);
+  if (errno == ERANGE || end == text || *end != '\0')
+    return false;
+  if (value < min_value || value > max_value)
+    return false;
+  out = static_cast<uint64_t> (value);
+  return true;
+}
+
+/* As parse_uint64_option, but for a finite fraction.  NaN and infinity are
+   rejected here.  Every ordered comparison against NaN is false, so a range
+   check alone would let it through.  */
+bool
+parse_double_option (const char *text, double min_value, double max_value,
+		     double &out)
+{
+  if (text == nullptr || *text == '\0' || isspace ((unsigned char) *text))
+    return false;
+  errno = 0;
+  char *end = nullptr;
+  const double value = std::strtod (text, &end);
+  if (errno == ERANGE || end == text || *end != '\0')
+    return false;
+  if (!std::isfinite (value) || value < min_value || value > max_value)
+    return false;
+  out = value;
+  return true;
+}
+
+struct program_options
+{
+  std::string perf_data_file;
+  std::string binary_file = "data.binary";
+  std::string output_file = "fbdata.afdo";
+  std::vector<std::string> command_argv;
+  autofdo::profiler_run_options run;
+  perf_data::sampling_mode sampling_mode
+    = perf_data::sampling_mode::BRANCH_STACK;
+  bool sample_period_set = false;
+  bool ring_buffer_kb_set = false;
+  bool no_inherit_set = false;
+  bool print_help = false;
+  bool print_version = false;
+};
+
+static void
+print_usage (const char *program_name)
+{
+  printf (_("Usage:\n"
+	  "  %s -b <binary> -o <output> [OPTIONS] -- <command> "
+	  "[args...]\n"
+	  "  %s -p <perf.data> -b <binary> -o <output> [OPTIONS]\n\n"
+	  "  -b, --binary FILE        Binary with DWARF (and command to run)\n"
+	  "  -o, --output FILE       Output profile path\n"
+	  "  --                       Separator; following args are the "
+	  "command\n\n"
+	  "Perf.data mode (optional): build profile from existing perf.data.\n"
+	  "  -p, --perf FILE          Path to perf.data (branch-stack: "
+	  "x86 LBR, ARM BRBE)\n"
+	  "  -b, --binary FILE        Binary with DWARF\n"
+	  "  -o, --output FILE       Output profile path\n\n"
+	  "                           Offline defaults: data.binary, perf.data,\n"
+	  "                           and fbdata.afdo.\n\n"
+	  "Profile options:\n"
+	  "      --sample-threshold-frac F  Skip below F * total profile "
+	  "mass\n"
+	  "                           (create_gcov "
+	  "--sample_threshold_frac;\n"
+	  "                           default 0 = "
+	  "--min-samples floor only).\n"
+	  "      --min-samples N      Skip function groups with fewer than N "
+	  "samples\n"
+	  "                           (default 10; 0 keeps every sampled "
+	  "function).\n"
+	  "  -j, --jobs N             Parallel DWARF parse + correlate "
+	  "threads\n"
+	  "                           (default 8).\n"
+	  "      --sample-period N    Live capture only: cycles between "
+	  "samples\n"
+	  "                           (default 100003; lower samples more "
+	  "often).\n"
+	  "      --ring-buffer-kb N   Live capture only: ring buffer per CPU\n"
+	  "                           (default 128; capped by "
+	  "perf_event_mlock_kb).\n"
+	  "      --no-inherit         Live capture only: do not follow the "
+	  "workload's\n"
+	  "                           threads, which needs only one buffer.\n"
+	  "      --no-branch-stack    Per-PC counts only (create_gcov "
+	  "use_branch_stack=false).\n"
+	  "      --no-lbr             Alias for --no-branch-stack.\n"
+	  "                           Default: branch-stack range expansion.\n"
+	  "  -s, --spe                Use ARM SPE reader with -p "
+	  "(perf.data only)\n\n"
+	  "Validation:\n"
+	  "  -m, --dump-addr-mapping FILE\n"
+	  "                           Link-time address, function, source "
+	  "location and\n"
+	  "                           inline stack for each run of PCs.\n"
+	  "  -D, --dump-perf-maps FILE\n"
+	  "                           After perf load, dump address_count, "
+	  "range_count,\n"
+	  "                           and branch_count maps (link-time "
+	  "addresses).\n\n"
+	  "General:\n"
+	  "  -h, --help               Show this help\n"
+	  "  -v, --version            Show version\n\n"
+	  "create_gcov compatibility options:\n"
+	  "  --gcov FILE              Output GCOV file\n"
+	  "  --profile FILE           Path to perf.data\n"
+	  "  --profiler ARG           Profile type (Branch-stack ('perf') or "
+	  "SPE ('perf_spe'))\n"
+	  "  --sample_threshold_frac F  Alias for --sample-threshold-frac\n"
+	  "\nFor bug reporting instructions, please see:\n"
+	  "%s.\n"),
+	  program_name, program_name, bug_report_url);
+}
+
+/* Fill OPTIONS from ARGC/ARGV.  Returns false when the command line is
+   rejected, and also for --help and --version, which OPTIONS records so that
+   the caller can print the requested text and exit successfully.  */
+static bool
+parse_arguments (int argc, char *argv[], program_options &options)
+{
+  static option long_options[]
+    = {{"perf", required_argument, nullptr, 'p'},
+       {"binary", required_argument, nullptr, 'b'},
+       {"output", required_argument, nullptr, 'o'},
+       {"dump-addr-mapping", required_argument, nullptr, 'm'},
+       {"dump-perf-maps", required_argument, nullptr, 'D'},
+       {"no-branch-stack", no_argument, nullptr, 'L'},
+       {"no-lbr", no_argument, nullptr, 'L'},
+       {"gcov", required_argument, nullptr, 0},
+       {"profile", required_argument, nullptr, 0},
+       {"profiler", required_argument, nullptr, 0},
+       {"spe", no_argument, nullptr, 's'},
+       {"sample-threshold-frac", required_argument, nullptr, 'F'},
+       {"sample_threshold_frac", required_argument, nullptr, 'F'},
+       {"min-samples", required_argument, nullptr, 0},
+       {"sample-period", required_argument, nullptr, 0},
+       {"ring-buffer-kb", required_argument, nullptr, 0},
+       {"no-inherit", no_argument, nullptr, 0},
+       {"jobs", required_argument, nullptr, 'j'},
+       {"help", no_argument, nullptr, 'h'},
+       {"version", no_argument, nullptr, 'v'},
+       {nullptr, 0, nullptr, 0}};
+
+  int c;
+  int option_index = 0;
+
+  /* create_gcov and SPEC pass long options with one dash.  */
+  while ((c = getopt_long_only (
+	    argc, argv, "p:b:o:m:D:LsF:j:hv", long_options, &option_index))
+	 != -1)
+    {
+      switch (c)
+	{
+	case 'p':
+	  options.perf_data_file = optarg;
+	  break;
+	case 'b':
+	  options.binary_file = optarg;
+	  break;
+	case 'o':
+	  options.output_file = optarg;
+	  break;
+	case 's':
+	  options.sampling_mode = perf_data::sampling_mode::SPE;
+	  break;
+	case 'm':
+	  options.run.dump_address_mapping = optarg;
+	  break;
+	case 'D':
+	  options.run.dump_perf_maps = optarg;
+	  break;
+	case 'F':
+	  {
+	    double v = 0.0;
+	    if (!parse_double_option (optarg, 0.0, 1.0, v))
+	      {
+		fprintf (stderr,
+			 _("Invalid --sample-threshold-frac (need 0 <= F <= 1)"
+			   ": %s\n"),
+			 optarg);
+		return false;
+	      }
+	    options.run.sample_threshold_frac = v;
+	  }
+	  break;
+	case 'j':
+	  {
+	    uint64_t n = 0;
+	    if (!parse_uint64_option (optarg, 1, UINT_MAX, n))
+	      {
+		fprintf (stderr,
+			 _("Invalid -j/--jobs (need 1 <= N <= %u): %s\n"),
+			 UINT_MAX, optarg);
+		return false;
+	      }
+	    options.run.correlate_threads = static_cast<unsigned> (n);
+	  }
+	  break;
+	case 'L':
+	  options.run.use_branch_stack = false;
+	  break;
+	case 'v':
+	  options.print_version = true;
+	  return false;
+	case 'h':
+	  options.print_help = true;
+	  return false;
+	case '?':
+	  fprintf (stderr, _("Try '%s --help' for more information.\n"),
+		   argv[0]);
+	  return false;
+	default:
+	  if (c != 0)
+	    return false;
+
+	  if (!strcmp (long_options[option_index].name, "profile"))
+	    options.perf_data_file = optarg;
+	  else if (!strcmp (long_options[option_index].name, "profiler"))
+	    {
+	      if (!strcmp (optarg, "perf"))
+		options.sampling_mode = perf_data::sampling_mode::BRANCH_STACK;
+	      else if (!strcmp (optarg, "perf_spe"))
+		options.sampling_mode = perf_data::sampling_mode::SPE;
+	      else
+		{
+		  fprintf (stderr,
+			   _("Invalid option for --profiler: expected 'perf' "
+			     "or 'perf_spe', got: %s\n"),
+			   optarg);
+		  return false;
+		}
+	    }
+	  else if (!strcmp (long_options[option_index].name, "gcov"))
+	    options.output_file = optarg;
+	  else if (!strcmp (long_options[option_index].name, "sample-period"))
+	    {
+	      uint64_t n = 0;
+	      if (!parse_uint64_option (optarg, 1, UINT64_MAX, n))
+		{
+		  fprintf (stderr,
+			   _("Invalid --sample-period (need N >= 1): %s\n"),
+			   optarg);
+		  return false;
+		}
+	      options.run.live_sample_period = n;
+	      options.sample_period_set = true;
+	    }
+	  else if (!strcmp (long_options[option_index].name, "min-samples"))
+	    {
+	      uint64_t n = 0;
+	      if (!parse_uint64_option (optarg, 0, UINT64_MAX, n))
+		{
+		  fprintf (stderr, _("Invalid --min-samples: %s\n"), optarg);
+		  return false;
+		}
+	      options.run.min_samples = n;
+	    }
+	  else if (!strcmp (long_options[option_index].name, "ring-buffer-kb"))
+	    {
+	      uint64_t n = 0;
+	      if (!parse_uint64_option (optarg, 1, UINT32_MAX, n))
+		{
+		  fprintf (stderr,
+			   _("Invalid --ring-buffer-kb (need N >= 1): %s\n"),
+			   optarg);
+		  return false;
+		}
+	      options.run.live_ring_buffer_kb = static_cast<unsigned> (n);
+	      options.ring_buffer_kb_set = true;
+	    }
+	  else if (!strcmp (long_options[option_index].name, "no-inherit"))
+	    {
+	      options.run.live_inherit = false;
+	      options.no_inherit_set = true;
+	    }
+	}
+    }
+
+  if (optind < argc)
+    {
+      if (!options.perf_data_file.empty ())
+	{
+	  fprintf (stderr, _("Error: unexpected argument with -p: %s\n"),
+		   argv[optind]);
+	  return false;
+	}
+      for (int j = optind; j < argc; ++j)
+	options.command_argv.push_back (argv[j]);
+    }
+
+  if (options.binary_file.empty ())
+    {
+      fprintf (stderr, _("Error: binary is required (-b option)\n"));
+      return false;
+    }
+  if (options.output_file.empty ())
+    {
+      fprintf (stderr, _("Error: output is required (-o option)\n"));
+      return false;
+    }
+  if (options.perf_data_file.empty () && options.command_argv.empty ())
+    options.perf_data_file = "perf.data";
+  if (!options.perf_data_file.empty () && !options.command_argv.empty ())
+    {
+      fprintf (stderr,
+	       _("Error: use either -p <perf.data> or command (--), not "
+		 "both\n"));
+      return false;
+    }
+  if (options.perf_data_file.empty ()
+      && options.sampling_mode == perf_data::sampling_mode::SPE)
+    {
+      fprintf (stderr,
+	       _("Error: -s/--spe requires -p <perf.data> (live SPE profiling "
+		 "is not supported)\n"));
+      return false;
+    }
+  const char *live_only = nullptr;
+  if (options.sample_period_set)
+    live_only = "--sample-period";
+  else if (options.ring_buffer_kb_set)
+    live_only = "--ring-buffer-kb";
+  else if (options.no_inherit_set)
+    live_only = "--no-inherit";
+  if (!options.perf_data_file.empty () && live_only != nullptr)
+    {
+      fprintf (stderr,
+	       _("Error: %s applies to live capture only; perf.data was "
+		 "recorded with its own settings\n"),
+	       live_only);
+      return false;
+    }
+
+  return true;
+}
+
+/* Build a profiler reading an existing perf.data, or one that captures live
+   samples from the command given after "--".  */
+static std::unique_ptr<autofdo::autofdo_profiler>
+make_profiler (const program_options &options)
+{
+  if (!options.perf_data_file.empty ())
+    return std::make_unique<autofdo::autofdo_profiler> (options.binary_file,
+							options.run,
+							options.perf_data_file,
+							options.sampling_mode);
+  return std::make_unique<autofdo::autofdo_profiler> (
+    options.binary_file, options.run, options.command_argv);
+}
+
+/* Write PROFILE in the version and encoding requested by OPTIONS.  */
+static bool
+write_gcov_output (const program_options &options,
+		   const gcov::gcov_profile &profile)
+{
+  gcov::gcov_writer_options writer_options;
+  std::unique_ptr<gcov::gcov_writer_base> generator
+    = gcov::make_gcov_writer (options.output_file, &profile, writer_options);
+  if (!generator)
+    {
+      fprintf (stderr, _("Error: unsupported output profile format\n"));
+      return false;
+    }
+
+  if (!generator->write ())
+    {
+      fprintf (stderr, _("Error: Failed to generate GCOV file\n"));
+      return false;
+    }
+  return true;
+}
+
+/* Check that the inputs named in OPTIONS exist.  A binary without execute
+   permission only draws a warning.  */
+static bool
+validate_input_files (const program_options &options)
+{
+  struct stat st;
+
+  if (!options.perf_data_file.empty ())
+    {
+      if (stat (options.perf_data_file.c_str (), &st) != 0)
+	{
+	  fprintf (stderr,
+		   _("Error: perf.data file does not exist: %s\n"),
+		   options.perf_data_file.c_str ());
+	  return false;
+	}
+    }
+
+  if (stat (options.binary_file.c_str (), &st) != 0)
+    {
+      fprintf (stderr,
+	       _("Error: binary file does not exist: %s\n"),
+	       options.binary_file.c_str ());
+      return false;
+    }
+
+  if ((st.st_mode & S_IXUSR) == 0)
+    fprintf (stderr,
+	     _("Warning: binary file is not executable: %s\n"),
+	     options.binary_file.c_str ());
+
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+int
+main (int argc, char *argv[])
+{
+  afdo_init_libintl ();
+
+  program_options options;
+
+  if (!parse_arguments (argc, argv, options))
+    {
+      if (options.print_help)
+	print_usage (argv[0]);
+      else if (options.print_version)
+	{
+	  printf ("afdo_create %s%s\n", pkgversion_string, version_string);
+	}
+      else
+	return 1;
+      return 0;
+    }
+
+  if (!validate_input_files (options))
+    return 1;
+
+  /* Resolve the binary to an absolute, symlink-free path, keeping the path as
+     given if that is not possible.  */
+  char *resolved = realpath (options.binary_file.c_str (), nullptr);
+  if (resolved != nullptr)
+    {
+      options.binary_file.assign (resolved);
+      free (resolved);
+    }
+
+  auto profiler = make_profiler (options);
+
+  if (!profiler->generate_profile ())
+    {
+      fprintf (stderr, _("Error: Failed to generate profile\n"));
+      return 1;
+    }
+
+  const std::chrono::steady_clock::time_point write_start
+    = std::chrono::steady_clock::now ();
+  if (!write_gcov_output (options, profiler->get_gcov_profile ()))
+    return 1;
+  fprintf (stderr, "AFDO: write gcov took %.1fs\n",
+	   std::chrono::duration<double> (
+	     std::chrono::steady_clock::now () - write_start).count ());
+
+  return 0;
+}
-- 
