+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_RANGE_INDEX_H
+#define GCC_RANGE_INDEX_H
+
+#include "afdo_assert.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace dwarf_debug {
+
+/* Maximum end at NODE of MAX_ENDS, or 0 past the last range.  */
+#define RANGE_INDEX_NODE_MAX(MAX_ENDS, NODE) \
+  ((NODE) < (MAX_ENDS).size () ? (MAX_ENDS)[(NODE)] : 0)
+
+/* Overlap index over RANGE values held by the caller.  Each value describes
+   a half-open interval using start and end.  The indexed vector must outlive
+   the index and must not be changed without rebuilding it.  */
+template <typename Range>
+class range_index
+{
+public:
+  void
+  check_valid () const
+  {
+    afdo_assert (ranges_ != nullptr);
+    afdo_assert (ranges_->data () == ranges_data_);
+    afdo_assert (ranges_->size () == range_count_);
+  }
+
+  /* RANGES must be sorted by start.  Each leaf stores one range's end, and
+     each internal node stores the maximum end below it.  Leaves past the
+     last range are not stored.  */
+  void
+  build (const std::vector<Range> &ranges)
+  {
+    afdo_assert (std::is_sorted (
+      ranges.begin (), ranges.end (),
+      [] (const Range &a, const Range &b)
+      {
+	return a.start < b.start;
+      }));
+    ranges_ = &ranges;
+    ranges_data_ = ranges.data ();
+    range_count_ = ranges.size ();
+    leaf_base_ = 1;
+    while (leaf_base_ < ranges.size ())
+      {
+	afdo_assert (leaf_base_
+		     <= std::numeric_limits<size_t>::max () / 2);
+	leaf_base_ <<= 1;
+      }
+    afdo_assert (leaf_base_
+		 <= std::numeric_limits<size_t>::max () - ranges.size ());
+    max_ends_.assign (leaf_base_ + ranges.size (), 0);
+    for (size_t i = 0; i < ranges.size (); ++i)
+      max_ends_[leaf_base_ + i] = ranges[i].end;
+    for (size_t i = leaf_base_; i-- > 1;)
+      max_ends_[i] = std::max (RANGE_INDEX_NODE_MAX (max_ends_, i * 2),
+			       RANGE_INDEX_NODE_MAX (max_ends_, i * 2 + 1));
+  }
+
+  /* Call VISITOR with each range overlapping [START, END), in ascending
+     start order.  */
+  template <typename Visitor>
+  void
+  visit_overlapping (uint64_t start, uint64_t end, Visitor visitor) const
+  {
+    check_valid ();
+    const std::vector<Range> &ranges = *ranges_;
+    if (start >= end || ranges.empty ())
+      return;
+    const auto limit
+      = std::lower_bound (ranges.begin (), ranges.end (), end,
+			  [] (const Range &range, uint64_t address)
+			  {
+			    return range.start < address;
+			  });
+    visit (ranges, 1, 0, leaf_base_,
+	   static_cast<size_t> (limit - ranges.begin ()), start, visitor);
+  }
+
+private:
+  /* Visit candidate leaves below NODE.  Ignore indices at or beyond
+     RANGE_LIMIT and subtrees whose ranges all end at or before QUERY_START.
+     NODE covers indices from NODE_BEGIN up to but not including NODE_END.  */
+  template <typename Visitor>
+  void
+  visit (const std::vector<Range> &ranges, size_t node, size_t node_begin,
+	 size_t node_end, size_t range_limit, uint64_t query_start,
+	 Visitor &visitor) const
+  {
+    if (node_begin >= range_limit
+	|| RANGE_INDEX_NODE_MAX (max_ends_, node) <= query_start)
+      return;
+    if (node >= leaf_base_)
+      {
+	visitor (ranges[node - leaf_base_]);
+	return;
+      }
+    const size_t middle = node_begin + (node_end - node_begin) / 2;
+    visit (ranges, node * 2, node_begin, middle, range_limit, query_start,
+	   visitor);
+    visit (ranges, node * 2 + 1, middle, node_end, range_limit, query_start,
+	   visitor);
+  }
+
+  size_t leaf_base_ = 0;
+  std::vector<uint64_t> max_ends_;
+  const std::vector<Range> *ranges_ = nullptr;
+  const Range *ranges_data_ = nullptr;
+  size_t range_count_ = 0;
+};
+
+#undef RANGE_INDEX_NODE_MAX
+
+} /* namespace dwarf_debug.  */
+
+#endif /* GCC_RANGE_INDEX_H.  */
diff --git a/afdo-tools/src/symbol_util.cc b/afdo-tools/src/symbol_util.cc
new file mode 100644
index 00000000000..d94d549579b
--- /dev/null
+++ b/afdo-tools/src/symbol_util.cc
@@ -0,0 +1,258 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "symbol_util.h"
+
+#include <algorithm>
+#include <cstring>
+
+namespace gcc_symbol {
+
+namespace {
+
+/* Keep this list explicit.  A generic .TAG.N match would also strip clones
+   with distinct profiles, such as .omp_fn.N.  */
+const char *const profile_equivalent_suffix_tags[] = {
+  ".isra", ".constprop", ".part", ".__part", ".lto_priv", ".clone",
+  ".cold", ".hot"
+};
+
+const char *const gcc_split_part_tags[] = {".cold", ".hot"};
+const char *const gcc_dotted_copy_tags[] = {".llvm", ".__part"};
+
+enum class suffix_position
+{
+  terminal,
+  embedded
+};
+
+/* Locate TAG and its optional or required number.  An embedded numbered tag
+   can be followed by further suffixes.  */
+bool
+match_tag (const char *name, const char *tag,
+	   suffix_number number, suffix_position position, size_t &at,
+	   size_t &end)
+{
+  if (*tag == '\0')
+    return false;
+  const char *match = nullptr;
+  for (const char *p = name; (p = std::strstr (p, tag)) != nullptr; ++p)
+    match = p;
+  if (match == nullptr)
+    return false;
+  at = static_cast<size_t> (match - name);
+  const char *p = match + std::strlen (tag);
+  if (*p == '\0')
+    {
+      end = static_cast<size_t> (p - name);
+      return number != suffix_number::required;
+    }
+  if (number == suffix_number::none || *p != '.')
+    return false;
+  const char *digits = ++p;
+  while (*p >= '0' && *p <= '9')
+    ++p;
+  end = static_cast<size_t> (p - name);
+  return p != digits
+    && (*p == '\0' || (position == suffix_position::embedded && *p == '.'));
+}
+
+bool
+erase_tag (std::string &name, const char *tag,
+	   suffix_number number, suffix_position position)
+{
+  size_t at, end;
+  if (!match_tag (name.c_str (), tag, number, position, at, end))
+    return false;
+  name.erase (at, end - at);
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+bool
+has_terminal_suffix (const char *name, const char *tag,
+		     suffix_number number)
+{
+  size_t at, end;
+  return match_tag (name, tag, number, suffix_position::terminal, at, end);
+}
+
+std::string
+symbol_base_name (std::string name)
+{
+  for (;;)
+    {
+      bool changed = false;
+      for (const char *tag : profile_equivalent_suffix_tags)
+	if (erase_tag (name, tag, suffix_number::required,
+		       suffix_position::terminal))
+	  {
+	    changed = true;
+	    break;
+	  }
+      if (!changed)
+	for (const char *tag : gcc_split_part_tags)
+	  if (erase_tag (name, tag, suffix_number::none,
+			 suffix_position::terminal))
+	    {
+	      changed = true;
+	      break;
+	    }
+      if (!changed)
+	break;
+    }
+  return name;
+}
+
+std::string
+symbol_split_part_parent (std::string name)
+{
+  bool changed;
+  do
+    {
+      changed = false;
+      for (const char *tag : gcc_split_part_tags)
+	if (erase_tag (name, tag, suffix_number::optional,
+		       suffix_position::terminal))
+	  changed = true;
+      if (erase_tag (name, ".part", suffix_number::required,
+		     suffix_position::terminal))
+	changed = true;
+      for (const char *tag : gcc_dotted_copy_tags)
+	if (erase_tag (name, tag, suffix_number::required,
+		       suffix_position::embedded))
+	  changed = true;
+    }
+  while (changed);
+  return name;
+}
+
+bool
+name_equivalent (const std::string &a, const std::string &b)
+{
+  if (a.empty () || b.empty ())
+    return false;
+  if (a == b)
+    return true;
+  const std::string a_part = symbol_split_part_parent (a);
+  const std::string b_part = symbol_split_part_parent (b);
+  if (a_part == b_part)
+    return true;
+  const std::string a_base = symbol_base_name (a_part);
+  const std::string b_base = symbol_base_name (b_part);
+  return a_base == b_base && (a_part == a_base || b_part == b_base);
+}
+
+} /* namespace gcc_symbol.  */
+
+namespace source_path {
+
+std::string
+normalize (std::string path)
+{
+  if (path.empty ())
+    return path;
+  for (char &c : path)
+    if (c == '\\')
+      c = '/';
+  while (path.size () >= 2 && path[0] == '.' && path[1] == '/')
+    path.erase (0, 2);
+  for (;;)
+    {
+      const size_t pos = path.find ("/./");
+      if (pos == std::string::npos)
+	break;
+      path.erase (pos, 2);
+    }
+  for (;;)
+    {
+      const size_t pos = path.find ("//");
+      if (pos == std::string::npos)
+	break;
+      path.erase (pos, 1);
+    }
+  /* A leading ".." has nothing to cancel and stays.  */
+  for (size_t pos = 0; (pos = path.find ("/../", pos)) != std::string::npos;)
+    {
+      const size_t prev = pos == 0 ? std::string::npos
+				   : path.rfind ('/', pos - 1);
+      const size_t begin = prev == std::string::npos ? 0 : prev + 1;
+      if (pos == begin || path.compare (begin, pos - begin, "..") == 0)
+	{
+	  pos += 3;
+	  continue;
+	}
+      path.erase (begin, pos + 4 - begin);
+      pos = begin == 0 ? 0 : begin - 1;
+    }
+  return path;
+}
+
+bool
+equivalent (const std::string &a, const std::string &b)
+{
+  if (a.empty () || b.empty ())
+    return false;
+  if (a == b)
+    return true;
+  const auto is_separator = [] (char c)
+    {
+      return c == '/' || c == '\\';
+    };
+  const std::string &longer = a.size () > b.size () ? a : b;
+  const std::string &shorter = a.size () > b.size () ? b : a;
+  if (is_separator (shorter[0])
+      || longer.compare (longer.size () - shorter.size (),
+			 shorter.size (), shorter)
+	   != 0)
+    return false;
+  const size_t start = longer.size () - shorter.size ();
+  return start != 0 && is_separator (longer[start - 1]);
+}
+
+} /* namespace source_path.  */
+
+namespace dwarf_debug {
+
+const function_metadata *
+function_containing_address (const std::vector<function_metadata> &funcs,
+			     uint64_t address)
+{
+  auto it = std::upper_bound (funcs.begin (), funcs.end (), address,
+			      [] (uint64_t addr, const function_metadata &func)
+			      { return addr < func.start_addr; });
+  if (it == funcs.begin ())
+    return nullptr;
+  --it;
+  return address < it->end_addr ? &*it : nullptr;
+}
+
+const function_metadata *
+function_at_entry_pc (const std::vector<function_metadata> &funcs, uint64_t pc)
+{
+  auto it = std::lower_bound (funcs.begin (), funcs.end (), pc,
+			      [] (const function_metadata &func,
+				  uint64_t addr)
+			      {
+				return func.start_addr < addr;
+			      });
+  return it != funcs.end () && it->start_addr == pc ? &*it : nullptr;
+}
+
+} /* namespace dwarf_debug.  */
diff --git a/afdo-tools/src/symbol_util.h b/afdo-tools/src/symbol_util.h
