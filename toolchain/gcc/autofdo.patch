+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "file_mmap.h"
+
+#include <fcntl.h>
+#include <limits>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace afdo_tools {
+
+file_mmap::~file_mmap () { unmap (); }
+
+void
+file_mmap::unmap ()
+{
+  if (addr_ != nullptr)
+    {
+      ::munmap (addr_, size_);
+      addr_ = nullptr;
+      size_ = 0;
+    }
+}
+
+bool
+file_mmap::map (const std::string &path)
+{
+  unmap ();
+
+  int fd = ::open (path.c_str (), O_RDONLY);
+  if (fd < 0)
+    return false;
+
+  struct stat st;
+  if (::fstat (fd, &st) != 0 || st.st_size <= 0)
+    {
+      ::close (fd);
+      return false;
+    }
+
+  if (static_cast<uintmax_t> (st.st_size)
+      > static_cast<uintmax_t> (std::numeric_limits<size_t>::max ()))
+    {
+      ::close (fd);
+      return false;
+    }
+  const size_t len = static_cast<size_t> (st.st_size);
+  void *m = ::mmap (nullptr, len, PROT_READ, MAP_PRIVATE, fd, 0);
+  ::close (fd);
+  if (m == MAP_FAILED)
+    return false;
+
+#ifdef MADV_SEQUENTIAL
+  ::madvise (m, len, MADV_SEQUENTIAL);
+#endif
+
+  addr_ = m;
+  size_ = len;
+  return true;
+}
+
+} /* namespace afdo_tools.  */
diff --git a/afdo_tools/src/file_mmap.h b/afdo_tools/src/file_mmap.h
new file mode 100644
