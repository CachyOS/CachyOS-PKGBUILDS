+
+#include "branch_stack_reader_base.h"
+#include "perf_file_reader.h"
+
+#include <cstdint>
+#include <string>
+
+namespace perf_data {
+
+/* Offline LBR/BRBE: SAMPLE + BRANCH_STACK into range/branch maps.  */
+class perf_branch_stack_reader : public perf_file_reader,
+				 public branch_stack_reader_base
+{
+public:
+  perf_branch_stack_reader (const std::string &_perf_data_path,
+			    const std::string &_binary_path);
+  ~perf_branch_stack_reader () override = default;
+
+  void set_accumulate_sample_ips (bool accumulate) override
+  {
+    accumulate_sample_ips_ = accumulate;
+  }
+
+  /* Expand range endpoints when sample IPs were not kept.  */
+  void materialize_address_frequencies_for_per_pc_correlate () override;
+
+  branch_stack_reader_base *as_branch_stack_reader () override { return this; }
+  const branch_stack_reader_base *as_branch_stack_reader () const override
+  {
+    return this;
+  }
+
+private:
+  bool parse_perf_data_section () override;
+  bool parse_sample_record (const uint8_t *record_data, size_t record_size);
+  bool
+  parse_sample_record_fixed_branch_stack_layout (const uint8_t *record_data,
+						 size_t record_size);
+  void compute_profile_total_count ();
+  void finalize_profile_maps_impl () override;
+
+  branch_stack_edge_count_map range_count_map;
+  branch_stack_edge_count_map branch_count_map;
+
+  bool accumulate_sample_ips_ = true;
+  bool use_fixed_layout_branch_stack_parse_ = false;
+};
+
+} /* namespace perf_data.  */
