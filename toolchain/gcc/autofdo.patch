+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_GCOV_READER_H
+#define GCC_GCOV_READER_H
+
+#include "gcov.h"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace gcov {
+
+class gcov_reader_base
+{
+protected:
+  gcov_profile profile;
+  std::string path;
+
+  uint32_t magic = 0;
+  uint32_t version = 0;
+
+public:
+  gcov_reader_base (const std::string &path_);
+  virtual ~gcov_reader_base ();
+  virtual bool read () = 0;
+  const gcov_profile *get_profile () const { return &profile; }
+
+  uint32_t get_version () const { return version; }
+};
+
+/* Reader for version 3 of the GCOV format.  */
+class gcov_reader_v3 : public gcov_reader_base
+{
+  const uint8_t *cur_ = nullptr;
+  const uint8_t *end_ = nullptr;
+  bool read_summary ();
+  bool read_file_names ();
+  bool read_function_names ();
+  bool read_pos_count (std::unique_ptr<gcov_location> &loc);
+  bool read_inline_callsite (gcov_location_inline &callsite);
+  bool read_function (gcov_function &func);
+  bool read_functions ();
+
+public:
+  explicit gcov_reader_v3 (const std::string &path_) : gcov_reader_base (path_)
+  {}
+  bool read () override;
+};
+
+enum class profile_format
+{
+  unknown,
+  v3_binary,
+};
+
+/* Sniff a profile file's format from its leading bytes.  */
+profile_format detect_format (const std::string &path);
+
+/* Construct the reader appropriate for PATH, or return nullptr when its format
+   is unsupported by this build.  */
+std::unique_ptr<gcov_reader_base> make_gcov_reader (const std::string &path);
+
+} /* namespace gcov.  */
+
+#endif /* GCC_GCOV_READER_H.  */
