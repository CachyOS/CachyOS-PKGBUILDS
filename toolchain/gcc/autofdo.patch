+
+dwarf_reader_impl::dwarf_reader_impl (
+  std::string _binary_path,
+  std::vector<std::pair<uint64_t, uint64_t>> sampled_ranges,
+  bool _debug_enabled)
+  : binary_path (std::move (_binary_path)), debug_enabled (_debug_enabled)
+{
+  /* Split sample scope into merged intervals.  */
+  std::vector<std::pair<uint64_t, uint64_t>> ranges;
+  ranges.reserve (sampled_ranges.size ());
+  for (const auto &sampled_range : sampled_ranges)
+    {
+      const uint64_t start = sampled_range.first;
+      const uint64_t end = sampled_range.second;
+      if (end <= start)
+	continue;
+      ranges.emplace_back (start, end);
+    }
+
+  std::sort (ranges.begin (), ranges.end ());
+  for (const auto &r : ranges)
+    {
+      if (!profile_sample_ranges_.empty ()
+	  && r.first <= profile_sample_ranges_.back ().second)
+	profile_sample_ranges_.back ().second
+	  = std::max (profile_sample_ranges_.back ().second, r.second);
+      else
+	profile_sample_ranges_.push_back (r);
+    }
+}
+
+dwarf_reader_impl::~dwarf_reader_impl () { close_line_dwarf (); }
+
+bool
+dwarf_reader_impl::load ()
+{
+  if (profile_sample_ranges_.empty ())
+    {
+      fprintf (stderr,
+	       "Error: DWARF load requires a non-empty profile sample scope\n");
+      return false;
+    }
+
+  afdo_assert (!mappings_loaded);
+
+  const auto t_load = std::chrono::steady_clock::now ();
+
+  if (debug_enabled)
+    fprintf (stderr, "AFDO: opening libdw...");
+  const auto t_open = std::chrono::steady_clock::now ();
+  if (!open_binary_dwarf ())
+    return false;
+  const auto t_after_open = std::chrono::steady_clock::now ();
+
+  /* ELF symtab index (needed during CU parse).  */
+  build_symtab_func_index ();
+  if (symtab_functions_.empty ())
+    {
+      fprintf (stderr,
+	       "Error: ELF symtab has no correlatable function symbols "
+	       "for profile bucketing.\n");
+      close_line_dwarf ();
+      return false;
+    }
+
+  const auto t_ranges = std::chrono::steady_clock::now ();
+  if (!build_address_range_index ())
+    {
+      close_line_dwarf ();
+      return false;
+    }
+  const auto t_after_ranges = std::chrono::steady_clock::now ();
+
+  /* Dedupe DWARF subprograms and build name index.  */
+
+  const auto t_symtab = std::chrono::steady_clock::now ();
+  sort_dedupe_function_metadata (dwarf_functions_);
+  build_dwarf_func_name_index ();
+  const auto t_after_symtab = std::chrono::steady_clock::now ();
+  if (debug_enabled)
+    {
+      fprintf (stderr,
+	       " %zu profile-touch CUs, %zu DWARF functions, "
+	       "%zu symtab FUNC\n",
+	       profile_cu_offs.size (),
+	       dwarf_functions_.size (),
+	       symtab_functions_.size ());
+    }
+  afdo_assert (mappings_loaded);
+
+  /* Fill missing STT_FUNC file/line from entry-PC symbolize (on demand).  */
+  const auto t_anchors = std::chrono::steady_clock::now ();
+  resolve_touch_symtab_export_anchors ();
+  const auto t_after_anchors = std::chrono::steady_clock::now ();
+
+  load_summary_.touch_cus = profile_cu_offs.size ();
+  load_summary_.dwarf_functions = dwarf_functions_.size ();
+  load_summary_.symtab_functions = symtab_functions_.size ();
+  load_summary_.line_segments = address_ranges_.size ();
+  /* Unique profile-touch PCs (range endpoints); symbolize is on demand.  */
+  {
+    std::vector<uint64_t> touch_pcs;
+    touch_pcs.reserve (profile_sample_ranges_.size () * 2);
+    for (const auto &r : profile_sample_ranges_)
+      {
+	touch_pcs.push_back (r.first);
+	if (r.second > r.first + 1)
+	  touch_pcs.push_back (r.second - 1);
+      }
+    std::sort (touch_pcs.begin (), touch_pcs.end ());
+    touch_pcs.erase (
+      std::unique (touch_pcs.begin (), touch_pcs.end ()), touch_pcs.end ());
+    load_summary_.touch_pcs = touch_pcs.size ();
+  }
+  profile_cu_offs.clear ();
+  profile_cu_offs.shrink_to_fit ();
+
+  if (debug_enabled)
+    {
+      using duration = std::chrono::duration<double>;
+      log_dwarf_load_debug_summary (
+	duration (t_after_open - t_open).count (),
+	duration (t_after_ranges - t_ranges).count (),
+	duration (t_after_symtab - t_symtab).count (),
+	duration (t_after_anchors - t_anchors).count (),
+	duration (t_after_anchors - t_load).count ());
+    }
+
+  close_line_dwarf ();
+  return true;
+}
+
+void
+dwarf_reader_impl::log_dwarf_load_debug_summary (double open_sec,
+						 double ranges_sec,
+						 double symtab_sec,
+						 double anchors_sec,
+						 double load_sec) const
+{
+  fprintf (stderr,
+	   "AFDO: %zu correlate functions (%zu DWARF), %zu touch PCs\n"
+	   "AFDO: DWARF load %.1fs (open %.1f, addr_ranges %.1f, symtab "
+	   "%.1f, anchors %.1f)\n",
+	   load_summary_.symtab_functions,
+	   load_summary_.dwarf_functions,
+	   load_summary_.touch_pcs,
+	   load_sec,
+	   open_sec,
+	   ranges_sec,
+	   symtab_sec,
+	   anchors_sec);
+}
+
+const std::vector<inline_frame> *
+dwarf_reader_impl::inline_stack_at_pc (uint64_t pc) const
+{
+  if (inline_stack_spans_.empty ())
+    return nullptr;
+
+  /* Prefer more frames, then the tighter range.  */
+  const inline_stack_span *best = nullptr;
+  visit_overlapping_ranges (
+    inline_stack_spans_, inline_stack_span_index_, pc, pc + 1,
+    [&] (size_t i)
+    {
+      const inline_stack_span &span = inline_stack_spans_[i];
+      if (!span.stack)
+	return;
+      if (best == nullptr || span.stack->size () > best->stack->size ()
+	  || (span.stack->size () == best->stack->size ()
+	      && span.end - span.start < best->end - best->start))
+	best = &span;
+    });
+  return best != nullptr ? best->stack.get () : nullptr;
+}
+
+void
+dwarf_reader_impl::collect_line_span_seed_pcs (uint64_t start, uint64_t end,
+					       std::vector<uint64_t> &out) const
+{
+  out.clear ();
+  if (start >= end || line_table_spans_.empty ())
+    return;
+
+  std::unordered_set<uint64_t> seen;
+  seen.reserve (64);
+  const address_range_index_span span = overlapping_range_index_span (
+    line_table_spans_, line_table_span_max_ends_, start, end);
+  for (size_t i = span.begin; i < span.end; ++i)
+    {
+      const line_table_span_entry &entry = line_table_spans_[i];
+      if (entry.end <= start)
+	continue;
+      const uint64_t seed_pc
+	= entry.line_table_pc != 0 ? entry.line_table_pc : entry.start;
+      if (seed_pc < start || seed_pc >= end)
+	continue;
+      if (seen.insert (seed_pc).second)
+	out.push_back (seed_pc);
+    }
+}
+
+void
+dwarf_reader_impl::build_line_table_spans_index ()
+{
+  line_table_spans_.clear ();
+  line_table_span_max_ends_.clear ();
+  if (address_ranges_.empty ())
+    return;
+
+  line_table_spans_.reserve (address_ranges_.size () / 2 + 1);
+  for (const address_range_entry &entry : address_ranges_)
+    {
+      if (!line_table_spans_.empty ()
+	  && line_table_spans_.back ().start == entry.start
+	  && line_table_spans_.back ().end == entry.end
+	  && line_table_spans_.back ().line_table_pc == entry.line_table_pc)
+	continue;
+      line_table_span_entry span;
+      span.start = entry.start;
+      span.end = entry.end;
+      span.line_table_pc = entry.line_table_pc;
+      line_table_spans_.push_back (span);
+    }
+  build_range_max_ends (line_table_spans_, line_table_span_max_ends_);
+}
+
+bool
+dwarf_reader_impl::same_line_table_coalesce_group (const address_range_entry &a,
+						   const address_range_entry &b)
+{
+  /* Each .debug_line Address column starts a distinct variant group; do not
+     merge across groups even when file:line:disc match (duplicate PCs).  */
+  return a.line_table_pc == b.line_table_pc;
+}
+
+void
+dwarf_reader_impl::consider_tightest_line_candidate (
+  uint64_t address, const address_range_entry &entry, bool &have_best,
+  source_location &best_loc, uint64_t &best_start, uint32_t &best_line_row_seq,
+  bool &best_line_table_primary) const
+{
+  if (address < entry.start || address >= entry.end)
+    return;
+
+  /* Pick primary location: highest range start, then line_table_primary,
+     then line_row_seq.  */
+  if (have_best)
+    {
+      if (entry.start < best_start)
+	return;
+      if (entry.start == best_start)
+	{
+	  if (entry.line_table_primary != best_line_table_primary)
+	    {
+	      if (!entry.line_table_primary)
+		return;
+	    }
+	  else if (entry.line_row_seq <= best_line_row_seq)
+	    return;
+	}
+    }
+
+  best_loc = entry.loc;
+  best_start = entry.start;
+  best_line_row_seq = entry.line_row_seq;
+  best_line_table_primary = entry.line_table_primary;
+  have_best = true;
+}
+
+bool
+dwarf_reader_impl::pick_tightest_line_location (
+  uint64_t address, source_location &out) const
+{
+  bool have_exact_line_pc = false;
+  bool have_best = false;
+  source_location best_loc;
+  uint64_t best_start = 0;
+  uint32_t best_line_row_seq = 0;
+  bool best_line_table_primary = false;
+  visit_overlapping_ranges (
+    address_ranges_, address_range_index_, address, address + 1,
+    [&] (size_t i)
+    {
+      const address_range_entry &entry = address_ranges_[i];
+      const bool exact_line_pc = entry.line_table_pc == address;
+      if (have_exact_line_pc && !exact_line_pc)
+	return;
+      if (exact_line_pc && !have_exact_line_pc)
+	{
+	  have_exact_line_pc = true;
+	  have_best = false;
+	}
+      consider_tightest_line_candidate (address,
+					entry,
+					have_best,
+					best_loc,
+					best_start,
+					best_line_row_seq,
+					best_line_table_primary);
+    });
+  if (!have_best)
+    return false;
+  out = best_loc;
+  return true;
+}
+
+uint32_t
+dwarf_reader_impl::parse_time_decl_line_at_entry (const std::string &name,
+						  uint64_t start_addr) const
+{
+  if (name.empty () || start_addr == 0 || dwarf_functions_.empty ())
+    return 0;
+  /* Exact (linkage name, start_addr) match: several DWARF subprograms can share
+     one entry (ICF/alias/COMDAT), so scan all entries at start_addr and pick
+     the
+     one whose name matches ? a decl-span lookup by entry, not a contains-PC
+     query.  */
+  auto it
+    = std::lower_bound (dwarf_functions_.begin (),
+			dwarf_functions_.end (),
+			start_addr,
+			[] (const function_metadata &func, uint64_t addr) {
+			  return func.start_addr < addr;
+			});
+  uint32_t unnamed = 0;
+  bool unnamed_ambiguous = false;
+  for (; it != dwarf_functions_.end () && it->start_addr == start_addr; ++it)
+    {
+      if (it->end_addr <= it->start_addr)
+	continue;
+      if (string_value (it->name) == name)
+	return it->start_line;
+      if (gcc_symbol::has_gcc_generated_suffix (name)
+	  && gcc_symbol::name_equivalent (string_value (it->name), name))
+	return it->start_line;
+      if (it->start_line == 0)
+	continue;
+      if (unnamed == 0)
+	unnamed = it->start_line;
+      else if (unnamed != it->start_line)
+	{
+	  unnamed_ambiguous = true;
+	  unnamed = std::min (unnamed, it->start_line);
+	}
+    }
+
+  /* No name match: use the entry's decl line when symtab/DWARF spell the same
+     body differently (clones, template mangling).  Ambiguous decl lines at one
+     address mean ICF folded unrelated bodies; only clones may fall back.  */
+  if (unnamed_ambiguous && !gcc_symbol::has_gcc_generated_suffix (name))
+    return 0;
+  return unnamed;
+}
+
+bool
+dwarf_reader_impl::function_profile_root_at_addr (
+  uint64_t addr, const std::string &name, function_root_metadata &out) const
+{
+  afdo_assert (mappings_loaded);
+  if (addr == 0)
+    return false;
+
+  out = function_root_metadata ();
+  if (!name.empty ())
+    out.decl_line = parse_time_decl_line_at_entry (name, addr);
+
+  /* Profile-root file: outermost inline call file, else line-table row.  */
+  source_location primary;
+  interned_string entry_file = nullptr;
+  if (lookup_primary_source_location_at_address (addr, primary))
+    entry_file = primary.file_path;
+
+  const std::vector<inline_frame> *inline_stack = inline_stack_at_pc (addr);
+  if (inline_stack != nullptr && !inline_stack->empty ()
+      && !string_empty (inline_stack->front ().caller_file_path))
+    entry_file = inline_stack->front ().caller_file_path;
+
+  if (!string_empty (entry_file))
+    out.file_path = entry_file;
+
+  if (out.decl_line == 0 && string_empty (out.file_path))
+    return false;
+  return true;
+}
+
+uint32_t
+dwarf_reader_impl::decl_line_at_entry (
+  const std::string &name, uint64_t addr,
+  const function_root_metadata *known_root) const
+{
+  const uint32_t parsed = parse_time_decl_line_at_entry (name, addr);
+  if (parsed != 0)
+    return parsed;
+  if (known_root != nullptr)
+    return known_root->decl_line;
+  function_root_metadata root;
+  if (function_profile_root_at_addr (addr, name, root))
+    return root.decl_line;
+  return 0;
+}
+
+inline_function_identity
+dwarf_reader_impl::resolve_inline_frame_identity (
+  const inline_frame &frame, const std::string &caller_file) const
+{
+  inline_function_identity identity;
+  const std::string &name = string_value (frame.function_name);
+  const std::string &call_file = string_value (frame.caller_file_path);
+  identity.file_path = string_value (frame.file_path);
+  identity.decl_line = frame.line_number;
+  if ((!identity.file_path.empty () && identity.decl_line != 0)
+      || name.empty ())
+    return identity;
+
+  const std::string &file_hint
+    = !identity.file_path.empty ()
+	? identity.file_path
+	: (!call_file.empty () ? call_file : caller_file);
+  identity_candidates all;
+  identity_candidates contextual;
+
+  auto dwarf_it = dwarf_func_name_index_.find (string_pool_.lookup (name));
+  if (dwarf_it == dwarf_func_name_index_.end ())
+    {
+      const std::string base = gcc_symbol::symbol_base_name (name);
+      if (base != name)
+	dwarf_it = dwarf_func_name_index_.find (string_pool_.lookup (base));
+    }
+  if (dwarf_it != dwarf_func_name_index_.end ())
+    for (size_t idx : dwarf_it->second)
+      if (idx < dwarf_functions_.size ())
+	add_identity_candidate (
+	  dwarf_functions_[idx], name, file_hint, all, contextual);
+
+  auto symtab_it = symtab_equiv_index_.find (string_pool_.lookup (name));
+  if (symtab_it == symtab_equiv_index_.end ())
+    {
+      const std::string base = gcc_symbol::symbol_base_name (name);
+      if (base != name)
+	symtab_it = symtab_equiv_index_.find (string_pool_.lookup (base));
+    }
+  if (symtab_it != symtab_equiv_index_.end ())
+    for (size_t idx : symtab_it->second)
+      if (idx < symtab_functions_.size ())
+	add_identity_candidate (
+	  symtab_functions_[idx], name, file_hint, all, contextual);
+
+  inline_function_identity candidate = contextual.identity ();
+  const inline_function_identity unique = all.identity ();
+  if (candidate.file_path.empty ())
+    candidate.file_path = unique.file_path;
+  if (candidate.decl_line == 0)
+    candidate.decl_line = unique.decl_line;
+  if (identity.file_path.empty ())
+    identity.file_path = candidate.file_path;
+  if (identity.decl_line == 0)
+    identity.decl_line = candidate.decl_line;
+  return identity;
+}
+
+bool
+dwarf_reader_impl::build_correlate_location_at_pc (
+  uint64_t file_offset, const function_metadata *containing_function,
+  source_location &out) const
+{
+  afdo_assert (mappings_loaded);
+
+  const function_metadata *func = containing_function;
+  if (func == nullptr)
+    func = containing_function_at_pc (file_offset);
+  if (func == nullptr || string_empty (func->name))
+    return false;
+
+  source_location primary;
+  if (lookup_primary_source_location_at_address (file_offset, primary))
+    {
+      out = primary;
+      return true;
+    }
+
+  /* Line-table gap (e.g. DW_AT_ranges hole): fall back to subprogram decl.  */
+  function_root_metadata root;
+  if (function_profile_root_at_addr (
+	file_offset, string_value (func->name), root))
+    {
+      if (!string_empty (root.file_path))
+	out.file_path = root.file_path;
+      if (root.decl_line != 0)
+	out.line_number = root.decl_line;
+      if (out.line_number != 0 || !string_empty (out.file_path))
+	return true;
+    }
+
+  return false;
+}
+
+bool
+dwarf_reader_impl::build_correlate_locations_at_pc (
+  uint64_t file_offset, const function_metadata *containing_function,
+  std::vector<source_location> &out, size_t &dwarf_line_index) const
+{
+  out.clear ();
+  dwarf_line_index = 0;
+
+  source_location primary;
+  if (!build_correlate_location_at_pc (
+	file_offset, containing_function, primary))
+    return false;
+  out.push_back (primary);
+
+  /* Collect exact-PC is_stmt rows; a unique one becomes OUT[0].  */
+  auto range_it
+    = std::lower_bound (
+      address_ranges_.begin (),
+      address_ranges_.end (),
+      file_offset,
+      [] (const address_range_entry &entry, uint64_t address)
+      {
+	return entry.start < address;
+      });
+  source_location stmt_location;
+  bool have_stmt_location = false;
+  bool ambiguous_stmt_location = false;
+  for (; range_it != address_ranges_.end ()
+	 && range_it->start == file_offset;
+       ++range_it)
+    {
+      const address_range_entry &entry = *range_it;
+      if (!entry.line_table_is_stmt || entry.line_table_pc != file_offset)
+	continue;
+      if (entry.loc.line_number == 0 || string_empty (entry.loc.file_path))
+	continue;
+      if (!have_stmt_location)
+	{
+	  stmt_location = entry.loc;
+	  have_stmt_location = true;
+	}
+      else if (!primary_locations_equal (stmt_location, entry.loc))
+	ambiguous_stmt_location = true;
+      if (entry.loc.file_path == primary.file_path
+	  && entry.loc.line_number == primary.line_number
+	  && entry.loc.discriminator == primary.discriminator)
+	continue;
+      out.push_back (entry.loc);
+    }
+  if (have_stmt_location && !ambiguous_stmt_location
+      && !primary_locations_equal (out[0], stmt_location))
+    for (size_t i = 1; i < out.size (); ++i)
+      if (primary_locations_equal (out[i], stmt_location))
+	{
+	  std::swap (out[0], out[i]);
+	  dwarf_line_index = i;
+	  break;
+	}
+  return true;
+}
+
+symbolized_result
+dwarf_reader_impl::symbolize (
+  uint64_t file_offset, correlate_session &session,
+  const function_metadata *containing_function) const
+{
+  afdo_assert (mappings_loaded);
+  symbolized_result result;
+
+  const std::vector<function_metadata> &correlate_funcs = symtab_functions ();
+
+  const auto cache_it = session.scratch_.symbolize_cache.find (file_offset);
+  if (cache_it != session.scratch_.symbolize_cache.end ())
+    {
+      if (cache_it->second.function_index < correlate_funcs.size ())
+	result.function = &correlate_funcs[cache_it->second.function_index];
+      result.locations = &cache_it->second.locations;
+      result.inline_stack = cache_it->second.inline_stack;
+      return result;
+    }
+
+  std::vector<source_location> locs;
+  size_t dwarf_line_index = 0;
+  if (!build_correlate_locations_at_pc (file_offset, containing_function, locs,
+					dwarf_line_index))
+    return result;
+
+  const function_metadata *func = containing_function;
+  if (func == nullptr)
+    func = containing_function_at_pc (file_offset);
+  if (func == nullptr || string_empty (func->name))
+    return result;
+
+  const size_t fidx = static_cast<size_t> (func - correlate_funcs.data ());
+  const std::vector<inline_frame> *inline_stack
+    = inline_stack_at_pc (file_offset);
+  result = store_correlate_symbolize_cache_entry (session.scratch_,
+						  file_offset,
+						  fidx,
+						  std::move (locs),
+						  dwarf_line_index,
+						  inline_stack,
+						  correlate_funcs);
+  return result;
+}
+
+/* Release the libdw handle and its backing fd.  Cached indexes are left for
+   normal member destruction: the reader is one-shot (load() asserts
+   !mappings_loaded) and every call site here is teardown, so there is no reuse
+   path that needs an explicit cache reset.  */
+void
+dwarf_reader_impl::close_line_dwarf ()
+{
+  if (line_dwarf)
+    {
+      dwarf_end (line_dwarf);
+      line_dwarf = nullptr;
+    }
+  if (line_dw_fd >= 0)
+    {
+      close (line_dw_fd);
+      line_dw_fd = -1;
+    }
+}
+
+/* Open libdw once for sample-scoped DWARF load.  */
+bool
+dwarf_reader_impl::open_binary_dwarf ()
+{
+  if (line_dwarf != nullptr)
+    return true;
+  line_dw_fd = open (binary_path.c_str (), O_RDONLY);
+  if (line_dw_fd < 0)
+    return false;
+  dwarf_functions_.clear ();
+  symtab_functions_.clear ();
+  symtab_aliases_.clear ();
+  line_dwarf = dwarf_begin (line_dw_fd, DWARF_C_READ);
+  if (!line_dwarf)
+    {
+      if (debug_enabled)
+	fprintf (
+	  stderr, "DWARF: dwarf_begin failed; discriminators disabled\n");
+      close (line_dw_fd);
+      line_dw_fd = -1;
+      return false;
+    }
+  Dwarf_Aranges *aranges = nullptr;
+  size_t naranges = 0;
+  if (dwarf_getaranges (line_dwarf, &aranges, &naranges) != 0 || naranges == 0)
+    {
+      close_line_dwarf ();
+      return false;
+    }
+  if (!build_cu_range_index (aranges, naranges))
+    {
+      close_line_dwarf ();
+      return false;
+    }
+  return true;
+}
+
+/* Build sample-scoped CU index from .debug_aranges.
+
+   Output:
+   - cu_range_index: sorted [start,end) -> cu_off for aranges touching samples
+   - profile_cu_offs: deduped CU offsets to parse in build_address_range_index
+ */
+bool
+dwarf_reader_impl::build_cu_range_index (Dwarf_Aranges *aranges,
+					 size_t naranges)
+{
+  cu_range_index.clear ();
+  profile_cu_offs.clear ();
+  cu_range_index.reserve (naranges);
+  profile_cu_offs.reserve (naranges);
+  std::unordered_set<Dwarf_Off> seen_cu_offs;
+  seen_cu_offs.reserve (naranges);
+  for (size_t i = 0; i < naranges; ++i)
+    {
+      Dwarf_Arange *const ar = dwarf_onearange (aranges, i);
+      if (ar == nullptr)
+	continue;
+      Dwarf_Addr ar_addr = 0;
+      Dwarf_Word ar_len = 0;
+      Dwarf_Off cu_off = 0;
+      if (dwarf_getarangeinfo (ar, &ar_addr, &ar_len, &cu_off) != 0
+	  || ar_len == 0)
+	continue;
+      const uint64_t start = static_cast<uint64_t> (ar_addr);
+      const uint64_t end = start + static_cast<uint64_t> (ar_len);
+      if (end <= start)
+	continue;
+      if (!range_overlaps_sampled (start, end))
+	continue;
+      cu_range_index.push_back ({start, end, cu_off});
+      if (seen_cu_offs.insert (cu_off).second)
+	profile_cu_offs.push_back (cu_off);
+    }
+
+  if (cu_range_index.empty ())
+    return false;
+
+  std::sort (cu_range_index.begin (),
+	     cu_range_index.end (),
+	     [] (const cu_range_index_entry &a, const cu_range_index_entry &b) {
+	       return a.start < b.start;
+	     });
+  return true;
+}
+
+/* Per-CU parse symbol bundles must be cleared or freshly constructed before
+   parse_cu_symbols.  */
+void
+dwarf_reader_impl::clear_cu_parse_symbols (
+  cu_lines &lines_out, cu_dies &dies_out,
+  std::vector<function_metadata> &symbols_out)
+{
+  lines_out.line_rows.clear ();
+  lines_out.ranges.clear ();
+  dies_out.inline_spans.clear ();
+  symbols_out.clear ();
+}
+
+/* Per-CU line table and DIE tree entry points.  */
+
+/* Walk each DWARF line-row and decode the running line-table state.  GCC often
+   emits several rows at the same PC (different file/line/disc); keep every raw
+   row so emit_cu_line_ranges can emit all variants instead of collapsing to a
+   single "best" row.  */
+void
+dwarf_reader_impl::decode_cu_line_rows (Dwarf_Lines *lines, size_t nlines,
+					cu_lines &out) const
+{
+  out.line_rows.reserve (nlines);
+  /* Accumulators mirror the libdw out-param types (dwarf_lineno: int,
+     dwarf_linediscriminator: unsigned int); widen to the uint32_t row fields
+     at assignment only.  */
+  int run_line = 0;
+  unsigned int run_disc = 0;
+  interned_string active_file_path = nullptr;
+  const char *last_src_file = nullptr;
+  std::unordered_map<const char *, interned_string> file_view_cache;
+
+  for (size_t i = 0; i < nlines; ++i)
+    {
+      Dwarf_Line *const srcl = dwarf_onesrcline (lines, i);
+      if (srcl == nullptr)
+	continue;
+
+      Dwarf_Addr row_addr = 0;
+      if (dwarf_lineaddr (srcl, &row_addr) != 0)
+	continue;
+
+      cu_line_row row;
+      row.addr = static_cast<uint64_t> (row_addr);
+
+      /* DW_LNE_end_sequence marks the address one past the last instruction of
+	 the sequence and carries no source location.  Keep the row so it
+	 terminates the preceding segment, but give it no file/line: the bytes
+	 from here to the next sequence belong to other objects (crt startup,
+	 assembler stubs) and must not inherit this CU's last line.  */
+      bool is_end_sequence = false;
+      if (dwarf_lineendsequence (srcl, &is_end_sequence) == 0
+	  && is_end_sequence)
+	{
+	  row.is_end_sequence = true;
+	  out.line_rows.push_back (row);
+	  active_file_path = {};
+	  last_src_file = nullptr;
+	  run_line = 0;
+	  run_disc = 0;
+	  continue;
+	}
+
+      int ln = 0;
+      if (dwarf_lineno (srcl, &ln) == 0 && ln > 0)
+	run_line = ln;
+      if (run_line > 0)
+	row.run_line = static_cast<uint32_t> (run_line);
+
+      unsigned int row_disc = 0;
+      if (dwarf_linediscriminator (srcl, &row_disc) == 0)
+	run_disc = row_disc;
+      row.disc = run_disc;
+
+      bool is_stmt = false;
+      if (dwarf_linebeginstatement (srcl, &is_stmt) == 0)
+	row.is_stmt = is_stmt;
+
+      const char *const src_file = dwarf_linesrc (srcl, nullptr, nullptr);
+      if (src_file != nullptr && src_file[0] != '\0')
+	{
+	  if (src_file != last_src_file)
+	    {
+	      const auto cached = file_view_cache.find (src_file);
+	      if (cached != file_view_cache.end ())
+		active_file_path = cached->second;
+	      else
+		{
+		  active_file_path = string_pool_.intern (src_file);
+		  if (!string_empty (active_file_path))
+		    file_view_cache.emplace (src_file, active_file_path);
+		}
+	      last_src_file = src_file;
+	    }
+	}
+
+      if (!string_empty (active_file_path))
+	row.file_path = active_file_path;
+
+      out.line_rows.push_back (row);
+    }
+}
+
+void
+dwarf_reader_impl::emit_cu_line_ranges (
+  cu_lines &out, uint64_t cu_end_excl,
+  const std::vector<function_metadata> &cu_local_functions) const
+{
+  for (size_t i = 0; i < out.line_rows.size ();)
+    {
+      const uint64_t group_addr = out.line_rows[i].addr;
+      size_t next_i = i;
+      while (next_i < out.line_rows.size ()
+	     && out.line_rows[next_i].addr == group_addr)
+	++next_i;
+
+      uint64_t end = 0;
+      if (next_i < out.line_rows.size ())
+	end = out.line_rows[next_i].addr;
+      else
+	{
+	  if (cu_end_excl > group_addr)
+	    end = cu_end_excl;
+	  for (const function_metadata &func : cu_local_functions)
+	    if (func.start_addr <= group_addr && func.end_addr > group_addr
+		&& (end == 0 || func.end_addr < end))
+	      end = func.end_addr;
+	}
+
+      if (end <= group_addr
+	  || !address_range_overlaps_sampled (
+	    group_addr, end, &cu_local_functions))
+	{
+	  i = next_i;
+	  continue;
+	}
+
+      /* Collect distinct (file,line,disc) variants at one PC.  */
+      struct line_variant_key
+      {
+	uint32_t line = 0;
+	uint32_t disc = 0;
+	interned_string file = nullptr;
+	uint32_t line_row_seq = 0;
+	bool is_stmt = false;
+      };
+      std::vector<line_variant_key> variants;
+      variants.reserve (next_i - i);
+      for (size_t j = i; j < next_i; ++j)
+	{
+	  const cu_line_row &candidate = out.line_rows[j];
+	  if (candidate.run_line == 0 && candidate.disc == 0
+	      && string_empty (candidate.file_path))
+	    continue;
+	  line_variant_key key;
+	  key.line = candidate.run_line;
+	  key.disc = candidate.disc;
+	  key.file = candidate.file_path;
+	  key.line_row_seq = static_cast<uint32_t> (j);
+	  key.is_stmt = candidate.is_stmt;
+	  auto existing = std::find_if (variants.begin (),
+					variants.end (),
+					[&] (const line_variant_key &v) {
+					  return v.line == key.line
+						 && v.file == key.file
+						 && v.disc == key.disc;
+					});
+	  if (existing == variants.end ())
+	    variants.push_back (key);
+	  else
+	    {
+	      existing->is_stmt = existing->is_stmt || key.is_stmt;
+	      if (j >= existing->line_row_seq)
+		existing->line_row_seq = static_cast<uint32_t> (j);
+	    }
+	}
+
+      const cu_line_row &last_row_at_pc = out.line_rows[next_i - 1];
+      const uint32_t last_row_line = last_row_at_pc.run_line;
+
+      for (const line_variant_key &variant : variants)
+	{
+	  address_range_local_entry entry;
+	  entry.start = group_addr;
+	  entry.end = end;
+	  entry.file_path = variant.file;
+	  entry.line_number = variant.line;
+	  entry.discriminator = variant.disc;
+	  entry.line_row_seq = variant.line_row_seq;
+	  entry.line_table_is_stmt = variant.is_stmt;
+	  entry.line_table_pc = group_addr;
+	  entry.line_table_primary = variant.line == last_row_line
+				     && variant.file == last_row_at_pc.file_path
+				     && variant.disc == last_row_at_pc.disc;
+
+	  if (!out.ranges.empty ())
+	    {
+	      const address_range_local_entry &prev = out.ranges.back ();
+	      if (prev.start == entry.start && prev.end == entry.end
+		  && prev.line_number == entry.line_number
+		  && prev.discriminator == entry.discriminator
+		  && prev.file_path == entry.file_path)
+		continue;
+	    }
+	  out.ranges.push_back (std::move (entry));
+	}
+      i = next_i;
+    }
+}
+
+/* One subprogram DIE yields zero or more function_metadata rows.  */
+void
+dwarf_reader_impl::record_subprogram_metadata (
+  Dwarf_Die *die, std::vector<function_metadata> &symbols_out) const
+{
+  cu_die_pc_ranges pc_ranges;
+  collect_die_pc_ranges (die, pc_ranges);
+  if (pc_ranges.empty ())
+    return;
+
+  const char *const linkage_name = resolve_die_symbol_name (die);
+  if (linkage_name == nullptr || linkage_name[0] == '\0')
+    return;
+
+  uint32_t start_line = 0;
+  interned_string decl_file = nullptr;
+  const subprogram_decl_info decl = resolve_subprogram_decl_info (die);
+  if (decl.decl_line != 0)
+    start_line = decl.decl_line;
+  if (dwarf_source_file_is_usable (decl.decl_file))
+    decl_file = string_pool_.intern (source_path::canonical (decl.decl_file));
+
+  /* Attribute the function to the file where its body actually lives: the
+     line-table row at the entry PC (lowest range start).  GCC keys a function
+     by DECL_SOURCE_FILE (the definition file), so a DW_AT_decl_file inherited
+     from a header via DW_AT_specification would be wrong here.  For a function
+     genuinely defined in a header (inline/template) the entry-PC row is that
+     header, which is correct.  Fall back to the definition DIE's own decl_file
+     only when the line table has no row at the entry PC.  */
+  uint64_t entry_pc = pc_ranges.front ().first;
+  for (const std::pair<uint64_t, uint64_t> &range : pc_ranges)
+    entry_pc = std::min (entry_pc, range.first);
+  interned_string file_path = decl_file;
+  Dwarf_Die cu_mem;
+  const char *const def_file = line_table_source_file_at_pc (
+    dwarf_diecu (die, &cu_mem, nullptr, nullptr), entry_pc);
+  if (dwarf_source_file_is_usable (def_file))
+    file_path = string_pool_.intern (source_path::canonical (def_file));
+
+  for (const std::pair<uint64_t, uint64_t> &range : pc_ranges)
+    {
+      const uint64_t start = range.first;
+      const uint64_t end = range.second;
+      if (end <= start)
+	continue;
+      if (!range_overlaps_sampled (start, end))
+	continue;
+      symbols_out.emplace_back (
+	string_pool_.intern (linkage_name), file_path, start, end, start_line);
+    }
+}
+
+/* One inlined_subroutine DIE: decode PC ranges, emit spans, push inline stacks.
+   Returns true when a frame was pushed (caller pops after children).  */
+bool
+dwarf_reader_impl::visit_inlined_subroutine_die (Dwarf_Die &die,
+						 cu_die_parser &parser,
+						 cu_dies &dies_out) const
+{
+  const decoded_inline_die decoded_die = decode_inline_die (&die);
+
+  cu_die_pc_ranges decoded;
+  collect_die_pc_ranges (&die, decoded);
+
+  parser.pc_ranges = decoded;
+  if (!parser.inline_ranges_stack.empty ()
+      && !parser.inline_ranges_stack.back ().empty ()
+      && !parser.pc_ranges.empty ()
+      && !pc_ranges_subset_of (
+	parser.pc_ranges, parser.inline_ranges_stack.back ()))
+    parser.pc_ranges.clear ();
+
+  inline_frame frame;
+  frame.function_name = string_pool_.intern (decoded_die.function_name);
+  if (string_empty (frame.function_name))
+    return false;
+  const subprogram_decl_info decl = resolve_subprogram_decl_info (&die);
+  if (decl.decl_file != nullptr && decl.decl_file[0] != '\0')
+    frame.file_path
+      = string_pool_.intern (source_path::canonical (decl.decl_file));
+  frame.line_number = decl.decl_line;
+  frame.call_line = decoded_die.call.line;
+  frame.discriminator = decoded_die.call.disc;
+  if (decoded_die.call.file != nullptr && decoded_die.call.file[0] != '\0')
+    frame.caller_file_path
+      = string_pool_.intern (source_path::canonical (decoded_die.call.file));
+  /* Keep recursive self-inlines; the DFS visits each DIE once.  */
+  parser.inline_stack.push_back (frame);
+
+  parser.inline_ranges_stack.push_back (
+    parser.pc_ranges.empty () ? cu_die_pc_ranges{} : parser.pc_ranges);
+
+  if (!parser.pc_ranges.empty ())
+    {
+      auto stack = std::make_shared<const std::vector<inline_frame>> (
+	parser.inline_stack);
+      for (const auto &range : parser.pc_ranges)
+	if (range.second > range.first)
+	  dies_out.inline_spans.push_back ({range.first, range.second, stack});
+    }
+
+  return true;
+}
+
+/* Depth-first walk of one CU DIE tree.  */
+void
+dwarf_reader_impl::parse_cu_die_tree_recursive (
+  Dwarf_Die *die, cu_dies &dies_out,
+  std::vector<function_metadata> &symbols_out, cu_die_parser &parser) const
+{
+  if (die == nullptr)
+    return;
+
+  const int tag = dwarf_tag (die);
+
+  if (tag == DW_TAG_subprogram && should_record_subprogram_die (die))
+    record_subprogram_metadata (die, symbols_out);
+
+  const bool is_inline_context
+    = tag == DW_TAG_inlined_subroutine
+      && visit_inlined_subroutine_die (*die, parser, dies_out);
+
+  Dwarf_Die child;
+  if (dwarf_child (die, &child) == 0)
+    {
+      parse_cu_die_tree_recursive (&child, dies_out, symbols_out, parser);
+      Dwarf_Die sibling;
+      while (dwarf_siblingof (&child, &sibling) == 0)
+	{
+	  parse_cu_die_tree_recursive (&sibling, dies_out, symbols_out, parser);
+	  child = sibling;
+	}
+    }
+
+  if (is_inline_context)
+    {
+      parser.inline_stack.pop_back ();
+      parser.inline_ranges_stack.pop_back ();
+    }
+}
+
+/* Parse one CU at cu_off (returns false if offdie fails): decode the line table
+   first (cheap state machine), then walk the DIE tree.  Line ranges are emitted
+   after the DIE walk so the existing function-span overlap filter can still use
+   symbols_out.functions.  */
+bool
+dwarf_reader_impl::parse_cu_symbols (
+  Dwarf *dwarf, Dwarf_Off cu_off, cu_lines &lines_out, cu_dies &dies_out,
+  std::vector<function_metadata> &symbols_out, cu_die_parser &parser) const
+{
+  Dwarf_Die cudie;
+  if (dwarf == nullptr || dwarf_offdie (dwarf, cu_off, &cudie) == nullptr)
+    return false;
+
+  clear_cu_parse_symbols (lines_out, dies_out, symbols_out);
+  lines_out.cu_off = cu_off;
+  dies_out.cu_off = cu_off;
+
+  Dwarf_Lines *lines = nullptr;
+  size_t nlines = 0;
+  if (dwarf_getsrclines (&cudie, &lines, &nlines) == 0 && nlines != 0)
+    decode_cu_line_rows (lines, nlines, lines_out);
+
+  parse_cu_die_tree_recursive (&cudie, dies_out, symbols_out, parser);
+  afdo_assert (parser.inline_stack.empty ());
+  afdo_assert (parser.inline_ranges_stack.empty ());
+
+  if (lines_out.line_rows.empty ())
+    return true;
+
+  /* Sort by PC so duplicate-address groups are contiguous.  */
+  std::stable_sort (lines_out.line_rows.begin (),
+		    lines_out.line_rows.end (),
+		    [] (const cu_line_row &a, const cu_line_row &b) {
+		      return a.addr < b.addr;
+		    });
+
+  /* Bound the final line row by its CU or function.  */
+  uint64_t cu_end_excl = 0;
+  if (lines_out.cu_off != 0)
+    {
+      for (const cu_range_index_entry &cu : cu_range_index)
+	{
+	  if (cu.cu_off == lines_out.cu_off && cu.end > cu_end_excl)
+	    cu_end_excl = cu.end;
+	}
+    }
+
+  /* Group rows by PC, expand distinct (file,line,disc) variants, and emit
+     sample-overlapping ranges into lines_out.ranges.  */
+  emit_cu_line_ranges (lines_out, cu_end_excl, symbols_out);
+  return true;
+}
+
+/* Merge one thread-local CU line parse buffer into global indexes.  */
+void
+dwarf_reader_impl::merge_cu_lines (cu_lines &buf)
+{
+  buf.line_rows.clear ();
+
+  if (buf.ranges.empty ())
+    {
+      buf.ranges.clear ();
+      return;
+    }
+
+  std::vector<address_range_entry> cu_ranges;
+  cu_ranges.reserve (buf.ranges.size ());
+  for (address_range_local_entry &local : buf.ranges)
+    {
+      address_range_entry entry;
+      entry.start = local.start;
+      entry.end = local.end;
+      if (!string_empty (local.file_path))
+	entry.loc.file_path = local.file_path;
+      entry.loc.line_number = local.line_number;
+      entry.loc.discriminator = local.discriminator;
+      entry.line_row_seq = local.line_row_seq;
+      entry.line_table_primary = local.line_table_primary;
+      entry.line_table_is_stmt = local.line_table_is_stmt;
+      entry.line_table_pc = local.line_table_pc;
+      if (!cu_ranges.empty ())
+	{
+	  address_range_entry &prev = cu_ranges.back ();
+	  if (prev.end == entry.start
+	      && prev.loc.file_path == entry.loc.file_path
+	      && prev.loc.line_number == entry.loc.line_number
+	      && prev.loc.discriminator == entry.loc.discriminator
+	      && same_line_table_coalesce_group (prev, entry))
+	    {
+	      prev.end = entry.end;
+	      prev.line_table_is_stmt
+		= prev.line_table_is_stmt || entry.line_table_is_stmt;
+	      continue;
+	    }
+	}
+      cu_ranges.push_back (std::move (entry));
+    }
+  buf.ranges.clear ();
+
+  if (buf.cu_off != 0)
+    address_ranges_by_cu_[buf.cu_off] = std::move (cu_ranges);
+  else
+    address_ranges_.insert (address_ranges_.end (),
+			    std::make_move_iterator (cu_ranges.begin ()),
+			    std::make_move_iterator (cu_ranges.end ()));
+}
+
+/* Merge one thread-local CU DIE parse buffer into global indexes.  */
+void
+dwarf_reader_impl::merge_cu_dies (cu_dies &buf)
+{
+  inline_stack_spans_.insert (
+    inline_stack_spans_.end (),
+    std::make_move_iterator (buf.inline_spans.begin ()),
+    std::make_move_iterator (buf.inline_spans.end ()));
+  buf.inline_spans.clear ();
+}
+
+/* Merge line, DIE, and metadata thread buffers for one CU.  Metadata is merged
+   first so global function metadata is available to later CU work.  Line-table
+   sample filtering already happened in parse_cu_symbols (via
+   cu_local_functions), not at merge time.  */
+void
+dwarf_reader_impl::merge_cu_parse_symbols (
+  cu_lines &lines_out, cu_dies &dies_out,
+  std::vector<function_metadata> &symbols_out)
+{
+  if (!symbols_out.empty ())
+    {
+      dwarf_functions_.insert (dwarf_functions_.end (),
+			       std::make_move_iterator (symbols_out.begin ()),
+			       std::make_move_iterator (symbols_out.end ()));
+      symbols_out.clear ();
+    }
+  merge_cu_lines (lines_out);
+  merge_cu_dies (dies_out);
+}
+
+unsigned
+dwarf_reader_impl::dwarf_parse_thread_count () const
+{
+  unsigned n = parse_threads_;
+  if (n == 0)
+    n = CU_PARSE_DEFAULT_THREADS;
+  return n;
+}
+
+/* Coalesce adjacent line segments that share the same source location.  */
+void
+dwarf_reader_impl::merge_consecutive_address_ranges ()
+{
+  if (address_ranges_.empty ())
+    return;
+
+  std::vector<address_range_entry> merged;
+  merged.reserve (address_ranges_.size ());
+  merged.push_back (address_ranges_.front ());
+  for (size_t i = 1; i < address_ranges_.size (); ++i)
+    {
+      address_range_entry &prev = merged.back ();
+      const address_range_entry &cur = address_ranges_[i];
+      if (prev.end != cur.start)
+	{
+	  merged.push_back (cur);
+	  continue;
+	}
+      if (!primary_locations_equal (prev.loc, cur.loc)
+	  || !same_line_table_coalesce_group (prev, cur))
+	{
+	  merged.push_back (cur);
+	  continue;
+	}
+      prev.end = cur.end;
+      prev.line_table_is_stmt
+	= prev.line_table_is_stmt || cur.line_table_is_stmt;
+    }
+  address_ranges_ = std::move (merged);
+}
+
+/* Parse profile-touch CUs into per-CU line/die/symbol buffers, then merge.  */
+bool
+dwarf_reader_impl::parse_profile_cus (unsigned num_threads, bool use_parallel)
+{
+  const size_t n_cus = profile_cu_offs.size ();
+  std::vector<cu_parse_symbols> partials (n_cus);
+
+  if (use_parallel)
+    {
+      const size_t chunk = (n_cus + num_threads - 1) / num_threads;
+      std::atomic<bool> session_failed{false};
+      std::vector<std::thread> workers;
+      workers.reserve (num_threads);
+      for (unsigned t = 0; t < num_threads; ++t)
+	{
+	  const size_t begin = static_cast<size_t> (t) * chunk;
+	  if (begin >= n_cus)
+	    break;
+	  const size_t end = std::min (n_cus, begin + chunk);
+	  workers.emplace_back ([&, begin, end] () {
+	    libdw_file_session session;
+	    if (!open_thread_libdw_session (binary_path, session))
+	      {
+		session_failed.store (true, std::memory_order_relaxed);
+		return;
+	      }
+	    cu_die_parser parser;
+	    for (size_t i = begin; i < end; ++i)
+	      {
+		parser.reset_for_cu ();
+		partials[i].parsed
+		  = parse_cu_symbols (session.dwarf,
+				      profile_cu_offs[i],
+				      partials[i].lines,
+				      partials[i].dies,
+				      partials[i].symbols,
+				      parser);
+	      }
+	    close_thread_libdw_session (session);
+	  });
+	}
+      for (std::thread &th : workers)
+	th.join ();
+      if (session_failed.load (std::memory_order_relaxed))
+	{
+	  fprintf (
+	    stderr, "Error: failed to open libdw for parallel CU parse\n");
+	  return false;
+	}
+    }
+  else
+    {
+      cu_die_parser parser;
+      for (size_t i = 0; i < n_cus; ++i)
+	{
+	  parser.reset_for_cu ();
+	  partials[i].parsed
+	    = parse_cu_symbols (line_dwarf,
+				profile_cu_offs[i],
+				partials[i].lines,
+				partials[i].dies,
+				partials[i].symbols,
+				parser);
+	}
+    }
+
+  bool parse_failed = false;
+  for (size_t i = 0; i < n_cus; ++i)
+    if (!partials[i].parsed)
+      {
+	fprintf (stderr,
+		 "Error: failed to parse DWARF CU at offset 0x%llx in %s\n",
+		 static_cast<unsigned long long> (profile_cu_offs[i]),
+		 binary_path.c_str ());
+	parse_failed = true;
+      }
+  if (parse_failed)
+    return false;
+
+  for (cu_parse_symbols &part : partials)
+    merge_cu_parse_symbols (part.lines, part.dies, part.symbols);
+  if (debug_enabled)
+    fprintf (stderr,
+	     "AFDO: parsed %zu profile-touch CUs (%u thread%s)\n",
+	     n_cus,
+	     use_parallel ? num_threads : 1,
+	     (use_parallel ? num_threads : 1) == 1 ? "" : "s");
+  return true;
+}
+
+bool
+dwarf_reader_impl::build_address_range_index ()
+{
+  afdo_assert (line_dwarf != nullptr && !cu_range_index.empty ());
+
+  const auto t0 = std::chrono::steady_clock::now ();
+  const size_t n_cus = profile_cu_offs.size ();
+  const unsigned max_workers = dwarf_parse_thread_count ();
+  const bool use_parallel = n_cus > 1 && max_workers > 1;
+  const unsigned num_threads
+    = static_cast<unsigned> (std::min<size_t> (n_cus, max_workers));
+
+  if (!parse_profile_cus (num_threads, use_parallel))
+    return false;
+
+  const auto t_parse = std::chrono::steady_clock::now ();
+
+  /* Flatten the per-CU line segments into one address_ranges_ vector.  */
+  if (!address_ranges_by_cu_.empty ())
+    {
+      address_ranges_.clear ();
+      size_t total_ranges = 0;
+      for (const auto &kv : address_ranges_by_cu_)
+	total_ranges += kv.second.size ();
+      address_ranges_.reserve (total_ranges);
+      for (Dwarf_Off cu_off : profile_cu_offs)
+	{
+	  auto it = address_ranges_by_cu_.find (cu_off);
+	  if (it == address_ranges_by_cu_.end ())
+	    continue;
+	  address_ranges_.insert (
+	    address_ranges_.end (),
+	    std::make_move_iterator (it->second.begin ()),
+	    std::make_move_iterator (it->second.end ()));
+	}
+      address_ranges_by_cu_.clear ();
+    }
+
+  if (address_ranges_.empty ())
+    {
+      fprintf (stderr,
+	       "Error: no line segments from profile-touch CUs in %s\n",
+	       binary_path.c_str ());
+      return false;
+    }
+
+  if (debug_enabled)
+    {
+      fprintf (stderr,
+	       "AFDO: %zu line segments (profile-touch)\n",
+	       address_ranges_.size ());
+    }
+
+  const auto t_sort = std::chrono::steady_clock::now ();
+  if (debug_enabled)
+    fprintf (stderr, "AFDO: sorting line segments...");
+  std::stable_sort (address_ranges_.begin (), address_ranges_.end ());
+  if (debug_enabled)
+    {
+      fprintf (stderr,
+	       " %.1fs\n",
+	       std::chrono::duration<double> (std::chrono::steady_clock::now ()
+					      - t_sort)
+		 .count ());
+    }
+
+  const auto t_after_sort = std::chrono::steady_clock::now ();
+  if (debug_enabled)
+    fprintf (stderr, "AFDO: merging consecutive line segments...");
+  const auto t_coalesce = std::chrono::steady_clock::now ();
+  merge_consecutive_address_ranges ();
+  build_range_max_tree (address_ranges_, address_range_index_);
+  std::stable_sort (inline_stack_spans_.begin (), inline_stack_spans_.end ());
+  build_range_max_tree (inline_stack_spans_, inline_stack_span_index_);
+  mappings_loaded = true;
+  if (debug_enabled)
+    {
+      fprintf (stderr,
+	       " %.1fs\n",
+	       std::chrono::duration<double> (std::chrono::steady_clock::now ()
+					      - t_coalesce)
+		 .count ());
+      fprintf (stderr, "AFDO: building line table span index...");
+    }
+  const auto t_keys = std::chrono::steady_clock::now ();
+  build_line_table_spans_index ();
+  if (debug_enabled)
+    {
+      fprintf (stderr,
+	       " %.1fs\n",
+	       std::chrono::duration<double> (std::chrono::steady_clock::now ()
+					      - t_keys)
+		 .count ());
+    }
+  const auto t_merge = std::chrono::steady_clock::now ();
+
+  if (debug_enabled)
+    {
+      const double parse_sec
+	= std::chrono::duration<double> (t_parse - t0).count ();
+      const double sort_sec
+	= std::chrono::duration<double> (t_after_sort - t_parse).count ();
+      const double merge_sec
+	= std::chrono::duration<double> (t_merge - t_after_sort).count ();
+      const double tail_sec = std::chrono::duration<double> (
+				std::chrono::steady_clock::now () - t_merge)
+				.count ();
+      const double sec
+	= std::chrono::duration<double> (std::chrono::steady_clock::now () - t0)
+	    .count ();
+      fprintf (stderr,
+	       "AFDO: address_ranges %zu segments, %zu line spans (%.1fs: "
+	       "parse %.1f, merge %.1f, tail %.1f)\n",
+	       address_ranges_.size (),
+	       line_table_spans_.size (),
+	       sec,
+	       parse_sec,
+	       merge_sec,
+	       (sort_sec + tail_sec));
+    }
+  return true;
+}
+
+/* Load correlatable STT_FUNC/.cold/.__part symtab entries.  */
+void
+dwarf_reader_impl::build_symtab_func_index ()
+{
+  symtab_functions_.clear ();
+  if (elf_version (EV_CURRENT) == EV_NONE)
+    elf_version (EV_CURRENT);
+
+  const int fd = open (binary_path.c_str (), O_RDONLY);
+  if (fd < 0)
+    {
+      fprintf (stderr,
+	       "Error: cannot open ELF binary %s: %s\n",
+	       binary_path.c_str (),
+	       std::strerror (errno));
+      return;
+    }
+  Elf *const elf = elf_begin (fd, ELF_C_READ, nullptr);
+  if (elf == nullptr)
+    {
+      fprintf (stderr,
+	       "Error: elf_begin failed for %s: %s\n",
+	       binary_path.c_str (),
+	       elf_errmsg (-1));
+      close (fd);
+      return;
+    }
+  if (elf_kind (elf) != ELF_K_ELF)
+    {
+      fprintf (stderr, "Error: not an ELF file: %s\n", binary_path.c_str ());
+      elf_end (elf);
+      close (fd);
+      return;
+    }
+
+  symtab_functions_.reserve (16384);
+  Elf_Scn *scn = nullptr;
+  while ((scn = elf_nextscn (elf, scn)) != nullptr)
+    {
+      GElf_Shdr shdr;
+      if (gelf_getshdr (scn, &shdr) == nullptr || shdr.sh_type != SHT_SYMTAB)
+	continue;
+
+      Elf_Data *const data = elf_getdata (scn, nullptr);
+      if (data == nullptr)
+	continue;
+
+      const size_t count = static_cast<size_t> (shdr.sh_size / shdr.sh_entsize);
+      for (size_t i = 0; i < count; ++i)
+	{
+	  GElf_Sym sym;
+	  if (gelf_getsym (data, static_cast<int> (i), &sym) == nullptr)
+	    continue;
+	  if (sym.st_value == 0 || sym.st_shndx == SHN_UNDEF)
+	    continue;
+
+	  const char *const raw = elf_strptr (elf, shdr.sh_link, sym.st_name);
+	  const uint64_t size = static_cast<uint64_t> (sym.st_size);
+	  if (!symtab_accepts_function_symbol (
+		raw, size, GELF_ST_TYPE (sym.st_info)))
+	    continue;
+
+	  const uint64_t start = static_cast<uint64_t> (sym.st_value);
+	  const uint64_t end = start + size;
+	  if (end <= start)
+	    continue;
+
+	  symtab_functions_.emplace_back (
+	    string_pool_.intern (raw), nullptr, start, end);
+	}
+    }
+  elf_end (elf);
+  close (fd);
+
+  auto symtab_less
+    = [] (const function_metadata &a, const function_metadata &b) {
+	if (a.start_addr != b.start_addr)
+	  return a.start_addr < b.start_addr;
+	if (a.end_addr != b.end_addr)
+	  return a.end_addr < b.end_addr;
+	return string_value (a.name) < string_value (b.name);
+      };
+  std::sort (symtab_functions_.begin (), symtab_functions_.end (), symtab_less);
+
+  /* Keep one owner per range and retain aliases for profile export.  */
+  symtab_aliases_.clear ();
+  size_t kept = 0;
+  for (size_t i = 0; i < symtab_functions_.size (); ++i)
+    {
+      const function_metadata &row = symtab_functions_[i];
+      if (kept > 0 && row.start_addr == symtab_functions_[kept - 1].start_addr
+	  && row.end_addr == symtab_functions_[kept - 1].end_addr)
+	{
+	  if (row.name != symtab_functions_[kept - 1].name)
+	    symtab_aliases_.push_back ({row, kept - 1});
+	  continue;
+	}
+      if (kept != i)
+	symtab_functions_[kept] = row;
+      ++kept;
+    }
+  symtab_functions_.resize (kept);
+
+  if (debug_enabled)
+    {
+      fprintf (stderr,
+	       "AFDO: symtab %zu FUNC ranges, %zu alias names"
+	       " (symtab filter)\n",
+	       symtab_functions_.size (),
+	       symtab_aliases_.size ());
+    }
+  build_symtab_name_equivalence_index ();
+}
+
+void
+dwarf_reader_impl::resolve_touch_symtab_export_anchors ()
+{
+  correlate_session session;
+  for (function_metadata &sym : symtab_functions_)
+    resolve_symtab_export_anchor (sym, session);
+  for (function_alias_metadata &alias : symtab_aliases_)
+    resolve_symtab_export_anchor (alias.function, session);
+}
+
+void
+dwarf_reader_impl::resolve_symtab_export_anchor (
+  function_metadata &sym, correlate_session &session)
+{
+  if (sym.end_addr <= sym.start_addr)
+    return;
+
+  /* Unsampled symbols still get an empty profile, so they need a file to
+     stay distinct from a same-named static in another TU.  */
+  const bool sampled = function_overlaps_sampled (sym);
+  function_root_metadata root;
+  const bool need_root
+    = string_empty (sym.file_path) || (sampled && sym.start_line == 0);
+  const bool have_root
+    = need_root
+      && function_profile_root_at_addr (
+	sym.start_addr, string_value (sym.name), root);
+  if (string_empty (sym.file_path) && have_root
+      && !string_empty (root.file_path))
+    sym.file_path = root.file_path;
+
+  /* Entry-line symbolize is only worth its cost where samples land.  */
+  if (!sampled || sym.start_line != 0)
+    return;
+
+  uint32_t entry_line = 0;
+  const symbolized_result sym_result
+    = symbolize (sym.start_addr, session, &sym);
+  if (sym_result.function != nullptr
+      && sym_result.locations != nullptr
+      && !sym_result.locations->empty ())
+    entry_line = (*sym_result.locations)[0].line_number;
+
+  /* Pass ROOT after either outcome to avoid repeating the lookup.  */
+  sym.start_line
+    = decl_line_at_entry (string_value (sym.name), sym.start_addr, &root);
+  if (sym.start_line == 0 && entry_line != 0)
+    sym.start_line = entry_line;
+}
+
+void
+dwarf_reader_impl::build_dwarf_func_name_index ()
+{
+  for (size_t i = 0; i < dwarf_functions_.size (); ++i)
+    {
+      const function_metadata &func = dwarf_functions_[i];
+      dwarf_func_name_index_[func.name].push_back (i);
+      const std::string base
+	= gcc_symbol::symbol_base_name (string_value (func.name));
+      if (base != string_value (func.name))
+	dwarf_func_name_index_[string_pool_.intern (base)].push_back (i);
+    }
+}
+
+void
+dwarf_reader_impl::build_symtab_name_equivalence_index ()
+{
+  symtab_equiv_index_.clear ();
+  symtab_equiv_index_.reserve (symtab_functions_.size () * 2);
+
+  const auto add_key = [this] (interned_string key, size_t i) {
+    auto &vec = symtab_equiv_index_[key];
+    if (vec.empty () || vec.back () != i)
+      vec.push_back (i);
+  };
+  const auto add_name = [this, &add_key] (interned_string name, size_t i) {
+    add_key (name, i);
+    const std::string base = gcc_symbol::symbol_base_name (string_value (name));
+    if (base != string_value (name))
+      add_key (string_pool_.intern (base), i);
+  };
+
+  for (size_t i = 0; i < symtab_functions_.size (); ++i)
+    add_name (symtab_functions_[i].name, i);
+  for (const function_alias_metadata &alias : symtab_aliases_)
+    add_name (alias.function.name, alias.primary_index);
+}
+
+bool
+dwarf_reader_impl::lookup_primary_source_location_at_address (
+  uint64_t address, source_location &out) const
+{
+  afdo_assert (mappings_loaded);
+  afdo_assert (!address_ranges_.empty ());
+  return pick_tightest_line_location (address, out);
+}
+
+dwarf_reader::dwarf_reader (
+  std::string binary_path,
+  std::vector<std::pair<uint64_t, uint64_t>> sampled_ranges, bool debug_enabled)
+  : impl_ (std::make_unique<dwarf_reader_impl> (
+    std::move (binary_path), std::move (sampled_ranges), debug_enabled))
+{}
+
+dwarf_reader::~dwarf_reader () = default;
+
+void
+dwarf_reader::set_parse_threads (unsigned n)
+{
+  impl_->set_parse_threads (n);
+}
+
+bool
+dwarf_reader::load ()
+{
+  return impl_->load ();
+}
+
+const dwarf_load_summary &
+dwarf_reader::load_summary () const
+{
+  return impl_->load_summary ();
+}
+
+const std::vector<function_metadata> &
+dwarf_reader::symtab_functions () const
+{
+  return impl_->symtab_functions ();
+}
+
+const std::vector<function_alias_metadata> &
+dwarf_reader::symtab_aliases () const
+{
+  return impl_->symtab_aliases ();
+}
+
+const function_metadata *
+dwarf_reader::containing_function_at_pc (uint64_t address) const
+{
+  return impl_->containing_function_at_pc (address);
+}
+
+symbolized_result
+dwarf_reader::symbolize (uint64_t file_offset, correlate_session &session,
+			 const function_metadata *containing_function) const
+{
+  return impl_->symbolize (file_offset, session, containing_function);
+}
+
+void
+dwarf_reader::collect_line_span_seed_pcs (uint64_t start, uint64_t end,
+					  std::vector<uint64_t> &out) const
+{
+  impl_->collect_line_span_seed_pcs (start, end, out);
+}
+
+inline_function_identity
+dwarf_reader::resolve_inline_frame_identity (
+  const inline_frame &frame, const std::string &caller_file) const
+{
+  return impl_->resolve_inline_frame_identity (frame, caller_file);
+}
+
+} /* namespace dwarf_debug.  */
