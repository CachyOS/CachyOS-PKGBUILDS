+#include "gcov_writer.h"
+#include "afdo_assert.h"
+#include "gcov.h"
+#include "gcov_io.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace gcov {
+
+using v4::write_be16;
+using v4::write_be32;
+using v4::write_be8;
+using v4::write_int;
+using v4::write_int32;
+using v4::write_line_offset;
+using v4::write_str;
+using v4::write_varint;
+
+namespace {
+
+/* Header directory entry recorded for each emitted section: its file OFFSET,
+   byte SIZE and leading BITMASK byte.  */
+struct section_dir_entry
+{
+  uint64_t off, size;
+  uint8_t bm;
+};
+
+/* Append SEC to FILE at the current offset, recording its directory entry in
+   DIR.  Returns false (recording nothing) when the file position cannot be
+   read, so the caller can abort.  */
+bool
+emit_section (FILE *file, const std::vector<uint8_t> &sec,
+	      std::vector<section_dir_entry> &dir)
+{
+  const long pos = ftell (file);
+  if (pos < 0)
+    return false;
+  dir.push_back ({static_cast<uint64_t> (pos), sec.size (), sec[0]});
+  fwrite (sec.data (), 1, sec.size (), file);
+  return true;
+}
+
+/* "line[.disc]" for LOC's offset and (16-bit) discriminator.  */
+std::string
+fmt_loc (const gcov_location *loc)
+{
+  const uint32_t disc = loc->discriminator & 0xffffu;
+  std::string s = std::to_string (loc->offset);
+  if (disc)
+    s += "." + std::to_string (disc);
+  return s;
+}
+
+/* Sum of F's position-location counts (not inline subtrees).  */
+uint64_t
+text_position_count (const gcov_function &f)
+{
+  uint64_t t = 0;
+  for (const auto &loc : f.locations)
+    if (loc->type != gcov_location::kind::inlined)
+      t += loc->total_count ();
+  return t;
+}
+
+} /* Anonymous namespace.  */
+
+uint32_t
+gcov_writer_v4::trie::intern (const std::string &s)
+{
+  uint32_t idx = 0;
+  for (unsigned char ch : s)
+    {
+      auto it = nodes[idx].children.find (ch);
+      if (it == nodes[idx].children.end ())
+	{
+	  const uint32_t new_idx = static_cast<uint32_t> (nodes.size ());
+	  nodes[idx].children[ch] = new_idx;
+	  nodes.emplace_back ();
+	  idx = new_idx;
+	}
+      else
+	idx = it->second;
+    }
+  trie_node &node = nodes[idx];
+  if (!node.is_terminal)
+    {
+      node.is_terminal = true;
+      node.terminal_id = next_id++;
+    }
+  return node.terminal_id;
+}
+
+/* Group the name pool by source file: the "unknown" group (no file) first, then
+   one group per file-table entry, so the per-TU section ordering is
+   deterministic.  */
+void
+gcov_writer_v4::build_file_groups ()
+{
+  file_groups.clear ();
+
+  file_group unknown;
+  unknown.filename = "";
+
+  std::vector<file_group> by_file (profile->file_names.size ());
+  for (size_t i = 0; i < profile->file_names.size (); ++i)
+    by_file[i].filename = profile->file_names[i];
+
+  for (uint32_t i = 0; i < profile->function_names.size (); ++i)
+    {
+      const uint32_t file_idx = (i < profile->file_name_map.size ())
+				  ? profile->file_name_map[i]
+				  : INVALID_INDEX;
+      if (file_idx == INVALID_INDEX || file_idx >= profile->file_names.size ())
+	unknown.symbol_indices.push_back (i);
+      else
+	by_file[file_idx].symbol_indices.push_back (i);
+    }
+
+  file_groups.push_back (std::move (unknown));
+  for (auto &g : by_file)
+    file_groups.push_back (std::move (g));
+}
+
+/* Serialize TRIE rooted at NODE_IDX:
+     1 byte (terminal flag | child count),
+     4 byte terminal id (optional)
+     for each child:
+       2 byte edge-label length,
+       label bytes path-compressed
+       ... and the child node recursively.
+
+   Node bitmask / terminal id / label length are always big-endian, even in
+   compact mode (only the leading num_strings word is compact-dispatched).  */
+void
+gcov_writer_v4::serialize_trie_node (std::vector<uint8_t> &buf,
+				     const trie &trie, uint32_t node_idx) const
+{
+  const trie_node &node = trie.nodes[node_idx];
+  /* The child count shares its header byte with the terminal flag, so it must
+     fit in seven bits.  */
+  afdo_assert (node.children.size () <= TRIE_MAX_CHILDREN);
+  write_be8 (buf,
+	     static_cast<uint8_t> ((node.is_terminal ? TRIE_TERMINAL_FLAG : 0)
+				   | node.children.size ()));
+  if (node.is_terminal)
+    write_be32 (buf, node.terminal_id);
+
+  for (const auto &child : node.children)
+    {
+      const unsigned char ch = child.first;
+      uint32_t cur = child.second;
+      /* Path-compress single-child non-terminal chains into one edge label.
+	 The common case is a single-character edge: emit it directly and only
+	 build the LABEL string when the compressed edge is longer.  */
+      if (trie.nodes[cur].children.size () != 1 || trie.nodes[cur].is_terminal)
+	{
+	  write_be16 (buf, 1);
+	  buf.push_back (static_cast<uint8_t> (ch));
+	}
+      else
+	{
+	  std::string label (1, static_cast<char> (ch));
+	  do
+	    {
+	      const auto &next = *trie.nodes[cur].children.begin ();
+	      label += static_cast<char> (next.first);
+	      cur = next.second;
+	    }
+	  while (trie.nodes[cur].children.size () == 1
+		 && !trie.nodes[cur].is_terminal);
+	  write_be16 (buf, static_cast<uint16_t> (label.size ()));
+	  buf.insert (buf.end (), label.begin (), label.end ());
+	}
+      serialize_trie_node (buf, trie, cur);
+    }
+}
+
+std::vector<uint8_t>
+gcov_writer_v4::build_summary_section () const
+{
+  std::vector<uint8_t> buf;
+  const gcov_summary &s = profile->summary;
+  write_be8 (
+    buf, v4::SECTION_SUMMARY_INFO | (compact ? v4::SECTION_COMPACT_FLAG : 0));
+  write_int (buf, s.total_count, compact);
+  write_int (buf, s.max_count, compact);
+  write_int (buf, s.max_function_count, compact);
+  write_int (buf, s.num_counts, compact);
+  write_int (buf, s.num_functions, compact);
+  write_int (buf, static_cast<uint64_t> (s.num_detailed_entries), compact);
+  for (const auto &e : s.detailed_entries)
+    {
+      write_int32 (buf, e.cutoff, compact);
+      write_int (buf, e.min_count, compact);
+      write_int (buf, e.num_counts, compact);
+    }
+  return buf;
+}
+
+std::vector<uint8_t>
+gcov_writer_v4::build_file_names_section () const
+{
+  std::vector<uint8_t> buf;
+  write_be8 (
+    buf, v4::SECTION_FILE_NAMES | (compact ? v4::SECTION_COMPACT_FLAG : 0));
+  write_int32 (buf, static_cast<uint32_t> (file_groups.size ()), compact);
+  for (const auto &fg : file_groups)
+    {
+      write_str (buf, fg.filename, compact);
+      write_int32 (buf, fg.string_table_section, compact);
+      write_int32 (buf, fg.symbol_names_section, compact);
+      write_int32 (buf, fg.symbol_id_begin, compact);
+      write_int32 (buf, fg.symbol_id_end, compact);
+    }
+  return buf;
+}
+
+/* Intern each symbol name into the group's trie (so it must run before
+   build_string_table_section for the same group).  */
+std::vector<uint8_t>
+gcov_writer_v4::build_symbol_names_section (size_t group_idx)
+{
+  std::vector<uint8_t> buf;
+  file_group &fg = file_groups[group_idx];
+  write_be8 (
+    buf, v4::SECTION_SYMBOL_NAMES | (compact ? v4::SECTION_COMPACT_FLAG : 0));
+  write_int32 (buf, static_cast<uint32_t> (fg.symbol_indices.size ()), compact);
+  for (uint32_t name_idx : fg.symbol_indices)
+    {
+      write_int32 (buf,
+		   fg.string_trie.intern (profile->function_names[name_idx]),
+		   compact);
+      write_int32 (buf, old_to_new_id[name_idx], compact);
+      auto it = symbol_to_section.find (name_idx);
+      write_int32 (buf,
+		   it != symbol_to_section.end () ? it->second : INVALID_INDEX,
+		   compact);
+    }
+  return buf;
+}
+
+std::vector<uint8_t>
+gcov_writer_v4::build_string_table_section (size_t group_idx) const
+{
+  std::vector<uint8_t> buf;
+  const file_group &fg = file_groups[group_idx];
+  write_be8 (
+    buf, v4::SECTION_STRING_TABLE | (compact ? v4::SECTION_COMPACT_FLAG : 0));
+  write_int32 (buf, fg.string_trie.next_id, compact);
+  serialize_trie_node (buf, fg.string_trie, 0);
+  return buf;
+}
+
+std::vector<uint8_t>
+gcov_writer_v4::build_symbol_info_section (const gcov_function &func) const
+{
+  std::vector<uint8_t> buf;
+  write_be8 (
+    buf, v4::SECTION_SYMBOL_INFO | (compact ? v4::SECTION_COMPACT_FLAG : 0));
+  write_symbol_info_body (buf, func);
+  return buf;
+}
+
+void
+gcov_writer_v4::collect_cross_group_inliners (
+  const gcov_function &f, uint32_t top_new_id, uint32_t top_group,
+  const std::unordered_map<uint32_t, uint32_t> &group_of,
+  std::vector<std::set<uint32_t>> &inliners) const
+{
+  for (const auto &loc : f.locations)
+    if (loc->type == gcov_location::kind::inlined)
+      {
+	const auto *inl
+	  = static_cast<const gcov_location_inline *> (loc.get ());
+	auto git = group_of.find (inl->inlined_sym.id);
+	uint32_t g = git != group_of.end () ? git->second : 0;
+	if (g != top_group)
+	  inliners[g].insert (top_new_id);
+	collect_cross_group_inliners (
+	  inl->inlined_sym, top_new_id, top_group, group_of, inliners);
+      }
+}
+
+/* Reverse inline index: per file group, the new symbol ids of top-level
+   functions in OTHER groups whose inline tree contains a symbol of this group.
+   Lets a partial read pull exactly the cross-module inliners of a TU.  */
+std::vector<std::pair<uint32_t, std::vector<uint32_t>>>
+gcov_writer_v4::compute_inline_groups () const
+{
+  std::unordered_map<uint32_t, uint32_t> group_of;
+  for (uint32_t g = 0; g < file_groups.size (); ++g)
+    for (uint32_t old_idx : file_groups[g].symbol_indices)
+      group_of[old_idx] = g;
+
+  std::vector<std::set<uint32_t>> inliners (file_groups.size ());
+  for (const auto &func : profile->functions)
+    {
+      auto nit = old_to_new_id.find (func.id);
+      auto git = group_of.find (func.id);
+      collect_cross_group_inliners (
+	func,
+	nit != old_to_new_id.end () ? nit->second : INVALID_INDEX,
+	git != group_of.end () ? git->second : 0,
+	group_of,
+	inliners);
+    }
+
+  /* One entry per file that has cross-group inliners (sparse); std::set keeps
+     the ids sorted.  */
+  std::vector<std::pair<uint32_t, std::vector<uint32_t>>> groups;
+  for (uint32_t g = 0; g < inliners.size (); ++g)
+    if (!inliners[g].empty ())
+      groups.emplace_back (
+	g, std::vector<uint32_t> (inliners[g].begin (), inliners[g].end ()));
+  return groups;
+}
+
+std::vector<uint8_t>
+gcov_writer_v4::build_inline_index_section (
+  const std::vector<uint32_t> &ids) const
+{
+  std::vector<uint8_t> buf;
+  write_be8 (
+    buf, v4::SECTION_INLINE_INDICES | (compact ? v4::SECTION_COMPACT_FLAG : 0));
+  write_int32 (buf, static_cast<uint32_t> (ids.size ()), compact);
+  for (uint32_t id : ids)
+    write_int32 (buf, id, compact);
+  return buf;
+}
+
+std::vector<uint8_t>
+gcov_writer_v4::build_inline_index_table_section (
+  const std::vector<std::pair<uint32_t, uint32_t>> &entries) const
+{
+  std::vector<uint8_t> buf;
+  write_be8 (
+    buf,
+    v4::SECTION_INLINE_INDEX_TABLE | (compact ? v4::SECTION_COMPACT_FLAG : 0));
+  write_int32 (buf, static_cast<uint32_t> (entries.size ()), compact);
+  for (const auto &entry : entries)
+    {
+      write_int32 (buf, entry.first, compact);
+      write_int32 (buf, entry.second, compact);
+    }
+  return buf;
+}
+
+void
+gcov_writer_v4::write_location_prefix (std::vector<uint8_t> &buf, uint8_t type,
+				       uint32_t line, uint32_t disc) const
+{
+  write_be8 (
+    buf, static_cast<uint8_t> (type | (disc ? v4::LOCATION_DISC_FLAG : 0)));
+  write_line_offset (buf, line, compact);
+  if (disc)
+    {
+      if (compact)
+	write_varint (buf, disc);
+      else
+	write_be16 (buf, static_cast<uint16_t> (disc));
+    }
+}
+
+/* A non-inline position: ZERO/NORMAL/WIDE for a plain count, or
+   CALLED_FN/CALLED_FNS when call targets are present (in the call cases the
+   call count stands in for the position count, so the latter is not emitted).
+ */
+void
+gcov_writer_v4::write_position_location (std::vector<uint8_t> &buf,
+					 const gcov_location *loc) const
+{
+  const uint32_t line = loc->offset;
+  const uint32_t disc = loc->discriminator & 0xffffu;
+
+  std::vector<std::pair<uint64_t, uint64_t>> targets;
+  if (loc->type == gcov_location::kind::call)
+    {
+      const auto *call = static_cast<const gcov_location_call *> (loc);
+      targets.assign (call->callee_map.begin (), call->callee_map.end ());
+      std::sort (targets.begin (),
+		 targets.end (),
+		 [] (const std::pair<uint64_t, uint64_t> &a,
+		     const std::pair<uint64_t, uint64_t> &b) {
+		   return a.first < b.first;
+		 });
+    }
+
+  if (targets.empty ())
+    {
+      const uint64_t count = loc->total_count ();
+      if (count == 0)
+	write_location_prefix (buf, v4::LOCATION_ZERO, line, disc);
+      else if (count <= UINT32_MAX)
+	{
+	  write_location_prefix (buf, v4::LOCATION_NORMAL, line, disc);
+	  write_int32 (buf, static_cast<uint32_t> (count), compact);
+	}
+      else
+	{
+	  write_location_prefix (buf, v4::LOCATION_WIDE, line, disc);
+	  write_int (buf, count, compact);
+	}
+      return;
+    }
+
+  auto new_id = [this] (uint64_t old_id) -> uint32_t {
+    auto it = old_to_new_id.find (static_cast<uint32_t> (old_id));
+    return it != old_to_new_id.end () ? it->second : INVALID_INDEX;
+  };
+
+  if (targets.size () == 1)
+    {
+      write_location_prefix (buf, v4::LOCATION_CALLED_FN, line, disc);
+      write_int32 (buf, new_id (targets[0].first), compact);
+      write_int (buf, targets[0].second, compact);
+    }
+  else
+    {
+      write_location_prefix (buf, v4::LOCATION_CALLED_FNS, line, disc);
+      write_int32 (buf, static_cast<uint32_t> (targets.size ()), compact);
+      for (const auto &t : targets)
+	{
+	  write_int32 (buf, new_id (t.first), compact);
+	  write_int (buf, t.second, compact);
+	}
+    }
+}
+
+/* Body shared by top-level and inlined functions: num_locs, then each position
+   (non-inline) location, then each inlined callsite.  */
+static void
+split_locations (const gcov_function &func,
+		 std::vector<const gcov_location *> *positions,
+		 std::vector<const gcov_location_inline *> *inlines)
+{
+  positions->reserve (positions->size () + func.locations.size ());
+  inlines->reserve (inlines->size () + func.locations.size ());
+  for (const auto &loc : func.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	inlines->push_back (
+	  static_cast<const gcov_location_inline *> (loc.get ()));
+      else
+	positions->push_back (loc.get ());
+    }
+}
+
+void
+gcov_writer_v4::write_inlined_body (std::vector<uint8_t> &buf,
+				    const gcov_function &func) const
+{
+  std::vector<const gcov_location *> positions;
+  std::vector<const gcov_location_inline *> inlines;
+  split_locations (func, &positions, &inlines);
+
+  write_int32 (
+    buf, static_cast<uint32_t> (positions.size () + inlines.size ()), compact);
+  for (const gcov_location *loc : positions)
+    write_position_location (buf, loc);
+  for (const gcov_location_inline *cs : inlines)
+    {
+      write_location_prefix (
+	buf, v4::LOCATION_INLINED_FN, cs->offset, cs->discriminator & 0xffffu);
+      auto it = old_to_new_id.find (cs->inlined_sym.id);
+      write_int32 (
+	buf, it != old_to_new_id.end () ? it->second : INVALID_INDEX, compact);
+      write_inlined_body (buf, cs->inlined_sym);
+    }
+}
+
+void
+gcov_writer_v4::write_symbol_info_body (std::vector<uint8_t> &buf,
+					const gcov_function &func) const
+{
+  write_int (buf, func.head_count, compact);
+  write_int (buf, func.timestamp, compact);
+  write_inlined_body (buf, func);
+}
+
+bool
+gcov_writer_v4::write_binary ()
+{
+  build_file_groups ();
+
+  /* Assign global section indices (0=SUMMARY, 1=FILE_NAMES, then per-group
+     STRING_TABLE/SYMBOL_NAMES, then one SYMBOL_INFO per top-level function),
+     contiguous symbol ids per group, and the old->new id map.  */
+  uint32_t next_section = 2;
+  uint32_t next_id = 0;
+  for (auto &fg : file_groups)
+    {
+      fg.string_table_section = next_section++;
+      fg.symbol_names_section = next_section++;
+      fg.symbol_id_begin = next_id;
+      for (uint32_t old_idx : fg.symbol_indices)
+	old_to_new_id[old_idx] = next_id++;
+      fg.symbol_id_end = next_id;
+    }
+  for (const auto &func : profile->functions)
+    symbol_to_section[func.id] = next_section++;
+
+  /* Section count is known from the groups/functions up front.  With the
+     fixed-width table the header size is too.  Stream each section straight to
+     the file (build -> write -> free) and record only a small {offset, size,
+     bitmask} directory, then seek back and write the header.  No section bytes
+     are held beyond the one being written.  */
+
+  /* One SECTION_INLINE_INDICES sub-section per file with cross-group inliners,
+     plus the SECTION_INLINE_INDEX_TABLE directory.  */
+  const std::vector<std::pair<uint32_t, std::vector<uint32_t>>> inline_groups
+    = compute_inline_groups ();
+  const uint64_t total_sections = 2 + file_groups.size () * 2
+				  + profile->functions.size ()
+				  + inline_groups.size () + 1;
+  const uint64_t header_size = 4 + 4 + 1 + 7 + total_sections * 16;
+
+  std::vector<section_dir_entry> dir;
+  dir.reserve (total_sections);
+
+  if (fseek (file, (long) header_size, SEEK_SET) != 0)
+    return false;
+  bool io_ok = true;
+
+  io_ok &= emit_section (file, build_summary_section (), dir);
+  io_ok &= emit_section (file, build_file_names_section (), dir);
+  for (size_t i = 0; i < file_groups.size (); ++i)
+    {
+      /* Build SYMBOL_NAMES first (interns strings into the trie), then the
+	 STRING_TABLE.  Emit STRING_TABLE before SYMBOL_NAMES (index order).  */
+      std::vector<uint8_t> sym_names = build_symbol_names_section (i);
+      io_ok &= emit_section (file, build_string_table_section (i), dir);
+      io_ok &= emit_section (file, sym_names, dir);
+    }
+  for (const auto &func : profile->functions)
+    io_ok &= emit_section (file, build_symbol_info_section (func), dir);
+  /* Per-file inline-index sub-sections.  Record each one's section index, then
+     emit the directory mapping file id -> that index.  */
+  std::vector<std::pair<uint32_t, uint32_t>> ii_table;
+  ii_table.reserve (inline_groups.size ());
+  for (const auto &group : inline_groups)
+    {
+      ii_table.emplace_back (group.first, static_cast<uint32_t> (dir.size ()));
+      io_ok
+	&= emit_section (file, build_inline_index_section (group.second), dir);
+    }
+  io_ok
+    &= emit_section (file, build_inline_index_table_section (ii_table), dir);
+
+  /* Header: magic, version, reserved byte, section count, then a fixed-width
+     16-byte entry per section { offset(8), size(7), bitmask(1) }.  */
+  std::vector<uint8_t> header;
+  header.push_back ('g');
+  header.push_back ('c');
+  header.push_back ('o');
+  header.push_back ('v');
+  write_be32 (header, v4::format::GCOV_VERSION);
+  write_be8 (header, 0); /* Reserved, must be 0.  */
+  v4::write_be56 (header, total_sections);
+  for (const section_dir_entry &e : dir)
+    {
+      v4::write_be64 (header, e.off);
+      v4::write_be56 (header, e.size);
+      write_be8 (header, e.bm);
+    }
+
+  if (!io_ok || fseek (file, 0, SEEK_SET) != 0)
+    return false;
+  fwrite (header.data (), 1, header.size (), file);
+
+  return file && !ferror (file);
+}
+
+bool
+gcov_writer_v4::write ()
+{
+  if (!file)
+    {
+      fprintf (stderr, "Error: failed to create output file\n");
+      return false;
+    }
+  if (profile == nullptr)
+    {
+      fprintf (stderr, "Error: no profile data to write\n");
+      return false;
+    }
+  return is_text ? write_text () : write_binary ();
+}
+
+int32_t
+gcov_writer_v4::file_id_for (uint32_t id) const
+{
+  if (id < profile->file_name_map.size ())
+    {
+      const uint32_t idx = profile->file_name_map[id];
+      if (idx < profile->file_names.size ())
+	return static_cast<int32_t> (idx);
+    }
+  return -1;
+}
+
+/* Emit FUNC's locations/callsites/inlined sub-sections (text format), each
+   indented by INDENT levels.  INLINED nodes recurse through
+   write_text_inlined.  */
+void
+gcov_writer_v4::write_text_sections (FILE *out, const gcov_function &func,
+				     int indent) const
+{
+  const std::string pad (static_cast<size_t> (indent) * 2, ' ');
+
+  std::vector<const gcov_location *> locs, calls;
+  std::vector<const gcov_location_inline *> inls;
+  for (const auto &loc : func.locations)
+    {
+      if (loc->type == gcov_location::kind::inlined)
+	inls.push_back (static_cast<const gcov_location_inline *> (loc.get ()));
+      else if (loc->type == gcov_location::kind::call
+	       && !static_cast<const gcov_location_call *> (loc.get ())
+		     ->callee_map.empty ())
+	calls.push_back (loc.get ());
+      else
+	locs.push_back (loc.get ());
+    }
+
+  bool need_comma = false;
+  if (!locs.empty ())
+    {
+      fprintf (out, "%slocations = {\n", pad.c_str ());
+      for (size_t i = 0; i < locs.size (); ++i)
+	{
+	  if (i)
+	    fprintf (out, ",\n");
+	  fprintf (out,
+		   "%s  %s = %" PRIu64,
+		   pad.c_str (),
+		   fmt_loc (locs[i]).c_str (),
+		   locs[i]->total_count ());
+	}
+      fprintf (out, "\n%s}", pad.c_str ());
+      need_comma = true;
+    }
+  if (!calls.empty ())
+    {
+      if (need_comma)
+	fprintf (out, ",\n");
+      fprintf (out, "%scallsites = {\n", pad.c_str ());
+      for (size_t i = 0; i < calls.size (); ++i)
+	{
+	  if (i)
+	    fprintf (out, ",\n");
+	  const auto *call = static_cast<const gcov_location_call *> (calls[i]);
+	  fprintf (
+	    out, "%s  %s -> {", pad.c_str (), fmt_loc (calls[i]).c_str ());
+	  std::vector<std::pair<uint64_t, uint64_t>> tg (
+	    call->callee_map.begin (), call->callee_map.end ());
+	  std::sort (tg.begin (), tg.end ());
+	  for (size_t t = 0; t < tg.size (); ++t)
+	    {
+	      if (t)
+		fprintf (out, ",");
+	      /* "name":id = count.  The name keeps ICP targets (callee-only
+		 symbols with no header of their own) recoverable from text.  */
+	      const char *tname
+		= tg[t].first < profile->function_names.size ()
+		    ? profile->function_names[tg[t].first].c_str ()
+		    : "";
+	      fprintf (out,
+		       " \"%s\":%" PRIu64 " = %" PRIu64,
+		       tname,
+		       tg[t].first,
+		       tg[t].second);
+	    }
+	  fprintf (out, " }");
+	}
+      fprintf (out, "\n%s}", pad.c_str ());
+      need_comma = true;
+    }
+  if (!inls.empty ())
+    {
+      if (need_comma)
+	fprintf (out, ",\n");
+      fprintf (out, "%sinlined = {\n", pad.c_str ());
+      for (size_t i = 0; i < inls.size (); ++i)
+	{
+	  if (i)
+	    fprintf (out, ",\n");
+	  write_text_inlined (out, inls[i], indent);
+	}
+      fprintf (out, "\n%s}", pad.c_str ());
+      need_comma = true;
+    }
+  if (need_comma)
+    fprintf (out, "\n");
+}
+
+/* Emit one inlined callsite CS (text format) at INDENT.  INLINED nodes carry
+   only (id:total) plus their own nested sub-sections.  */
+void
+gcov_writer_v4::write_text_inlined (FILE *out, const gcov_location_inline *cs,
+				    int indent) const
+{
+  const gcov_function &nested = cs->inlined_sym;
+  const std::string pad (static_cast<size_t> (indent + 1) * 2, ' ');
+  const uint64_t total = text_position_count (nested);
+  fprintf (out,
+	   "%s%s = \"%s\":%d(%u:%" PRIu64 ") = {\n",
+	   pad.c_str (),
+	   fmt_loc (cs).c_str (),
+	   profile->function_names[nested.desc.name_index].c_str (),
+	   file_id_for (nested.id),
+	   (unsigned) nested.id,
+	   total);
+  write_text_sections (out, nested, indent + 2);
+  fprintf (out, "%s}", pad.c_str ());
+}
+
+/* Human-readable v4 text format.  Unlike the binary format, it keys symbols by
+   their name-pool index (no per-TU grouping / contiguous ids).  */
+bool
+gcov_writer_v4::write_text ()
+{
+  FILE *out = file;
+
+  fprintf (out, "filenames = {\n");
+  for (size_t i = 0; i < profile->file_names.size (); ++i)
+    fprintf (out,
+	     "  \"%s\"%s\n",
+	     profile->file_names[i].c_str (),
+	     (i + 1 < profile->file_names.size () ? "," : ""));
+  fprintf (out, "}\n");
+
+  const gcov_summary &s = profile->summary;
+  fprintf (out, "\nsummary = {\n");
+  fprintf (out, "  total_count = %" PRIu64 ",\n", s.total_count);
+  fprintf (out, "  max_count = %" PRIu64 ",\n", s.max_count);
+  fprintf (out, "  max_fn_count = %" PRIu64 ",\n", s.max_function_count);
+  fprintf (out, "  num_counts = %" PRIu64 ",\n", s.num_counts);
+  fprintf (out, "  num_functions = %" PRIu64 ",\n", s.num_functions);
+  fprintf (out, "  num_detailed_entries = %zu,\n", s.num_detailed_entries);
+  fprintf (out, "  detailed_entries = {\n");
+  for (size_t i = 0; i < s.detailed_entries.size (); ++i)
+    {
+      const auto &e = s.detailed_entries[i];
+      fprintf (out,
+	       "    {cutoff = %u, min_count = %" PRIu64
+	       ", num_counts = %" PRIu64 "}%s\n",
+	       (unsigned) e.cutoff,
+	       e.min_count,
+	       e.num_counts,
+	       (i + 1 < s.detailed_entries.size () ? "," : ""));
+    }
+  fprintf (out, "  }\n");
+  fprintf (out, "}\n");
+
+  for (const auto &func : profile->functions)
+    {
+      fprintf (out,
+	       "\n\"%s\":%d(%u:%" PRIu64 ":%" PRIu64 ":%" PRIu64 ") = {\n",
+	       profile->function_names[func.desc.name_index].c_str (),
+	       file_id_for (func.id),
+	       (unsigned) func.id,
+	       text_position_count (func),
+	       func.head_count,
+	       func.timestamp);
+      write_text_sections (out, func, 1);
+      fprintf (out, "}\n");
+    }
+
+  return out && !ferror (out);
+}
+
+} /* namespace gcov.  */
