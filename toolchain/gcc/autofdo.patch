+#ifndef GCC_LIVE_BRANCH_STACK_READER_H
+#define GCC_LIVE_BRANCH_STACK_READER_H
+
+#include "branch_stack_reader_base.h"
+#include "profile_reader.h"
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace perf_data {
+
+class live_branch_stack_reader : public profile_reader,
+				 public branch_stack_reader_base
+{
+  std::string binary_path;
+  std::vector<std::string> command_argv;
+  uint64_t total_samples = 0;
+  std::unordered_map<uint64_t, uint64_t> address_frequencies;
+
+  branch_stack_edge_count_map range_count_map;
+  branch_stack_edge_count_map branch_count_map;
+
+  std::string binary_path_resolved;
+  std::vector<simple_mmap> target_mmaps;
+  uint64_t sample_period;
+  bool accumulate_sample_ips_ = true;
+  bool use_branch_stack = true;
+  uint64_t sample_type = 0;
+  uint64_t branch_sample_type = 0;
+  /* Records the kernel dropped because the ring buffer was full.  */
+  uint64_t lost_records = 0;
+
+  bool is_target_binary (const std::string &mmap_filename) const;
+  void add_target_mapping_if_accepted (const std::string &mmap_filename,
+				       uint64_t start, uint64_t end,
+				       uint64_t pgoff);
+  void process_mmap_record (const uint8_t *payload, size_t payload_size);
+  void process_mmap2_record (const uint8_t *payload, size_t payload_size);
+  bool process_sample_record (const uint8_t *payload, size_t payload_size);
+  void process_ring_buffer (void *mmap_base, uint64_t data_offset,
+			    uint64_t data_size);
+
+public:
+  live_branch_stack_reader (const std::string &_binary_path,
+			    const std::vector<std::string> &_command_argv,
+			    uint64_t _sample_period);
+
+  ~live_branch_stack_reader () override;
+
+  bool load () override;
+  const std::unordered_map<uint64_t, uint64_t> &
+  get_address_frequencies () const override
+  {
+    return address_frequencies;
+  }
+  uint64_t get_total_samples () const override { return total_samples; }
+  uint64_t translate_address (uint64_t runtime_addr) const override;
+
+  void set_accumulate_sample_ips (bool accumulate) override
+  {
+    accumulate_sample_ips_ = accumulate;
+  }
+
+  void materialize_address_frequencies_for_per_pc_correlate () override;
+  void finalize_profile_after_capture ();
+
+  branch_stack_reader_base *as_branch_stack_reader () override { return this; }
+  const branch_stack_reader_base *as_branch_stack_reader () const override
+  {
+    return this;
+  }
+};
