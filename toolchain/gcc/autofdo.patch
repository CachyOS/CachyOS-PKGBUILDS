index 00000000000..97cdab10d07
--- /dev/null
+++ b/afdo_tools/src/gcov_merge.cc
@@ -0,0 +1,420 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_merge.h"
+#include "gcov_reader.h"
+#include "gcov_summary.h"
+#include "gcov_writer.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <set>
+#include <tuple>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace gcov {
+namespace {
+using location_key = std::tuple<uint32_t, uint32_t, uint64_t>;
+
+/* Match key for merge_locations.  All positions (normal/call) at one
+   (offset, disc) share a slot (kind 0); each inline callsite is keyed by its
+   callee id as well, since several functions may be inlined at the same
+   (offset, disc).
+
+   CALLEE_ID must be expressed in the merged name pool for both operands.  The
+   destination is already remapped, the source is remapped by the caller.  */
+location_key
+location_slot (const gcov_location &l, uint64_t callee_id)
+{
+  if (l.type == gcov_location::kind::inlined)
+    return {l.offset, l.discriminator, callee_id + 1};
+  return {l.offset, l.discriminator, 0};
+}
+
+/* The callee id keyed into location_slot: an inline callsite's inlined symbol,
+   else 0.  */
+uint64_t
+location_callee_id (const gcov_location &l)
+{
+  if (l.type != gcov_location::kind::inlined)
+    return 0;
+  return static_cast<const gcov_location_inline &> (l).inlined_sym.id;
+}
+
+/* Order two locations by their merge slot (offset, discriminator, callee).  */
+bool
+location_slot_less (const std::unique_ptr<gcov_location> &a,
+		    const std::unique_ptr<gcov_location> &b)
+{
+  return location_slot (*a, location_callee_id (*a))
+	 < location_slot (*b, location_callee_id (*b));
+}
+
+/* Sort by location_slot, recursively into inline subtrees.  */
+void
+sort_locations (gcov_function &f)
+{
+  std::stable_sort (
+    f.locations.begin (), f.locations.end (), location_slot_less);
+  for (auto &loc : f.locations)
+    if (loc->type == gcov_location::kind::inlined)
+      sort_locations (
+	static_cast<gcov_location_inline *> (loc.get ())->inlined_sym);
+}
+
+bool
+valid_gcov_name_index (uint32_t id)
+{
+  return id != 0 && id != INVALID_INDEX;
+}
+
+} /* anonymous namespace.  */
+
+gcov_merger::symbol_identity
+gcov_merger::identity_at (const gcov_profile &profile, uint64_t id) const
+{
+  if (id == 0 || id >= profile.function_names.size ())
+    return {};
+  std::string file;
+  if (id < profile.file_name_map.size ())
+    {
+      const uint32_t file_index = profile.file_name_map[id];
+      if (file_index < profile.file_names.size ())
+	file = profile.file_names[file_index];
+    }
+  return {profile.function_names[id], std::move (file)};
+}
+
+uint32_t
+gcov_merger::remap_callee (uint64_t src_id,
+			   const gcov_profile &src_profile) const
+{
+  const symbol_identity identity = identity_at (src_profile, src_id);
+  if (identity.name.empty ())
+    return INVALID_INDEX;
+  const auto it = identity_to_id.find (identity);
+  if (it == identity_to_id.end () || it->second == 0)
+    return INVALID_INDEX;
+  return it->second;
+}
+
+std::unique_ptr<gcov_location>
+gcov_merger::clone_location (const gcov_location &src,
+			     const gcov_profile &src_profile)
+{
+  std::unique_ptr<gcov_location> out;
+  switch (src.type)
+    {
+    case gcov_location::kind::normal:
+      out = std::make_unique<gcov_location_normal> (
+	static_cast<const gcov_location_normal &> (src).count);
+      break;
+    case gcov_location::kind::call:
+      {
+	const auto &c = static_cast<const gcov_location_call &> (src);
+	auto call = std::make_unique<gcov_location_call> (c.count);
+	for (const auto &kv : c.callee_map)
+	  {
+	    const uint32_t remapped = remap_callee (kv.first, src_profile);
+	    if (valid_gcov_name_index (remapped))
+	      call->callee_map[remapped] += kv.second;
+	  }
+	out = std::move (call);
+	break;
+      }
+    case gcov_location::kind::inlined:
+      {
+	auto inl = std::make_unique<gcov_location_inline> ();
+	/* Callee cannot be remapped into the merged pool.  Drop the callsite
+	   rather than fabricate a bogus offset-0 position count.  */
+	if (!build_inlined (
+	      inl->inlined_sym,
+	      static_cast<const gcov_location_inline &> (src).inlined_sym,
+	      src_profile))
+	  return nullptr;
+	out = std::move (inl);
+	break;
+      }
+    }
+  out->offset = src.offset;
+  out->discriminator = src.discriminator;
+  return out;
+}
+
+bool
+gcov_merger::build_inlined (gcov_function &dst, const gcov_function &src,
+			    const gcov_profile &src_profile)
+{
+  const uint32_t mid = remap_callee (src.id, src_profile);
+  if (!valid_gcov_name_index (mid))
+    return false;
+  dst.id = mid;
+  dst.desc.name_index = mid;
+  dst.timestamp = src.timestamp;
+  dst.head_count = src.head_count;
+  for (const auto &loc : src.locations)
+    if (auto cloned = clone_location (*loc, src_profile))
+      dst.locations.push_back (std::move (cloned));
+  dst.total_count = gcov_function_subtree_count (dst);
+  return true;
+}
+
+void
+gcov_merger::merge_locations (
+  std::vector<std::unique_ptr<gcov_location>> &dst,
+  const std::vector<std::unique_ptr<gcov_location>> &src,
+  const gcov_profile &src_profile)
+{
+  /* DST inline ids are already in the merged pool.  SRC ids must be remapped to
+     the merged pool before keying so identical callsites match.  */
+  const auto dst_callee = [] (const gcov_location &l) -> uint64_t {
+    return l.type == gcov_location::kind::inlined
+	     ? static_cast<const gcov_location_inline &> (l).inlined_sym.id
+	     : 0;
+  };
+  const auto src_callee = [&] (const gcov_location &l) -> uint64_t {
+    return l.type == gcov_location::kind::inlined ? remap_callee (
+	     static_cast<const gcov_location_inline &> (l).inlined_sym.id,
+	     src_profile)
+						  : 0;
+  };
+
+  std::map<location_key, size_t> slot;
+  for (size_t i = 0; i < dst.size (); ++i)
+    slot[location_slot (*dst[i], dst_callee (*dst[i]))] = i;
+
+  for (const auto &sloc : src)
+    {
+      auto it = slot.find (location_slot (*sloc, src_callee (*sloc)));
+      if (it == slot.end ())
+	{
+	  auto cloned = clone_location (*sloc, src_profile);
+	  if (!cloned)
+	    continue;
+	  dst.push_back (std::move (cloned));
+	  slot[location_slot (*dst.back (), dst_callee (*dst.back ()))]
+	    = dst.size () - 1;
+	  continue;
+	}
+
+      const size_t di = it->second;
+      if (sloc->type == gcov_location::kind::inlined)
+	{
+	  merge_function (
+	    static_cast<gcov_location_inline *> (dst[di].get ())->inlined_sym,
+	    static_cast<const gcov_location_inline &> (*sloc).inlined_sym,
+	    src_profile);
+	  continue;
+	}
+
+      /* Position slot: a call (indirect targets) in either operand makes the
+	 merged position a call.  Upgrade a normal DST in place if needed.  */
+      const bool src_is_call = sloc->type == gcov_location::kind::call;
+      if (src_is_call && dst[di]->type == gcov_location::kind::normal)
+	{
+	  auto up = std::make_unique<gcov_location_call> (
+	    static_cast<const gcov_location_normal &> (*dst[di]).count);
+	  up->offset = dst[di]->offset;
+	  up->discriminator = dst[di]->discriminator;
+	  dst[di] = std::move (up);
+	}
+
+      if (dst[di]->type == gcov_location::kind::call)
+	{
+	  auto *dc = static_cast<gcov_location_call *> (dst[di].get ());
+	  if (src_is_call)
+	    {
+	      const auto &sc = static_cast<const gcov_location_call &> (*sloc);
+	      dc->count += sc.count;
+	      for (const auto &kv : sc.callee_map)
+		{
+		  const uint32_t remapped
+		    = remap_callee (kv.first, src_profile);
+		  if (valid_gcov_name_index (remapped))
+		    dc->callee_map[remapped] += kv.second;
+		}
+	    }
+	  else
+	    dc->count
+	      += static_cast<const gcov_location_normal &> (*sloc).count;
+	}
+      else
+	static_cast<gcov_location_normal *> (dst[di].get ())->count
+	  += static_cast<const gcov_location_normal &> (*sloc).count;
+    }
+}
+
+void
+gcov_merger::merge_function (gcov_function &dst, const gcov_function &src,
+			     const gcov_profile &src_profile)
+{
+  dst.head_count += src.head_count;
+  if (dst.timestamp == 0
+      || (src.timestamp != 0 && src.timestamp < dst.timestamp))
+    dst.timestamp = src.timestamp;
+  merge_locations (dst.locations, src.locations, src_profile);
+  dst.total_count = gcov_function_subtree_count (dst);
+}
+
+bool
+gcov_merger::merge (const std::vector<std::string> &inputs,
+		    const std::string &output)
+{
+  if (inputs.empty ())
+    {
+      fprintf (stderr, "Error: no input profiles\n");
+      return false;
+    }
+
+  std::vector<std::unique_ptr<gcov_reader_base>> readers;
+  readers.reserve (inputs.size ());
+  for (const auto &path : inputs)
+    {
+      std::unique_ptr<gcov_reader_base> r = make_gcov_reader (path);
+      if (!r)
+	{
+	  fprintf (
+	    stderr, "Error: unrecognized profile format: %s\n", path.c_str ());
+	  return false;
+	}
+      if (!r->read ())
+	{
+	  fprintf (stderr, "Error: Failed to load %s\n", path.c_str ());
+	  return false;
+	}
+      fprintf (stderr,
+	       "Loaded %s with %zu functions\n",
+	       path.c_str (),
+	       r->get_profile ()->get_functions ().size ());
+      readers.push_back (std::move (r));
+    }
+
+  /* merge () may be called more than once.  Reset the incremental maps that the
+     passes below only insert into.  */
+  identity_to_id.clear ();
+  fn_index.clear ();
+
+  /* Pass 1: union of symbol identities (sorted, deterministic) -> name
+     pool.  */
+  std::set<symbol_identity> all_identities;
+  for (const auto &r : readers)
+    {
+      const gcov_profile &profile = *r->get_profile ();
+      for (size_t id = 1; id < profile.function_names.size (); ++id)
+	{
+	  symbol_identity identity = identity_at (profile, id);
+	  if (!identity.name.empty ())
+	    all_identities.insert (std::move (identity));
+	}
+    }
+
+  result.function_names.clear ();
+  result.function_names.push_back ("");
+  std::vector<std::string> symbol_paths;
+  symbol_paths.push_back ("");
+  uint32_t next_id = 1;
+  for (const symbol_identity &identity : all_identities)
+    {
+      result.function_names.push_back (identity.name);
+      symbol_paths.push_back (identity.file);
+      identity_to_id[identity] = next_id++;
+    }
+
+  result.build_file_name_table (symbol_paths);
+
+  /* Pass 2: materialize and merge function records.  */
+  result.functions.clear ();
+  result.functions.reserve (identity_to_id.size ());
+  for (const auto &r : readers)
+    {
+      const gcov_profile *in = r->get_profile ();
+      for (const auto &f : in->get_functions ())
+	{
+	  const symbol_identity identity = identity_at (*in, f.desc.name_index);
+	  if (identity.name.empty ())
+	    continue;
+	  auto fit = fn_index.find (identity);
+	  if (fit != fn_index.end ())
+	    {
+	      merge_function (result.functions[fit->second], f, *in);
+	      continue;
+	    }
+	  result.functions.emplace_back ();
+	  gcov_function &dst = result.functions.back ();
+	  if (!build_inlined (dst, f, *in))
+	    {
+	      result.functions.pop_back ();
+	      continue;
+	    }
+	  if (dst.timestamp == 0)
+	    dst.timestamp = UNKNOWN_TIMESTAMP;
+	  const uint32_t fidx = (dst.id < result.file_name_map.size ())
+				  ? result.file_name_map[dst.id]
+				  : INVALID_INDEX;
+	  dst.desc.file_index
+	    = (fidx < result.file_names.size ()) ? fidx : INVALID_INDEX;
+	  fn_index[identity] = result.functions.size () - 1;
+	}
+    }
+
+  /* Canonical location order within each function (merge appends in input
+     order; sort to the offset order profile_builder emits).  */
+  for (auto &f : result.functions)
+    sort_locations (f);
+
+  /* Deterministic output order (by symbol identity).  */
+  std::sort (result.functions.begin (),
+	     result.functions.end (),
+	     [this] (const gcov_function &a, const gcov_function &b) {
+	       return identity_at (result, a.desc.name_index)
+		      < identity_at (result, b.desc.name_index);
+	     });
+
+  compute_summary (result.functions, result.summary);
+
+  /* Lookup maps (top-level functions).  */
+  result.function_map.clear ();
+  for (const auto &f : result.functions)
+    result.function_map[f.id] = &f;
+
+  fprintf (stderr, "Merged data has %zu functions\n", result.functions.size ());
+
+  gcov_writer_options options;
+  std::unique_ptr<gcov_writer_base> writer
+    = make_gcov_writer (output, &result, options);
+  if (!writer)
+    {
+      fprintf (stderr, "Error: unsupported output profile format\n");
+      return false;
+    }
+
+  if (!writer->write ())
+    {
+      fprintf (stderr, "Error: Failed to write merged profile\n");
+      return false;
+    }
+  return true;
+}
+
+} /* namespace gcov.  */
