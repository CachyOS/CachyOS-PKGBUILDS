+void
+expect (bool condition, const char *message)
+{
+  if (condition)
+    return;
+  std::fprintf (stderr, "gcov-v4-test: %s\n", message);
+  std::exit (1);
+}
+
+std::string
+temporary_path ()
+{
+  char path[] = "/tmp/gcov-v4-test-XXXXXX";
+  const int fd = mkstemp (path);
+  expect (fd >= 0, "create temporary file");
+  expect (close (fd) == 0, "close temporary file");
+  return path;
+}
+
+std::string
+quoted_name (const char *prefix)
+{
+  std::string name = prefix;
+  name += "\"\\\n";
+  name.push_back ('\1');
+  name.push_back ('\0');
+  return name;
+}
+
+void
+check_binary_header (const std::string &path)
+{
+  uint8_t header[32];
+  FILE *file = std::fopen (path.c_str (), "rb");
+  expect (file != nullptr, "open v4 binary profile");
+  expect (std::fread (header, 1, sizeof (header), file) == sizeof (header),
+	  "read v4 binary header");
+  expect (std::fclose (file) == 0, "close v4 binary profile");
+  expect (std::memcmp (header, "gcov", 4) == 0, "preserve v4 magic");
+  expect (header[4] == 4 && header[5] == 0 && header[6] == 0
+	    && header[7] == 0,
+	  "write little-endian v4 version");
+  expect (header[8] == 0, "clear v4 reserved byte");
+  bool has_sections = false;
+  for (unsigned i = 9; i < 16; ++i)
+    has_sections |= header[i] != 0;
+  expect (has_sections, "write v4 section directory");
+  expect (header[31] == gcov::v4::SECTION_SUMMARY_INFO,
+	  "write v4 summary section");
+}
