+/* Version 4 GCOV writer.  Emits the section-based binary layout (big-endian, or
+   varint when compact) or the human-readable text format.  */
+class gcov_writer_v4 : public gcov_writer_base
+{
+  /* Per-TU path-compressed string-table trie.  */
+  struct trie_node
+  {
+    std::map<unsigned char, uint32_t> children;
+    bool is_terminal = false;
+    uint32_t terminal_id = 0;
+  };
+  struct trie
+  {
+    std::vector<trie_node> nodes; /* Root is nodes[0].  */
+    uint32_t next_id = 0;
+    trie () { nodes.emplace_back (); }
+    /* Insert S.  Return its (stable) string index within this TU.  */
+    uint32_t intern (const std::string &s);
+  };
+
+  /* One translation unit: its symbols (name-pool indices), trie, id range and
+     the section indices it occupies.  */
+  struct file_group
+  {
+    std::string filename;
+    std::vector<uint32_t> symbol_indices;
+    trie string_trie;
+    uint32_t symbol_id_begin = 0;
+    uint32_t symbol_id_end = 0;
+    uint32_t string_table_section = 0;
+    uint32_t symbol_names_section = 0;
+  };
+
+  bool compact = false;
+  bool is_text = false;
+  std::vector<file_group> file_groups;
+  /* Name-pool index -> SYMBOL_INFO section index (top-level functions only). */
+  std::unordered_map<uint32_t, uint32_t> symbol_to_section;
+  /* Name-pool index -> new contiguous symbol id.  */
+  std::unordered_map<uint32_t, uint32_t> old_to_new_id;
+
+  void build_file_groups ();
+  void serialize_trie_node (std::vector<uint8_t> &buf, const trie &trie,
+			    uint32_t node_idx) const;
+  std::vector<uint8_t> build_summary_section () const;
+  std::vector<uint8_t> build_file_names_section () const;
+  std::vector<uint8_t> build_symbol_names_section (size_t group_idx);
+  std::vector<uint8_t> build_string_table_section (size_t group_idx) const;
+  std::vector<uint8_t>
+  build_symbol_info_section (const gcov_function &func) const;
+  /* Reverse inline index, split per file group.  */
+  std::vector<std::pair<uint32_t, std::vector<uint32_t>>>
+  compute_inline_groups () const;
+  /* Recurse F's inline tree, recording TOP_NEW_ID as a cross-group inliner of
+     each group (per GROUP_OF) other than TOP_GROUP that it inlines from.  */
+  void collect_cross_group_inliners (
+    const gcov_function &f, uint32_t top_new_id, uint32_t top_group,
+    const std::unordered_map<uint32_t, uint32_t> &group_of,
+    std::vector<std::set<uint32_t>> &inliners) const;
+  std::vector<uint8_t>
+  build_inline_index_section (const std::vector<uint32_t> &ids) const;
+  std::vector<uint8_t> build_inline_index_table_section (
+    const std::vector<std::pair<uint32_t, uint32_t>> &entries) const;
+  void write_symbol_info_body (std::vector<uint8_t> &buf,
+			       const gcov_function &func) const;
+  void write_inlined_body (std::vector<uint8_t> &buf,
+			   const gcov_function &func) const;
+  void write_location_prefix (std::vector<uint8_t> &buf, uint8_t type,
+			      uint32_t line, uint32_t disc) const;
+  void write_position_location (std::vector<uint8_t> &buf,
+				const gcov_location *loc) const;
+  bool write_binary ();
+  bool write_text ();
+  /* Text-format symbol id -> file-table index, or -1 when unknown.  */
+  int32_t file_id_for (uint32_t id) const;
+  /* Emit FUNC's locations/callsites/inlined sections (text format) at INDENT.
+   */
+  void write_text_sections (FILE *out, const gcov_function &func,
+			    int indent) const;
+  /* Emit one inlined callsite CS (text format) at INDENT.  */
+  void write_text_inlined (FILE *out, const gcov_location_inline *cs,
+			   int indent) const;
+
+public:
+  gcov_writer_v4 (const std::string &path, const gcov_profile *profile_)
+    : gcov_writer_base (path, profile_)
+  {}
+  bool supports_text_profile () const override { return true; }
+  bool set_text_profile (bool is_text_ = true) override
+  {
+    is_text = is_text_;
+    return true;
+  }
+  void set_compact (bool compact_ = true) { compact = compact_; }
   bool write () override;
 };
 
