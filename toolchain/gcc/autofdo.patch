+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_ARM_SPE_AUX_DECODE_H
+#define GCC_ARM_SPE_AUX_DECODE_H
+
+#include "perf.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace perf_data {
+
+/* AArch64 instructions have a fixed four-byte width.  */
+constexpr uint64_t AARCH64_INSN_SIZE = 4;
+
+/* Filled from SPE AUXTRACE.  Callbacks borrow CTX to attribute and translate
+   addresses.  Taken edges go in branch_counts and conditional not-taken
+   branch PCs in not_taken_counts, both keyed by DWARF lookup address.  */
+struct arm_spe_profile_accumulator
+{
+  /* Attribute the record sampled at TIMESTAMP to CONTEXT_ID, the CONTEXTIDR
+     the SPE stream reports, or 0 when it reports none.  False drops it.  */
+  bool (*set_context) (uint64_t context_id, uint64_t timestamp, void *ctx)
+    = nullptr;
+
+  /* Translate RUNTIME_ADDR, sampled at TIMESTAMP, to a DWARF lookup address.
+     False drops the address.  */
+  bool (*translate_addr) (uint64_t runtime_addr, uint64_t timestamp,
+			  uint64_t *dwarf_addr, void *ctx)
+    = nullptr;
+
+  void (*note_timestamp) (uint64_t dwarf_addr, uint64_t timestamp, void *ctx)
+    = nullptr;
+  void *ctx = nullptr;
+  branch_stack_edge_count_map *branch_counts = nullptr;
+  std::unordered_map<uint64_t, uint64_t> *not_taken_counts = nullptr;
+};
+
+/* Streaming SPE decoder.  Packet fragments and the record under construction
+   survive AUXTRACE chunk boundaries.  */
+class arm_spe_stream_decoder
+{
+  std::vector<uint8_t> pending_;
+  uint64_t pending_offset_;
+  uint64_t from_ip_ = 0;
+  uint64_t to_ip_ = 0;
+  uint64_t events_ = 0;
+  uint64_t op_payload_ = 0;
+  uint64_t timestamp_ = 0;
+  /* CONTEXTIDR of the sampled thread, 0 when the stream has no context
+     packet.  It carries over, since the packet is only sent on a change.  */
+  uint64_t context_id_ = 0;
+  unsigned char op_index_ = 0;
+  bool have_from_ip_ = false;
+  bool have_to_ip_ = false;
+  bool have_op_ = false;
+  uint64_t skipped_bytes_ = 0;
+
+  void clear_record ();
+  void commit_record (arm_spe_profile_accumulator *acc);
+
+public:
+  explicit arm_spe_stream_decoder (uint64_t offset = 0)
+    : pending_offset_ (offset)
+  {}
+
+  /* Consume the next contiguous bytes in the SPE stream.  */
+  bool consume (const uint8_t *spe_buf, size_t spe_len,
+		arm_spe_profile_accumulator *acc);
+
+  /* False when the stream ends in the middle of a packet.  */
+  bool finish () const { return pending_.empty (); }
+
+  /* Bytes skipped to resync after ones that start no valid packet.  */
+  uint64_t skipped_bytes () const { return skipped_bytes_; }
+};
+
+/* Profiled binary executable bytes, keyed by static vaddr.  */
+class arm_text_image
+{
+  struct segment
+  {
+    uint64_t vaddr;
+    std::vector<uint8_t> bytes;
+  };
+  std::vector<segment> segments_;
+  /* Sorted start addresses of FUNC symbols.  */
+  std::vector<uint64_t> func_starts_;
+
+public:
+  bool load (const std::string &binary_path);
+
+  /* False only for an AArch64 unconditional transfer.  Unknown addrs stay
+     true.  */
+  bool can_fall_through (uint64_t addr) const;
+
+  /* First address in [START, END] holding an instruction that cannot fall
+     through, or the last instruction before the next function that starts
+     after START.  UINT64_MAX if neither lies in the interval.  */
+  uint64_t fall_through_limit (uint64_t start, uint64_t end) const;
+};
+
+/* LBR-style fall-through ranges.  Stop where TEXT cannot fall through.  */
+void arm_spe_synthesize_ranges
+  (const branch_stack_edge_count_map &branch_counts,
+   const std::unordered_map<uint64_t, uint64_t> &not_taken_counts,
+   const arm_text_image &text, branch_stack_edge_count_map *range_counts);
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_ARM_SPE_AUX_DECODE_H.  */
