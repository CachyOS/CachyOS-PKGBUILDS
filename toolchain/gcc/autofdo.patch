@@ -0,0 +1,67 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_summary.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <vector>
+
+static void
+expect (bool condition)
+{
+  if (!condition)
+    {
+      std::fprintf (stderr, "gcov-summary-test failed\n");
+      std::exit (1);
+    }
+}
+
+int
+main ()
+{
+  expect (gcov::gcov_add_count (UINT64_MAX, 1) == UINT64_MAX);
+  expect (gcov::gcov_add_count (UINT64_MAX - 1, 1) == UINT64_MAX);
+  expect (gcov::gcov_multiply_count (UINT64_MAX, 2) == UINT64_MAX);
+  expect (gcov::gcov_multiply_count (UINT64_MAX, 0) == 0);
+  expect (gcov::gcov_multiply_count (7, 3) == 21);
+
+  std::vector<gcov::gcov_function> functions (1);
+  functions[0].locations.emplace_back (new gcov::gcov_location_normal (1));
+  gcov::gcov_summary summary;
+  gcov::compute_summary (functions, summary);
+  for (const auto &entry : summary.detailed_entries)
+    expect (entry.min_count == 1 && entry.num_counts == 1);
+
+  functions[0].locations.emplace_back (new gcov::gcov_location_normal (99));
+  gcov::compute_summary (functions, summary);
+  expect (summary.total_count == 100);
+  expect (summary.detailed_entries.front ().min_count == 99);
+  expect (summary.detailed_entries.back ().min_count == 1);
+
+  functions[0].locations.clear ();
+  functions[0].locations.emplace_back
+    (new gcov::gcov_location_normal (UINT64_MAX));
+  functions[0].locations.emplace_back
+    (new gcov::gcov_location_normal (UINT64_MAX));
+  gcov::compute_summary (functions, summary);
+  expect (summary.total_count == UINT64_MAX);
+  for (const auto &entry : summary.detailed_entries)
+    expect (entry.min_count == UINT64_MAX && entry.num_counts == 2);
+}
diff --git a/afdo-tools/testsuite/unit/symbol-util-test.cc b/afdo-tools/testsuite/unit/symbol-util-test.cc
new file mode 100644
index 00000000000..68b5605cff1
--- /dev/null
+++ b/afdo-tools/testsuite/unit/symbol-util-test.cc
@@ -0,0 +1,205 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "symbol_util.h"
+#include "perf.h"
+#include "range_index.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace {
+
+void
+expect (bool condition, const char *message)
+{
+  if (condition)
+    return;
+  std::fprintf (stderr, "symbol-util-test: %s\n", message);
+  std::exit (1);
+}
+
+void
+test_symbol_names ()
+{
+  using gcc_symbol::has_terminal_suffix;
+  using gcc_symbol::suffix_number;
+  expect (has_terminal_suffix ("foo.isra.1.cold", ".cold",
+			       suffix_number::none), "match nested cold suffix");
+  expect (has_terminal_suffix ("foo.cold.__part.2", ".__part",
+			       suffix_number::required), "match numbered part");
+  expect (!has_terminal_suffix ("foo.__part.", ".__part",
+				suffix_number::required), "require part number");
+  expect (!has_terminal_suffix ("foo.cold.2", ".cold",
+				suffix_number::none), "reject numbered cold");
+  expect (gcc_symbol::symbol_base_name ("foo.constprop.1.cold") == "foo",
+	  "strip chained GCC suffixes");
+  expect (gcc_symbol::symbol_split_part_parent ("foo.__part.2.cold")
+	    == "foo",
+	  "strip split-part suffixes");
+  expect (gcc_symbol::symbol_split_part_parent ("foo.part.3.cold") == "foo",
+	  "strip ipa-split and cold suffixes");
+  expect (gcc_symbol::symbol_split_part_parent ("foo.part.x") == "foo.part.x",
+	  "keep nonnumeric part suffixes");
+  expect (gcc_symbol::symbol_split_part_parent ("foo.__part.2.isra.3")
+	    == "foo.isra.3",
+	  "strip embedded numbered part and retain clone");
+  expect (gcc_symbol::symbol_split_part_parent ("foo.llvm.x.isra.3")
+	    == "foo.llvm.x.isra.3",
+	  "keep embedded nonnumeric copy suffix");
+  expect (gcc_symbol::symbol_base_name ("foo.omp_fn.1") == "foo.omp_fn.1",
+	  "keep unrelated clone suffixes");
+  expect (gcc_symbol::name_equivalent ("foo", "foo.isra.1"),
+	  "match a base function and its clone");
+  expect (!gcc_symbol::name_equivalent ("foo.isra.1", "foo.constprop.2"),
+	  "keep specialized siblings distinct");
+}
+
+void
+test_source_paths ()
+{
+  expect (perf_data::normalize_mmap_filename ("/tmp/a (deleted)") == "/tmp/a",
+	  "remove a deleted mapping suffix");
+  expect (perf_data::normalize_mmap_filename ("/tmp/a (deleted)/b")
+	    == "/tmp/a (deleted)/b",
+	  "preserve a deleted marker inside a path");
+  expect (source_path::normalize ("./src/dir/../file.cc") == "src/file.cc",
+	  "normalize source path components");
+  expect (source_path::normalize ("../src\\file.cc") == "../src/file.cc",
+	  "preserve leading parent and normalize separators");
+  expect (source_path::equivalent ("/build/src/dir/file.cc",
+				   "src/dir/file.cc"),
+	  "match a canonical relative suffix");
+  expect (!source_path::equivalent ("/build/src/dir/file.cc",
+				    "/other/src/dir/file.cc"),
+	  "keep distinct absolute paths separate");
+  expect (!source_path::equivalent ("/build/src/dir/file.cc", "file.c"),
+	  "reject a partial component");
+  expect (source_path::equivalent ("src/file.cc", "/a/src/file.cc")
+	  && source_path::equivalent ("src/file.cc", "/b/src/file.cc")
+	  && !source_path::equivalent ("/a/src/file.cc", "/b/src/file.cc"),
+	  "relative suffix matching is not transitive");
+}
+
+void
+test_function_lookup ()
+{
+  std::string first_name = "first";
+  std::string second_name = "second";
+  std::vector<dwarf_debug::function_metadata> functions{
+    {&first_name, nullptr, 10, 20},
+    {&second_name, nullptr, 30, 40},
+  };
+
+  const dwarf_debug::function_metadata *function
+    = dwarf_debug::function_containing_address (functions, 10);
+  expect (function != nullptr && function->name == &first_name,
+	  "include the function start");
+
+  function = dwarf_debug::function_containing_address (functions, 9);
+  expect (function == nullptr, "reject addresses before the first function");
+
+  function = dwarf_debug::function_containing_address (functions, 35);
+  expect (function != nullptr && function->name == &second_name,
+	  "find the containing function");
+
+  function = dwarf_debug::function_containing_address (functions, 20);
+  expect (function == nullptr, "treat function ends as exclusive");
+
+  function = dwarf_debug::function_containing_address (
+    functions, std::numeric_limits<uint64_t>::max ());
+  expect (function == nullptr, "handle the maximum address without overflow");
+
+  function = dwarf_debug::function_at_entry_pc (functions, 30);
+  expect (function != nullptr && function->name == &second_name,
+	  "find an exact entry");
+
+  function = dwarf_debug::function_at_entry_pc (functions, 31);
+  expect (function == nullptr, "require an exact entry PC");
+
+  const std::vector<dwarf_debug::function_metadata> empty;
+  expect (dwarf_debug::function_containing_address (empty, 0) == nullptr
+	  && dwarf_debug::function_at_entry_pc (empty, 0) == nullptr,
+	  "handle an empty function table");
+
+  functions[0].end_addr = 50;
+  function = dwarf_debug::function_containing_address (functions, 40);
+  expect (function == nullptr, "check only the nearest preceding entry");
+}
+
+void
+test_overlapping_ranges ()
+{
+  struct range
+  {
+    uint64_t start;
+    uint64_t end;
+    unsigned id;
+  };
+  const std::vector<range> ranges{
+    {10, 50, 0}, {15, 20, 1}, {18, 40, 2}, {50, 60, 3}
+  };
+  dwarf_debug::range_index<range> index;
+  index.build (ranges);
+  std::vector<unsigned> found;
+  index.visit_overlapping (19, 20,
+			   [&] (const range &r) { found.push_back (r.id); });
+  expect (found == std::vector<unsigned> ({0, 1, 2}),
+	  "find nested and overlapping ranges");
+  found.clear ();
+  index.visit_overlapping (20, 21,
+			   [&] (const range &r) { found.push_back (r.id); });
+  expect (found == std::vector<unsigned> ({0, 2}),
+	  "exclude ranges ending at the query start");
+  found.clear ();
+  index.visit_overlapping (50, 51,
+			   [&] (const range &r) { found.push_back (r.id); });
+  expect (found == std::vector<unsigned> ({3}),
+	  "exclude an enclosing range at its end");
+
+  std::vector<range> many;
+  for (unsigned i = 0; i < 64; ++i)
+    many.push_back ({i * 2, i * 2 + 1 + (i * 37) % 32, i});
+  index.build (many);
+  for (uint64_t pc = 0; pc < 160; ++pc)
+    {
+      std::vector<unsigned> expected;
+      for (const range &r : many)
+	if (r.start <= pc && pc < r.end)
+	  expected.push_back (r.id);
+      found.clear ();
+      index.visit_overlapping (pc, pc + 1,
+			       [&] (const range &r) { found.push_back (r.id); });
+      expect (found == expected, "match a linear overlapping-range search");
+    }
+}
+
+} /* anonymous namespace.  */
+
+int
+main ()
+{
+  test_symbol_names ();
+  test_source_paths ();
+  test_function_lookup ();
+  test_overlapping_ranges ();
+  return 0;
+}
