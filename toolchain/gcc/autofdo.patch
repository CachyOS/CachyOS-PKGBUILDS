diff --git a/afdo-tools/src/perf_branch_stack_reader.cc b/afdo-tools/src/perf_branch_stack_reader.cc
new file mode 100644
index 00000000000..742ddbdabc7
--- /dev/null
+++ b/afdo-tools/src/perf_branch_stack_reader.cc
@@ -0,0 +1,317 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "perf_branch_stack_reader.h"
+
+#include "perf_event_sample_util.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace perf_data {
+namespace {
+
+/* Branch-stack profiles use IP|TID|TIME|PERIOD|BRANCH_STACK (0x907).  */
+constexpr uint64_t BRANCH_STACK_SAMPLE_TYPE_IP_TID_TIME_PERIOD
+  = PERF_SAMPLE_IP | PERF_SAMPLE_TID | PERF_SAMPLE_TIME | PERF_SAMPLE_PERIOD
+    | PERF_SAMPLE_BRANCH_STACK;
+
+/* IP, the PID/TID pair, TIME and PERIOD.  */
+constexpr size_t BRANCH_STACK_FIXED_PREFIX_BYTES = 4 * sizeof (uint64_t);
+
+/* The same, plus the entry count the branch stack begins with.  */
+constexpr size_t BRANCH_STACK_FIXED_PREFIX_AND_COUNT_BYTES
+  = BRANCH_STACK_FIXED_PREFIX_BYTES + sizeof (uint64_t);
+
+bool
+branch_stack_sample_has_fixed_prefix_layout (uint64_t sample_type,
+					     uint64_t read_format)
+{
+  return sample_type == BRANCH_STACK_SAMPLE_TYPE_IP_TID_TIME_PERIOD
+	 && read_format == 0;
+}
+
+} /* anonymous namespace.  */
+
+perf_branch_stack_reader::perf_branch_stack_reader
+  (const std::string &_perf_data_path, const std::string &_binary_path)
+  : perf_file_reader (_perf_data_path, _binary_path)
+{}
+
+bool
+perf_branch_stack_reader::parse_perf_data_section ()
+{
+  reset_branch_stack_profile ();
+  range_count_map.clear ();
+  branch_count_map.clear ();
+  address_frequencies.clear ();
+  bad_samples_ = 0;
+
+  use_fixed_layout_branch_stack_parse_
+    = branch_stack_sample_has_fixed_prefix_layout (sample_layout.sample_type,
+						   sample_layout.read_format)
+      && (sample_layout.branch_sample_type
+	  & (BRANCH_SAMPLE_HW_INDEX | BRANCH_SAMPLE_COUNTERS))
+	   == 0;
+
+  size_t processed_samples = 0;
+  bool valid_mappings = true;
+
+  /* MMAPs can appear after samples in the ring buffer.  Bind mappings
+     first.  */
+  if (!for_each_mapped_perf_data_record (
+	[&] (const perf_event_header &record_header,
+	     const uint8_t *payload_ptr,
+	     size_t payload_size,
+	     size_t)
+	{
+	  switch (record_header.type)
+	    {
+	    case PERF_RECORD_MMAP:
+	      if (!parse_mmap_record (payload_ptr, payload_size,
+				      record_header.misc))
+		valid_mappings = false;
+	      break;
+	    case PERF_RECORD_MMAP2:
+	      if (!parse_mmap2_record (payload_ptr, payload_size,
+				       record_header.misc))
+		valid_mappings = false;
+	      break;
+	    case PERF_RECORD_COMM:
+	    case PERF_RECORD_FORK:
+	      note_process_lifetime_record (
+		record_header, payload_ptr, payload_size);
+	      break;
+	    default:
+	      break;
+	    }
+	}))
+    return false;
+  if (!valid_mappings)
+    {
+      fprintf (stderr, _("PERF: Truncated MMAP or MMAP2 record\n"));
+      return false;
+    }
+  close_target_mmap_time_windows ();
+  if (!target_mapping_lifetime_valid ())
+    return false;
+
+  if (!for_each_mapped_perf_data_record (
+	[&] (const perf_event_header &record_header,
+	     const uint8_t *payload_ptr,
+	     size_t payload_size,
+	     size_t)
+	{
+	  switch (record_header.type)
+	    {
+	    case PERF_RECORD_SAMPLE:
+	      if (parse_sample_record (payload_ptr, payload_size))
+		processed_samples++;
+	      break;
+	    default:
+	      break;
+	    }
+	}))
+    return false;
+
+  if (bad_samples_ > 1)
+    fprintf (stderr,
+	     _("PERF: WARNING: %zu further malformed sample(s) ignored\n"),
+	     bad_samples_ - 1);
+
+  compute_profile_mass ();
+
+  if (processed_samples == 0)
+    {
+      if (target_mmaps_by_pid_.empty ())
+	fprintf (stderr,
+		 _("PERF-LBR: No samples matched -b %s "
+		   "(no target MMAP/MMAP2 found).\n"),
+		 binary_path.c_str ());
+      else
+	fprintf (stderr,
+		 _("PERF-LBR: No branch-stack samples accepted for -b %s "
+		   "(%zu target mapping(s); check sample_type / LBR "
+		   "filters).\n"),
+		 binary_path.c_str (),
+		 target_mmap_count ());
+      return false;
+    }
+  publish_dwarf_branch_stack_maps (
+    range_count_map, branch_count_map, &sorted_touch_pcs_);
+  return true;
+}
+
+void
+perf_branch_stack_reader::warn_bad_sample (const char *message)
+{
+  if (bad_samples_++ == 0)
+    fprintf (stderr, "%s", message);
+}
+
+bool
+perf_branch_stack_reader::parse_sample_record (const uint8_t *record_data,
+					       size_t record_size)
+{
+  if (use_fixed_layout_branch_stack_parse_)
+    return parse_sample_record_fixed_branch_stack_layout (
+      record_data, record_size);
+
+  const uint8_t *ptr = record_data;
+  const uint8_t *const end = record_data + record_size;
+
+  uint64_t ip = 0;
+  bool have_ip = false;
+  uint32_t pid = 0;
+  uint32_t tid = 0;
+  uint64_t sample_time = 0;
+
+  /* Not checked.  The kernel lowers the period while throttling on PMI
+     overload, so a sample can report less than the configured one.  */
+  if (!perf_event_sample_util::walk_sample_before_branch (
+	ptr, end, sample_layout.sample_type, sample_layout.read_format, &ip,
+	&have_ip, &pid, &tid, nullptr, &sample_time))
+    {
+      warn_bad_sample (
+	_("PERF: WARNING: Truncated or invalid sample (prefix)\n"));
+      return false;
+    }
+
+  perf_event_sample_util::branch_stack_view branch_stack;
+  if (!perf_event_sample_util::walk_sample_branch_and_suffix (
+	ptr, end, sample_layout.branch_sample_type, sample_layout.sample_type,
+	sample_layout.sample_regs_user, sample_layout.sample_regs_intr,
+	branch_stack))
+    {
+      warn_bad_sample (_("PERF: WARNING: Truncated or invalid sample "
+			 "branch stack or suffix\n"));
+      return false;
+    }
+
+  const std::vector<executable_mapping> *const pid_mmaps
+    = target_mmaps_for_sample (pid, tid);
+  if (pid_mmaps == nullptr)
+    return false;
+  uint64_t dwarf_ip = 0;
+  const bool ip_is_target
+    = have_ip && ip != 0
+      && try_translate_runtime_with_mmaps (*pid_mmaps, ip, &dwarf_ip,
+					   sample_time);
+  bool recorded_sample = record_sample_ip (
+    dwarf_ip, ip_is_target, sample_time, accumulate_sample_ips_,
+    address_frequencies);
+  if (use_branch_stack_for_correlation_
+      && (sample_layout.sample_type & PERF_SAMPLE_BRANCH_STACK) != 0
+      && !branch_stack.empty ()
+      && accumulate_branch_stack_sample (
+	branch_stack,
+	sample_timestamps (),
+	sample_time,
+	*pid_mmaps,
+	range_count_map,
+	branch_count_map))
+    recorded_sample = true;
+
+  return recorded_sample;
+}
+
+bool
+perf_branch_stack_reader::parse_sample_record_fixed_branch_stack_layout
+  (const uint8_t *record_data, size_t record_size)
+{
+  if (record_size < BRANCH_STACK_FIXED_PREFIX_AND_COUNT_BYTES)
+    {
+      warn_bad_sample (_("PERF: WARNING: Truncated sample record\n"));
+      return false;
+    }
+
+  struct
+  {
+    uint64_t ip;
+    uint32_t pid, tid;
+    uint64_t time;
+    uint64_t period;
+    uint64_t nr;
+  } prefix;
+  static_assert (sizeof (prefix) == BRANCH_STACK_FIXED_PREFIX_AND_COUNT_BYTES,
+		 "fixed branch-stack prefix layout");
+  std::memcpy (&prefix, record_data, sizeof (prefix));
+  const uint64_t ip = prefix.ip;
+  const uint32_t pid = prefix.pid;
+  const uint32_t tid = prefix.tid;
+  const uint64_t sample_time = prefix.time;
+  const uint64_t nr = prefix.nr;
+
+  const uint8_t *ptr = record_data + sizeof (prefix);
+  const uint8_t *const end = record_data + record_size;
+
+  if (nr > SIZE_MAX / perf_event_sample_util::BRANCH_ENTRY_BYTES)
+    {
+      warn_bad_sample (_("PERF: WARNING: Invalid branch stack size\n"));
+      return false;
+    }
+  const size_t esz
+    = static_cast<size_t> (nr) * perf_event_sample_util::BRANCH_ENTRY_BYTES;
+  if (static_cast<size_t> (end - ptr) != esz)
+    {
+      warn_bad_sample (_("PERF: WARNING: Invalid branch stack size\n"));
+      return false;
+    }
+
+  const perf_event_sample_util::branch_stack_view branch_stack (
+    ptr, static_cast<size_t> (nr));
+
+  const std::vector<executable_mapping> *const pid_mmaps
+    = target_mmaps_for_sample (pid, tid);
+  if (pid_mmaps == nullptr)
+    return false;
+  uint64_t dwarf_ip = 0;
+  const bool ip_is_target
+    = ip != 0
+      && try_translate_runtime_with_mmaps (*pid_mmaps, ip, &dwarf_ip,
+					   sample_time);
+  bool recorded_sample = record_sample_ip (
+    dwarf_ip, ip_is_target, sample_time, accumulate_sample_ips_,
+    address_frequencies);
+  if (use_branch_stack_for_correlation_ && !branch_stack.empty ()
+      && accumulate_branch_stack_sample (
+	branch_stack,
+	sample_timestamps (),
+	sample_time,
+	*pid_mmaps,
+	range_count_map,
+	branch_count_map))
+    recorded_sample = true;
+
+  return recorded_sample;
+}
+
+void
+perf_branch_stack_reader::compute_profile_mass ()
+{
+  if (!range_count_map.empty ())
+    {
+      total_profile_mass = total_mass_from_runtime_range_map (range_count_map);
+      return;
+    }
+  total_profile_mass
+    = total_mass_from_address_frequencies (address_frequencies);
+}
+
+} /* namespace perf_data.  */
