+static bool
+write_gcov_output (const program_options &options,
+		   const gcov::gcov_profile &profile)
+{
+  gcov::gcov_writer_options writer_options;
+  std::unique_ptr<gcov::gcov_writer_base> generator
+    = gcov::make_gcov_writer (options.output_file, &profile, writer_options);
+  if (!generator)
+    return false;
+
+  if (!generator->write ())
+    {
+      fprintf (stderr, "Error: Failed to generate GCOV file\n");
+      return false;
+    }
+  return true;
+}
+
+static bool
+validate_input_files (const program_options &options)
+{
+  struct stat st;
+
+  if (!options.perf_data_file.empty ())
+    {
+      if (stat (options.perf_data_file.c_str (), &st) != 0)
+	{
+	  fprintf (stderr,
+		   "Error: perf.data file does not exist: %s\n",
+		   options.perf_data_file.c_str ());
+	  return false;
+	}
+    }
+
+  if (stat (options.binary_file.c_str (), &st) != 0)
+    {
+      fprintf (stderr,
+	       "Error: binary file does not exist: %s\n",
+	       options.binary_file.c_str ());
+      return false;
+    }
+
+  if ((st.st_mode & S_IXUSR) == 0)
+    fprintf (stderr,
+	     "Warning: binary file is not executable: %s\n",
+	     options.binary_file.c_str ());
+
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+int
+main (int argc, char *argv[])
+{
+  program_options options;
+
+  if (!parse_arguments (argc, argv, options))
+    {
+      if (options.print_help)
+	print_usage (argv[0]);
+      else if (options.print_version)
+	print_version ();
+      else
+	return 1;
+      return 0;
+    }
+
+  if (!validate_input_files (options))
+    return 1;
+
+  absolute_binary_path (options);
+
+  profile_timer::start ();
+
+  auto profiler = make_profiler (options);
+
+  profile_timer::mark ();
+  if (!profiler->generate_profile ())
+    {
+      fprintf (stderr, "Error: Failed to generate profile\n");
+      return 1;
+    }
+
+  profile_timer::mark ();
+  if (!write_gcov_output (options, profiler->get_gcov_profile ()))
+    return 1;
+
+  return 0;
+}
