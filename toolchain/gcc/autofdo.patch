index 00000000000..c52cda08367
--- /dev/null
+++ b/afdo-tools/src/autofdo_correlate_deposit.cc
@@ -0,0 +1,821 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
