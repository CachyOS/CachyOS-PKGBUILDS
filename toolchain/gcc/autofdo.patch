+
+namespace afdo_tools {
+
+/* Readonly whole-file mmap for GCOV profiles and offline perf.data.
+   Live perf ring buffers use MAP_SHARED separately and do not use this.  */
+class file_mmap
+{
+  void *addr_ = nullptr;
+  size_t size_ = 0;
+
+public:
+  file_mmap () = default;
+  ~file_mmap ();
+
+  file_mmap (const file_mmap &) = delete;
+  file_mmap &operator= (const file_mmap &) = delete;
+  file_mmap (file_mmap &&) = delete;
+  file_mmap &operator= (file_mmap &&) = delete;
+
+  /* Map PATH with PROT_READ / MAP_PRIVATE.  Unmaps any previous mapping.
+     Returns false on open/fstat/empty/mmap failure (object left empty).  */
+  bool map (const std::string &path);
+  void unmap ();
+
+  const uint8_t *data () const { return static_cast<const uint8_t *> (addr_); }
+  size_t size () const { return size_; }
+  explicit operator bool () const { return addr_ != nullptr; }
+};
+
+} /* namespace afdo_tools.  */
+
+#endif /* GCC_FILE_MMAP_H.  */
