+/* DW_AT_GNU_discriminator is a GCC vendor attribute not present in
+   elfutils dwarf.h.  */
+constexpr Dwarf_Half DW_AT_CALL_DISCRIMINATOR_EXT = 0x2136;
+
+/* Retain ELF binding only while choosing the owner of aliased ranges.  */
+struct elf_func_sym
+{
+  function_metadata meta;
+  unsigned char bind = 0;
+};
+
+/* Sort merged subprogram rows for binary search.  Drop exact duplicates
+   only.  */
+void
+sort_dedupe_function_metadata (std::vector<function_metadata> &funcs)
+{
+  if (funcs.empty ())
+    return;
+  std::sort (funcs.begin (),
+	     funcs.end (),
+	     [] (const function_metadata &a, const function_metadata &b)
+	     {
+	       if (a.start_addr != b.start_addr)
+		 return a.start_addr < b.start_addr;
+	       if (a.end_addr != b.end_addr)
+		 return a.end_addr < b.end_addr;
+	       /* Order by name text because interned_string is a pointer and
+		  directly would follow intern order and vary between runs of
+		  the parallel CU parse.  */
+	       if (a.name != b.name)
+		 return string_value (a.name) < string_value (b.name);
+	       if (a.file_path != b.file_path)
+		 return string_value (a.file_path) < string_value (b.file_path);
+	       return a.start_line < b.start_line;
+	     });
+  funcs.erase (std::unique (funcs.begin (),
+			    funcs.end (),
+			    [] (const function_metadata &a,
+				const function_metadata &b)
+			    {
+			      return a.start_addr == b.start_addr
+				     && a.end_addr == b.end_addr
+				     && a.name == b.name
+				     && a.file_path == b.file_path
+				     && a.start_line == b.start_line;
+			    }),
+	       funcs.end ());
+}
+
+/* True when NAME ends in a GCC clone suffix that symbol_base_name strips.  */
+bool
+has_gcc_generated_suffix (const std::string &name)
+{
+  return gcc_symbol::symbol_base_name (name) != name;
+}
+
+/* A DWARF file-table entry usable as a profile source file.  GCC also emits
+   pseudo-files that name no source.  */
+bool
+dwarf_source_file_is_usable (const char *file)
+{
+  static const char *const pseudo_files[]
+    = {"<built-in>", "<command-line>", "<artificial>", "<stdin>"};
+
+  if (file == nullptr || file[0] == '\0')
+    return false;
+  for (const char *pseudo : pseudo_files)
+    if (strcmp (file, pseudo) == 0)
+      return false;
+  return true;
+}
+
+/* Correlatable ELF symtab function ranges include STT_FUNC,
+   trailing .cold blocks, and .__part.N splits.  Reject @plt and size 0.  */
+bool
+symtab_accepts_function_symbol (const char *name, uint64_t size, int sym_type)
+{
+  if (name == nullptr || name[0] == '\0' || size == 0)
+    return false;
+
+  const size_t name_len = std::strlen (name);
+  if (name_len >= 4 && std::strcmp (name + name_len - 4, "@plt") == 0)
+    return false;
+  /* Cold partitions can be emitted as non-function symbols.  */
+  if (sym_type == STT_FUNC
+      || gcc_symbol::has_terminal_suffix (name, ".cold",
+					  gcc_symbol::suffix_number::none))
+    return true;
+  return gcc_symbol::has_terminal_suffix (name, ".__part",
+					  gcc_symbol::suffix_number::required);
+}
+
+/* True for a DW_AT_declaration DIE, that is, a declaration without a body.  */
+bool
+die_is_declaration (Dwarf_Die *die)
+{
+  Dwarf_Attribute decl_mem;
+  Dwarf_Attribute *decl_attr = dwarf_attr (die, DW_AT_declaration, &decl_mem);
+  if (decl_attr == nullptr)
+    return false;
+  bool flag = false;
+  return dwarf_formflag (decl_attr, &flag) == 0 && flag;
+}
+
+/* Resolve gcov symbol name.  Prefer linkage name, else DW_AT_name via
+   spec/abstract-origin chain.  */
+const char *
+resolve_die_symbol_name (Dwarf_Die *die)
+{
+  if (die == nullptr)
+    return nullptr;
+
+  const char *first_diename = nullptr;
+  Dwarf_Die cur = *die;
+  /* Cycle guard.  A spec/abstract-origin reference must never revisit a DIE
+     we already walked (malformed/looping DWARF).  Well-formed chains are
+     1-3 deep, so this set stays tiny.  */
+  std::vector<Dwarf_Off> seen;
+  for (;;)
+    {
+      const Dwarf_Off off = dwarf_dieoffset (&cur);
+      if (std::find (seen.begin (), seen.end (), off) != seen.end ())
+	break;
+      seen.push_back (off);
+
+      /* Linkage name is the gcov key.  The first one on the chain is the
+	 one.  Before DWARF 4, GCC emits it as DW_AT_MIPS_linkage_name.  */
+      Dwarf_Attribute link_mem;
+      Dwarf_Attribute *link_attr
+	= dwarf_attr (&cur, DW_AT_linkage_name, &link_mem);
+      if (link_attr == nullptr)
+	link_attr = dwarf_attr (&cur, DW_AT_MIPS_linkage_name, &link_mem);
+      const char *const link
+	= link_attr == nullptr ? nullptr : dwarf_formstring (link_attr);
+      if (link != nullptr && link[0] != '\0')
+	return link;
+
+      const char *diename = dwarf_diename (&cur);
+      if (diename != nullptr && diename[0] != '\0' && first_diename == nullptr)
+	first_diename = diename;
+
+      /* Follow DW_AT_specification, else DW_AT_abstract_origin, to the next
+	 DIE in the chain (dwarf_formref_die rewrites cur).  Stop when
+	 neither.  */
+      Dwarf_Attribute attr_mem;
+      const bool advanced
+	= (dwarf_attr (&cur, DW_AT_specification, &attr_mem) != nullptr
+	   && dwarf_formref_die (&attr_mem, &cur) != nullptr)
+	  || (dwarf_attr (&cur, DW_AT_abstract_origin, &attr_mem) != nullptr
+	      && dwarf_formref_die (&attr_mem, &cur) != nullptr);
+      if (!advanced)
+	break;
+    }
+
+  return first_diename;
+}
+
+/* True if every child PC range lies inside some parent range.  Both lists
+   come from collect_die_pc_ranges, so they are sorted and merged and one
+   walk of PARENT serves all of CHILD.  */
+bool
+pc_ranges_subset_of (const pc_range_list &child, const pc_range_list &parent)
+{
+  if (child.empty ())
+    return false;
+  size_t parent_index = 0;
+  for (const auto &child_range : child)
+    {
+      /* Skip parent ranges that end before this child range.  */
+      while (parent_index < parent.size ()
+	     && parent[parent_index].second < child_range.second)
+	++parent_index;
+      if (parent_index == parent.size ()
+	  || parent[parent_index].first > child_range.first)
+	return false;
+    }
+  return true;
+}
+
+/* Unsigned value of ATTR_NAME on DIE, or 0 if absent or not udata-form.  */
+Dwarf_Word
+die_udata_attr (Dwarf_Die *die, Dwarf_Half attr_name)
+{
+  if (die == nullptr)
+    return 0;
+  Dwarf_Attribute attr_mem;
+  Dwarf_Attribute *attr = dwarf_attr (die, attr_name, &attr_mem);
+  Dwarf_Word value = 0;
+  if (attr == nullptr || dwarf_formudata (attr, &value) != 0)
+    return 0;
+  return value;
+}
+
+/* CU path for DW_AT_call_file, or null.  libdw's table is already indexed by
+   the raw attribute value.  DWARF 5 starts from 0, while earlier versions
+   keep a dummy row 0.  */
+const char *
+die_call_file_path (Dwarf_Die *die)
+{
+  Dwarf_Attribute attr_mem;
+  if (die == nullptr || dwarf_attr (die, DW_AT_call_file, &attr_mem) == nullptr)
+    return nullptr;
+  Dwarf_Word file_idx = 0;
+  if (dwarf_formudata (&attr_mem, &file_idx) != 0)
+    return nullptr;
+  Dwarf_Die cu_mem;
+  Dwarf_Die *cu = dwarf_diecu (die, &cu_mem, nullptr, nullptr);
+  Dwarf_Files *files = nullptr;
+  size_t nfiles = 0;
+  if (cu == nullptr || dwarf_getsrcfiles (cu, &files, &nfiles) != 0
+      || files == nullptr || file_idx >= nfiles)
+    return nullptr;
+  return dwarf_filesrc (files, static_cast<size_t> (file_idx), nullptr,
+			nullptr);
+}
+
+/* Decl line/file from the DIE, or its enclosing class/struct for artificial
+   members (e.g.  lambda operator ()) that omit DW_AT_decl_*.  Prefer the
+   enclosing-type index.  Dwarf_getscopes_die is last resort.  */
+die_decl_site
+resolve_die_decl_site
+  (Dwarf_Die *die,
+   const std::unordered_map<Dwarf_Off, die_decl_site> *enclosing_by_die)
+{
+  die_decl_site info;
+  if (die == nullptr)
+    return info;
+
+  int ln = 0;
+  if (dwarf_decl_line (die, &ln) == 0 && ln > 0)
+    info.line_number = static_cast<uint32_t> (ln);
+  /* <artificial> / <built-in> are not source files.  Skip them so origin
+     and enclosing-type fallbacks can still run.  */
+  const char *file = dwarf_decl_file (die);
+  if (dwarf_source_file_is_usable (file))
+    info.file_path = file;
+  if (info.line_number != 0 && info.file_path != nullptr)
+    return info;
+
+  const auto use_enclosing_type = [&] (Dwarf_Off off)
+    {
+      if (enclosing_by_die == nullptr)
+	return;
+      const auto it = enclosing_by_die->find (off);
+      if (it == enclosing_by_die->end ())
+	return;
+      if (info.file_path == nullptr
+	  && dwarf_source_file_is_usable (it->second.file_path))
+	info.file_path = it->second.file_path;
+      if (info.line_number == 0)
+	info.line_number = it->second.line_number;
+    };
+
+  /* Follow the semantic declaration chain before asking for lexical scopes.
+     An inlined DIE is nested in its caller, not in the callee's declaring
+     type.  Prefer abstract_origin at each step, as libdw integration does.  */
+  Dwarf_Die origin = *die;
+  bool followed_reference = false;
+  /* A broken reference must not lead back to the caller's lexical scope.  */
+  bool has_reference = false;
+  std::vector<Dwarf_Off> seen;
+  for (;;)
+    {
+      const Dwarf_Off off = dwarf_dieoffset (&origin);
+      if (std::find (seen.begin (), seen.end (), off) != seen.end ())
+	break;
+
+      if (followed_reference)
+	{
+	  /* Integration can stop on a pseudo-file.  A later DIE may have a
+	     real path.  */
+	  if (info.file_path == nullptr)
+	    {
+	      file = dwarf_decl_file (&origin);
+	      if (dwarf_source_file_is_usable (file))
+		info.file_path = file;
+	    }
+	  use_enclosing_type (off);
+	  if (info.line_number != 0 && info.file_path != nullptr)
+	    return info;
+	}
+
+      Dwarf_Attribute attr_mem;
+      Dwarf_Attribute *attr
+	= dwarf_attr (&origin, DW_AT_abstract_origin, &attr_mem);
+      if (attr == nullptr)
+	attr = dwarf_attr (&origin, DW_AT_specification, &attr_mem);
+      if (attr == nullptr)
+	break;
+      seen.push_back (off);
+      has_reference = true;
+
+      Dwarf_Die next;
+      if (dwarf_formref_die (attr, &next) == nullptr)
+	break;
+      origin = next;
+      followed_reference = true;
+    }
+
+  if (!followed_reference)
+    {
+      /* A broken reference leaves ORIGIN nested in the caller.  */
+      if (has_reference)
+	return info;
+      /* With no reference, the DIE's own enclosing type is relevant.  */
+      use_enclosing_type (dwarf_dieoffset (&origin));
+      if (info.line_number != 0 && info.file_path != nullptr)
+	return info;
+    }
+
+  Dwarf_Die *scopes = nullptr;
+  const int nscopes = dwarf_getscopes_die (&origin, &scopes);
+  /* scopes[0] is ORIGIN itself.  Enclosing scopes begin at index 1.  */
+  for (int i = 1; i < nscopes; ++i)
+    {
+      const int tag = dwarf_tag (&scopes[i]);
+      if (tag != DW_TAG_class_type && tag != DW_TAG_structure_type
+	  && tag != DW_TAG_union_type)
+	continue;
+      if (info.line_number == 0)
+	{
+	  ln = 0;
+	  if (dwarf_decl_line (&scopes[i], &ln) == 0 && ln > 0)
+	    info.line_number = static_cast<uint32_t> (ln);
+	}
+      if (info.file_path == nullptr)
+	{
+	  file = dwarf_decl_file (&scopes[i]);
+	  if (dwarf_source_file_is_usable (file))
+	    info.file_path = file;
+	}
+      break;
+    }
+  free (scopes);
+  return info;
+}
+
+/* Open a libdw session on BINARY_PATH.  Each thread needs its own, as handles
+   are not thread-safe.  */
+bool
+open_libdw_session (const std::string &binary_path, libdw_file_session &session)
+{
+  session.fd = open (binary_path.c_str (), O_RDONLY);
+  if (session.fd < 0)
+    return false;
+  session.dwarf = dwarf_begin (session.fd, DWARF_C_READ);
+  if (!session.dwarf)
+    {
+      close (session.fd);
+      session.fd = -1;
+      return false;
+    }
+  return true;
+}
+
+/* Release a libdw session.  Safe on a partial or already-closed open.  */
+void
+close_libdw_session (libdw_file_session &session)
+{
+  if (session.dwarf)
+    {
+      dwarf_end (session.dwarf);
+      session.dwarf = nullptr;
+    }
+  if (session.fd >= 0)
+    {
+      close (session.fd);
+      session.fd = -1;
+    }
+}
+
+enum class pc_range_decode_status
+{
+  no_extent,
+  valid,
+  invalid
+};
+
+/* Decode and merge the PC ranges that libdw reports for DIE.  Preserve the
+   first decoded range start in FIRST_START before sorting.  */
+pc_range_decode_status
+collect_die_pc_ranges (Dwarf_Die *d, pc_range_list &out,
+		       uint64_t *first_start = nullptr)
+{
+  out.clear ();
+  if (first_start != nullptr)
+    *first_start = 0;
+  if (d == nullptr)
+    return pc_range_decode_status::invalid;
+
+  Dwarf_Addr base = 0, start = 0, end = 0;
+  ptrdiff_t offset = 0;
+  while (true)
+    {
+      const ptrdiff_t next
+	= dwarf_ranges (d, offset, &base, &start, &end);
+      if (next < 0 || (next != 0 && next <= offset))
+	{
+	  out.clear ();
+	  if (first_start != nullptr)
+	    *first_start = 0;
+	  return pc_range_decode_status::invalid;
+	}
+      if (next == 0)
+	break;
+      offset = next;
+      if (end <= start)
+	continue;
+      if (out.empty () && first_start != nullptr)
+	*first_start = static_cast<uint64_t> (start);
+      out.emplace_back (static_cast<uint64_t> (start),
+			static_cast<uint64_t> (end));
+    }
+
+  if (out.empty ())
+    {
+      if (dwarf_hasattr (d, DW_AT_low_pc)
+	  || dwarf_hasattr (d, DW_AT_high_pc)
+	  || dwarf_hasattr (d, DW_AT_ranges))
+	return pc_range_decode_status::valid;
+      return pc_range_decode_status::no_extent;
+    }
+
+  std::sort (out.begin (), out.end ());
+  size_t merged = 0;
+  for (const auto &range : out)
+    {
+      if (merged != 0 && range.first <= out[merged - 1].second)
+	out[merged - 1].second
+	  = std::max (out[merged - 1].second, range.second);
+      else
+	out[merged++] = range;
+    }
+  out.resize (merged);
+  return pc_range_decode_status::valid;
+}
+
+} /* anonymous namespace.  */
+
+/* Move this worker's cached symbolizations into DEST.  Prefer the reader's
+   canonical owner if more than one function symbolized the same PC.  */
+void
+correlate_session::drain_symbolize_snapshot_into (correlate_symbolize_map &dest)
+{
+  for (auto &kv : symbolize_cache_)
+    {
+      const uint64_t pc = kv.first.pc;
+      const function_metadata *const owner
+	= function_containing_address (reader_->symtab_functions (), pc);
+      const bool canonical
+	= owner != nullptr && owner->name == kv.first.function.name
+	  && owner->start_addr == kv.first.function.start_addr;
+      auto existing = dest.find (pc);
+      if (existing == dest.end ())
+	dest.emplace (pc, std::move (kv.second));
+      else if (canonical)
+	existing->second = std::move (kv.second);
+    }
+  symbolize_cache_.clear ();
+}
+
+/* Set the CU parse worker count, 0 selecting the default.  Must be called
+   before load ().  */
+void
+dwarf_reader_impl::set_parse_threads (unsigned n)
+{
+  if (mappings_loaded)
+    {
+      fprintf (stderr,
+	       _("Warning: set_parse_threads ignored after DWARF load "
+		 "(call before load ())\n"));
+      return;
+    }
+  parse_threads_ = n != 0 ? n : CU_PARSE_DEFAULT_THREADS;
+}
+
+/* Construct over BINARY_PATH, narrowing the DWARF scope to SAMPLED_RANGES.  */
+dwarf_reader_impl::dwarf_reader_impl (std::string binary_path,
+				      pc_range_list sampled_ranges)
+  : binary_path_ (std::move (binary_path))
+{
+  /* Split sample scope into merged intervals, skipping empty ones.  */
+  pc_range_list ranges = std::move (sampled_ranges);
+  std::sort (ranges.begin (), ranges.end ());
+  for (const auto &r : ranges)
+    {
+      if (r.second <= r.first)
+	continue;
+      if (!profile_sample_ranges_.empty ()
+	  && r.first <= profile_sample_ranges_.back ().second)
+	profile_sample_ranges_.back ().second
+	  = std::max (profile_sample_ranges_.back ().second, r.second);
+      else
+	profile_sample_ranges_.push_back (r);
+    }
+}
+
+/* Only the libdw session needs releasing.  The cached indexes go with normal
+   member destruction, as the reader is one-shot (load () asserts
+   !mappings_loaded) and so has no reuse path needing a cache reset.  */
+dwarf_reader_impl::~dwarf_reader_impl ()
+{
+  close_libdw_session (dw_);
+}
+
+/* Run the whole load pipeline.  Open libdw, index the symtab, parse the
+   profile-touch CUs, then build the address, name and span indexes.  */
+bool
+dwarf_reader_impl::load ()
+{
+  if (profile_sample_ranges_.empty ())
+    {
+      fprintf (stderr,
+	       _("Error: DWARF load requires a non-empty profile sample "
+		 "scope\n"));
+      return false;
+    }
+
+  afdo_assert (!mappings_loaded);
+
+  std::vector<Dwarf_Off> all_cus;
+  if (!open_binary_dwarf (all_cus))
+    return false;
+
+  /* ELF symtab index (needed during CU parse).  */
+  if (!build_symtab_func_index ())
+    {
+      close_libdw_session (dw_);
+      return false;
+    }
+  if (symtab_functions_.empty ())
+    {
+      fprintf (stderr,
+	       _("Error: ELF symtab has no correlatable function symbols "
+		 "for profile bucketing.\n"));
+      close_libdw_session (dw_);
+      return false;
+    }
+
+  if (!build_global_die_metadata (all_cus))
+    {
+      close_libdw_session (dw_);
+      return false;
+    }
+  if (!build_address_range_index ())
+    {
+      close_libdw_session (dw_);
+      return false;
+    }
+
+  /* Dedupe DWARF subprograms and build name index.  */
+  sort_dedupe_function_metadata (dwarf_functions_);
+  build_dwarf_name_indexes ();
+  afdo_assert (mappings_loaded);
+
+  /* Fill missing STT_FUNC file/line from entry-PC symbolize (on demand).  */
+  resolve_touch_symtab_export_anchors ();
+
+  load_summary_.touch_cus = profile_cu_offs_.size ();
+  load_summary_.dwarf_functions = dwarf_functions_.size ();
+  load_summary_.symtab_functions = symtab_functions_.size ();
+  load_summary_.line_segments = address_ranges_.size ();
+  /* Unique profile-touch PCs (range endpoints).  Symbolize is on demand.  */
+  load_summary_.touch_pcs = profile_sample_ranges_.size ();
+  for (const auto &r : profile_sample_ranges_)
+    if (r.second > r.first + 1)
+      ++load_summary_.touch_pcs;
+  /* These tables are used only while loading.  */
+  pc_range_list ().swap (profile_sample_ranges_);
+  std::vector<Dwarf_Off> ().swap (profile_cu_offs_);
+  std::unordered_map<Dwarf_Off, uint64_t> ().swap (cu_end_by_off_);
+  std::unordered_map<Dwarf_Off, die_decl_site> ().swap (enclosing_type_by_die_);
+
+  close_libdw_session (dw_);
+  return true;
+}
+
+/* Deepest inline frame stack covering PC, or null if PC is not
+   inlined.  */
+const std::vector<inline_frame> *
+dwarf_reader_impl::inline_stack_at_pc (uint64_t pc) const
+{
+  if (inline_stack_spans_.empty ())
+    return nullptr;
+
+  /* Prefer more frames, then the tighter range.  */
+  const inline_stack_span *best = nullptr;
+  inline_stack_span_index_.visit_overlapping
+    (pc, pc + 1, [&] (const inline_stack_span &span)
+    {
+      if (!span.stack)
+	return;
+      if (best == nullptr || span.stack->size () > best->stack->size ()
+	  || (span.stack->size () == best->stack->size ()
+	      && span.end - span.start < best->end - best->start))
+	best = &span;
+    });
+  return best != nullptr ? best->stack.get () : nullptr;
+}
+
+/* Collect line-table PCs for overlapping spans.  See dwarf_reader.h.  */
+void
+dwarf_reader_impl::collect_line_span_seed_pcs (uint64_t start, uint64_t end,
+					       std::vector<uint64_t> &out) const
+{
+  out.clear ();
+  std::unordered_set<uint64_t> seen;
+  seen.reserve (64);
+  address_range_index_.visit_overlapping
+    (start, end, [&] (const address_range_entry &entry)
+    {
+      const uint64_t seed_pc
+	= entry.line_table_pc != 0 ? entry.line_table_pc : entry.start;
+      if (seed_pc >= start && seed_pc < end && seen.insert (seed_pc).second)
+	out.push_back (seed_pc);
+    });
+}
+
+/* True when two adjacent segments may be coalesced into one span.  */
+bool
+dwarf_reader_impl::same_line_table_coalesce_group (const address_range_entry &a,
+						   const address_range_entry &b)
+{
+  /* Each .debug_line Address column starts a distinct variant group.  Do not
+     merge across groups even when file:line:disc match (duplicate PCs).  */
+  return a.line_table_pc == b.line_table_pc;
+}
+
+/* The run of DWARF functions whose entry PC is exactly ADDR.  */
+dwarf_reader_impl::function_range
+dwarf_reader_impl::dwarf_functions_at_entry (uint64_t addr) const
+{
+  struct by_start_addr
+  {
+    bool operator () (const function_metadata &f, uint64_t a) const noexcept
+    {
+      return f.start_addr < a;
+    }
+    bool operator () (uint64_t a, const function_metadata &f) const noexcept
+    {
+      return a < f.start_addr;
+    }
+  };
+  return std::equal_range
+    (dwarf_functions_.begin (), dwarf_functions_.end (), addr, by_start_addr{});
+}
+
+/* DWARF definition named NAME at START_ADDR, or null if ambiguous.  */
+const function_metadata *
+dwarf_reader_impl::find_function_at_entry (const std::string &name,
+					   uint64_t start_addr) const
+{
+  if (name.empty ())
+    return nullptr;
+  const function_range entry = dwarf_functions_at_entry (start_addr);
+  const function_metadata *result = nullptr;
+  interned_string file_path = nullptr;
+  uint32_t line = 0;
+  for (auto it = entry.first; it != entry.second; ++it)
+    if (it->end_addr > it->start_addr && string_value (it->name) == name)
+      {
+	if (line != 0 && it->start_line != 0 && line != it->start_line)
+	  return nullptr;
+	if (file_path != nullptr && it->file_path != nullptr
+	    && !source_path::equivalent (string_value (file_path),
+					 string_value (it->file_path)))
+	  return nullptr;
+	if (line == 0)
+	  line = it->start_line;
+	/* Compare later candidates against the most specific path.  A relative
+	   suffix can match two different absolute paths.  */
+	if (file_path == nullptr
+	    || (it->file_path != nullptr
+		&& it->file_path->size () > file_path->size ()))
+	  file_path = it->file_path;
+	if (result == nullptr
+	    || (result->start_line == 0 && it->start_line != 0))
+	  result = &*it;
+      }
+  return result;
+}
+
+/* INDEX entry for NAME, retrying under its GCC-suffix base name.  */
+const std::vector<size_t> *
+dwarf_reader_impl::find_name_index (const name_index_map &index,
+				    const std::string &name) const
+{
+  if (name.empty ())
+    return nullptr;
+  auto it = index.find (string_pool_.lookup (name));
+  if (it == index.end ())
+    {
+      /* Only a dotted name can carry a GCC suffix, and symbol_base_name
+	 copies its argument, so screen the common case out first.  */
+      if (name.find ('.') == std::string::npos)
+	return nullptr;
+      const std::string base = gcc_symbol::symbol_base_name (name);
+      if (base == name)
+	return nullptr;
+      it = index.find (string_pool_.lookup (base));
+      if (it == index.end ())
+	return nullptr;
+    }
+  return &it->second;
+}
+
+/* Source identity of the addressless ICF alias NAME.  Null when nothing
+   matches or the candidates disagree on file or line.  */
+const function_metadata *
+dwarf_reader_impl::find_unique_alias_identity (const std::string &name) const
+{
+  const std::vector<size_t> *const indices
+    = find_name_index (dwarf_alias_name_index_, name);
+  if (indices == nullptr)
+    return nullptr;
+
+  const function_metadata *result = nullptr;
+  /* Compare against the longest path seen.  Relative suffix matching is not
+     transitive, so a shorter path can hide two different absolute paths.  */
+  interned_string known_file = nullptr;
+  uint32_t known_line = 0;
+  for (size_t idx : *indices)
+    {
+      if (idx >= dwarf_alias_identities_.size ())
+	continue;
+      const function_metadata &candidate = dwarf_alias_identities_[idx];
+      if (!gcc_symbol::name_equivalent (string_value (candidate.name), name))
+	continue;
+      const bool different_file
+	= !string_empty (known_file)
+	  && !string_empty (candidate.file_path)
+	  && !source_path::equivalent (string_value (known_file),
+				       string_value (candidate.file_path));
+      const bool different_line = known_line != 0
+				  && candidate.start_line != 0
+				  && known_line != candidate.start_line;
+      if (different_file || different_line)
+	return nullptr;
+      if (!string_empty (candidate.file_path)
+	  && (string_empty (known_file)
+	      || string_value (candidate.file_path).size ()
+		   > string_value (known_file).size ()))
+	known_file = candidate.file_path;
+      if (known_line == 0)
+	known_line = candidate.start_line;
+      if (result == nullptr
+	  || (string_empty (result->file_path)
+	      && !string_empty (candidate.file_path))
+	  || (!string_empty (result->file_path)
+	      && !string_empty (candidate.file_path)
+	      && result->start_line == 0 && candidate.start_line != 0))
+	result = &candidate;
+    }
+  return result;
+}
+
+/* Declaration line for NAME at START_ADDR, given the DWARF definition
+   AT_ENTRY and alias identity IDENTITY already resolved for it (either may
+   be null).  Split from the lookup below so callers that need those two
+   pointers anyway do not pay for them twice.  */
+uint32_t
+dwarf_reader_impl::parse_time_decl_line
+  (const std::string &name, uint64_t start_addr,
+   const function_metadata *at_entry,
+   const function_metadata *identity) const
+{
+  if (at_entry != nullptr)
+    return at_entry->start_line;
+  if (identity != nullptr && identity->start_line != 0)
+    return identity->start_line;
+
+  const bool is_clone = has_gcc_generated_suffix (name);
+  const function_range entry = dwarf_functions_at_entry (start_addr);
+  uint32_t unnamed = 0;
+  interned_string unnamed_file = nullptr;
+  bool unnamed_ambiguous = false;
+  for (auto it = entry.first; it != entry.second; ++it)
+    {
+      if (it->end_addr <= it->start_addr)
+	continue;
+      if (is_clone
+	  && gcc_symbol::name_equivalent (string_value (it->name), name))
+	return it->start_line;
+      if (it->start_line == 0)
+	continue;
+      if (unnamed == 0)
+	{
+	  unnamed = it->start_line;
+	  unnamed_file = it->file_path;
+	}
+      /* A line identifies a decl site only with its file.  An absent file
+	 decides nothing.  */
+      else if (unnamed != it->start_line
+	       || (unnamed_file != nullptr && it->file_path != nullptr
+		   && unnamed_file != it->file_path))
+	{
+	  unnamed_ambiguous = true;
+	  unnamed = std::min (unnamed, it->start_line);
+	}
+    }
+
+  /* No name match.  Use the entry's decl line when symtab/DWARF spell the same
+     body differently (clones, template mangling).  Ambiguous decl lines at one
+     address mean ICF folded unrelated bodies.  Only clones may fall back.  */
+  if (unnamed_ambiguous && !is_clone)
+    return 0;
+  return unnamed;
+}
+
+/* Declaring file and line for FUNC.  */
+bool
+dwarf_reader_impl::function_profile_root (const function_metadata &func,
+					  source_location &out) const
+{
+  afdo_assert (mappings_loaded);
+  if (func.end_addr <= func.start_addr)
+    return false;
+
+  const std::string &name = string_value (func.name);
+  const function_metadata *const at_entry
+    = find_function_at_entry (name, func.start_addr);
+  const function_metadata *const identity
+    = at_entry == nullptr ? find_unique_alias_identity (name) : nullptr;
+
+  out = source_location ();
+  if (!name.empty ())
+    out.line_number
+      = parse_time_decl_line (name, func.start_addr, at_entry, identity);
+
+  /* An ICF alias left addressless by folding is the one case where the file
+     has to come from the name.  The code at ADDR is the primary's, so both the
+     line table and the inline stack would name the primary's file.  A
+     same-body alias (a C1/C2 constructor pair, a .localalias) does have a
+     definition at ADDR and shares the primary's file.  */
+  if (identity != nullptr)
+    out.file_path = identity->file_path;
+
+  if (!string_empty (out.file_path))
+    return true;
+
+  /* Prefer the outermost inline call file to the entry's line-table file.  */
+  const std::vector<inline_frame> *inline_stack
+    = inline_stack_at_pc (func.start_addr);
+  if (inline_stack != nullptr && !inline_stack->empty ()
+      && !string_empty (inline_stack->front ().caller_file_path))
+    out.file_path = inline_stack->front ().caller_file_path;
+  else
+    {
+      source_location primary;
+      if (lookup_primary_source_location_at_address (func.start_addr, primary)
+	  && !string_empty (primary.file_path))
+	out.file_path = primary.file_path;
+    }
+
+  return out.line_number != 0 || !string_empty (out.file_path);
+}
+
+namespace {
+
+/* The declaring file and line agreed on by a set of equivalently-named
+   definitions, or nothing when they disagree.  */
+struct decl_location_candidates
+{
+  interned_string file_path = nullptr;
+  interned_string comparison_file = nullptr;
+  uint32_t line_number = 0;
+  bool file_ambiguous = false;
+  bool line_ambiguous = false;
+  bool line_without_file = false;
+
+  /* Fold FUNCTION in, marking the file or line ambiguous once two candidates
+     disagree.  */
+  void add (const function_metadata &function)
+  {
+    if (!string_empty (function.file_path))
+      {
+	if (comparison_file != nullptr
+	    && !source_path::equivalent
+		   (string_value (comparison_file),
+		    string_value (function.file_path)))
+	  file_ambiguous = true;
+	if (file_path == nullptr)
+	  file_path = function.file_path;
+	/* A relative suffix can match two different absolute paths.  */
+	if (comparison_file == nullptr
+	    || function.file_path->size () > comparison_file->size ())
+	  comparison_file = function.file_path;
+      }
+    if (function.start_line != 0)
+      {
+	if (string_empty (function.file_path))
+	  line_without_file = true;
+	if (line_number == 0)
+	  line_number = function.start_line;
+	else if (line_number != function.start_line)
+	  line_ambiguous = true;
+      }
+  }
+
+  source_location location () const
+  {
+    source_location result;
+    if (!file_ambiguous && !string_empty (file_path))
+      result.file_path = file_path;
+    if (!line_ambiguous)
+      result.line_number = line_number;
+    return result;
+  }
+};
+
+} /* anonymous namespace.  */
+
+/* Declaring file and line of an inlined callee, filling in whatever the
+   frame itself does not carry by matching equivalently-named definitions.  */
+source_location
+dwarf_reader_impl::resolve_inline_frame_decl_location
+  (const inline_frame &frame, const std::string &caller_file) const
+{
+  source_location location;
+  const std::string &name = string_value (frame.function_name);
+  const std::string &call_file = string_value (frame.caller_file_path);
+  location.file_path = frame.file_path;
+  location.line_number = frame.line_number;
+  if ((!string_empty (location.file_path) && location.line_number != 0)
+      || name.empty ())
+    return location;
+
+  const std::string &file_hint
+    = !string_empty (location.file_path)
+	? string_value (location.file_path)
+	: (!call_file.empty () ? call_file : caller_file);
+  decl_location_candidates all;
+  decl_location_candidates contextual;
+
+  /* Every equivalently-named definition feeds ALL.  Those whose file matches
+     FILE_HINT also feed the preferred CONTEXTUAL set.  */
+  const auto collect = [&] (const name_index_map &index,
+			    const std::vector<function_metadata> &functions)
+  {
+    const std::vector<size_t> *const indices = find_name_index (index, name);
+    if (indices == nullptr)
+      return;
+    for (size_t idx : *indices)
+      {
+	if (idx >= functions.size ())
+	  continue;
+	const function_metadata &function = functions[idx];
+	if (!gcc_symbol::name_equivalent (string_value (function.name), name))
+	  continue;
+	/* Do not supply a file from a different or unknown declaration line.  */
+	if (location.line_number != 0
+	    && function.start_line != location.line_number)
+	  continue;
+	all.add (function);
+	if (!file_hint.empty () && !string_empty (function.file_path)
+	    && source_path::equivalent
+		 (string_value (function.file_path), file_hint))
+	  contextual.add (function);
+      }
+  };
+  collect (dwarf_func_name_index_, dwarf_functions_);
+  collect (symtab_equiv_index_, symtab_functions_);
+
+  const source_location candidate = contextual.location ();
+  const source_location unique = all.location ();
+  if (string_empty (location.file_path))
+    {
+      location.file_path = candidate.file_path;
+      if (string_empty (location.file_path))
+	location.file_path = unique.file_path;
+    }
+  if (location.line_number == 0)
+    location.line_number = candidate.line_number;
+  /* A line without a known file cannot complete a known file.  */
+  if (location.line_number == 0
+      && (string_empty (location.file_path)
+	  || (!all.line_without_file && !string_empty (unique.file_path)
+	      && source_path::equivalent (string_value (location.file_path),
+					  string_value (unique.file_path)))))
+    location.line_number = unique.line_number;
+  return location;
+}
+
+/* All candidate locations for PC, OUT[0] being the primary one and
+   DWARF_LINE_INDEX the row an addr2line-style consumer would report.  */
+bool
+dwarf_reader_impl::build_correlate_locations_at_pc
+  (uint64_t pc, const function_metadata &func,
+   std::vector<source_location> &out, size_t &dwarf_line_index) const
+{
+  out.clear ();
+  dwarf_line_index = 0;
+
+  source_location primary;
+  if (!lookup_primary_source_location_at_address (pc, primary))
+    {
+      /* Line-table gap, for example a DW_AT_ranges hole.  Take the
+	 subprogram's file but no line.  The decl line would put the PC's
+	 mass at relative line 0, which is then taken as the entry count.  */
+      source_location root;
+      if (!function_profile_root (func, root))
+	return false;
+      if (string_empty (root.file_path))
+	return false;
+      primary.file_path = root.file_path;
+    }
+  out.push_back (primary);
+
+  /* Collect exact-PC is_stmt rows.  A unique one becomes OUT[0].  */
+  auto range_it
+    = std::lower_bound
+	(address_ranges_.begin (),
+	 address_ranges_.end (),
+	 pc,
+	 [] (const address_range_entry &entry, uint64_t address)
+	 {
+	   return entry.start < address;
+	 });
+  source_location stmt_location;
+  bool have_stmt_location = false;
+  bool ambiguous_stmt_location = false;
+  for (; range_it != address_ranges_.end ()
+	 && range_it->start == pc;
+       ++range_it)
+    {
+      const address_range_entry &entry = *range_it;
+      if (!entry.line_table_is_stmt || entry.line_table_pc != pc)
+	continue;
+      if (entry.loc.line_number == 0 || string_empty (entry.loc.file_path))
+	continue;
+      if (!have_stmt_location)
+	{
+	  stmt_location = entry.loc;
+	  have_stmt_location = true;
+	}
+      else if (!source_location_equal (stmt_location, entry.loc))
+	ambiguous_stmt_location = true;
+      if (entry.loc.file_path == primary.file_path
+	  && entry.loc.line_number == primary.line_number
+	  && entry.loc.discriminator == primary.discriminator)
+	continue;
+      out.push_back (entry.loc);
+    }
+  if (have_stmt_location && !ambiguous_stmt_location
+      && !source_location_equal (out[0], stmt_location))
+    for (size_t i = 1; i < out.size (); ++i)
+      if (source_location_equal (out[i], stmt_location))
+	{
+	  std::swap (out[0], out[i]);
+	  dwarf_line_index = i;
+	  break;
+	}
+  return true;
+}
+
+/* Source locations and inline stack at PC.  */
+const correlate_symbolize_entry *
+dwarf_reader_impl::symbolize (uint64_t pc, correlate_session &session,
+			      const function_metadata &func) const
+{
+  afdo_assert (mappings_loaded);
+  afdo_assert (session.reader_ == this);
+
+  const correlate_session::cache_key cache_key
+    = {pc, {func.name, func.start_addr}};
+  const auto cache_it = session.symbolize_cache_.find (cache_key);
+  if (cache_it != session.symbolize_cache_.end ())
+    return &cache_it->second;
+
+  if (string_empty (func.name))
+    return nullptr;
+
+  std::vector<source_location> locs;
+  size_t dwarf_line_index = 0;
+  if (!build_correlate_locations_at_pc
+	(pc, func, locs, dwarf_line_index))
+    return nullptr;
+
+  const std::vector<inline_frame> *const inline_stack
+    = inline_stack_at_pc (pc);
+  correlate_symbolize_entry entry;
+  entry.locations = std::move (locs);
+  entry.dwarf_line_index = dwarf_line_index;
+  entry.inline_stack = inline_stack;
+  const auto inserted
+    = session.symbolize_cache_.emplace (cache_key, std::move (entry));
+  return &inserted.first->second;
+}
+
+/* Open libdw once for sample-scoped DWARF load.  An absent, empty, or
+   non-overlapping .debug_aranges section is not a load failure.  */
+bool
+dwarf_reader_impl::open_binary_dwarf (std::vector<Dwarf_Off> &all_cus)
+{
+  dwarf_functions_.clear ();
+  dwarf_alias_identities_.clear ();
+  symtab_functions_.clear ();
+  symtab_aliases_.clear ();
+  if (!open_libdw_session (binary_path_, dw_))
+    return false;
+
+  if (!all_cu_die_offsets (all_cus))
+    {
+      close_libdw_session (dw_);
+      return false;
+    }
+
+  Dwarf_Aranges *aranges = nullptr;
+  size_t naranges = 0;
+  const bool have_aranges
+    = dwarf_getaranges (dw_.dwarf, &aranges, &naranges) == 0 && naranges != 0
+      && build_profile_cu_index (aranges, naranges);
+  if (!have_aranges)
+    {
+      /* .debug_aranges cannot name the sample-touch CUs, so index all CUs.
+	 Their last-row bounds fall back to function ends.  */
+      cu_end_by_off_.clear ();
+      profile_cu_offs_ = all_cus;
+      for (const Dwarf_Off cu_off : profile_cu_offs_)
+	cu_end_by_off_.emplace (cu_off, 0);
+    }
+  else
+    {
+      /* Aranges can omit CUs or individual ranges.  Check the CU ranges
+	 as well, and parse CUs without usable ranges conservatively.  */
+      for (Dwarf_Off off : all_cus)
+	if (cu_end_by_off_.count (off) == 0)
+	  {
+	    Dwarf_Die die;
+	    pc_range_list ranges;
+	    if (dwarf_offdie (dw_.dwarf, off, &die) == nullptr)
+	      {
+		fprintf (stderr, _("Error: cannot read DWARF CU in %s\n"),
+			 binary_path_.c_str ());
+		close_libdw_session (dw_);
+		return false;
+	      }
+	    const pc_range_decode_status status
+	      = collect_die_pc_ranges (&die, ranges, nullptr);
+	    if (status == pc_range_decode_status::invalid)
+	      {
+		fprintf (stderr,
+			 _("Error: cannot read DWARF CU ranges in %s\n"),
+			 binary_path_.c_str ());
+		close_libdw_session (dw_);
+		return false;
+	      }
+	    bool selected = ranges.empty ();
+	    for (const auto &range : ranges)
+	      if (range_overlaps_sampled (range.first, range.second))
+		selected = true;
+	    if (selected)
+	      {
+		profile_cu_offs_.push_back (off);
+		cu_end_by_off_.emplace (off, 0);
+	      }
+	  }
+    }
+  if (profile_cu_offs_.empty ())
+    {
+      fprintf (stderr,
+	       _("Error: no DWARF compilation units in %s\n"),
+	       binary_path_.c_str ());
+      close_libdw_session (dw_);
+      return false;
+    }
+
+  if (selected_cus_use_split_dwarf ())
+    {
+      fprintf (stderr,
+	       _("Error: split DWARF is not supported for %s\n"),
+	       binary_path_.c_str ());
+      close_libdw_session (dw_);
+      return false;
+    }
+  return true;
+}
+
+/* True when [LO, HI) meets any sampled range.  */
+bool
+dwarf_reader_impl::range_overlaps_sampled (uint64_t lo, uint64_t hi) const
+{
+  if (profile_sample_ranges_.empty () || hi <= lo)
+    return false;
+  /* First interval whose exclusive end is past lo.  It overlaps [lo,hi)
+     iff it also begins before hi.  */
+  auto it = std::upper_bound
+    (profile_sample_ranges_.begin (),
+     profile_sample_ranges_.end (),
+     lo,
+     [] (uint64_t v, const std::pair<uint64_t, uint64_t> &r)
+     {
+       return v < r.second;
+     });
+  return it != profile_sample_ranges_.end () && it->first < hi;
+}
+
+/* Build sample-scoped CU index from .debug_aranges.
+
+   Output.
+   cu_end_by_off_ holds the highest arange end per CU, bounding its last line
+   row.  profile_cu_offs_ holds deduplicated CU offsets to parse in
+   build_address_range_index.
+
+   Returns true when at least one arange overlaps the samples.  */
+bool
+dwarf_reader_impl::build_profile_cu_index (Dwarf_Aranges *aranges,
+					   size_t naranges)
+{
+  cu_end_by_off_.clear ();
+  profile_cu_offs_.clear ();
+  cu_end_by_off_.reserve (naranges);
+  profile_cu_offs_.reserve (naranges);
+  for (size_t i = 0; i < naranges; ++i)
+    {
+      Dwarf_Arange *const ar = dwarf_onearange (aranges, i);
+      if (ar == nullptr)
+	continue;
+      Dwarf_Addr ar_addr = 0;
+      Dwarf_Word ar_len = 0;
+      Dwarf_Off cu_off = 0;
+      if (dwarf_getarangeinfo (ar, &ar_addr, &ar_len, &cu_off) != 0
+	  || ar_len == 0)
+	continue;
+      const uint64_t start = static_cast<uint64_t> (ar_addr);
+      const uint64_t end = start + static_cast<uint64_t> (ar_len);
+      if (end <= start)
+	continue;
+      if (!range_overlaps_sampled (start, end))
+	continue;
+      const auto inserted = cu_end_by_off_.emplace (cu_off, end);
+      if (inserted.second)
+	profile_cu_offs_.push_back (cu_off);
+      else if (end > inserted.first->second)
+	inserted.first->second = end;
+    }
+
+  return !profile_cu_offs_.empty ();
+}
+
+/* True when a selected CU refers to separate .dwo debug information.  */
+bool
+dwarf_reader_impl::selected_cus_use_split_dwarf () const
+{
+  for (const Dwarf_Off cu_off : profile_cu_offs_)
+    {
+      Dwarf_Die cu_die;
+      if (dwarf_offdie (dw_.dwarf, cu_off, &cu_die) == nullptr)
+	continue;
+      if (dwarf_tag (&cu_die) == DW_TAG_skeleton_unit
+	  || dwarf_hasattr (&cu_die, DW_AT_dwo_name)
+	  || dwarf_hasattr (&cu_die, DW_AT_GNU_dwo_name))
+	return true;
+    }
+  return false;
+}
+
+/* Every CU DIE offset in the binary, in .debug_info order.  */
+bool
+dwarf_reader_impl::all_cu_die_offsets (std::vector<Dwarf_Off> &cu_dies) const
+{
+  cu_dies.clear ();
+  for (Dwarf_Off off = 0;;)
+    {
+      Dwarf_Off next_off = 0;
+      size_t header_size = 0;
+      const int status = dwarf_nextcu (dw_.dwarf, off, &next_off, &header_size,
+				       nullptr, nullptr, nullptr);
+      if (status > 0)
+	return true;
+      if (status < 0 || next_off <= off || header_size > next_off - off)
+	{
+	  fprintf (stderr, _("Error: cannot read DWARF CU headers in %s\n"),
+		   binary_path_.c_str ());
+	  return false;
+	}
+      cu_dies.push_back (off + header_size);
+      off = next_off;
+    }
+}
+
+/* Per-CU line table and DIE tree entry points.  */
+
+/* Walk each DWARF line-row and decode the running line-table state.  GCC often
+   emits several rows at the same PC (different file/line/disc).  Keep every raw
+   row so emit_cu_line_ranges can emit all variants instead of collapsing to a
+   single "best" row.  */
+void
+dwarf_reader_impl::decode_cu_line_rows (Dwarf_Lines *lines, size_t nlines,
+					std::vector<cu_line_row> &out) const
+{
+  out.reserve (nlines);
+  /* Accumulators use libdw's output types and are widened on assignment.  */
+  int run_line = 0;
+  unsigned int run_disc = 0;
+  interned_string active_file_path = nullptr;
+  const char *last_src_file = nullptr;
+  std::unordered_map<const char *, interned_string> file_view_cache;
+  bool row_starts_sequence = true;
+  bool skip_sequence = false;
+
+  for (size_t i = 0; i < nlines; ++i)
+    {
+      Dwarf_Line *const srcl = dwarf_onesrcline (lines, i);
+      if (srcl == nullptr)
+	continue;
+
+      Dwarf_Addr row_addr = 0;
+      if (dwarf_lineaddr (srcl, &row_addr) != 0)
+	continue;
+
+      /* Discarded sections can have line sequences starting at zero.  Keep
+	 them only when the binary has a function at that address.  */
+      bool ends_sequence = false;
+      if (dwarf_lineendsequence (srcl, &ends_sequence) != 0)
+	ends_sequence = false;
+      if (row_starts_sequence)
+	skip_sequence = (row_addr == 0
+			 && function_containing_address (symtab_functions_, 0)
+			      == nullptr);
+      row_starts_sequence = ends_sequence;
+      if (skip_sequence)
+	continue;
+
+      cu_line_row row;
+      row.addr = static_cast<uint64_t> (row_addr);
+
+      /* Keep the end marker to terminate the preceding segment.  Its file
+	 and line help identify rows with no instructions at this address.  */
+      if (ends_sequence)
+	{
+	  row.end_sequence = true;
+	  int end_line = 0;
+	  if (dwarf_lineno (srcl, &end_line) == 0 && end_line > 0)
+	    row.run_line = static_cast<uint32_t> (end_line);
+	  const char *const end_file = dwarf_linesrc (srcl, nullptr, nullptr);
+	  if (end_file != nullptr && end_file[0] != '\0')
+	    row.file_path
+	      = string_pool_.intern (source_path::normalize (end_file));
+	  out.push_back (row);
+	  active_file_path = {};
+	  last_src_file = nullptr;
+	  run_line = 0;
+	  run_disc = 0;
+	  continue;
+	}
+
+      int ln = 0;
+      if (dwarf_lineno (srcl, &ln) == 0 && ln >= 0)
+	run_line = ln;
+      if (run_line > 0)
+	row.run_line = static_cast<uint32_t> (run_line);
+
+      unsigned int row_disc = 0;
+      if (dwarf_linediscriminator (srcl, &row_disc) == 0)
+	run_disc = row_disc;
+      row.disc = run_disc;
+
+      bool is_stmt = false;
+      if (dwarf_linebeginstatement (srcl, &is_stmt) == 0)
+	row.is_stmt = is_stmt;
+
+      const char *const src_file = dwarf_linesrc (srcl, nullptr, nullptr);
+      if (src_file != nullptr && src_file[0] != '\0')
+	{
+	  if (src_file != last_src_file)
+	    {
+	      const auto cached = file_view_cache.find (src_file);
+	      if (cached != file_view_cache.end ())
+		active_file_path = cached->second;
+	      else
+		{
+		  active_file_path
+		    = string_pool_.intern (source_path::normalize (src_file));
+		  if (!string_empty (active_file_path))
+		    file_view_cache.emplace (src_file, active_file_path);
+		}
+	      last_src_file = src_file;
+	    }
+	}
+
+      if (!string_empty (active_file_path))
+	row.file_path = active_file_path;
+
+      out.push_back (row);
+    }
+}
+
+/* Turn a CU's line-table rows into address ranges, ending each row at the
+   next row's address or, for the last one, at the enclosing function's end.  */
+void
+dwarf_reader_impl::emit_cu_line_ranges
+  (const std::vector<cu_line_row> &rows, uint64_t cu_end_excl,
+   const std::vector<function_metadata> &cu_local_functions,
+   std::vector<address_range_entry> &out) const
+{
+  struct cu_function_range
+  {
+    uint64_t start;
+    uint64_t end;
+    size_t index;
+  };
+  std::vector<cu_function_range> functions;
+  functions.reserve (cu_local_functions.size ());
+  for (size_t i = 0; i < cu_local_functions.size (); ++i)
+    if (cu_local_functions[i].start_addr < cu_local_functions[i].end_addr)
+      functions.push_back ({cu_local_functions[i].start_addr,
+			    cu_local_functions[i].end_addr, i});
+  std::sort (functions.begin (), functions.end (),
+	     [] (const cu_function_range &a, const cu_function_range &b)
+	     {
+	       return a.start < b.start;
+	     });
+  range_index<cu_function_range> function_index;
+  function_index.build (functions);
+  std::vector<size_t> owners;
+
+  for (size_t i = 0; i < rows.size ();)
+    {
+      const uint64_t group_addr = rows[i].addr;
+      size_t next_i = i;
+      while (next_i < rows.size ()
+	     && rows[next_i].addr == group_addr)
+	++next_i;
+
+      uint64_t end = 0;
+      if (next_i < rows.size ())
+	end = rows[next_i].addr;
+      else
+	{
+	  if (cu_end_excl > group_addr)
+	    end = cu_end_excl;
+	  for (const function_metadata &func : cu_local_functions)
+	    if (func.start_addr <= group_addr && func.end_addr > group_addr
+		&& (end == 0 || func.end_addr < end))
+	      end = func.end_addr;
+	}
+
+      owners.clear ();
+      if (end > group_addr)
+	function_index.visit_overlapping (group_addr, end,
+	  [&] (const cu_function_range &func)
+	  {
+	    owners.push_back (func.index);
+	  });
+      if (end <= group_addr
+	  || (owners.empty () && !range_overlaps_sampled (group_addr, end)))
+	{
+	  i = next_i;
+	  continue;
+	}
+      /* Preserve DIE order when several functions cover the same PC.  */
+      std::sort (owners.begin (), owners.end ());
+
+      /* A sequence end can coincide with a row from another sequence.  */
+      bool has_end_sequence = false;
+      for (size_t j = i; j < next_i; ++j)
+	if (rows[j].end_sequence)
+	  {
+	    has_end_sequence = true;
+	    break;
+	  }
+      bool function_at_pc = false;
+      if (has_end_sequence)
+	for (size_t owner : owners)
+	  if (cu_local_functions[owner].start_addr <= group_addr)
+	    {
+	      function_at_pc = true;
+	      break;
+	    }
+
+      const cu_line_row &last_row_at_pc = rows[next_i - 1];
+      const uint32_t last_row_line = last_row_at_pc.run_line;
+
+      /* Collect distinct (file,line,disc) variants at one PC.  */
+      struct line_variant_key
+      {
+	uint32_t line = 0;
+	uint32_t disc = 0;
+	interned_string file = nullptr;
+	uint32_t line_row_seq = 0;
+	bool is_stmt = false;
+      };
+      std::vector<line_variant_key> variants;
+      variants.reserve (next_i - i);
+      for (size_t j = i; j < next_i; ++j)
+	{
+	  const cu_line_row &candidate = rows[j];
+	  if (candidate.end_sequence)
+	    continue;
+	  if (candidate.run_line == 0 && candidate.disc == 0
+	      && string_empty (candidate.file_path))
+	    continue;
+	  if (has_end_sequence)
+	    {
+	      bool ended = false;
+	      for (size_t k = i; k < next_i; ++k)
+		if (rows[k].end_sequence && rows[k].run_line != 0
+		    && !string_empty (rows[k].file_path)
+		    && rows[k].run_line == candidate.run_line
+		    && rows[k].file_path == candidate.file_path)
+		  {
+		    ended = true;
+		    break;
+		  }
+	      /* Keep the selected row if this CU has code at the address.  */
+	      const bool selected
+		= (function_at_pc && !last_row_at_pc.end_sequence
+		   && candidate.run_line == last_row_at_pc.run_line
+		   && candidate.disc == last_row_at_pc.disc
+		   && candidate.file_path == last_row_at_pc.file_path);
+	      if (ended && !selected)
+		continue;
+	    }
+	  line_variant_key key;
+	  key.line = candidate.run_line;
+	  key.disc = candidate.disc;
+	  key.file = candidate.file_path;
+	  key.line_row_seq = static_cast<uint32_t> (j);
+	  key.is_stmt = candidate.is_stmt;
+	  auto existing = std::find_if (variants.begin (),
+					variants.end (),
+					[&] (const line_variant_key &v)
+					{
+					  return v.line == key.line
+						 && v.file == key.file
+						 && v.disc == key.disc;
+					});
+	  if (existing == variants.end ())
+	    variants.push_back (key);
+	  else
+	    {
+	      existing->is_stmt = existing->is_stmt || key.is_stmt;
+	      existing->line_row_seq = static_cast<uint32_t> (j);
+	    }
+	}
+
+      const auto append_entry = [&out] (address_range_entry entry)
+	{
+	  if (!out.empty ())
+	    {
+	      const address_range_entry &prev = out.back ();
+	      if (prev.start == entry.start && prev.end == entry.end
+		  && source_location_equal (prev.loc, entry.loc))
+		return;
+	    }
+	  out.push_back (std::move (entry));
+	};
+
+      for (const line_variant_key &variant : variants)
+	{
+	  address_range_entry entry;
+	  entry.start = group_addr;
+	  entry.end = end;
+	  entry.loc.file_path = variant.file;
+	  entry.loc.line_number = variant.line;
+	  entry.loc.discriminator = variant.disc;
+	  entry.line_row_seq = variant.line_row_seq;
+	  entry.line_table_is_stmt = variant.is_stmt;
+	  entry.line_table_pc = group_addr;
+	  entry.line_table_primary = !last_row_at_pc.end_sequence
+				     && variant.line == last_row_line
+				     && variant.file == last_row_at_pc.file_path
+				     && variant.disc == last_row_at_pc.disc;
+
+	  for (size_t owner : owners)
+	    {
+	      const function_metadata &func = cu_local_functions[owner];
+	      const uint64_t owned_start
+		= std::max (entry.start, func.start_addr);
+	      const uint64_t owned_end = std::min (entry.end, func.end_addr);
+	      address_range_entry owned = entry;
+	      owned.start = owned_start;
+	      owned.end = owned_end;
+	      append_entry (std::move (owned));
+	    }
+	  if (owners.empty ())
+	    append_entry (std::move (entry));
+	}
+      i = next_i;
+    }
+}
+
+/* One subprogram DIE yields zero or more function_metadata rows.  */
+void
+dwarf_reader_impl::record_subprogram_metadata
+  (Dwarf_Die *die, std::vector<function_metadata> &symbols_out,
+   bool &invalid_ranges) const
+{
+  if (die == nullptr || die_is_declaration (die))
+    return;
+  afdo_assert (dwarf_tag (die) == DW_TAG_subprogram);
+
+  pc_range_list pc_ranges;
+  uint64_t first_range_start = 0;
+  const pc_range_decode_status range_status
+    = collect_die_pc_ranges (die, pc_ranges, &first_range_start);
+  if (range_status == pc_range_decode_status::invalid)
+    invalid_ranges = true;
+  if (range_status != pc_range_decode_status::valid || pc_ranges.empty ())
+    return;
+
+  const char *const linkage_name = resolve_die_symbol_name (die);
+  if (linkage_name == nullptr || linkage_name[0] == '\0')
+    return;
+  /* Linkers also use address zero for discarded COMDAT relocations.  */
+  if (pc_ranges.front ().first == 0)
+    {
+      bool real_zero = false;
+      for (const function_metadata &function : symtab_functions_)
+	{
+	  if (function.start_addr != 0)
+	    break;
+	  if (function.end_addr != 0
+	      && string_value (function.name) == linkage_name)
+	    {
+	      real_zero = true;
+	      break;
+	    }
+	}
+      if (!real_zero)
+	{
+	  /* libdw interleaves line rows by address, so a discarded zero-based
+	     DIE cannot be separated safely from real code at zero.  */
+	  if (function_containing_address (symtab_functions_, 0))
+	    {
+	      if (!invalid_ranges)
+		fprintf (stderr, _("Error: ambiguous zero-address DWARF "
+				   "ranges in %s\n"), binary_path_.c_str ());
+	      invalid_ranges = true;
+	      return;
+	    }
+	  pc_ranges.erase (pc_ranges.begin ());
+	}
+    }
+  if (pc_ranges.empty ())
+    return;
+
+  const interned_string owner_name = string_pool_.intern (linkage_name);
+
+  const die_decl_site decl
+    = resolve_die_decl_site (die, &enclosing_type_by_die_);
+
+  /* Prefer the definition file at the first decoded range.  The declaration
+     file may come from a header even when the function is defined elsewhere.  */
+  const uint64_t entry_pc
+    = first_range_start != 0 ? first_range_start : pc_ranges.front ().first;
+  Dwarf_Die cu_mem;
+  Dwarf_Die *const cudie = dwarf_diecu (die, &cu_mem, nullptr, nullptr);
+  Dwarf_Line *const entry_row
+    = cudie == nullptr
+	? nullptr
+	: dwarf_getsrc_die (cudie, static_cast<Dwarf_Addr> (entry_pc));
+  const char *const def_file = entry_row == nullptr
+				 ? nullptr
+				 : dwarf_linesrc (entry_row, nullptr, nullptr);
+  const char *file = dwarf_source_file_is_usable (def_file)
+		       ? def_file : decl.file_path;
+  interned_string file_path = nullptr;
+  if (dwarf_source_file_is_usable (file))
+    file_path = string_pool_.intern (source_path::normalize (file));
+
+  for (const std::pair<uint64_t, uint64_t> &range : pc_ranges)
+    {
+      const uint64_t start = range.first;
+      const uint64_t end = range.second;
+      if (!range_overlaps_sampled (start, end))
+	continue;
+      symbols_out.emplace_back (owner_name, file_path, start, end,
+				decl.line_number);
+    }
+}
+
+/* One inlined_subroutine DIE.  Preserve its effective range constraint and,
+   when its extent and name are usable, emit spans and push its frame.
+   Returns true when the caller must pop a frame after visiting children.
+   The caller always pops the range constraint.  */
+bool
+dwarf_reader_impl::visit_inlined_subroutine_die
+  (Dwarf_Die &die, cu_die_parser &parser,
+   std::vector<inline_stack_span> &spans_out) const
+{
+  const pc_range_decode_status range_status
+    = collect_die_pc_ranges (&die, parser.pc_ranges);
+  if (range_status == pc_range_decode_status::invalid)
+    parser.invalid_ranges = true;
+
+  const pc_range_list *const parent_ranges
+    = parser.inline_ranges_stack.empty ()
+	? nullptr
+	: &parser.inline_ranges_stack.back ();
+  bool accept_frame
+    = range_status == pc_range_decode_status::no_extent
+      || (range_status == pc_range_decode_status::valid
+	  && !parser.pc_ranges.empty ());
+  if (accept_frame && parent_ranges != nullptr && !parent_ranges->empty ()
+      && !parser.pc_ranges.empty ()
+      && !pc_ranges_subset_of (parser.pc_ranges, *parent_ranges))
+    {
+      parser.pc_ranges.clear ();
+      accept_frame = false;
+    }
+
+  /* Missing or rejected extents inherit the nearest valid ancestor
+     constraint.  A usable extent narrows that constraint for descendants.  */
+  const bool has_own_ranges = !parser.pc_ranges.empty ();
+  pc_range_list effective_ranges;
+  if (has_own_ranges)
+    effective_ranges = std::move (parser.pc_ranges);
+  else if (parent_ranges != nullptr)
+    effective_ranges = *parent_ranges;
+  parser.inline_ranges_stack.push_back (std::move (effective_ranges));
+
+  if (!accept_frame)
+    return false;
+
+  inline_frame frame;
+  frame.function_name = string_pool_.intern (resolve_die_symbol_name (&die));
+  if (string_empty (frame.function_name))
+    return false;
+  const die_decl_site decl
+    = resolve_die_decl_site (&die, &enclosing_type_by_die_);
+  if (dwarf_source_file_is_usable (decl.file_path))
+    frame.file_path
+      = string_pool_.intern (source_path::normalize (decl.file_path));
+  frame.line_number = decl.line_number;
+
+  /* DW_AT_call_* name the call site.  No call_line means the DIE has none.  */
+  const Dwarf_Word call_line = die_udata_attr (&die, DW_AT_call_line);
+  if (call_line != 0)
+    {
+      frame.call_line = static_cast<uint32_t> (call_line);
+      frame.discriminator = static_cast<uint32_t>
+	(die_udata_attr (&die, DW_AT_CALL_DISCRIMINATOR_EXT));
+      const char *const call_file = die_call_file_path (&die);
+      if (dwarf_source_file_is_usable (call_file))
+	frame.caller_file_path
+	  = string_pool_.intern (source_path::normalize (call_file));
+    }
+  /* Keep recursive self-inlines.  The DFS visits each DIE once.  */
+  parser.inline_stack.push_back (frame);
+
+  if (has_own_ranges)
+    {
+      auto stack = std::make_shared<const std::vector<inline_frame>>
+	(parser.inline_stack);
+      for (const auto &range : parser.inline_ranges_stack.back ())
+	spans_out.push_back ({range.first, range.second, stack});
+    }
+
+  return true;
+}
+
+/* Collect enclosing type declarations and addressless ICF alias identities.  */
+void
+dwarf_reader_impl::record_global_die_metadata (Dwarf_Die *die,
+					       global_die_walk &walk) const
+{
+  if (die == nullptr)
+    return;
+
+  const int tag = dwarf_tag (die);
+  const bool is_type
+    = (tag == DW_TAG_class_type
+       || tag == DW_TAG_structure_type
+       || tag == DW_TAG_union_type);
+  if (is_type)
+    {
+      int ln = 0;
+      die_decl_site site;
+      if (dwarf_decl_line (die, &ln) == 0 && ln > 0)
+	site.line_number = static_cast<uint32_t> (ln);
+      const char *const file = dwarf_decl_file (die);
+      if (dwarf_source_file_is_usable (file))
+	{
+	  const interned_string interned
+	    = string_pool_.intern (source_path::normalize (file));
+	  if (interned != nullptr)
+	    site.file_path = interned->c_str ();
+	}
+      walk.type_stack.push_back (site);
+    }
+  if ((tag == DW_TAG_subprogram || tag == DW_TAG_inlined_subroutine)
+      && walk.retain_enclosing_types && !walk.type_stack.empty ())
+    walk.out->enclosing_types[dwarf_dieoffset (die)] = walk.type_stack.back ();
+  /* ICF can leave an alias definition addressless, so keep its name and decl
+     site even though the DIE carries no code range.  */
+  if (tag == DW_TAG_subprogram && !walk.identity_names->empty ()
+      && !die_is_declaration (die))
+    {
+      const char *const raw_name = resolve_die_symbol_name (die);
+      const intern_string_set &wanted = *walk.identity_names;
+      if (raw_name != nullptr
+	  && (wanted.find (raw_name) != wanted.end ()
+	      || wanted.find (gcc_symbol::symbol_base_name (raw_name))
+		   != wanted.end ()))
+	{
+	  const auto *const enclosing_types
+	    = walk.retain_enclosing_types
+	      ? &walk.out->enclosing_types : nullptr;
+	  const die_decl_site decl
+	    = resolve_die_decl_site (die, enclosing_types);
+	  interned_string file_path = nullptr;
+	  if (dwarf_source_file_is_usable (decl.file_path))
+	    file_path
+	      = string_pool_.intern (source_path::normalize (decl.file_path));
+	  walk.out->alias_identities.emplace_back
+	    (string_pool_.intern (raw_name), file_path, 0, 0, decl.line_number);
+	}
+    }
+
+  Dwarf_Die child;
+  if (dwarf_child (die, &child) == 0)
+    {
+      record_global_die_metadata (&child, walk);
+      Dwarf_Die sibling;
+      while (dwarf_siblingof (&child, &sibling) == 0)
+	{
+	  record_global_die_metadata (&sibling, walk);
+	  child = sibling;
+	}
+    }
+
+  if (is_type)
+    walk.type_stack.pop_back ();
+}
+
+/* Index enclosing type declarations in sampled CUs.  ELF aliases require a
+   whole-binary name scan because ICF can leave their DIEs addressless.  */
+bool
+dwarf_reader_impl::build_global_die_metadata
+  (const std::vector<Dwarf_Off> &all_cus)
+{
+  dwarf_alias_identities_.clear ();
+  enclosing_type_by_die_.clear ();
+  intern_string_set identity_names;
+  for (const function_alias_metadata &alias : symtab_aliases_)
+    {
+      const std::string &name = string_value (alias.function.name);
+      identity_names.insert (name);
+      identity_names.insert (gcc_symbol::symbol_base_name (name));
+    }
+
+  const std::vector<Dwarf_Off> &cu_dies
+    = identity_names.empty () ? profile_cu_offs_ : all_cus;
+  const size_t n_cus = cu_dies.size ();
+  if (n_cus == 0)
+    return true;
+
+  const std::unordered_set<Dwarf_Off> profile_cus
+    (profile_cu_offs_.begin (), profile_cu_offs_.end ());
+
+  const unsigned num_threads = dwarf_parse_thread_count (n_cus);
+  std::vector<global_die_metadata> partials (n_cus);
+  std::atomic<size_t> next_cu{0};
+
+  std::atomic<bool> invalid_cu{false};
+  const bool sessions_opened
+    = for_each_libdw_worker (num_threads, [&] (Dwarf *dwarf)
+  {
+    global_die_walk walk;
+    walk.identity_names = &identity_names;
+    for (;;)
+      {
+	const size_t i = next_cu.fetch_add (1, std::memory_order_relaxed);
+	if (i >= n_cus)
+	  break;
+	Dwarf_Die cu_die;
+	if (dwarf_offdie (dwarf, cu_dies[i], &cu_die) == nullptr)
+	  {
+	    invalid_cu.store (true, std::memory_order_relaxed);
+	    continue;
+	  }
+	walk.type_stack.clear ();
+	walk.retain_enclosing_types
+	  = profile_cus.find (cu_dies[i]) != profile_cus.end ();
+	walk.out = &partials[i];
+	record_global_die_metadata (&cu_die, walk);
+      }
+  });
+
+  if (!sessions_opened || invalid_cu.load (std::memory_order_relaxed))
+    {
+      fprintf (stderr, _("Error: cannot read DWARF metadata in %s\n"),
+	       binary_path_.c_str ());
+      return false;
+    }
+
+  for (global_die_metadata &part : partials)
+    {
+      enclosing_type_by_die_.insert
+	(part.enclosing_types.begin (), part.enclosing_types.end ());
+      dwarf_alias_identities_.insert
+	(dwarf_alias_identities_.end (),
+	 std::make_move_iterator (part.alias_identities.begin ()),
+	 std::make_move_iterator (part.alias_identities.end ()));
+    }
+  return true;
+}
+
+/* Depth-first walk of one CU DIE tree.  */
+void
+dwarf_reader_impl::parse_cu_die_tree_recursive
+  (Dwarf_Die *die, std::vector<inline_stack_span> &spans_out,
+   std::vector<function_metadata> &symbols_out, cu_die_parser &parser) const
+{
+  if (die == nullptr)
+    return;
+
+  const int tag = dwarf_tag (die);
+
+  if (tag == DW_TAG_subprogram)
+    record_subprogram_metadata (die, symbols_out, parser.invalid_ranges);
+
+  const bool is_inline_die = tag == DW_TAG_inlined_subroutine;
+  const bool inline_frame_pushed
+    = is_inline_die
+      && visit_inlined_subroutine_die (*die, parser, spans_out);
+
+  Dwarf_Die child;
+  if (dwarf_child (die, &child) == 0)
+    {
+      parse_cu_die_tree_recursive (&child, spans_out, symbols_out, parser);
+      Dwarf_Die sibling;
+      while (dwarf_siblingof (&child, &sibling) == 0)
+	{
+	  parse_cu_die_tree_recursive
+	    (&sibling, spans_out, symbols_out, parser);
+	  child = sibling;
+	}
+    }
+
+  if (is_inline_die)
+    {
+      if (inline_frame_pushed)
+	parser.inline_stack.pop_back ();
+      parser.inline_ranges_stack.pop_back ();
+    }
+}
+
+/* Parse one CU at cu_off into OUT (returns false if offdie fails).  Decode the
+   line table first (cheap state machine), then walk the DIE tree.  Line ranges
+   are emitted after the DIE walk so the function-span overlap filter can use
+   out.symbols.  OUT must be freshly constructed.  */
+bool
+dwarf_reader_impl::parse_cu_symbols (Dwarf *dwarf, Dwarf_Off cu_off,
+				     cu_parse_symbols &out,
+				     cu_die_parser &parser) const
+{
+  Dwarf_Die cudie;
+  if (dwarf == nullptr || dwarf_offdie (dwarf, cu_off, &cudie) == nullptr)
+    return false;
+
+  std::vector<cu_line_row> line_rows;
+
+  Dwarf_Lines *lines = nullptr;
+  size_t nlines = 0;
+  if (dwarf_hasattr (&cudie, DW_AT_stmt_list))
+    {
+      if (dwarf_getsrclines (&cudie, &lines, &nlines) != 0)
+	return false;
+      if (nlines != 0)
+	decode_cu_line_rows (lines, nlines, line_rows);
+    }
+
+  parse_cu_die_tree_recursive (&cudie, out.inline_spans, out.symbols, parser);
+  if (parser.invalid_ranges)
+    return false;
+  afdo_assert (parser.inline_stack.empty ());
+  afdo_assert (parser.inline_ranges_stack.empty ());
+
+  if (line_rows.empty ())
+    return true;
+
+  /* Sort by PC so duplicate-address groups are contiguous.  */
+  std::stable_sort (line_rows.begin (), line_rows.end (),
+		    [] (const cu_line_row &a, const cu_line_row &b)
+		    {
+		      return a.addr < b.addr;
+		    });
+
+  /* Bound the final line row by its CU or function.  Without aranges the
+     stored CU end is 0.  Use the tightest DIE end, else one past the last
+     line-table address, so a trailing sampled row is not dropped.  */
+  const auto cu_end_it = cu_end_by_off_.find (cu_off);
+  uint64_t cu_end_excl
+    = cu_end_it != cu_end_by_off_.end () ? cu_end_it->second : 0;
+  if (cu_end_excl == 0)
+    {
+      for (const function_metadata &func : out.symbols)
+	if (func.end_addr > cu_end_excl)
+	  cu_end_excl = func.end_addr;
+      if (cu_end_excl == 0)
+	{
+	  const uint64_t last = line_rows.back ().addr;
+	  if (last < std::numeric_limits<uint64_t>::max ())
+	    cu_end_excl = last + 1;
+	}
+    }
+
+  /* Group rows by PC, expand distinct (file,line,disc) variants, and emit
+     sample-overlapping ranges into OUT.  */
+  emit_cu_line_ranges (line_rows, cu_end_excl, out.symbols, out.ranges);
+  return true;
+}
+
+/* Merge line, DIE, and metadata thread buffers for one CU.  Metadata is merged
+   first so global function metadata is available to later CU work.  Line-table
+   sample filtering already happened in parse_cu_symbols (via
+   cu_local_functions), not at merge time.  */
+void
+dwarf_reader_impl::merge_cu_parse_symbols (cu_parse_symbols &buf)
+{
+  if (!buf.symbols.empty ())
+    {
+      dwarf_functions_.insert (dwarf_functions_.end (),
+			       std::make_move_iterator (buf.symbols.begin ()),
+			       std::make_move_iterator (buf.symbols.end ()));
+      buf.symbols.clear ();
+    }
+  const size_t cu_begin = address_ranges_.size ();
+  for (address_range_entry &entry : buf.ranges)
+    {
+      if (address_ranges_.size () > cu_begin)
+	{
+	  address_range_entry &prev = address_ranges_.back ();
+	  if (prev.end == entry.start
+	      && source_location_equal (prev.loc, entry.loc)
+	      && same_line_table_coalesce_group (prev, entry))
+	    {
+	      prev.end = entry.end;
+	      prev.line_table_is_stmt
+		= prev.line_table_is_stmt || entry.line_table_is_stmt;
+	      continue;
+	    }
+	}
+      address_ranges_.push_back (std::move (entry));
+    }
+  std::vector<address_range_entry> ().swap (buf.ranges);
+  inline_stack_spans_.insert
+    (inline_stack_spans_.end (),
+     std::make_move_iterator (buf.inline_spans.begin ()),
+     std::make_move_iterator (buf.inline_spans.end ()));
+  buf.inline_spans.clear ();
+}
+
+/* How many threads to walk N_CUS compilation units with.  The configured
+   count, capped so none of them sits idle.  */
+unsigned
+dwarf_reader_impl::dwarf_parse_thread_count (size_t n_cus) const
+{
+  return static_cast<unsigned> (std::min<size_t> (n_cus, parse_threads_));
+}
+
+/* Run BODY on NUM_THREADS workers, giving each its own libdw session since
+   handles are not thread-safe, or running it inline on the reader's session
+   when a single worker is asked for.  False when a worker could not reopen
+   the binary.  The others still finish, as they share one work queue.  */
+bool
+dwarf_reader_impl::for_each_libdw_worker (unsigned num_threads,
+					  const libdw_worker_body &body) const
+{
+  const unsigned sessions = std::min (num_threads, CU_PARSE_MAX_SESSIONS);
+  if (sessions <= 1)
+    {
+      body (dw_.dwarf);
+      return true;
+    }
+
+  std::atomic<bool> session_failed{false};
+  std::vector<std::thread> workers;
+  workers.reserve (sessions);
+  for (unsigned t = 0; t < sessions; ++t)
+    workers.emplace_back ([&] ()
+    {
+      libdw_file_session session;
+      if (!open_libdw_session (binary_path_, session))
+	{
+	  session_failed.store (true, std::memory_order_relaxed);
+	  return;
+	}
+      body (session.dwarf);
+      close_libdw_session (session);
+    });
+  for (std::thread &th : workers)
+    th.join ();
+  return !session_failed.load (std::memory_order_relaxed);
+}
+
+/* Coalesce adjacent line segments that share the same source location.  */
+void
+dwarf_reader_impl::merge_consecutive_address_ranges ()
+{
+  if (address_ranges_.empty ())
+    return;
+
+  size_t last = 0;
+  for (size_t i = 1; i < address_ranges_.size (); ++i)
+    {
+      address_range_entry &prev = address_ranges_[last];
+      const address_range_entry &cur = address_ranges_[i];
+      if (prev.end != cur.start
+	  || !source_location_equal (prev.loc, cur.loc)
+	  || !same_line_table_coalesce_group (prev, cur))
+	{
+	  ++last;
+	  if (last != i)
+	    address_ranges_[last] = std::move (address_ranges_[i]);
+	  continue;
+	}
+      prev.end = cur.end;
+      prev.line_table_is_stmt
+	= prev.line_table_is_stmt || cur.line_table_is_stmt;
+    }
+  address_ranges_.resize (last + 1);
+}
+
+/* Parse profile-touch CUs into per-CU line/die/symbol buffers, then merge.  */
+bool
+dwarf_reader_impl::parse_profile_cus (unsigned num_threads)
+{
+  const size_t n_cus = profile_cu_offs_.size ();
+  std::vector<cu_parse_symbols> partials (n_cus);
+  std::atomic<size_t> next_cu{0};
+
+  /* CUs vary hugely in size, so hand them out one at a time rather than in
+     fixed blocks.  Each lands in its own slot, leaving the merge below in CU
+     order however the workers interleave.  */
+  const bool sessions_opened
+    = for_each_libdw_worker (num_threads, [&] (Dwarf *dwarf)
+      {
+	cu_die_parser parser;
+	for (;;)
+	  {
+	    const size_t i = next_cu.fetch_add (1, std::memory_order_relaxed);
+	    if (i >= n_cus)
+	      break;
+	    parser.reset_for_cu ();
+	    partials[i].parsed = parse_cu_symbols
+	      (dwarf, profile_cu_offs_[i], partials[i], parser);
+	  }
+      });
+  if (!sessions_opened)
+    {
+      fprintf (stderr,
+	       _("Error: failed to open libdw for parallel CU parse\n"));
+      return false;
+    }
+
+  for (size_t i = 0; i < n_cus; ++i)
+    if (!partials[i].parsed)
+      {
+	fprintf (stderr,
+		 _("Error: cannot read DWARF CU at offset 0x%llx in %s\n"),
+		 static_cast<unsigned long long> (profile_cu_offs_[i]),
+		 binary_path_.c_str ());
+	return false;
+      }
+
+  size_t total_ranges = 0;
+  for (const cu_parse_symbols &part : partials)
+    total_ranges += part.ranges.size ();
+  address_ranges_.reserve (address_ranges_.size () + total_ranges);
+  for (cu_parse_symbols &part : partials)
+    merge_cu_parse_symbols (part);
+  return true;
+}
+
+/* Parse the profile-relevant CUs and flatten their line segments into the
+   address-sorted address_ranges_ that every PC lookup searches.  */
+bool
+dwarf_reader_impl::build_address_range_index ()
+{
+  afdo_assert (dw_.dwarf != nullptr && !profile_cu_offs_.empty ());
+
+  const size_t n_cus = profile_cu_offs_.size ();
+  const unsigned num_threads = dwarf_parse_thread_count (n_cus);
+
+  address_ranges_.clear ();
+  if (!parse_profile_cus (num_threads))
+    return false;
+
+  if (address_ranges_.empty ())
+    {
+      fprintf (stderr,
+	       _("Error: no line segments from profile-touch CUs in %s\n"),
+	       binary_path_.c_str ());
+      return false;
+    }
+
+  std::stable_sort (address_ranges_.begin (), address_ranges_.end ());
+  merge_consecutive_address_ranges ();
+  address_range_index_.build (address_ranges_);
+  std::stable_sort (inline_stack_spans_.begin (), inline_stack_spans_.end ());
+  inline_stack_span_index_.build (inline_stack_spans_);
+  mappings_loaded = true;
+  return true;
+}
+
+/* Load correlatable STT_FUNC/.cold/.__part symtab entries.  */
+bool
+dwarf_reader_impl::build_symtab_func_index ()
+{
+  symtab_functions_.clear ();
+  if (elf_version (EV_CURRENT) == EV_NONE)
+    elf_version (EV_CURRENT);
+
+  afdo_assert (dw_.dwarf != nullptr);
+  Elf *const elf = dwarf_getelf (dw_.dwarf);
+  if (elf == nullptr)
+    {
+      fprintf (stderr,
+	       _("Error: cannot access ELF binary %s: %s\n"),
+	       binary_path_.c_str (),
+	       elf_errmsg (-1));
+      return false;
+    }
+  if (elf_kind (elf) != ELF_K_ELF)
+    {
+      fprintf (stderr, _("Error: not an ELF file: %s\n"),
+	       binary_path_.c_str ());
+      return false;
+    }
+
+  std::vector<elf_func_sym> funcs;
+  funcs.reserve (16384);
+  const auto invalid_symtab = [this] ()
+    {
+      fprintf (stderr, _("Error: cannot read ELF symbol table in %s\n"),
+	       binary_path_.c_str ());
+      return false;
+    };
+  Elf_Scn *scn = nullptr;
+  for (;;)
+    {
+      elf_errno ();
+      scn = elf_nextscn (elf, scn);
+      if (scn == nullptr)
+	{
+	  if (elf_errno () != 0)
+	    return invalid_symtab ();
+	  break;
+	}
+      GElf_Shdr shdr;
+      if (gelf_getshdr (scn, &shdr) == nullptr)
+	return invalid_symtab ();
+      if (shdr.sh_type != SHT_SYMTAB)
+	continue;
+      if (shdr.sh_entsize == 0 || shdr.sh_size % shdr.sh_entsize != 0
+	  || shdr.sh_size / shdr.sh_entsize > static_cast<uint64_t> (INT_MAX))
+	return invalid_symtab ();
+
+      Elf_Data *const data = elf_getdata (scn, nullptr);
+      if (data == nullptr)
+	return invalid_symtab ();
+
+      const size_t count = static_cast<size_t> (shdr.sh_size / shdr.sh_entsize);
+      for (size_t i = 0; i < count; ++i)
+	{
+	  GElf_Sym sym;
+	  if (gelf_getsym (data, static_cast<int> (i), &sym) == nullptr)
+	    return invalid_symtab ();
+	  if (sym.st_shndx == SHN_UNDEF)
+	    continue;
+
+	  const char *const raw = elf_strptr (elf, shdr.sh_link, sym.st_name);
+	  if (raw == nullptr)
+	    return invalid_symtab ();
+	  const uint64_t size = static_cast<uint64_t> (sym.st_size);
+	  if (!symtab_accepts_function_symbol (raw, size,
+					       GELF_ST_TYPE (sym.st_info)))
+	    continue;
+
+	  const uint64_t start = static_cast<uint64_t> (sym.st_value);
+	  const uint64_t end = start + size;
+	  if (end <= start)
+	    continue;
+
+	  elf_func_sym row;
+	  row.meta = function_metadata (string_pool_.intern (raw), nullptr,
+					start, end);
+	  row.bind = GELF_ST_BIND (sym.st_info);
+	  funcs.push_back (std::move (row));
+	}
+    }
+  /* Binding an external reference would resolve to.  */
+  const auto bind_pref = [] (unsigned char bind)
+    {
+      return bind == STB_GLOBAL ? 2 : bind == STB_WEAK ? 1 : 0;
+    };
+
+  /* Choose a shared entry owner by strongest binding, then lexicographically
+     first name.
+     That prefers GCC's unsuffixed parent (foo over foo.localalias / foo.isra.0)
+     and is independent of symtab order.  */
+  std::sort (funcs.begin (), funcs.end (),
+	     [&bind_pref] (const elf_func_sym &a, const elf_func_sym &b)
+	     {
+	       if (a.meta.start_addr != b.meta.start_addr)
+		 return a.meta.start_addr < b.meta.start_addr;
+	       const int pa = bind_pref (a.bind);
+	       const int pb = bind_pref (b.bind);
+	       if (pa != pb)
+		 return pa > pb;
+	       const std::string &aname = string_value (a.meta.name);
+	       const std::string &bname = string_value (b.meta.name);
+	       if (aname != bname)
+		 return aname < bname;
+	       return a.meta.end_addr > b.meta.end_addr;
+	     });
+
+  /* Keep one owner per entry and retain the other names as aliases.  */
+  symtab_aliases_.clear ();
+  for (size_t i = 0; i < funcs.size ();)
+    {
+      const uint64_t start = funcs[i].meta.start_addr;
+      const size_t owner = symtab_functions_.size ();
+      symtab_functions_.push_back (std::move (funcs[i].meta));
+      ++i;
+      while (i < funcs.size () && funcs[i].meta.start_addr == start)
+	{
+	  /* Cover the largest range when aliases have different sizes.  */
+	  symtab_functions_[owner].end_addr
+	    = std::max (symtab_functions_[owner].end_addr,
+			funcs[i].meta.end_addr);
+	  if (funcs[i].meta.name != symtab_functions_[owner].name)
+	    symtab_aliases_.push_back ({std::move (funcs[i].meta), owner});
+	  ++i;
+	}
+    }
+
+  build_symtab_name_equivalence_index ();
+  return true;
+}
+
+/* Fill in the declaring file and line of every exported symtab function and
+   alias.  */
+void
+dwarf_reader_impl::resolve_touch_symtab_export_anchors ()
+{
+  correlate_session session (this);
+  for (function_metadata &sym : symtab_functions_)
+    resolve_symtab_export_anchor (sym, session);
+  for (function_alias_metadata &alias : symtab_aliases_)
+    resolve_symtab_export_anchor (alias.function, session);
+}
+
+/* Give SYM the declaring file and line it will be keyed by in the profile.  */
+void
+dwarf_reader_impl::resolve_symtab_export_anchor
+  (function_metadata &sym, correlate_session &session)
+{
+  if (sym.end_addr <= sym.start_addr)
+    return;
+
+  /* Unsampled symbols still get an empty profile, so they need a file to
+     stay distinct from a same-named static in another TU.  */
+  const bool sampled = range_overlaps_sampled (sym.start_addr, sym.end_addr);
+  source_location root;
+  if ((string_empty (sym.file_path) || (sampled && sym.start_line == 0))
+      && function_profile_root (sym, root))
+    {
+      if (string_empty (sym.file_path) && !string_empty (root.file_path))
+	sym.file_path = root.file_path;
+      if (sampled && sym.start_line == 0)
+	sym.start_line = root.line_number;
+    }
+
+  /* Entry-line symbolize is only worth its cost where samples land.  */
+  if (!sampled || sym.start_line != 0)
+    return;
+
+  /* Fall back to symbolizing the entry PC.  */
+  const correlate_symbolize_entry *const result
+    = symbolize (sym.start_addr, session, sym);
+  if (result != nullptr && !result->locations.empty ())
+    sym.start_line = result->locations[0].line_number;
+}
+
+/* Index the DWARF definitions and alias identities by name for lookup.  */
+void
+dwarf_reader_impl::build_dwarf_name_indexes ()
+{
+  dwarf_func_name_index_.clear ();
+  for (size_t i = 0; i < dwarf_functions_.size (); ++i)
+    {
+      const function_metadata &func = dwarf_functions_[i];
+      dwarf_func_name_index_[func.name].push_back (i);
+      const std::string base
+	= gcc_symbol::symbol_base_name (string_value (func.name));
+      if (base != string_value (func.name))
+	dwarf_func_name_index_[string_pool_.intern (base)].push_back (i);
+    }
+
+  dwarf_alias_name_index_.clear ();
+  for (size_t i = 0; i < dwarf_alias_identities_.size (); ++i)
+    {
+      const function_metadata &func = dwarf_alias_identities_[i];
+      dwarf_alias_name_index_[func.name].push_back (i);
+      const std::string base
+	= gcc_symbol::symbol_base_name (string_value (func.name));
+      if (base != string_value (func.name))
+	dwarf_alias_name_index_[string_pool_.intern (base)].push_back (i);
+    }
+}
+
+/* Index symtab functions under both their mangled and base names, so an ICF
+   alias and its primary resolve to the same entry.  */
+void
+dwarf_reader_impl::build_symtab_name_equivalence_index ()
+{
+  symtab_equiv_index_.clear ();
+  symtab_equiv_index_.reserve (symtab_functions_.size () * 2);
+
+  const auto add_key = [this] (interned_string key, size_t i)
+    {
+      auto &vec = symtab_equiv_index_[key];
+      if (vec.empty () || vec.back () != i)
+	vec.push_back (i);
+    };
+  const auto add_name = [this, &add_key] (interned_string name, size_t i)
+    {
+      add_key (name, i);
+      const std::string base
+	= gcc_symbol::symbol_base_name (string_value (name));
+      if (base != string_value (name))
+	add_key (string_pool_.intern (base), i);
+    };
+
+  for (size_t i = 0; i < symtab_functions_.size (); ++i)
+    add_name (symtab_functions_[i].name, i);
+  for (const function_alias_metadata &alias : symtab_aliases_)
+    add_name (alias.function.name, alias.primary_index);
+}
+
+/* Source location of ADDRESS from the line table alone.  Prefer a row at
+   ADDRESS, then the latest range start, primary row and later row.  Return
+   false when no segment covers ADDRESS.  */
+bool
+dwarf_reader_impl::lookup_primary_source_location_at_address
+  (uint64_t address, source_location &out) const
+{
+  afdo_assert (mappings_loaded);
+  afdo_assert (!address_ranges_.empty ());
+
+  const address_range_entry *best = nullptr;
+  address_range_index_.visit_overlapping
+    (address, address + 1, [&] (const address_range_entry &entry)
+    {
+      if (best != nullptr)
+	{
+	  const bool exact = entry.line_table_pc == address;
+	  const bool best_exact = best->line_table_pc == address;
+	  if (exact != best_exact)
+	    {
+	      if (!exact)
+		return;
+	    }
+	  else if (entry.start != best->start)
+	    {
+	      if (entry.start < best->start)
+		return;
+	    }
+	  else if (entry.line_table_primary != best->line_table_primary)
+	    {
+	      if (!entry.line_table_primary)
+		return;
+	    }
+	  else if (entry.line_row_seq <= best->line_row_seq)
+	    return;
+	}
+      best = &entry;
+    });
+  if (best == nullptr)
+    return false;
+  out = best->loc;
+  return true;
+}
+
+dwarf_reader::dwarf_reader (std::string binary_path,
+			    pc_range_list sampled_ranges)
+  : impl_ (std::make_unique<dwarf_reader_impl> (
+    std::move (binary_path), std::move (sampled_ranges)))
+{}
+
+dwarf_reader::~dwarf_reader () = default;
+
+void
+dwarf_reader::set_parse_threads (unsigned n)
+{
+  impl_->set_parse_threads (n);
+}
+
+bool
+dwarf_reader::load ()
+{
+  return impl_->load ();
+}
+
+const dwarf_load_summary &
+dwarf_reader::load_summary () const
+{
+  return impl_->load_summary ();
+}
+
+correlate_session
+dwarf_reader::make_correlate_session () const
+{
+  return correlate_session (impl_.get ());
+}
+
+const std::vector<function_metadata> &
+dwarf_reader::symtab_functions () const
+{
+  return impl_->symtab_functions ();
+}
+
+const std::vector<function_alias_metadata> &
+dwarf_reader::symtab_aliases () const
+{
+  return impl_->symtab_aliases ();
+}
+
+const function_metadata *
+dwarf_reader::containing_function_at_pc (uint64_t address) const
+{
+  return function_containing_address (impl_->symtab_functions (), address);
+}
+
+const function_metadata *
+dwarf_reader::function_at_entry_pc (uint64_t address) const
+{
+  return dwarf_debug::function_at_entry_pc (impl_->symtab_functions (),
+					   address);
+}
+
+const correlate_symbolize_entry *
+dwarf_reader::symbolize (uint64_t pc, correlate_session &session,
+			 const function_metadata &containing_function) const
+{
+  return impl_->symbolize (pc, session, containing_function);
+}
+
+void
+dwarf_reader::collect_line_span_seed_pcs (uint64_t start, uint64_t end,
+					  std::vector<uint64_t> &out) const
+{
+  impl_->collect_line_span_seed_pcs (start, end, out);
+}
+
+source_location
+dwarf_reader::resolve_inline_frame_decl_location
+  (const inline_frame &frame, const std::string &caller_file) const
+{
+  return impl_->resolve_inline_frame_decl_location (frame, caller_file);
+}
+
+} /* namespace dwarf_debug.  */
