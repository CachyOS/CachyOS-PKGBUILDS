+#include "autofdo_correlate_detail.h"
+
+#include "autofdo_options.h"
+#include "function_metadata_util.h"
+#include "symbol_util.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace autofdo {
+namespace correlate_detail {
+namespace {
+
+constexpr uint64_t MIN_SAMPLES_FOR_GCOV_EMIT = 10;
+
+using func_map_key = const dwarf_debug::function_metadata *;
+using func_maps_type
+  = std::unordered_map<func_map_key, per_function_profile_maps>;
+using entry_edge_count_by_addr = std::unordered_map<uint64_t, uint64_t>;
+
+struct function_emit_group_key
+{
+  std::string parent_name;
+  std::string file_path;
+  uint64_t fallback_addr = 0;
+
+  bool operator== (const function_emit_group_key &o) const noexcept
+  {
+    return parent_name == o.parent_name && file_path == o.file_path
+	   && fallback_addr == o.fallback_addr;
+  }
+};
+
+struct function_emit_group_hash
+{
+  size_t operator() (const function_emit_group_key &key) const noexcept
+  {
+    size_t h = std::hash<std::string>{}(key.parent_name);
+    hash_combine (h, std::hash<std::string>{}(key.file_path));
+    hash_combine (h, std::hash<uint64_t>{}(key.fallback_addr));
+    return h;
+  }
+};
+
+uint64_t
+gcov_should_emit_threshold (double sample_threshold_frac,
+			    uint64_t total_profile_mass)
+{
+  uint64_t threshold = static_cast<uint64_t> (
+    sample_threshold_frac * static_cast<double> (total_profile_mass));
+  if (threshold < MIN_SAMPLES_FOR_GCOV_EMIT)
+    threshold = MIN_SAMPLES_FOR_GCOV_EMIT;
+  return threshold;
+}
+
+uint64_t
+profile_total_mass_for_emit_threshold (const perf_data::profile_reader &profile)
+{
+  const auto *ranges = profile.range_counts ();
+  if (ranges != nullptr)
+    return perf_data::total_mass_from_range_counts (*ranges);
+  uint64_t total = 0;
+  for (const auto &entry : profile.get_address_frequencies ())
+    total += entry.second;
+  return total;
+}
+
+bool
+gcov_should_emit_mass (uint64_t func_mass, uint64_t emit_threshold)
+{
+  return func_mass > emit_threshold;
+}
+
+bool
+branch_stack_range_bounds (const perf_data::branch_stack_edge_count_map &ranges,
+			   uint64_t &min_addr, uint64_t &max_addr)
+{
+  min_addr = std::numeric_limits<uint64_t>::max ();
+  max_addr = 0;
+  for (const auto &entry : ranges)
+    {
+      const perf_data::branch_stack_edge &range = entry.first;
+      if (entry.second == 0 || range.second < range.first)
+	continue;
+      min_addr = std::min (min_addr, range.first);
+      max_addr = std::max (max_addr, range.second);
+    }
+  return min_addr <= max_addr;
+}
+
+bool
+clip_branch_stack_range (const perf_data::branch_stack_edge &range,
+			 uint64_t count, uint64_t min_addr, uint64_t max_addr,
+			 uint64_t &lo, uint64_t &hi)
+{
+  if (count == 0 || range.second < range.first)
+    return false;
+  lo = std::max (range.first, min_addr);
+  hi = std::min (range.second, max_addr);
+  return hi >= lo;
+}
+
+void
+for_each_mass_pc_in_span (const perf_data::branch_stack_edge_count_map &ranges,
+			  unsigned addr_step, uint64_t min_addr,
+			  uint64_t max_addr, const range_mass_visitor &visitor)
+{
+  const uint64_t span = max_addr - min_addr + 1;
+  if (addr_step == 1)
+    {
+      std::vector<uint64_t> diff (span + 1, 0);
+      for (const auto &entry : ranges)
+	{
+	  uint64_t lo = 0;
+	  uint64_t hi = 0;
+	  if (!clip_branch_stack_range (
+		entry.first, entry.second, min_addr, max_addr, lo, hi))
+	    continue;
+	  diff[lo - min_addr] += entry.second;
+	  diff[hi - min_addr + 1] -= entry.second;
+	}
+      uint64_t running = 0;
+      for (uint64_t off = 0; off < span; ++off)
+	{
+	  running += diff[off];
+	  if (running != 0)
+	    visitor (min_addr + off, running);
+	}
+      return;
+    }
+
+  std::vector<uint64_t> mass (span, 0);
+  for (const auto &entry : ranges)
+    {
+      uint64_t lo = 0;
+      uint64_t hi = 0;
+      if (!clip_branch_stack_range (
+	    entry.first, entry.second, min_addr, max_addr, lo, hi))
+	continue;
+      for (uint64_t addr = lo;; addr += addr_step)
+	{
+	  mass[addr - min_addr] += entry.second;
+	  if (hi - addr < addr_step)
+	    break;
+	}
+    }
+  for (uint64_t off = 0; off < span; off += addr_step)
+    if (mass[off] != 0)
+      visitor (min_addr + off, mass[off]);
+}
+
+void
+collect_target_line_span_anchors (dwarf_debug::dwarf_reader &dw,
+				  correlate_target &target)
+{
+  uint64_t min_addr = 0;
+  uint64_t max_addr = 0;
+  if (branch_stack_range_bounds (
+	target.maps.range_count_map, min_addr, max_addr))
+    dw.collect_line_span_seed_pcs (
+      min_addr, max_addr + 1, target.line_span_anchor_pcs);
+  else
+    dw.collect_line_span_seed_pcs (
+      target.start_addr, target.end_addr, target.line_span_anchor_pcs);
+}
+
+function_emit_group_key
+function_emit_group (const dwarf_debug::function_metadata &func)
+{
+  return {gcc_symbol::symbol_split_part_parent (
+	    dwarf_debug::string_value (func.name)),
+	  dwarf_debug::string_value (func.file_path),
+	  dwarf_debug::string_empty (func.file_path) ? func.start_addr : 0};
+}
+
+bool
+per_function_maps_have_samples (const per_function_profile_maps &maps,
+				bool use_branch_stack)
+{
+  if (maps.end_addr <= maps.start_addr)
+    return false;
+  if (!maps.addr_counts.empty () || !maps.branch_count_map.empty ())
+    return true;
+  return use_branch_stack && !maps.range_count_map.empty ();
+}
+
+per_function_profile_maps &
+get_or_create_function_maps (func_maps_type &func_maps,
+			     const dwarf_debug::function_metadata &func)
+{
+  auto it = func_maps.find (&func);
+  if (it != func_maps.end ())
+    return it->second;
+  auto inserted = func_maps.emplace (&func, per_function_profile_maps ());
+  inserted.first->second.start_addr = func.start_addr;
+  inserted.first->second.end_addr = func.end_addr;
+  return inserted.first->second;
+}
+
+uint64_t
+per_function_profile_mass (const per_function_profile_maps &maps)
+{
+  if (!maps.range_count_map.empty ())
+    {
+      uint64_t total = 0;
+      for (const auto &entry : maps.range_count_map)
+	{
+	  const perf_data::branch_stack_edge &range = entry.first;
+	  if (range.second >= range.first)
+	    total += entry.second * (range.second - range.first + 1);
+	}
+      return total;
+    }
+  uint64_t total = 0;
+  for (const auto &entry : maps.addr_counts)
+    total += entry.second;
+  return total;
+}
+
+void
+merge_branch_counts (perf_data::branch_stack_edge_count_map &dst,
+		     const perf_data::branch_stack_edge_count_map &src)
+{
+  for (const auto &entry : src)
+    dst[entry.first] += entry.second;
+}
+
+void
+assign_branch_edges_to_functions (
+  const std::vector<dwarf_debug::function_metadata> &symtab_functions,
+  const std::vector<perf_data::profile_branch> &branches, size_t begin,
+  size_t end, func_maps_type &func_maps,
+  entry_edge_count_by_addr &entry_edge_counts)
+{
+  size_t symtab_sweep_index = 0;
+  uint64_t last_from = 0;
+  const dwarf_debug::function_metadata *func = nullptr;
+  for (size_t i = begin; i < end; ++i)
+    {
+      const perf_data::profile_branch &row = branches[i];
+      if (i == begin || row.from != last_from)
+	{
+	  last_from = row.from;
+	  func = dwarf_debug::function_containing_address (
+	    symtab_functions, row.from, symtab_sweep_index);
+	}
+      if (func == nullptr)
+	continue;
+      get_or_create_function_maps (func_maps, *func)
+	.branch_count_map[{row.from, row.to}]
+	+= row.count;
+      const dwarf_debug::function_metadata *callee
+	= dwarf_debug::function_at_entry_pc (symtab_functions, row.to);
+      if (callee != nullptr)
+	entry_edge_counts[callee->start_addr] += row.count;
+    }
+}
+
+void
+assign_range_to_functions (
+  const std::vector<dwarf_debug::function_metadata> &symtab, uint64_t begin,
+  uint64_t end, uint64_t count, func_maps_type &func_maps,
+  size_t &symtab_sweep_index)
+{
+  uint64_t cursor = begin;
+  while (cursor <= end)
+    {
+      const dwarf_debug::function_metadata *func
+	= dwarf_debug::function_containing_address (
+	  symtab, cursor, symtab_sweep_index);
+      if (func == nullptr)
+	{
+	  size_t next = symtab_sweep_index;
+	  while (next < symtab.size ()
+		 && symtab[next].start_addr <= cursor)
+	    ++next;
+	  if (next == symtab.size () || symtab[next].start_addr > end)
+	    return;
+	  symtab_sweep_index = next;
+	  cursor = symtab[next].start_addr;
+	  continue;
+	}
+      uint64_t segment_end = std::min (end, func->end_addr - 1);
+      size_t next = static_cast<size_t> (func - symtab.data ()) + 1;
+      while (next < symtab.size ()
+	     && symtab[next].start_addr <= cursor)
+	++next;
+      if (next < symtab.size ()
+	  && symtab[next].start_addr <= segment_end)
+	segment_end = symtab[next].start_addr - 1;
+      get_or_create_function_maps (func_maps, *func)
+	.range_count_map[{cursor, segment_end}]
+	+= count;
+      cursor = segment_end + 1;
+    }
+}
+
+unsigned
+bounded_worker_count (unsigned configured, size_t task_limit)
+{
+  unsigned count = configured == 0 ? DEFAULT_CORRELATE_THREADS : configured;
+  if (task_limit > 0 && task_limit < count)
+    count = static_cast<unsigned> (task_limit);
+  return std::max (1u, count);
+}
+
+} /* anonymous namespace.  */
+
+void
+for_each_branch_stack_mass_pc (
+  const perf_data::branch_stack_edge_count_map &ranges, unsigned addr_step,
+  const range_mass_visitor &visitor)
+{
+  uint64_t min_addr = 0;
+  uint64_t max_addr = 0;
+  if (!branch_stack_range_bounds (ranges, min_addr, max_addr))
+    return;
+  const uint64_t span = max_addr - min_addr + 1;
+  if (span > DENSE_ADDR_MASS_MAX_SPAN)
+    {
+      const uint64_t window = DENSE_ADDR_MASS_MAX_SPAN;
+      for (uint64_t start = min_addr; start <= max_addr; start += window)
+	{
+	  const uint64_t end = std::min (start + window - 1, max_addr);
+	  for_each_mass_pc_in_span (ranges, addr_step, start, end, visitor);
+	}
+      return;
+    }
+  for_each_mass_pc_in_span (ranges, addr_step, min_addr, max_addr, visitor);
+}
+
+size_t
+estimate_correlate_target_work (const correlate_target &target,
+				unsigned addr_step)
+{
+  size_t work = target.maps.branch_count_map.size ()
+		+ target.maps.addr_counts.size ()
+		+ target.line_span_anchor_pcs.size ();
+  for (const auto &entry : target.maps.range_count_map)
+    {
+      const perf_data::branch_stack_edge &range = entry.first;
+      if (entry.second != 0 && range.second >= range.first)
+	work
+	  += static_cast<size_t> ((range.second - range.first) / addr_step + 1);
+    }
+  return work;
+}
+
+void
+materialize_correlate_targets (correlate_context &ctx, profile_builder &profile)
+{
+  const std::vector<dwarf_debug::function_metadata> &symtab
+    = ctx.reader.symtab_functions ();
+  profile.reserve_profiles (ctx.targets.size ());
+  ctx.emitted_hot_symbols.reserve (ctx.targets.size ());
+  for (correlate_target &target : ctx.targets)
+    {
+      ctx.emitted_hot_symbols.insert ({target.func_name, target.start_addr});
+      target.func_profile = &profile.get_or_create_function_profile (
+	dwarf_debug::string_value (target.func_name), target.start_addr);
+      profile.init_function_builder (
+	*target.func_profile, symtab[target.symtab_index]);
+      target.func_profile->builder->add_incoming_entry_count (
+	target.maps.incoming_entry_count);
+      collect_target_line_span_anchors (ctx.reader, target);
+    }
+}
+
+bool
+bucket_and_select_targets (correlate_context &ctx,
+			   const perf_data::profile_reader &perf,
+			   const profiler_run_options &run_opts)
+{
+  const std::vector<dwarf_debug::function_metadata> &symtab
+    = ctx.reader.symtab_functions ();
+  if (symtab.empty ())
+    {
+      fprintf (stderr, "Error: correlate failed ? no ELF symtab functions\n");
+      return false;
+    }
+
+  const bool use_branch_stack = run_opts.use_branch_stack;
+  const uint64_t emit_threshold
+    = gcov_should_emit_threshold (run_opts.sample_threshold_frac,
+				  profile_total_mass_for_emit_threshold (perf));
+  func_maps_type func_maps;
+  if (use_branch_stack)
+    if (const auto *ranges = perf.range_counts ())
+      {
+	size_t sweep_index = 0;
+	for (const perf_data::profile_range &row : *ranges)
+	  assign_range_to_functions (
+	    symtab, row.beg, row.end, row.count, func_maps, sweep_index);
+      }
+
+  entry_edge_count_by_addr entry_edge_counts;
+  const auto *branches = perf.branch_counts ();
+  if (branches != nullptr && !branches->empty ())
+    {
+      const size_t count = branches->size ();
+      const size_t workers
+	= bounded_worker_count (run_opts.correlate_threads, count);
+      if (workers <= 1 || count < 4096)
+	assign_branch_edges_to_functions (
+	  symtab, *branches, 0, count, func_maps, entry_edge_counts);
+      else
+	{
+	  const size_t chunk = (count + workers - 1) / workers;
+	  std::vector<func_maps_type> partials (workers);
+	  std::vector<entry_edge_count_by_addr> edge_partials (workers);
+	  std::vector<std::thread> threads;
+	  threads.reserve (workers);
+	  for (size_t i = 0; i < workers; ++i)
+	    {
+	      const size_t begin = i * chunk;
+	      if (begin >= count)
+		break;
+	      const size_t end = std::min (count, begin + chunk);
+	      threads.emplace_back (
+		[&symtab, branches, &partials, &edge_partials, i, begin, end] {
+		  assign_branch_edges_to_functions (symtab,
+						    *branches,
+						    begin,
+						    end,
+						    partials[i],
+						    edge_partials[i]);
+		});
+	    }
+	  for (std::thread &thread : threads)
+	    thread.join ();
+	  for (const func_maps_type &part : partials)
+	    for (const auto &entry : part)
+	      merge_branch_counts (
+		get_or_create_function_maps (func_maps, *entry.first)
+		  .branch_count_map,
+		entry.second.branch_count_map);
+	  for (const entry_edge_count_by_addr &part : edge_partials)
+	    for (const auto &entry : part)
+	      entry_edge_counts[entry.first] += entry.second;
+	}
+    }
+
+  if (!use_branch_stack || perf.range_counts () == nullptr)
+    for (const auto &entry : perf.get_address_frequencies ())
+      {
+	const dwarf_debug::function_metadata *func
+	  = dwarf_debug::function_containing_address (symtab, entry.first);
+	if (func != nullptr)
+	  get_or_create_function_maps (func_maps, *func)
+	    .addr_counts[entry.first]
+	    += entry.second;
+      }
+
+  if (!perf.has_sample_mass ())
+    {
+      fprintf (
+	stderr, "Error: correlate failed ? perf profile has no sample mass\n");
+      return false;
+    }
+
+  std::unordered_map<func_map_key, function_emit_group_key> group_by_func;
+  std::
+    unordered_map<function_emit_group_key, uint64_t, function_emit_group_hash>
+      group_mass;
+  group_by_func.reserve (func_maps.size ());
+  group_mass.reserve (func_maps.size ());
+  for (const auto &entry : func_maps)
+    {
+      const function_emit_group_key key = function_emit_group (*entry.first);
+      group_by_func.emplace (entry.first, key);
+      group_mass[key] += per_function_profile_mass (entry.second);
+    }
+
+  std::unordered_set<function_emit_group_key, function_emit_group_hash>
+    emitted_groups;
+  for (const auto &entry : group_mass)
+    if (gcov_should_emit_mass (entry.second, emit_threshold))
+      emitted_groups.insert (entry.first);
+
+  for (auto &entry : func_maps)
+    {
+      const dwarf_debug::function_metadata *func = entry.first;
+      if (emitted_groups.count (group_by_func.find (func)->second) == 0)
+	continue;
+      const auto edge = entry_edge_counts.find (func->start_addr);
+      if (edge != entry_edge_counts.end ())
+	entry.second.incoming_entry_count = edge->second;
+    }
+
+  ctx.targets.reserve (func_maps.size ());
+  for (auto &entry : func_maps)
+    {
+      const dwarf_debug::function_metadata *func = entry.first;
+      per_function_profile_maps &maps = entry.second;
+      if (!per_function_maps_have_samples (maps, use_branch_stack)
+	  || emitted_groups.count (group_by_func.find (func)->second) == 0)
+	continue;
+      const size_t symtab_index
+	= dwarf_debug::function_index_from_ptr (func, symtab);
+      if (symtab_index == NO_SYMTAB_INDEX)
+	continue;
+      correlate_target target;
+      target.func_name = func->name;
+      target.start_addr = maps.start_addr;
+      target.end_addr = maps.end_addr;
+      target.symtab_index = symtab_index;
+      target.maps = std::move (maps);
+      ctx.targets.push_back (std::move (target));
+    }
+
+  if (ctx.targets.empty ())
+    {
+      fprintf (stderr,
+	       "Error: correlate failed ? no functions above emit threshold\n");
+      return false;
+    }
+  ctx.num_threads
+    = bounded_worker_count (run_opts.correlate_threads, ctx.targets.size ());
+  return true;
+}
+
+} /* namespace correlate_detail.  */
+} /* namespace autofdo.  */
