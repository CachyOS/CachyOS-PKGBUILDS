+/* Rebuild a per-TU string table (index -> string) from a serialized
+   path-compressed trie, read in preorder.  TABLE is pre-sized by the caller to
+   the section's declared string count.  The ids are consecutive, so a terminal
+   id at or past that size means the section is corrupt.  The walk keeps its
+   own stack because the trie is as deep as its longest string.  */
+void
+deserialize_trie (const uint8_t *&cur, const uint8_t *end,
+		  std::vector<std::string> &table)
+{
+  /* Prefix of each open node and how many of its children are unread.  */
+  std::vector<std::pair<std::string, uint8_t>> open;
+  std::string prefix;
+  for (;;)
+    {
+      const uint8_t flags = read_int8 (cur, end);
+      const bool is_terminal = (flags >> 7) & 1;
+      const uint8_t num_children = flags & 0x7F;
+
+      if (is_terminal)
+	{
+	  const uint32_t tid = read_int32 (cur, end);
+	  if (tid >= table.size ())
+	    {
+	      v4::set_decode_error ("v4: trie terminal id past string count");
+	      return;
+	    }
+	  table[tid] = prefix;
+	}
+      open.emplace_back (std::move (prefix), num_children);
+
+      while (!open.empty () && open.back ().second == 0)
+	open.pop_back ();
+      if (open.empty () || v4::decode_failed ())
+	return;
+      --open.back ().second;
+      const uint16_t label_len = read_int16 (cur, end);
+      if (!COUNT_FITS_IN_BUFFER (cur, end, label_len, 1))
+	{
+	  v4::set_decode_error ("v4: trie edge label past end");
+	  return;
+	}
+      prefix = open.back ().first;
+      prefix.append (reinterpret_cast<const char *> (cur), label_len);
+      cur += label_len;
+    }
