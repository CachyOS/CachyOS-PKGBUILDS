+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_HASH_UTIL_H
+#define GCC_HASH_UTIL_H
+
+#include <cstddef>
+
+namespace autofdo {
+
+/* Mix VALUE into SEED (the Boost hash_combine mixing step).  */
+template <typename T>
+void
+hash_combine (size_t &seed, T value) noexcept
+{
+  seed ^= static_cast<size_t> (value)
+	  + static_cast<size_t> (0x9e3779b97f4a7c15ULL) + (seed << 6)
+	  + (seed >> 2);
+}
+
+} /* namespace autofdo.  */
+
+#endif /* GCC_HASH_UTIL_H.  */
