+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_reader.h"
+#include "gcov.h"
+#include "gcov_io.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace gcov {
+
+gcov_reader_base::gcov_reader_base (const std::string &path_) : path (path_) {}
+
+gcov_reader_base::~gcov_reader_base () {}
+
+/* Sniff a profile's format from its leading bytes (shared by afdo_dump /
+   afdo_merge to pick a reader).  */
+profile_format
+detect_format (const std::string &path)
+{
+  /* Only the leading v3 magic word is needed; do not map the whole file.  */
+  uint32_t magic = 0;
+  FILE *f = fopen (path.c_str (), "rb");
+  if (f == nullptr)
+    return profile_format::unknown;
+  const bool have_magic
+    = fread (&magic, 1, sizeof (magic), f) == sizeof (magic);
+  fclose (f);
+  if (have_magic && magic == v3::format::GCOV_DATA_MAGIC)
+    return profile_format::v3_binary;
+  return profile_format::unknown;
+}
+
+std::unique_ptr<gcov_reader_base>
+make_gcov_reader (const std::string &path)
+{
+  if (detect_format (path) == profile_format::v3_binary)
+    return std::make_unique<gcov_reader_v3> (path);
+  return nullptr;
+}
+
+} /* namespace gcov.  */
