+  [AC_MSG_ERROR([cannot determine host byte order for afdo-tools])],
+  [AC_MSG_ERROR([afdo-tools requires a little-endian host])])
+
+dnl Profiles and perf.data hold 64-bit addresses and file offsets, and the
+dnl tools map whole profiles into memory.  Do not cater for a 32-bit host.
+AC_CHECK_SIZEOF([void *])
+if test "$ac_cv_sizeof_void_p" != 8; then
+  AC_MSG_ERROR([afdo-tools requires a 64-bit host])
+fi
+
+AC_MSG_CHECKING([for a usable perf_event_open system call number])
+AC_COMPILE_IFELSE(
+  [AC_LANG_PROGRAM([[
+#include <sys/syscall.h>
+#if !defined(__NR_perf_event_open) \
+    && !defined(__x86_64__) && !defined(__aarch64__)
+# error "perf_event_open system call number is unavailable"
+#endif
+  ]], [[]])],
+  [AC_MSG_RESULT([yes])],
+  [AC_MSG_ERROR([afdo-tools requires perf_event_open support])])
+
+dnl Check the oldest perf declarations used directly.  Newer perf.data bits
+dnl are defined locally so builds with older headers can still decode them.
+AC_MSG_CHECKING([whether linux/perf_event.h provides the required perf ABI])
+AC_COMPILE_IFELSE(
+  [AC_LANG_PROGRAM([[
+#include <linux/perf_event.h>
+  ]], [[
+    perf_event_attr attr = {};
+    perf_event_mmap_page page = {};
+    unsigned long long x = PERF_SAMPLE_PHYS_ADDR
+      | PERF_SAMPLE_BRANCH_CALL | PERF_AUX_FLAG_COLLISION
+      | PERF_RECORD_NAMESPACES;
+    return x == attr.sample_regs_intr + page.data_size;
+  ]])],
+  [AC_MSG_RESULT([yes])],
+  [AC_MSG_RESULT([no])
+   AC_MSG_ERROR([afdo-tools requires a compatible linux/perf_event.h])])
+
+ZW_GNU_GETTEXT_SISTER_DIR
+
+AH_BOTTOM([
+#ifndef AFDO_I18N_CONFIGURED
+#define AFDO_I18N_CONFIGURED
+#ifdef ENABLE_NLS
+# include <libintl.h>
+# include <locale.h>
+# ifndef _
+#  define _(msgid) gettext (msgid)
+# endif
+static inline void
+afdo_init_libintl (void)
+{
+  setlocale (LC_ALL, "");
+  (void) bindtextdomain ("gcc", LOCALEDIR);
+  (void) textdomain ("gcc");
+}
+#else
+# ifndef _
+#  define _(msgid) (msgid)
+# endif
+# define afdo_init_libintl() ((void) 0)
+#endif
+#endif
+])
+
+save_LIBS="$LIBS"
+AC_SEARCH_LIBS([pthread_create], [pthread], [],
+            [AC_MSG_ERROR([afdo-tools requires pthreads])])
+AC_CHECK_LIB([z], [compress], [],
+             [AC_MSG_ERROR([afdo-tools requires zlib])])
+AC_CHECK_LIB([elf], [elf_begin], [],
+             [AC_MSG_ERROR([afdo-tools requires libelf])])
+AC_CHECK_LIB([dw], [dwarf_begin], [],
+             [AC_MSG_ERROR([afdo-tools requires libdw])])
+AFDO_TOOLS_LIBS="$LIBS"
+LIBS="$save_LIBS"
+AC_SUBST(AFDO_TOOLS_LIBS)
+
+AC_CONFIG_FILES([Makefile version.h])
+AC_OUTPUT
