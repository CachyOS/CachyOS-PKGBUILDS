new file mode 100644
index 00000000000..e70a5215229
--- /dev/null
+++ b/afdo_tools/src/perf_spe_reader.cc
@@ -0,0 +1,320 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "perf_spe_reader.h"
+
+#include "arm_spe_aux_decode.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <unordered_map>
+#include <vector>
+
+namespace perf_data {
+namespace {
+
+/* Prefer synthesized range mass; else not-taken / SAMPLE PC mass.  */
+uint64_t
+spe_profile_total_mass (
+  const branch_stack_edge_count_map &range_count_map,
+  const std::unordered_map<uint64_t, uint64_t> &address_frequencies)
+{
+  const uint64_t from_ranges
+    = total_mass_from_runtime_range_map (range_count_map);
+  if (from_ranges != 0)
+    return from_ranges;
+  return total_mass_from_address_frequencies (address_frequencies);
+}
+
+void
+translate_pc_counts_to_dwarf (
+  const std::unordered_map<uint64_t, uint64_t> &runtime_counts,
+  const std::vector<simple_mmap> &mmaps,
+  std::unordered_map<uint64_t, uint64_t> *dwarf_counts)
+{
+  dwarf_counts->clear ();
+  dwarf_counts->reserve (runtime_counts.size ());
+  for (const auto &entry : runtime_counts)
+    {
+      uint64_t off = 0;
+      if (!try_translate_runtime_with_mmaps (mmaps, entry.first, &off))
+	continue;
+      (*dwarf_counts)[off] += entry.second;
+    }
+}
+
+void
+translate_edges_to_dwarf (const branch_stack_edge_count_map &runtime_edges,
+			  const std::vector<simple_mmap> &mmaps,
+			  branch_stack_edge_count_map *dwarf_edges)
+{
+  dwarf_edges->clear ();
+  dwarf_edges->reserve (runtime_edges.size ());
+  for (const auto &entry : runtime_edges)
+    {
+      uint64_t from = 0;
+      uint64_t to = 0;
+      if (!try_translate_runtime_with_mmaps (mmaps, entry.first.first, &from)
+	  || !try_translate_runtime_with_mmaps (mmaps, entry.first.second, &to))
+	continue;
+      (*dwarf_edges)[{from, to}] += entry.second;
+    }
+}
+
+/* AUXTRACE payload after the descriptor; empty tail is ok.  */
+bool
+spe_auxtrace_tail (const perf_event_header &hdr, const uint8_t *payload,
+		   size_t skip, const uint8_t *file_base, size_t file_size,
+		   const uint8_t **tail_out, size_t *tail_size_out)
+{
+  if (payload == nullptr || file_base == nullptr || tail_out == nullptr
+      || tail_size_out == nullptr || skip < hdr.size)
+    return false;
+
+  const size_t tail = skip - hdr.size;
+  if (payload < file_base)
+    return false;
+  const size_t payload_offset = static_cast<size_t> (payload - file_base);
+  if (payload_offset > file_size || payload_offset < sizeof (perf_event_header))
+    return false;
+  const size_t record_offset = payload_offset - sizeof (perf_event_header);
+  if (hdr.size > file_size - record_offset)
+    return false;
+  const size_t tail_offset = record_offset + hdr.size;
+  if (tail > file_size - tail_offset)
+    return false;
+
+  *tail_out = file_base + tail_offset;
+  *tail_size_out = tail;
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+perf_spe_reader::perf_spe_reader (const std::string &_perf_data_path,
+				  const std::string &_binary_path)
+  : perf_file_reader (_perf_data_path, _binary_path)
+{}
+
+void
+perf_spe_reader::materialize_address_frequencies_for_per_pc_correlate ()
+{
+  /* Not-taken PCs already seed address_frequencies; still expand ranges.  */
+  if (sorted_ranges_.empty ())
+    return;
+  materialize_address_frequencies_from_range_counts (
+    address_frequencies,
+    AARCH64_INSN_SIZE,
+    /*skip_existing_pcs=*/true);
+}
+
+bool
+perf_spe_reader::accept_target_addr_cb (uint64_t runtime_addr, void *ctx)
+{
+  return static_cast<perf_spe_reader *> (ctx)->is_target_address (runtime_addr);
+}
+
+void
+perf_spe_reader::note_timestamp_cb (uint64_t runtime_addr, uint64_t timestamp,
+				    void *ctx)
+{
+  static_cast<perf_spe_reader *> (ctx)->note_sample_timestamp (
+    runtime_addr, timestamp);
+}
+
+bool
+perf_spe_reader::parse_perf_data_section ()
+{
+  if (header.data_offset > mapped_size ())
+    {
+      fprintf (stderr,
+	       "SPE: perf.data data section starts past end of file "
+	       "(data_offset=%" PRIu64 ", file_size=%zu).\n",
+	       header.data_offset,
+	       mapped_size ());
+      return false;
+    }
+
+  size_t auxtrace_records = 0;
+  size_t aux_chunks = 0;
+  size_t mmap_records_seen = 0;
+  size_t mmap_records_matched = 0;
+  bool spe_aux_decode_ok = true;
+
+  reset_branch_stack_profile ();
+  range_count_map_.clear ();
+  branch_count_map_.clear ();
+  address_frequencies.clear ();
+
+  /* Pass 1: bind MMAPs before address filtering (same reason as LBR).  */
+  for_each_mapped_perf_data_record (
+    [&] (size_t,
+	 size_t,
+	 const perf_event_header &hdr,
+	 const uint8_t *payload,
+	 size_t payload_size,
+	 size_t) {
+      if (hdr.type == perf_record_type::MMAP
+	  || hdr.type == perf_record_type::MMAP2)
+	{
+	  const size_t before = target_mmaps.size ();
+	  if (hdr.type == perf_record_type::MMAP)
+	    parse_mmap_record (payload, payload_size);
+	  else
+	    parse_mmap2_record (payload, payload_size, hdr.misc);
+	  ++mmap_records_seen;
+	  if (target_mmaps.size () > before)
+	    ++mmap_records_matched;
+	}
+    },
+    perf_scan_log::SPE);
+
+  /* Pass 2: decode AUXTRACE SPE tails into address_frequencies.  */
+  arm_spe_profile_accumulator acc{};
+  acc.accept_addr = accept_target_addr_cb;
+  acc.note_timestamp = note_timestamp_cb;
+  acc.ctx = this;
+  acc.branch_counts = &branch_count_map_;
+  acc.not_taken_counts = &address_frequencies;
+
+  const uint8_t *const file_base = mapped_bytes ();
+
+  for_each_mapped_perf_data_record (
+    [&] (size_t,
+	 size_t,
+	 const perf_event_header &hdr,
+	 const uint8_t *payload,
+	 size_t,
+	 size_t skip) {
+      if (!spe_aux_decode_ok || hdr.type != perf_record_type::AUXTRACE)
+	return;
+
+      ++auxtrace_records;
+      const uint8_t *tail_ptr = nullptr;
+      size_t tail = 0;
+      if (!spe_auxtrace_tail (
+	    hdr, payload, skip, file_base, mapped_size (), &tail_ptr, &tail))
+	{
+	  spe_aux_decode_ok = false;
+	  fprintf (stderr,
+		   "SPE: invalid AUXTRACE record (hdr.size=%u skip=%zu) "
+		   "at file offset %zu.\n",
+		   (unsigned) hdr.size,
+		   skip,
+		   payload != nullptr
+		     ? static_cast<size_t> (payload - file_base)
+		     : (size_t) 0);
+	  return;
+	}
+
+      /* Zero-size tails are metadata / empty AUXTRACE; keep scanning.  */
+      if (tail == 0)
+	return;
+
+      ++aux_chunks;
+      if (!arm_spe_aux_accumulate_profile (tail_ptr, tail, &acc))
+	{
+	  spe_aux_decode_ok = false;
+	  fprintf (stderr,
+		   "SPE: AUXTRACE decode failed (corrupt SPE) at file "
+		   "offset %zu, tail %zu B.\n",
+		   static_cast<size_t> (tail_ptr - file_base),
+		   tail);
+	}
+    },
+    perf_scan_log::SPE);
+
+  if (!spe_aux_decode_ok)
+    return false;
+
+  arm_text_image text;
+  if (!text.load (binary_path))
+    {
+      fprintf (stderr,
+	       "SPE: failed to load executable text from %s\n",
+	       binary_path.c_str ());
+      return false;
+    }
+  /* Insn decode needs static addresses; translate before synthesizing.  */
+  branch_stack_edge_count_map dwarf_branches;
+  std::unordered_map<uint64_t, uint64_t> dwarf_not_taken;
+  translate_edges_to_dwarf (branch_count_map_, target_mmaps, &dwarf_branches);
+  translate_pc_counts_to_dwarf (
+    address_frequencies, target_mmaps, &dwarf_not_taken);
+  arm_spe_synthesize_ranges (
+    dwarf_branches, dwarf_not_taken, text, &range_count_map_);
+  total_samples
+    = spe_profile_total_mass (range_count_map_, address_frequencies);
+
+  if (target_mmaps.empty ())
+    fprintf (stderr,
+	     "SPE: WARNING: no target mappings "
+	     "(saw %zu MMAP/MMAP2, %zu matched -b %s)\n",
+	     mmap_records_seen,
+	     mmap_records_matched,
+	     binary_path.c_str ());
+  else if (mmap_records_matched == 0 && mmap_records_seen > 0)
+    fprintf (stderr,
+	     "SPE: WARNING: %zu MMAP/MMAP2 but none matched -b %s\n",
+	     mmap_records_seen,
+	     binary_path.c_str ());
+
+  if (total_samples == 0)
+    {
+      if (auxtrace_records == 0)
+	fprintf (stderr,
+		 "SPE: No PERF_RECORD_AUXTRACE records in %s "
+		 "(not an SPE perf.data, or empty capture).\n",
+		 perf_data_path.c_str ());
+      else if (aux_chunks == 0)
+	fprintf (stderr,
+		 "SPE: %zu AUXTRACE record(s) but no SPE payload "
+		 "(all empty tails) in %s.\n",
+		 auxtrace_records,
+		 perf_data_path.c_str ());
+      else
+	fprintf (stderr,
+		 "SPE: No profile hits matched -b %s "
+		 "(check path / build-id / MMAP; decoded %zu AUXTRACE "
+		 "tail(s)).\n",
+		 binary_path.c_str (),
+		 aux_chunks);
+      return false;
+    }
+  return true;
+}
+
+void
+perf_spe_reader::finalize_profile_maps_impl ()
+{
+  /* Ranges already in dwarf space; translate edges only.  */
+  sorted_ranges_.clear ();
+  sorted_ranges_.reserve (range_count_map_.size ());
+  for (const auto &entry : range_count_map_)
+    sorted_ranges_.push_back (
+      profile_range{entry.first.first, entry.first.second, entry.second});
+  range_count_map_.clear ();
+  range_count_map_.rehash (0);
+  std::sort (sorted_ranges_.begin (), sorted_ranges_.end ());
+
+  finalize_branch_edges_to_file_offsets (branch_count_map_, target_mmaps);
+  build_sorted_touch_pcs_from_ranges (&sorted_touch_pcs_);
+}
+
+} /* namespace perf_data.  */
