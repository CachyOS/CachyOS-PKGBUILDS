+
+void
+clear_decode_error ()
+{
+  g_decode_failed = false;
+  g_decode_msg = "";
+}
+
+/* Record MSG as the decode error.  Only the first one is kept, as cascading
+   failures are less informative.  */
+void
+set_decode_error (const char *msg)
+{
+  if (g_decode_failed)
+    return;
+  g_decode_failed = true;
+  g_decode_msg = msg;
+}
+
