diff --git a/afdo-tools/src/arm_spe_aux_decode.cc b/afdo-tools/src/arm_spe_aux_decode.cc
new file mode 100644
index 00000000000..1f1d4441ee8
--- /dev/null
+++ b/afdo-tools/src/arm_spe_aux_decode.cc
@@ -0,0 +1,560 @@
+/* Minimal Arm SPE (Statistical Profiling Extension) auxtrace decoder.
+   Packet formats follow the Statistical Profiling Extension chapter of the
+   Arm Architecture Reference Manual for A-profile.  */
+
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "arm_spe_aux_decode.h"
+
+#include <algorithm>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include <fcntl.h>
+#include <gelf.h>
+#include <libelf.h>
+#include <unistd.h>
+
+namespace perf_data {
+
+namespace {
+
+/* Packet headers.  A header byte matches a type when (byte & MASK) == VALUE.
+   The bits outside the mask hold the payload size or an index.  */
+constexpr uint8_t SPE_PADDING = 0x00;
+constexpr uint8_t SPE_END = 0x01;
+constexpr uint8_t SPE_TIMESTAMP = 0x71;
+constexpr uint8_t SPE_SIZE_MASK = 0xcf;
+constexpr uint8_t SPE_EVENTS = 0x42;
+constexpr uint8_t SPE_DATA_SOURCE = 0x43;
+constexpr uint8_t SPE_INDEX2_MASK = 0xfc;
+constexpr uint8_t SPE_CONTEXT = 0x64;
+constexpr uint8_t SPE_OP_TYPE = 0x48;
+/* First byte of a two-byte header.  It holds index bits 4:3 of the address
+   or counter header that follows.  */
+constexpr uint8_t SPE_EXTENDED = 0x20;
+constexpr uint8_t SPE_ALIGNMENT = 0x00;
+constexpr uint8_t SPE_INDEX3_MASK = 0xf8;
+constexpr uint8_t SPE_ADDRESS = 0xb0;
+constexpr uint8_t SPE_COUNTER = 0x98;
+
+/* Address packet index.  */
+constexpr unsigned SPE_ADDRESS_PC = 0;
+constexpr unsigned SPE_ADDRESS_BRANCH_TARGET = 1;
+/* Address packet payload bits 55:0.  The upper bits hold EL and NS.  */
+constexpr uint64_t SPE_ADDRESS_VA_MASK = (1ULL << 56) - 1;
+
+/* Operation type packet class, and the conditional bit of a branch.  */
+constexpr unsigned SPE_OP_CLASS_BRANCH = 2;
+constexpr uint64_t SPE_OP_BRANCH_COND = 0x1;
+
+/* Events packet bits.  */
+constexpr uint64_t SPE_EVENT_RETIRED = 1ULL << 1;
+constexpr uint64_t SPE_EVENT_NOT_TAKEN = 1ULL << 6;
+
+constexpr uint64_t MAX_SPE_RANGE_BYTES = 0x1000;
+
+enum spe_packet_type
+{
+  SPE_PKT_BAD,
+  SPE_PKT_PADDING,
+  SPE_PKT_END,
+  SPE_PKT_TIMESTAMP,
+  SPE_PKT_EVENTS,
+  SPE_PKT_DATA_SOURCE,
+  SPE_PKT_CONTEXT,
+  SPE_PKT_OP_TYPE,
+  SPE_PKT_ADDRESS,
+  SPE_PKT_COUNTER,
+};
+
+struct spe_packet
+{
+  spe_packet_type type = SPE_PKT_BAD;
+  /* Address index or operation class.  */
+  unsigned index = 0;
+  uint64_t payload = 0;
+  /* Header and payload bytes.  */
+  size_t size = 0;
+};
+
+static spe_packet_type
+spe_header_type (uint8_t hdr)
+{
+  if (hdr == SPE_PADDING)
+    return SPE_PKT_PADDING;
+  if (hdr == SPE_END)
+    return SPE_PKT_END;
+  if (hdr == SPE_TIMESTAMP)
+    return SPE_PKT_TIMESTAMP;
+  if ((hdr & SPE_SIZE_MASK) == SPE_EVENTS)
+    return SPE_PKT_EVENTS;
+  if ((hdr & SPE_SIZE_MASK) == SPE_DATA_SOURCE)
+    return SPE_PKT_DATA_SOURCE;
+  if ((hdr & SPE_INDEX2_MASK) == SPE_CONTEXT)
+    return SPE_PKT_CONTEXT;
+  if ((hdr & SPE_INDEX2_MASK) == SPE_OP_TYPE)
+    return SPE_PKT_OP_TYPE;
+  if ((hdr & SPE_INDEX3_MASK) == SPE_ADDRESS)
+    return SPE_PKT_ADDRESS;
+  if ((hdr & SPE_INDEX3_MASK) == SPE_COUNTER)
+    return SPE_PKT_COUNTER;
+  return SPE_PKT_BAD;
+}
+
+/* Decode the packet at the start of BUF.  Returns 1 with PKT filled in, 0 if
+   BUF ends inside the packet, and -1 if BUF[0] starts no packet.  */
+static int
+spe_read_packet (const uint8_t *buf, size_t len, uint64_t offset,
+		 spe_packet *pkt)
+{
+  size_t hdr_len = 1;
+  uint8_t hdr = buf[0];
+  unsigned index = 0;
+  if ((hdr & SPE_INDEX2_MASK) == SPE_EXTENDED)
+    {
+      if (len < 2)
+	return 0;
+      index = (hdr & 0x3) << 3;
+      hdr = buf[1];
+      hdr_len = 2;
+      if (hdr == SPE_ALIGNMENT)
+	{
+	  const size_t alignment = size_t (1) << ((buf[0] & 0xf) + 1);
+	  const size_t padding = alignment - (offset & (alignment - 1));
+	  if (len < padding)
+	    return 0;
+	  pkt->type = SPE_PKT_PADDING;
+	  pkt->size = padding;
+	  return 1;
+	}
+    }
+
+  pkt->type = spe_header_type (hdr);
+  if (pkt->type == SPE_PKT_BAD
+      || (hdr_len == 2 && pkt->type != SPE_PKT_ADDRESS
+	  && pkt->type != SPE_PKT_COUNTER))
+    return -1;
+  if (pkt->type == SPE_PKT_ADDRESS)
+    pkt->index = index | (hdr & 0x7);
+  else if (pkt->type == SPE_PKT_OP_TYPE)
+    pkt->index = hdr & 0x3;
+
+  /* Every packet but padding and end has a 1 << hdr[5:4] byte payload.  */
+  const size_t payload_len
+    = (pkt->type == SPE_PKT_PADDING || pkt->type == SPE_PKT_END)
+	? 0
+	: size_t (1) << ((hdr >> 4) & 0x3);
+  if (len - hdr_len < payload_len)
+    return 0;
+  pkt->payload = 0;
+  for (size_t i = 0; i < payload_len; ++i)
+    pkt->payload |= uint64_t (buf[hdr_len + i]) << (8 * i);
+  pkt->size = hdr_len + payload_len;
+  return 1;
+}
+
+} /* namespace.  */
+
+void
+arm_spe_stream_decoder::clear_record ()
+{
+  from_ip_ = 0;
+  to_ip_ = 0;
+  events_ = 0;
+  op_payload_ = 0;
+  timestamp_ = 0;
+  op_index_ = 0;
+  have_from_ip_ = false;
+  have_to_ip_ = false;
+  have_op_ = false;
+}
+
+/* Account a completed record.  A retired branch contributes either a taken
+   edge or, for an untaken conditional branch, a not-taken PC.  */
+void
+arm_spe_stream_decoder::commit_record (arm_spe_profile_accumulator *acc)
+{
+  if (!(events_ & SPE_EVENT_RETIRED) || !have_op_
+      || op_index_ != SPE_OP_CLASS_BRANCH)
+    return;
+  if (acc->set_context != nullptr
+      && !acc->set_context (context_id_, timestamp_, acc->ctx))
+    return;
+  uint64_t from = 0;
+  if (!have_from_ip_
+      || !acc->translate_addr (from_ip_, timestamp_, &from, acc->ctx))
+    return;
+  if (timestamp_ != 0 && acc->note_timestamp != nullptr)
+    acc->note_timestamp (from, timestamp_, acc->ctx);
+
+  const bool br_cond = (op_payload_ & SPE_OP_BRANCH_COND) != 0;
+  const bool not_taken = (events_ & SPE_EVENT_NOT_TAKEN) != 0;
+  if (br_cond && not_taken)
+    {
+      (*acc->not_taken_counts)[from] += 1;
+      return;
+    }
+
+  uint64_t to = 0;
+  if (!have_to_ip_
+      || !acc->translate_addr (to_ip_, timestamp_, &to, acc->ctx))
+    return;
+  if (timestamp_ != 0 && acc->note_timestamp != nullptr)
+    acc->note_timestamp (to, timestamp_, acc->ctx);
+  (*acc->branch_counts)[{from, to}] += 1;
+}
+
+bool
+arm_spe_stream_decoder::consume (const uint8_t *spe_buf, size_t spe_len,
+				 arm_spe_profile_accumulator *acc)
+{
+  if ((spe_buf == nullptr && spe_len != 0) || acc == nullptr
+      || acc->translate_addr == nullptr || acc->branch_counts == nullptr
+      || acc->not_taken_counts == nullptr
+      || spe_len > pending_.max_size () - pending_.size ())
+    return false;
+
+  if (spe_len != 0)
+    pending_.insert (pending_.end (), spe_buf, spe_buf + spe_len);
+  size_t pos = 0;
+  while (pos < pending_.size ())
+    {
+      spe_packet pkt;
+      const int ret = spe_read_packet (pending_.data () + pos,
+				       pending_.size () - pos,
+				       pending_offset_ + pos, &pkt);
+      if (ret == 0)
+	break;
+      if (ret < 0)
+	{
+	  /* Drop the record in progress and resync at the next byte.  A
+	     snapshot buffer can start mid-packet.  */
+	  clear_record ();
+	  ++skipped_bytes_;
+	  ++pos;
+	  continue;
+	}
+
+      switch (pkt.type)
+	{
+	case SPE_PKT_END:
+	  commit_record (acc);
+	  clear_record ();
+	  break;
+	case SPE_PKT_TIMESTAMP:
+	  timestamp_ = pkt.payload;
+	  commit_record (acc);
+	  clear_record ();
+	  break;
+	case SPE_PKT_ADDRESS:
+	  if (pkt.index == SPE_ADDRESS_PC)
+	    {
+	      from_ip_ = pkt.payload & SPE_ADDRESS_VA_MASK;
+	      have_from_ip_ = true;
+	    }
+	  else if (pkt.index == SPE_ADDRESS_BRANCH_TARGET)
+	    {
+	      to_ip_ = pkt.payload & SPE_ADDRESS_VA_MASK;
+	      have_to_ip_ = true;
+	    }
+	  break;
+	case SPE_PKT_CONTEXT:
+	  context_id_ = pkt.payload;
+	  break;
+	case SPE_PKT_EVENTS:
+	  events_ = pkt.payload;
+	  break;
+	case SPE_PKT_OP_TYPE:
+	  op_index_ = static_cast<unsigned char> (pkt.index);
+	  op_payload_ = pkt.payload;
+	  have_op_ = true;
+	  break;
+	default:
+	  break;
+	}
+      pos += pkt.size;
+    }
+
+  if (pos != 0)
+    {
+      pending_.erase (pending_.begin (), pending_.begin () + pos);
+      pending_offset_ += pos;
+    }
+  return true;
+}
+
+constexpr uint32_t AARCH64_B_MASK = 0xfc000000;
+constexpr uint32_t AARCH64_B = 0x14000000;
+constexpr uint32_t AARCH64_BRANCH_REG_MASK = 0xfe000000;
+constexpr uint32_t AARCH64_BRANCH_REG = 0xd6000000;
+constexpr uint32_t AARCH64_BRANCH_REG_LINK_MASK = 0x00e00000;
+constexpr uint32_t AARCH64_BRANCH_REG_LINK = 0x00200000;
+constexpr uint32_t AARCH64_EXCEPTION_MASK = 0xffe00000;
+constexpr uint32_t AARCH64_BRK = 0xd4200000;
+constexpr uint32_t AARCH64_HLT = 0xd4400000;
+constexpr uint32_t AARCH64_UDF_MASK = 0xffff0000;
+constexpr uint32_t AARCH64_UDF = 0x00000000;
+
+/* AArch64 insns that never fall through include B, BR/RET/ERET/DRPS (not
+   BL/BLR),
+   BRK/HLT, UDF.  Conditional branches still fall through when not taken.  */
+
+static bool
+aarch64_insn_falls_through (uint32_t insn)
+{
+  if ((insn & AARCH64_B_MASK) == AARCH64_B)
+    return false;
+  /* Branch to register.  Of these only BLR, BLRAA and BLRAB (opc x001) fall
+     through.  */
+  if ((insn & AARCH64_BRANCH_REG_MASK) == AARCH64_BRANCH_REG)
+    return (insn & AARCH64_BRANCH_REG_LINK_MASK) == AARCH64_BRANCH_REG_LINK;
+  if ((insn & AARCH64_EXCEPTION_MASK) == AARCH64_BRK
+      || (insn & AARCH64_EXCEPTION_MASK) == AARCH64_HLT)
+    return false;
+  if ((insn & AARCH64_UDF_MASK) == AARCH64_UDF)
+    return false;
+  return true;
+}
+
+/* Cache the executable PT_LOAD segments of BINARY_PATH.  */
+bool
+arm_text_image::load (const std::string &binary_path)
+{
+  segments_.clear ();
+  if (elf_version (EV_CURRENT) == EV_NONE)
+    return false;
+
+  const int fd = open (binary_path.c_str (), O_RDONLY);
+  if (fd < 0)
+    return false;
+
+  Elf *const elf = elf_begin (fd, ELF_C_READ, nullptr);
+  if (elf == nullptr)
+    {
+      close (fd);
+      return false;
+    }
+
+  size_t phnum = 0;
+  size_t raw_size = 0;
+  const char *const raw = elf_rawfile (elf, &raw_size);
+  if (elf_kind (elf) == ELF_K_ELF && raw != nullptr
+      && elf_getphdrnum (elf, &phnum) == 0)
+    for (size_t i = 0; i < phnum; ++i)
+      {
+	GElf_Phdr phdr;
+	if (gelf_getphdr (elf, i, &phdr) != &phdr)
+	  continue;
+	if (phdr.p_type != PT_LOAD || (phdr.p_flags & PF_X) == 0
+	    || phdr.p_filesz == 0 || phdr.p_offset > raw_size
+	    || phdr.p_filesz > raw_size - phdr.p_offset)
+	  continue;
+	const uint8_t *const start
+	  = reinterpret_cast<const uint8_t *> (raw) + phdr.p_offset;
+	segments_.push_back (
+	  {phdr.p_vaddr, std::vector<uint8_t> (start, start + phdr.p_filesz)});
+      }
+
+  func_starts_.clear ();
+  for (Elf_Scn *scn = elf_nextscn (elf, nullptr); scn != nullptr;
+       scn = elf_nextscn (elf, scn))
+    {
+      GElf_Shdr shdr;
+      if (gelf_getshdr (scn, &shdr) != &shdr || shdr.sh_type != SHT_SYMTAB
+	  || shdr.sh_entsize == 0)
+	continue;
+      Elf_Data *const data = elf_getdata (scn, nullptr);
+      if (data == nullptr)
+	continue;
+      const size_t nsyms = shdr.sh_size / shdr.sh_entsize;
+      for (size_t i = 0; i < nsyms; ++i)
+	{
+	  GElf_Sym sym;
+	  if (gelf_getsym (data, i, &sym) == &sym
+	      && GELF_ST_TYPE (sym.st_info) == STT_FUNC && sym.st_value != 0)
+	    func_starts_.push_back (sym.st_value);
+	}
+    }
+  std::sort (func_starts_.begin (), func_starts_.end ());
+  func_starts_.erase (std::unique (func_starts_.begin (), func_starts_.end ()),
+		      func_starts_.end ());
+
+  elf_end (elf);
+  close (fd);
+  return !segments_.empty ();
+}
+
+bool
+arm_text_image::can_fall_through (uint64_t addr) const
+{
+  for (const segment &seg : segments_)
+    {
+      if (addr < seg.vaddr)
+	continue;
+      const uint64_t off = addr - seg.vaddr;
+      if (off > seg.bytes.size ()
+	  || AARCH64_INSN_SIZE > seg.bytes.size () - off)
+	continue;
+      const uint8_t *const p = seg.bytes.data () + off;
+      const uint32_t insn = static_cast<uint32_t> (p[0])
+			    | (static_cast<uint32_t> (p[1]) << 8)
+			    | (static_cast<uint32_t> (p[2]) << 16)
+			    | (static_cast<uint32_t> (p[3]) << 24);
+      return aarch64_insn_falls_through (insn);
+    }
+  return true;
+}
+
+uint64_t
+arm_text_image::fall_through_limit (uint64_t start, uint64_t end) const
+{
+  uint64_t limit = UINT64_MAX;
+  const auto next_func
+    = std::upper_bound (func_starts_.begin (), func_starts_.end (), start);
+  if (next_func != func_starts_.end () && *next_func <= end
+      && *next_func - start >= AARCH64_INSN_SIZE)
+    end = limit = *next_func - AARCH64_INSN_SIZE;
+  for (const segment &seg : segments_)
+    {
+      if (start < seg.vaddr || start - seg.vaddr >= seg.bytes.size ())
+	continue;
+      for (uint64_t pc = start; pc <= end; pc += AARCH64_INSN_SIZE)
+	{
+	  const uint64_t off = pc - seg.vaddr;
+	  if (AARCH64_INSN_SIZE > seg.bytes.size ()
+	      || off > seg.bytes.size () - AARCH64_INSN_SIZE)
+	    break;
+	  const uint8_t *const p = seg.bytes.data () + off;
+	  const uint32_t insn = static_cast<uint32_t> (p[0])
+				| (static_cast<uint32_t> (p[1]) << 8)
+				| (static_cast<uint32_t> (p[2]) << 16)
+				| (static_cast<uint32_t> (p[3]) << 24);
+	  if (!aarch64_insn_falls_through (insn))
+	    return pc;
+	  if (pc > UINT64_MAX - AARCH64_INSN_SIZE)
+	    break;
+	}
+      break;
+    }
+  return limit;
+}
+
+void
+arm_spe_synthesize_ranges
+  (const branch_stack_edge_count_map &branch_counts,
+   const std::unordered_map<uint64_t, uint64_t> &not_taken_counts,
+   const arm_text_image &text, branch_stack_edge_count_map *range_counts)
+{
+  if (range_counts == nullptr || branch_counts.empty ())
+    return;
+
+  /* Synthesize execution ranges from branch landings.  */
+  std::unordered_map<uint64_t, uint64_t> incoming_weights;
+  incoming_weights.reserve (branch_counts.size ());
+  for (const auto &entry : branch_counts)
+    incoming_weights[entry.first.second] += entry.second;
+
+  std::vector<uint64_t> landings;
+  landings.reserve (incoming_weights.size ());
+  for (const auto &entry : incoming_weights)
+    landings.push_back (entry.first);
+  std::sort (landings.begin (), landings.end ());
+
+  std::unordered_set<uint64_t> branch_pc_set;
+  branch_pc_set.reserve (branch_counts.size () + not_taken_counts.size ());
+  for (const auto &entry : branch_counts)
+    branch_pc_set.insert (entry.first.first);
+  for (const auto &entry : not_taken_counts)
+    branch_pc_set.insert (entry.first);
+
+  std::vector<uint64_t> branch_addrs (
+    branch_pc_set.begin (), branch_pc_set.end ());
+  std::sort (branch_addrs.begin (), branch_addrs.end ());
+
+  /* Weight that falls through into the next landing, which is a join.  The
+     run there continues with it as well as the branches landing there.  */
+  uint64_t carried_weight = 0;
+  for (size_t i = 0; i < landings.size (); ++i)
+    {
+      const uint64_t landing = landings[i];
+      const uint64_t window = landing > UINT64_MAX - MAX_SPE_RANGE_BYTES
+				? UINT64_MAX
+				: landing + MAX_SPE_RANGE_BYTES;
+      const uint64_t scan_end = (i + 1 < landings.size ())
+				  ? std::min (landings[i + 1], window)
+				  : window;
+      uint64_t range_start = landing;
+      uint64_t range_weight = incoming_weights[landing] + carried_weight;
+      carried_weight = 0;
+      bool reached_scan_end = false;
+
+      while (range_weight > 0)
+	{
+	  if (range_start >= scan_end)
+	    {
+	      reached_scan_end = true;
+	      break;
+	    }
+	  const auto next_branch = std::lower_bound (
+	    branch_addrs.begin (), branch_addrs.end (), range_start);
+	  const bool hit_branch
+	    = next_branch != branch_addrs.end () && *next_branch < scan_end;
+	  if (!hit_branch && scan_end - range_start < AARCH64_INSN_SIZE)
+	    break;
+	  const uint64_t range_end
+	    = hit_branch ? *next_branch : scan_end - AARCH64_INSN_SIZE;
+
+	  /* Unsampled unconditional transfers and function ends still end a
+	     fall-through run.  */
+	  const uint64_t limit
+	    = text.fall_through_limit (range_start, range_end);
+	  if (limit < range_end)
+	    {
+	      (*range_counts)[{range_start, limit}] += range_weight;
+	      break;
+	    }
+
+	  if (range_end >= range_start)
+	    (*range_counts)[{range_start, range_end}] += range_weight;
+
+	  if (!hit_branch)
+	    {
+	      reached_scan_end = limit != range_end;
+	      break;
+	    }
+
+	  /* Continue past a branch only with its sampled not-taken weight, and
+	     never past an unconditional transfer.  */
+	  const auto nit = not_taken_counts.find (*next_branch);
+	  range_weight = (nit != not_taken_counts.end ()) ? nit->second : 0;
+	  if (!text.can_fall_through (*next_branch))
+	    break;
+	  if (*next_branch > UINT64_MAX - AARCH64_INSN_SIZE)
+	    break;
+	  range_start = *next_branch + AARCH64_INSN_SIZE;
+	}
+      if (reached_scan_end && i + 1 < landings.size ()
+	  && scan_end == landings[i + 1])
+	carried_weight = range_weight;
+    }
+}
+
+} /* namespace perf_data.  */
