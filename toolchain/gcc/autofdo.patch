+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_merge.h"
+#include "version.h"
+
+#include <cstdio>
+#include <getopt.h>
+#include <string>
+#include <vector>
+
+static void
+print_usage (const char *prog, FILE *stream)
+{
+  fprintf (stream, _("Usage:\n"
+		   "  %s [OPTIONS] <a.gcov> [<b.gcov> ...]\n"
+		   "\n"
+		   "Merge AutoFDO profiles (sum counts).  With -o, a single "
+		   "input is\n"
+		   "allowed.\n"
+		   "Options:\n"
+		   "  -o, --output_file FILE   Write merged profile to FILE\n"
+		   "  -h, --help  Print this help, then exit\n"
+		   "  -v, --version  Print version information, then exit\n"
+		   "\nFor bug reporting instructions, please see:\n"
+		   "%s.\n"),
+	   prog, bug_report_url);
+}
+
+int
+main (int argc, char *argv[])
+{
+  afdo_init_libintl ();
+
+  std::string output_path;
+  static option longopts[] = {{"output_file", required_argument, nullptr, 'o'},
+			      {"help", no_argument, nullptr, 'h'},
+			      {"version", no_argument, nullptr, 'v'},
+			      {nullptr, 0, nullptr, 0}};
+
+  int c, idx = 0;
+  while ((c = getopt_long_only (argc, argv, "o:hv", longopts, &idx)) != -1)
+    {
+      switch (c)
+	{
+	case 'o':
+	  output_path = optarg;
+	  break;
+	case 'h':
+	  print_usage (argv[0], stdout);
+	  return 0;
+	case 'v':
+	  printf ("afdo_merge %s%s\n", pkgversion_string, version_string);
+	  printf (_("Copyright %s 2026 Free Software Foundation, Inc.\n"),
+		  _("(C)"));
+	  printf (_("This is free software; see the source for copying "
+		    "conditions.  There is NO\n"
+		    "warranty; not even for MERCHANTABILITY or FITNESS FOR A "
+		    "PARTICULAR PURPOSE.\n"));
+	  return 0;
+	default:
+	  print_usage (argv[0], stderr);
+	  return 1;
+	}
+    }
+
+  std::vector<std::string> inputs;
+  for (int i = optind; i < argc; ++i)
+    inputs.emplace_back (argv[i]);
+
+  if (output_path.empty ())
+    {
+      /* An explicit output file is required: never treat a positional
+	 argument as the output (that would silently overwrite an input).  */
+      fprintf (stderr, _("error: no output file; use -o FILE\n"));
+      print_usage (argv[0], stderr);
+      return 1;
+    }
+  if (inputs.empty ())
+    {
+      /* Nothing to merge.  A lone input is accepted, since with -o that is a
+	 faithful version conversion rather than an accidental overwrite.  */
+      print_usage (argv[0], stderr);
+      return 1;
+    }
+
+  gcov::gcov_merger merger;
+  if (!merger.merge (inputs, output_path))
+    return 1;
+
+  return 0;
+}
