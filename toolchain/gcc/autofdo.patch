+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "perf_spe_reader.h"
+
+#include "arm_spe_aux_decode.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace perf_data {
+namespace {
+
+constexpr size_t PERF_RECORD_AUX_FIXED_BYTES = 3 * sizeof (uint64_t);
+constexpr uint64_t PERF_AUX_DATA_LOSS_FLAGS
+  = PERF_AUX_FLAG_TRUNCATED | PERF_AUX_FLAG_OVERWRITE
+    | PERF_AUX_FLAG_PARTIAL | PERF_AUX_FLAG_COLLISION;
+
+/* Prefer synthesized range mass.  Otherwise use not-taken / SAMPLE PC
+   mass.  */
+uint64_t
+spe_profile_total_mass
+  (const branch_stack_edge_count_map &range_count_map,
+   const std::unordered_map<uint64_t, uint64_t> &address_frequencies)
+{
+  const uint64_t from_ranges
+    = total_mass_from_runtime_range_map (range_count_map);
+  if (from_ranges != 0)
+    return from_ranges;
+  return total_mass_from_address_frequencies (address_frequencies);
+}
+
+/* PERF_RECORD_AUXTRACE descriptor, excluding perf_event_header.  */
+struct perf_auxtrace_descriptor
+{
+  uint64_t size;
+  uint64_t offset;
+  uint64_t reference;
+  uint32_t idx;
+  uint32_t tid;
+  uint32_t cpu;
+  uint32_t reserved;
+};
+
+/* One AUXTRACE record.  The descriptor fields this reader uses, and the SPE
+   payload that trails the record.  */
+struct spe_auxtrace_chunk
+{
+  const uint8_t *tail = nullptr;
+  size_t tail_size = 0;
+  uint64_t aux_offset = 0;
+  uint32_t idx = 0;
+  uint32_t tid = 0;
+  uint32_t cpu = 0;
+};
+
+/* AUXTRACE payload after the descriptor.  Empty tail is ok.  */
+bool
+spe_auxtrace_tail (const perf_event_header &hdr, const uint8_t *payload,
+		   size_t skip, const uint8_t *file_base, size_t file_size,
+		   spe_auxtrace_chunk *out)
+{
+  if (payload == nullptr || file_base == nullptr || out == nullptr
+      || skip < hdr.size
+      || hdr.size < sizeof (perf_event_header)
+		      + sizeof (perf_auxtrace_descriptor))
+    return false;
+
+  const size_t tail = skip - hdr.size;
+  perf_auxtrace_descriptor desc;
+  std::memcpy (&desc, payload, sizeof (desc));
+  if (desc.size != tail)
+    return false;
+  if (payload < file_base)
+    return false;
+  const size_t payload_offset = static_cast<size_t> (payload - file_base);
+  if (payload_offset > file_size || payload_offset < sizeof (perf_event_header))
+    return false;
+  const size_t record_offset = payload_offset - sizeof (perf_event_header);
+  if (hdr.size > file_size - record_offset)
+    return false;
+  const size_t tail_offset = record_offset + hdr.size;
+  if (tail > file_size - tail_offset)
+    return false;
+
+  out->tail = file_base + tail_offset;
+  out->tail_size = tail;
+  out->aux_offset = desc.offset;
+  out->idx = desc.idx;
+  out->tid = desc.tid;
+  out->cpu = desc.cpu;
+  return true;
+}
+
+struct spe_stream_state
+{
+  arm_spe_stream_decoder decoder;
+  uint64_t next_aux_offset = 0;
+  bool have_offset = false;
+};
+
+} /* anonymous namespace.  */
+
+perf_spe_reader::perf_spe_reader (const std::string &_perf_data_path,
+				  const std::string &_binary_path)
+  : perf_file_reader (_perf_data_path, _binary_path)
+{}
+
+/* Pick the process an SPE record belongs to.  A privileged capture names the
+   thread in a context packet, because Linux writes the thread id into
+   CONTEXTIDR_EL1 on a context switch.  Otherwise the record's CPU and
+   timestamp are looked up in the schedule the side-band records describe.  */
+bool
+perf_spe_reader::select_context (uint64_t context_id, uint64_t timestamp)
+{
+  uint32_t pid = 0;
+  if (context_id != 0)
+    {
+      const auto it
+	= target_pid_by_tid_.find (static_cast<uint32_t> (context_id));
+      if (it == target_pid_by_tid_.end ())
+	{
+	  active_mmaps_ = nullptr;
+	  active_pid_ = 0;
+	  return false;
+	}
+      pid = it->second;
+    }
+  else
+    {
+      uint64_t sample_time = 0;
+      const bool timed
+	= active_cpu_valid_
+	  && spe_timestamp_to_perf_time (timestamp, &sample_time);
+      if (!timed)
+	pid = fallback_pid_;
+      /* Where the CPU has a schedule, nothing traced ran outside it.  */
+      else if (!cpu_owner_at (active_cpu_, sample_time, &pid)
+	       && !cpu_has_schedule (active_cpu_))
+	pid = fallback_pid_;
+      if (pid == 0)
+	{
+	  if (!timed && active_cpu_shared_)
+	    ++unplaced_records_;
+	  else
+	    ++unattributed_records_;
+	  active_mmaps_ = nullptr;
+	  active_pid_ = 0;
+	  return false;
+	}
+    }
+
+  /* Records come in runs from the same process, so only look up a change.  */
+  if (pid != active_pid_)
+    {
+      active_pid_ = pid;
+      active_mmaps_ = target_mmaps_for_pid (pid);
+    }
+  return active_mmaps_ != nullptr;
+}
+
+/* SPE stamps its records with the hardware counter, not perf's clock.  */
+bool
+perf_spe_reader::spe_timestamp_to_perf_time (uint64_t timestamp,
+					     uint64_t *out_time) const
+{
+  return timestamp != 0 && counter_to_perf_time (timestamp, out_time);
+}
+
+bool
+perf_spe_reader::set_context_cb (uint64_t context_id, uint64_t timestamp,
+				 void *ctx)
+{
+  return static_cast<perf_spe_reader *> (ctx)->select_context (context_id,
+							       timestamp);
+}
+
+bool
+perf_spe_reader::translate_target_addr_cb (uint64_t runtime_addr,
+					   uint64_t timestamp,
+					   uint64_t *dwarf_addr, void *ctx)
+{
+  const perf_spe_reader *const reader = static_cast<perf_spe_reader *> (ctx);
+  if (reader->active_mmaps_ == nullptr)
+    return false;
+  /* Mapping windows are on perf's scale.  0 asks for any covering mapping.  */
+  uint64_t sample_time = 0;
+  reader->spe_timestamp_to_perf_time (timestamp, &sample_time);
+  return try_translate_runtime_with_mmaps (*reader->active_mmaps_,
+					   runtime_addr, dwarf_addr,
+					   sample_time);
+}
+
+void
+perf_spe_reader::note_timestamp_cb (uint64_t dwarf_addr, uint64_t timestamp,
+				    void *ctx)
+{
+  perf_spe_reader *const reader = static_cast<perf_spe_reader *> (ctx);
+  uint64_t sample_time = 0;
+  if (reader->spe_timestamp_to_perf_time (timestamp, &sample_time))
+    reader->sample_timestamps ().note (dwarf_addr, sample_time);
+}
+
+bool
+perf_spe_reader::parse_perf_data_section ()
+{
+  if (header.data_offset > mapped_size ())
+    {
+      fprintf (stderr,
+	       _("SPE: perf.data data section starts past end of file "
+		 "(data_offset=%" PRIu64 ", file_size=%zu).\n"),
+	       header.data_offset,
+	       mapped_size ());
+      return false;
+    }
+
+  size_t auxtrace_records = 0;
+  size_t aux_chunks = 0;
+  size_t mmap_records_seen = 0;
+  bool spe_aux_decode_ok = true;
+  bool aux_metadata_ok = true;
+  bool valid_mappings = true;
+  uint64_t aux_loss_records = 0;
+  uint64_t aux_truncated_records = 0;
+  uint64_t aux_overwrite_records = 0;
+  uint64_t aux_partial_records = 0;
+  uint64_t aux_collision_records = 0;
+  uint64_t aux_forward_gaps = 0;
+  uint64_t aux_overlaps = 0;
+  uint64_t skipped_bytes = 0;
+
+  reset_branch_stack_profile ();
+  range_count_map_.clear ();
+  branch_count_map_.clear ();
+  address_frequencies.clear ();
+  active_mmaps_ = nullptr;
+  active_pid_ = 0;
+  active_cpu_ = 0;
+  active_cpu_valid_ = false;
+  active_cpu_shared_ = false;
+  fallback_pid_ = 0;
+  unattributed_records_ = 0;
+  unplaced_records_ = 0;
+
+  /* Pass 1.  Bind MMAPs before address filtering (same reason as LBR).  */
+  if (!for_each_mapped_perf_data_record (
+	[&] (const perf_event_header &hdr,
+	     const uint8_t *payload,
+	     size_t payload_size,
+	     size_t)
+	{
+	  if (hdr.type == PERF_RECORD_MMAP
+	      || hdr.type == PERF_RECORD_MMAP2)
+	    {
+	      const bool valid
+		= hdr.type == PERF_RECORD_MMAP
+		    ? parse_mmap_record (payload, payload_size, hdr.misc)
+		    : parse_mmap2_record (payload, payload_size, hdr.misc);
+	      if (!valid)
+		valid_mappings = false;
+	      ++mmap_records_seen;
+	    }
+	  else if (hdr.type == PERF_RECORD_AUX)
+	    {
+	      if (payload_size < PERF_RECORD_AUX_FIXED_BYTES)
+		aux_metadata_ok = false;
+	      else
+		{
+		  uint64_t flags;
+		  std::memcpy (&flags, payload + 2 * sizeof (uint64_t),
+			       sizeof (flags));
+		  if ((flags & PERF_AUX_DATA_LOSS_FLAGS) != 0)
+		    ++aux_loss_records;
+		  if ((flags & PERF_AUX_FLAG_TRUNCATED) != 0)
+		    ++aux_truncated_records;
+		  if ((flags & PERF_AUX_FLAG_OVERWRITE) != 0)
+		    ++aux_overwrite_records;
+		  if ((flags & PERF_AUX_FLAG_PARTIAL) != 0)
+		    ++aux_partial_records;
+		  if ((flags & PERF_AUX_FLAG_COLLISION) != 0)
+		    ++aux_collision_records;
+		}
+	    }
+	  else if (hdr.type == PERF_RECORD_COMM
+		   || hdr.type == PERF_RECORD_FORK)
+	    note_process_lifetime_record (hdr, payload, payload_size);
+	  else if (hdr.type == PERF_RECORD_ITRACE_START
+		   || hdr.type == PERF_RECORD_SWITCH
+		   || hdr.type == PERF_RECORD_SWITCH_CPU_WIDE)
+	    note_cpu_schedule_record (hdr, payload, payload_size);
+	  else if (hdr.type == PERF_RECORD_TIME_CONV)
+	    note_time_conv_record (payload, payload_size);
+	},
+	perf_scan_log::SPE))
+    return false;
+  if (!valid_mappings)
+    {
+      fprintf (stderr, _("SPE: truncated MMAP or MMAP2 record\n"));
+      return false;
+    }
+  sort_cpu_schedule ();
+  close_target_mmap_time_windows ();
+  if (!target_mapping_lifetime_valid ())
+    return false;
+  if (target_mmaps_by_pid_.empty ())
+    {
+      fprintf (stderr,
+	       _("SPE: no target mappings (saw %zu MMAP/MMAP2, none matched "
+		 "-b %s)\n"),
+	       mmap_records_seen,
+	       binary_path.c_str ());
+      return false;
+    }
+
+  if (!aux_metadata_ok)
+    {
+      fprintf (stderr, _("SPE: truncated PERF_RECORD_AUX metadata\n"));
+      return false;
+    }
+  if (aux_loss_records != 0)
+    fprintf (stderr,
+	     _("Warning: %" PRIu64 " SPE AUX records report data loss "
+	       "(truncated=%" PRIu64 ", overwrite=%" PRIu64 ", partial=%"
+	       PRIu64 ", collision=%" PRIu64 ")\n"),
+	     aux_loss_records, aux_truncated_records, aux_overwrite_records,
+	     aux_partial_records, aux_collision_records);
+
+  /* Pass 2.  Decode the AUXTRACE SPE tails.  Every record is attributed to the
+     process that held its CPU when it was sampled and translated as of its
+     own timestamp, so the counts arrive keyed by DWARF lookup address.  */
+  branch_stack_edge_count_map dwarf_branches;
+  std::unordered_map<uint64_t, uint64_t> dwarf_not_taken;
+  arm_spe_profile_accumulator acc{};
+  acc.set_context = set_context_cb;
+  acc.translate_addr = translate_target_addr_cb;
+  acc.note_timestamp = note_timestamp_cb;
+  acc.ctx = this;
+  acc.branch_counts = &dwarf_branches;
+  acc.not_taken_counts = &dwarf_not_taken;
+  std::unordered_map<uint32_t, spe_stream_state> streams;
+
+  const uint8_t *const file_base = mapped_bytes ();
+
+  const bool scan_complete = for_each_mapped_perf_data_record (
+    [&] (const perf_event_header &hdr,
+	 const uint8_t *payload,
+	 size_t,
+	 size_t skip)
+    {
+      if (!spe_aux_decode_ok || hdr.type != PERF_RECORD_AUXTRACE)
+	return;
+
+      ++auxtrace_records;
+      spe_auxtrace_chunk chunk;
+      if (!spe_auxtrace_tail (hdr, payload, skip, file_base, mapped_size (),
+			      &chunk))
+	{
+	  spe_aux_decode_ok = false;
+	  fprintf (stderr,
+		   _("SPE: invalid AUXTRACE record (hdr.size=%u skip=%zu) "
+		     "at file offset %zu.\n"),
+		   (unsigned) hdr.size,
+		   skip,
+		   payload != nullptr
+		     ? static_cast<size_t> (payload - file_base)
+		     : (size_t) 0);
+	  return;
+	}
+
+      /* Zero-size tails are metadata / empty AUXTRACE.  Keep scanning.  */
+      if (chunk.tail_size == 0)
+	return;
+
+      /* A per-CPU AUXTRACE record holds the records of every traced process
+	 that ran on that CPU, so the CPU and each record's timestamp are
+	 what tell them apart.  The descriptor's thread id names only the
+	 process that opened the event, so it is a last resort.  */
+      active_cpu_ = chunk.cpu;
+      active_cpu_valid_ = true;
+      active_cpu_shared_ = cpu_runs_other_processes (chunk.cpu);
+      fallback_pid_ = 0;
+      if (!active_cpu_shared_)
+	{
+	  const auto tid_it = target_pid_by_tid_.find (chunk.tid);
+	  if (tid_it != target_pid_by_tid_.end ())
+	    fallback_pid_ = tid_it->second;
+	  else if (target_mapping_pids_.size () == 1)
+	    fallback_pid_ = *target_mapping_pids_.begin ();
+	}
+
+      ++aux_chunks;
+      spe_stream_state &stream = streams[chunk.idx];
+      if (stream.have_offset && chunk.aux_offset != stream.next_aux_offset)
+	{
+	  if (chunk.aux_offset > stream.next_aux_offset)
+	    ++aux_forward_gaps;
+	  else
+	    ++aux_overlaps;
+	  skipped_bytes += stream.decoder.skipped_bytes ();
+	  stream = spe_stream_state{};
+	}
+      if (chunk.tail_size > UINT64_MAX - chunk.aux_offset)
+	{
+	  spe_aux_decode_ok = false;
+	  fprintf (stderr,
+		   _("SPE: AUXTRACE offset and size overflow for stream %u\n"),
+		   chunk.idx);
+	  return;
+	}
+      if (!stream.have_offset)
+	stream.decoder = arm_spe_stream_decoder (chunk.aux_offset);
+      stream.next_aux_offset = chunk.aux_offset + chunk.tail_size;
+      stream.have_offset = true;
+
+      if (!stream.decoder.consume (chunk.tail, chunk.tail_size, &acc))
+	{
+	  spe_aux_decode_ok = false;
+	  fprintf (stderr,
+		   _("SPE: AUXTRACE decode failed (corrupt SPE) at file "
+		     "offset %zu, tail %zu B.\n"),
+		   static_cast<size_t> (chunk.tail - file_base),
+		   chunk.tail_size);
+	}
+    },
+    perf_scan_log::SPE);
+  active_mmaps_ = nullptr;
+  active_cpu_valid_ = false;
+
+  /* A snapshot (-S) buffer can also end mid-packet.  */
+  for (const auto &entry : streams)
+    {
+      skipped_bytes += entry.second.decoder.skipped_bytes ();
+      if (spe_aux_decode_ok && !entry.second.decoder.finish ())
+	fprintf (stderr,
+		 _("Warning: SPE AUXTRACE stream %u ends in a truncated "
+		   "packet\n"),
+		 entry.first);
+    }
+  if (skipped_bytes != 0)
+    fprintf (stderr,
+	     _("Warning: skipped %" PRIu64 " SPE byte(s) that start no "
+	       "valid packet, dropping the records they were in\n"),
+	     skipped_bytes);
+
+  if (unattributed_records_ != 0)
+    fprintf (stderr,
+	     _("Warning: %" PRIu64 " SPE record(s) dropped: no process was "
+	       "recorded as running on their CPU when they were sampled\n"),
+	     unattributed_records_);
+  if (unplaced_records_ != 0)
+    fprintf (stderr,
+	     _("Warning: %" PRIu64 " SPE record(s) dropped: their CPU also "
+	       "ran other programs, and their timestamps cannot be put on "
+	       "perf's clock to tell which one\n"),
+	     unplaced_records_);
+
+  if (aux_forward_gaps != 0 || aux_overlaps != 0)
+    fprintf (stderr,
+	     _("Warning: SPE AUX offsets have %" PRIu64 " forward gaps "
+	       "and %" PRIu64 " overlaps; dropped partial decoder state "
+	       "at each discontinuity\n"),
+	     aux_forward_gaps, aux_overlaps);
+
+  if (!spe_aux_decode_ok || !scan_complete)
+    return false;
+
+  arm_text_image text;
+  if (!text.load (binary_path))
+    {
+      fprintf (stderr,
+	       _("SPE: failed to load executable text from %s\n"),
+	       binary_path.c_str ());
+      return false;
+    }
+  arm_spe_synthesize_ranges (
+    dwarf_branches, dwarf_not_taken, text, &range_count_map_);
+  branch_count_map_ = std::move (dwarf_branches);
+  address_frequencies = std::move (dwarf_not_taken);
+  total_profile_mass
+    = spe_profile_total_mass (range_count_map_, address_frequencies);
+
+  if (total_profile_mass == 0)
+    {
+      if (auxtrace_records == 0)
+	fprintf (stderr,
+		 _("SPE: No PERF_RECORD_AUXTRACE records in %s "
+		   "(not an SPE perf.data, or empty capture).\n"),
+		 perf_data_path.c_str ());
+      else if (aux_chunks == 0)
+	fprintf (stderr,
+		 _("SPE: %zu AUXTRACE record(s) but no SPE payload "
+		   "(all empty tails) in %s.\n"),
+		 auxtrace_records,
+		 perf_data_path.c_str ());
+      else
+	fprintf (stderr,
+		 _("SPE: No profile hits matched -b %s "
+		   "(check path / build-id / MMAP; decoded %zu AUXTRACE "
+		   "tail(s)).\n"),
+		 binary_path.c_str (),
+		 aux_chunks);
+      return false;
+    }
+  publish_dwarf_branch_stack_maps (
+    range_count_map_, branch_count_map_, &sorted_touch_pcs_);
+  if (!use_branch_stack_for_correlation_)
+    seed_address_frequencies_from_ranges ();
+  return true;
+}
+
+/* SPE reports ranges, not sampled IPs, so per-PC scoring needs the range
+   mass spread over the instructions the range covers.  */
+void
+perf_spe_reader::seed_address_frequencies_from_ranges ()
+{
+  const uint64_t step = range_mass_addr_step ();
+  for (const profile_range &row : sorted_ranges_)
+    {
+      /* An unaligned start is a decode error, not an instruction address.  */
+      if (row.end < row.beg || (row.beg % step) != 0)
+	continue;
+      const uint64_t steps = (row.end - row.beg) / step + 1;
+      uint64_t pc = row.beg;
+      for (uint64_t i = 0; i < steps; ++i, pc += step)
+	/* Keep a count already recorded for this PC.  */
+	address_frequencies.emplace (pc, row.count);
+    }
+}
+
+} /* namespace perf_data.  */
