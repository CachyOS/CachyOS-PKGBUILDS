+/* Ingest one PERF_RECORD_SAMPLE.  Returns true when it contributed mass.  */
+bool
+live_branch_stack_reader::process_sample_record (const uint8_t *payload,
+						 size_t payload_size)
+{
+  if (payload_size == 0)
+    return false;
+
+  const uint8_t *ptr = payload;
+  const uint8_t *const end = payload + payload_size;
+  uint64_t ip = 0;
+  bool have_ip = false;
+  uint32_t pid = 0;
+  uint64_t sample_time = 0;
+
+  /* Not checked.  The kernel lowers the period while throttling on PMI
+     overload, so a sample can report less than the configured one.  */
+  if (!perf_event_sample_util::walk_sample_before_branch (
+	ptr, end, sample_type, 0, &ip, &have_ip, &pid, nullptr, nullptr,
+	&sample_time))
+    return false;
+
+  perf_event_sample_util::branch_stack_view branch_stack;
+  if (!perf_event_sample_util::walk_sample_branch_and_suffix (
+	ptr, end, branch_sample_type, sample_type, 0, 0, branch_stack))
+    return false;
+
+  const auto mmap_it = target_mmaps_by_pid.find (pid);
+  if (mmap_it == target_mmaps_by_pid.end ())
+    return false;
+  const std::vector<executable_mapping> &pid_mmaps = mmap_it->second;
+
+  /* The primary path uses the LBR branch stack.  Sample IP fallbacks improve
+     when the stack is empty or has no target branches.  */
+  uint64_t dwarf_ip = 0;
+  const bool ip_is_target
+    = have_ip && ip != 0
+      && try_translate_runtime_with_mmaps (pid_mmaps, ip, &dwarf_ip,
+					   sample_time);
+  bool recorded = record_sample_ip (
+    dwarf_ip, ip_is_target, sample_time, accumulate_sample_ips_,
+    address_frequencies);
+  if ((sample_type & PERF_SAMPLE_BRANCH_STACK) != 0
+      && !branch_stack.empty ()
+      && accumulate_branch_stack_sample (branch_stack,
+					 sample_timestamps (),
+					 sample_time,
+					 pid_mmaps,
+					 range_count_map,
+					 branch_count_map))
+    recorded = true;
+
+  return recorded;
+}
+
+/* Drain the records the kernel has published into the perf ring buffer,
+   handling records that wrap around its end.  */
+void
+live_branch_stack_reader::process_ring_buffer (void *mmap_base,
+					       uint64_t data_offset,
+					       uint64_t data_size,
+					       live_mapping_reader &mappings,
+					       FILE *samples,
+					       bool &write_failed)
+{
+  if (mmap_base == nullptr || data_size == 0)
+    return;
+  char *base = static_cast<char *> (mmap_base);
+  perf_event_mmap_page *meta = reinterpret_cast<perf_event_mmap_page *> (base);
+  char *data = base + data_offset;
+  uint64_t ring_size = data_size;
+
+  for (;;)
+    {
+      uint64_t head = __atomic_load_n (&meta->data_head, __ATOMIC_ACQUIRE);
+      uint64_t tail = __atomic_load_n (&meta->data_tail, __ATOMIC_RELAXED);
+      if (tail == head)
+	break;
+      if (tail > head || head - tail > ring_size)
+	{
+	  /* Once the producer has lapped the consumer, head - ring_size is
+	     not necessarily a record boundary.  Discard this snapshot rather
+	     than interpreting overwritten bytes as event headers.  */
+	  ring_overwrite = true;
+	  __atomic_store_n (&meta->data_tail, head, __ATOMIC_RELEASE);
+	  break;
+	}
+      const uint64_t initial_tail = tail;
+      while (tail != head)
+	{
+	  if (tail > head || head - tail < sizeof (perf_event_header)
+	      || ring_size < sizeof (perf_event_header))
+	    break;
+	  uint64_t offset = tail % ring_size;
+	  perf_event_header header;
+	  const size_t header_first
+	    = std::min<uint64_t> (sizeof (header), ring_size - offset);
+	  std::memcpy (&header, data + offset, header_first);
+	  if (header_first < sizeof (header))
+	    std::memcpy (reinterpret_cast<uint8_t *> (&header) + header_first,
+			 data,
+			 sizeof (header) - header_first);
+	  uint32_t size = header.size;
+	  if (size < sizeof (perf_event_header) || size > ring_size)
+	    {
+	      /* Skip the bad size, so the scan cannot loop forever.  */
+	      tail += sizeof (perf_event_header);
+	      continue;
+	    }
+	  if (size > head - tail)
+	    break;
+
+	  std::vector<uint8_t> wrap_buf;
+	  const uint8_t *payload = nullptr;
+	  if (size > ring_size - offset)
+	    {
+	      wrap_buf.resize (size);
+	      const size_t first = ring_size - offset;
+	      std::memcpy (wrap_buf.data (), data + offset, first);
+	      std::memcpy (wrap_buf.data () + first, data, size - first);
+	      payload = wrap_buf.data () + sizeof (perf_event_header);
+	    }
+	  else
+	    payload = reinterpret_cast<const uint8_t *> (data + offset)
+		      + sizeof (perf_event_header);
+	  size_t payload_size = size - sizeof (perf_event_header);
+
+	  switch (header.type)
+	    {
+	    case PERF_RECORD_SAMPLE:
+	      if (std::fwrite (&size, sizeof (size), 1, samples) != 1
+		  || std::fwrite (payload, 1, payload_size, samples)
+		       != payload_size)
+		write_failed = true;
+	      break;
+	    case PERF_RECORD_MMAP:
+	    case PERF_RECORD_MMAP2:
+	    case PERF_RECORD_COMM:
+	    case PERF_RECORD_FORK:
+	    case PERF_RECORD_EXIT:
+	      if (!mappings.add_record (header, payload, payload_size))
+		write_failed = true;
+	      break;
+	    case PERF_RECORD_LOST:
+	      /* Payload is { u64 id; u64 lost; }.  */
+	      if (payload_size >= 2 * sizeof (uint64_t))
+		{
+		  uint64_t lost;
+		  std::memcpy (&lost, payload + sizeof (uint64_t),
+			       sizeof (lost));
+		  lost_records += lost;
+		}
+	      break;
+	    case PERF_RECORD_THROTTLE:
+	      throttle_records++;
+	      break;
+	    default:
+	      break;
+	    }
+	  tail += size;
+	}
+      __atomic_store_n (&meta->data_tail, tail, __ATOMIC_RELEASE);
+      if (tail == initial_tail)
+	break;
+    }
+}
+
+/* Run the command under a branch-stack perf event and collect its profile.  */
+bool
+live_branch_stack_reader::load ()
+{
+  range_count_map.clear ();
+  branch_count_map.clear ();
+  address_frequencies.clear ();
+  reset_branch_stack_profile ();
+  reset_profile_state ();
+  target_mmaps_by_pid.clear ();
+  processed_samples = 0;
+  total_profile_mass = 0;
+  lost_records = 0;
+  throttle_records = 0;
+  ring_overwrite = false;
+  if (command_argv.empty ())
+    {
+      fprintf (stderr, _("Error: No command to run for direct profiling\n"));
+      return false;
+    }
+  if (sample_period == 0)
+    {
+      fprintf (stderr, _("Error: Live sample period must be nonzero\n"));
+      return false;
+    }
+
+  /* Prepare ATTR before fork so the parent can call perf_event_open
+     immediately (the child may exit quickly).  */
+  perf_event_attr attr = {};
+  attr.type = PERF_TYPE_HARDWARE;
+  attr.size = sizeof (attr);
+  attr.config = PERF_COUNT_HW_CPU_CYCLES;
+  attr.sample_period = sample_period;
+  attr.sample_type
+    = use_branch_stack_for_correlation_
+	? DEFAULT_BRANCH_STACK_SAMPLE_TYPE
+	: DEFAULT_BRANCH_STACK_SAMPLE_TYPE & ~PERF_SAMPLE_BRANCH_STACK;
+  attr.branch_sample_type
+    = use_branch_stack_for_correlation_ ? PERF_SAMPLE_BRANCH_ANY : 0;
+  attr.exclude_kernel = 1;
+  attr.exclude_hv = 1;
+  attr.inherit = inherit_threads ? 1 : 0;
+  attr.mmap = 1;
+  attr.mmap2 = 1;
+  attr.task = 1;
+  attr.comm = 1;
+  attr.comm_exec = 1;
+  attr.sample_id_all = 1;
+
+  /* Samples can precede their mappings in another CPU's buffer.  Save them
+     until all mapping and fork records have been collected.  */
+  std::unique_ptr<FILE, int (*) (FILE *)> samples (std::tmpfile (),
+						   std::fclose);
+  if (!samples)
+    {
+      fprintf (stderr, _("Error: cannot create temporary sample file: %s\n"),
+	       strerror (errno));
+      return false;
+    }
+  if (fcntl (fileno (samples.get ()), F_SETFD, FD_CLOEXEC) < 0)
+    {
+      fprintf (stderr, _("Error: cannot protect temporary sample file: %s\n"),
+	       strerror (errno));
+      return false;
+    }
+  live_mapping_reader mappings (binary_path, attr.sample_type);
+  bool write_failed = false;
+
+  int sync_pipe[2];
+  if (pipe (sync_pipe) != 0)
+    {
+      fprintf (stderr, _("Error: pipe failed: %s\n"), strerror (errno));
+      return false;
+    }
+
+  pid_t pid = fork ();
+  if (pid < 0)
+    {
+      fprintf (stderr, _("Error: fork failed: %s\n"), strerror (errno));
+      close (sync_pipe[0]);
+      close (sync_pipe[1]);
+      return false;
+    }
+
+  if (pid == 0)
+    {
+      /* We start the command here.  We block in read () until the parent
+	 attaches perf, then exec.  */
+      close (sync_pipe[1]);
+      char ignore;
+      if (read (sync_pipe[0], &ignore, 1) != 1)
+	_exit (126);
+      close (sync_pipe[0]);
+      std::vector<char *> argv;
+      for (auto &s : command_argv)
+	argv.push_back (const_cast<char *> (s.c_str ()));
+      argv.push_back (nullptr);
+      execvp (argv[0], argv.data ());
+      fprintf (stderr, _("Error: execvp %s failed: %s\n"), argv[0],
+	       strerror (errno));
+      _exit (127);
+    }
+
+  /* Parent.  Attach perf to the child, which is blocked in read () and so
+     cannot exit.  */
+  close (sync_pipe[0]);
+
+  const size_t page_size = static_cast<size_t> (sysconf (_SC_PAGESIZE));
+
+  /* An inheriting event cannot be mmapped with cpu == -1, so following the
+     workload's threads costs one event per CPU.  Without it a single event
+     covers the whole workload.  */
+  const std::vector<int> cpus
+    = attr.inherit ? usable_cpu_ids () : std::vector<int>{-1};
+  const size_t data_pages = ring_data_pages (page_size, ring_buffer_kb);
+  std::vector<cpu_ring_buffer> buffers;
+  int open_errno = 0;
+  int mmap_errno = 0;
+  /* TODO: profile a cgroup, by opening the events on a cgroup fd with
+     PERF_FLAG_PID_CGROUP rather than on the child's pid.  */
+  for (const int cpu : cpus)
+    {
+      const long opened = sys_perf_event_open (&attr, pid, cpu, -1, 0);
+      if (opened < 0)
+	{
+	  if (open_errno == 0)
+	    open_errno = errno;
+	  continue;
+	}
+      cpu_ring_buffer buffer;
+      buffer.fd = static_cast<int> (opened);
+      if (!map_cpu_ring_buffer (buffer, page_size, data_pages))
+	{
+	  if (mmap_errno == 0)
+	    mmap_errno = errno;
+	  close (buffer.fd);
+	  continue;
+	}
+      buffers.push_back (buffer);
+    }
+
+  if (buffers.empty ())
+    {
+      close (sync_pipe[1]);
+      reap_child (pid);
+      if (open_errno != 0 && use_branch_stack_for_correlation_)
+	fprintf (stderr,
+		 _("Error: live capture requires LBR/BRBE branch-stack support"
+		   " (perf_event_open failed: %s)\n"),
+		 strerror (open_errno));
+      else if (open_errno != 0)
+	fprintf (stderr, _("Error: live perf_event_open failed: %s\n"),
+		 strerror (open_errno));
+      else
+	fprintf (stderr, _("Error: mmap perf buffer failed: %s\n"),
+		 strerror (mmap_errno));
+      fprintf (stderr,
+	       _("  Check kernel.perf_event_paranoid or grant CAP_PERFMON to "
+		 "afdo_create; do not run the profiled workload as root.\n"));
+      fprintf (stderr,
+	       _("  Offline mode (-p <perf.data>) still works without live"
+		 " branch-stack.\n"));
+      return false;
+    }
+  /* A missing CPU can also hide an inherited task's exit record.  */
+  if (buffers.size () != cpus.size ())
+    {
+      fprintf (stderr, _("Error: cannot profile all CPUs (%s)\n"),
+	       strerror (open_errno != 0 ? open_errno : mmap_errno));
+      for (const cpu_ring_buffer &buffer : buffers)
+	{
+	  munmap (buffer.base, buffer.len);
+	  close (buffer.fd);
+	}
+      close (sync_pipe[1]);
+      reap_child (pid);
+      return false;
+    }
+
+  sample_type = attr.sample_type;
+  branch_sample_type = attr.branch_sample_type;
+
+  /* Find each data area, ignoring a layout that would read past the
+     mapping.  */
+  for (cpu_ring_buffer &buffer : buffers)
+    {
+      const perf_event_mmap_page *meta
+	= static_cast<const perf_event_mmap_page *> (buffer.base);
+      buffer.data_offset = meta->data_offset;
+      buffer.data_size = meta->data_size;
+      if (buffer.data_size == 0 || buffer.data_offset >= buffer.len
+	  || buffer.data_size > buffer.len - buffer.data_offset)
+	{
+	  buffer.data_offset = page_size;
+	  buffer.data_size = buffer.len - page_size;
+	}
+    }
+
+  int enable_errno = 0;
+  for (const cpu_ring_buffer &buffer : buffers)
+    if (ioctl (buffer.fd, PERF_EVENT_IOC_ENABLE, 0) < 0)
+      {
+	enable_errno = errno;
+	break;
+      }
+  if (enable_errno != 0)
+    {
+      fprintf (stderr, _("Error: PERF_EVENT_IOC_ENABLE failed: %s\n"),
+	       strerror (enable_errno));
+      for (const cpu_ring_buffer &buffer : buffers)
+	{
+	  munmap (buffer.base, buffer.len);
+	  close (buffer.fd);
+	}
+      close (sync_pipe[1]);
+      reap_child (pid);
+      return false;
+    }
+  /* Unblock child only after perf is enabled.  */
+  {
+    char one = 1;
+    ssize_t written;
+    do
+      written = write (sync_pipe[1], &one, 1);
+    while (written < 0 && errno == EINTR);
+    /* Closing the write end unblocks the child either way, but on a short
+       write it reads EOF and exits instead of running the workload.  */
+    if (written != 1)
+      fprintf (stderr,
+	       _("Error: could not release the profiled workload: %s\n"),
+	       strerror (errno));
+    close (sync_pipe[1]);
+  }
+
+  fprintf (stderr,
+	   use_branch_stack_for_correlation_
+	     ? _("Profiling %s (PID %d, branch-stack)...\n")
+	     : _("Profiling %s (PID %d, sampled IPs)...\n"),
+	   command_argv[0].c_str (),
+	   pid);
+  int status = 0;
+  bool have_status = false;
+  int epoll_fd = -1;
+  std::vector<pollfd> pfds;
+  pfds.reserve (buffers.size ());
+  for (const cpu_ring_buffer &buffer : buffers)
+    pfds.push_back (pollfd{buffer.fd, POLLIN, 0});
+  /* TODO: drain the buffers from several threads, so that a machine with many
+     CPUs does not bottleneck on this one.  */
+  for (;;)
+    {
+      if (!have_status)
+	{
+	  const pid_t reaped = waitpid (pid, &status, WNOHANG);
+	  if (reaped == pid)
+	    have_status = true;
+	  else if (reaped < 0 && errno != EINTR)
+	    break;
+	}
+      if (have_status)
+	{
+	  /* Fork and exit records can arrive from different CPU buffers.  */
+	  const uint64_t previous_changes = mappings.task_changes ();
+	  for (const cpu_ring_buffer &buffer : buffers)
+	    process_ring_buffer (buffer.base, buffer.data_offset,
+				 buffer.data_size, mappings, samples.get (),
+				 write_failed);
+	  const bool live_tasks = mappings.has_live_tasks ();
+	  if (!inherit_threads || write_failed || lost_records != 0
+	      || ring_overwrite
+	      || (!live_tasks
+		  && previous_changes == mappings.task_changes ()))
+	    break;
+	  if (!live_tasks)
+	    continue;
+	  /* Edge-triggered polling avoids repeatedly waking on the original
+	     task's POLLHUP while inherited events are still active.  */
+	  if (epoll_fd < 0)
+	    {
+	      epoll_fd = epoll_create1 (EPOLL_CLOEXEC);
+	      if (epoll_fd < 0)
+		{
+		  write_failed = true;
+		  break;
+		}
+	      for (const cpu_ring_buffer &buffer : buffers)
+		{
+		  epoll_event event{};
+		  event.events = EPOLLIN | EPOLLET;
+		  if (epoll_ctl (epoll_fd, EPOLL_CTL_ADD, buffer.fd, &event) < 0)
+		    {
+		      write_failed = true;
+		      break;
+		    }
+		}
+	      if (write_failed)
+		break;
+	    }
+	  epoll_event event;
+	  if (epoll_wait (epoll_fd, &event, 1, 100) < 0 && errno != EINTR)
+	    {
+	      write_failed = true;
+	      break;
+	    }
+	  continue;
+	}
+      const int r = poll (pfds.data (), pfds.size (), 100);
+      if (r < 0 && errno != EINTR)
+	{
+	  /* Without poll () there is nothing left to pace this loop, so stop
+	     draining incrementally and wait for the workload instead.  */
+	  fprintf (stderr,
+		   _("Warning: poll on the perf event fds failed: %s\n"),
+		   strerror (errno));
+	  break;
+	}
+      if (r <= 0)
+	continue;
+      for (size_t i = 0; i < buffers.size (); ++i)
+	if ((pfds[i].revents & POLLIN) != 0)
+	  process_ring_buffer (buffers[i].base, buffers[i].data_offset,
+			       buffers[i].data_size, mappings, samples.get (),
+			       write_failed);
+    }
+  if (epoll_fd >= 0)
+    close (epoll_fd);
+  int reap_errno = 0;
+  if (!have_status)
+    {
+      have_status = reap_child (pid, &status);
+      if (!have_status)
+	reap_errno = errno;
+    }
+
+  /* Closing the fds below stops sampling, so a failed disable costs nothing
+     beyond the records already drained.  */
+  for (const cpu_ring_buffer &buffer : buffers)
+    {
+      process_ring_buffer (buffer.base, buffer.data_offset, buffer.data_size,
+			   mappings, samples.get (), write_failed);
+      if (ioctl (buffer.fd, PERF_EVENT_IOC_DISABLE, 0) < 0)
+	fprintf (stderr, _("Warning: PERF_EVENT_IOC_DISABLE failed: %s\n"),
+		 strerror (errno));
+      munmap (buffer.base, buffer.len);
+      close (buffer.fd);
+    }
+
+  if (lost_records != 0)
+    fprintf (stderr,
+	     _("Warning: kernel dropped %" PRIu64 " perf records; raise"
+	       " --sample-period to sample less often\n"),
+	     lost_records);
+  /* Throttling stops the event until the rate falls, so whatever ran during
+     it is under-represented.  */
+  if (throttle_records != 0)
+    fprintf (stderr,
+	     _("Warning: the kernel throttled sampling %" PRIu64 " time(s);"
+	       " raise --sample-period to sample less often\n"),
+	     throttle_records);
+  if (ring_overwrite)
+    fprintf (stderr,
+	     _("Warning: the perf ring buffer was overwritten; discarded "
+	       "an incomplete snapshot.  Raise --sample-period to sample "
+	       "less often\n"));
+
+  if (lost_records != 0 || ring_overwrite)
+    {
+      fprintf (stderr, _("Error: live profile is incomplete\n"));
+      return false;
+    }
+
+  if (!have_status)
+    fprintf (stderr,
+	     _("Warning: could not reap the profiled workload (%s); its exit"
+	       " status is unknown and the profile may be incomplete\n"),
+	     strerror (reap_errno));
+  else if (WIFEXITED (status) && WEXITSTATUS (status) == 0)
+    fprintf (stderr, _("Process exited with code 0\n"));
+  else if (WIFEXITED (status))
+    fprintf (stderr,
+	     _("Warning: process exited with code %d; the workload did not"
+	       " run to completion and the profile may be incomplete\n"),
+	     WEXITSTATUS (status));
+  else if (WIFSIGNALED (status))
+    fprintf (stderr,
+	     _("Warning: process killed by signal %d (e.g.  SIGSEGV); profile"
+	       " may be incomplete.\n"),
+	     WTERMSIG (status));
+
+  if (write_failed || std::fflush (samples.get ()) != 0
+      || std::fseek (samples.get (), 0, SEEK_SET) != 0)
+    {
+      fprintf (stderr, _("Error: cannot save live samples or read mappings\n"));
+      return false;
+    }
+  if (!mappings.finish (target_mmaps_by_pid))
+    return false;
+  std::vector<uint8_t> payload;
+  for (;;)
+    {
+      uint32_t size;
+      const size_t bytes = std::fread (&size, 1, sizeof (size), samples.get ());
+      if (bytes != sizeof (size))
+	{
+	  if (bytes == 0 && std::feof (samples.get ()))
+	    break;
+	  fprintf (stderr, _("Error: cannot read live samples\n"));
+	  return false;
+	}
+      if (size < sizeof (perf_event_header))
+	return false;
+      payload.resize (size - sizeof (perf_event_header));
+      if (std::fread (payload.data (), 1, payload.size (), samples.get ())
+	  != payload.size ())
+	{
+	  fprintf (stderr, _("Error: cannot read live samples\n"));
+	  return false;
+	}
+      if (process_sample_record (payload.data (), payload.size ()))
+	++processed_samples;
+    }
+
+  if (target_mmaps_by_pid.empty ())
+    {
+      fprintf (stderr,
+	       _("Error: No memory mappings found for target binary '%s'\n"),
+	       path_basename (binary_path.c_str ()));
+      return false;
+    }
+  if (range_count_map.empty () && branch_count_map.empty ()
+      && address_frequencies.empty ())
+    {
+      fprintf (stderr,
+	       use_branch_stack_for_correlation_
+		 ? _("Error: No branch-stack samples collected (binary "
+		     "may not match or workload too short)\n")
+		 : _("Error: No sampled IPs collected (binary may not match "
+		     "or workload too short)\n"));
+      return false;
+    }
+
+  fprintf (stderr,
+	   _("Collected %" PRIu64 " samples, %zu ranges, %zu branches"),
+	   processed_samples,
+	   range_count_map.size (),
+	   branch_count_map.size ());
+  if (!address_frequencies.empty ())
+    fprintf (stderr, _(", %zu sample IPs"), address_frequencies.size ());
+  fprintf (stderr, "\n");
+  finalize_profile_after_capture ();
+  /* Report mass like offline, not raw record count.  */
+  if (!sorted_ranges_.empty ())
+    total_profile_mass = total_mass_from_range_counts (sorted_ranges_);
+  else
+    total_profile_mass
+      = total_mass_from_address_frequencies (address_frequencies);
+  return true;
+}
+
+/* Publish the profile, whose samples were translated through PID-scoped
+   mappings while being ingested.  */
+void
+live_branch_stack_reader::finalize_profile_after_capture ()
+{
+  publish_dwarf_branch_stack_maps (
+    range_count_map, branch_count_map, &sorted_touch_pcs_);
+  target_mmaps_by_pid.clear ();
+  target_mmaps_by_pid.rehash (0);
+}
+
+} /* namespace perf_data.  */
