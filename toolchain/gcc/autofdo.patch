+  {
+    branch_stack_finalized_ = false;
+    sorted_ranges_.clear ();
+    sorted_branches_.clear ();
+  }
+
+  /* Publish maps whose keys are already DWARF addresses.  */
+  void publish_dwarf_branch_stack_maps
+    (branch_stack_edge_count_map &range_count_map,
+     branch_stack_edge_count_map &branch_count_map,
+     std::vector<uint64_t> *touch_pcs_out);
+
+  /* Collect the unique sorted range endpoints into TOUCH_PCS.  */
+  void
+  build_sorted_touch_pcs_from_ranges (std::vector<uint64_t> *touch_pcs) const;
+
+  /* Fold one sample's branch stack into the range and edge maps.  Returns
+     true when anything was accumulated.  */
+  bool accumulate_branch_stack_sample
+    (const perf_event_sample_util::branch_stack_view &entries,
+     sample_timestamp_collector &timestamps, uint64_t sample_time,
+     const std::vector<executable_mapping> &target_mmaps,
+     branch_stack_edge_count_map &range_count_map,
+     branch_stack_edge_count_map &branch_count_map) const;
+};
