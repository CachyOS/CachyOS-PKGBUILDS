diff --git a/afdo_tools/src/branch_stack_reader_base.cc b/afdo_tools/src/branch_stack_reader_base.cc
new file mode 100644
index 00000000000..e0575b9ca89
--- /dev/null
+++ b/afdo_tools/src/branch_stack_reader_base.cc
@@ -0,0 +1,256 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "branch_stack_reader_base.h"
+
+#include "profile_reader.h"
+
+#include <algorithm>
+#include <cstddef>
+
+namespace perf_data {
+namespace {
+
+/* Upper bound on a plausible fall-through range between two consecutive
+   branches.  Anything larger is treated as a bogus/wrong-path LBR interval and
+   dropped rather than inflating range mass.  */
+constexpr uint64_t MAX_BETWEEN_BRANCH_RANGE_BYTES = 1ull << 20;
+
+/* Some LBR implementations record the most recent branch twice: once as the
+   stack head and again as the next entry.  We only treat the second entry as a
+   spurious duplicate of the head when it is an exact copy and represents a
+   large backward edge (a loop backedge), which is where the quirk appears.  */
+constexpr uint64_t MIN_DUPLICATE_HEAD_BACKEDGE_BYTES = 1u << 12;
+
+bool
+branch_entry_wrong_path (uint64_t flags) noexcept
+{
+  return (flags & perf_branch_spec::MASK) == perf_branch_spec::WRONG_PATH;
+}
+
+size_t
+skip_wrong_path_prefix (const perf_branch_stack_entry *entries, size_t n)
+{
+  size_t i = 0;
+  while (i < n && branch_entry_wrong_path (entries[i].flags))
+    ++i;
+  return i;
+}
+
+bool
+valid_between_branch_range (uint64_t begin, uint64_t end) noexcept
+{
+  return end >= begin && end - begin <= MAX_BETWEEN_BRANCH_RANGE_BYTES;
+}
+
+void
+accumulate_branch_edge (branch_stack_edge_count_map &branch_count_map,
+			uint64_t from, uint64_t to, uint64_t period)
+{
+  branch_count_map[{from, to}] += period;
+}
+
+} /* namespace.  */
+
+/* LBR ingest: skip WRONG_PATH at stack head; record head branch; walk older
+   entries for [to, prev.from) ranges and explicit (from, to) edges.  */
+bool
+branch_stack_reader_base::accumulate_branch_stack_sample (
+  const perf_branch_stack_entry *entries, uint64_t num_branches,
+  uint64_t period, profile_reader &timestamps, uint64_t sample_time,
+  const std::vector<simple_mmap> &target_mmaps,
+  const std::vector<std::pair<uint64_t, uint64_t>> *sorted_ranges,
+  branch_stack_edge_count_map &range_count_map,
+  branch_stack_edge_count_map &branch_count_map) const
+{
+  if (entries == nullptr || num_branches == 0
+      || num_branches > static_cast<uint64_t> (SIZE_MAX))
+    return false;
+
+  const size_t n = static_cast<size_t> (num_branches);
+  const size_t start = skip_wrong_path_prefix (entries, n);
+  if (start >= n)
+    return false;
+
+  bool any = false;
+
+  /* LBR/BRBE has no per-entry timestamps.  Use the enclosing sample time as
+     an upper bound for accepted branch and range endpoints.  */
+  const perf_branch_stack_entry &head = entries[start];
+  if (target_address_contained (target_mmaps, sorted_ranges, head.to)
+      && target_address_contained (target_mmaps, sorted_ranges, head.from))
+    {
+      accumulate_branch_edge (branch_count_map, head.from, head.to, period);
+      timestamps.note_sample_timestamp (head.from, sample_time);
+      timestamps.note_sample_timestamp (head.to, sample_time);
+      any = true;
+    }
+
+  for (size_t i = start + 1; i < n; ++i)
+    {
+      const perf_branch_stack_entry &e = entries[i];
+      if (branch_entry_wrong_path (e.flags))
+	continue;
+      /* Skip the spurious duplicate of the stack head (see
+	 MIN_DUPLICATE_HEAD_BACKEDGE_BYTES): only the entry immediately after
+	 the (possibly skipped) head, only when it exactly copies that head, and
+	 only for a large backward edge.  */
+      if (i == start + 1 && head.from == e.from && head.to == e.to
+	  && e.from > e.to && e.from - e.to > MIN_DUPLICATE_HEAD_BACKEDGE_BYTES)
+	continue;
+      if (!target_address_contained (target_mmaps, sorted_ranges, e.to))
+	continue;
+
+      const uint64_t begin = e.to;
+      const uint64_t end = entries[i - 1].from;
+      if (!valid_between_branch_range (begin, end))
+	continue;
+
+      range_count_map[{begin, end}] += period;
+      timestamps.note_sample_timestamp (begin, sample_time);
+      any = true;
+
+      if (target_address_contained (target_mmaps, sorted_ranges, e.from))
+	{
+	  accumulate_branch_edge (branch_count_map, e.from, e.to, period);
+	  timestamps.note_sample_timestamp (e.from, sample_time);
+	  any = true;
+	}
+    }
+  return any;
+}
+
+void
+branch_stack_reader_base::finalize_branch_stack_to_file_offsets (
+  branch_stack_edge_count_map &range_count_map,
+  branch_stack_edge_count_map &branch_count_map,
+  const std::vector<simple_mmap> &target_mmaps)
+{
+  branch_stack_edge_count_map file_ranges;
+  file_ranges.reserve (range_count_map.size ());
+  size_t range_hint = static_cast<size_t> (-1);
+  for (const auto &entry : range_count_map)
+    {
+      const branch_stack_edge &range = entry.first;
+      const uint64_t count = entry.second;
+      uint64_t beg = 0;
+      uint64_t end = 0;
+      if (!translate_runtime_range_with_mmaps (
+	    target_mmaps, range.first, range.second, &beg, &end, &range_hint))
+	continue;
+      if (end < beg)
+	continue;
+      file_ranges[{beg, end}] += count;
+    }
+  range_count_map.clear ();
+  range_count_map.rehash (0);
+
+  sorted_ranges_.clear ();
+  sorted_ranges_.reserve (file_ranges.size ());
+  for (const auto &entry : file_ranges)
+    {
+      const branch_stack_edge &range = entry.first;
+      const uint64_t count = entry.second;
+      sorted_ranges_.push_back (
+	profile_range{range.first, range.second, count});
+    }
+  file_ranges.clear ();
+  std::sort (sorted_ranges_.begin (), sorted_ranges_.end ());
+
+  branch_stack_edge_count_map file_branches;
+  file_branches.reserve (branch_count_map.size ());
+  for (const auto &entry : branch_count_map)
+    {
+      const branch_stack_edge &edge = entry.first;
+      const uint64_t count = entry.second;
+      uint64_t from = 0;
+      uint64_t to = 0;
+      if (!try_translate_runtime_with_mmaps (target_mmaps, edge.first, &from)
+	  || !try_translate_runtime_with_mmaps (target_mmaps, edge.second, &to))
+	continue;
+      file_branches[{from, to}] += count;
+    }
+  branch_count_map.clear ();
+  branch_count_map.rehash (0);
+
+  sorted_branches_.clear ();
+  sorted_branches_.reserve (file_branches.size ());
+  for (const auto &entry : file_branches)
+    {
+      const branch_stack_edge &edge = entry.first;
+      const uint64_t count = entry.second;
+      sorted_branches_.push_back (
+	profile_branch{edge.first, edge.second, count});
+    }
+  file_branches.clear ();
+  std::sort (sorted_branches_.begin (), sorted_branches_.end ());
+
+  branch_stack_finalized_ = true;
+}
+
+void
+branch_stack_reader_base::build_sorted_touch_pcs_from_ranges (
+  std::vector<uint64_t> *touch_pcs) const
+{
+  if (touch_pcs == nullptr || sorted_ranges_.empty ())
+    return;
+
+  touch_pcs->clear ();
+  touch_pcs->reserve (sorted_ranges_.size () * 2);
+  for (const profile_range &row : sorted_ranges_)
+    {
+      touch_pcs->push_back (row.beg);
+      touch_pcs->push_back (row.end);
+    }
+  std::sort (touch_pcs->begin (), touch_pcs->end ());
+  touch_pcs->erase (
+    std::unique (touch_pcs->begin (), touch_pcs->end ()), touch_pcs->end ());
+}
+
+void
+branch_stack_reader_base::materialize_address_frequencies_from_range_counts (
+  std::unordered_map<uint64_t, uint64_t> &address_frequencies,
+  uint64_t addr_step, bool skip_existing_pcs) const
+{
+  if (addr_step == 0)
+    addr_step = 1;
+  for (const profile_range &row : sorted_ranges_)
+    {
+      if (row.end < row.beg)
+	continue;
+      if (addr_step > 1 && (row.beg % addr_step) != 0)
+	continue;
+      const uint64_t span = row.end - row.beg;
+      const uint64_t steps = span / addr_step + 1;
+      for (uint64_t step = 0; step < steps; ++step)
+	{
+	  const uint64_t addr = row.beg + step * addr_step;
+	  if (addr > row.end)
+	    break;
+	  if (skip_existing_pcs)
+	    {
+	      if (!address_frequencies.emplace (addr, row.count).second)
+		continue;
+	    }
+	  else
+	    address_frequencies[addr] += row.count;
+	}
+    }
+}
+
+} /* namespace perf_data.  */
