+namespace dwarf_debug {
+
+/* Per-thread libdw open (handles are not thread-safe).  */
+struct libdw_file_session
+{
+  int fd = -1;
+  Dwarf *dwarf = nullptr;
+};
+
+struct function_root_metadata
+{
+  interned_string file_path = nullptr;
+  uint32_t decl_line = 0;
+};
+
+using intern_string_set = std::set<std::string, std::less<>>;
+
+/* Thread-safe interned-string pool (stable pointer identity).  */
+class StringPool
+{
+public:
+  static constexpr size_t SHARD_COUNT = 32;
+
+  interned_string intern (const std::string &str);
+  interned_string intern (const char *str)
+  {
+    if (str == nullptr || str[0] == '\0')
+      return nullptr;
+    return intern_cstr (str);
+  }
+  interned_string lookup (const std::string &str) const;
+  interned_string lookup (const char *str) const;
+
+private:
+  interned_string intern_cstr (const char *str);
+
+  static size_t shard (const std::string &str)
+  {
+    return std::hash<std::string>{}(str) % SHARD_COUNT;
+  }
+
+  std::array<intern_string_set, SHARD_COUNT> shards_{};
+  mutable std::array<std::mutex, SHARD_COUNT> shard_mus_{};
+};
+
+struct cu_range_index_entry
+{
+  uint64_t start = 0;
+  uint64_t end = 0;
+  Dwarf_Off cu_off = 0;
+};
+
+struct cu_line_row
+{
+  uint64_t addr = 0;
+  uint32_t run_line = 0;
+  uint32_t disc = 0;
+  interned_string file_path = nullptr;
+  bool is_stmt = false;
+  /* DW_LNE_end_sequence row: bounds the preceding segment and carries no
+     source location of its own.  */
+  bool is_end_sequence = false;
+};
+
+/* One PC range of an inlined_subroutine DIE; stack is shared across the
+   DIE's discontiguous ranges.  */
+struct inline_stack_span
+{
+  uint64_t start = 0;
+  uint64_t end = 0;
+  std::shared_ptr<const std::vector<inline_frame>> stack;
+
+  bool operator< (const inline_stack_span &other) const
+  {
+    return start < other.start;
+  }
+};
+
+struct address_range_index_span
+{
+  size_t begin = 0;
+  size_t end = 0;
+};
+
+/* One contiguous .debug_line span; duplicate-PC variants share start/end.  */
+struct line_table_span_entry
+{
+  uint64_t start = 0;
+  uint64_t end = 0;
+  uint64_t line_table_pc = 0;
+};
+
+struct range_max_tree_index
+{
+  size_t leaf_base = 0;
+  std::vector<uint64_t> max_ends;
+};
+
+/* Sample-scoped DWARF + ELF symtab index (pimpl for dwarf_reader).  */
+class dwarf_reader_impl
+{
+public:
+  /* Sampled [start,end) file-offset ranges (merged internally).  */
+  explicit dwarf_reader_impl (
+    std::string binary_path,
+    std::vector<std::pair<uint64_t, uint64_t>> sampled_ranges,
+    bool debug_enabled = false);
+  ~dwarf_reader_impl ();
+
+  dwarf_reader_impl (const dwarf_reader_impl &) = delete;
+  dwarf_reader_impl &operator= (const dwarf_reader_impl &) = delete;
+
+  /* Lifecycle.  */
+  void set_parse_threads (unsigned n);
+  bool load ();
+  const dwarf_load_summary &load_summary () const { return load_summary_; }
+
+  /* Symtab / containing function.  */
+  const std::vector<function_metadata> &symtab_functions () const;
+  const std::vector<function_alias_metadata> &symtab_aliases () const
+  {
+    return symtab_aliases_;
+  }
+  const function_metadata *containing_function_at_pc (uint64_t address) const;
+
+  /* Symbolize + inline stack.  */
+  symbolized_result symbolize (uint64_t file_offset, correlate_session &session,
+			       const function_metadata *containing_function
+			       = nullptr) const;
+  void collect_line_span_seed_pcs (uint64_t start, uint64_t end,
+				   std::vector<uint64_t> &out) const;
+  inline_function_identity
+  resolve_inline_frame_identity (const inline_frame &frame,
+				 const std::string &caller_file) const;
+
+private:
+  /* Nested load / parse types.  */
+  struct address_range_entry
+  {
+    uint64_t start = 0;
+    uint64_t end = 0;
+    source_location loc;
+    /* .debug_line metadata for this span.  */
+    uint32_t line_row_seq = 0;
+    bool line_table_primary = false;
+    bool line_table_is_stmt = false;
+    uint64_t line_table_pc = 0;
+
+    bool operator< (const address_range_entry &other) const
+    {
+      return start < other.start;
+    }
+  };
+
+  struct address_range_local_entry
+  {
+    uint64_t start = 0;
+    uint64_t end = 0;
+    interned_string file_path = nullptr;
+    uint32_t line_number = 0;
+    uint32_t discriminator = 0;
+    /* Index of the last .debug_line row (within the CU) that contributed this
+       (file,line) variant.  */
+    uint32_t line_row_seq = 0;
+    /* Primary variant at a duplicate PC (final line-table row).  */
+    bool line_table_primary = false;
+    bool line_table_is_stmt = false;
+    /* .debug_line Address column for this variant's duplicate-PC group.  */
+    uint64_t line_table_pc = 0;
+  };
+
+  struct cu_lines
+  {
+    Dwarf_Off cu_off = 0;
+    std::vector<cu_line_row> line_rows;
+    std::vector<address_range_local_entry> ranges;
+  };
+
+  struct cu_dies
+  {
+    Dwarf_Off cu_off = 0;
+    std::vector<inline_stack_span> inline_spans;
+  };
+
+  struct cu_parse_symbols
+  {
+    cu_lines lines;
+    cu_dies dies;
+    std::vector<function_metadata> symbols;
+    bool parsed = false;
+  };
+
+  /* Reusable working memory for the CU DIE-tree walk (per worker thread).  */
+  struct cu_die_parser
+  {
+    std::vector<std::pair<uint64_t, uint64_t>> pc_ranges;
+    std::vector<inline_frame> inline_stack;
+    /* Ancestor PC ranges; reject child ranges not a subset of the parent.  */
+    std::vector<std::vector<std::pair<uint64_t, uint64_t>>> inline_ranges_stack;
+
+    void reset_for_cu () noexcept
+    {
+      pc_ranges.clear ();
+      inline_stack.clear ();
+      inline_ranges_stack.clear ();
+    }
+  };
+
+  /* Load orchestration.  */
+  unsigned dwarf_parse_thread_count () const;
+  void log_dwarf_load_debug_summary (double open_sec, double ranges_sec,
+				     double symtab_sec, double anchors_sec,
+				     double load_sec) const;
+  bool open_binary_dwarf ();
+  void close_line_dwarf ();
+  bool build_cu_range_index (Dwarf_Aranges *aranges, size_t naranges);
+  bool build_address_range_index ();
+  void resolve_touch_symtab_export_anchors ();
+  void resolve_symtab_export_anchor (function_metadata &sym,
+				     correlate_session &session);
+
+  /* Sample-scope predicates.  */
+  bool range_overlaps_sampled (uint64_t lo, uint64_t hi) const
+  {
+    if (profile_sample_ranges_.empty () || hi <= lo)
+      return false;
+    /* First interval whose exclusive end is past lo; it overlaps [lo,hi)
+       iff it also begins before hi.  */
+    auto it = std::upper_bound (
+      profile_sample_ranges_.begin (),
+      profile_sample_ranges_.end (),
+      lo,
+      [] (uint64_t v, const std::pair<uint64_t, uint64_t> &r) {
+	return v < r.second;
+      });
+    return it != profile_sample_ranges_.end () && it->first < hi;
+  }
+
+  bool function_overlaps_sampled (const function_metadata &func) const
+  {
+    if (func.end_addr <= func.start_addr)
+      return false;
+    return range_overlaps_sampled (func.start_addr, func.end_addr);
+  }
+
+  bool address_range_overlaps_sampled (
+    uint64_t range_start, uint64_t range_end_excl,
+    const std::vector<function_metadata> *cu_local_functions = nullptr) const
+  {
+    if (range_end_excl <= range_start)
+      return false;
+    if (range_overlaps_sampled (range_start, range_end_excl))
+      return true;
+    /* Cold row/scope of an otherwise-sampled function in this CU: retain the
+       whole function's line table once any part is sampled.  Only the CU-local
+       subprogram list is consulted ? line rows belong to this CU's DIE tree. */
+    if (cu_local_functions == nullptr)
+      return false;
+    for (const function_metadata &func : *cu_local_functions)
+      {
+	if (func.end_addr <= func.start_addr)
+	  continue;
+	if (func.start_addr < range_end_excl && range_start < func.end_addr
+	    && function_overlaps_sampled (func))
+	  return true;
+      }
+    return false;
+  }
+
+  /* CU parse + merge.  */
+  bool parse_profile_cus (unsigned num_threads, bool use_parallel);
+  bool parse_cu_symbols (Dwarf *dwarf, Dwarf_Off cu_off, cu_lines &lines_out,
+			 cu_dies &dies_out,
+			 std::vector<function_metadata> &symbols_out,
+			 cu_die_parser &parser) const;
+  void parse_cu_die_tree_recursive (Dwarf_Die *die, cu_dies &dies_out,
+				    std::vector<function_metadata> &symbols_out,
+				    cu_die_parser &parser) const;
+  void decode_cu_line_rows (Dwarf_Lines *lines, size_t nlines,
+			    cu_lines &out) const;
+  void emit_cu_line_ranges (
+    cu_lines &out, uint64_t cu_end_excl,
+    const std::vector<function_metadata> &cu_local_functions) const;
+  void record_subprogram_metadata (
+    Dwarf_Die *die, std::vector<function_metadata> &symbols_out) const;
+  bool visit_inlined_subroutine_die (Dwarf_Die &die, cu_die_parser &parser,
+				     cu_dies &dies_out) const;
+  static void
+  clear_cu_parse_symbols (cu_lines &lines_out, cu_dies &dies_out,
+			  std::vector<function_metadata> &symbols_out);
+  void merge_cu_lines (cu_lines &buf);
+  void merge_cu_dies (cu_dies &buf);
+  void merge_cu_parse_symbols (cu_lines &lines_out, cu_dies &dies_out,
+			       std::vector<function_metadata> &symbols_out);
+  void merge_consecutive_address_ranges ();
+
+  /* Post-parse indexes.  */
+  void build_symtab_func_index ();
+  void build_dwarf_func_name_index ();
+  void build_symtab_name_equivalence_index ();
+  void build_line_table_spans_index ();
+
+  /* Line-table / address-range lookup.  */
+  const std::vector<inline_frame> *inline_stack_at_pc (uint64_t pc) const;
+  bool lookup_primary_source_location_at_address (uint64_t address,
+						  source_location &out) const;
+  bool pick_tightest_line_location (uint64_t address,
+				    source_location &out) const;
+  void consider_tightest_line_candidate (
+    uint64_t address, const address_range_entry &entry, bool &have_best,
+    source_location &best_loc, uint64_t &best_start,
+    uint32_t &best_line_row_seq, bool &best_line_table_primary) const;
+  static bool same_line_table_coalesce_group (const address_range_entry &a,
+					      const address_range_entry &b);
+
+  /* Symbolize (on-demand; session scratch).  */
+  bool
+  build_correlate_location_at_pc (uint64_t file_offset,
+				  const function_metadata *containing_function,
+				  source_location &out) const;
+  bool
+  build_correlate_locations_at_pc (uint64_t file_offset,
+				   const function_metadata *containing_function,
+				   std::vector<source_location> &out,
+				   size_t &dwarf_line_index) const;
+
+  /* Decl helpers used by the public identity API.  */
+  template <typename F>
+  bool visit_symtab_equiv_indices (const std::string &key, F fn) const
+  {
+    const auto it = symtab_equiv_index_.find (string_pool_.lookup (key));
+    if (it == symtab_equiv_index_.end ())
+      return false;
+    for (size_t idx : it->second)
+      if (idx < symtab_functions_.size ())
+	fn (symtab_functions_[idx], idx);
+    return true;
+  }
+
+  uint32_t decl_line_at_entry (const std::string &name, uint64_t addr,
+			       const function_root_metadata *known_root
+			       = nullptr) const;
+  uint32_t parse_time_decl_line_at_entry (const std::string &name,
+					  uint64_t start_addr) const;
+  bool function_profile_root_at_addr (uint64_t addr, const std::string &name,
+				      function_root_metadata &out) const;
+
+  /* Configuration / load state.  */
+  std::string binary_path;
