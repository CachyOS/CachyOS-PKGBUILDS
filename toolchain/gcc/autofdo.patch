+#include <vector>
+
+namespace autofdo {
+
+namespace {
+
+using gcov_name_index_map = std::unordered_map<std::string, uint32_t>;
+using gcov_symbol_identity = std::pair<std::string, std::string>;
+using gcov_identity_index_map = std::map<gcov_symbol_identity, uint32_t>;
+
+void
+collect_export_identities (const function_builder &builder,
+			   std::set<gcov_symbol_identity> &identities,
+			   std::set<std::string> &target_names)
+{
+  if (!builder.name.empty ())
+    identities.emplace (builder.name, builder.file_path);
+  for (const auto &kv : builder.position_targets ())
+    for (const auto &target : kv.second)
+      if (!dwarf_debug::string_empty (target.first))
+	target_names.insert (dwarf_debug::string_value (target.first));
+  for (const auto &kv : builder.callsites ())
+    {
+      const function_builder &child = *kv.second;
+      if (!dwarf_debug::string_empty (kv.first.function_name))
+	identities.emplace (
+	  dwarf_debug::string_value (kv.first.function_name), child.file_path);
+      collect_export_identities (child, identities, target_names);
+    }
+}
+
+uint64_t
+build_gcov_locations (const function_builder &builder,
+		      const gcov_identity_index_map &identity_to_idx,
+		      const gcov_name_index_map &name_to_idx,
+		      std::vector<std::unique_ptr<gcov::gcov_location>> &out)
+{
+  uint64_t subtree_total = 0;
+  const function_builder::position_count_map &position_counts
+    = builder.position_counts ();
+  const function_builder::position_target_map &position_targets
+    = builder.position_targets ();
+  for (const auto &kv : position_counts)
+    {
+      const uint64_t key = kv.first;
+      const uint64_t count = kv.second;
+      const auto targets_it = position_targets.find (key);
+      const bool has_targets
+	= targets_it != position_targets.end () && !targets_it->second.empty ();
+      const uint32_t relative_line = gcov_rel_line_from_packed (key);
+      /* Drop positions that GCOV cannot encode rather than wrap their line.  */
+      if (!gcov_offset_fields_representable (relative_line))
+	continue;
+
+      std::unique_ptr<gcov::gcov_location> location;
+      if (!has_targets)
+	location = std::make_unique<gcov::gcov_location_normal> (count);
+      else
+	{
+	  std::vector<std::pair<uint32_t, uint64_t>> targets;
+	  targets.reserve (targets_it->second.size ());
+	  for (const auto &target : targets_it->second)
+	    {
+	      if (dwarf_debug::string_empty (target.first) || target.second == 0)
+		continue;
+	      const std::string target_name
+		= dwarf_debug::string_value (target.first);
+	      const auto name_it = name_to_idx.find (target_name);
+	      if (name_it == name_to_idx.end () || name_it->second == 0)
+		{
+		  std::fprintf (
+		    stderr,
+		    "afdo_create: skip unresolved export name '%.*s'\n",
+		    static_cast<int> (target_name.size ()),
+		    target_name.data ());
+		  continue;
+		}
+	      targets.push_back ({name_it->second, target.second});
+	    }
+	  if (targets.size () > 1)
+	    std::sort (
+	      targets.begin (),
+	      targets.end (),
+	      [] (const auto &a, const auto &b) { return a.first < b.first; });
+	  if (targets.empty ())
+	    location = std::make_unique<gcov::gcov_location_normal> (count);
+	  else
+	    {
+	      auto call = std::make_unique<gcov::gcov_location_call> (count);
+	      call->callee_map.reserve (targets.size ());
+	      for (const auto &target : targets)
+		call->callee_map[static_cast<uint64_t> (target.first)]
+		  = target.second;
+	      location = std::move (call);
+	    }
+	}
+
+      const uint32_t encoded = gcov_compress_offset (key);
+      location->offset = encoded >> 16;
+      location->discriminator = encoded & 0xffff;
+      subtree_total += location->total_count ();
+      out.emplace_back (std::move (location));
+    }
+
+  for (const auto &kv : builder.callsites ())
+    {
+      const function_builder &child = *kv.second;
+      const uint32_t callsite_line = kv.first.call_line;
+      const uint32_t offset = callsite_line >= builder.start_line
+				? callsite_line - builder.start_line
+				: 0;
+      const uint32_t discriminator
+	= kv.first.call_disc != 0
+	    ? kv.first.call_disc
+	    : get_base_discriminator (child.discriminator);
+      if (!gcov_offset_fields_representable (offset))
+	continue;
+
+      const uint32_t encoded
+	= gcov_compress_offset (gcov_pack_line_disc (offset, discriminator));
+      auto inlined = std::make_unique<gcov::gcov_location_inline> ();
+      inlined->offset = encoded >> 16;
+      inlined->discriminator = encoded & 0xffff;
+
+      std::string callee_name;
+      if (!dwarf_debug::string_empty (kv.first.function_name))
+	callee_name = dwarf_debug::string_value (kv.first.function_name);
+      else
+	callee_name = child.name;
+      if (callee_name.empty ())
+	continue;
+
+      const auto identity_it
+	= identity_to_idx.find ({callee_name, child.file_path});
+      if (identity_it == identity_to_idx.end () || identity_it->second == 0)
+	{
+	  std::fprintf (
+	    stderr,
+	    "afdo_create: skip unresolved inline export name '%.*s'\n",
+	    static_cast<int> (callee_name.size ()),
+	    callee_name.data ());
+	  continue;
+	}
+
+      gcov::gcov_function &symbol = inlined->inlined_sym;
+      symbol.id = identity_it->second;
+      symbol.desc.name_index = symbol.id;
+      symbol.timestamp = 0;
+      symbol.total_count = build_gcov_locations (
+	child, identity_to_idx, name_to_idx, symbol.locations);
+      subtree_total += inlined->total_count ();
+      out.emplace_back (std::move (inlined));
+    }
+  return subtree_total;
+}
+
+} /* anonymous namespace.  */
+
+bool
+gcov_profile_exporter::export_profile (const gcov_export_functions &functions,
+				       gcov::gcov_profile &out)
+{
+  /* Inline identities retain their file.  Indirect targets have no file
+     information and get a separate name-only entry.  */
+  std::set<gcov_symbol_identity> extra_identities;
+  std::set<std::string> target_names;
+  for (const auto &entry : functions)
+    {
+      function_builder &builder = *entry.second->builder;
+      collect_export_identities (builder, extra_identities, target_names);
+    }
+  for (const std::string &name : target_names)
+    extra_identities.emplace (name, std::string ());
+  for (const auto &entry : functions)
+    {
+      const function_builder *builder = entry.second->builder.get ();
+      extra_identities.erase (
+	{entry.first,
+	 builder != nullptr ? builder->file_path : std::string ()});
+    }
+
+  out.function_names.clear ();
+  out.function_names.reserve (functions.size () + extra_identities.size () + 1);
+  out.function_names.push_back ("");
+  std::vector<std::string> symbol_paths;
+  symbol_paths.reserve (functions.size () + extra_identities.size () + 1);
+  symbol_paths.push_back ("");
+  std::vector<uint32_t> emit_name_ids (functions.size (), 0);
+  for (size_t i = 0; i < functions.size (); ++i)
+    {
+      const std::string &mangled = functions[i].first;
+      if (mangled.empty ())
+	continue;
+      out.function_names.push_back (mangled);
+      const function_builder *builder = functions[i].second->builder.get ();
+      std::string path
+	= builder != nullptr ? builder->file_path : std::string ();
+      symbol_paths.push_back (std::move (path));
+      emit_name_ids[i] = static_cast<uint32_t> (out.function_names.size () - 1);
+    }
+  for (const auto &identity : extra_identities)
+    {
+      if (identity.first.empty ())
+	continue;
+      out.function_names.push_back (identity.first);
+      symbol_paths.push_back (identity.second);
+    }
+
+  gcov_identity_index_map identity_to_idx;
+  gcov_name_index_map name_to_idx;
+  name_to_idx.reserve (out.function_names.size ());
+  for (size_t i = 1; i < out.function_names.size (); ++i)
+    {
+      const uint32_t idx = static_cast<uint32_t> (i);
+      identity_to_idx.emplace (
+	gcov_symbol_identity{out.function_names[i], symbol_paths[i]}, idx);
+      /* Prefer the explicit name-only entry for targets without a file.  */
+      if (symbol_paths[i].empty ())
+	name_to_idx[out.function_names[i]] = idx;
+      else
+	name_to_idx.emplace (out.function_names[i], idx);
+    }
+
+  out.build_file_name_table (symbol_paths);
+
+  out.functions.clear ();
+  out.functions.reserve (functions.size ());
+  for (size_t i = 0; i < functions.size (); ++i)
+    {
+      const uint32_t id = emit_name_ids[i];
+      if (id == 0)
+	continue;
+      function_profile *func = functions[i].second;
+      const function_builder *builder = func->builder.get ();
+
+      gcov::gcov_function fn;
+      fn.id = id;
+      fn.desc.name_index = id;
+      const uint32_t fidx = out.file_name_map[id];
+      fn.desc.file_index
+	= (fidx < out.file_names.size ()) ? fidx : gcov::INVALID_INDEX;
+      fn.head_count = func->head_count;
+      fn.timestamp
+	= func->timestamp != 0 ? func->timestamp : gcov::UNKNOWN_TIMESTAMP;
+      fn.total_count = build_gcov_locations (
+	*builder, identity_to_idx, name_to_idx, fn.locations);
+      out.functions.push_back (std::move (fn));
+    }
+
+  out.function_map.clear ();
+  out.function_map.reserve (out.functions.size ());
+  for (const auto &fn : out.functions)
+    out.function_map[fn.id] = &fn;
+  gcov::compute_summary (out.functions, out.summary);
+  return true;
+}
+
+} /* namespace autofdo.  */
