+++ b/afdo-tools/testsuite/afdo-test/stripped-binary-rejection.c
@@ -0,0 +1,35 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -Wl,--build-id" } */
+/* { dg-afdo-entry live-reject } */
+/* { dg-afdo-sources lbr brbe spe } */
+/* { dg-afdo-strip-variants no-g strip-debug strip-all } */
+/* { dg-afdo-requires python3 perf strip } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+__attribute__((noinline))
+int hot (int x)
+{
+  int a = (x + seed) * 3 + 1;
+  int b = a ^ (a >> 5);
+  return b * 31 + (b << 2) - seed;
+}
+
+__attribute__((noinline))
+int hot_loop (int n)
+{
+  int sum = 0;
+  for (int i = 0; i < n; ++i)
+    sum += hot (i);
+  return sum;
+}
+
+volatile int iters = 200000000;
+
+int main (void)
+{
+  printf ("%d\n", hot_loop (iters));
+  return 0;
+}
