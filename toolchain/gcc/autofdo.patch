+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_DWARF_TYPES_H
+#define GCC_DWARF_TYPES_H
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "hash_util.h"
+
+namespace dwarf_debug {
+
+/* Reader-owned string identity.  Pointer equality is valid only for values
+   interned by the same dwarf_reader.  */
+using interned_string = const std::string *;
+
+/* A list of half-open [start, end) address ranges.  */
+using pc_range_list = std::vector<std::pair<uint64_t, uint64_t>>;
+
+/* Empty interned values are represented by nullptr.  */
+const std::string &string_value (interned_string);
+bool string_empty (interned_string);
+
+struct function_instance_key
+{
+  interned_string name = nullptr;
+  uint64_t start_addr = 0;
+
+  bool operator== (const function_instance_key &o) const noexcept
+  {
+    return start_addr == o.start_addr && name == o.name;
+  }
+};
+
+struct function_instance_key_hash
+{
+  size_t operator () (const function_instance_key &key) const noexcept
+  {
+    size_t hash = 0;
+    autofdo::hash_combine (hash, key.name);
+    autofdo::hash_combine (hash, key.start_addr);
+    return hash;
+  }
+};
+
+/* ELF symbol range with DWARF export anchors.  */
+struct function_metadata
+{
+  interned_string name = nullptr;
+  interned_string file_path = nullptr;
+  uint64_t start_addr = 0;
+  uint64_t end_addr = 0;
+  uint32_t start_line = 0;
+
+  function_metadata () = default;
+  function_metadata (interned_string n, interned_string file, uint64_t start,
+		     uint64_t end, uint32_t sl = 0)
+    : name (n), file_path (file), start_addr (start), end_addr (end),
+      start_line (sl)
+  {}
+};
+
+struct function_alias_metadata
+{
+  function_metadata function;
+  /* Index of this alias's owner in dwarf_reader::symtab_functions ().  */
+  size_t primary_index = 0;
+};
+
+struct inline_frame
+{
+  interned_string function_name = nullptr;
+  interned_string file_path = nullptr;
+  interned_string caller_file_path = nullptr;
+  uint32_t line_number = 0;
+  uint32_t call_line = 0;
+  uint32_t discriminator = 0;
+};
+
+struct source_location
+{
+  interned_string file_path = nullptr;
+  uint32_t line_number = 0;
+  uint32_t discriminator = 0;
+};
+
+struct dwarf_load_summary
+{
+  size_t touch_cus = 0;
+  size_t dwarf_functions = 0;
+  size_t symtab_functions = 0;
+  size_t line_segments = 0;
+  /* Unique profile-touch PCs.  These are range endpoints, not the size of a
+     symbolization cache.  */
+  size_t touch_pcs = 0;
+};
+
+/* STACK, or a shared empty one when the PC carries no inline frames, so
+   callers can bind a reference without testing for null.  */
+const std::vector<inline_frame> &
+inline_stack_or_empty (const std::vector<inline_frame> *);
+
+/* True when A and B describe the same inline frame at every depth.  */
+bool
+inline_stacks_equal (const std::vector<inline_frame> &a,
+		     const std::vector<inline_frame> &b);
+
+/* True when A and B name the same file, line and discriminator.  */
+bool source_location_equal (const source_location &, const source_location &);
+
+/* True when A and B agree at every position.  */
+bool
+source_locations_equal (const std::vector<source_location> &a,
+			const std::vector<source_location> &b);
+
+} /* namespace dwarf_debug.  */
+
+#endif /* GCC_DWARF_TYPES_H.  */
