diff --git a/afdo_tools/src/autofdo_correlate_deposit.cc b/afdo_tools/src/autofdo_correlate_deposit.cc
new file mode 100644
index 00000000000..89431cd71cc
--- /dev/null
+++ b/afdo_tools/src/autofdo_correlate_deposit.cc
@@ -0,0 +1,801 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
