+{
+  buf.push_back (value);
+}
+
+namespace {
+
+/* Append the low NBYTES of VALUE in little-endian form.  */
+void
+write_bytes (std::vector<uint8_t> &buf, uint64_t value, unsigned nbytes)
+{
+#ifdef WORDS_BIGENDIAN
+  for (unsigned i = 0; i < nbytes; i++)
+    buf.push_back ((value >> (i * 8)) & 0xFF);
+#else
+  const size_t pos = buf.size ();
+  buf.resize (pos + nbytes);
+  std::memcpy (buf.data () + pos, &value, nbytes);
+#endif
+}
+
+} /* anonymous namespace.  */
+
+void
