 clean: mostlyclean
 	rm -f $(TARGETS)
@@ -97,6 +105,89 @@ distclean: clean
 
 maintainer-clean: distclean
 
+# Run each DejaGnu test as a separate Make target for parallel execution.
+
+AFDO_TEST_SRC := $(srcdir)/testsuite/afdo-test
+AFDO_TEST_STEMS := $(shell \
+  if test -d $(AFDO_TEST_SRC); then \
+    for f in $(AFDO_TEST_SRC)/*.c $(AFDO_TEST_SRC)/*.cc; do \
+      test -f "$$f" || continue; \
+      grep -q 'dg-afdo-entry' "$$f" || continue; \
+      b=`basename "$$f"`; echo $${b%.*}; \
+    done | sort -u; \
+  fi)
+ifneq ($(AFDO_TEST_STEM),)
+AFDO_CHECK_STEMS := $(AFDO_TEST_STEM)
+else
+AFDO_CHECK_STEMS := $(AFDO_TEST_STEMS)
+endif
+AFDO_CHECK_TARGETS := $(addprefix check-afdo-,$(AFDO_CHECK_STEMS))
+
+DG_EXTRACT_RESULTS := $(srcdir)/../contrib/dg-extract-results.sh
+
+AFDO_RUNTEST := $(shell \
+  if $(RUNTEST) --version >/dev/null 2>&1; then echo $(RUNTEST); \
+  else echo ''; fi)
+
+.PHONY: $(AFDO_CHECK_TARGETS) check-afdo-prereq check-afdo-tests check-afdo-report
+
+check: $(TARGETS) check-afdo-report
+
+check-afdo-tests: $(AFDO_CHECK_TARGETS)
+
+# Warn once when runtest is missing; per-stem recipes then skip quietly.
+check-afdo-prereq:
+	@if test -z "$(AFDO_RUNTEST)"; then \
+	  echo "WARNING: DejaGnu runtest not found; skipping afdo-test" 1>&2; \
+	  echo "  (install DejaGnu)" 1>&2; \
+	fi
+
+check-afdo-report: check-afdo-tests
+	@sums=; logs=; \
+	for s in $(AFDO_CHECK_STEMS); do \
+	  f=testsuite/jobs/$$s/testrun.sum; \
+	  l=testsuite/jobs/$$s/testrun.log; \
+	  test -f "$$f" && sums="$$sums $$f"; \
+	  test -f "$$l" && logs="$$logs $$l"; \
+	done; \
+	if test -z "$$sums"; then \
+	  if test -z "$(AFDO_RUNTEST)"; then \
+	    echo "WARNING: afdo-test skipped (DejaGnu runtest not found)" 1>&2; \
+	  else \
+	    echo "WARNING: no afdo-test results to merge" 1>&2; \
+	  fi; \
+	  exit 0; \
+	fi; \
+	if test -f "$(DG_EXTRACT_RESULTS)"; then \
+	  $(SHELL) "$(DG_EXTRACT_RESULTS)" $$sums > testrun.sum; \
+	  $(SHELL) "$(DG_EXTRACT_RESULTS)" -L $$logs > testrun.log; \
+	else \
+	  cat $$sums > testrun.sum; \
+	  cat $$logs > testrun.log 2>/dev/null || :; \
+	fi; \
+	echo "=== afdo-test merged summary ==="; \
+	grep -E '^# of ' testrun.sum || true; \
+	echo "Full results: `pwd`/testrun.sum"
+
+# Static pattern so each stem is a real Make target (works with -j / .PHONY).
+# One shell for the whole recipe: an early exit must skip the runtest invoke.
+$(AFDO_CHECK_TARGETS): check-afdo-%: check-afdo-prereq | $(TARGETS)
+	@if test -z "$(AFDO_RUNTEST)"; then \
+	  exit 0; \
+	fi; \
+	test -f "$(srcdir)/testsuite/afdo-test/afdo-test.exp" \
+	  || { echo "error: missing afdo-test.exp" 1>&2; exit 1; }; \
+	tb=`pwd`; ts=`cd $(srcdir)/testsuite && pwd`; \
+	jobd="$$tb/testsuite/jobs/$*"; \
+	$(SHELL) $(srcdir)/../mkinstalldirs "$$jobd"; \
+	rm -f "$$jobd/testrun.sum" "$$jobd/testrun.log"; \
+	cd "$$jobd" && \
+	  unset RUNTESTFLAGS && \
+	  TOOL_BIN_DIR="$$tb" EXEEXT="$(exeext)" AFDO_TEST_STEM="$*" \
+	  $(AFDO_RUNTEST) $(AFDO_TOOLS_RUNTESTFLAGS) \
+	    --srcdir "$$ts" --objdir "$$jobd" \
+	    afdo-test/afdo-test.exp
+
 installcheck:
 dvi:
 pdf:
diff --git a/afdo_tools/testsuite/afdo-test/addr-mapping-basic.c b/afdo_tools/testsuite/afdo-test/addr-mapping-basic.c
new file mode 100644
index 00000000000..998e6059a80
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/addr-mapping-basic.c
@@ -0,0 +1,52 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-create -m } */
+/* { dg-afdo-validate addr2line } */
+/* { dg-afdo-requires addr2line python3 perf } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+static inline __attribute__((always_inline))
+int leaf(int x)
+{
+  int y = x + seed;
+  return (y * 3) + 1;
+}
+
+static inline __attribute__((always_inline))
+int middle(int x)
+{
+  return leaf(x) + 11;
+}
+
+__attribute__((noinline))
+int hot_loop(int n)
+{
+  int sum = 0;
+
+  for (int i = 0; i < n; ++i)
+    if (seed > 0 && (i & 1) == 0) sum += middle(i); else sum += leaf(i);
+
+  return sum;
+}
+
+__attribute__((noinline))
+int cold_path(int x)
+{
+  return x - 17;
+}
+
+int main(void)
+{
+  int result = hot_loop(50000000);
+
+  if (result == 12345)
+    result += cold_path(result);
+
+  printf("%d\n", result);
+  return 0;
+}
