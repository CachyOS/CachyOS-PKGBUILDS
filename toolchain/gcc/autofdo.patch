diff --git a/afdo_tools/testsuite/afdo-test/deep-inline-chain.c b/afdo_tools/testsuite/afdo-test/deep-inline-chain.c
new file mode 100644
index 00000000000..f283d91dd55
--- /dev/null
+++ b/afdo_tools/testsuite/afdo-test/deep-inline-chain.c
@@ -0,0 +1,55 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot hot_driver } */
+/* { dg-afdo-dump-inline level1 } */
+/* { dg-afdo-dump-nested level2 level3 level4 } */
+/* { dg-afdo-requires python3 perf } */
+
+#include <stdio.h>
+
+volatile int seed = 3;
+volatile int sink;
+
+static inline __attribute__((always_inline))
+int level4(int x)
+{
+  return (x ^ (x << 1)) + seed;
+}
+
+static inline __attribute__((always_inline))
+int level3(int x)
+{
+  return level4(x + 1) * 3;
+}
+
+static inline __attribute__((always_inline))
+int level2(int x)
+{
+  return level3(x + 2) - 7;
+}
+
+static inline __attribute__((always_inline))
+int level1(int x)
+{
+  return level2(x + 3) + 5;
+}
+
+__attribute__((noinline))
+int hot_driver(int n)
+{
+  int sum = 0;
+  for (int i = 0; i < n; ++i)
+    sum += level1(i);
+  return sum;
+}
+
+int main(void)
+{
+  sink = hot_driver(50000000);
+  printf("%d\n", sink);
+  return 0;
+}
