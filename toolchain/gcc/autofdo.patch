+/* Return the final component of PATH.  */
+const char *
+path_basename (const char *path)
+{
+  const char *slash = std::strrchr (path, '/');
+  return slash ? slash + 1 : path;
+}
+
+/* Sum of each row's count weighted by its inclusive byte span.  */
+uint64_t
+total_mass_from_range_counts (const std::vector<profile_range> &ranges)
+{
+  uint64_t total = 0;
+  for (const profile_range &row : ranges)
+    {
+      if (row.end >= row.beg)
+	total += row.count * (row.end - row.beg + 1);
+    }
+  return total;
+}
+
+/* One CPU's perf event and its ring buffer.  */
+struct cpu_ring_buffer
+{
+  int fd = -1;
+  void *base = nullptr;
+  size_t len = 0;
+  uint64_t data_offset = 0;
+  uint64_t data_size = 0;
+};
+
+/* The CPUs this process may run on, which under an affinity mask or in a
+   container is fewer than the online ones.  */
+std::vector<int>
+usable_cpu_ids ()
+{
+  std::vector<int> cpus;
+  long configured = sysconf (_SC_NPROCESSORS_CONF);
+  if (configured < CPU_SETSIZE)
+    configured = CPU_SETSIZE;
+  if (cpu_set_t *set = CPU_ALLOC (configured))
+    {
+      const size_t set_size = CPU_ALLOC_SIZE (configured);
+      CPU_ZERO_S (set_size, set);
+      if (sched_getaffinity (0, set_size, set) == 0)
+	for (long cpu = 0; cpu < configured; ++cpu)
+	  if (CPU_ISSET_S (cpu, set_size, set))
+	    cpus.push_back (static_cast<int> (cpu));
+      CPU_FREE (set);
+    }
+  if (cpus.empty ())
+    {
+      const long ncpu = sysconf (_SC_NPROCESSORS_ONLN);
+      for (long cpu = 0; cpu < ncpu; ++cpu)
+	cpus.push_back (static_cast<int> (cpu));
+    }
+  return cpus;
+}
+
+/* Data pages to request per CPU for a buffer of WANT_KB.  perf_event_mlock_kb
+   is a per-CPU limit, so asking for more fails once every CPU is mapped.  */
+size_t
+ring_data_pages (size_t page_size, size_t want_kb)
+{
+  /* The kernel's default, if the sysctl cannot be read.  */
+  unsigned long mlock_kb = 512;
+  if (FILE *f = fopen ("/proc/sys/kernel/perf_event_mlock_kb", "r"))
+    {
+      unsigned long value = 0;
+      if (fscanf (f, "%lu", &value) == 1 && value != 0)
+	mlock_kb = value;
+      fclose (f);
+    }
+  if (want_kb > mlock_kb)
+    want_kb = mlock_kb;
+
+  /* One page goes to the metadata page, and the count must be a power of
+     two.  */
+  const size_t budget = (want_kb * 1024) / page_size;
+  if (budget < 2)
+    return 1;
+  size_t pages = 1;
+  while (pages * 2 <= budget - 1)
+    pages *= 2;
+  return pages;
+}
+
+/* Map BUFFER's ring, halving DATA_PAGES while the kernel refuses it.  Other
+   perf users share the same limit.  */
+bool
+map_cpu_ring_buffer (cpu_ring_buffer &buffer, size_t page_size,
+		     size_t data_pages)
+{
+  while (data_pages != 0)
+    {
+      const size_t len = page_size * (1 + data_pages);
+      void *base
+	= mmap (nullptr, len, PROT_READ | PROT_WRITE, MAP_SHARED, buffer.fd, 0);
+      if (base != MAP_FAILED)
+	{
+	  buffer.base = base;
+	  buffer.len = len;
+	  return true;
+	}
+      data_pages /= 2;
+    }
+  return false;
+}
