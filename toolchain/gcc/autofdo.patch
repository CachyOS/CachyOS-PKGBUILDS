+
+/* Consume fields before PERF_SAMPLE_BRANCH_STACK and return selected values. */
+bool walk_sample_before_branch (const uint8_t *&ptr, const uint8_t *end,
+				uint64_t sample_ty, uint64_t read_format,
+				uint64_t *out_ip, bool *out_have_ip,
