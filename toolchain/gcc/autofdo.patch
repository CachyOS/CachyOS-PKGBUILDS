 afdo_tools/src/afdo_create.cc    |  63 ++-
 afdo_tools/src/afdo_dump.cc      |  43 +-
 afdo_tools/src/afdo_merge.cc     |  59 +-
 afdo_tools/src/gcov.h            |  45 ++
 afdo_tools/src/gcov_io.cc        | 240 ++++++++
