+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_reader.h"
+#include "gcov.h"
+#include "gcov_io.h"
+#include "file_mmap.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+
+namespace gcov {
+
+bool
+gcov_reader_v3::read_summary ()
+{
+  uint32_t tag;
+  if (!gcov_read_uint32 (cur_, end_, tag))
+    return false;
+  if (tag != v3::format::GCOV_TAG_AFDO_SUMMARY)
+    {
+      fprintf (stderr,
+	       "Error: Expected AFDO_SUMMARY tag (0x%x), got 0x%x\n",
+	       (unsigned) v3::format::GCOV_TAG_AFDO_SUMMARY,
+	       (unsigned) tag);
+      return false;
+    }
+  gcov_summary &summary = profile.summary;
+  if (!gcov_read_uint64 (cur_, end_, summary.total_count)
+      || !gcov_read_uint64 (cur_, end_, summary.max_count)
+      || !gcov_read_uint64 (cur_, end_, summary.max_function_count)
+      || !gcov_read_uint64 (cur_, end_, summary.num_counts)
+      || !gcov_read_uint64 (cur_, end_, summary.num_functions)
+      || !gcov_read_uint64 (cur_, end_, summary.num_detailed_entries))
+    return false;
+  summary.detailed_entries.resize (summary.num_detailed_entries);
+  for (size_t i = 0; i < summary.num_detailed_entries; i++)
+    {
+      if (!gcov_read_uint32 (cur_, end_, summary.detailed_entries[i].cutoff)
+	  || !gcov_read_uint64 (
+	    cur_, end_, summary.detailed_entries[i].min_count)
+	  || !gcov_read_uint64 (
+	    cur_, end_, summary.detailed_entries[i].num_counts))
+	return false;
+    }
+  return true;
+}
+
+bool
+gcov_reader_v3::read_file_names ()
+{
+  uint32_t tag;
+  if (!gcov_read_uint32 (cur_, end_, tag))
+    return false;
+  if (tag != v3::format::GCOV_TAG_AFDO_FILE_NAMES)
+    {
+      fprintf (stderr,
+	       "Error: Expected AFDO_FILE_NAMES tag (0x%x), got 0x%x\n",
+	       (unsigned) v3::format::GCOV_TAG_AFDO_FILE_NAMES,
+	       (unsigned) tag);
+      return false;
+    }
+
+  /* Skip unused record length.  */
+  uint32_t record_length = 0;
+  if (!gcov_read_uint32 (cur_, end_, record_length))
+    return false;
+  (void) record_length;
+
+  uint32_t num_files = 0;
+  if (!gcov_read_uint32 (cur_, end_, num_files))
+    return false;
+  std::vector<std::string> &file_names = profile.file_names;
+  file_names.reserve (num_files);
+  for (uint32_t i = 0; i < num_files; i++)
+    {
+      file_names.emplace_back ();
+      if (!gcov_read_string (cur_, end_, file_names.back ()))
+	return false;
+    }
+  return true;
+}
+
+bool
+gcov_reader_v3::read_function_names ()
+{
+  uint32_t num_functions = 0;
+  if (!gcov_read_uint32 (cur_, end_, num_functions))
+    return false;
+  profile.function_names.reserve (num_functions);
+  profile.file_name_map.reserve (num_functions);
+  for (uint32_t i = 0; i < num_functions; i++)
+    {
+      profile.function_names.emplace_back ();
+      if (!gcov_read_string (cur_, end_, profile.function_names.back ()))
+	return false;
+      profile.file_name_map.emplace_back ();
+      if (!gcov_read_uint32 (cur_, end_, profile.file_name_map.back ()))
+	return false;
+    }
+  return true;
+}
+
+bool
+gcov_reader_v3::read_pos_count (std::unique_ptr<gcov_location> &loc)
+{
+  uint32_t encoded_offset = 0, num_targets = 0;
+  uint64_t count = 0;
+  if (!gcov_read_uint32 (cur_, end_, encoded_offset)
+      || !gcov_read_uint32 (cur_, end_, num_targets)
+      || !gcov_read_uint64 (cur_, end_, count))
+    return false;
+
+  std::unique_ptr<gcov_location> location = nullptr;
+  if (num_targets == 0)
+    location = std::make_unique<gcov_location_normal> (count);
+  else
+    location = std::make_unique<gcov_location_call> (count);
+
+  if (num_targets > 0)
+    {
+      gcov_location_call *call
+	= static_cast<gcov_location_call *> (location.get ());
+      call->callee_map.reserve (num_targets);
+      for (uint32_t target = 0; target < num_targets; target++)
+	{
+	  uint32_t value_profile_type = 0;
+	  uint64_t function_id = 0, target_count = 0;
+	  if (!gcov_read_uint32 (cur_, end_, value_profile_type)
+	      || !gcov_read_uint64 (cur_, end_, function_id)
+	      || !gcov_read_uint64 (cur_, end_, target_count))
+	    return false;
+	  call->callee_map[function_id] = target_count;
+	}
+    }
+
+  location->offset = encoded_offset >> 16;
+  location->discriminator = encoded_offset & 0xffff;
+  loc = std::move (location);
+  return true;
+}
+
+bool
+gcov_reader_v3::read_inline_callsite (gcov_location_inline &callsite)
+{
+  uint32_t callsite_offset = 0, inline_func_name_idx = 0,
+	   inline_num_pos_counts = 0, inline_num_callsites = 0;
+
+  if (!gcov_read_uint32 (cur_, end_, callsite_offset)
+      || !gcov_read_uint32 (cur_, end_, inline_func_name_idx)
+      || !gcov_read_uint32 (cur_, end_, inline_num_pos_counts)
+      || !gcov_read_uint32 (cur_, end_, inline_num_callsites))
+    return false;
+
+  if (inline_func_name_idx >= profile.get_function_names ().size ())
+    {
+      fprintf (stderr, "Error: v3 inline callsite name index out of range\n");
+      return false;
+    }
+
+  callsite.offset = callsite_offset >> 16;
+  callsite.discriminator = callsite_offset & 0xffff;
+  callsite.inlined_sym.desc.name_index = inline_func_name_idx;
+  callsite.inlined_sym.id = inline_func_name_idx;
+
+  callsite.inlined_sym.locations.reserve (inline_num_pos_counts
+					  + inline_num_callsites);
+  for (uint32_t j = 0; j < inline_num_pos_counts; ++j)
+    {
+      std::unique_ptr<gcov_location> location = nullptr;
+      if (!read_pos_count (location))
+	return false;
+      callsite.inlined_sym.locations.emplace_back (std::move (location));
+    }
+
+  for (uint32_t j = 0; j < inline_num_callsites; ++j)
+    {
+      std::unique_ptr<gcov_location> nested
+	= std::make_unique<gcov_location_inline> ();
+      if (!read_inline_callsite (
+	    *static_cast<gcov_location_inline *> (nested.get ())))
+	return false;
+      callsite.inlined_sym.locations.emplace_back (std::move (nested));
+    }
+
+  callsite.inlined_sym.total_count
+    = gcov_function_subtree_count (callsite.inlined_sym);
+
+  return true;
+}
+
+bool
+gcov_reader_v3::read_function (gcov_function &func)
+{
+  if (!gcov_read_uint64 (cur_, end_, func.head_count)
+      || !gcov_read_uint64 (cur_, end_, func.timestamp))
+    return false;
+  uint32_t name_idx = 0, num_pos = 0, num_inline_calls = 0;
+  if (!gcov_read_uint32 (cur_, end_, name_idx))
+    return false;
+  const std::vector<std::string> &function_names
+    = profile.get_function_names ();
+  const std::vector<uint32_t> &file_name_map = profile.get_file_name_map ();
+  const std::vector<std::string> &file_names = profile.get_file_names ();
+  if (name_idx >= function_names.size () || name_idx >= file_name_map.size ())
+    {
+      fprintf (stderr, "Error: v3 function name index out of range\n");
+      return false;
+    }
+  func.desc.name_index = name_idx;
+  func.id = name_idx;
+  const uint32_t file_idx = file_name_map[name_idx];
+  func.desc.file_index
+    = (file_idx < file_names.size ()) ? file_idx : INVALID_INDEX;
+  if (!gcov_read_uint32 (cur_, end_, num_pos)
+      || !gcov_read_uint32 (cur_, end_, num_inline_calls))
+    return false;
+  func.locations.reserve (num_pos + num_inline_calls);
+  for (uint32_t i = 0; i < num_pos; i++)
+    {
+      std::unique_ptr<gcov_location> location = nullptr;
+      if (!read_pos_count (location))
+	return false;
+      func.locations.emplace_back (std::move (location));
+    }
+
+  for (uint32_t i = 0; i < num_inline_calls; i++)
+    {
+      std::unique_ptr<gcov_location> location
+	= std::make_unique<gcov_location_inline> ();
+      if (!read_inline_callsite (
+	    *static_cast<gcov_location_inline *> (location.get ())))
+	return false;
+      func.locations.emplace_back (std::move (location));
+    }
+
+  std::stable_sort (func.locations.begin (),
+		    func.locations.end (),
+		    [] (const std::unique_ptr<gcov_location> &one,
+			const std::unique_ptr<gcov_location> &two) {
+		      return one->offset < two->offset
+			     || (one->offset == two->offset
+				 && one->discriminator < two->discriminator);
+		    });
+
+  func.total_count = gcov_function_subtree_count (func);
+  return true;
+}
+
+bool
+gcov_reader_v3::read_functions ()
+{
+  uint32_t tag;
+  if (!gcov_read_uint32 (cur_, end_, tag))
+    return false;
+  if (tag != v3::format::GCOV_TAG_AFDO_FUNCTION)
+    {
+      fprintf (stderr,
+	       "Error: Expected AFDO_FUNCTION tag (0x%x), got 0x%x\n",
+	       (unsigned) v3::format::GCOV_TAG_AFDO_FUNCTION,
+	       (unsigned) tag);
+      return false;
+    }
+
+  /* Skip unused record length.  */
+  uint32_t record_length = 0;
+  if (!gcov_read_uint32 (cur_, end_, record_length))
+    return false;
+  (void) record_length;
+
+  uint32_t num_functions = 0;
+  if (!gcov_read_uint32 (cur_, end_, num_functions))
+    return false;
+
+  std::vector<gcov_function> &functions = profile.functions;
+  functions.reserve (num_functions);
+  for (uint32_t i = 0; i < num_functions; i++)
+    {
+      functions.emplace_back ();
+      if (!read_function (functions.back ()))
+	return false;
+    }
+
+  profile.rebuild_function_map ();
+
+  return true;
+}
+
+bool
+gcov_reader_v3::read ()
+{
+  afdo_tools::file_mmap fb;
+  if (!fb.map (path))
+    {
+      fprintf (stderr, "Error: cannot mmap %s\n", path.c_str ());
+      return false;
+    }
+  cur_ = fb.data ();
+  end_ = fb.data () + fb.size ();
+
+  if (!gcov_read_uint32 (cur_, end_, magic))
+    {
+      fprintf (stderr, "Error: Failed to read magic number\n");
+      return false;
+    }
+
+  if (magic != v3::format::GCOV_DATA_MAGIC)
+    {
+      fprintf (stderr, "Error: Invalid magic number\n");
+      return false;
+    }
+
+  uint32_t checksum = 0;
+  if (!gcov_read_uint32 (cur_, end_, version)
+      || !gcov_read_uint32 (cur_, end_, checksum))
+    {
+      fprintf (stderr, "Error: Failed to read version/checksum\n");
+      return false;
+    }
+  (void) checksum;
+
+  if (version != v3::format::GCOV_VERSION)
+    {
+      fprintf (
+	stderr, "Error: unsupported v3 version %u\n", (unsigned) version);
+      return false;
+    }
+
+  if (!read_summary ())
+    {
+      fprintf (stderr, "Error: Unable to read summary information\n");
+      return false;
+    }
+
+  if (!read_file_names ())
+    {
+      fprintf (stderr, "Error: Unable to read file names\n");
+      return false;
+    }
+
+  if (!read_function_names ())
+    {
+      fprintf (stderr, "Error: Unable to read function names\n");
+      return false;
+    }
+
+  if (!read_functions ())
+    {
+      fprintf (stderr, "Error: Unable to read function information\n");
+      return false;
+    }
+
+  return true;
+}
+
+} /* namespace gcov.  */
