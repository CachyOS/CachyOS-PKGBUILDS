+#ifndef GCC_GCOV_MERGE_H
+#define GCC_GCOV_MERGE_H
+
+#include "gcov.h"
+
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace gcov {
+
+/* Merge several AutoFDO profiles (sum counts) on the gcov_profile model.  */
+class gcov_merger
+{
+  struct symbol_identity
+  {
+    std::string name;
+    std::string file;
+
+    bool operator< (const symbol_identity &other) const
+    {
+      if (name != other.name)
+	return name < other.name;
+      return file < other.file;
+    }
+  };
+
+  gcov_profile result;
+  /* Merged symbol identity -> function id.  */
+  std::map<symbol_identity, uint32_t> identity_to_id;
+  /* Merged top-level symbol identity -> index into result.functions.  */
+  std::map<symbol_identity, size_t> fn_index;
+
+  symbol_identity identity_at (const gcov_profile &profile, uint64_t id) const;
+  uint32_t remap_callee (uint64_t src_id,
+			 const gcov_profile &src_profile) const;
+  std::unique_ptr<gcov_location>
+  clone_location (const gcov_location &src, const gcov_profile &src_profile);
+  bool build_inlined (gcov_function &dst, const gcov_function &src,
+		      const gcov_profile &src_profile);
+  void merge_function (gcov_function &dst, const gcov_function &src,
+		       const gcov_profile &src_profile);
+  void merge_locations (std::vector<std::unique_ptr<gcov_location>> &dst,
+			const std::vector<std::unique_ptr<gcov_location>> &src,
+			const gcov_profile &src_profile);
+
+public:
+  bool merge (const std::vector<std::string> &inputs,
+	      const std::string &output);
+};
+
+} /* namespace gcov.  */
+
+#endif /* GCC_GCOV_MERGE_H.  */
