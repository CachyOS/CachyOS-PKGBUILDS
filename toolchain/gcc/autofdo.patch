From 595c8ef46ba1b6c924420b52adbffabd8386b2c0 Mon Sep 17 00:00:00 2001
From: Kugan Vivekanandarajah <kvivekananda@nvidia.com>
Date: Sat, 7 Nov 2026 22:34:56 +1100
Subject: [PATCH 04/45] Add the in-memory GCOV v3 profile model

Define the in-memory representation of a GCOV AutoFDO v3 profile, including
functions, source positions, callsites, indirect targets, and
discriminators.  This isolates the data model from serialization so its
ownership and invariants can be reviewed first.

The discriminator bit layout is written by the compiler and read back by
these tools, so keep it in one header both can include instead of
restating the shifts and masks on each side.

gcc/ChangeLog:

	* gcov-discriminator-layout.h: New file.
	* input.h: Include gcov-discriminator-layout.h.  Move the
	discriminator bit layout constants there.

afdo-tools/ChangeLog:

	* src/gcov.h: New file.
	* src/gcov_discriminator_encoding.h: New file.

Signed-off-by: Kugan Vivekanandarajah <kvivekananda@nvidia.com>
Co-authored-by: Dhruv Chawla <dhruvc@nvidia.com>
Co-authored-by: Rahul Shinde <rashinde@nvidia.com>
---
 afdo-tools/src/gcov.h                        | 277 +++++++++++++++++++
 afdo-tools/src/gcov_discriminator_encoding.h | 111 ++++++++
 gcc/gcov-discriminator-layout.h              |  52 ++++
 gcc/input.h                                  |  27 +-
 4 files changed, 442 insertions(+), 25 deletions(-)
 create mode 100644 afdo-tools/src/gcov.h
 create mode 100644 afdo-tools/src/gcov_discriminator_encoding.h
 create mode 100644 gcc/gcov-discriminator-layout.h

diff --git a/afdo-tools/src/gcov.h b/afdo-tools/src/gcov.h
new file mode 100644
index 00000000000..812e05dd964
--- /dev/null
+++ b/afdo-tools/src/gcov.h
@@ -0,0 +1,277 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_AFDO_TOOLS_GCOV_H
+#define GCC_AFDO_TOOLS_GCOV_H
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace gcov {
+
+/* All-ones sentinel for an absent name, file, section, or symbol index.  */
+constexpr uint32_t INVALID_INDEX = UINT32_MAX;
+
+/* Deepest inline nesting the readers accept.  The profile tree is walked
+   recursively, so without a bound a small malformed file could exhaust the
+   stack.  Real profiles stay far below this.  */
+constexpr unsigned MAX_INLINE_DEPTH = 1024;
+
+/* Warn once when a profile count overflows a uint64_t.  */
+void gcov_note_count_overflow ();
+
+/* Add or multiply profile counts, capping at UINT64_MAX with a warning.  */
+uint64_t gcov_add_count (uint64_t a, uint64_t b);
+uint64_t gcov_multiply_count (uint64_t a, uint64_t b);
+
+/* A symbol's name and defining source file.  */
+struct symbol_identity
+{
+  std::string name;
+  std::string file;
+
+  bool operator< (const symbol_identity &other) const
+  {
+    if (name != other.name)
+      return name < other.name;
+    return file < other.file;
+  }
+};
+
+struct gcov_location
+{
+  uint32_t offset = 0;
+  uint32_t discriminator = 0;
+  enum class kind
+  {
+    normal,
+    call,
+    inlined
+  } type;
+  gcov_location (kind type_)
+    : type (type_)
+  {
+  }
+  virtual ~gcov_location () = default;
+  uint64_t total_count () const;
+};
+
+struct gcov_function
+{
+  struct descriptor
+  {
+    /* Indices into gcov_profile::function_names / file_names (file_index
+       is INVALID_INDEX when the function has no source file).  */
+    uint32_t name_index = 0;
+    uint32_t file_index = INVALID_INDEX;
+  } desc;
+  uint32_t id = 0;
+  /* First-execution time.  0 when unknown, which is what auto-profile's
+     "gf.timestamp > 0" guard tests for.
+     TODO: auto-profile only ranks these, so a smaller encoding would do.
+     It has to stay comparable across profiles for gcov_merge.  */
+  uint64_t timestamp = 0;
+  uint64_t head_count = 0;
+  uint64_t total_count = 0;
+  std::vector<std::unique_ptr<gcov_location>> locations;
+};
+
+struct gcov_summary_detailed_entry
+{
+  uint32_t cutoff = 0;
+  uint64_t min_count = 0;
+  uint64_t num_counts = 0;
+};
+
+struct gcov_summary
+{
+  uint64_t total_count = 0;
+  uint64_t max_count = 0;
+  uint64_t max_function_count = 0;
+  uint64_t num_counts = 0;
+  uint64_t num_functions = 0;
+  uint64_t num_detailed_entries = 0;
+  std::vector<gcov_summary_detailed_entry> detailed_entries;
+};
+
+class gcov_profile
+{
+  std::vector<std::string> file_names;
+  std::vector<std::string> function_names;
+  /* Function-name index -> file-name index.  */
+  std::vector<uint32_t> file_name_map;
+  std::vector<gcov_function> functions;
+  gcov_summary summary;
+
+public:
+  gcov_profile () = default;
+  /* Immovable and non-copyable.  */
+  gcov_profile (const gcov_profile &) = delete;
+  gcov_profile (gcov_profile &&) = delete;
+  gcov_profile &operator= (const gcov_profile &) = delete;
+  gcov_profile &operator= (gcov_profile &&) = delete;
+
+  const std::vector<gcov_function> &get_functions () const { return functions; }
+
+  const std::vector<std::string> &get_function_names () const
+  {
+    return function_names;
+  }
+
+  const std::vector<std::string> &get_file_names () const { return file_names; }
+
+  /* Function id -> index into get_file_names () (INVALID_INDEX if none).  */
+  const std::vector<uint32_t> &get_file_name_map () const
+  {
+    return file_name_map;
+  }
+
+  const gcov_summary &get_summary () const
+  {
+    return summary;
+  }
+
+  void set_summary (gcov_summary s)
+  {
+    summary = std::move (s);
+  }
+
+  /* Replace the name and file tables.  FILE_MAP[i] is the file-table index
+     for function-name i, or INVALID_INDEX.  */
+  void set_names (std::vector<std::string> files,
+		  std::vector<std::string> names,
+		  std::vector<uint32_t> file_map)
+  {
+    file_names = std::move (files);
+    function_names = std::move (names);
+    file_name_map = std::move (file_map);
+  }
+
+  /* Build the deduplicated file-name table FILES and the map from each
+     SYMBOL_PATHS index to its entry in FILES.  */
+  static void
+  build_file_name_table (const std::vector<std::string> &symbol_paths,
+			 std::vector<std::string> &files,
+			 std::vector<uint32_t> &file_map)
+  {
+    files.clear ();
+    /* Reserved slot kept for the format.  FILE_MAP spells "no file" as
+       INVALID_INDEX, so nothing ever points here.  */
+    files.push_back ("");
+    std::unordered_map<std::string, uint32_t> path_to_file_idx;
+    file_map.assign (symbol_paths.size (), INVALID_INDEX);
+    /* I is a function-name id, whose index 0 is the reserved empty name.  */
+    for (size_t i = 1; i < symbol_paths.size (); ++i)
+      {
+	const std::string &path = symbol_paths[i];
+	if (path.empty ())
+	  continue;
+	auto inserted
+	  = path_to_file_idx.emplace (
+	    path, static_cast<uint32_t> (files.size ()));
+	if (inserted.second)
+	  files.push_back (path);
+	file_map[i] = inserted.first->second;
+      }
+  }
+
+  void set_functions (std::vector<gcov_function> funcs)
+  {
+    functions = std::move (funcs);
+  }
+};
+
+struct gcov_location_normal : gcov_location
+{
+  uint64_t count = 0;
+  gcov_location_normal ()
+    : gcov_location (kind::normal)
+  {
+  }
+  gcov_location_normal (uint64_t count_) : gcov_location_normal ()
+  {
+    count = count_;
+  }
+};
+
+struct gcov_location_call : gcov_location
+{
+  uint64_t count = 0;
+  /* Callee function id to count.  */
+  std::unordered_map<uint64_t, uint64_t> callee_map;
+  gcov_location_call ()
+    : gcov_location (kind::call)
+  {
+  }
+  gcov_location_call (uint64_t count_) : gcov_location_call ()
+  {
+    count = count_;
+  }
+};
+
+struct gcov_location_inline : gcov_location
+{
+  gcov_function inlined_sym;
+  gcov_location_inline ()
+    : gcov_location (kind::inlined)
+  {
+  }
+};
+
+/* A function's total_count.  The sum of its position counts plus the totals of
+   its inline subtrees.  Canonical definition of gcov_function::total_count.
+   Callers that build or mutate a function's locations recompute it via
+   this.  */
+uint64_t gcov_function_subtree_count (const gcov_function &func);
+
+/* AutoFDO v3 on-disk format constants (magic, tags, version).  */
+namespace v3 {
+/* Value-profile histogram type written per indirect-call target in the v3
+   format, and the only type the format admits.  The value is fixed by the
+   original AutoFDO producer rather than by GCC, whose current enum hist_type
+   has no such enumerator (7 is HIST_TYPE_MAX there).  */
+constexpr uint32_t HIST_TYPE_INDIR_CALL_TOPN = 7;
+
+/* GCOV file format constants.  */
+struct format
+{
+  enum : uint32_t
+  {
+    /* Magic numbers.  */
+    AFDO_GCOV_DATA_MAGIC = 0x67636461, /* "gcda" */
+    /* AutoFDO-specific tags.  */
+    GCOV_TAG_AFDO_SUMMARY = 0xa8000000,
+    GCOV_TAG_AFDO_FILE_NAMES = 0xaa000000,
+    GCOV_TAG_AFDO_FUNCTION = 0xac000000,
+    GCOV_TAG_MODULE_GROUPING = 0xae000000,
+    GCOV_TAG_AFDO_WORKING_SET = 0xaf000000,
+    GCOV_WORKING_SET_BUCKETS = 128,
+    /* Profile version word.  */
+    AFDO_GCOV_VERSION = 3
+  };
+};
+
+} /* namespace v3.  */
+
+} /* namespace gcov.  */
+
+#endif /* GCC_AFDO_TOOLS_GCOV_H.  */
