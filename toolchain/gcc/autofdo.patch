+AC_PROG_CXX
+AC_LANG(C++)
+
+ACX_PKGVERSION([GCC])
+ACX_BUGURL([https://gcc.gnu.org/bugs/])
+
+gcc_basever=`cat "$srcdir/../gcc/BASE-VER"`
+gcc_datestamp=`cat "$srcdir/../gcc/DATESTAMP"`
+gcc_devphase=`cat "$srcdir/../gcc/DEV-PHASE"`
+gcc_patchlevel=`echo "$gcc_basever" | sed 's/^[[0-9]]*\.[[0-9]]*\.//'`
+AFDO_VERSION_STRING="$gcc_basever"
+if test -n "$gcc_devphase" || test "$gcc_patchlevel" != 0; then
+  test -z "$gcc_datestamp" \
+    || AFDO_VERSION_STRING="$AFDO_VERSION_STRING $gcc_datestamp"
+fi
+test -z "$gcc_devphase" \
+  || AFDO_VERSION_STRING="$AFDO_VERSION_STRING ($gcc_devphase)"
+AC_SUBST(AFDO_VERSION_STRING)
+
+AC_CHECK_HEADERS([elf.h libelf.h gelf.h elfutils/libdw.h], [],
+                 [AC_MSG_ERROR([required header not found for afdo_tools])])
+AC_CHECK_HEADERS([linux/perf_event.h locale.h sys/mman.h sys/syscall.h unistd.h],
+		 [],
+                 [AC_MSG_ERROR([required header not found for afdo_tools])])
+dnl perf.data and the kernel ABI are little-endian.  Do not byte-swap.
+AC_C_BIGENDIAN(
+  [AC_MSG_ERROR([afdo_tools requires a little-endian host])], [],
+  [AC_MSG_ERROR([cannot determine host byte order for afdo_tools])],
+  [AC_MSG_ERROR([afdo_tools requires a little-endian host])])
+
+AC_MSG_CHECKING([for a usable perf_event_open system call number])
+AC_COMPILE_IFELSE(
+  [AC_LANG_PROGRAM([[
+#include <sys/syscall.h>
+#if !defined(__NR_perf_event_open) \
+    && !defined(__x86_64__) && !defined(__aarch64__)
+# error "perf_event_open system call number is unavailable"
+#endif
+  ]], [[]])],
+  [AC_MSG_RESULT([yes])],
+  [AC_MSG_ERROR([afdo_tools requires perf_event_open support])])
+
+ZW_GNU_GETTEXT_SISTER_DIR
+
+AH_BOTTOM([
+#ifndef AFDO_I18N_CONFIGURED
+#define AFDO_I18N_CONFIGURED
+#ifdef ENABLE_NLS
+# include <libintl.h>
+# include <locale.h>
+# ifndef _
+#  define _(msgid) gettext (msgid)
+# endif
+static inline void
+afdo_init_libintl (void)
+{
+  setlocale (LC_ALL, "");
+  (void) bindtextdomain ("gcc", LOCALEDIR);
+  (void) textdomain ("gcc");
+}
+#else
+# ifndef _
+#  define _(msgid) (msgid)
+# endif
+# define afdo_init_libintl() ((void) 0)
+#endif
+#endif
+])
+
+save_LIBS="$LIBS"
+AC_CHECK_LIB([elf], [elf_begin], [],
+             [AC_MSG_ERROR([afdo_tools requires libelf])])
+AC_CHECK_LIB([dw], [dwarf_begin], [],
+             [AC_MSG_ERROR([afdo_tools requires libdw])])
+AC_CHECK_LIB([z], [compress], [],
+             [AC_MSG_ERROR([afdo_tools requires zlib])])
+AFDO_TOOLS_LIBS="$LIBS"
+LIBS="$save_LIBS"
+AC_SUBST(AFDO_TOOLS_LIBS)
+
+AC_CONFIG_FILES([Makefile version.h])
+AC_OUTPUT
