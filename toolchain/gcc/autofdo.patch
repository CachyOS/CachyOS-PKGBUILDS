+	byte = static_cast<uint8_t> (byte | 0x80);
+      buf.push_back (byte);
+    }
+  while (value);
+}
+
+void
+write_str (std::vector<uint8_t> &buf, const std::string &str)
+{
+  const uint32_t len
+    = static_cast<uint32_t> (str.size () + 1); /* Include NUL.  */
+  write_varint (buf, len);
+  buf.insert (buf.end (), str.begin (), str.end ());
+  buf.push_back ('\0');
+}
+
+uint8_t
+read_int8 (const uint8_t *&cur, const uint8_t *end)
+{
+  if (cur >= end)
+    {
+      set_decode_error ("v4: truncated uint8");
+      return 0;
+    }
+  return *cur++;
+}
+
+namespace {
+
+/* Read the low NBYTES as a little-endian value, advancing CUR.  On truncation
+   record the decode error and return 0.  */
+uint64_t
+read_bytes (const uint8_t *&cur, const uint8_t *end, unsigned nbytes)
+{
+  if (!COUNT_FITS_IN_BUFFER (cur, end, nbytes, 1))
+    {
+      set_decode_error ("v4: truncated value");
+      return 0;
+    }
+  uint64_t val = 0;
+#ifdef WORDS_BIGENDIAN
+  for (unsigned i = 0; i < nbytes; i++)
+    val |= static_cast<uint64_t> (cur[i]) << (i * 8);
+#else
+  std::memcpy (&val, cur, nbytes);
+#endif
+  cur += nbytes;
+  return val;
+}
+
+} /* anonymous namespace.  */
+
+uint16_t
+read_int16 (const uint8_t *&cur, const uint8_t *end)
+{
+  return static_cast<uint16_t> (read_bytes (cur, end, 2));
+}
+
+uint32_t
+read_int32 (const uint8_t *&cur, const uint8_t *end)
+{
+  return static_cast<uint32_t> (read_bytes (cur, end, 4));
+}
+
+uint64_t
+read_int56 (const uint8_t *&cur, const uint8_t *end)
+{
+  return read_bytes (cur, end, 7);
+}
+
+uint64_t
+read_int64 (const uint8_t *&cur, const uint8_t *end)
+{
+  return read_bytes (cur, end, 8);
+}
+
+/* Read a base-128 varint, recording a decode error on truncation or on a
+   value wider than 64 bits.  */
+uint64_t
+read_varint (const uint8_t *&cur, const uint8_t *end)
+{
+  uint64_t result = 0;
+  for (unsigned shift = 0; shift < 64; shift += 7)
+    {
+      if (cur >= end)
+	{
+	  set_decode_error ("v4: truncated varint");
+	  return result;
+	}
+      uint8_t byte = *cur++;
+      if (shift == 63 && (byte & 0xfe) != 0)
+	{
+	  set_decode_error ("v4: varint too long");
+	  return result;
+	}
+      result |= uint64_t (byte & 0x7F) << shift;
+      if ((byte & 0x80) == 0)
+	return result;
+    }
+  set_decode_error ("v4: varint too long");
+  return result;
+}
+
+uint32_t
+read_varint32 (const uint8_t *&cur, const uint8_t *end)
+{
+  const uint64_t value = read_varint (cur, end);
+  if (value > std::numeric_limits<uint32_t>::max ())
+    {
+      set_decode_error ("v4: varint does not fit in 32 bits");
+      return 0;
+    }
+  return static_cast<uint32_t> (value);
+}
+
+/* Read a varint-length-prefixed string, dropping the trailing NUL counted by
+   the length.  */
+std::string
+read_str (const uint8_t *&cur, const uint8_t *end)
+{
+  uint32_t len = read_varint32 (cur, end);
+  if (len == 0)
+    return "";
+  if (!COUNT_FITS_IN_BUFFER (cur, end, len, 1) || cur[len - 1] != '\0')
+    {
+      set_decode_error ("v4: string past end of buffer");
+      return "";
+    }
+  std::string result (reinterpret_cast<const char *> (cur), len - 1);
+  cur += len;
+  return result;
+}
+} /* namespace v4.  */
 } /* namespace gcov.  */
