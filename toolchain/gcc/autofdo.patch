--- /dev/null
+++ b/afdo_tools/Makefile.in
@@ -0,0 +1,86 @@
+# Makefile for afdo_tools
+
+srcdir := @srcdir@
+prefix := @prefix@
+bindir := @bindir@
+INSTALL := @INSTALL@
+INSTALL_PROGRAM := @INSTALL_PROGRAM@
+INSTALL_STRIP_PROGRAM := $(srcdir)/../install-sh -c -s
+CXX := @CXX@
+CXXFLAGS := @CXXFLAGS@
+CXXOPTS := $(CXXFLAGS) -std=c++14 -fno-exceptions -fno-rtti \
+	   -DHAVE_CONFIG_H
+LDFLAGS := @LDFLAGS@
+NO_PIE_FLAG := -no-pie
+exeext := @EXEEXT@
+
+INCLUDES = -I. -I$(srcdir) -I$(srcdir)/src
+
+GCOV_RDWR_SRCS = src/gcov_reader.cc src/gcov_reader_v3.cc \
+		 src/gcov_writer.cc src/gcov_writer_v3.cc src/gcov_io.cc src/file_mmap.cc
+
+GCOV_RDWR_OBJS = $(GCOV_RDWR_SRCS:.cc=.o)
+
+TARGETS = afdo_dump$(exeext) afdo_merge$(exeext)
+
+.PHONY: all clean distclean install install-strip installcheck \
+	dvi pdf html info install-info install-pdf install-dvi \
+	install-man install-html mostlyclean maintainer-clean
+
+all: $(TARGETS)
+
+afdo_dump$(exeext): src/afdo_dump.o $(GCOV_RDWR_OBJS)
+	$(CXX) $(CXXOPTS) $(LDFLAGS) $(NO_PIE_FLAG) -o $@ $^
+
+afdo_merge$(exeext): src/afdo_merge.o src/gcov_merge.o src/gcov_summary.o \
+	$(GCOV_RDWR_OBJS)
+	$(CXX) $(CXXOPTS) $(LDFLAGS) $(NO_PIE_FLAG) -o $@ $^
+
+src/%.o: $(srcdir)/src/%.cc
+	@mkdir -p $(dir $@)
+	$(CXX) $(CXXOPTS) $(INCLUDES) -MMD -MP -MF $(@:.o=.d) -c $< -o $@
+
+# Auto-dependency tracking (like gcc/Makefile.in): each object writes a
+# dependency file of the headers it included; re-include them so a header
+# edit rebuilds dependents.
+-include $(wildcard src/*.d)
+
+install: all
+	$(SHELL) $(srcdir)/../mkinstalldirs $(DESTDIR)$(bindir)
+	$(INSTALL_PROGRAM) afdo_dump$(exeext) \
+		$(DESTDIR)$(bindir)/afdo_dump$(exeext)
+	$(INSTALL_PROGRAM) afdo_merge$(exeext) \
+		$(DESTDIR)$(bindir)/afdo_merge$(exeext)
+
+install-strip: override INSTALL_PROGRAM = $(INSTALL_STRIP_PROGRAM)
+install-strip: install
+
+mostlyclean:
+	rm -f src/*.o src/*.d
+
+clean: mostlyclean
+	rm -f $(TARGETS)
+
+distclean: clean
+	rm -f config.log config.status config.cache Makefile config.h
+
+maintainer-clean: distclean
+
+installcheck:
+dvi:
+pdf:
+html:
+info:
+install-info:
+install-pdf:
+install-dvi:
+install-man:
+install-html:
+
+# Rebuild generated files when templates change (stage1 bootstrap keeps a
+# configured Makefile; without this, Makefile.in edits are ignored).
+Makefile: $(srcdir)/Makefile.in config.status
+	$(SHELL) ./config.status Makefile
+
+config.h: $(srcdir)/config.h.in config.status
+	$(SHELL) ./config.status config.h
