--- /dev/null
+++ b/afdo_tools/src/perf_branch_stack_reader.cc
@@ -0,0 +1,258 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "perf_branch_stack_reader.h"
+
+#include "perf_event_sample_util.h"
+
+#include <cinttypes>
+#include <climits>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <utility>
+
+namespace perf_data {
+namespace {
+
+/* Branch-stack profiles: IP|TID|TIME|PERIOD|BRANCH_STACK (0x907).  */
+constexpr uint64_t BRANCH_STACK_SAMPLE_TYPE_IP_TID_TIME_PERIOD
+  = perf_sample_type::IP | perf_sample_type::TID | perf_sample_type::TIME
+    | perf_sample_type::PERIOD | perf_sample_type::BRANCH_STACK;
+
+constexpr size_t BRANCH_STACK_FIXED_PREFIX_BYTES = 4 * sizeof (uint64_t);
+
+bool
+branch_stack_sample_has_fixed_prefix_layout (uint64_t sample_type,
+					     uint64_t read_format)
+{
+  return sample_type == BRANCH_STACK_SAMPLE_TYPE_IP_TID_TIME_PERIOD
+	 && read_format == 0;
+}
+
+} /* anonymous namespace.  */
+
+perf_branch_stack_reader::perf_branch_stack_reader (
+  const std::string &_perf_data_path, const std::string &_binary_path)
+  : perf_file_reader (_perf_data_path, _binary_path)
+{}
+
+void
+perf_branch_stack_reader::
+  materialize_address_frequencies_for_per_pc_correlate ()
+{
+  materialize_address_frequencies_from_ranges (address_frequencies);
+}
+
+bool
+perf_branch_stack_reader::parse_perf_data_section ()
+{
+  reset_branch_stack_profile ();
+  range_count_map.clear ();
+  branch_count_map.clear ();
+  address_frequencies.clear ();
+
+  use_fixed_layout_branch_stack_parse_
+    = branch_stack_sample_has_fixed_prefix_layout (sample_type, read_format)
+      && (branch_sample_type
+	  & (perf_branch_stack_format::HW_INDEX
+	     | perf_branch_stack_format::COUNTERS))
+	   == 0;
+
+  size_t processed_samples = 0;
+
+  /* MMAPs can appear after samples in the ring buffer; bind mappings first.  */
+  for_each_mapped_perf_data_record ([&] (size_t,
+					 size_t,
+					 const perf_event_header &record_header,
+					 const uint8_t *payload_ptr,
+					 size_t payload_size,
+					 size_t) {
+    switch (record_header.type)
+      {
+      case perf_record_type::MMAP:
+	parse_mmap_record (payload_ptr, payload_size);
+	break;
+      case perf_record_type::MMAP2:
+	parse_mmap2_record (payload_ptr, payload_size, record_header.misc);
+	break;
+      default:
+	break;
+      }
+  });
+
+  for_each_mapped_perf_data_record ([&] (size_t,
+					 size_t,
+					 const perf_event_header &record_header,
+					 const uint8_t *payload_ptr,
+					 size_t payload_size,
+					 size_t) {
+    switch (record_header.type)
+      {
+      case perf_record_type::SAMPLE:
+	if (payload_size > 0 && parse_sample_record (payload_ptr, payload_size))
+	  processed_samples++;
+	break;
+      default:
+	break;
+      }
+  });
+
+  compute_profile_total_count ();
+
+  if (processed_samples == 0)
+    {
+      if (target_mmaps.empty ())
+	fprintf (stderr,
+		 "PERF-LBR: No samples matched -b %s "
+		 "(no target MMAP/MMAP2 found).\n",
+		 binary_path.c_str ());
+      else
+	fprintf (stderr,
+		 "PERF-LBR: No branch-stack samples accepted for -b %s "
+		 "(%zu target mapping(s); check sample_type / LBR filters).\n",
+		 binary_path.c_str (),
+		 target_mmaps.size ());
+      return false;
+    }
+  return true;
+}
+
+bool
+perf_branch_stack_reader::parse_sample_record (const uint8_t *record_data,
+					       size_t record_size)
+{
+  if (use_fixed_layout_branch_stack_parse_)
+    return parse_sample_record_fixed_branch_stack_layout (
+      record_data, record_size);
+
+  const uint8_t *ptr = record_data;
+  const uint8_t *const end = record_data + record_size;
+
+  uint64_t ip = 0;
+  bool have_ip = false;
+  uint64_t sample_time = 0;
+
+  if (!perf_event_sample_util::walk_sample_before_branch (ptr,
+							  end,
+							  sample_type,
+							  read_format,
+							  &ip,
+							  &have_ip,
+							  nullptr,
+							  &sample_time))
+    {
+      fprintf (stderr, "PERF: WARNING: Truncated or invalid sample (prefix)\n");
+      return false;
+    }
+
+  uint64_t nr = 0;
+  const perf_branch_stack_entry *entries = nullptr;
+  if (!perf_event_sample_util::walk_sample_branch_stack (
+	ptr, end, branch_sample_type, sample_type, &nr, &entries))
+    {
+      fprintf (
+	stderr, "PERF: WARNING: Truncated sample record (BRANCH_STACK)\n");
+      return false;
+    }
+
+  const bool ip_is_target = have_ip && ip != 0 && is_target_address (ip);
+  bool recorded_sample = record_sample_ip (
+    ip, ip_is_target, sample_time, accumulate_sample_ips_, address_frequencies);
+  if ((sample_type & perf_sample_type::BRANCH_STACK) != 0 && nr > 0
+      && accumulate_branch_stack_sample (
+	entries,
+	nr,
+	1,
+	*this,
+	sample_time,
+	target_mmaps,
+	sorted_target_address_ranges_for_branch_stack (),
+	range_count_map,
+	branch_count_map))
+    recorded_sample = true;
+
+  return recorded_sample;
+}
+
+bool
+perf_branch_stack_reader::parse_sample_record_fixed_branch_stack_layout (
+  const uint8_t *record_data, size_t record_size)
+{
+  if (record_size < BRANCH_STACK_FIXED_PREFIX_BYTES + sizeof (uint64_t))
+    return false;
+
+  uint64_t ip = read_u64 (record_data);
+
+  uint64_t sample_time = read_u64 (record_data + 2 * sizeof (uint64_t));
+
+  const uint8_t *ptr = record_data + BRANCH_STACK_FIXED_PREFIX_BYTES;
+  const uint8_t *const end = record_data + record_size;
+
+  uint64_t nr = read_u64 (ptr);
+  ptr += sizeof (uint64_t);
+
+  if (nr > SIZE_MAX / perf_event_sample_util::BRANCH_ENTRY_BYTES)
+    return false;
+  const size_t esz
+    = static_cast<size_t> (nr) * perf_event_sample_util::BRANCH_ENTRY_BYTES;
+  if (esz > static_cast<size_t> (end - ptr))
+    return false;
+
+  const perf_branch_stack_entry *entries
+    = nr > 0 ? reinterpret_cast<const perf_branch_stack_entry *> (ptr)
+	     : nullptr;
+
+  const bool ip_is_target = ip != 0 && is_target_address (ip);
+  bool recorded_sample = record_sample_ip (
+    ip, ip_is_target, sample_time, accumulate_sample_ips_, address_frequencies);
+  if (nr > 0
+      && accumulate_branch_stack_sample (
+	entries,
+	nr,
+	1,
+	*this,
+	sample_time,
+	target_mmaps,
+	sorted_target_address_ranges_for_branch_stack (),
+	range_count_map,
+	branch_count_map))
+    recorded_sample = true;
+
+  return recorded_sample;
+}
+
+void
+perf_branch_stack_reader::compute_profile_total_count ()
+{
+  if (!range_count_map.empty ())
+    {
+      total_samples = total_mass_from_runtime_range_map (range_count_map);
+      return;
+    }
+  total_samples = total_mass_from_address_frequencies (address_frequencies);
+}
+
+void
+perf_branch_stack_reader::finalize_profile_maps_impl ()
+{
+  finalize_branch_stack_maps (
+    range_count_map, branch_count_map, target_mmaps, &sorted_touch_pcs_);
+}
+
+} /* namespace perf_data.  */
