 1 file changed, 424 insertions(+)
 create mode 100644 afdo-tools/src/perf.h

diff --git a/afdo-tools/src/perf.h b/afdo-tools/src/perf.h
new file mode 100644
index 00000000000..1a02cf6d7c6
--- /dev/null
+++ b/afdo-tools/src/perf.h
@@ -0,0 +1,424 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_PERF_H
+#define GCC_PERF_H
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <limits>
+#include <utility>
+#include <vector>
+#include <string>
+#include <unordered_map>
+
+#include <linux/perf_event.h>
+
+#include "hash_util.h"
+
+namespace perf_data {
+
+/* Remove the marker perf appends to mappings of unlinked files.  */
+inline std::string
+normalize_mmap_filename (std::string filename)
+{
+  constexpr char deleted[] = " (deleted)";
+  constexpr size_t length = sizeof (deleted) - 1;
+  if (filename.size () >= length
+      && filename.compare (filename.size () - length, length, deleted) == 0)
+    filename.erase (filename.size () - length);
+  return filename;
+}
+
+/* True when BYTES can be read at PTR without passing END.  */
+inline bool
+bytes_available (const uint8_t *ptr, const uint8_t *end,
+		 uint64_t bytes) noexcept
+{
+  return ptr <= end && bytes <= static_cast<uint64_t> (end - ptr);
+}
+
+/* Record types written by the perf tool rather than the kernel, so absent
+   from <linux/perf_event.h>.  */
+constexpr uint32_t PERF_RECORD_AUXTRACE = 71;
+constexpr uint32_t PERF_RECORD_TIME_CONV = 79;
+constexpr uint32_t PERF_RECORD_COMPRESSED = 81;
+constexpr uint32_t PERF_RECORD_COMPRESSED2 = 83;
+
+/* Perf ABI bits added after Linux 5.0.  Keep local names so builds with
+   older headers can still read newer perf.data files.  */
+constexpr uint64_t SAMPLE_AUX = 1ULL << 20;
+constexpr uint64_t SAMPLE_CGROUP = 1ULL << 21;
+constexpr uint64_t SAMPLE_DATA_PAGE_SIZE = 1ULL << 22;
+constexpr uint64_t SAMPLE_CODE_PAGE_SIZE = 1ULL << 23;
+constexpr uint64_t SAMPLE_WEIGHT_STRUCT = 1ULL << 24;
+constexpr uint64_t SAMPLE_WEIGHT_TYPE
+  = PERF_SAMPLE_WEIGHT | SAMPLE_WEIGHT_STRUCT;
+constexpr uint64_t READ_FORMAT_LOST = 1ULL << 4;
+constexpr uint64_t BRANCH_SAMPLE_HW_INDEX = 1ULL << 17;
+
+/* The sample fields whose size this build knows.  */
+constexpr uint64_t SUPPORTED_SAMPLE_FIELDS
+  = PERF_SAMPLE_IP | PERF_SAMPLE_TID | PERF_SAMPLE_TIME | PERF_SAMPLE_ADDR
+    | PERF_SAMPLE_READ | PERF_SAMPLE_CALLCHAIN | PERF_SAMPLE_ID
+    | PERF_SAMPLE_CPU | PERF_SAMPLE_PERIOD | PERF_SAMPLE_STREAM_ID
+    | PERF_SAMPLE_RAW | PERF_SAMPLE_BRANCH_STACK | PERF_SAMPLE_REGS_USER
+    | PERF_SAMPLE_STACK_USER | PERF_SAMPLE_WEIGHT | PERF_SAMPLE_DATA_SRC
+    | PERF_SAMPLE_IDENTIFIER | PERF_SAMPLE_TRANSACTION | PERF_SAMPLE_REGS_INTR
+    | PERF_SAMPLE_PHYS_ADDR | SAMPLE_AUX | SAMPLE_CGROUP
+    | SAMPLE_DATA_PAGE_SIZE | SAMPLE_CODE_PAGE_SIZE | SAMPLE_WEIGHT_STRUCT;
+
+/* Sample fields branch stack profiling asks for, and assumes when the event
+   attribute is too short to name them.  Only the fields the readers use are
+   listed, to keep samples small.  TIME gives each function the timestamp of
+   its earliest sample.  */
+constexpr uint64_t DEFAULT_BRANCH_STACK_SAMPLE_TYPE
+  = PERF_SAMPLE_IP | PERF_SAMPLE_TID | PERF_SAMPLE_TIME | PERF_SAMPLE_PERIOD
+    | PERF_SAMPLE_BRANCH_STACK;
+
+/* PERF_SAMPLE_BRANCH_COUNTERS, which older kernel headers lack.  */
+constexpr uint64_t BRANCH_SAMPLE_COUNTERS = 1ULL << 19;
+
+/* Branch filters that record only some taken branches.  The code between
+   two branch stack entries is only fall-through when none is set, or
+   PERF_SAMPLE_BRANCH_ANY is.  CALL_STACK entries are not a branch history
+   at all.  */
+constexpr uint64_t BRANCH_SAMPLE_PARTIAL_FILTERS
+  = PERF_SAMPLE_BRANCH_ANY_CALL | PERF_SAMPLE_BRANCH_ANY_RETURN
+    | PERF_SAMPLE_BRANCH_IND_CALL | PERF_SAMPLE_BRANCH_ABORT_TX
+    | PERF_SAMPLE_BRANCH_IN_TX | PERF_SAMPLE_BRANCH_NO_TX
+    | PERF_SAMPLE_BRANCH_COND | PERF_SAMPLE_BRANCH_IND_JUMP
+    | PERF_SAMPLE_BRANCH_CALL;
+
+/* struct perf_branch_entry with its bit-fields as one FLAGS word, since
+   older kernel headers lack the speculation field.  */
+struct perf_branch_stack_entry
+{
+  uint64_t from;
+  uint64_t to;
+  uint64_t flags;
+};
+
+/* The 2-bit speculation field at bit 24 of FLAGS, and its
+   PERF_BR_SPEC_WRONG_PATH value.  */
+constexpr uint64_t BRANCH_SPEC_MASK = 3ULL << 24;
+constexpr uint64_t BRANCH_SPEC_WRONG_PATH = 1ULL << 24;
+
+/* An executable mapping of the profiled binary and its ELF address range.  */
+struct executable_mapping
+{
+  struct takeover
+  {
+    uint64_t start;
+    uint64_t end;
+    uint64_t time;
+    bool inherited = false;
+  };
+
+  uint64_t start_addr;
+  uint64_t end_addr;
+  uint64_t file_offset;	  /* File offset at the start of the mapping.  */
+  uint64_t segment_vaddr;  /* Link-time address at the start of the mapping.  */
+  bool have_segment_vaddr;
+  /* The mapping is in force from its MMAP record's timestamp until another
+     mapping takes the address range over.  TIME_BEGIN 0 means it was already
+     there when recording started.  */
+  uint64_t time_begin = 0;
+  uint64_t time_end = std::numeric_limits<uint64_t>::max ();
+  bool is_pie = false;
+  /* Other mappings overlapping this address range.  */
+  std::vector<takeover> takeovers;
+
+  executable_mapping (uint64_t start, uint64_t end, uint64_t offset,
+		      uint64_t vaddr = 0, bool pie = false, uint64_t begin = 0,
+		      bool have_vaddr = false)
+    : start_addr (start), end_addr (end), file_offset (offset),
+      segment_vaddr (vaddr), have_segment_vaddr (have_vaddr || vaddr != 0),
+      time_begin (begin), is_pie (pie)
+  {
+  }
+
+  bool contains (uint64_t addr) const
+    {
+      return addr >= start_addr && addr < end_addr;
+    }
+
+  /* A takeover inherited at a fork is in force for the child's lifetime.  */
+  bool taken_over_at_start (uint64_t addr) const
+    {
+      for (const takeover &t : takeovers)
+	if (t.inherited && addr >= t.start && addr < t.end)
+	  return true;
+      return false;
+    }
+
+  /* The endpoints are inclusive.  A zero TIME denotes an untimed sample.  */
+  bool contains_range_at (uint64_t begin, uint64_t end, uint64_t time) const
+    {
+      if (end < begin || !contains (begin) || !contains (end))
+	return false;
+      if (time == 0)
+	{
+	  if (time_end != std::numeric_limits<uint64_t>::max ())
+	    return false;
+	}
+      else if (time < time_begin || time >= time_end)
+	return false;
+      for (const takeover &t : takeovers)
+	if (begin < t.end && end >= t.start
+	    && (time == 0 || (t.time >= time_begin && t.time <= time)))
+	  return false;
+      return true;
+    }
+
+  /* Return the link-time address for DWARF lookup.  If the segment address
+     is unavailable, use the file offset for PIE or the runtime address
+     otherwise.  */
+  uint64_t to_dwarf_address (uint64_t runtime_addr) const
+    {
+      if (!contains (runtime_addr))
+	return runtime_addr;
+      uint64_t offset_in_segment = runtime_addr - start_addr;
+      if (have_segment_vaddr)
+	return segment_vaddr + offset_in_segment;
+      if (is_pie)
+	return file_offset + offset_in_segment;
+      return runtime_addr;
+    }
+};
+
+/* Executable mappings of the target binary, keyed by the mapping PID.  */
+using pid_mmap_map
+  = std::unordered_map<uint32_t, std::vector<executable_mapping>>;
+
+/* Little-endian PERFILE2 header.  FEATURES is only the first word of Linux
+   perf's multiword feature bitmap.  Remaining feature words are unused.  */
+struct perf_file_header
+{
+  uint64_t magic;
+  uint64_t size;
+  uint64_t attr_size;
+  uint64_t attrs_offset;
+  uint64_t attrs_size;
+  uint64_t data_offset;
+  uint64_t data_size;
+  uint64_t event_types_offset;
+  uint64_t event_types_size;
+  uint64_t features;
+};
+
+struct perf_mmap_record
+{
+  uint32_t pid;
+  uint32_t tid;
+  uint64_t addr;
+  uint64_t len;
+  uint64_t pgoff;
+};
+
+struct perf_mmap2_record
+{
+  uint32_t pid;
+  uint32_t tid;
+  uint64_t addr;
+  uint64_t len;
+  uint64_t pgoff;
+  union
+    {
+      struct
+	{
+	  uint32_t maj;
+	  uint32_t min;
+	  uint64_t ino;
+	  uint64_t ino_generation;
+	} mmap;
+      struct
+	{
+	  uint8_t build_id_size;
+	  uint8_t __reserved_1;
+	  uint16_t __reserved_2;
+	  uint8_t build_id[20];
+	} build;
+    } id;
+  uint32_t prot;
+  uint32_t flags;
+};
+
+/* Helpers using the structs above (MMAP records, executable_mapping lists).  */
+
+/* Store START + LENGTH in END, rejecting empty and wrapping mappings.  */
+inline bool
+try_compute_mmap_end (uint64_t start, uint64_t length, uint64_t *end)
+{
+  if (end == nullptr || length == 0 || length > UINT64_MAX - start)
+    return false;
+  *end = start + length;
+  return true;
+}
+
+/* Copy the record-trailing FILENAME, which need not be NUL terminated
+   within its FILENAME_MAX bytes.  */
+inline std::string
+perf_mmap_filename_view (const char *filename, size_t filename_max)
+{
+  size_t len = 0;
+  while (len < filename_max && filename[len] != '\0')
+    ++len;
+  return std::string (filename, len);
+}
+
+using branch_stack_edge = std::pair<uint64_t, uint64_t>;
+
+struct branch_stack_edge_hash
+{
+  size_t operator () (const branch_stack_edge &e) const noexcept
+    {
+      size_t hash = 0;
+      autofdo::hash_combine (hash, e.first);
+      autofdo::hash_combine (hash, e.second);
+      return hash;
+    }
+};
+
+/* Aggregated from perf branch-stack samples (x86 LBR, ARM BRBE, etc.).  */
+using branch_stack_edge_count_map
+  = std::unordered_map<branch_stack_edge, uint64_t, branch_stack_edge_hash>;
+
+/* Sorted range/branch count rows after load finalize.  */
+struct profile_range
+{
+  uint64_t beg = 0;
+  uint64_t end = 0;
+  uint64_t count = 0;
+
+  bool operator< (const profile_range &other) const
+    {
+      return beg < other.beg;
+    }
+};
+
+/* The source of a branch into the binary from outside it, kept so entries
+   from other objects (libc to main, callbacks) still count.  */
+constexpr uint64_t EXTERNAL_BRANCH_SOURCE = UINT64_MAX;
+
+struct profile_branch
+{
+  uint64_t from = 0;
+  uint64_t to = 0;
+  uint64_t count = 0;
+
+  bool operator< (const profile_branch &other) const
+    {
+      if (from != other.from)
+	return from < other.from;
+      return to < other.to;
+    }
+};
+
+/* Lowest and highest address carrying mass in RANGES, as MIN_ADDR and
+   MAX_ADDR.  False when no range carries any.  */
+inline bool
+branch_stack_range_bounds (const branch_stack_edge_count_map &ranges,
+			   uint64_t &min_addr, uint64_t &max_addr)
+{
+  min_addr = std::numeric_limits<uint64_t>::max ();
+  max_addr = 0;
+  for (const auto &entry : ranges)
+    {
+      const branch_stack_edge &range = entry.first;
+      if (entry.second == 0 || range.second < range.first)
+	continue;
+      min_addr = std::min (min_addr, range.first);
+      max_addr = std::max (max_addr, range.second);
+    }
+  return min_addr <= max_addr;
+}
+
+/* As total_mass_from_range_counts, for the unfinalized runtime map.  */
+inline uint64_t
+total_mass_from_runtime_range_map (const branch_stack_edge_count_map &ranges)
+{
+  uint64_t total = 0;
+  for (const auto &entry : ranges)
+    {
+      const branch_stack_edge &range = entry.first;
+      const uint64_t count = entry.second;
+      if (range.second >= range.first)
+	total += count * (1 + (range.second - range.first));
+    }
+  return total;
+}
+
+inline uint64_t
+total_mass_from_address_frequencies
+  (const std::unordered_map<uint64_t, uint64_t> &address_frequencies)
+{
+  uint64_t total = 0;
+  for (const auto &entry : address_frequencies)
+    total += entry.second;
+  return total;
+}
+
+/* True if an untimed sample cannot identify the mapping of RUNTIME_ADDR.  */
+inline bool
+untimed_mapping_ambiguous (const std::vector<executable_mapping> &mmaps,
+			   uint64_t runtime_addr)
+{
+  bool found = false;
+  uint64_t address = 0;
+  for (const auto &m : mmaps)
+    if (m.contains (runtime_addr))
+      {
+	if (m.taken_over_at_start (runtime_addr))
+	  continue;
+	if (!m.contains_range_at (runtime_addr, runtime_addr, 0))
+	  return true;
+	const uint64_t current = m.to_dwarf_address (runtime_addr);
+	if (found && current != address)
+	  return true;
+	address = current;
+	found = true;
+      }
+  return false;
+}
+
+/* Translate RUNTIME_ADDR through MMAPS as of SAMPLE_TIME.  A zero SAMPLE_TIME
+   denotes an untimed sample.  Return false if no mapping can be selected.  */
+inline bool
+try_translate_runtime_with_mmaps (const std::vector<executable_mapping> &mmaps,
+				  uint64_t runtime_addr, uint64_t *out,
+				  uint64_t sample_time = 0)
+{
+  if (out == nullptr)
+    return false;
+  if (sample_time == 0 && untimed_mapping_ambiguous (mmaps, runtime_addr))
+    return false;
+  for (const auto &m : mmaps)
+    if (m.contains_range_at (runtime_addr, runtime_addr, sample_time))
+      {
+	*out = m.to_dwarf_address (runtime_addr);
+	return true;
+      }
+  return false;
+}
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_H.  */
-- 
