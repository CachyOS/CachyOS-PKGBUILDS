--- /dev/null
+++ b/afdo-tools/testsuite/afdo-test/is-stmt-callsite-routing.c
@@ -0,0 +1,44 @@
+/* { dg-require-profiling "-fauto-profile" } */
+/* { dg-options "-O2 -g -Wl,--build-id -fno-pie -no-pie" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources auto } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot hot_caller } */
+/* { dg-afdo-dump-inline leaf } */
+/* { dg-afdo-dump-line-hot hot_caller:4 } */
+/* { dg-afdo-requires python3 perf } */
+
+/* GCC may list both a caller callsite and inline-body statements at one PC.
+   Verify that exact-PC fanout retains the caller's source position at the
+   root rather than routing every variant into the inline child.  */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+static inline __attribute__((always_inline))
+int leaf(int x)
+{
+  int y = x + seed;
+  int z = (y * 3) + 1;
+  return z ^ (y >> 2);
+}
+
+__attribute__((noinline))
+int hot_caller(int n)
+{
+  int sum = 0;
+  for (int i = 0; i < n; ++i)
+    sum += leaf(i);
+  return sum;
+}
+
+int main(void)
+{
+  int s = 0;
+  for (int i = 0; i < 20; ++i)
+    s += hot_caller(200000);
+  printf("%d\n", s);
+  return 0;
+}
