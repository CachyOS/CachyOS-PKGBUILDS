+interned_string
+StringPool::lookup (const std::string &str) const
+{
+  if (str.empty ())
+    return nullptr;
+
+  const size_t shard = StringPool::shard (str);
+  std::lock_guard<std::mutex> lock (shard_mus_[shard]);
+  const intern_string_set &shard_set = shards_[shard];
+  const intern_string_set::const_iterator it = shard_set.find (str);
+  return it != shard_set.end () ? &*it : nullptr;
+}
+
+interned_string
+StringPool::lookup (const char *str) const
+{
+  if (str == nullptr || str[0] == '\0')
+    return nullptr;
+
+  const size_t shard = StringPool::shard (str);
+  std::lock_guard<std::mutex> lock (shard_mus_[shard]);
+  const intern_string_set &shard_set = shards_[shard];
+  const intern_string_set::const_iterator it = shard_set.find (str);
+  return it != shard_set.end () ? &*it : nullptr;
+}
+
+interned_string
+StringPool::intern (const std::string &str)
+{
+  if (str.empty ())
+    return nullptr;
+
+  const size_t shard = StringPool::shard (str);
+  std::lock_guard<std::mutex> lock (shard_mus_[shard]);
+  intern_string_set &shard_set = shards_[shard];
+  intern_string_set::const_iterator it = shard_set.find (str);
+  if (it != shard_set.end ())
+    return &*it;
+  return &*shard_set.insert (str).first;
+}
+
+interned_string
+StringPool::intern_cstr (const char *str)
+{
+  if (str == nullptr || str[0] == '\0')
+    return nullptr;
+
+  const size_t shard = StringPool::shard (str);
+  std::lock_guard<std::mutex> lock (shard_mus_[shard]);
+  intern_string_set &shard_set = shards_[shard];
+  intern_string_set::const_iterator it = shard_set.find (str);
+  if (it != shard_set.end ())
+    return &*it;
+  return &*shard_set.insert (std::string (str)).first;
+}
