new file mode 100644
index 00000000000..afd6d65dafe
--- /dev/null
+++ b/afdo-tools/src/gcov_io.cc
@@ -0,0 +1,160 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "gcov.h"
+#include "gcov_io.h"
+
+#ifdef IN_GCC
+#include "intl.h"
+#endif
+
+#include <cstdio>
+#include <cstring>
+
+namespace gcov {
+
+void
+gcov_note_count_overflow ()
+{
+  static bool warned;
+  if (warned)
+    return;
+  warned = true;
+  fprintf (stderr,
+	   _("Warning: GCOV profile count capped at UINT64_MAX\n"));
+}
+
+uint64_t
+gcov_add_count (uint64_t a, uint64_t b)
+{
+  if (b > UINT64_MAX - a)
+    {
+      gcov_note_count_overflow ();
+      return UINT64_MAX;
+    }
+  return a + b;
+}
+
+uint64_t
+gcov_multiply_count (uint64_t a, uint64_t b)
+{
+  if (b != 0 && a > UINT64_MAX / b)
+    {
+      gcov_note_count_overflow ();
+      return UINT64_MAX;
+    }
+  return a * b;
+}
+
+uint64_t
+gcov_location::total_count () const
+{
+  if (type == kind::normal)
+    return static_cast<const gcov_location_normal *> (this)->count;
+  if (type == kind::call)
+    return static_cast<const gcov_location_call *> (this)->count;
+  return static_cast<const gcov_location_inline *> (this)
+    ->inlined_sym.total_count;
+}
+
+uint64_t
+gcov_function_subtree_count (const gcov_function &func)
+{
+  uint64_t total = 0;
+  for (const auto &loc : func.locations)
+    total = gcov_add_count (total, loc->total_count ());
+  return total;
+}
+
+/* Write VALUE to FILE as a raw host-endian 32-bit word.  */
+void
+gcov_write_uint32 (FILE *file, uint32_t value)
+{
+  fwrite (&value, 1, sizeof (value), file);
+}
+
+/* Write VALUE to FILE as two 32-bit words, low word first.  */
+void
+gcov_write_uint64 (FILE *file, uint64_t value)
+{
+  gcov_write_uint32 (file, static_cast<uint32_t> (value));
+  gcov_write_uint32 (file, static_cast<uint32_t> (value >> 32));
+}
+
+/* Write STR to FILE prefixed by its length, which counts the trailing NUL.  */
+void
+gcov_write_string (FILE *file, const std::string &str)
+{
+  const size_t alloc = str.size () + 1; /* Include NUL.  */
+  gcov_write_uint32 (file, static_cast<uint32_t> (alloc));
+  fwrite (str.c_str (), 1, alloc, file);
+}
+
+/* Read a raw host-endian 32-bit word into VALUE, advancing CUR.  Returns
+   false when [CUR, END) is too short.  */
+bool
+gcov_read_uint32 (const uint8_t *&cur, const uint8_t *end, uint32_t &value)
+{
+  if (!COUNT_FITS_IN_BUFFER (cur, end, sizeof (value), 1))
+    return false;
+
+  std::memcpy (&value, cur, sizeof (value));
+  cur += sizeof (value);
+  return true;
+}
+
+/* Read two 32-bit words, low word first, into VALUE.  */
+bool
+gcov_read_uint64 (const uint8_t *&cur, const uint8_t *end, uint64_t &value)
+{
+  uint32_t lo = 0, hi = 0;
+  if (!gcov_read_uint32 (cur, end, lo) || !gcov_read_uint32 (cur, end, hi))
+    return false;
+  value = (static_cast<uint64_t> (hi) << 32) | lo;
+  return true;
+}
+
+/* Read a length-prefixed string into OUT, dropping the trailing NUL.  */
+bool
+gcov_read_string (const uint8_t *&cur, const uint8_t *end, std::string &out)
+{
+  uint32_t byte_len = 0;
+  if (!gcov_read_uint32 (cur, end, byte_len))
+    return false;
+
+  /* A length of zero carries no NUL and denotes the empty string.  */
+  if (byte_len == 0)
+    {
+      out.clear ();
+      return true;
+    }
+
+  if (!COUNT_FITS_IN_BUFFER (cur, end, byte_len, 1)
+      || cur[byte_len - 1] != '\0')
+    return false;
+
+  out.assign (reinterpret_cast<const char *> (cur), byte_len - 1);
+  cur += byte_len;
+  return true;
+}
+
+} /* namespace gcov.  */
