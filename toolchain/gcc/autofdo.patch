+enum class perf_scan_log : uint8_t
+{
+  GENERIC,
+  SPE
+};
+
+/* perf_event_attr fields that determine the SAMPLE record layout.  */
+struct attr_sample_layout
+{
+  uint64_t sample_type = DEFAULT_BRANCH_STACK_SAMPLE_TYPE;
+  uint64_t read_format = 0;
+  uint64_t branch_sample_type = 0;
+  uint64_t sample_regs_user = 0;
+  uint64_t sample_regs_intr = 0;
+  uint64_t sample_period = 0;
+  /* True when every sample carries the same known mass.  The event counts on a
+     fixed period.  */
+  bool fixed_sample_period = false;
+  /* True when side-band records carry a sample_id trailer.  That is what
+     puts a timestamp on the MMAP records.  */
+  bool sample_id_all = false;
+};
+
+/* Offline perf.data loader.  Subclasses ingest samples.  */
+class perf_file_reader : public profile_reader
+{
+public:
+  perf_file_reader (const std::string &perf_data_path,
+		    const std::string &binary_path)
+    : perf_data_path (perf_data_path), binary_path (binary_path),
+      total_profile_mass (0), header{}
+  {}
+
+  ~perf_file_reader () override;
+
+  bool load () override;
+  const address_frequency_map &get_address_frequencies () const override
+  {
+    return address_frequencies;
+  }
+  uint64_t get_total_mass () const override { return total_profile_mass; }
+
+protected:
+  /* Lifecycle / I/O.  */
+  bool open_and_map_file ();
+  void cleanup ();
+  bool parse_header ();
+  virtual bool parse_perf_data_section () = 0;
+  void clear_runtime_translation_state ();
+
+  /* Record scan.  Returns false on truncation or a malformed record.  */
+  bool for_each_mapped_perf_data_record
+    (const std::function<void (const perf_event_header &hdr,
+			       const uint8_t *payload, size_t payload_size,
+			       size_t skip_whole)> &fn,
+     perf_scan_log log = perf_scan_log::GENERIC);
+  size_t perf_record_skip_bytes (const perf_event_header &record_header,
+				 const uint8_t *payload,
+				 size_t data_remaining) const;
+  bool parse_mmap_record (const uint8_t *record_data, size_t record_size,
+			  uint16_t misc);
+  bool parse_mmap2_record (const uint8_t *record_data, size_t record_size,
+			   uint16_t misc);
+  void add_target_mmap (uint32_t pid, uint32_t tid, uint64_t start,
+			uint64_t end, uint64_t pgoff, uint64_t time);
+  void note_process_lifetime_record (const perf_event_header &header,
+				     const uint8_t *payload,
+				     size_t payload_size);
+  void note_time_conv_record (const uint8_t *payload, size_t payload_size);
+  bool counter_to_perf_time (uint64_t counter, uint64_t *out_time) const;
+  /* Per-CPU schedule of the traced processes, for attributing AUX records.
+     Read the ITRACE_START and SWITCH records, then sort before searching.  */
+  void note_cpu_schedule_record (const perf_event_header &header,
+				 const uint8_t *payload, size_t payload_size);
+  void sort_cpu_schedule ();
+  bool cpu_owner_at (uint32_t cpu, uint64_t time, uint32_t *out_pid) const;
+  bool cpu_has_schedule (uint32_t cpu) const
+  {
+    return cpu_schedule_.count (cpu) != 0;
+  }
+  /* True when CPU's schedule names a process that is not a target.  */
+  bool cpu_runs_other_processes (uint32_t cpu) const;
+  void observe_executable_mmap (uint32_t pid, uint64_t start, uint64_t end,
+				uint64_t pgoff, bool is_target,
+				const std::string &mmap_filename,
+				uint64_t time);
+  /* Give forked children their parent's target mappings, bound each mapping
+     by the time another mapping, an exec or a new process with the same pid
+     takes over, and tie threads to target processes.  Call after all
+     mappings and task records have been read.  */
+  void close_target_mmap_time_windows ();
+  void bound_target_mmaps (uint32_t pid,
+			   std::vector<executable_mapping> &mmaps);
+  bool target_mapping_lifetime_valid () const;
+
+  /* Target binary / address filters.  */
+  bool is_target_binary (const std::string &mmap_filename,
+			 const std::string &build_id) const;
+  void report_build_id_mismatch (const std::string &mmap_path,
+				 const std::string &recorded_build_id) const;
+  bool is_valid_user_address (uint64_t addr) const;
+  const std::vector<executable_mapping> *
+  target_mmaps_for_pid (uint32_t pid) const;
+  /* Try the sample's process, then resolve its thread through task
+     records.  */
+  const std::vector<executable_mapping> *
+  target_mmaps_for_sample (uint32_t pid, uint32_t tid) const;
+  size_t target_mmap_count () const;
+  void parse_build_id_table () const;
+
+  const uint8_t *mapped_bytes () const { return mapped_file_.data (); }
+  size_t mapped_size () const { return mapped_file_.size (); }
+
+  /* Paths and sample mass.  */
+  std::string perf_data_path;
+  std::string binary_path;
+  uint64_t total_profile_mass;
+  address_frequency_map address_frequencies;
+  pid_mmap_map target_mmaps_by_pid_;
+  std::unordered_map<uint32_t, uint32_t> target_pid_by_tid_;
+
+  struct mmap_observation
+  {
+    std::string filename;
+    uint64_t start;
+    uint64_t end;
+    uint64_t pgoff;
+    uint64_t time;
+    bool is_target;
+  };
+  std::unordered_map<uint32_t, std::vector<mmap_observation>>
+    executable_mmaps_by_pid_;
+  std::unordered_set<uint32_t> target_mapping_pids_;
+  std::unordered_set<uint32_t> unstable_target_pids_;
+  /* Process of each thread, and the processes, named by COMM and FORK.  */
+  std::unordered_map<uint32_t, uint32_t> thread_pids_;
+  std::unordered_set<uint32_t> task_pids_;
+  /* PID starts a new address space at TIME.  Forked from PARENT, or by an
+     exec when IS_EXEC.  */
+  struct process_start
+  {
+    uint32_t pid;
+    uint32_t parent;
+    uint64_t time;
+    bool is_exec;
+  };
+  std::vector<process_start> process_starts_;
+  /* PIDs whose target mapping shares an address range with a later mapping.
+     The record timestamps tell the two apart.  */
+  std::unordered_set<uint32_t> reused_range_pids_;
+  bool mmap_time_windows_closed_ = false;
+  bool warned_reused_mmap_range_ = false;
+
+  /* PERF_RECORD_TIME_CONV relates the hardware counter an AUX trace stamps
+     its records with to the timestamps the side-band records carry.  */
+  struct counter_time_conversion
+  {
+    uint64_t shift = 0;
+    uint64_t mult = 0;
+    uint64_t zero = 0;
+    uint64_t cycles = 0;
+    uint64_t mask = 0;
+    bool valid = false;
+    bool short_counter = false;
+  };
+  counter_time_conversion counter_time_conv_;
+
+  /* PID 0 marks the point where the CPU stops running anything traced.  */
+  struct cpu_schedule_entry
+  {
+    uint64_t time;
+    uint32_t pid;
+  };
+  std::unordered_map<uint32_t, std::vector<cpu_schedule_entry>> cpu_schedule_;
+
+  /* Build-id cache and HEADER_BUILD_ID table.  */
+  mutable std::string cached_target_build_id_;
+  mutable bool cached_target_build_id_valid_ = false;
+  mutable std::map<std::string, std::string, std::less<>> buildid_table_;
+  mutable bool buildid_table_valid_ = false;
+  mutable bool reported_build_id_mismatch_ = false;
+
+  /* Mapped perf.data and sample attributes.  */
+  afdo_tools::file_mmap mapped_file_;
+  perf_file_header header;
+  attr_sample_layout sample_layout;
+  /* Side-band records carry the sample_id trailer of the event that wrote
+     them, often perf's dummy tracking event.  When every event samples
+     PERF_SAMPLE_IDENTIFIER the trailer's last word names it.  Otherwise
+     assume the event that tracks mmaps.  */
+  std::unordered_map<uint64_t, attr_sample_layout> sideband_layout_by_id_;
+  attr_sample_layout sideband_layout_;
+  const attr_sample_layout &sideband_layout (const uint8_t *payload,
+					     size_t payload_size) const;
+  /* Events the kernel dropped while recording (PERF_RECORD_LOST*).  */
+  uint64_t lost_events_ = 0;
+  /* Times the kernel throttled the event (PERF_RECORD_THROTTLE).  */
+  uint64_t throttle_events_ = 0;
+  /* Process mapping sets perf stopped reading after its timeout.  */
+  uint64_t proc_map_timeouts_ = 0;
+};
+
+std::unique_ptr<profile_reader>
+create_perf_reader (const std::string &perf_data_path,
+		    const std::string &binary_path, sampling_mode mode);
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_FILE_READER_H.  */
