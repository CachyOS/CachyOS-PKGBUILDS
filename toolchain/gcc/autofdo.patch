new file mode 100644
index 00000000000..e62bcaeea40
--- /dev/null
+++ b/afdo-tools/src/profile_reader.h
@@ -0,0 +1,141 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
