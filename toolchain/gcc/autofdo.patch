+
+#ifndef GCC_DWARF_READER_IMPL_H
+#define GCC_DWARF_READER_IMPL_H
+
+#include "dwarf_reader.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <elfutils/libdw.h>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace dwarf_debug {
+
+/* CU parse workers to use when the caller does not pick a count.  */
+constexpr unsigned CU_PARSE_DEFAULT_THREADS = 8;
+
+/* Concurrent libdw sessions to allow, however many workers were asked for.
+   Each session maps the whole binary, and resident pages are charged per
+   mapping, so sessions cost memory in a way plain threads do not.  */
+constexpr unsigned CU_PARSE_MAX_SESSIONS = 32;
+
+/* Per-thread libdw open (handles are not thread-safe).  */
+struct libdw_file_session
+{
+  int fd = -1;
+  Dwarf *dwarf = nullptr;
+};
+
+/* One worker of a parallel DWARF walk, called with that worker's own handle.
+   Workers share a queue, so each must be able to process any compilation
+   unit.  */
+using libdw_worker_body = std::function<void (Dwarf *)>;
+
+/* Decl site of a DIE.  FILE_PATH points into the interned string pool when
+   retained beyond the libdw operation that read it.  */
+struct die_decl_site
+{
+  const char *file_path = nullptr;
+  uint32_t line_number = 0;
+};
+
+/* Interned name -> indices into a function table.  */
+using name_index_map = std::unordered_map<interned_string, std::vector<size_t>>;
+
+using intern_string_set = std::set<std::string, std::less<>>;
+
+/* Thread-safe interned-string pool (stable pointer identity).  */
+class StringPool
+{
+public:
+  static constexpr size_t SHARD_COUNT = 32;
+
+  interned_string intern (const std::string &str);
+
+  /* As above, tolerating the null that DWARF and ELF readers hand back.  */
+  interned_string intern (const char *str)
+  {
+    if (str == nullptr || str[0] == '\0')
+      return nullptr;
+    return intern (std::string (str));
+  }
+  interned_string lookup (const std::string &str) const;
+
+private:
+  static size_t shard (const std::string &str)
+  {
+    return std::hash<std::string>{}(str) % SHARD_COUNT;
+  }
+
+  std::array<intern_string_set, SHARD_COUNT> shards_{};
+  mutable std::array<std::mutex, SHARD_COUNT> shard_mus_{};
+};
+
+struct cu_line_row
+{
+  uint64_t addr = 0;
+  uint32_t run_line = 0;
+  uint32_t disc = 0;
+  interned_string file_path = nullptr;
+  bool is_stmt = false;
+};
+
+/* One PC range of an inlined_subroutine DIE; stack is shared across the
+   DIE's discontiguous ranges.  */
+struct inline_stack_span
+{
+  uint64_t start = 0;
+  uint64_t end = 0;
+  std::shared_ptr<const std::vector<inline_frame>> stack;
+
+  bool operator< (const inline_stack_span &other) const
+  {
+    return start < other.start;
+  }
+};
+
+struct range_max_tree_index
+{
+  size_t leaf_base = 0;
+  std::vector<uint64_t> max_ends;
+};
+
+/* Sample-scoped DWARF + ELF symtab index (pimpl for dwarf_reader).  */
+class dwarf_reader_impl
+{
+public:
+  /* Sampled [start,end) file-offset ranges (merged internally).  */
+  explicit dwarf_reader_impl (std::string binary_path,
+			      pc_range_list sampled_ranges);
+  ~dwarf_reader_impl ();
+
+  dwarf_reader_impl (const dwarf_reader_impl &) = delete;
+  dwarf_reader_impl &operator= (const dwarf_reader_impl &) = delete;
+
+  /* Lifecycle.  */
+  void set_parse_threads (unsigned n);
+  bool load ();
+  const dwarf_load_summary &load_summary () const { return load_summary_; }
+
+  /* Symtab / containing function.  */
+  /* Correlatable ELF symtab functions, sorted by start address.  */
+  const std::vector<function_metadata> &symtab_functions () const
+  {
+    return symtab_functions_;
+  }
+  const std::vector<function_alias_metadata> &symtab_aliases () const
+  {
+    return symtab_aliases_;
+  }
+  const function_metadata *containing_function_at_pc (uint64_t address) const;
+
+  /* Symbolize + inline stack.  */
+  symbolized_result
+  symbolize (uint64_t file_offset, correlate_session &session,
+	     const function_metadata &containing_function) const;
+  void collect_line_span_seed_pcs (uint64_t start, uint64_t end,
+				   std::vector<uint64_t> &out) const;
+  source_location
+  resolve_inline_frame_decl_location (const inline_frame &frame,
+				      const std::string &caller_file) const;
+
+private:
+  /* Nested load / parse types.  */
+  struct address_range_entry
+  {
+    uint64_t start = 0;
+    uint64_t end = 0;
+    source_location loc;
+    /* Index of the last .debug_line row (within the CU) that contributed this
+       (file,line) variant.  */
+    uint32_t line_row_seq = 0;
+    /* Primary variant at a duplicate PC (final line-table row).  */
+    bool line_table_primary = false;
+    bool line_table_is_stmt = false;
+    /* .debug_line Address column for this variant's duplicate-PC group.  */
+    uint64_t line_table_pc = 0;
+
+    bool operator< (const address_range_entry &other) const
+    {
+      return start < other.start;
+    }
+  };
+
+  struct cu_lines
+  {
+    std::vector<cu_line_row> line_rows;
+    std::vector<address_range_entry> ranges;
+  };
+
+  struct cu_parse_symbols
+  {
+    cu_lines lines;
+    std::vector<inline_stack_span> inline_spans;
+    std::vector<function_metadata> symbols;
+    bool parsed = false;
+  };
+
+  /* Results of the all-CU metadata walk, accumulated one CU at a time.  */
+  struct global_die_metadata
+  {
+    std::unordered_map<Dwarf_Off, die_decl_site> enclosing_types;
+    std::vector<function_metadata> alias_identities;
+  };
+
+  /* Inputs and scratch for the all-CU metadata walk; one instance per worker
+     thread.  OUT points at the CU currently being walked: it is read back
+     during the walk, so it must not span CUs or results would depend on
+     thread scheduling.  */
+  struct global_die_walk
+  {
+    /* Symtab alias names whose DWARF source identity is wanted.  */
+    const intern_string_set *identity_names = nullptr;
+    /* Enclosing type decls of the DIEs currently open.  */
+    std::vector<die_decl_site> type_stack;
+    global_die_metadata *out = nullptr;
+  };
+
+  /* Reusable working memory for the CU DIE-tree walk (per worker thread).  */
+  struct cu_die_parser
+  {
+    pc_range_list pc_ranges;
+    std::vector<inline_frame> inline_stack;
+    /* Ancestor PC ranges; reject child ranges not a subset of the parent.  */
+    std::vector<pc_range_list> inline_ranges_stack;
+
+    void reset_for_cu () noexcept
+    {
+      pc_ranges.clear ();
+      inline_stack.clear ();
+      inline_ranges_stack.clear ();
+    }
+  };
+
+  /* Load orchestration.  */
+  unsigned dwarf_parse_thread_count (size_t n_cus) const;
+  bool for_each_libdw_worker (unsigned num_threads,
+			      const libdw_worker_body &body) const;
+  bool open_binary_dwarf ();
+  bool build_profile_cu_index (Dwarf_Aranges *aranges, size_t naranges);
+  std::vector<Dwarf_Off> all_cu_die_offsets () const;
+  bool build_address_range_index ();
+  void resolve_touch_symtab_export_anchors ();
+  void resolve_symtab_export_anchor (function_metadata &sym,
+				     correlate_session &session);
+
+  /* Sample-scope predicates.  */
+  bool range_overlaps_sampled (uint64_t lo, uint64_t hi) const;
+  bool function_overlaps_sampled (const function_metadata &func) const;
+  bool address_range_overlaps_sampled (
+    uint64_t range_start, uint64_t range_end_excl,
+    const std::vector<function_metadata> &cu_local_functions) const;
+
+  /* CU parse + merge.  */
+  bool parse_profile_cus (unsigned num_threads);
+  bool parse_cu_symbols (Dwarf *dwarf, Dwarf_Off cu_off, cu_parse_symbols &out,
+			 cu_die_parser &parser) const;
+  void parse_cu_die_tree_recursive (Dwarf_Die *die,
+				    std::vector<inline_stack_span> &spans_out,
+				    std::vector<function_metadata> &symbols_out,
+				    cu_die_parser &parser) const;
+  void record_global_die_metadata (Dwarf_Die *die, global_die_walk &walk) const;
+  void build_global_die_metadata ();
+  void decode_cu_line_rows (Dwarf_Lines *lines, size_t nlines,
+			    cu_lines &out) const;
+  void emit_cu_line_ranges (
+    cu_lines &out, uint64_t cu_end_excl,
+    const std::vector<function_metadata> &cu_local_functions) const;
+  void record_subprogram_metadata (
+    Dwarf_Die *die, std::vector<function_metadata> &symbols_out) const;
+  bool visit_inlined_subroutine_die
+    (Dwarf_Die &die, cu_die_parser &parser,
+     std::vector<inline_stack_span> &spans_out) const;
+  void merge_cu_parse_symbols (cu_parse_symbols &buf);
+  void merge_consecutive_address_ranges ();
+
+  /* Post-parse indexes.  */
+  void build_symtab_func_index ();
+  void build_dwarf_name_indexes ();
+  void build_symtab_name_equivalence_index ();
+
+  /* Line-table / address-range lookup.  */
+  const std::vector<inline_frame> *inline_stack_at_pc (uint64_t pc) const;
+  bool lookup_primary_source_location_at_address (uint64_t address,
+						  source_location &out) const;
+  static bool same_line_table_coalesce_group (const address_range_entry &a,
+					      const address_range_entry &b);
+
+  /* Symbolize (on-demand; session scratch).  FUNC is the already-resolved
+     containing function.  */
+  bool build_correlate_locations_at_pc (uint64_t file_offset,
+					const function_metadata &func,
+					std::vector<source_location> &out,
+					size_t &dwarf_line_index) const;
+
+  /* Decl helpers used by the public identity API.  */
+  /* Indices for NAME, falling back to its GCC-suffix base name; nullptr when
+     neither is indexed.  */
+  const std::vector<size_t> *find_name_index (const name_index_map &index,
+					      const std::string &name) const;
+
+  using function_range
+    = std::pair<std::vector<function_metadata>::const_iterator,
+		std::vector<function_metadata>::const_iterator>;
+  /* Code-bearing DWARF subprograms entered at ADDR; ICF, aliasing, and COMDAT
+     merging can put several at one address.  */
+  function_range dwarf_functions_at_entry (uint64_t addr) const;
+
+  const function_metadata *find_function_at_entry (const std::string &name,
+						   uint64_t addr) const;
+  const function_metadata *
+  find_unique_alias_identity (const std::string &name) const;
+  uint32_t parse_time_decl_line (const std::string &name, uint64_t start_addr,
+				 const function_metadata *at_entry,
+				 const function_metadata *identity) const;
+  bool function_profile_root_at_addr (uint64_t addr, const std::string &name,
+				      source_location &out) const;
+
+  /* Configuration / load state.  */
+  std::string binary_path_;
+  pc_range_list profile_sample_ranges_;
+  bool mappings_loaded = false;
+  unsigned parse_threads_ = CU_PARSE_DEFAULT_THREADS;
+  dwarf_load_summary load_summary_;
+
+  /* Function tables and name indexes.  */
+  std::vector<function_metadata> dwarf_functions_;
+  /* Name-only DWARF definitions for aliases whose code-bearing DIE was
+     eliminated by ICF; their address range remains zero.  */
+  std::vector<function_metadata> dwarf_alias_identities_;
+  std::vector<function_metadata> symtab_functions_;
+  name_index_map dwarf_func_name_index_;
+  name_index_map dwarf_alias_name_index_;
+  name_index_map symtab_equiv_index_;
+  /* ELF names dropped by symtab range dedupe.  */
+  std::vector<function_alias_metadata> symtab_aliases_;
+  /* Subprogram/inlined DIE offset -> enclosing class/struct/union decl.  */
+  std::unordered_map<Dwarf_Off, die_decl_site> enclosing_type_by_die_;
+  /* Line segments and inline DIE spans.  */
+  std::vector<address_range_entry> address_ranges_;
+  range_max_tree_index address_range_index_;
+  std::vector<inline_stack_span> inline_stack_spans_;
+  range_max_tree_index inline_stack_span_index_;
+
+  /* libdw session + CU aranges index.  */
+  mutable StringPool string_pool_;
+  libdw_file_session dw_;
+  /* Both filled at the aranges scan and cleared after load.  */
+  std::unordered_map<Dwarf_Off, uint64_t> cu_end_by_off_;
+  std::vector<Dwarf_Off> profile_cu_offs_;
+};
+
+} /* namespace dwarf_debug.  */
+
+#endif /* GCC_DWARF_READER_IMPL_H.  */
