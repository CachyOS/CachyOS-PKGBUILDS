+
+#include "perf_event_sample_util.h"
+
+namespace perf_data {
+namespace perf_event_sample_util {
+namespace {
+
+constexpr uint64_t SUPPORTED_READ_FORMAT
+  = PERF_FORMAT_TOTAL_TIME_ENABLED | PERF_FORMAT_TOTAL_TIME_RUNNING
+    | PERF_FORMAT_ID | PERF_FORMAT_GROUP | READ_FORMAT_LOST;
+
+int
+popcount64 (uint64_t x)
+{
+  int bits = 0;
+  for (; x != 0; x &= x - 1)
+    ++bits;
+  return bits;
+}
+
+/* Consume PERF_SAMPLE_READ, whose size depends on read format RF.  */
+bool
+skip_sample_read (const uint8_t *&ptr, const uint8_t *end, uint64_t rf)
+{
+  if (rf & ~SUPPORTED_READ_FORMAT)
+    return false;
+  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+    return false;
+  uint64_t first;
+  std::memcpy (&first, ptr, sizeof (first));
+  ptr += sizeof (uint64_t);
+  if (rf & PERF_FORMAT_TOTAL_TIME_ENABLED)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (rf & PERF_FORMAT_TOTAL_TIME_RUNNING)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (rf & PERF_FORMAT_GROUP)
+    {
+      const uint64_t nr = first;
+      size_t words_per_event = 1;
+      if (rf & PERF_FORMAT_ID)
+	++words_per_event;
+      if (rf & READ_FORMAT_LOST)
+	++words_per_event;
+      if (nr > SIZE_MAX / sizeof (uint64_t) / words_per_event)
+	return false;
+      const size_t sz
+	= static_cast<size_t> (nr) * words_per_event * sizeof (uint64_t);
+      if (!bytes_available (ptr, end, sz))
+	return false;
+      ptr += sz;
+    }
+  else
+    {
+      /* FIRST was the non-group value.  ID and LOST are optional.  */
+      if (rf & PERF_FORMAT_ID)
+	{
+	  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	    return false;
+	  ptr += sizeof (uint64_t);
+	}
+      if (rf & READ_FORMAT_LOST)
+	{
+	  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	    return false;
+	  ptr += sizeof (uint64_t);
+	}
+    }
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+bool
+walk_sample_before_branch (const uint8_t *&ptr, const uint8_t *end,
+			   uint64_t sample_ty, uint64_t read_format,
+			   uint64_t *out_ip, bool *out_have_ip,
+			   uint32_t *out_pid, uint32_t *out_tid,
+			   uint64_t *out_period, uint64_t *out_time)
+{
+  uint64_t ip = 0;
+  uint32_t pid = 0;
+  uint32_t tid = 0;
+  uint64_t period = 0;
+  uint64_t time = 0;
+  bool have_ip = false;
+  if (out_ip)
+    *out_ip = 0;
+  if (out_have_ip)
+    *out_have_ip = false;
+  if (out_pid)
+    *out_pid = 0;
+  if (out_tid)
+    *out_tid = 0;
+  if (out_period)
+    *out_period = 0;
+  if (out_time)
+    *out_time = 0;
+
+  if (sample_ty & PERF_SAMPLE_IDENTIFIER)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_IP)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      std::memcpy (&ip, ptr, sizeof (ip));
+      have_ip = true;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_TID)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      std::memcpy (&pid, ptr, sizeof (pid));
+      std::memcpy (&tid, ptr + sizeof (pid), sizeof (tid));
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_TIME)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      std::memcpy (&time, ptr, sizeof (time));
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_ADDR)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_ID)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_STREAM_ID)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_CPU)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_PERIOD)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      std::memcpy (&period, ptr, sizeof (period));
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_READ)
+    {
+      if (!skip_sample_read (ptr, end, read_format))
+	return false;
+    }
+  /* TODO: the call chain is skipped, not read.  It would give the profile
+     calling context, which LLVM's converter already uses.  */
+  if (sample_ty & PERF_SAMPLE_CALLCHAIN)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t nr;
+      std::memcpy (&nr, ptr, sizeof (nr));
+      ptr += sizeof (uint64_t);
+      if (nr > SIZE_MAX / sizeof (uint64_t))
+	return false;
+      const size_t sz = static_cast<size_t> (nr) * sizeof (uint64_t);
+      if (!bytes_available (ptr, end, sz))
+	return false;
+      ptr += sz;
+    }
+  if (sample_ty & PERF_SAMPLE_RAW)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint32_t)))
+	return false;
+      uint32_t raw_size;
+      std::memcpy (&raw_size, ptr, sizeof (raw_size));
+      ptr += sizeof (uint32_t);
+      if (!bytes_available (ptr, end, raw_size))
+	return false;
+      ptr += raw_size;
+    }
+
+  if (out_ip)
+    *out_ip = ip;
+  if (out_have_ip)
+    *out_have_ip = have_ip;
+  if (out_pid)
+    *out_pid = pid;
+  if (out_tid)
+    *out_tid = tid;
+  if (out_period)
+    *out_period = period;
+  if (out_time)
+    *out_time = time;
+  return true;
+}
+
+namespace {
+
+/* Consume PERF_SAMPLE_BRANCH_STACK and return its entries.  */
+bool
+walk_sample_branch_stack (const uint8_t *&ptr, const uint8_t *end,
+			  uint64_t branch_sample_type, uint64_t sample_ty,
+			  branch_stack_view &branch_stack)
+{
+  branch_stack = {};
+  if (!(sample_ty & PERF_SAMPLE_BRANCH_STACK))
+    {
+      return true;
+    }
+  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+    return false;
+  uint64_t nr;
+  std::memcpy (&nr, ptr, sizeof (nr));
+  ptr += sizeof (uint64_t);
+  if (branch_sample_type & BRANCH_SAMPLE_HW_INDEX)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (nr > SIZE_MAX / BRANCH_ENTRY_BYTES)
+    return false;
+  const size_t esz = static_cast<size_t> (nr) * BRANCH_ENTRY_BYTES;
+  if (!bytes_available (ptr, end, esz))
+    return false;
+  const uint8_t *const entries = ptr;
+  ptr += esz;
+  if (branch_sample_type & BRANCH_SAMPLE_COUNTERS)
+    {
+      if (nr > SIZE_MAX / sizeof (uint64_t))
+	return false;
+      const size_t csz = static_cast<size_t> (nr) * sizeof (uint64_t);
+      if (!bytes_available (ptr, end, csz))
+	return false;
+      ptr += csz;
+    }
+  branch_stack = branch_stack_view (entries, static_cast<size_t> (nr));
+  return true;
+}
+
+/* Consume fields after PERF_SAMPLE_BRANCH_STACK.  */
+bool
+walk_sample_after_branch (const uint8_t *&ptr, const uint8_t *end,
+			  uint64_t sample_ty, uint64_t sample_regs_user,
+			  uint64_t sample_regs_intr)
+{
+  /* TODO: the register values are skipped, not read.  They could recover
+     some of the value profiling that instrumented gcov has and AutoFDO
+     lacks, but that needs DWARF location expressions to interpret them.  */
+  if (sample_ty & PERF_SAMPLE_REGS_USER)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t abi;
+      std::memcpy (&abi, ptr, sizeof (abi));
+      ptr += sizeof (uint64_t);
+      if (abi != 0)
+	{
+	  const size_t rsz = static_cast<size_t> (popcount64 (sample_regs_user))
+			     * sizeof (uint64_t);
+	  if (!bytes_available (ptr, end, rsz))
+	    return false;
+	  ptr += rsz;
+	}
+    }
+  if (sample_ty & PERF_SAMPLE_STACK_USER)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t stack_sz;
+      std::memcpy (&stack_sz, ptr, sizeof (stack_sz));
+      ptr += sizeof (uint64_t);
+      if (stack_sz != 0)
+	{
+	  if (!bytes_available (ptr, end, stack_sz))
+	    return false;
+	  ptr += static_cast<size_t> (stack_sz);
+	  if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	    return false;
+	  uint64_t dynamic_size;
+	  std::memcpy (&dynamic_size, ptr, sizeof (dynamic_size));
+	  if (dynamic_size > stack_sz)
+	    return false;
+	  ptr += sizeof (uint64_t);
+	}
+    }
+  if (sample_ty & SAMPLE_WEIGHT_TYPE)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_DATA_SRC)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_TRANSACTION)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & PERF_SAMPLE_REGS_INTR)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t abi;
+      std::memcpy (&abi, ptr, sizeof (abi));
+      ptr += sizeof (uint64_t);
+      if (abi != 0)
+	{
+	  const size_t rsz = static_cast<size_t> (popcount64 (sample_regs_intr))
+			     * sizeof (uint64_t);
+	  if (!bytes_available (ptr, end, rsz))
+	    return false;
+	  ptr += rsz;
+	}
+    }
+  if (sample_ty & PERF_SAMPLE_PHYS_ADDR)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & SAMPLE_CGROUP)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & SAMPLE_DATA_PAGE_SIZE)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & SAMPLE_CODE_PAGE_SIZE)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      ptr += sizeof (uint64_t);
+    }
+  if (sample_ty & SAMPLE_AUX)
+    {
+      if (!bytes_available (ptr, end, sizeof (uint64_t)))
+	return false;
+      uint64_t aux_sz;
+      std::memcpy (&aux_sz, ptr, sizeof (aux_sz));
+      ptr += sizeof (uint64_t);
+      if (!bytes_available (ptr, end, aux_sz))
+	return false;
+      ptr += static_cast<size_t> (aux_sz);
+    }
+  return true;
+}
+
+} /* anonymous namespace.  */
+
+bool
+walk_sample_branch_and_suffix (const uint8_t *&ptr, const uint8_t *end,
+			       uint64_t branch_sample_type,
+			       uint64_t sample_ty, uint64_t sample_regs_user,
+			       uint64_t sample_regs_intr,
+			       branch_stack_view &branch_stack)
+{
+  const uint8_t *const start = ptr;
+  auto try_layout = [&] (uint64_t branch_type)
+    {
+      const uint8_t *p = start;
+      if (!walk_sample_branch_stack (p, end, branch_type, sample_ty,
+				     branch_stack)
+	  || !walk_sample_after_branch (p, end, sample_ty, sample_regs_user,
+				       sample_regs_intr)
+	  || p != end)
+	return false;
+      ptr = p;
+      return true;
+    };
+
+  if (try_layout (branch_sample_type))
+    return true;
+
+  /* With no branch stack the kernel can omit the hardware index.  */
+  uint64_t nr;
+  if ((sample_ty & PERF_SAMPLE_BRANCH_STACK)
+      && (branch_sample_type & BRANCH_SAMPLE_HW_INDEX)
+      && bytes_available (start, end, sizeof (nr)))
+    {
+      std::memcpy (&nr, start, sizeof (nr));
+      if (nr == 0)
+	return try_layout (branch_sample_type & ~BRANCH_SAMPLE_HW_INDEX);
+    }
+  return false;
+}
+
+} /* namespace perf_event_sample_util.  */
+} /* namespace perf_data.  */
