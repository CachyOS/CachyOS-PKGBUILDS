+
+#ifndef GCC_PERF_FILE_READER_H
+#define GCC_PERF_FILE_READER_H
+
+#include "file_mmap.h"
+#include "perf.h"
+#include "profile_reader.h"
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace perf_data {
+
+enum class sampling_mode : uint8_t
+{
+  BRANCH_STACK,
+  SPE
+};
+
+/* Scan-log prefix for record diagnostics.  */
+enum class perf_scan_log : uint8_t
+{
+  GENERIC,
+  SPE
+};
+
+/* perf_event_attr fields that determine the SAMPLE record layout.  */
+struct attr_sample_layout
+{
+  uint64_t eff_size = 0;
+  uint64_t sample_type = DEFAULT_BRANCH_STACK_SAMPLE_TYPE;
+  uint64_t read_format = 0;
+  uint64_t branch_sample_type = 0;
+  uint64_t sample_regs_user = 0;
+  uint64_t sample_regs_intr = 0;
+  uint64_t sample_period = 0;
+  /* True when every sample carries the same known mass: the event counts on a
+     fixed period and each sample reports that period.  */
+  bool fixed_sample_period = false;
+};
+
+/* Offline perf.data loader; subclasses ingest samples.  */
+class perf_file_reader : public profile_reader
+{
+public:
+  perf_file_reader (const std::string &_perf_data_path,
+		    const std::string &_binary_path)
+    : perf_data_path (_perf_data_path), binary_path (_binary_path),
+      total_samples (0), header{}
+  {}
+
+  ~perf_file_reader () override;
+
+  bool load () override;
+  const std::unordered_map<uint64_t, uint64_t> &
+  get_address_frequencies () const override
+  {
+    return address_frequencies;
+  }
+  uint64_t get_total_samples () const override { return total_samples; }
+
+protected:
+  /* Lifecycle / I/O.  */
+  bool open_and_map_file ();
+  void cleanup ();
+  bool parse_header ();
+  virtual bool parse_perf_data_section () = 0;
+  void clear_runtime_translation_state ();
+
+  /* Record scan.  Returns false on truncation or a malformed record.  */
+  bool for_each_mapped_perf_data_record (
+    const std::function<void (const perf_event_header &hdr,
+			      const uint8_t *payload, size_t payload_size,
+			      size_t skip_whole)> &fn,
+    perf_scan_log log = perf_scan_log::GENERIC);
+  size_t perf_record_skip_bytes (const perf_event_header &record_header,
+				 const uint8_t *payload,
+				 size_t data_remaining) const;
+  bool parse_mmap_record (const uint8_t *record_data, size_t record_size,
+			  uint16_t misc);
+  bool parse_mmap2_record (const uint8_t *record_data, size_t record_size,
+			   uint16_t misc);
+  void add_target_mmap (uint32_t pid, uint32_t tid,
+			const std::string &mmap_filename, uint64_t start,
+			uint64_t end, uint64_t pgoff);
+  void note_process_lifetime_record (const perf_event_header &header,
+				     const uint8_t *payload,
+				     size_t payload_size);
+  void observe_executable_mmap (uint32_t pid, uint64_t start, uint64_t end,
+				uint64_t pgoff, bool is_target);
+  bool target_mapping_lifetime_valid () const;
+
+  /* Target binary / address filters.  */
+  bool is_target_binary (const std::string &mmap_filename,
+			 const std::string &build_id) const;
+  void report_build_id_mismatch (const std::string &mmap_path,
+				 const std::string &recorded_build_id) const;
+  bool is_valid_user_address (uint64_t addr) const;
+  const std::vector<simple_mmap> *target_mmaps_for_pid (uint32_t pid) const;
+  size_t target_mmap_count () const;
+  void parse_build_id_table () const;
+
+  const uint8_t *mapped_bytes () const { return mapped_file_.data (); }
+  size_t mapped_size () const { return mapped_file_.size (); }
+
+  /* Paths and sample mass.  */
+  std::string perf_data_path;
+  std::string binary_path;
+  uint64_t total_samples;
+  std::unordered_map<uint64_t, uint64_t> address_frequencies;
+  pid_mmap_map target_mmaps_by_pid_;
+  std::unordered_map<uint32_t, uint32_t> target_pid_by_tid_;
+
+  struct mmap_observation
+  {
+    uint64_t start;
+    uint64_t end;
+    uint64_t pgoff;
+    bool is_target;
+  };
+  std::unordered_map<uint32_t, std::vector<mmap_observation>>
+    executable_mmaps_by_pid_;
+  std::unordered_set<uint32_t> target_mapping_pids_;
+  std::unordered_set<uint32_t> unstable_target_pids_;
+
+  /* Build-id cache and HEADER_BUILD_ID table.  */
+  mutable std::string cached_target_build_id_;
+  mutable bool cached_target_build_id_valid_ = false;
+  mutable std::map<std::string, std::string, std::less<>> buildid_table_;
+  mutable bool buildid_table_valid_ = false;
+  mutable bool reported_build_id_mismatch_ = false;
+
+  /* Mapped perf.data and sample attributes.  */
+  afdo_tools::file_mmap mapped_file_;
+  perf_file_header header;
+  attr_sample_layout sample_layout;
+  /* Events the kernel dropped while recording (PERF_RECORD_LOST*).  */
+  uint64_t lost_events_ = 0;
+};
+
+std::unique_ptr<profile_reader>
+create_perf_reader (const std::string &perf_data_path,
+		    const std::string &binary_path, sampling_mode mode);
+
+bool get_elf_segment_vaddr_for_pgoff (const std::string &binary_path,
+				      uint64_t pgoff, uint64_t &out);
+
+bool get_elf_is_pie (const std::string &binary_path);
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_FILE_READER_H.  */
