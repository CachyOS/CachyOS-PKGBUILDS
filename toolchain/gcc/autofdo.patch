+#ifndef GCC_PROFILE_READER_H
+#define GCC_PROFILE_READER_H
+
+#include "perf.h"
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace dwarf_debug {
+class dwarf_reader;
+}
+
+namespace perf_data {
+
+class branch_stack_reader_base;
+
+using function_timestamp_map
+  = std::map<std::pair<std::string, uint64_t>, uint64_t>;
+
+class profile_reader
+{
+  friend class branch_stack_reader_base;
+
+  /* Earliest observed sample time at each sampled PC.  */
+  std::unordered_map<uint64_t, uint64_t> first_sample_time_by_pc_;
+
+  /* Earliest observed sample time for each function after DWARF folding.  */
+  function_timestamp_map function_timestamps_;
+
+protected:
+  bool profile_addresses_are_file_offsets_ = false;
+  std::vector<uint64_t> sorted_touch_pcs_;
+
+  void reset_profile_state ();
+  void note_sample_timestamp (uint64_t runtime_ip, uint64_t time);
+
+  bool
+  record_sample_ip (uint64_t ip, bool ip_is_target, uint64_t sample_time,
+		    bool accumulate_sample_ip,
+		    std::unordered_map<uint64_t, uint64_t> &address_frequencies)
+  {
+    if (sample_time != 0 && ip_is_target)
+      note_sample_timestamp (ip, sample_time);
+    if (!accumulate_sample_ip || !ip_is_target)
+      return false;
+    address_frequencies[ip]++;
+    return true;
+  }
+
+public:
+  virtual ~profile_reader () = default;
+
+  virtual bool load () = 0;
+  virtual const std::unordered_map<uint64_t, uint64_t> &
+  get_address_frequencies () const = 0;
+  virtual uint64_t get_total_samples () const = 0;
+  virtual uint64_t translate_address (uint64_t runtime_addr) const = 0;
+
+  /* Return the branch-stack interface when supported.  */
+  virtual branch_stack_reader_base *as_branch_stack_reader ()
+  {
+    return nullptr;
+  }
+  virtual const branch_stack_reader_base *as_branch_stack_reader () const
+  {
+    return nullptr;
+  }
+
+  /* Configure branch-stack mode, load, and prepare maps for correlate.
+     Returns false on load failure or empty sample mass.  */
+  bool load_and_prepare (bool use_branch_stack);
+
+  /* Address ranges that DWARF load should cover (half-open [beg, end)).  */
+  std::vector<std::pair<uint64_t, uint64_t>> sample_ranges_for_dwarf () const;
+
+  /* Unique sorted touch PCs (built at load finalize).  */
+  const std::vector<uint64_t> &sorted_touch_pcs () const
+  {
+    return sorted_touch_pcs_;
+  }
+
+  /* Finalized branch-stack tables (nullptr when absent or empty).  */
+  const std::vector<profile_range> *range_counts () const;
+  const std::vector<profile_branch> *branch_counts () const;
+
+  /* True when correlate has range mass, branch edges, or per-PC counts.  */
+  bool has_sample_mass () const;
+
+  /* Merge runtime-keyed address frequencies to file offsets; optionally
+     return touch PCs.  */
+  static void finalize_address_frequencies_with_mmaps (
+    std::unordered_map<uint64_t, uint64_t> &address_frequencies,
+    const std::vector<simple_mmap> &target_mmaps,
+    std::vector<uint64_t> *sorted_touch_pcs_out = nullptr);
+
+  /* Retain the earliest sampled time for each function.  */
+  void
+  fold_sample_timestamps_by_function (const dwarf_debug::dwarf_reader &dwarf);
+
+  const function_timestamp_map &function_timestamps () const
+  {
+    return function_timestamps_;
+  }
+};
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PROFILE_READER_H.  */
