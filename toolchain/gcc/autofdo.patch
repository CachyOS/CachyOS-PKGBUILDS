diff --git a/afdo-tools/src/perf_file_reader.cc b/afdo-tools/src/perf_file_reader.cc
new file mode 100644
index 00000000000..f421c82a81d
--- /dev/null
+++ b/afdo-tools/src/perf_file_reader.cc
@@ -0,0 +1,1582 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "perf_file_reader.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+#include <cerrno>
+#include <unordered_map>
+#include <vector>
+
+#include <fcntl.h>
+#include <linux/perf_event.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <elf.h>
+#include <gelf.h>
+#include <libelf.h>
+
+namespace perf_data {
+namespace {
+
+/* Return the final component of PATH.  */
+const char *
+path_basename (const char *path)
+{
+  const char *slash = std::strrchr (path, '/');
+  return slash ? slash + 1 : path;
+}
+
+#ifndef NT_GNU_BUILD_ID
+#define NT_GNU_BUILD_ID 3
+#endif
+
+/* Perf file format constants.  */
+constexpr uint64_t PERF_MAGIC = 0x32454c4946524550ULL; /* "PERFILE2".  */
+constexpr uint64_t PERF_MAGIC_SWAPPED
+  = 0x50455246494c4532ULL; /* Byte-swapped PERFILE2.  */
+/* A pipe-mode stream has only MAGIC and SIZE before its records.  */
+constexpr uint64_t PERF_PIPE_HEADER_SIZE = 2 * sizeof (uint64_t);
+
+/* Lowercase hexadecimal digits for build IDs.  */
+constexpr char HEX_DIGITS[] = "0123456789abcdef";
+
+/* Kernel-space address mask.  */
+constexpr uint64_t KERNEL_ADDRESS_MASK = 0xFFFF000000000000ULL;
+
+/* Misc bits an older kernel header may not define.  */
+#ifndef PERF_RECORD_MISC_PROC_MAP_PARSE_TIMEOUT
+#define PERF_RECORD_MISC_PROC_MAP_PARSE_TIMEOUT (1 << 12)
+#endif
+#ifndef PERF_RECORD_MISC_MMAP_BUILD_ID
+#define PERF_RECORD_MISC_MMAP_BUILD_ID (1 << 14)
+#endif
+/* Perf's own bit, not the kernel's.  The build id size in a HEADER_BUILD_ID
+   record is valid.  */
+constexpr uint16_t PERF_RECORD_MISC_BUILD_ID_SIZE = 1U << 15;
+constexpr unsigned HEADER_COMPRESSED_FEATURE_BIT = 27;
+constexpr uint64_t PERF_FILE_ATTR_IDS_SIZE = 2 * sizeof (uint64_t);
+
+/* Bytes of ATTR that both the file and this reader agree are present.  */
+uint64_t
+effective_attr_size (const uint8_t *attr, uint64_t attr_bytes)
+{
+  uint32_t published;
+  std::memcpy (&published, attr + offsetof (perf_event_attr, size),
+	       sizeof (published));
+  if (published < PERF_ATTR_SIZE_VER0 || published > attr_bytes)
+    return 0;
+  return published;
+}
+
+/* Copy the attribute's EFF_SIZE bytes into a native one.  perf_event_attr
+   only grows by appending, so a shorter attribute leaves the fields it
+   predates zeroed, and a longer one only loses fields this build lacks.  */
+perf_event_attr
+read_perf_event_attr (const uint8_t *attr, uint64_t eff_size)
+{
+  perf_event_attr out = {};
+  std::memcpy (&out, attr, std::min<uint64_t> (eff_size, sizeof (out)));
+  return out;
+}
+
+/* True for the software dummy event perf adds to track mmaps for AUX and
+   system-wide records.  It emits side-band records but never samples.  */
+bool
+attr_is_dummy (const perf_event_attr &attr)
+{
+  return attr.type == PERF_TYPE_SOFTWARE
+	 && attr.config == PERF_COUNT_SW_DUMMY;
+}
+
+attr_sample_layout
+read_attr_sample_layout (const perf_event_attr &attr)
+{
+  attr_sample_layout layout;
+  layout.sample_period = attr.sample_period;
+  layout.read_format = attr.read_format;
+  layout.branch_sample_type = attr.branch_sample_type;
+  layout.sample_regs_user = attr.sample_regs_user;
+  layout.sample_regs_intr = attr.sample_regs_intr;
+  layout.sample_type = attr.sample_type;
+  /* perf record -c N leaves PERF_SAMPLE_PERIOD out, as it is fixed.  */
+  layout.fixed_sample_period = layout.sample_period != 0 && !attr.freq;
+  layout.sample_id_all = attr.sample_id_all != 0;
+  return layout;
+}
+
+/* Fields of the sample_id trailer this file uses.  Each HAVE_ flag says
+   whether the layout carried the field.  */
+struct sample_id_trailer
+{
+  uint32_t pid = 0;
+  uint32_t tid = 0;
+  uint64_t time = 0;
+  uint32_t cpu = 0;
+  bool have_tid = false;
+  bool have_time = false;
+  bool have_cpu = false;
+};
+
+/* Read the sample_id trailer of a side-band record such as MMAP, COMM or
+   SWITCH.  With sample_id_all set, perf appends a trailer holding TID, TIME,
+   ID, STREAM_ID, CPU and IDENTIFIER in that order, each 8 bytes and each
+   present only if SAMPLE_TYPE names it.  Since the trailer ends the record,
+   its total size gives the step back from the end of PAYLOAD to each
+   field.  */
+bool
+read_record_sample_id (const attr_sample_layout &layout,
+		       const uint8_t *payload, size_t payload_size,
+		       sample_id_trailer *out)
+{
+  if (!layout.sample_id_all || payload == nullptr)
+    return false;
+
+  size_t trailer_bytes = 0;
+  size_t tid_off = 0;
+  size_t time_off = 0;
+  size_t cpu_off = 0;
+  const bool have_tid = (layout.sample_type & PERF_SAMPLE_TID) != 0;
+  if (have_tid)
+    {
+      tid_off = trailer_bytes;
+      trailer_bytes += sizeof (uint64_t);
+    }
+  const bool have_time = (layout.sample_type & PERF_SAMPLE_TIME) != 0;
+  if (have_time)
+    {
+      time_off = trailer_bytes;
+      trailer_bytes += sizeof (uint64_t);
+    }
+  if (layout.sample_type & PERF_SAMPLE_ID)
+    trailer_bytes += sizeof (uint64_t);
+  if (layout.sample_type & PERF_SAMPLE_STREAM_ID)
+    trailer_bytes += sizeof (uint64_t);
+  const bool have_cpu = (layout.sample_type & PERF_SAMPLE_CPU) != 0;
+  if (have_cpu)
+    {
+      cpu_off = trailer_bytes;
+      trailer_bytes += sizeof (uint64_t);
+    }
+  if (layout.sample_type & PERF_SAMPLE_IDENTIFIER)
+    trailer_bytes += sizeof (uint64_t);
+
+  if (payload_size < trailer_bytes)
+    return false;
+  const uint8_t *const trailer = payload + payload_size - trailer_bytes;
+  if (have_tid)
+    {
+      std::memcpy (&out->pid, trailer + tid_off, sizeof (out->pid));
+      std::memcpy (&out->tid, trailer + tid_off + sizeof (out->pid),
+		   sizeof (out->tid));
+      out->have_tid = true;
+    }
+  if (have_time)
+    {
+      std::memcpy (&out->time, trailer + time_off, sizeof (out->time));
+      out->have_time = true;
+    }
+  if (have_cpu)
+    {
+      std::memcpy (&out->cpu, trailer + cpu_off, sizeof (out->cpu));
+      out->have_cpu = true;
+    }
+  return true;
+}
+
+/* Returns false, leaving *OUT_TIME alone, when there is no timestamp.  */
+bool
+read_record_sample_id_time (const attr_sample_layout &layout,
+			    const uint8_t *payload, size_t payload_size,
+			    uint64_t *out_time)
+{
+  sample_id_trailer trailer;
+  if (!read_record_sample_id (layout, payload, payload_size, &trailer)
+      || !trailer.have_time)
+    return false;
+  *out_time = trailer.time;
+  return true;
+}
+
+/* True when A and B's samples decode the same way.  The period is not part
+   of this.  A hybrid CPU gives each PMU its own default period.  */
+bool
+sample_layouts_agree (const attr_sample_layout &a, const attr_sample_layout &b)
+{
+  return a.sample_type == b.sample_type && a.read_format == b.read_format
+	 && a.branch_sample_type == b.branch_sample_type
+	 && a.sample_regs_user == b.sample_regs_user
+	 && a.sample_regs_intr == b.sample_regs_intr;
+}
+
+struct segment_info
+{
+  uint64_t p_offset;
+  uint64_t p_filesz;
+  uint64_t p_vaddr;
+  uint32_t p_flags;
+};
+
+/* Largest page size a mapping's pgoff may be rounded down by.  */
+constexpr uint64_t MAX_PAGE_SIZE = 0x10000;
+
+struct elf_segment_cache
+{
+  std::vector<segment_info> segments;
+  bool is_pie = false;
+};
+
+std::unordered_map<std::string, elf_segment_cache> segment_cache;
+
+/* PT_LOAD table from ELF.  Empty on failure.  */
+std::vector<segment_info>
+build_segment_table (Elf *elf)
+{
+  std::vector<segment_info> segments;
+  size_t phnum = 0;
+  if (elf_getphdrnum (elf, &phnum) != 0)
+    return segments;
+  for (size_t i = 0; i < phnum; ++i)
+    {
+      GElf_Phdr phdr;
+      if (gelf_getphdr (elf, static_cast<int> (i), &phdr) != &phdr)
+	continue;
+      if (phdr.p_type != PT_LOAD)
+	continue;
+      segments.push_back ({static_cast<uint64_t> (phdr.p_offset),
+			   static_cast<uint64_t> (phdr.p_filesz),
+			   static_cast<uint64_t> (phdr.p_vaddr),
+			   static_cast<uint32_t> (phdr.p_flags)});
+    }
+  return segments;
+}
+
+/* Link-time address of file offset PGOFF, where an executable mapping
+   starts.  The kernel maps a PT_LOAD from its p_offset rounded down to a
+   page, so a segment that is not page-aligned starts after PGOFF.  */
+bool
+lookup_vaddr (const std::vector<segment_info> &segments, uint64_t pgoff,
+	      uint64_t &out)
+{
+  if (segments.empty ())
+    return false;
+
+  const segment_info *best = nullptr;
+  int best_rank = -1;
+  uint64_t first_nonzero_p_vaddr = 0;
+  bool have_first_nonzero = false;
+
+  for (const auto &s : segments)
+    {
+      if (!have_first_nonzero && s.p_vaddr != 0)
+	{
+	  first_nonzero_p_vaddr = s.p_vaddr;
+	  have_first_nonzero = true;
+	}
+
+      const bool starts_in_page
+	= s.p_offset >= pgoff && s.p_offset - pgoff < MAX_PAGE_SIZE;
+      const bool contains
+	= s.p_offset <= pgoff && pgoff - s.p_offset < s.p_filesz;
+      if (!starts_in_page && !contains)
+	continue;
+      /* The translated address must not wrap.  */
+      if (starts_in_page ? s.p_offset - pgoff > s.p_vaddr
+			 : pgoff - s.p_offset > UINT64_MAX - s.p_vaddr)
+	continue;
+      /* Prefer an executable segment, then one starting in the mapping's
+	 first page, since that is the segment the mapping was made for.  */
+      const int rank = ((s.p_flags & PF_X) != 0 ? 2 : 0)
+		       + (starts_in_page ? 1 : 0);
+      if (rank > best_rank)
+	{
+	  best = &s;
+	  best_rank = rank;
+	}
+    }
+  if (best != nullptr)
+    {
+      out = best->p_vaddr - best->p_offset + pgoff;
+      return true;
+    }
+  /* For a pgoff 0 fallback, use the first nonzero PT_LOAD p_vaddr.  */
+  if (pgoff == 0 && have_first_nonzero)
+    {
+      out = first_nonzero_p_vaddr;
+      return true;
+    }
+  return false;
+}
+
+/* Lowercase hex text for the BUILD_ID_LEN bytes at BUILD_ID.  */
+std::string
+hex_encode_build_id (const uint8_t *build_id, size_t build_id_len)
+{
+  if (build_id == nullptr || build_id_len > SIZE_MAX / 2)
+    return {};
+  std::string encoded (build_id_len * 2, '\0');
+  for (size_t i = 0; i < build_id_len; i++)
+    {
+      encoded[2 * i] = HEX_DIGITS[build_id[i] >> 4];
+      encoded[2 * i + 1] = HEX_DIGITS[build_id[i] & 0x0f];
+    }
+  return encoded;
+}
+
+/* Parse .note.gnu.build-id from SHT_NOTE section payload.  */
+bool
+gnu_build_id_from_note_data (Elf_Data *data, std::string &out)
+{
+  size_t offset = 0;
+  GElf_Nhdr nhdr;
+  size_t name_off, desc_off;
+  while ((offset = gelf_getnote (data, offset, &nhdr, &name_off, &desc_off))
+	 != 0)
+    {
+      if (nhdr.n_type != NT_GNU_BUILD_ID)
+	continue;
+      const char *note_name
+	= static_cast<const char *> (data->d_buf) + name_off;
+      if (nhdr.n_namesz < 4 || memcmp (note_name, "GNU", 4) != 0)
+	continue;
+
+      const uint8_t *build_id
+	= static_cast<const uint8_t *> (data->d_buf) + desc_off;
+      size_t build_id_len = nhdr.n_descsz;
+      out = hex_encode_build_id (build_id, build_id_len);
+      return true;
+    }
+  return false;
+}
+
+/* ELF .note.gnu.build-id as hex.  */
+std::string
+get_buildid_from_binary (const std::string &binary_path)
+{
+  if (elf_version (EV_CURRENT) == EV_NONE)
+    return {};
+
+  int fd = open (binary_path.c_str (), O_RDONLY);
+  if (fd < 0)
+    return {};
+
+  Elf *elf = elf_begin (fd, ELF_C_READ, nullptr);
+  if (!elf)
+    {
+      close (fd);
+      return {};
+    }
+
+  if (elf_kind (elf) != ELF_K_ELF)
+    {
+      elf_end (elf);
+      close (fd);
+      return {};
+    }
+
+  Elf_Scn *scn = nullptr;
+  while ((scn = elf_nextscn (elf, scn)) != nullptr)
+    {
+      GElf_Shdr shdr;
+      if (gelf_getshdr (scn, &shdr) == nullptr)
+	continue;
+      if (shdr.sh_type != SHT_NOTE)
+	continue;
+
+      Elf_Data *data = elf_getdata (scn, nullptr);
+      if (data == nullptr || data->d_size == 0)
+	continue;
+
+      std::string build_id;
+      if (gnu_build_id_from_note_data (data, build_id))
+	{
+	  elf_end (elf);
+	  close (fd);
+	  return build_id;
+	}
+    }
+
+  elf_end (elf);
+  close (fd);
+  return {};
+}
+
+/* PT_LOAD p_vaddr for pgoff.  False if not ELF or no match.  */
+bool
+get_elf_segment_vaddr_for_pgoff (const std::string &binary_path,
+				 uint64_t pgoff, uint64_t &out)
+{
+  if (elf_version (EV_CURRENT) == EV_NONE)
+    return false;
+
+  auto it = segment_cache.find (binary_path);
+  if (it == segment_cache.end ())
+    {
+      int fd = open (binary_path.c_str (), O_RDONLY);
+      if (fd < 0)
+	return false;
+
+      /* libelf reads lazily, so FD must outlive every call up to elf_end.  */
+      Elf *elf = elf_begin (fd, ELF_C_READ, nullptr);
+      if (!elf)
+	{
+	  close (fd);
+	  return false;
+	}
+
+      if (elf_kind (elf) != ELF_K_ELF)
+	{
+	  elf_end (elf);
+	  close (fd);
+	  return false;
+	}
+
+      elf_segment_cache cache;
+      cache.segments = build_segment_table (elf);
+      GElf_Ehdr ehdr;
+      if (gelf_getehdr (elf, &ehdr) == &ehdr)
+	cache.is_pie = (ehdr.e_type == ET_DYN);
+      elf_end (elf);
+      close (fd);
+      it = segment_cache.emplace (binary_path, std::move (cache)).first;
+    }
+
+  return lookup_vaddr (it->second.segments, pgoff, out);
+}
+
+/* True if binary is PIE (ET_DYN).  Requires prior segment cache fill.  */
+bool
+get_elf_is_pie (const std::string &binary_path)
+{
+  auto it = segment_cache.find (binary_path);
+  return it != segment_cache.end () && it->second.is_pie;
+}
+
+} /* anonymous namespace.  */
+
+const attr_sample_layout &
+perf_file_reader::sideband_layout (const uint8_t *payload,
+				   size_t payload_size) const
+{
+  if (sideband_layout_by_id_.empty () || payload_size < sizeof (uint64_t))
+    return sideband_layout_;
+  uint64_t id;
+  std::memcpy (&id, payload + payload_size - sizeof (id), sizeof (id));
+  const auto it = sideband_layout_by_id_.find (id);
+  return it != sideband_layout_by_id_.end () ? it->second : sideband_layout_;
+}
+
+perf_file_reader::~perf_file_reader ()
+{
+  cleanup ();
+}
+
+bool
+perf_file_reader::load ()
+{
+  cleanup ();
+  if (!open_and_map_file ())
+    return false;
+
+  if (!parse_header ())
+    return false;
+
+  const bool parsed = parse_perf_data_section ();
+
+  if (lost_events_ != 0)
+    fprintf (stderr,
+	     _("Warning: the kernel dropped %" PRIu64 " event(s) while "
+	       "recording %s; the profile is incomplete\n"),
+	     lost_events_,
+	     perf_data_path.c_str ());
+
+  /* Throttling stops the event until the rate falls, so whatever ran during
+     it is under-represented.  */
+  if (throttle_events_ != 0)
+    fprintf (stderr,
+	     _("Warning: the kernel throttled sampling %" PRIu64 " time(s) "
+	       "while recording %s; record with a longer period\n"),
+	     throttle_events_,
+	     perf_data_path.c_str ());
+
+  if (proc_map_timeouts_ != 0)
+    fprintf (stderr,
+	     _("Warning: perf stopped reading %" PRIu64 " process mapping "
+	       "set(s) while recording %s; some mappings may be missing\n"),
+	     proc_map_timeouts_,
+	     perf_data_path.c_str ());
+
+  if (!parsed)
+    return false;
+
+  if (target_mmaps_by_pid_.empty ())
+    {
+      const char *base = path_basename (binary_path.c_str ());
+      fprintf (stderr,
+	       _("Error: No memory mappings found for '%s'. perf.data may be "
+		 "from a different binary.  Ensure it was collected while "
+		 "running: %s\n"),
+	       base,
+	       binary_path.c_str ());
+      return false;
+    }
+
+  /* Samples were translated through their own PID's mappings as they were
+     ingested, so the mappings are no longer needed.  */
+  clear_runtime_translation_state ();
+  return true;
+}
+
+bool
+perf_file_reader::open_and_map_file ()
+{
+  if (!mapped_file_.map (perf_data_path))
+    {
+      fprintf (stderr,
+	       _("Failed to mmap perf.data file: %s (errno: %d)\n"),
+	       perf_data_path.c_str (),
+	       errno);
+      return false;
+    }
+  return true;
+}
+
+void
+perf_file_reader::cleanup ()
+{
+  mapped_file_.unmap ();
+  reset_profile_state ();
+  address_frequencies.clear ();
+  clear_runtime_translation_state ();
+  counter_time_conv_ = counter_time_conversion{};
+  reported_build_id_mismatch_ = false;
+  total_profile_mass = 0;
+  lost_events_ = 0;
+  throttle_events_ = 0;
+  proc_map_timeouts_ = 0;
+  header = {};
+  sample_layout = attr_sample_layout ();
+}
+
+/* Parse perf.data file header.  */
+bool
+perf_file_reader::parse_header ()
+{
+  if (mapped_file_.size () < sizeof (header))
+    {
+      fprintf (stderr, _("File too small to contain perf header\n"));
+      return false;
+    }
+
+  std::memcpy (&header, mapped_file_.data (), sizeof (header));
+
+  if (header.magic != PERF_MAGIC)
+    {
+      if (header.magic == PERF_MAGIC_SWAPPED)
+	fprintf (stderr,
+		 _("Error: big-endian perf.data is not supported\n"));
+      else
+	fprintf (stderr,
+		 _("Invalid perf.data magic number: 0x%" PRIx64 "\n"),
+		 header.magic);
+      return false;
+    }
+
+  /* Pipe mode shares the magic but has no section table to read.  */
+  if (header.size == PERF_PIPE_HEADER_SIZE)
+    {
+      fprintf (stderr,
+	       _("Error: pipe-mode perf.data is not supported; record to a "
+		 "file rather than a pipe\n"));
+      return false;
+    }
+
+  const uint8_t *const base = mapped_file_.data ();
+  if ((header.features >> HEADER_COMPRESSED_FEATURE_BIT) & 1ULL)
+    {
+      fprintf (stderr, _("Error: compressed perf.data is not supported\n"));
+      return false;
+    }
+
+  uint64_t sampling_attrs = 0;
+  if (header.attrs_size > 0 && header.attrs_offset > 0)
+    {
+      if (header.attrs_offset >= mapped_file_.size ()
+	  || header.attrs_size > mapped_file_.size () - header.attrs_offset)
+	{
+	  fprintf (stderr,
+		   _("Error: perf.data attribute table is truncated\n"));
+	  return false;
+	}
+
+      if (header.attr_size == 0)
+	{
+	  fprintf (stderr,
+		   _("Error: perf.data declares a zero attribute size\n"));
+	  return false;
+	}
+
+      if (header.attr_size < PERF_ATTR_SIZE_VER0 + PERF_FILE_ATTR_IDS_SIZE
+	  || header.attrs_size % header.attr_size != 0)
+	{
+	  fprintf (stderr,
+		   _("Error: perf.data declares an invalid attribute "
+		     "stride\n"));
+	  return false;
+	}
+
+      /* SAMPLE records carry no attribute id, so every sampling event has to
+	 decode the same way.  A hybrid CPU records one event per PMU.  */
+      const uint8_t *const attrs = base + header.attrs_offset;
+      const uint64_t num_attrs = header.attrs_size / header.attr_size;
+      const uint64_t attr_bytes
+	= header.attr_size - PERF_FILE_ATTR_IDS_SIZE;
+      attr_sample_layout chosen;
+      bool periods_differ = false;
+      bool have_tracking_attr = false;
+      bool all_have_identifier = true;
+      sideband_layout_by_id_.clear ();
+
+      for (uint64_t i = 0; i < num_attrs; ++i)
+	{
+	  const uint8_t *const attr = attrs + i * header.attr_size;
+	  const uint64_t eff_size
+	    = effective_attr_size (attr, attr_bytes);
+	  if (eff_size == 0)
+	    {
+	      fprintf (stderr,
+		       _("Error: perf.data declares an invalid event attribute "
+			 "size\n"));
+	      return false;
+	    }
+	  const perf_event_attr event_attr
+	    = read_perf_event_attr (attr, eff_size);
+	  const attr_sample_layout layout = read_attr_sample_layout (event_attr);
+
+	  if ((layout.sample_type & PERF_SAMPLE_IDENTIFIER) == 0)
+	    all_have_identifier = false;
+	  if (!have_tracking_attr
+	      && (event_attr.mmap || event_attr.mmap2 || event_attr.comm
+		  || event_attr.task))
+	    {
+	      sideband_layout_ = layout;
+	      have_tracking_attr = true;
+	    }
+	  /* perf_file_attr contains the attribute followed by its id
+	     section.  */
+	  uint64_t ids[2];
+	  std::memcpy (ids, attr + attr_bytes, sizeof (ids));
+	  if (ids[0] > mapped_file_.size ()
+	      || ids[1] > mapped_file_.size () - ids[0]
+	      || ids[1] % sizeof (uint64_t) != 0)
+	    {
+	      fprintf (stderr,
+		       _("Error: perf.data attribute ID section is invalid\n"));
+	      return false;
+	    }
+	  for (uint64_t off = 0; off < ids[1]; off += sizeof (uint64_t))
+	    {
+	      uint64_t id;
+	      std::memcpy (&id, base + ids[0] + off, sizeof (id));
+	      sideband_layout_by_id_[id] = layout;
+	    }
+
+	  if (attr_is_dummy (event_attr))
+	    continue;
+	  if (sampling_attrs != 0 && !sample_layouts_agree (layout, chosen))
+	    {
+	      fprintf (stderr,
+		       _("Error: perf.data records sampling events that "
+			 "disagree on sample layout; record one event at a "
+			 "time\n"));
+	      return false;
+	    }
+	  if (sampling_attrs != 0
+	      && (layout.sample_period != chosen.sample_period
+		  || layout.fixed_sample_period != chosen.fixed_sample_period))
+	    periods_differ = true;
+	  ++sampling_attrs;
+	  chosen = layout;
+	}
+
+      sample_layout = chosen;
+      if (!have_tracking_attr)
+	sideband_layout_ = chosen;
+      if (!all_have_identifier)
+	sideband_layout_by_id_.clear ();
+      /* Every sample carries the same mass, so the event with the shorter
+	 period contributes more.  A single event's period cancels out.  */
+      if (periods_differ)
+	fprintf (stderr,
+		 _("Warning: perf.data records sampling events with "
+		   "different periods; the event sampling more often "
+		   "contributes more to the profile\n"));
+    }
+
+  if (sampling_attrs == 0)
+    {
+      fprintf (stderr, _("Error: perf.data has no sampling event\n"));
+      return false;
+    }
+
+  /* A field of unknown size shifts every field after it in the sample.  */
+  const uint64_t unsupported_fields
+    = sample_layout.sample_type & ~SUPPORTED_SAMPLE_FIELDS;
+  if (unsupported_fields != 0)
+    {
+      fprintf (stderr,
+	       _("Error: perf.data samples carry fields this build does not "
+		 "support (sample_type 0x%" PRIx64 ")\n"),
+	       unsupported_fields);
+      return false;
+    }
+
+  if ((sample_layout.sample_type & PERF_SAMPLE_TID) == 0)
+    {
+      fprintf (stderr,
+	       _("Error: perf.data samples must include PERF_SAMPLE_TID\n"));
+      return false;
+    }
+  const uint64_t branch_filters = sample_layout.branch_sample_type;
+  if (use_branch_stack_for_correlation_
+      && (sample_layout.sample_type & PERF_SAMPLE_BRANCH_STACK) != 0
+      && ((branch_filters & PERF_SAMPLE_BRANCH_CALL_STACK) != 0
+	  || ((branch_filters & PERF_SAMPLE_BRANCH_ANY) == 0
+	      && (branch_filters & BRANCH_SAMPLE_PARTIAL_FILTERS) != 0)))
+    {
+      fprintf (stderr,
+	       _("Error: perf.data branch stacks record only some branches "
+		 "(branch_sample_type 0x%" PRIx64 "); record with -b or "
+		 "-j any\n"),
+	       branch_filters);
+      return false;
+    }
+  /* Correlation gives every sample equal mass, which only reflects the
+     workload when the event counts on a fixed period.  */
+  if (use_branch_stack_for_correlation_
+      && (sample_layout.sample_type & PERF_SAMPLE_BRANCH_STACK) != 0
+      && !sample_layout.fixed_sample_period)
+    fprintf (stderr,
+	     _("Warning: perf.data was not recorded with a fixed sampling "
+	       "period; samples are still counted as equal mass\n"));
+
+  return true;
+}
+
+void
+perf_file_reader::clear_runtime_translation_state ()
+{
+  target_mmaps_by_pid_.clear ();
+  target_mmaps_by_pid_.rehash (0);
+  target_pid_by_tid_.clear ();
+  target_pid_by_tid_.rehash (0);
+  executable_mmaps_by_pid_.clear ();
+  executable_mmaps_by_pid_.rehash (0);
+  target_mapping_pids_.clear ();
+  unstable_target_pids_.clear ();
+  thread_pids_.clear ();
+  task_pids_.clear ();
+  process_starts_.clear ();
+  reused_range_pids_.clear ();
+  cpu_schedule_.clear ();
+  mmap_time_windows_closed_ = false;
+  warned_reused_mmap_range_ = false;
+  buildid_table_.clear ();
+  buildid_table_valid_ = false;
+  cached_target_build_id_.clear ();
+  cached_target_build_id_valid_ = false;
+}
+
+/* Invoke FN for every record of the perf.data data section.  LOG selects the
+   diagnostic prefix.  Returns false when the file is truncated or a malformed
+   record ends the scan early, so callers do not accept a prefix of the
+   profile as complete.  Kernel-reported loss is tallied in LOST_EVENTS_.
+
+   Records come in file order, not timestamp order.  Perf drains one ring
+   buffer per CPU in turn.  Sorting them as they stream would need
+   PERF_RECORD_FINISHED_ROUND, which ends one sweep of the buffers, but
+   nothing here sorts.  Every record carries the timestamp it is resolved
+   against.  */
+bool
+perf_file_reader::for_each_mapped_perf_data_record
+  (const std::function<void (const perf_event_header &hdr,
+			     const uint8_t *payload, size_t payload_size,
+			     size_t skip_whole)> &fn,
+   perf_scan_log log)
+{
+  const char *const tag = (log == perf_scan_log::SPE ? "SPE" : "PERF");
+  if (header.data_offset > mapped_file_.size ())
+    {
+      fprintf (stderr,
+	       _("%s: perf.data data section starts past end of file.\n"),
+	       tag);
+      return false;
+    }
+  const size_t data_offset = static_cast<size_t> (header.data_offset);
+  const size_t available = mapped_file_.size () - data_offset;
+
+  bool complete = true;
+  if (header.data_size > available)
+    {
+      fprintf (stderr,
+	       _("%s: perf.data is truncated: header declares %" PRIu64
+		 " data bytes, %zu present.\n"),
+	       tag,
+	       header.data_size,
+	       available);
+      complete = false;
+    }
+
+  const uint8_t *local_ptr = mapped_file_.data () + data_offset;
+  size_t local_rem = header.data_size > available
+		       ? available
+		       : static_cast<size_t> (header.data_size);
+  size_t total_records = 0;
+  uint64_t lost = 0;
+  uint64_t throttles = 0;
+  uint64_t proc_map_timeouts = 0;
+
+  while (local_rem >= sizeof (perf_event_header))
+    {
+      total_records++;
+      perf_event_header record_header;
+      std::memcpy (&record_header, local_ptr, sizeof (perf_event_header));
+      if (record_header.size == 0
+	  || record_header.size < sizeof (perf_event_header)
+	  || record_header.size > local_rem)
+	{
+	  fprintf (stderr,
+		   _("%s: Invalid record size (%u) at record %zu.  "
+		     "Stopping.\n"),
+		   tag,
+		   (unsigned) record_header.size,
+		   total_records);
+	  complete = false;
+	  break;
+	}
+
+      const uint8_t *payload_ptr = local_ptr + sizeof (perf_event_header);
+      const size_t payload_size
+	= record_header.size - sizeof (perf_event_header);
+
+      if (record_header.type == PERF_RECORD_COMPRESSED
+	  || record_header.type == PERF_RECORD_COMPRESSED2)
+	{
+	  fprintf (stderr,
+		   _("%s: compressed perf records are not supported\n"),
+		   tag);
+	  return false;
+	}
+      if ((record_header.type == PERF_RECORD_MMAP
+	   || record_header.type == PERF_RECORD_MMAP2)
+	  && (record_header.misc & PERF_RECORD_MISC_PROC_MAP_PARSE_TIMEOUT))
+	++proc_map_timeouts;
+
+      const size_t skip
+	= perf_record_skip_bytes (record_header, payload_ptr, local_rem);
+      if (skip == 0)
+	{
+	  fprintf (stderr,
+		   _("%s: Invalid record advance at record %zu (type %u). "
+		     "Stopping.\n"),
+		   tag,
+		   total_records,
+		   (unsigned) record_header.type);
+	  complete = false;
+	  break;
+	}
+
+      /* PERF_RECORD_LOST is { u64 id; u64 lost; }; PERF_RECORD_LOST_SAMPLES
+	 is { u64 lost; }.  */
+      uint64_t record_lost = 0;
+      if (record_header.type == PERF_RECORD_LOST
+	  && payload_size >= 2 * sizeof (uint64_t))
+	std::memcpy (&record_lost, payload_ptr + sizeof (uint64_t),
+		     sizeof (record_lost));
+      else if (record_header.type == PERF_RECORD_LOST_SAMPLES
+	       && payload_size >= sizeof (uint64_t))
+	std::memcpy (&record_lost, payload_ptr, sizeof (record_lost));
+      else if (record_header.type == PERF_RECORD_THROTTLE)
+	++throttles;
+      lost += record_lost;
+
+      local_ptr += skip;
+      local_rem -= skip;
+      fn (record_header, payload_ptr, payload_size, skip);
+    }
+
+  /* A well-formed data section ends on a record boundary.  Only report the
+     tail when the scan itself found nothing else to complain about.  */
+  if (complete && local_rem != 0)
+    {
+      fprintf (stderr,
+	       _("%s: %zu trailing byte(s) after the last record.\n"),
+	       tag,
+	       local_rem);
+      complete = false;
+    }
+
+  /* Each pass sees the same records, so keep the largest tally.  */
+  if (lost > lost_events_)
+    lost_events_ = lost;
+  if (throttles > throttle_events_)
+    throttle_events_ = throttles;
+  if (proc_map_timeouts > proc_map_timeouts_)
+    proc_map_timeouts_ = proc_map_timeouts;
+  return complete;
+}
+
+/* Bytes to advance past this record, counting the AUXTRACE inline tail.
+   Returns 0 when the record does not fit in DATA_REMAINING.  */
+size_t
+perf_file_reader::perf_record_skip_bytes
+  (const perf_event_header &record_header, const uint8_t *payload,
+   size_t data_remaining) const
+{
+  if (record_header.size < sizeof (perf_event_header))
+    return 0;
+  if (record_header.size > data_remaining)
+    return 0;
+
+  if (record_header.type != static_cast<uint32_t> (PERF_RECORD_AUXTRACE))
+    return record_header.size;
+
+  const size_t payload_size = record_header.size - sizeof (perf_event_header);
+  if (payload_size < sizeof (uint64_t))
+    return record_header.size;
+
+  uint64_t inline_tail;
+  std::memcpy (&inline_tail, payload, sizeof (inline_tail));
+  const size_t base = record_header.size;
+  if (inline_tail > SIZE_MAX - base)
+    return 0;
+  const size_t total = base + static_cast<size_t> (inline_tail);
+  if (total > data_remaining)
+    return 0;
+  return total;
+}
+
+void
+perf_file_reader::observe_executable_mmap (uint32_t pid, uint64_t start,
+					   uint64_t end, uint64_t pgoff,
+					   bool is_target,
+					   const std::string &mmap_filename,
+					   uint64_t time)
+{
+  std::vector<mmap_observation> &history = executable_mmaps_by_pid_[pid];
+  for (const mmap_observation &old : history)
+    {
+      if (start >= old.end || end <= old.start)
+	continue;
+      if (old.is_target != is_target
+	  || (is_target
+	      && (start != old.start || end != old.end
+		  || pgoff != old.pgoff)))
+	{
+	  /* The later record needs a timestamp of its own to bound the
+	     earlier mapping.  Without one, or with both at the same time,
+	     there is no way to say which was in force for a sample.  */
+	  if (time == 0 || time == old.time)
+	    unstable_target_pids_.insert (pid);
+	  else
+	    reused_range_pids_.insert (pid);
+	}
+      else if (old.filename != mmap_filename && !warned_reused_mmap_range_)
+	{
+	  /* A library can be unloaded and another loaded at the same address.
+	     Only the target binary's samples are translated, so this is a
+	     warning rather than an error.  */
+	  warned_reused_mmap_range_ = true;
+	  fprintf (stderr,
+		   _("PERF: WARNING: address range 0x%" PRIx64 "-0x%" PRIx64
+		     " is mapped from both %s and %s\n"),
+		   start, end, old.filename.c_str (),
+		   mmap_filename.c_str ());
+	}
+    }
+  history.push_back ({mmap_filename, start, end, pgoff, time, is_target});
+}
+
+void
+perf_file_reader::bound_target_mmaps (uint32_t pid,
+				      std::vector<executable_mapping> &mmaps)
+{
+  /* Without timestamps on the MMAP records a mapping made during the
+     recording looks as if it was there from the start, so a fork cannot
+     end it.  */
+  const bool mmap_times
+    = sideband_layout_.sample_id_all
+      && (sideband_layout_.sample_type & PERF_SAMPLE_TIME) != 0;
+  const auto history = executable_mmaps_by_pid_.find (pid);
+  for (executable_mapping &m : mmaps)
+    {
+      if (history != executable_mmaps_by_pid_.end ())
+	for (const mmap_observation &o : history->second)
+	  {
+	    if (o.start >= m.end_addr || o.end <= m.start_addr)
+	      continue;
+	    /* perf can report the same target mapping once per event.  */
+	    if (o.is_target && o.start == m.start_addr && o.end == m.end_addr
+		&& o.pgoff == m.file_offset)
+	      continue;
+	    m.takeovers.push_back ({std::max (o.start, m.start_addr),
+				    std::min (o.end, m.end_addr), o.time});
+	  }
+      for (const process_start &s : process_starts_)
+	if (s.pid == pid && s.time > m.time_begin && (s.is_exec || mmap_times))
+	  m.time_end = std::min (m.time_end, s.time);
+    }
+}
+
+void
+perf_file_reader::close_target_mmap_time_windows ()
+{
+  mmap_time_windows_closed_ = true;
+  for (auto &entry : target_mmaps_by_pid_)
+    bound_target_mmaps (entry.first, entry.second);
+
+  /* A child runs its parent's mappings from the fork on.  Go in time order
+     so that a grandchild gets what its parent inherited.  */
+  std::stable_sort (process_starts_.begin (), process_starts_.end (),
+		    [] (const process_start &a, const process_start &b)
+		    { return a.time < b.time; });
+  for (const process_start &s : process_starts_)
+    {
+      if (s.is_exec)
+	continue;
+      const auto parent = target_mmaps_by_pid_.find (s.parent);
+      if (parent == target_mmaps_by_pid_.end ())
+	continue;
+      std::vector<executable_mapping> inherited;
+      for (const executable_mapping &m : parent->second)
+	if (m.time_begin <= s.time && s.time < m.time_end)
+	  {
+	    executable_mapping copy = m;
+	    /* Parent changes after the fork do not affect the child.  Earlier
+	       takeovers remain in the child's inherited address space.  */
+	    const auto last
+	      = std::remove_if (copy.takeovers.begin (), copy.takeovers.end (),
+				[&] (const executable_mapping::takeover &t)
+				{
+				  return (t.time < m.time_begin
+					  || t.time > s.time);
+				});
+	    copy.takeovers.erase (last, copy.takeovers.end ());
+	    for (executable_mapping::takeover &t : copy.takeovers)
+	      {
+		t.time = s.time;
+		t.inherited = true;
+	      }
+	    copy.time_begin = s.time;
+	    copy.time_end = std::numeric_limits<uint64_t>::max ();
+	    inherited.push_back (copy);
+	  }
+      if (inherited.empty ())
+	continue;
+      bound_target_mmaps (s.pid, inherited);
+      std::vector<executable_mapping> &child = target_mmaps_by_pid_[s.pid];
+      child.insert (child.end (), inherited.begin (), inherited.end ());
+    }
+
+  for (const auto &entry : thread_pids_)
+    if (target_mmaps_by_pid_.count (entry.second) != 0)
+      target_pid_by_tid_.emplace (entry.first, entry.second);
+}
+
+/* COMM and FORK records.  Which process each thread belongs to, and where a
+   process starts a new address space.  */
+void
+perf_file_reader::note_process_lifetime_record
+  (const perf_event_header &record_header, const uint8_t *payload,
+   size_t payload_size)
+{
+  if (payload == nullptr)
+    return;
+  uint32_t pid;
+  uint32_t tid;
+  if (record_header.type == PERF_RECORD_COMM)
+    {
+      if (payload_size < 2 * sizeof (uint32_t))
+	return;
+      std::memcpy (&pid, payload, sizeof (pid));
+      std::memcpy (&tid, payload + sizeof (pid), sizeof (tid));
+      task_pids_.insert (pid);
+      thread_pids_[tid] = pid;
+      if ((record_header.misc & PERF_RECORD_MISC_COMM_EXEC) == 0)
+	return;
+      uint64_t time = 0;
+      read_record_sample_id_time (sideband_layout (payload, payload_size),
+				  payload, payload_size, &time);
+      if (time != 0)
+	process_starts_.push_back ({pid, 0, time, true});
+      /* Without a timestamp the mappings before the exec cannot be told
+	 from those after it.  */
+      else if (target_mapping_pids_.count (pid) != 0)
+	unstable_target_pids_.insert (pid);
+    }
+  else if (record_header.type == PERF_RECORD_FORK)
+    {
+      /* pid, ppid, tid, ptid, then time.  */
+      if (payload_size < 4 * sizeof (uint32_t) + sizeof (uint64_t))
+	return;
+      uint32_t ppid;
+      uint64_t time;
+      std::memcpy (&pid, payload, sizeof (pid));
+      std::memcpy (&ppid, payload + sizeof (pid), sizeof (ppid));
+      std::memcpy (&tid, payload + 2 * sizeof (pid), sizeof (tid));
+      std::memcpy (&time, payload + 4 * sizeof (pid), sizeof (time));
+      task_pids_.insert (pid);
+      thread_pids_[tid] = pid;
+      /* A new thread has ppid equal to pid.  perf writes the processes
+	 already running with time 0, and their own MMAPs describe them.  */
+      if (pid != ppid && time != 0)
+	process_starts_.push_back ({pid, ppid, time, false});
+    }
+}
+
+/* PERF_RECORD_TIME_CONV.  Older perf writes only the first three fields, so
+   the capability bytes may be absent.  */
+void
+perf_file_reader::note_time_conv_record (const uint8_t *payload,
+					 size_t payload_size)
+{
+  if (payload == nullptr || payload_size < 3 * sizeof (uint64_t))
+    return;
+  std::memcpy (&counter_time_conv_.shift, payload, sizeof (uint64_t));
+  std::memcpy (&counter_time_conv_.mult, payload + sizeof (uint64_t),
+	       sizeof (uint64_t));
+  std::memcpy (&counter_time_conv_.zero, payload + 2 * sizeof (uint64_t),
+	       sizeof (uint64_t));
+  counter_time_conv_.valid
+    = counter_time_conv_.mult != 0 && counter_time_conv_.shift < 64;
+  if (payload_size < 5 * sizeof (uint64_t) + 2 * sizeof (uint8_t))
+    return;
+  std::memcpy (&counter_time_conv_.cycles, payload + 3 * sizeof (uint64_t),
+	       sizeof (uint64_t));
+  std::memcpy (&counter_time_conv_.mask, payload + 4 * sizeof (uint64_t),
+	       sizeof (uint64_t));
+  const uint8_t *const caps = payload + 5 * sizeof (uint64_t);
+  /* Without a counter origin the counter cannot be placed on perf's scale.  */
+  counter_time_conv_.valid = counter_time_conv_.valid && caps[0] != 0;
+  counter_time_conv_.short_counter = caps[1] != 0;
+}
+
+/* Put a hardware counter value on the scale the side-band record timestamps
+   use.  This is the same arithmetic perf's own AUX decoders apply.  */
+bool
+perf_file_reader::counter_to_perf_time (uint64_t counter,
+					uint64_t *out_time) const
+{
+  const counter_time_conversion &tc = counter_time_conv_;
+  if (!tc.valid)
+    return false;
+  /* A counter narrower than 64 bits wraps, so fold it back onto the range
+     around the origin.  */
+  if (tc.short_counter)
+    counter = tc.cycles + ((counter - tc.cycles) & tc.mask);
+  const uint64_t quot = counter >> tc.shift;
+  const uint64_t rem = counter & ((UINT64_C (1) << tc.shift) - 1);
+  *out_time = tc.zero + quot * tc.mult + ((rem * tc.mult) >> tc.shift);
+  return true;
+}
+
+/* Track which process holds each CPU over time.  An AUX trace writes into
+   per-CPU buffers, so a record's CPU and timestamp are all there is to say
+   which of the traced processes produced it.  ITRACE_START names the process
+   the trace switches to, and a switch-out leaves the CPU with none.  */
+void
+perf_file_reader::note_cpu_schedule_record
+  (const perf_event_header &record_header, const uint8_t *payload,
+   size_t payload_size)
+{
+  sample_id_trailer trailer;
+  if (!read_record_sample_id (sideband_layout (payload, payload_size),
+			      payload, payload_size, &trailer)
+      || !trailer.have_time || !trailer.have_cpu)
+    return;
+
+  cpu_schedule_entry entry{trailer.time, 0};
+  if (record_header.type == PERF_RECORD_ITRACE_START)
+    {
+      if (payload_size < 2 * sizeof (uint32_t))
+	return;
+      std::memcpy (&entry.pid, payload, sizeof (entry.pid));
+    }
+  else if ((record_header.misc & PERF_RECORD_MISC_SWITCH_OUT) == 0)
+    {
+      /* A switch into a traced thread.  The trailer names it.  */
+      if (!trailer.have_tid)
+	return;
+      entry.pid = trailer.pid;
+    }
+  cpu_schedule_[trailer.cpu].push_back (entry);
+}
+
+/* Order each CPU's entries so that CPU_OWNER_AT can search them.  Records
+   arrive per ring buffer, so they are only roughly ordered by time.  */
+void
+perf_file_reader::sort_cpu_schedule ()
+{
+  for (auto &cpu : cpu_schedule_)
+    std::stable_sort (cpu.second.begin (), cpu.second.end (),
+		      [] (const cpu_schedule_entry &a,
+			  const cpu_schedule_entry &b)
+		      { return a.time < b.time; });
+}
+
+/* The process holding CPU at TIME, taken from the last schedule entry at or
+   before it.  False when nothing traced was running then.  */
+bool
+perf_file_reader::cpu_owner_at (uint32_t cpu, uint64_t time,
+				uint32_t *out_pid) const
+{
+  const auto it = cpu_schedule_.find (cpu);
+  if (it == cpu_schedule_.end ())
+    return false;
+  const std::vector<cpu_schedule_entry> &entries = it->second;
+  const auto after
+    = std::upper_bound (entries.begin (), entries.end (), time,
+			[] (uint64_t t, const cpu_schedule_entry &e)
+			{ return t < e.time; });
+  if (after == entries.begin () || (after - 1)->pid == 0)
+    return false;
+  *out_pid = (after - 1)->pid;
+  return true;
+}
+
+bool
+perf_file_reader::cpu_runs_other_processes (uint32_t cpu) const
+{
+  const auto it = cpu_schedule_.find (cpu);
+  if (it == cpu_schedule_.end ())
+    return false;
+  for (const cpu_schedule_entry &e : it->second)
+    if (e.pid != 0 && target_mmaps_by_pid_.count (e.pid) == 0)
+      return true;
+  return false;
+}
+
+bool
+perf_file_reader::target_mapping_lifetime_valid () const
+{
+  /* The mapping time windows resolve a reused address range, so it only
+     fails the readers that do not apply them.  */
+  if (unstable_target_pids_.empty ()
+      && (reused_range_pids_.empty () || mmap_time_windows_closed_))
+    return true;
+  fprintf (stderr,
+	   _("Error: perf.data changes the executable mapping lifetime for "
+	     "a target process; this is not supported\n"));
+  return false;
+}
+
+/* Record the target binary's half-open START to END range and resolve its
+   link-time address.  Keep each mapping separate.  pgoff alone does not
+   establish that two runtime intervals have the same affine translation.  */
+void
+perf_file_reader::add_target_mmap (uint32_t pid, uint32_t tid,
+				   uint64_t start, uint64_t end,
+				   uint64_t pgoff, uint64_t time)
+{
+  target_mapping_pids_.insert (pid);
+  /* The recorded path may name another build of the binary, or nothing on
+     this host, so translate with the binary whose DWARF is read.  */
+  uint64_t vaddr = 0;
+  const bool have_vaddr
+    = get_elf_segment_vaddr_for_pgoff (binary_path, pgoff, vaddr);
+  const bool is_pie = get_elf_is_pie (binary_path);
+  target_mmaps_by_pid_[pid].emplace_back (
+    start, end, pgoff, vaddr, is_pie, time, have_vaddr);
+  target_pid_by_tid_[tid] = pid;
+}
+
+bool
+perf_file_reader::parse_mmap_record (const uint8_t *record_data,
+				     size_t record_size, uint16_t misc)
+{
+  if (record_size < sizeof (perf_mmap_record))
+    return false; /* Record too small.  */
+
+  perf_mmap_record mmap;
+  std::memcpy (&mmap, record_data, sizeof (mmap));
+
+  /* Filename follows the fixed-size header.  Copy its bounded record
+     bytes.  */
+  const char *filename
+    = reinterpret_cast<const char *> (record_data + sizeof (perf_mmap_record));
+  const size_t filename_max_len = record_size - sizeof (perf_mmap_record);
+  const std::string mmap_filename
+    = perf_mmap_filename_view (filename, filename_max_len);
+
+  if (!is_valid_user_address (mmap.addr))
+    return true;
+
+  uint64_t end = 0;
+  if (!try_compute_mmap_end (mmap.addr, mmap.len, &end))
+    return true;
+  uint64_t time = 0;
+  read_record_sample_id_time (sideband_layout (record_data, record_size),
+			      record_data, record_size, &time);
+
+  /* Data mappings can replace part of an executable mapping.  */
+  const bool is_target = !(misc & PERF_RECORD_MISC_MMAP_DATA)
+			 && is_target_binary (mmap_filename, "");
+  observe_executable_mmap (
+    mmap.pid, mmap.addr, end, mmap.pgoff, is_target, mmap_filename, time);
+  if (!is_target)
+    return true;
+
+  add_target_mmap (mmap.pid, mmap.tid, mmap.addr, end, mmap.pgoff, time);
+  return true;
+}
+
+bool
+perf_file_reader::parse_mmap2_record (const uint8_t *record_data,
+				      size_t record_size, uint16_t misc)
+{
+  if (record_size < sizeof (perf_mmap2_record))
+    return false; /* Record too small.  */
+
+  perf_mmap2_record mmap2;
+  std::memcpy (&mmap2, record_data, sizeof (mmap2));
+
+  const uint8_t *filename_bytes
+    = record_data + sizeof (perf_mmap2_record);
+  const char *filename = reinterpret_cast<const char *> (filename_bytes);
+  const size_t filename_max_len = record_size - sizeof (perf_mmap2_record);
+  const std::string mmap_filename
+    = perf_mmap_filename_view (filename, filename_max_len);
+
+  if (!is_valid_user_address (mmap2.addr))
+    return true;
+
+  uint64_t end = 0;
+  if (!try_compute_mmap_end (mmap2.addr, mmap2.len, &end))
+    return true;
+
+  std::string build_id;
+  if (misc & PERF_RECORD_MISC_MMAP_BUILD_ID)
+    {
+      const size_t build_id_size = std::min<size_t> (
+	mmap2.id.build.build_id_size, sizeof (mmap2.id.build.build_id));
+      build_id = hex_encode_build_id (mmap2.id.build.build_id, build_id_size);
+    }
+  uint64_t time = 0;
+  read_record_sample_id_time (sideband_layout (record_data, record_size),
+			      record_data, record_size, &time);
+
+  const bool is_target = (mmap2.prot & PROT_EXEC) != 0
+			 && is_target_binary (mmap_filename, build_id);
+  observe_executable_mmap (
+    mmap2.pid, mmap2.addr, end, mmap2.pgoff, is_target, mmap_filename, time);
+  if (!is_target)
+    return true;
+
+  add_target_mmap (
+    mmap2.pid, mmap2.tid, mmap2.addr, end, mmap2.pgoff, time);
+  return true;
+}
+
+/* Match a mapping against the profiled binary, by build ID where one is
+   known and by basename otherwise.  */
+bool
+perf_file_reader::is_target_binary (const std::string &mmap_filename,
+				    const std::string &build_id) const
+{
+  if (mmap_filename.empty ())
+    return false;
+  const std::string mmap_path = normalize_mmap_filename (mmap_filename);
+
+  if (!cached_target_build_id_valid_)
+    {
+      cached_target_build_id_ = get_buildid_from_binary (binary_path);
+      cached_target_build_id_valid_ = true;
+    }
+  if (!buildid_table_valid_)
+    parse_build_id_table ();
+
+  const bool basename_matches
+    = strcmp (path_basename (mmap_path.c_str ()),
+	      path_basename (binary_path.c_str ()))
+      == 0;
+
+  /* Prefer the build ID from MMAP2, else the one HEADER_BUILD_ID recorded for
+     this path, which also covers a renamed or relocated binary.  */
+  std::string recorded_build_id = build_id;
+  if (recorded_build_id.empty ())
+    {
+      const auto it = buildid_table_.find (mmap_path);
+      if (it != buildid_table_.end ())
+	recorded_build_id = it->second;
+    }
+
+  /* A recorded build ID decides the match whenever the requested binary has
+     one too.  Falling back to the basename would accept a different build.  */
+  if (!recorded_build_id.empty () && !cached_target_build_id_.empty ())
+    {
+      if (recorded_build_id == cached_target_build_id_)
+	return true;
+      if (basename_matches)
+	report_build_id_mismatch (mmap_path, recorded_build_id);
+      return false;
+    }
+
+  return basename_matches;
+}
+
+/* Report once that perf.data profiled a different build of the binary named
+   by MMAP_PATH, which is otherwise the requested one.  */
+void
+perf_file_reader::report_build_id_mismatch
+  (const std::string &mmap_path, const std::string &recorded_build_id) const
+{
+  if (reported_build_id_mismatch_)
+    return;
+  reported_build_id_mismatch_ = true;
+  fprintf (stderr,
+	   _("Warning: perf.data profiled a different build of %s\n"
+	     "  build ID in perf.data: %s\n"
+	     "  build ID of %s: %s\n"),
+	   mmap_path.c_str (),
+	   recorded_build_id.c_str (),
+	   binary_path.c_str (),
+	   cached_target_build_id_.c_str ());
+}
+
+/* Reject kernel addresses.  */
+bool
+perf_file_reader::is_valid_user_address (uint64_t addr) const
+{
+  return (addr & KERNEL_ADDRESS_MASK) != KERNEL_ADDRESS_MASK;
+}
+
+const std::vector<executable_mapping> *
+perf_file_reader::target_mmaps_for_pid (uint32_t pid) const
+{
+  const auto it = target_mmaps_by_pid_.find (pid);
+  return it == target_mmaps_by_pid_.end () ? nullptr : &it->second;
+}
+
+const std::vector<executable_mapping> *
+perf_file_reader::target_mmaps_for_sample (uint32_t pid, uint32_t tid) const
+{
+  if (const std::vector<executable_mapping> *mmaps = target_mmaps_for_pid (pid))
+    return mmaps;
+  if (task_pids_.count (pid) != 0 || executable_mmaps_by_pid_.count (pid) != 0)
+    return nullptr;
+
+  auto it = target_pid_by_tid_.find (tid);
+  if (it != target_pid_by_tid_.end ())
+    if (const std::vector<executable_mapping> *mmaps
+	  = target_mmaps_for_pid (it->second))
+      return mmaps;
+  return nullptr;
+}
+
+size_t
+perf_file_reader::target_mmap_count () const
+{
+  size_t count = 0;
+  for (const auto &entry : target_mmaps_by_pid_)
+    count += entry.second.size ();
+  return count;
+}
+
+/* Parse HEADER_BUILD_ID into a filename-to-hex-build-id map.  */
+void
+perf_file_reader::parse_build_id_table () const
+{
+  buildid_table_valid_ = true;
+  if (!mapped_file_)
+    return;
+
+  constexpr int BUILD_ID_FEATURE_BIT = 2;
+  const uint64_t feats = header.features;
+  if (!((feats >> BUILD_ID_FEATURE_BIT) & 1ULL))
+    return;
+
+  const uint8_t *const base = mapped_file_.data ();
+  const size_t file_size = mapped_file_.size ();
+  if (header.data_offset > file_size
+      || header.data_size > file_size - header.data_offset)
+    return;
+  const uint64_t sec_table = header.data_offset + header.data_size;
+  /* Section index = number of feature bits set below bit 2.  */
+  int index = 0;
+  for (int b = 0; b < BUILD_ID_FEATURE_BIT; ++b)
+    if ((feats >> b) & 1ULL)
+      ++index;
+  /* Each table entry is {u64 offset; u64 size;}.  */
+  const uint64_t entry_off
+    = sec_table + static_cast<uint64_t> (index) * 16;
+  if (entry_off > file_size || 16 > file_size - entry_off)
+    return;
+  uint64_t bid_off;
+  uint64_t bid_size;
+  std::memcpy (&bid_off, base + entry_off, sizeof (bid_off));
+  std::memcpy (&bid_size, base + entry_off + 8, sizeof (bid_size));
+  if (bid_size == 0 || bid_off > file_size || bid_size > file_size - bid_off)
+    return;
+
+  const uint8_t *p = base + bid_off;
+  const uint8_t *const end = p + bid_size;
+  /* build_id_event consists of hdr(8) + pid(4) + build_id[24] + filename.  */
+  constexpr size_t BUILD_ID_NAME_OFF = sizeof (perf_event_header) + 4 + 24;
+  constexpr size_t BUILD_ID_OFF = sizeof (perf_event_header) + 4;
+  constexpr size_t BUILD_ID_DATA_BYTES = 20;
+  constexpr size_t BUILD_ID_SIZE_OFF = BUILD_ID_OFF + BUILD_ID_DATA_BYTES;
+  while (bytes_available (p, end, sizeof (perf_event_header)))
+    {
+      perf_event_header h;
+      std::memcpy (&h, p, sizeof h);
+      if (h.size < sizeof (perf_event_header)
+	  || !bytes_available (p, end, h.size))
+	break;
+      if (h.size > BUILD_ID_NAME_OFF)
+	{
+	  size_t build_id_len = BUILD_ID_DATA_BYTES;
+	  if (h.misc & PERF_RECORD_MISC_BUILD_ID_SIZE)
+	    {
+	      build_id_len = p[BUILD_ID_SIZE_OFF];
+	      if (build_id_len == 0 || build_id_len > BUILD_ID_DATA_BYTES)
+		{
+		  p += h.size;
+		  continue;
+		}
+	    }
+	  std::string hex
+	    = hex_encode_build_id (p + BUILD_ID_OFF, build_id_len);
+	  const char *fname
+	    = reinterpret_cast<const char *> (p + BUILD_ID_NAME_OFF);
+	  const size_t maxlen = h.size - BUILD_ID_NAME_OFF;
+	  const size_t flen = ::strnlen (fname, maxlen);
+	  if (flen != 0)
+	    buildid_table_.emplace (
+	      normalize_mmap_filename (std::string (fname, flen)),
+	      std::move (hex));
+	}
+      p += h.size;
+    }
+}
+
+} /* namespace perf_data.  */
