+	    const uint64_t count = read_varint (cur, end);
+	    const uint32_t idx = read_varint32 (cur, end);
+	    const uint64_t target_count = read_varint (cur, end);
+	    if (idx >= parse_name_count_)
+	      {
+		v4::set_decode_error ("v4: call target id past symbol count");
+		return;
+	      }
+	    if (lazy_resolve_)
+	      lazy_resolve_ (idx);
+	    auto call = std::make_unique<gcov_location_call> (count);
+	    call->callee_map[idx] = target_count;
+	    loc = std::move (call);
+	    break;
+	  }
+	case v4::LOCATION_CALLED_FNS:
+	  {
+	    const uint64_t count = read_varint (cur, end);
+	    const uint32_t n = read_varint32 (cur, end);
+	    if (!COUNT_FITS_IN_BUFFER (cur, end, n, 2))
+	      {
+		v4::set_decode_error ("v4: call target count past end");
+		return;
+	      }
+	    auto call = std::make_unique<gcov_location_call> (count);
+	    for (uint32_t j = 0; j < n && !v4::decode_failed (); ++j)
+	      {
+		const uint32_t idx = read_varint32 (cur, end);
+		const uint64_t cnt = read_varint (cur, end);
+		if (idx >= parse_name_count_)
+		  {
+		    v4::set_decode_error (
+		      "v4: call target id past symbol count");
+		    return;
+		  }
+		if (lazy_resolve_)
+		  lazy_resolve_ (idx);
+		call->callee_map[idx] = cnt;
+	      }
+	    loc = std::move (call);
+	    break;
+	  }
+	case v4::LOCATION_INLINED_FN:
+	  {
+	    const uint32_t idx = read_varint32 (cur, end);
+	    if (idx >= parse_name_count_)
+	      {
+		v4::set_decode_error ("v4: inline symbol id past symbol count");
+		return;
+	      }
+	    auto inl = std::make_unique<gcov_location_inline> ();
+	    inl->inlined_sym.id = idx;
+	    if (lazy_resolve_)
+	      lazy_resolve_ (idx);
+	    inl->inlined_sym.desc.name_index = idx;
+	    read_locations (cur, end, inl->inlined_sym, depth + 1);
+	    inl->inlined_sym.total_count
+	      = gcov_function_subtree_count (inl->inlined_sym);
+	    loc = std::move (inl);
+	    break;
+	  }
+	default:
+	  {
+	    /* Forward-compat.  Unknown types carry a trailing-size word.  */
+	    const uint32_t trailing = read_varint32 (cur, end);
+	    if (trailing > static_cast<uint64_t> (end - cur))
+	      {
+		v4::set_decode_error ("v4: unknown location trailing past end");
+		return;
+	      }
+	    cur += trailing;
+	    continue;
+	  }
+	}
+      loc->offset = line;
+      loc->discriminator = disc;
+      func.locations.push_back (std::move (loc));
+    }
+}
+
+/* SUMMARY section body, shared by the full and lazy readers.  */
+void
+gcov_reader_v4::parse_summary (const uint8_t *&cur, const uint8_t *end,
+			       gcov_summary &s)
+{
+  s.total_count = read_varint (cur, end);
+  s.max_count = read_varint (cur, end);
+  s.max_function_count = read_varint (cur, end);
+  s.num_counts = read_varint (cur, end);
+  s.num_functions = read_varint (cur, end);
+  s.num_detailed_entries = read_varint (cur, end);
+  if (!COUNT_FITS_IN_BUFFER (cur, end, s.num_detailed_entries, 3))
+    {
+      v4::set_decode_error ("v4: detailed_entries count past end");
+      return;
+    }
+  s.detailed_entries.resize (static_cast<size_t> (s.num_detailed_entries));
+  for (auto &e : s.detailed_entries)
+    {
+      e.cutoff = read_varint32 (cur, end);
+      e.min_count = read_varint (cur, end);
+      e.num_counts = read_varint (cur, end);
+    }
+}
+
+/* FILE_NAMES section body, shared by the full and lazy readers.  */
+void
+gcov_reader_v4::parse_file_entries (const uint8_t *&cur, const uint8_t *end,
+				    std::vector<file_entry> &fes)
+{
+  const uint32_t n = read_varint32 (cur, end);
+  if (!COUNT_FITS_IN_BUFFER (cur, end, n, 5))
+    {
+      v4::set_decode_error ("v4: file group count past end");
+      return;
+    }
+  fes.resize (n);
+  for (auto &fe : fes)
+    {
+      fe.name = read_str (cur, end);
+      fe.string_table_section = read_varint32 (cur, end);
+      fe.symbol_names_section = read_varint32 (cur, end);
+      fe.symbol_id_begin = read_varint32 (cur, end);
+      fe.symbol_id_end = read_varint32 (cur, end);
+    }
+}
+
+/* Parse a v4 binary profile.  With an empty WANT_PATH this is a full read.  All
+   file groups are materialized and functions are emitted in section-index order
+   (the writer's order, so re-emission is byte-identical).  Otherwise it is a
+   partial, per-TU read.  Only the metadata plus the SYMBOL_INFO of the TU whose
+   file name matches WANT_PATH (by basename, or realpath when IS_REALPATH) and,
+   via the reverse inline index, its cross-module inliners.  The per-TU
+   STRING_TABLE / SYMBOL_NAMES groups are then deserialized on demand.
+   set_partial_files () selects an analogous partial read keyed by a list of
+   file names rather than a single path.  */
+bool
+gcov_reader_v4::read_binary (const uint8_t *base, size_t size,
+			     const std::string &want_path, bool is_realpath)
+{
+  const uint8_t *cur = base, *end = base + size;
+  if (size < 16 || std::memcmp (cur, "gcov", 4) != 0)
+    {
+      fprintf (stderr, "Error: invalid v4 magic\n");
+      return false;
+    }
+  cur += 4;
+  magic = v4::format::AFDO_GCOV_MAGIC;
+  version = read_int32 (cur, end);
+  if (version != v4::format::AFDO_GCOV_VERSION)
+    {
+      fprintf (stderr, "Error: unsupported v4 version %u\n",
+	       (unsigned) version);
+      return false;
+    }
+  if (read_int8 (cur, end) != 0)
+    {
+      fprintf (stderr, "Error: nonzero v4 reserved byte\n");
+      return false;
+    }
+  const uint64_t total_sections = read_int56 (cur, end);
+  if (!COUNT_FITS_IN_BUFFER (cur, end, total_sections, 16))
+    {
+      fprintf (stderr, "Error: v4 section directory past end\n");
+      return false;
+    }
+  std::vector<section_directory_entry> section_directory (total_sections);
+  for (uint64_t i = 0; i < total_sections; ++i)
+    {
+      section_directory[i].offset = read_int64 (cur, end);
+      section_directory[i].size = read_int56 (cur, end);
+      section_directory[i].bitmask = read_int8 (cur, end);
+      if (section_directory[i].bitmask & 0x80)
+	v4::set_decode_error ("v4: reserved section type bit is set");
+    }
+  if (v4::decode_failed ())
+    {
+      fprintf (stderr, "Error: %s\n", v4::decode_message ());
+      return false;
+    }
+  const uint64_t section_data_offset = static_cast<uint64_t> (cur - base);
+
+  auto section_bounds = [&] (uint64_t section_index,
+			     const uint8_t *&section_body,
+			     const uint8_t *&section_end) -> bool {
+    if (section_index >= total_sections)
+      return false;
+    const section_directory_entry &section = section_directory[section_index];
+    if (section.offset < section_data_offset || section.offset > size
+	|| section.size == 0
+	|| section.size > size - section.offset)
+      {
+	v4::set_decode_error ("v4: invalid section bounds");
+	return false;
+      }
+    const uint8_t *section_start = base + section.offset;
+    if (*section_start != section.bitmask)
+      {
+	v4::set_decode_error ("v4: section type mismatch");
+	return false;
+      }
+    section_end = section_start + section.size;
+    section_body = section_start + 1;
+    return true;
+  };
+
+  const bool partial = !want_path.empty () || partial_;
+
+  /* Phase A.  The light metadata -- summary, file names, and the inline-index
+     directory.  Per-TU STRING_TABLE / SYMBOL_NAMES are read by load_group.  */
+  gcov_summary summary;
+  std::vector<file_entry> file_entries;
+  std::map<uint32_t, uint32_t> inline_index_sections;
+  unsigned summary_sections = 0;
+  unsigned file_name_sections = 0;
+  unsigned inline_table_sections = 0;
+  for (uint64_t i = 0; i < total_sections; ++i)
+    {
+      const uint8_t *body, *section_end;
+      if (!section_bounds (i, body, section_end))
+	continue;
+      const uint8_t section_type = section_directory[i].bitmask;
+      if (section_type == v4::SECTION_SUMMARY_INFO)
+	{
+	  if (++summary_sections > 1)
+	    v4::set_decode_error ("v4: duplicate summary section");
+	  else
+	    parse_summary (body, section_end, summary);
+	}
+      else if (section_type == v4::SECTION_FILE_NAMES)
+	{
+	  if (++file_name_sections > 1)
+	    v4::set_decode_error ("v4: duplicate file names section");
+	  else
+	    parse_file_entries (body, section_end, file_entries);
+	}
+      else if (section_type == v4::SECTION_INLINE_INDEX_TABLE)
+	{
+	  if (++inline_table_sections > 1)
+	    v4::set_decode_error ("v4: duplicate inline index table");
+	  else
+	    {
+	      const uint32_t n = read_varint32 (body, section_end);
+	      if (!COUNT_FITS_IN_BUFFER (body, section_end, n, 2))
+		{
+		  v4::set_decode_error ("v4: inline index count past end");
+		  break;
+		}
+	      for (uint32_t k = 0; k < n; ++k)
+		{
+		  const uint32_t file_id = read_varint32 (body, section_end);
+		  const uint32_t section_index
+		    = read_varint32 (body, section_end);
+		  const auto inserted
+		    = inline_index_sections.emplace (file_id, section_index);
+		  if (!inserted.second)
+		    {
+		      v4::set_decode_error ("v4: duplicate inline index group");
+		      break;
+		    }
+		}
+	    }
+	}
+    }
+
+  if (summary_sections != 1 || file_name_sections != 1
+      || inline_table_sections != 1)
+    v4::set_decode_error ("v4: missing required section");
+
+  for (const auto &entry : inline_index_sections)
+    {
+      const uint8_t *body, *section_end;
+      if (entry.first >= file_entries.size ()
+	  || !section_bounds (entry.second, body, section_end)
+	  || section_directory[entry.second].bitmask
+	       != v4::SECTION_INLINE_INDICES)
+	{
+	  v4::set_decode_error ("v4: invalid inline index section");
+	  break;
+	}
+    }
+
+  if (v4::decode_failed ())
+    {
+      fprintf (stderr, "Error: %s\n", v4::decode_message ());
+      return false;
+    }
+
+  if (partial && file_entries.empty ())
+    {
+      fprintf (stderr, "Error: v4 partial read: no file names\n");
+      return false;
+    }
+
+  uint32_t total_symbols = 0;
+  for (const auto &fe : file_entries)
+    {
+      if (fe.symbol_id_begin != total_symbols
+	  || fe.symbol_id_end < fe.symbol_id_begin)
+	{
+	  v4::set_decode_error ("v4: invalid symbol id range");
+	  break;
+	}
+      const uint8_t *strings, *strings_end;
+      if (!section_bounds (fe.string_table_section, strings, strings_end)
+	  || section_directory[fe.string_table_section].bitmask
+	       != v4::SECTION_STRING_TABLE)
+	{
+	  v4::set_decode_error ("v4: invalid string table section");
+	  break;
+	}
+      const uint32_t num_strings = read_varint32 (strings, strings_end);
+      if (!COUNT_FITS_IN_BUFFER (strings, strings_end, num_strings, 5))
+	{
+	  v4::set_decode_error ("v4: string count past end");
+	  break;
+	}
+      const uint8_t *body, *section_end;
+      if (!section_bounds (fe.symbol_names_section, body, section_end)
+	  || section_directory[fe.symbol_names_section].bitmask
+	       != v4::SECTION_SYMBOL_NAMES)
+	{
+	  v4::set_decode_error ("v4: invalid symbol names section");
+	  break;
+	}
+      const uint32_t n = read_varint32 (body, section_end);
+      if (n != fe.symbol_id_end - fe.symbol_id_begin
+	  || !COUNT_FITS_IN_BUFFER (body, section_end, n, 3))
+	{
+	  v4::set_decode_error ("v4: invalid symbol count");
+	  break;
+	}
+      total_symbols = fe.symbol_id_end;
+    }
+  if (v4::decode_failed ())
+    {
+      fprintf (stderr, "Error: %s\n", v4::decode_message ());
+      return false;
+    }
+  std::vector<std::string> function_names (total_symbols);
+  parse_name_count_ = total_symbols;
+  std::vector<uint32_t> file_name_map (total_symbols, INVALID_INDEX);
+  std::vector<std::string> file_names;
+  if (!file_entries.empty ())
+    {
+      file_names.resize (file_entries.size () - 1);
+      for (size_t g = 1; g < file_entries.size (); ++g)
+	file_names[g - 1] = file_entries[g].name;
+    }
+  std::vector<uint32_t> info_section (total_symbols, INVALID_INDEX);
+
+  std::vector<uint32_t> id_to_group (total_symbols, INVALID_INDEX);
+  for (uint32_t g = 0; g < file_entries.size (); ++g)
+    for (uint32_t id = file_entries[g].symbol_id_begin;
+	 id < file_entries[g].symbol_id_end;
+	 ++id)
+      if (id < total_symbols)
+	id_to_group[id] = g;
+
+  std::vector<bool> group_loaded (file_entries.size (), false);
+  auto load_group = [&] (uint32_t g)
+    {
+      if (g >= file_entries.size () || group_loaded[g])
+	return;
+      group_loaded[g] = true;
+      const file_entry &fe = file_entries[g];
+      std::vector<std::string> strings;
+      const uint8_t *body, *section_end;
+      if (section_bounds (fe.string_table_section, body, section_end))
+	{
+	  const uint32_t num_strings = read_varint32 (body, section_end);
+	  if (!COUNT_FITS_IN_BUFFER (body, section_end, num_strings, 5))
+	    {
+	      v4::set_decode_error ("v4: string count past end");
+	      return;
+	    }
+	  strings.resize (num_strings);
+	  deserialize_trie (body, section_end, strings);
+	  if (v4::decode_failed ())
+	    return;
+	}
+      if (section_bounds (fe.symbol_names_section, body, section_end))
+	{
+	  const uint32_t n = read_varint32 (body, section_end);
+	  if (!COUNT_FITS_IN_BUFFER (body, section_end, n, 3))
+	    {
+	      v4::set_decode_error ("v4: symbol count past end");
+	      return;
+	    }
+	  std::vector<bool> seen (n, false);
+	  for (uint32_t k = 0; k < n; ++k)
+	    {
+	      const uint32_t nsi = read_varint32 (body, section_end);
+	      const uint32_t sid = read_varint32 (body, section_end);
+	      const uint32_t isec = read_varint32 (body, section_end);
+	      if (sid < fe.symbol_id_begin || sid >= fe.symbol_id_end
+		  || seen[sid - fe.symbol_id_begin])
+		{
+		  v4::set_decode_error ("v4: invalid symbol id");
+		  return;
+		}
+	      seen[sid - fe.symbol_id_begin] = true;
+	      if (nsi >= strings.size ())
+		{
+		  v4::set_decode_error ("v4: invalid symbol name index");
+		  return;
+		}
+	      if (isec != INVALID_INDEX)
+		{
+		  const uint8_t *info_body, *info_end;
+		  if (!section_bounds (isec, info_body, info_end)
+		      || section_directory[isec].bitmask
+			   != v4::SECTION_SYMBOL_INFO)
+		    {
+		      v4::set_decode_error ("v4: invalid symbol info section");
+		      return;
+		    }
+		}
+	      function_names[sid] = strings[nsi];
+	      file_name_map[sid] = (g == 0) ? INVALID_INDEX : (g - 1);
+	      info_section[sid] = isec;
+	    }
+	}
+    };
+
+  lazy_resolve_ = [&] (uint32_t id)
+    {
+      const uint32_t g
+	= id < id_to_group.size () ? id_to_group[id] : INVALID_INDEX;
+      if (g != INVALID_INDEX)
+	load_group (g);
+    };
+
+  /* Select which functions to parse.  */
+  std::vector<uint32_t> wanted_ids;
+  if (!partial)
+    {
+      /* Materialize every group and take every top-level symbol.  */
+      for (uint32_t g = 0; g < file_entries.size (); ++g)
+	load_group (g);
+      for (uint32_t id = 0; id < total_symbols; ++id)
+	if (info_section[id] != INVALID_INDEX)
+	  wanted_ids.push_back (id);
+    }
+  else
+    {
+      /* Select groups matching WANT_PATH or those named by
+	 set_partial_files ().  */
+      auto basename = [] (const std::string &path) -> std::string
+	{
+	  size_t pos = path.find_last_of ('/');
+	  return pos == std::string::npos ? path : path.substr (pos + 1);
+	};
+      const std::string want
+	= is_realpath ? want_path : basename (want_path);
+      std::set<std::string> wanted_files;
+      for (const std::string &file : partial_files_)
+	wanted_files.insert (partial_files_realpath_ ? file : basename (file));
+      auto group_wanted = [&] (const std::string &fn) -> bool
+	{
+	  if (!want_path.empty ())
+	    return (is_realpath ? fn : basename (fn)) == want;
+	  return wanted_files.count (partial_files_realpath_
+				       ? fn : basename (fn)) != 0;
+	};
+      /* A function without a source file can still match by name.  */
+      for (uint32_t g = 0; g < file_entries.size (); ++g)
+	{
+	  if (g != 0 && !group_wanted (file_entries[g].name))
+	    continue;
+	  load_group (g);
+	  for (uint32_t id = file_entries[g].symbol_id_begin;
+	       id < file_entries[g].symbol_id_end;
+	       ++id)
+	    if (id < total_symbols && info_section[id] != INVALID_INDEX)
+	      wanted_ids.push_back (id);
+	  /* Pull this file's cross-module inliners via its INLINE_INDICES
+	     sub-section, read on demand.  */
+	  auto inline_index_it = inline_index_sections.find (g);
+	  const uint8_t *inline_body, *inline_end;
+	  if (inline_index_it != inline_index_sections.end ()
+	      && section_bounds (inline_index_it->second, inline_body,
+				 inline_end))
+	    {
+	      const uint32_t cnt
+		= read_varint32 (inline_body, inline_end);
+	      if (!COUNT_FITS_IN_BUFFER (inline_body, inline_end, cnt, 1))
+		{
+		  v4::set_decode_error ("v4: inline index count past end");
+		  break;
+		}
+	      for (uint32_t k = 0; k < cnt && !v4::decode_failed (); ++k)
+		{
+		  const uint32_t inl
+		    = read_varint32 (inline_body, inline_end);
+		  if (inl >= total_symbols)
+		    {
+		      v4::set_decode_error ("v4: invalid inline index symbol");
+		      break;
+		    }
+		  lazy_resolve_ (inl);
+		  if (info_section[inl] == INVALID_INDEX)
+		    {
+		      v4::set_decode_error ("v4: invalid inline index symbol");
+		      break;
+		    }
+		  wanted_ids.push_back (inl);
+		}
+	    }
+	}
+    }
+
+  /* Emit in the writer's section-index order for full and partial reads, so
+     re-emission is byte-identical and both paths behave identically.  Each
+     symbol owns a distinct SYMBOL_INFO section, so this is a total order.
+     Dedup first, as a partial read can reach an inliner twice.  */
+  std::sort (wanted_ids.begin (), wanted_ids.end ());
+  wanted_ids.erase (std::unique (wanted_ids.begin (), wanted_ids.end ()),
+		    wanted_ids.end ());
+  std::sort (wanted_ids.begin (), wanted_ids.end (),
+	     [&] (uint32_t a, uint32_t b)
+	     {
+	       return info_section[a] < info_section[b];
+	     });
+
+  std::vector<gcov_function> functions;
+  functions.reserve (wanted_ids.size ());
+  for (uint32_t id : wanted_ids)
+    {
+      const uint8_t *body, *section_end;
+      if (!section_bounds (info_section[id], body, section_end))
+	continue;
+      lazy_resolve_ (id);
+      gcov_function func;
+      func.id = id;
+      func.desc.name_index = id;
+      const uint32_t fidx = (id < file_name_map.size ())
+			      ? file_name_map[id]
+			      : INVALID_INDEX;
+      func.desc.file_index
+	= (fidx < file_names.size ()) ? fidx : INVALID_INDEX;
+      func.head_count = read_varint (body, section_end);
+      func.timestamp = read_varint (body, section_end);
+      read_locations (body, section_end, func);
+      func.total_count = gcov_function_subtree_count (func);
+      functions.push_back (std::move (func));
+    }
+  lazy_resolve_ = nullptr;
+  parse_name_count_ = 0;
+  profile.set_summary (std::move (summary));
+  profile.set_names (std::move (file_names), std::move (function_names),
+		     std::move (file_name_map));
+  profile.set_functions (std::move (functions));
+
+  if (v4::decode_failed ())
+    {
+      fprintf (stderr, "Error: %s\n", v4::decode_message ());
+      return false;
+    }
+  return true;
+}
+
+bool
+gcov_reader_v4::read_files (std::vector<std::string> files, bool is_realpath)
+{
+  if (is_text_)
+    return false;
+  set_partial_files (std::move (files));
+  partial_files_realpath_ = is_realpath;
+  const bool result = read ();
+  partial_ = false;
+  partial_files_.clear ();
+  partial_files_realpath_ = true;
+  return result;
+}
+
+bool
+gcov_reader_v4::read (std::string path_, bool is_realpath)
+{
+  afdo_tools::file_mmap fb;
+  if (!fb.map (path))
+    {
+      fprintf (stderr, "Error: cannot mmap %s\n", path.c_str ());
+      return false;
+    }
+  v4::clear_decode_error ();
+  return read_binary (fb.data (), fb.size (), path_, is_realpath);
+}
+
+bool
+gcov_reader_v4::read ()
+{
+  afdo_tools::file_mmap fb;
+  if (!fb.map (path))
+    {
+      fprintf (stderr, "Error: cannot mmap %s\n", path.c_str ());
+      return false;
+    }
+  const uint8_t *base = fb.data ();
+  const size_t size = fb.size ();
+
+  /* The format was already established by detect_format () / make_gcov_reader,
+     which sets is_text_ for a textual profile.  No need to check it again.  */
+  v4::clear_decode_error ();
+  if (is_text_)
+    return read_text (base, size);
+  return read_binary (base, size);
+}
+
+namespace {
+
+/* Minimal recursive-descent parser for the v4 textual format.  Symbols are
+   keyed by their name-pool index (the id in the header), so the parser fills
+   id -> name / id -> file maps and builds the gcov_function location trees.
+   The reader assembles the gcov_profile from those.  */
+struct text_parser
+{
+  const char *cur;
+  const char *end;
+  std::map<uint32_t, std::string> id_name;
+  std::map<uint32_t, int64_t> id_file; /* -1 => unknown.  */
+  std::set<uint32_t> top_level_ids;
+
+  text_parser (const char *b, const char *e)
+    : cur (b), end (e)
+  {
+  }
+
+  /* Every consuming method early-returns a default once !ok ().  */
+  void fail (const char *what)
+  {
+    v4::set_decode_error (what);
+  }
+  bool ok () const { return !v4::decode_failed (); }
+  void register_name (uint32_t id, const std::string &name)
+  {
+    const auto inserted = id_name.emplace (id, name);
+    if (!inserted.second && inserted.first->second != name)
+      fail ("v4 text: conflicting symbol name");
+  }
+  void register_file (uint32_t id, int64_t file)
+  {
+    const auto inserted = id_file.emplace (id, file);
+    if (!inserted.second && inserted.first->second != file)
+      fail ("v4 text: conflicting symbol file");
+  }
+  void skip_ws ()
+  {
+    while (cur < end
+	   && (*cur == ' ' || *cur == '\n' || *cur == '\t' || *cur == '\r'))
+      ++cur;
+  }
+  bool peek (char c)
+  {
+    skip_ws ();
+    return cur < end && *cur == c;
+  }
+  void expect (char c)
+  {
+    if (!ok ())
+      return;
+    skip_ws ();
+    if (cur >= end || *cur != c)
+      {
+	fail ("v4 text: unexpected character");
+	return;
+      }
+    ++cur;
+  }
+  void expect_word (const char *w)
+  {
+    if (!ok ())
+      return;
+    skip_ws ();
+    const size_t n = strlen (w);
+    /* The buffer is not NUL-terminated at the keyword, so compare a bounded
+       span with strncmp rather than strcmp.  */
+    if (!COUNT_FITS_IN_BUFFER (cur, end, n, 1) || strncmp (cur, w, n) != 0)
+      {
+	fail ("v4 text: expected keyword");
+	return;
+      }
+    cur += n;
+  }
+  bool next_word_is (const char *w)
+  {
+    skip_ws ();
+    const size_t n = strlen (w);
+    if (!COUNT_FITS_IN_BUFFER (cur, end, n, 1) || strncmp (cur, w, n) != 0)
+      return false;
+    const char *next = cur + n;
+    return next == end
+	   || !((*next >= 'a' && *next <= 'z')
+		|| (*next >= '0' && *next <= '9') || *next == '_');
+  }
+  uint64_t parse_uint ()
+  {
+    if (!ok ())
+      return 0;
+    skip_ws ();
+    if (cur >= end || *cur < '0' || *cur > '9')
+      {
+	fail ("v4 text: expected number");
+	return 0;
+      }
+    uint64_t value = 0;
+    while (cur < end && *cur >= '0' && *cur <= '9')
+	{
+	  const uint64_t digit = static_cast<uint64_t> (*cur - '0');
+	  if (value > (UINT64_MAX - digit) / 10)
+	    {
+	      fail ("v4 text: number out of range");
+	      return 0;
+	    }
+	  value = value * 10 + digit;
+	  ++cur;
+	}
+    return value;
+  }
+  uint32_t parse_uint32 ()
+  {
+    const uint64_t value = parse_uint ();
+    if (value > UINT32_MAX)
+      {
+	fail ("v4 text: number does not fit in 32 bits");
+	return 0;
+	}
+    return static_cast<uint32_t> (value);
+  }
+  int64_t parse_file_id ()
+  {
+    if (!ok ())
+      return 0;
+    skip_ws ();
+    const bool negative = cur < end && *cur == '-';
+    if (negative)
+      ++cur;
+    const uint64_t value = parse_uint ();
+    if (!ok ())
+      return 0;
+    if (negative)
+      {
+	if (value != 1)
+	  {
+	    fail ("v4 text: invalid file id");
+	    return 0;
+	  }
+	return -1;
+      }
+    if (value > INT64_MAX)
+      {
+	fail ("v4 text: file id out of range");
+	return 0;
+      }
+    return static_cast<int64_t> (value);
+  }
+  static int hex_value (char c)
+  {
+    if (c >= '0' && c <= '9')
+      return c - '0';
+    if (c >= 'a' && c <= 'f')
+      return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F')
+      return c - 'A' + 10;
+    return -1;
+  }
+  std::string parse_quoted ()
+  {
+    expect ('"');
+    if (!ok ())
+      return std::string ();
+    std::string result;
+    while (cur < end)
+      {
+	const char c = *cur++;
+	if (c == '"')
+	  return result;
+	if (c != '\\')
+	  {
+	    result += c;
+	    continue;
+	  }
+	if (cur >= end)
+	  break;
+	const char escape = *cur++;
+	switch (escape)
+	  {
+	  case '\\':
+	  case '"':
+	    result += escape;
+	    break;
+	  case 'n':
+	    result += '\n';
+	    break;
+	  case 'r':
+	    result += '\r';
+	    break;
+	  case 't':
+	    result += '\t';
+	    break;
+	  case 'x':
+	    {
+	      if (end - cur < 2)
+		{
+		  fail ("v4 text: invalid hex escape");
+		  return std::string ();
+		}
+	      const int high = hex_value (cur[0]);
+	      const int low = hex_value (cur[1]);
+	      if (high < 0 || low < 0)
+		{
+		  fail ("v4 text: invalid hex escape");
+		  return std::string ();
+		}
+	      result += static_cast<char> ((high << 4) | low);
+	      cur += 2;
+	      break;
+	    }
+	  default:
+	    fail ("v4 text: invalid escape");
+	    return std::string ();
+	  }
+      }
+    fail ("v4 text: unterminated string");
+    return std::string ();
+  }
+  std::string parse_word ()
+  {
+    if (!ok ())
+      return std::string ();
+    skip_ws ();
+    const char *s = cur;
+    if (cur >= end || *cur < 'a' || *cur > 'z')
+	{
+	  fail ("v4 text: expected section name");
+	  return std::string ();
+	}
+    ++cur;
+    while (cur < end
+	   && ((*cur >= 'a' && *cur <= 'z')
+	       || (*cur >= '0' && *cur <= '9') || *cur == '_'))
+      ++cur;
+    return std::string (s, cur);
+  }
+  /* Skip from just after a section's opening brace through its matching
+     closing brace.  Braces in quoted strings do not affect nesting.  */
+  void skip_braced_contents ()
+  {
+    unsigned depth = 1;
+    bool quoted = false;
+    while (cur < end && depth != 0)
+	{
+	  const char c = *cur++;
+	  if (quoted)
+	    {
+	      if (c == '\\' && cur < end)
+		++cur;
+	      else if (c == '"')
+		quoted = false;
+	      continue;
+	    }
+	  if (c == '"')
+	    quoted = true;
+	  else if (c == '{')
+	    ++depth;
+	  else if (c == '}')
+	    --depth;
+	}
+    if (depth != 0)
+      fail ("v4 text: unterminated section");
+  }
+  void skip_named_section ()
+  {
+    parse_word ();
+    expect ('=');
+    expect ('{');
+    if (ok ())
+      skip_braced_contents ();
+  }
+  /* LOCATION = number (. number)?  */
+  void parse_loc (uint32_t *line, uint32_t *disc)
+  {
+    *line = parse_uint32 ();
+    *disc = 0;
+    if (ok () && cur < end && *cur == '.')
+      {
+	++cur;
+	*disc = parse_uint32 ();
+      }
+  }
+
+  /* Parse the section list of a function body at inline nesting DEPTH into
+     FUNC.LOCATIONS.  */
+  void parse_sections (gcov_function &func, unsigned depth)
+  {
+    if (depth >= MAX_INLINE_DEPTH)
+      {
+	fail ("v4 text: inline callsites nested too deeply");
+	return;
+      }
+    expect ('{');
+    while (!peek ('}') && ok ())
+      {
+	const std::string sect = parse_word ();
+	expect ('=');
+	expect ('{');
+	if (sect == "locations")
+	  {
+	    while (!peek ('}') && ok ())
+	      {
+		uint32_t line, disc;
+		parse_loc (&line, &disc);
+		expect ('=');
+		const uint64_t cnt = parse_uint ();
+		auto loc = std::make_unique<gcov_location_normal> (cnt);
+		loc->offset = line;
+		loc->discriminator = disc;
+		func.locations.push_back (std::move (loc));
+		if (peek (','))
+		  expect (',');
+	      }
+	    expect ('}');
+	  }
+	else if (sect == "callsites")
+	  {
+	    while (!peek ('}') && ok ())
+	      {
+		uint32_t line, disc;
+		parse_loc (&line, &disc);
+		expect ('=');
+		const uint64_t count = parse_uint ();
+		expect ('-');
+		expect ('>');
+		expect ('{');
+		auto call = std::make_unique<gcov_location_call> (count);
+		while (!peek ('}') && ok ())
+		  {
+		    /* "name":id = count.  Register the callee name so the pool
+		       covers ICP-only ids (else the name is lost and the id can
+		       exceed the name pool).  */
+		    const std::string tname = parse_quoted ();
+		    expect (':');
+		    const uint32_t id = parse_uint32 ();
+		    expect ('=');
+		    const uint64_t c = parse_uint ();
+		    register_name (id, tname);
+		    call->callee_map[id] = c;
+		    if (peek (','))
+		      expect (',');
+		  }
+		expect ('}');
+		call->offset = line;
+		call->discriminator = disc;
+		func.locations.push_back (std::move (call));
+		if (peek (','))
+		  expect (',');
+	      }
+	    expect ('}');
+	  }
+	else if (sect == "inlined")
+	  {
+	    while (!peek ('}') && ok ())
+	      {
+		uint32_t line, disc;
+		parse_loc (&line, &disc);
+		expect ('=');
+		auto inl = std::make_unique<gcov_location_inline> ();
+		parse_inlined_header (inl->inlined_sym);
+		parse_sections (inl->inlined_sym, depth + 1);
+		inl->inlined_sym.total_count
+		  = gcov_function_subtree_count (inl->inlined_sym);
+		inl->offset = line;
+		inl->discriminator = disc;
+		func.locations.push_back (std::move (inl));
+		if (peek (','))
+		  expect (',');
+	      }
+	    expect ('}');
+	  }
+	else
+	  {
+	    /* Forward-compat.  */
+	    skip_braced_contents ();
+	  }
+	if (peek (','))
+	  expect (',');
+      }
+    expect ('}');
+  }
+
+  /* "name":file_id(id:total) for an inlined callee.  */
+  void parse_inlined_header (gcov_function &func)
+  {
+    const std::string name = parse_quoted ();
+    expect (':');
+    const int64_t file_id = parse_file_id ();
+    expect ('(');
+    const uint32_t id = parse_uint32 ();
+    expect (':');
+    parse_uint (); /* total (recomputed)  */
+    expect (')');
+    func.id = id;
+    register_name (id, name);
+    register_file (id, file_id);
+    expect ('=');
+  }
+
+  /* "name":file_id(id:total:head:ts) = { ... } for a top-level function.  */
+  bool parse_symbol (gcov_function &func)
+  {
+    skip_ws ();
+    if (cur >= end || *cur != '"')
+      return false;
+    const std::string name = parse_quoted ();
+    expect (':');
+    const int64_t file_id = parse_file_id ();
+    expect ('(');
+    const uint32_t id = parse_uint32 ();
+    expect (':');
+    parse_uint (); /* total (recomputed)  */
+    expect (':');
+    const uint64_t head = parse_uint ();
+    expect (':');
+    const uint64_t ts = parse_uint ();
+    expect (')');
+    expect ('=');
+    if (!top_level_ids.insert (id).second)
+      {
+	fail ("v4 text: duplicate top-level symbol id");
+	return false;
+      }
+    func.id = id;
+    func.head_count = head;
+    func.timestamp = ts;
+    register_name (id, name);
+    register_file (id, file_id);
+    parse_sections (func, 0);
+    return true;
+  }
+};
+
+} /* anonymous namespace.  */
+
+bool
+gcov_reader_v4::read_text (const uint8_t *base, size_t size)
+{
+  text_parser p (reinterpret_cast<const char *> (base),
+		 reinterpret_cast<const char *> (base) + size);
+
+  /* filenames = { "a", "b", ... }  */
+  p.expect_word ("filenames");
+  p.expect ('=');
+  p.expect ('{');
+  std::vector<std::string> file_names;
+  while (!p.peek ('}') && p.ok ())
+    {
+      file_names.push_back (p.parse_quoted ());
+      if (p.peek (','))
+	p.expect (',');
+    }
+  p.expect ('}');
+
+  auto read_section = [&] ()
+    {
+      if (!p.next_word_is ("symbol_files"))
+	{
+	  p.skip_named_section ();
+	  return;
+	}
+      p.expect_word ("symbol_files");
+      p.expect ('=');
+      p.expect ('{');
+      while (!p.peek ('}') && p.ok ())
+	{
+	  const uint32_t id = p.parse_uint32 ();
+	  p.expect ('=');
+	  const int64_t file_id = p.parse_file_id ();
+	  p.register_file (id, file_id);
+	  if (p.peek (','))
+	    p.expect (',');
+	}
+      p.expect ('}');
+    };
+
+  while (p.ok () && !p.next_word_is ("summary"))
+    read_section ();
+
+  /* summary = { ... }  */
+  p.expect_word ("summary");
+  p.expect ('=');
+  p.expect ('{');
+  gcov_summary s;
+  auto kv = [&] (const char *key) -> uint64_t {
+    p.expect_word (key);
+    p.expect ('=');
+    const uint64_t v = p.parse_uint ();
+    if (p.peek (','))
+      p.expect (',');
+    return v;
+  };
+  s.total_count = kv ("total_count");
+  s.max_count = kv ("max_count");
+  s.max_function_count = kv ("max_fn_count");
+  s.num_counts = kv ("num_counts");
+  s.num_functions = kv ("num_functions");
+  s.num_detailed_entries = kv ("num_detailed_entries");
+  p.expect_word ("detailed_entries");
+  p.expect ('=');
+  p.expect ('{');
+  while (!p.peek ('}') && p.ok ())
+    {
+      p.expect ('{');
+      gcov_summary_detailed_entry e{};
+      p.expect_word ("cutoff");
+      p.expect ('=');
+      e.cutoff = p.parse_uint32 ();
+      p.expect (',');
+      p.expect_word ("min_count");
+      p.expect ('=');
+      e.min_count = p.parse_uint ();
+      p.expect (',');
+      p.expect_word ("num_counts");
+      p.expect ('=');
+      e.num_counts = p.parse_uint ();
+      p.expect ('}');
+      s.detailed_entries.push_back (e);
+      if (p.peek (','))
+	p.expect (',');
+    }
+  p.expect ('}'); /* detailed_entries.  */
+  p.expect ('}'); /* summary.  */
+
+  /* Symbols.  */
+  std::vector<gcov_function> funcs;
+  while (p.ok ())
+    {
+      p.skip_ws ();
+      if (p.cur >= p.end)
+	break;
+      if (!p.peek ('"'))
+	{
+	  read_section ();
+	  continue;
+	}
+      gcov_function func;
+      if (!p.parse_symbol (func))
+	continue;
+      func.total_count = gcov_function_subtree_count (func);
+      funcs.push_back (std::move (func));
+    }
+
+  for (const auto &entry : p.id_file)
+    if (entry.second < -1
+	|| (entry.second >= 0
+	    && static_cast<uint64_t> (entry.second) >= file_names.size ()))
+      {
+	p.fail ("v4 text: file id past file count");
+	break;
+      }
+
+  if (v4::decode_failed ())
+    {
+      fprintf (stderr, "Error: %s\n", v4::decode_message ());
+      return false;
+    }
+
+  /* Size the name/file pools from every id seen.  */
+  uint32_t max_id = 0;
+  for (const auto &kvp : p.id_name)
+    max_id = std::max (max_id, kvp.first);
+  for (const auto &kvp : p.id_file)
+    max_id = std::max (max_id, kvp.first);
+  /* Bound the allocation by the input size.  */
+  if (max_id >= size)
+    {
+      fprintf (stderr, "Error: v4 text: symbol id %u out of range\n",
+	       (unsigned) max_id);
+      return false;
+    }
+  std::vector<std::string> function_names (max_id + 1);
+  std::vector<uint32_t> file_name_map (max_id + 1, INVALID_INDEX);
+  for (const auto &kvp : p.id_name)
+    function_names[kvp.first] = kvp.second;
+  for (const auto &kvp : p.id_file)
+    file_name_map[kvp.first]
+      = kvp.second < 0 ? INVALID_INDEX : static_cast<uint32_t> (kvp.second);
+
+  /* Inlined nodes were built before the name pool existed.  Set their display
+     names now (the binary reader does this inline).  */
+  std::function<void (gcov_function &)> fixup_inlined_names
+    = [&] (gcov_function &f)
+      {
+	for (auto &loc : f.locations)
+	  if (loc->type == gcov_location::kind::inlined)
+	    {
+	      auto *inl = static_cast<gcov_location_inline *> (loc.get ());
+	      if (inl->inlined_sym.id < function_names.size ())
+		inl->inlined_sym.desc.name_index = inl->inlined_sym.id;
+	      fixup_inlined_names (inl->inlined_sym);
+	    }
+      };
+
+  for (auto &func : funcs)
+    {
+      fixup_inlined_names (func);
+      func.desc.name_index = func.id;
+      const uint32_t fidx
+	= (func.id < file_name_map.size ()) ? file_name_map[func.id]
+					    : INVALID_INDEX;
+      func.desc.file_index
+	= (fidx < file_names.size ()) ? fidx : INVALID_INDEX;
+    }
+
+  profile.set_summary (std::move (s));
+  profile.set_names (std::move (file_names), std::move (function_names),
+		     std::move (file_name_map));
+  profile.set_functions (std::move (funcs));
+
+  version = v4::format::AFDO_GCOV_VERSION;
+  return true;
+}
+
+} /* namespace gcov.  */
