diff --git a/afdo_tools/src/symbol_util.h b/afdo_tools/src/symbol_util.h
new file mode 100644
index 00000000000..f73a2cf624d
--- /dev/null
+++ b/afdo_tools/src/symbol_util.h
@@ -0,0 +1,247 @@
+/* Copyright The GNU Toolchain Authors
+
+This file is part of GCC.
+
+GCC is free software; you can redistribute it and/or modify it under
+the terms of the GNU General Public License as published by the Free
+Software Foundation; either version 3, or (at your option) any later
+version.
+
+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_SYMBOL_UTIL_H
+#define GCC_SYMBOL_UTIL_H
+
+/* GCC symbol-name normalization and source-path identity helpers used by
+   correlate, DWARF, and GCOV materialization.  Symbol suffix handling is in
+   gcc_symbol; source-file path comparison is in source_path.  */
+
+#include <cstddef>
+#include <string>
+
+namespace gcc_symbol {
+
+static const char *const GCC_GENERATED_SUFFIX_TAGS[] = {".isra",
+							".constprop",
+							".part",
+							".__part",
+							".lto_priv",
+							".clone",
+							".cold",
+							".hot"};
+
+inline bool
+is_digit_suffix (const std::string &s)
+{
+  if (s.empty ())
+    return false;
+  for (unsigned char c : s)
+    {
+      if (c < '0' || c > '9')
+	return false;
+    }
+  return true;
+}
+
+inline bool
+is_gcc_generated_suffix_tag (const std::string &tag)
+{
+  for (const char *candidate : GCC_GENERATED_SUFFIX_TAGS)
+    if (tag == candidate)
+      return true;
+  return false;
+}
+
+inline std::string
+symbol_base_name (std::string name)
+{
+  /* Strip trailing GCC clone suffixes: .isra.N, .constprop.N, .lto_priv.N,
+     .cold, .hot, ...  */
+  for (;;)
+    {
+      const size_t dot = name.rfind ('.');
+      if (dot == std::string::npos || dot + 1 >= name.size ())
+	break;
+
+      const std::string tail = name.substr (dot + 1);
+      if (tail == "cold" || tail == "hot")
+	{
+	  name.erase (dot);
+	  continue;
+	}
+
+      if (dot == 0 || !is_digit_suffix (tail))
+	break;
+
+      const size_t prev = name.rfind ('.', dot - 1);
+      if (prev == std::string::npos
+	  || !is_gcc_generated_suffix_tag (name.substr (prev, dot - prev)))
+	break;
+
+      name.erase (prev);
+    }
+  return name;
+}
+
+inline bool
+has_gcc_generated_suffix (const std::string &name)
+{
+  if (name.empty ())
+    return false;
+  const size_t dot = name.rfind ('.');
+  if (dot == std::string::npos || dot + 1 == name.size ())
+    return false;
+  const std::string tail = name.substr (dot + 1);
+  if (tail == "cold" || tail == "hot")
+    return true;
+  if (!is_digit_suffix (tail) || dot == 0)
+    return false;
+  const size_t prev = name.rfind ('.', dot - 1);
+  return prev != std::string::npos
+	 && is_gcc_generated_suffix_tag (name.substr (prev, dot - prev));
+}
+
+/* Tags naming a piece of one function rather than a separately specialized
+   body: text-partition parts, and dotted copy tags whose numeric appendix
+   follows the tag.  */
+static const char *const GCC_SPLIT_PART_TAGS[] = {".cold", ".hot"};
+static const char *const GCC_DOTTED_COPY_TAGS[] = {".llvm.", ".__part."};
+
+/* Remove TAG and its trailing numeric appendix, if present.  */
+inline void
+erase_last_tag (std::string &name, const std::string &tag)
+{
+  const size_t at = name.rfind (tag);
+  if (at == std::string::npos)
+    return;
+  const size_t after = at + tag.size ();
+  if (after == name.size ())
+    {
+      name.erase (at);
+      return;
+    }
+  if (name[after] != '.')
+    return;
+  if (is_digit_suffix (name.substr (after + 1)))
+    name.erase (at);
+  else
+    name.erase (at, tag.size ());
+}
+
+/* Erase the last TAG together with the appendix that follows it, up to the
+   next '.' or the end of NAME (".llvm.283491234").  */
+inline void
+erase_last_dotted_tag (std::string &name, const std::string &tag)
+{
+  const size_t at = name.rfind (tag);
+  if (at == std::string::npos)
+    return;
+  const size_t next = name.find ('.', at + tag.size ());
+  name.erase (at, next == std::string::npos ? std::string::npos : next - at);
+}
+
+/* Name shared by a function and its split parts for emit accounting.  Only
+   pieces that carry no profile identity of their own fold into the parent
+   (foo.cold, foo.llvm.N); specialized clones (foo.constprop.N, foo.isra.N,
+   foo.lto_priv.N, foo.part.N) each keep their own identity, so a cold clone
+   is not carried into the profile by a hot sibling.  */
+inline std::string
+symbol_split_part_parent (std::string name)
+{
+  for (const char *tag : GCC_SPLIT_PART_TAGS)
+    erase_last_tag (name, tag);
+  for (const char *tag : GCC_DOTTED_COPY_TAGS)
+    erase_last_dotted_tag (name, tag);
+  return name;
+}
+
+/* Match split parts or a generated variant with its unsuffixed function.  */
+inline bool
+name_equivalent (const std::string &a, const std::string &b)
+{
+  if (a.empty () || b.empty ())
+    return false;
+  if (a == b)
+    return true;
+  const std::string a_part = symbol_split_part_parent (a);
+  const std::string b_part = symbol_split_part_parent (b);
+  if (a_part == b_part)
+    return true;
+  const std::string a_base = symbol_base_name (a_part);
+  const std::string b_base = symbol_base_name (b_part);
+  return a_base == b_base && (a_part == a_base || b_part == b_base);
+}
+
+} /* namespace gcc_symbol.  */
+
+namespace source_path {
+
+/* C++14 stand-in for std::string::ends_with (C++20).  */
+inline bool
+ends_with (const std::string &s, const std::string &suffix)
+{
+  return s.size () >= suffix.size ()
+	 && s.compare (s.size () - suffix.size (), suffix.size (), suffix) == 0;
+}
+
+inline bool
+is_separator (char c)
+{
+  return c == '/' || c == '\\';
+}
+
+/* Normalize path separators and redundant "." components.  */
+inline std::string
+canonical (std::string path)
+{
+  if (path.empty ())
+    return path;
+  for (char &c : path)
+    if (c == '\\')
+      c = '/';
+  while (path.size () >= 2 && path[0] == '.' && path[1] == '/')
+    path.erase (0, 2);
+  for (;;)
+    {
+      const size_t pos = path.find ("/./");
+      if (pos == std::string::npos)
+	break;
+      path.erase (pos, 2);
+    }
+  for (;;)
+    {
+      const size_t pos = path.find ("//");
+      if (pos == std::string::npos)
+	break;
+      path.erase (pos, 1);
+    }
+  return path;
+}
+
+/* True when paths are equal or one is a relative component suffix of the
+   other.  */
+inline bool
+equivalent (const std::string &a, const std::string &b)
+{
+  if (a == b)
+    return true;
+  if (a.empty () || b.empty ())
+    return false;
+  const std::string &longer = a.size () > b.size () ? a : b;
+  const std::string &shorter = a.size () > b.size () ? b : a;
+  if (is_separator (shorter[0]) || !ends_with (longer, shorter))
+    return false;
+  const size_t start = longer.size () - shorter.size ();
+  return start != 0 && is_separator (longer[start - 1]);
+}
+
+} /* namespace source_path.  */
+
+#endif /* GCC_SYMBOL_UTIL_H.  */
