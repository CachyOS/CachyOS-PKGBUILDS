+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "gcov_merge.h"
+#include "version.h"
+
+#include <cstdio>
+#include <getopt.h>
+#include <string>
+#include <vector>
+
+static void
+print_usage (const char *prog, FILE *stream)
+{
+  fprintf (stream, _("Usage:\n"
+		   "  %s [OPTIONS] [<profile.gcov> ...]\n"
+		   "\n"
+		   "Merge AutoFDO profiles (sum counts).\n"
+		   "With no inputs, write an empty profile.\n"
+		   "Options:\n"
+		   "  -o, --output_file FILE   Write merged profile to FILE "
+		   "(default fbdata.afdo)\n"
+		   "  -h, --help  Print this help, then exit\n"
+		   "  -v, --version  Print version information, then exit\n"
+		   "\nFor bug reporting instructions, please see:\n"
+		   "%s.\n"),
+	   prog, bug_report_url);
+}
+
+int
+main (int argc, char *argv[])
+{
+  afdo_init_libintl ();
+
+  std::string output_path = "fbdata.afdo";
+  static option longopts[] = {{"output_file", required_argument, nullptr, 'o'},
+			      {"help", no_argument, nullptr, 'h'},
+			      {"version", no_argument, nullptr, 'v'},
+			      {nullptr, 0, nullptr, 0}};
+
+  int c, idx = 0;
+  while ((c = getopt_long_only (argc, argv, "o:hv", longopts, &idx)) != -1)
+    {
+      switch (c)
+	{
+	case 'o':
+	  output_path = optarg;
+	  break;
+	case 'h':
+	  print_usage (argv[0], stdout);
+	  return 0;
+	case 'v':
+	  printf ("afdo_merge %s%s\n", pkgversion_string, version_string);
+	  return 0;
+	default:
+	  print_usage (argv[0], stderr);
+	  return 1;
+	}
+    }
+
+  std::vector<std::string> inputs;
+  for (int i = optind; i < argc; ++i)
+    inputs.emplace_back (argv[i]);
+
+  gcov::gcov_merger merger;
+  if (!merger.merge (inputs, output_path))
+    return 1;
+
+  return 0;
+}
diff --git a/afdo-tools/src/gcov_merge.cc b/afdo-tools/src/gcov_merge.cc
