+GCC is distributed in the hope that it will be useful, but WITHOUT ANY
+WARRANTY; without even the implied warranty of MERCHANTABILITY or
+FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
+for more details.
+
+You should have received a copy of the GNU General Public License
+along with GCC; see the file COPYING3.  If not see
+<http://www.gnu.org/licenses/>.  */
+
+#include "profile_timer.h"
+
+#include <chrono>
+#include <cstdio>
+#include <utility>
+#include <vector>
+
+namespace autofdo {
+namespace profile_timer {
+
+using clock_type = std::chrono::steady_clock;
+
+struct stage_timer
+{
+  std::string label;
+  clock_type::time_point start;
+};
+
+static clock_type::time_point s_start;
+static bool s_started = false;
+static std::vector<stage_timer> s_stages;
+
+void
+start ()
+{
+  s_start = clock_type::now ();
+  s_started = true;
+  s_stages.clear ();
+}
+
+/* Push a named stage starting now.  */
+void
+begin_stage (const char *label)
+{
+  if (!s_started)
+    start ();
+  s_stages.push_back ({label, clock_type::now ()});
+}
+
+/* Report and pop the innermost stage.  */
+void
+end_stage (const std::string &detail)
+{
+  if (!s_started || s_stages.empty ())
+    {
+      /* Ignoring this silently would misindent every later stage.  */
+      fprintf (stderr, _("Warning: no profiling stage to end\n"));
+      return;
+    }
+
+  const clock_type::time_point now = clock_type::now ();
+  stage_timer stage = std::move (s_stages.back ());
+  s_stages.pop_back ();
+  const double total = std::chrono::duration<double> (now - s_start).count ();
+  const double elapsed
+    = std::chrono::duration<double> (now - stage.start).count ();
+  const int indent = static_cast<int> (s_stages.size () * 2);
+
+  fprintf (stderr,
+	   _("%*sStage: %s [%.1fs] (+%.1fs)"),
+	   indent,
+	   "",
+	   stage.label.c_str (),
+	   total,
+	   elapsed);
+  if (!detail.empty ())
+    fprintf (stderr, "  %s", detail.c_str ());
+  fprintf (stderr, "\n");
+}
+
+} /* namespace profile_timer.  */
+} /* namespace autofdo.  */
