+<http://www.gnu.org/licenses/>.  */
+
+#ifndef GCC_PERF_SPE_READER_H
+#define GCC_PERF_SPE_READER_H
+
+#include "branch_stack_reader_base.h"
+#include "perf_file_reader.h"
+
+#include <cstdint>
+#include <string>
+
+namespace perf_data {
+
+/* Offline ARM SPE: AUXTRACE branches + synthesized ranges.  */
+class perf_spe_reader : public perf_file_reader, public branch_stack_reader_base
+{
+public:
+  perf_spe_reader (const std::string &_perf_data_path,
+		   const std::string &_binary_path);
+  ~perf_spe_reader () override = default;
+
+  void set_accumulate_sample_ips (bool) override {}
+
+  void materialize_address_frequencies_for_per_pc_correlate () override;
+
+  unsigned range_mass_addr_step () const override { return 4; }
+
+  branch_stack_reader_base *as_branch_stack_reader () override { return this; }
+  const branch_stack_reader_base *as_branch_stack_reader () const override
+  {
+    return this;
+  }
+
+private:
+  static bool accept_target_addr_cb (uint64_t runtime_addr, void *ctx);
+  static void note_timestamp_cb (uint64_t runtime_addr, uint64_t timestamp,
+				 void *ctx);
+
+  bool parse_perf_data_section () override;
+  void finalize_profile_maps_impl () override;
+
+  branch_stack_edge_count_map range_count_map_;
+  branch_stack_edge_count_map branch_count_map_;
+};
+
+} /* namespace perf_data.  */
+
+#endif /* GCC_PERF_SPE_READER_H.  */
