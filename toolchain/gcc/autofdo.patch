+/* { dg-options "-O2 -g -Wl,--build-id" } */
+/* { dg-afdo-entry live } */
+/* { dg-afdo-sources lbr brbe spe } */
+/* { dg-afdo-post dump } */
+/* { dg-afdo-validate dump-tree } */
+/* { dg-afdo-dump-hot driver } */
+/* { dg-afdo-determinism-runs 3 } */
+/* { dg-afdo-requires python3 perf } */
+
+#include <stdio.h>
+
+volatile int seed = 7;
+
+#define HOT_FN(name)						\
+  __attribute__((noinline))					\
+  int name (int x)						\
+  {								\
+    int a = (x + seed) * 3 + 1;					\
+    int b = a ^ (a >> 5);					\
+    return b * 31 + (b << 2) - seed;				\
+  }
+
+HOT_FN (alpha)
+HOT_FN (bravo)
+HOT_FN (charlie)
+HOT_FN (delta)
+HOT_FN (echo_fn)
+
+__attribute__((noinline))
+int driver (int n)
+{
+  int s = 0;
+  for (int i = 0; i < n; ++i)
+    s += alpha (i) + bravo (i) + charlie (i) + delta (i) + echo_fn (i);
+  return s;
+}
+
+volatile int iters = 40000000;
+
+int main (void)
+{
+  printf ("%d\n", driver (iters));
+  return 0;
+}
