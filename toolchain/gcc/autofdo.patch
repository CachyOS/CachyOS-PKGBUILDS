+namespace autofdo {
+
+function_builder::function_builder (const function_builder &other)
+  : name (other.name), file_path (other.file_path),
+    start_line (other.start_line), discriminator (other.discriminator),
+    total_count (other.total_count), head_count (other.head_count),
+    position_count_values (other.position_count_values),
+    position_target_values (other.position_target_values)
+{
+  for (const auto &entry : other.callsite_nodes)
+    callsite_nodes.emplace (
+      entry.first, std::make_unique<function_builder> (*entry.second));
+}
+
+void
+profile_builder::init_function_builder (
+  function_profile &func_profile, const dwarf_debug::function_metadata &func)
+{
+  if (!func_profile.builder)
+    {
+      auto builder = std::make_unique<function_builder> ();
+      builder->name = dwarf_debug::string_value (func.name);
+      builder->file_path = dwarf_debug::string_value (func.file_path);
+      /* start_line: DECL_SOURCE_LINE base for relative offsets.  */
+      builder->start_line = func.start_line;
+      func_profile.builder = std::move (builder);
+    }
+}
+
+function_profile &
+profile_builder::get_or_create_function_profile (const std::string &name,
+						 uint64_t start_addr)
+{
+  function_profile_key key{name, start_addr};
+  auto it = function_profiles.find (key);
+  if (it != function_profiles.end ())
+    return it->second;
+
+  auto inserted
+    = function_profiles.emplace (std::move (key), function_profile ());
+  inserted.first->second.start_addr = start_addr;
+  return inserted.first->second;
+}
+
+void
+profile_builder::finalize_after_correlate (
+  const perf_data::profile_reader &perf)
+{
+  for (const auto &entry : perf.function_timestamps ())
+    {
+      const uint64_t timestamp = entry.second;
+      if (timestamp == 0)
+	continue;
+      const function_profile_key &fp_key = entry.first;
+      auto fp_it = function_profiles.find (fp_key);
+      if (fp_it == function_profiles.end () || fp_it->second.builder == nullptr)
+	continue;
+      fp_it->second.timestamp = timestamp;
+    }
+
+  for (auto &kv : function_profiles)
+    {
+      function_profile &func_profile = kv.second;
+      if (!func_profile.builder)
+	continue;
+      func_profile.builder->collapse_copy_ids ();
+      func_profile.builder->estimate_head_count (/*toplevel=*/true);
+      func_profile.head_count = func_profile.builder->head_count;
+      func_profile.total_samples = func_profile.builder->compute_total_count ();
+    }
+}
+
+void
+profile_builder::materialize_alias_profiles (
+  const std::vector<dwarf_debug::function_metadata> &functions,
+  const std::vector<dwarf_debug::function_alias_metadata> &aliases)
+{
+  for (const dwarf_debug::function_alias_metadata &alias : aliases)
+    {
+      if (alias.primary_index >= functions.size ())
+	continue;
+      const dwarf_debug::function_metadata &primary
+	= functions[alias.primary_index];
+      const function_profile_key primary_key{
+	dwarf_debug::string_value (primary.name), primary.start_addr};
+      const auto primary_it = function_profiles.find (primary_key);
+      if (primary_it == function_profiles.end ()
+	  || primary_it->second.builder == nullptr
+	  || primary_it->second.total_samples == 0)
+	continue;
+
+      const dwarf_debug::function_metadata &alias_func = alias.function;
+      const function_profile_key alias_key{
+	dwarf_debug::string_value (alias_func.name), alias_func.start_addr};
+      if (function_profiles.find (alias_key) != function_profiles.end ())
+	continue;
+
+      function_profile copy;
+      copy.start_addr = alias_func.start_addr;
+      copy.total_samples = primary_it->second.total_samples;
+      copy.head_count = primary_it->second.head_count;
+      copy.timestamp = primary_it->second.timestamp;
+      copy.builder
+	= std::make_unique<function_builder> (*primary_it->second.builder);
+      copy.builder->name = dwarf_debug::string_value (alias_func.name);
+      copy.builder->file_path
+	= dwarf_debug::string_value (alias_func.file_path);
+      function_profiles.emplace (alias_key, std::move (copy));
+    }
+}
+
+/* Function-tree operations.  */
+
+bool
+function_builder::has_sampled_mass () const
+{
+  for (const auto &entry : position_count_values)
+    if (entry.second != 0)
+      return true;
+  for (const auto &entry : callsite_nodes)
+    if (entry.second != nullptr && entry.second->has_sampled_mass ())
+      return true;
+  return false;
+}
+
+void
+function_builder::materialize_callsite_entry_counts ()
+{
+  if (start_line == 0)
+    return;
+  for (auto &entry : callsite_nodes)
+    {
+      function_builder &child = *entry.second;
+      child.estimate_head_count (/*toplevel=*/false);
+      if (child.head_count == 0 || entry.first.call_line < start_line)
+	continue;
+
+      const uint32_t offset = entry.first.call_line - start_line;
+      if (!gcov_offset_fields_representable (offset))
+	continue;
+      const uint32_t disc = entry.first.call_disc != 0
+			      ? entry.first.call_disc
+			      : get_base_discriminator (child.discriminator);
+      uint64_t &count
+	= position_count_values[gcov_pack_line_disc (offset, disc)];
+      count = std::max (count, child.head_count);
+    }
+}
+
+uint64_t
+function_builder::compute_total_count ()
+{
+  uint64_t t = 0;
+  for (const auto &kv : position_count_values)
+    t += kv.second;
+  for (auto &kv : callsite_nodes)
+    t += kv.second->compute_total_count ();
+  total_count = t;
+  return t;
+}
+
+void
+function_builder::estimate_head_count (bool toplevel)
+{
+  /* Keep a measured incoming-edge head_count.  */
+  if (head_count != 0)
+    return;
+
+  /* Only relative line 0 is entry mass; do not promote body samples.  */
+  for (const auto &pos_kv : position_count_values)
+    {
+      if (gcov_rel_line_from_packed (pos_kv.first) != 0)
+	break;
+      if (pos_kv.second == 0)
+	continue;
+      head_count = pos_kv.second;
+      break;
+    }
+  for (const auto &cs : callsite_nodes)
+    {
+      if (head_count != 0)
+	break;
+      const uint64_t cs_off
+	= profile_offset (cs.first.call_line, cs.first.call_disc);
+      if (cs_off == std::numeric_limits<uint64_t>::max ()
+	  || gcov_rel_line_from_packed (cs_off) != 0)
+	continue;
+      cs.second->estimate_head_count (/*toplevel=*/false);
+      head_count = cs.second->head_count;
+    }
+  if (head_count != 0)
+    return;
+
+  /* Top-level only: head_count=1 for unsampled entries GCC must annotate.  */
+  if (toplevel && has_sampled_mass ())
+    head_count = 1;
+}
+
+void
+function_builder::collapse_copy_ids ()
+{
+  for (auto &kv : callsite_nodes)
+    kv.second->collapse_copy_ids ();
+
+  std::map<uint64_t, uint64_t> new_pos;
+  for (const auto &kv : position_count_values)
+    {
+      const uint32_t rel = gcov_rel_line_from_packed (kv.first);
+      const uint32_t base
+	= get_base_discriminator (gcov_disc_from_packed (kv.first));
+      new_pos[gcov_pack_line_disc (rel, base)] += kv.second;
+    }
+  position_count_values = std::move (new_pos);
+
+  std::map<uint64_t, pos_target_map> new_targets;
+  for (auto &kv : position_target_values)
+    {
+      const uint32_t rel = gcov_rel_line_from_packed (kv.first);
+      const uint32_t base
+	= get_base_discriminator (gcov_disc_from_packed (kv.first));
+      auto &slot = new_targets[gcov_pack_line_disc (rel, base)];
+      for (auto &tgt : kv.second)
+	slot[tgt.first] += tgt.second;
+    }
+  position_target_values = std::move (new_targets);
+}
+
+uint64_t
+function_builder::profile_offset (uint32_t line, uint32_t disc_full) const
+{
+  constexpr uint64_t INVALID_PROFILE_OFFSET
+    = std::numeric_limits<uint64_t>::max ();
+  /* Relative offsets need a known DECL_SOURCE_LINE base.  */
+  if (line == 0 || start_line == 0)
+    return INVALID_PROFILE_OFFSET;
+  if (line < start_line)
+    return INVALID_PROFILE_OFFSET;
+  const uint32_t rel = line - start_line;
+  const uint32_t disc_key = strip_multiplicity (disc_full);
+  if (!gcov_offset_fields_representable (rel))
+    return INVALID_PROFILE_OFFSET;
+  return gcov_pack_line_disc (rel, disc_key);
+}
+
+function_builder &
+function_builder::create_callsite (const callsite_key &key)
+{
+  auto child = std::make_unique<function_builder> ();
+  child->name = dwarf_debug::string_value (key.function_name);
+  child->discriminator = key.call_disc;
+  const auto inserted = callsite_nodes.emplace (key, std::move (child));
+  return *inserted.first->second;
+}
+
+void
+function_builder::deposit_position_max (uint32_t line, uint32_t disc,
+					uint64_t count)
+{
+  const uint64_t offset = profile_offset (line, disc);
+  if (offset == std::numeric_limits<uint64_t>::max ())
+    return;
+  uint64_t &position_count = position_count_values[offset];
+  position_count = std::max (position_count, count);
+}
+
+void
+function_builder::record_call_target_max (
+  uint32_t line, uint32_t disc, dwarf_debug::interned_string callee_name,
+  uint64_t count)
+{
+  const uint64_t offset = profile_offset (line, disc);
+  if (offset == std::numeric_limits<uint64_t>::max ())
+    return;
+  position_count_values.emplace (offset, 0);
+  uint64_t &target_count = position_target_values[offset][callee_name];
+  target_count = std::max (target_count, count);
+}
+
+bool
+profile_builder::build_gcov_profile (gcov::gcov_profile &out)
+{
+  std::vector<std::pair<std::string, function_profile *>> emit;
+  emit.reserve (function_profiles.size ());
+  for (auto &kv : function_profiles)
+    {
+      function_profile &func = kv.second;
+      if (!func.builder)
+	continue;
+      /* Skip zero-mass profiles (below emit threshold).  */
+      if (func.total_samples == 0)
+	continue;
+      const std::string &mangled = kv.first.first;
+      emit.push_back ({mangled, &func});
+    }
+  /* Deterministic GCOV order; one profile per (name, start_addr) already.  */
+  std::sort (emit.begin (), emit.end (), [] (const auto &a, const auto &b) {
+    if (a.first != b.first)
+      return a.first < b.first;
+    const std::string &fa = a.second->builder != nullptr
+			      ? a.second->builder->file_path
+			      : std::string ();
+    const std::string &fb = b.second->builder != nullptr
+			      ? b.second->builder->file_path
+			      : std::string ();
+    if (fa != fb)
+      return fa < fb;
+    return a.second->start_addr < b.second->start_addr;
+  });
+
+  /* Materialize callsite entry counts before name collection / summary /
+     serialization so all three see the same totals.  */
+  for (auto &entry : emit)
+    {
+      function_builder *builder = entry.second->builder.get ();
+      builder->materialize_callsite_entry_counts ();
+      entry.second->total_samples = builder->compute_total_count ();
+    }
+
+  return gcov_profile_exporter::export_profile (emit, out);
+}
+
+} /* namespace autofdo.  */
