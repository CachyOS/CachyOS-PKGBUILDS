+/* Reuse the offline mapping history for records from all live CPU buffers.  */
+class live_mapping_reader : public perf_file_reader
+{
+  struct task_state
+  {
+    uint64_t time;
+    bool alive;
+  };
+  /* The latest fork or exit for each inherited task.  */
+  std::unordered_map<uint32_t, task_state> tasks_;
+  uint64_t task_changes_ = 0;
+
+public:
+  live_mapping_reader (const std::string &binary, uint64_t sample_type)
+    : perf_file_reader ("", binary)
+  {
+    sideband_layout_.sample_type = sample_type;
+    sideband_layout_.sample_id_all = true;
+  }
+
+  bool add_record (const perf_event_header &header, const uint8_t *payload,
+		   size_t size)
+  {
+    switch (header.type)
+      {
+      case PERF_RECORD_MMAP:
+	return parse_mmap_record (payload, size, header.misc);
+      case PERF_RECORD_MMAP2:
+	return parse_mmap2_record (payload, size, header.misc);
+      case PERF_RECORD_COMM:
+	note_process_lifetime_record (header, payload, size);
+	break;
+      case PERF_RECORD_FORK:
+      case PERF_RECORD_EXIT:
+	{
+	  if (size < 4 * sizeof (uint32_t) + sizeof (uint64_t))
+	    return false;
+	  if (header.type == PERF_RECORD_FORK)
+	    note_process_lifetime_record (header, payload, size);
+	  uint32_t tid;
+	  uint64_t time;
+	  std::memcpy (&tid, payload + 2 * sizeof (uint32_t), sizeof (tid));
+	  std::memcpy (&time, payload + 4 * sizeof (uint32_t), sizeof (time));
+	  const bool alive = header.type == PERF_RECORD_FORK;
+	  auto it = tasks_.find (tid);
+	  if (it == tasks_.end ())
+	    {
+	      tasks_.emplace (tid, task_state{time, alive});
+	      ++task_changes_;
+	    }
+	  else if (time > it->second.time
+		   || (time == it->second.time && !alive && it->second.alive))
+	    {
+	      it->second = {time, alive};
+	      ++task_changes_;
+	    }
+	  break;
+	}
+      default:
+	break;
+      }
+    return true;
+  }
+
+  bool has_live_tasks () const
+  {
+    for (const auto &entry : tasks_)
+      if (entry.second.alive)
+	return true;
+    return false;
+  }
+
+  uint64_t task_changes () const { return task_changes_; }
+
+  bool finish (pid_mmap_map &maps)
+  {
+    close_target_mmap_time_windows ();
+    if (!target_mapping_lifetime_valid ())
+      return false;
+    maps = std::move (target_mmaps_by_pid_);
+    return true;
+  }
+
+private:
+  bool parse_perf_data_section () override { return false; }
+};
