+# afdo_format_flags.  Return the afdo_create options for FORMAT.
+proc afdo_format_flags { format } {
+    switch -- $format {
+	v3      { return [list --gcov_version 3] }
+	v4      { return [list --gcov_version 4] }
+	v4-text { return [list --gcov_version 4 --format text] }
+    }
+    return {}
+}
+
+# afdo_current_format.  Return the GCOV encoding for this test instance.
+proc afdo_current_format {} {
+    global afdo_gcov_format env
+    if { [info exists afdo_gcov_format] && $afdo_gcov_format ne "" } {
+	return $afdo_gcov_format
+    }
+    if { [info exists env(AFDO_FORCE_GCOV_FORMAT)] \
+	     && $env(AFDO_FORCE_GCOV_FORMAT) ne "" } {
+	return $env(AFDO_FORCE_GCOV_FORMAT)
+    }
+    return v3
+}
+
+# afdo_expand_formats.  Return the encodings to test.  Tests that select a
+# profile reader explicitly keep the format requested by the test.
+proc afdo_expand_formats { fields } {
+    global env
+    if { [dict exists $fields opt-profile-options] } {
+	return [list [afdo_current_format]]
+    }
+    if { [info exists env(AFDO_FORCE_GCOV_FORMAT)] \
+	     && $env(AFDO_FORCE_GCOV_FORMAT) ne "" } {
+	return [list $env(AFDO_FORCE_GCOV_FORMAT)]
+    }
+    if { [info exists env(AFDO_GCOV_FORMATS)] \
+	 && $env(AFDO_GCOV_FORMATS) ne "" } {
+	return $env(AFDO_GCOV_FORMATS)
+    }
+    return [list v3 v4 v4-text]
+}
+
+# afdo_forced_format_flags.  Return options for the current encoding.  The
+# caller appends these options so that they override any earlier format.
+proc afdo_forced_format_flags {} {
+    set format [afdo_current_format]
+    if { $format eq "" || $format eq "v3" } { return {} }
+    set flags [afdo_format_flags $format]
+    if { [llength $flags] == 0 } {
+	verbose -log -- "afdo: ignoring unknown GCOV format '$format'" 0
+    }
+    return $flags
+}
