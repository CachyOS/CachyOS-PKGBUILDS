pkgname=cachyos-xfce-settings
pkgdesc='CachyOS XFCE settings'
pkgver=1.0.9
pkgrel=2
arch=('any')
url="https://github.com/cachyos/$pkgname"
license=(GPL-1.0-only)
makedepends=('coreutils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
sha512sums=('d4a530abb6aaf067c8ec9a2fc8bebb9ffdc2fae8cfb2623ce6baf27273e0c142738f7226a55d2f39785d4da5b9cc5da975a1e99c8f7ddabb464b2ae8d1b0d8e6')
depends=('cachyos-zsh-config'
    'cachyos-alacritty-config'
    'ttf-fantasque-nerd'
    'noto-fonts'
    'ttf-fira-sans'
    'kvantum'
    'qt5ct'
    'xfce4-whiskermenu-plugin'
    'thunar'
    'char-white'
    'qogir-icon-theme'
    'capitaine-cursors'
    'cachyos-wallpapers')
install=$pkgname.install
provides=('cachyos-desktop-settings')
conflicts=('cachyos-desktop-settings')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"

  # Stop selecting the retired GTK theme; leave GTK defaults in effect.
  sed -i '/^gtk-theme-name=.*cachyos-nord/d' \
    etc/skel/.gtkrc-2.0 \
    etc/skel/.config/gtk-3.0/settings.ini \
    etc/skel/.config/gtk-4.0/settings.ini
  sed -i "/^gtk-theme='cachyos-nord'$/d" usr/share/glib-2.0/schemas/25_xfce-default-settings.gschema.override
  sed -i '/name="ThemeName".*value="cachyos-nord"/d' \
    etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
  sed -i '/^theme=Nordic-Darker-Solid$/d' etc/skel/.config/Kvantum/kvantum.kvconfig
}

package() {
    install -d $pkgdir/etc
    cp -rf $srcdir/$pkgname-$pkgver/etc $pkgdir
    install -d $pkgdir/usr
    cp -rf $srcdir/$pkgname-$pkgver/usr $pkgdir
}
