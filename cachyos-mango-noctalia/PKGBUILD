pkgname=cachyos-mango-noctalia
pkgdesc='CachyOS Mango (+Noctalia) settings'
pkgver=1.4.0
pkgrel=1
arch=('any')
url="https://github.com/cachyos/$pkgname"
license=(GPL-3.0-only)
makedepends=('coreutils' 'git')
source=(
    git+https://github.com/cachyos/cachyos-mango-noctalia#tag=$pkgver
)
sha512sums=('f395eb1ea222ffb41bc1bff7a9299d5eca549ffb8fcfb7adbfab25a97568ef588eb9e362cce267d69bbf18f8e79a40970fd5eb95bf830a79aaee70b7e3bd3a0f')
depends=(
  adw-gtk-theme
  breeze
  cachyos-alacritty-config
  capitaine-cursors
  dolphin
  gnome-keyring
  gpu-screen-recorder
  mangowm
  noctalia
  noto-fonts
  noto-fonts-emoji
  qt6ct
  wl-clipboard
  wlr-randr
  xdg-desktop-portal-gtk
  xdg-desktop-portal-wlr
)
provides=('cachyos-desktop-settings')
conflicts=('cachyos-desktop-settings')

package() {
  install -d "${pkgdir}/etc"
  cp -rf "${srcdir}/${pkgname}/etc" "${pkgdir}"
}
