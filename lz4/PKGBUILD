# Maintainer: Sébastien Luttringer
# PGO build: Laio O. Seman <laio [at] ieee.org>

pkgname=lz4
epoch=1
pkgver=1.11.1
pkgrel=2
pkgdesc='Extremely fast compression algorithm'
arch=('x86_64')
url='https://lz4.github.io/lz4/'
license=(GPL-2.0-or-later)
makedepends=('git' 'meson' 'ninja' 'llvm' 'clang')
checkdepends=('diffutils')
depends=('glibc')
provides=('liblz4.so')
source=("git+https://github.com/lz4/lz4.git#tag=v$pkgver")
sha256sums=('aa0cfb1377f46ae4697892f16ac6b5ebda4f3ad66cc6db13b45682b20a4a65cf')

_meson_setup() {
  meson setup --prefix=/usr --buildtype=plain \
    -Dcontrib=true -Dexamples=true -Dprograms=true "$@" \
    lz4/build/meson build
}

# Exercise the instrumented build: frame API through the CLI (every
# compression mode, plus legacy frames as used for initramfs) and the
# block API through upstream's fullbench.
_pgo_train() {
  local _lz4="$srcdir/build/meson/programs/lz4"
  local _tests="$srcdir/build/meson/tests"
  local _data="$srcdir/pgo-data"
  local _f _l

  mkdir "$_data"

  # datagen is instrumented as well; keep its profile out of the merge
  export LLVM_PROFILE_FILE="$srcdir/pgo-discard/%m_%p.profraw"
  "$_tests/datagen" -g32000000      > "$_data/text"  # lorem ipsum text
  "$_tests/datagen" -g32000000 -P20 > "$_data/low"   # poorly compressible
  "$_tests/datagen" -g32000000 -P90 > "$_data/high"  # highly repetitive
  head -c 32000000 /usr/lib/libLLVM.so > "$_data/bin" # real machine code

  export LLVM_PROFILE_FILE="$srcdir/pgo/%m_%p.profraw"
  for _f in "$_data"/text "$_data"/low "$_data"/high "$_data"/bin; do
    for _l in --fast=8 -1 -2 -3 -6 -9 -10 -12; do
      "$_lz4" -q -f "$_l" "$_f" "$_f.lz4"
      "$_lz4" -q -f -d "$_f.lz4" "$_f.out"
      cmp "$_f" "$_f.out"
    done
    # legacy format (lz4 -l), e.g. kernel and initramfs images
    "$_lz4" -q -f -l -9 "$_f" "$_f.lz4"
    "$_lz4" -q -f -d "$_f.lz4" "$_f.out"
    cmp "$_f" "$_f.out"
  done

  # block API (LZ4_compress_*, LZ4_decompress_*, HC), used by most library consumers
  "$_tests/fullbench" --no-prompt -i1 "$_data/text" "$_data/bin" > /dev/null
  unset LLVM_PROFILE_FILE

  rm -rf "$_data"
}

build() {
  export CC=clang
  export CXX=clang++

  rm -rf build pgo pgo-discard
  mkdir pgo pgo-discard

  local _cflags="$CFLAGS" _cxxflags="$CXXFLAGS" _ldflags="$LDFLAGS"
  local _gen="-fprofile-generate -fprofile-update=atomic"

  # Instrumented build: only the binaries the training needs (tests are
  # enabled for datagen and fullbench; the freestanding test can't link
  # against the profile runtime)
  export CFLAGS="$_cflags $_gen"
  export CXXFLAGS="$_cxxflags $_gen"
  export LDFLAGS="$_ldflags $_gen"
  _meson_setup -Dtests=true
  meson compile -C build lz4:executable datagen fullbench

  msg2 "Running PGO training workload"
  _pgo_train
  llvm-profdata merge -o pgo/merged.profdata pgo/*.profraw

  # Optimized build
  rm -rf build
  local _use="-fprofile-use=$srcdir/pgo/merged.profdata"
  export CFLAGS="$_cflags $_use"
  export CXXFLAGS="$_cxxflags $_use"
  export LDFLAGS="$_ldflags $_use"
  _meson_setup
  meson compile -C build
}

check() {
  rm -f passwd.lz4
  build/meson/programs/lz4 /etc/passwd passwd.lz4
  build/meson/programs/lz4 -d passwd.lz4 passwd
  diff -q /etc/passwd passwd
  rm passwd
}

package() {
  meson install -C build --destdir "$pkgdir"
}

