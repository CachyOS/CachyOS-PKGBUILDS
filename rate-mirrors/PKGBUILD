# Maintainer: Vladislav Nepogodin (vnepogodin) <vnepogodin@cachyos.org>
# Contributor: Nikita Almakov <nikita.almakov@gmail.com>

pkgname=rate-mirrors
pkgver=0.34.0
pkgrel=1
pkgdesc="Everyday-use client-side map-aware mirror ranking tool"
arch=(x86_64)
url="https://github.com/westandskif/rate-mirrors"
license=('CC-BY-NC-SA-3.0')
depends=('glibc' 'gcc-libs' 'librustls')
makedepends=('git' 'cargo' 'lld' 'clang' 'llvm')
source=(
    "${pkgname}::git+$url.git#tag=v${pkgver}"
    "https://github.com/CachyOS/rate-mirrors/commit/646c4f5377e37549ca860b6bbbe5893e7a53521f.patch"
    "https://github.com/CachyOS/rate-mirrors/commit/38cc36bc4778af6f9c42c24e8eb2f1c0a63715a8.patch"
    "https://github.com/CachyOS/rate-mirrors/commit/04c45751d15657a20e939d744eee2f10d3f15439.patch"
)
sha256sums=('5711cf7a7ec817f1f4c880717950a24f2563e2fc963144082b170d238b82cbc7'
            'bc67ef8ce7972c86d1a35c81edef0f3f201e65ba13a729f58a7dd52beb32bb00'
            '7c7aa882e1e10a54c781b8f70e78bbaade444fb4549c9daa9651639ea4fbdae5'
            'e0c553a8877017fd4fd3b5199f3f4a923a27394058ce50f4f5a65ce236ff9c01')

prepare() {
  cd "$pkgname"

  # cachyos: add proxy mirrorlist as primary
  patch -Np1 -i ../646c4f5377e37549ca860b6bbbe5893e7a53521f.patch

  # archlinux: use cachyos proxy mirrorlist
  patch -Np1 -i ../38cc36bc4778af6f9c42c24e8eb2f1c0a63715a8.patch

  # cachyos: use mirrorlist API from zyner
  patch -Np1 -i ../04c45751d15657a20e939d744eee2f10d3f15439.patch

  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname"
  # Compile with clang
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  export RUSTFLAGS="-Cembed-bitcode -C opt-level=3 -Ccodegen-units=1 -Clinker=clang -C link-arg=-flto -Clink-arg=-fuse-ld=/usr/bin/ld.lld"

  cargo build --release --frozen
}

package() {
  cd "$pkgname"

  install -Dm755 "target/release/rate_mirrors" "$pkgdir/usr/bin/${pkgname}"
}

