From 7a8a0b9e3666d620a774907706a609288d33d73b Mon Sep 17 00:00:00 2001
From: cloudy <37777261+uwuclxdy@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:33:25 +0100
Subject: [PATCH] fix(search): stop -Sss printing a dead AUR URL for split
 packages

The AUR URL line used the package base, which has no /packages/ page
when no package in the base shares its name; it now uses the package name.

(cherry picked from commit 7a8a0b9e3666d620a774907706a609288d33d73b,
 tests dropped)
---
 src/search.rs | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/search.rs b/src/search.rs
index 1d658fd6..60ed0aa0 100644
--- a/src/search.rs
+++ b/src/search.rs
@@ -367,8 +367,9 @@ fn print_pkg(config: &Config, pkg: &raur::Package, quiet: bool) {
             info::print(c, 14, config.cols, "    URL", url);
         }
 
-        let aur_url = format!("{}packages/{}", config.aur_url, pkg.package_base);
-        info::print(c, 14, config.cols, "    AUR URL", aur_url.as_str());
+        if let Ok(aur_url) = config.aur_url.join(&format!("packages/{}", pkg.name)) {
+            info::print(c, 14, config.cols, "    AUR URL", aur_url.as_str());
+        }
     }
 }
 
