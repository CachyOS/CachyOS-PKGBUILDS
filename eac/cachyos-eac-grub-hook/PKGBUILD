pkgname=cachyos-eac-grub-hook
pkgver=1
pkgrel=1
pkgdesc='mkinitcpio hook that keeps the copy of the EAC kernel on the EFI system partition up to date (GRUB, set up by eac-setup)'
arch=('any')
url="https://github.com/CachyOS/CachyOS-PKGBUILDs"
license=('GPL-3.0-or-later')
depends=('mkinitcpio' 'systemd')
source=("cachyos-eac-esp")

package() {
    install -Dm755 cachyos-eac-esp "$pkgdir/usr/lib/initcpio/post/cachyos-eac-esp"
}

