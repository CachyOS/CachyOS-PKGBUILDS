# Maintainer: Morten Linderud <foxboron@archlinux.org>
# Contributor: Dave Reisner <dreisner@archlinux.org>

pkgname=arch-install-scripts
pkgver=32
pkgrel=1
pkgdesc="Scripts to aid in installing Arch Linux"
arch=('any')
url="https://gitlab.archlinux.org/archlinux/arch-install-scripts"
license=('GPL-2.0-only')
depends=('awk' 'bash' 'coreutils' 'grep' 'pacman' 'util-linux')
makedepends=('asciidoc' 'git')
source=("git+$url.git#tag=v${pkgver}?signed"
        https://github.com/CachyOS/arch-install-scripts/commit/6f52dcbeb02cb096d5b14589df42f69d06c9effc.patch)
validpgpkeys=(
  'C100346676634E80C940FB9E9C02FF419FECBE16'  # Morten Linderud
  'E499C79F53C96A54E572FEE1C06086337C50773E'  # Jelle van der Waa
)
sha256sums=('1c0d4d6f22136033b18d717e0ddc73dc77ab0e7d5db1627c306587b014db43a0'
            '2466083c908ac9ae62a72a0dc6d74dedf84365a8c2d514cf3e73feade1971825')

prepare() {
  cd "$pkgname"

  # pacstrap: give the new root a private /run
  patch -Np1 -i ../6f52dcbeb02cb096d5b14589df42f69d06c9effc.patch
}

build() {
  make -C "$pkgname"
}

check() {
  make -C "$pkgname" check
}

package() {
  make -C "$pkgname" PREFIX=/usr DESTDIR="$pkgdir" install
}
