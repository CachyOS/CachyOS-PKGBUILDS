pkgname = nvidia-utils
	pkgdesc = NVIDIA drivers utilities
	install = nvidia-utils.install
	depends = libglvnd
	depends = egl-wayland
	depends = egl-wayland2
	depends = egl-gbm
	depends = egl-x11
