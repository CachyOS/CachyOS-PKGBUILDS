pkgname=cachyos-drm-awaiter
pkgver=6
pkgrel=1
pkgdesc="Configuration for proper systemd chain-loading of DRM modules"
arch=('any')
license=('GPL-3.0-or-later')
url="https://github.com/CachyOS/CachyOS-PKGBUILDS/tree/master/$pkgname"
depends=('systemd')
makedepends=('coreutils')
source=(
    drm-module-awaiter-generator
    drm-failure-handler
    drm-failure-handler.service
)
sha256sums=(
    '70c6876fa0918769505e0a32bd3a207d3c9289ff07f98d4b01668b5abb25a32d'
    '6b801848e6559cd8aed4c57741678055eebf72baf705f6511509fab6d00852f3'
    'ca353c9b49a831651c528fa6ca78196376660906ec5a7d472bf9c18043faa940'
)

package() {
    install -Dm755 drm-module-awaiter-generator "${pkgdir}/usr/lib/systemd/system-generators/drm-module-awaiter-generator"
    install -Dm755 drm-failure-handler "${pkgdir}/usr/lib/systemd/scripts/drm-failure-handler"
    install -Dm644 drm-failure-handler.service "${pkgdir}/usr/lib/systemd/system/drm-failure-handler.service"
}
