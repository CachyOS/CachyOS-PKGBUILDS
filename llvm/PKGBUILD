pkgname=('llvm' 'llvm-libs')
pkgver=23.1.1
pkgrel=2
arch=('x86_64')
url="https://llvm.org/"
license=('Apache-2.0 WITH LLVM-exception')
makedepends=('cmake' 'ninja' 'zlib' 'zstd' 'curl' 'libffi' 'libedit' 'libxml2'
             'python-setuptools' 'python-psutil' 'python-sphinx'
             'python-myst-parser' 'python-build' 'python-installer' 'python-wheel'
             'clang' 'lld' 'llvm')
checkdepends=('llvm-libs')
options=('staticlibs' '!lto') # tools/llvm-shlib/typeids.test fails with LTO
_source_base=https://github.com/llvm/llvm-project/releases/download/llvmorg-$pkgver
source=($_source_base/llvm-project-$pkgver.src.tar.xz{,.sig})
sha256sums=('ebe9be46fe8756d58c5b198ffad0fa2a766257add81a4dc52179bfacc7888ee6'
            'SKIP')
validpgpkeys=('474E22316ABF4785A88C6E8EA2C794A986419D8A'  # Tom Stellard <tstellar@redhat.com>
              'D574BD5D1D0E98895E3BF90044F2485E45D59042'  # Tobias Hieta <tobias@hieta.se>
              'FFB3368980F3E6BB5737145A316C56D064CACBA5'  # Douglas Yung <douglas.yung@sony.com>
              '71046D1E9C6656BDD61171873E83BABF4A4F9E85'  # Cullen Rhodes <cullen.rhodes@arm.com>
)

# Utilizing LLVM_DISTRIBUTION_COMPONENTS to avoid
# installing static libraries; inspired by Gentoo
_get_distribution_components() {
  local target
  ninja -t targets | grep -Po 'install-\K.*(?=-stripped:)' | while read -r target; do
    case $target in
      llvm-libraries|distribution)
        continue
        ;;
      # shared libraries
      LLVM|LLVMgold)
        ;;
      # libraries needed for clang-tblgen
      LLVMDemangle|LLVMSupport|LLVMTableGen)
        ;;
      # used by lldb
      LLVMDebuginfod|LLVMHTTP)
        ;;
      # testing libraries
      LLVMTestingAnnotations|LLVMTestingSupport)
        ;;
      # exclude static libraries
      LLVM*)
        continue
        ;;
      # exclude llvm-exegesis (doesn't seem useful without libpfm)
      llvm-exegesis)
        continue
        ;;
    esac
    echo $target
  done
}

prepare() {
  cd llvm-project-$pkgver.src/llvm
  mkdir build

  # Remove CMake find module for zstd; breaks if out of sync with upstream zstd
  rm cmake/modules/Findzstd.cmake
}

build() {
  cd llvm-project-$pkgver.src/llvm/build

  # Build only minimal debug info to reduce size
  CFLAGS=${CFLAGS/-g /-g1 }
  CXXFLAGS=${CXXFLAGS/-g /-g1 }

  # Add fno-semantic-position, can improve at fPIC compiled packages massively the performance
  # At clang it improves for 3%
  # If clang is as compiler used, it should as default add this anyways
  export CFLAGS+=" -fno-semantic-interposition"
  export CXXFLAGS+=" -fno-semantic-interposition"

  local cmake_args=(
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_DOCDIR=share/doc
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_SKIP_INSTALL_RPATH=ON
    -DLLVM_BINUTILS_INCDIR=/usr/include
    -DLLVM_BUILD_DOCS=ON
    -DLLVM_BUILD_LLVM_DYLIB=ON
    -DLLVM_BUILD_TESTS=ON
    -DLLVM_ENABLE_BINDINGS=OFF
    -DLLVM_ENABLE_CURL=ON
    -DLLVM_ENABLE_FFI=ON
    -DLLVM_ENABLE_RTTI=ON
    -DLLVM_ENABLE_SPHINX=ON
    -DLLVM_HOST_TRIPLE=$CHOST
    -DLLVM_INCLUDE_BENCHMARKS=OFF
    -DLLVM_INSTALL_GTEST=ON
    -DLLVM_INSTALL_UTILS=ON
    -DLLVM_LINK_LLVM_DYLIB=ON
    -DLLVM_USE_PERF=ON
    -DSPHINX_WARNINGS_AS_ERRORS=OFF
    -DPACKAGE_BUGREPORT=https://gitlab.archlinux.org/archlinux/packaging/packages/llvm/-/issues
  )

  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  cmake .. "${cmake_args[@]}"
  local distribution_components=$(_get_distribution_components | paste -sd\;)
  test -n "$distribution_components"

  # Build instrumented LLVM; LLVM_BUILD_INSTRUMENTED=IR adds
  # -fprofile-generate=<build>/profiles itself. Unittests and docs are
  # not needed for training, so skip them in this stage. Nothing gets
  # installed from here, so the distribution components are only passed
  # to the final build (they include docs targets).
  # Clang is only built here as training driver on top of the
  # instrumented libLLVM; it gets thrown away afterwards.
  cmake .. -DLLVM_BUILD_INSTRUMENTED=IR -DLLVM_USE_LINKER=lld -DLLVM_VP_COUNTERS_PER_SITE=6 \
    "${cmake_args[@]}" -DLLVM_BUILD_TESTS=OFF -DLLVM_BUILD_DOCS=OFF \
    -DLLVM_ENABLE_PROJECTS=clang -DCLANG_BUILD_TOOLS=OFF \
    -DCLANG_INCLUDE_TESTS=OFF -DCLANG_INCLUDE_DOCS=OFF
  ninja
  ninja clang

  # Drop profiles written by llvm-tblgen etc. during the build
  rm -f profiles/*.profraw

  # Run a subset of the LLVM lit tests; covers all backends (e.g. AMDGPU for
  # Mesa, BPF), the optimizer and the JIT, so they don't end up with zero
  # counts and get optimized as cold code
  ./bin/llvm-lit ../test/{CodeGen,Transforms,MC,ExecutionEngine} || true

  # Main workload: compile part of LLVM itself (middle-end + X86 backend)
  # with the instrumented clang and the regular package CFLAGS
  cmake -S .. -B ../build-train -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER="$PWD/bin/clang" \
    -DCMAKE_CXX_COMPILER="$PWD/bin/clang++" \
    -DCMAKE_OPTIMIZE_DEPENDENCIES=ON \
    -DLLVM_TARGETS_TO_BUILD=X86 \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    -DLLVM_INCLUDE_EXAMPLES=OFF \
    -DLLVM_INCLUDE_TESTS=OFF
  ninja -C ../build-train LLVMCore LLVMInstCombine LLVMScalarOpts LLVMX86CodeGen
  rm -rf ../build-train

  # Merge the generated profile
  local pgo_profile="$PWD/llvm.profdata"
  llvm-profdata merge -o "$pgo_profile" profiles/*.profraw

  # Make sure the training actually ran against the instrumented libLLVM
  # (InstCombine only lives there) and that the clang workload ran
  local _fn
  for _fn in InstCombinerImpl _ZN5clang; do
    if llvm-profdata show --function=$_fn "$pgo_profile" | grep -q '^Functions shown: 0$'; then
      echo "PGO profile has no data for $_fn, aborting" >&2
      return 1
    fi
  done

  cd ..
  mkdir build-pgo-use
  cd build-pgo-use
  # Use the profile and enable ThinLTO
  cmake .. -DLLVM_USE_LINKER=lld -DLLVM_ENABLE_LTO=Thin -DLLVM_PROFDATA_FILE="$pgo_profile" \
    "${cmake_args[@]}" -DLLVM_DISTRIBUTION_COMPONENTS="$distribution_components"
  ninja

  # Include lit for running lit-based tests in other projects
  pushd ../utils/lit
  python -m build --wheel --no-isolation
  popd
}

check() {
  cd llvm-project-$pkgver.src/llvm/build-pgo-use
  LD_LIBRARY_PATH=$PWD/lib ninja check
}

package_llvm() {
  pkgdesc="Compiler infrastructure"
  depends=('llvm-libs' 'curl' 'perl' 'libstdc++' 'glibc' 'libgcc')

  cd llvm-project-$pkgver.src/llvm/build-pgo-use

  DESTDIR="$pkgdir" ninja install-distribution

  # Include lit for running lit-based tests in other projects
  pushd ../utils/lit
  python -m installer --destdir="$pkgdir" dist/*.whl
  popd

  # The runtime libraries go into llvm-libs
  mv -f "$pkgdir"/usr/lib/lib{LLVM,LTO,Remarks}*.so* "$srcdir"
  mv -f "$pkgdir"/usr/lib/LLVMgold.so "$srcdir"

  # Remove documentation sources
  rm -r "$pkgdir"/usr/share/doc/llvm/html/{_sources,.buildinfo}

  install -Dm644 ../LICENSE.TXT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_llvm-libs() {
  pkgdesc="LLVM runtime libraries"
  depends=('libgcc' 'glibc' 'libstdc++' 'zlib' 'zstd' 'libffi' 'libedit' 'libxml2')
  provides=('libLLVM.so' 'libLTO.so' 'libRemarks.so')

  install -d "$pkgdir/usr/lib"
  cp -P \
    "$srcdir"/lib{LLVM,LTO,Remarks}*.so* \
    "$srcdir"/LLVMgold.so \
    "$pkgdir/usr/lib/"

  # Symlink LLVMgold.so from /usr/lib/bfd-plugins
  # https://bugs.archlinux.org/task/28479
  install -d "$pkgdir/usr/lib/bfd-plugins"
  ln -s ../LLVMgold.so "$pkgdir/usr/lib/bfd-plugins/LLVMgold.so"

  install -Dm644 "$srcdir/llvm-project-$pkgver.src/llvm/LICENSE.TXT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

