pkgname=cachyos-hypr-noctalia
pkgdesc='CachyOS Hyprland Noctalia settings'
pkgver=1.2.6
pkgrel=1
arch=('any')
url="https://github.com/cachyos/$pkgname"
license=(GPL-1.0-only)
makedepends=('coreutils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
sha256sums=('fc03b1f2ac8122e42aac2b4f1f077c6a8b787237b9572fdaf0811213816549a7')
backup=('var/lib/noctalia-greeter/greeter.toml')
depends=(
	adw-gtk-theme
	awesome-terminal-fonts
	brightnessctl
	cachyos-alacritty-config
	ddcutil
	curl
	dolphin
	gnome-calculator
	gnome-keyring
	gnome-text-editor
	grim
	hyprland
	hyprpicker
	kde-cli-tools
	kitty
	noctalia
	noto-fonts
	noto-fonts-emoji
	nwg-look
	python3
	qt6ct
	qview
	slurp
	swash
	uwsm
	wl-clipboard
	xdg-desktop-portal-hyprland
  	xorg-xhost
)
provides=('cachyos-desktop-settings')
conflicts=('cachyos-desktop-settings')

install=cachyos-hypr-noctalia.install
package() {
  cp -rf "$srcdir/$pkgname-$pkgver/etc" "$pkgdir"
  cp -rf "$srcdir/$pkgname-$pkgver/usr" "$pkgdir"
  cp -rf "$srcdir/$pkgname-$pkgver/var" "$pkgdir"
}
