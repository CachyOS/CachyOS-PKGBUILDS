# Maintainer: Norbert Preining <norbert@preining.info>
pkgname=intel-lpmd
pkgver=0.1.1
pkgrel=4
pkgdesc="Intel Low Power Mode Daemon"
arch=('x86_64')
url="https://github.com/cachyos/$pkgname"
license=('GPL-2.0-or-later')
backup=('etc/intel_lpmd/process_cpuset_user.xml')
makedepends=(
  git
  automake
  autoconf-archive
  gtk-doc
  glib2-devel
  systemd
)
depends=(
  glib2
  glibc
  libnl
  libxml2
  polkit
  systemd-libs
  upower
)
source=(git+${url}.git#commit=011a8bfc4c449a42ecff7a6cfaeabc545d7aa69d)
sha256sums=('10d4b9510a061ef9cb27f83792ae3fdad3d74ab371e1138f1d7d23ea8ebda9dd')

prepare() {
	cd "$pkgname"
	./autogen.sh prefix=/usr sysconfdir=/etc localstatedir=/var sbindir=/usr/bin
}

build() {
	cd "$pkgname"
	make
}

package() {
	cd "$pkgname"
	DESTDIR="$pkgdir" make install
	install -Dm 644 -t "${pkgdir}/usr/share/doc/${pkgname}" "$srcdir/${pkgname}"/README.md
	install -Dm 644 -t "${pkgdir}/usr/share/doc/${pkgname}" "$srcdir/${pkgname}"/doc/WLT_proxy.md
}
