# Maintainer: Norbert Preining <norbert@preining.info>
pkgname=intel-lpmd
pkgver=0.1.1
pkgrel=1
pkgdesc="Intel Low Power Mode Daemon"
arch=('x86_64')
url="https://github.com/cachyos/$pkgname"
license=('GPL-2.0-or-later')
backup=('etc/intel_lpmd/process_cpuset_user.xml')
makedepends=(
  git
  automake
  autoconf-archive
  gtk-doc
  glib2-devel
  systemd
)
depends=(
  glib2
  glibc
  libnl
  libxml2
  polkit
  systemd-libs
  upower
)
source=(git+${url}.git#commit=16b1efb5bd2da7c9cee89f0eeb0509326e7e2db7)
sha256sums=('d4b4f40c1fbcbe55868159b98e030b810ca3142aec370417636b9af105208d60')

prepare() {
	cd "$pkgname"
	./autogen.sh prefix=/usr sysconfdir=/etc sbindir=/usr/bin
}

build() {
	cd "$pkgname"
	make
}

package() {
	cd "$pkgname"
	DESTDIR="$pkgdir" make install
	install -Dm 644 -t "${pkgdir}/usr/share/doc/${pkgname}" "$srcdir/${pkgname}"/README.md
	install -Dm 644 -t "${pkgdir}/usr/share/doc/${pkgname}" "$srcdir/${pkgname}"/doc/WLT_proxy.md
}
