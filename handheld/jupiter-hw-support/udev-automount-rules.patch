diff --git a/usr/lib/udev/rules.d/99-holo-automount.rules b/usr/lib/udev/rules.d/99-holo-automount.rules
index 817c4d3..2e9ab3c 100644
--- a/usr/lib/udev/rules.d/99-holo-automount.rules
+++ b/usr/lib/udev/rules.d/99-holo-automount.rules
@@ -1,7 +1,11 @@
 # Originally from https://serverfault.com/a/767079
 # Run a mount script through systemd on any block device activity
 
-KERNEL!="mmcblk*|sd*|nvme*|vd*", GOTO="holo_automount_end"
+# Only automount SD cards and USB drives. The OS partition check below and in
+# block-device-event.sh relies on SteamOS partition names and partsets, which
+# CachyOS installs do not have, so internal NVMe and SATA drives must be skipped.
+KERNEL!="mmcblk*|sd*", GOTO="holo_automount_end"
+KERNEL=="sd*", ENV{ID_BUS}!="usb", GOTO="holo_automount_end"
 ENV{ID_FS_USAGE}!="filesystem", GOTO="holo_automount_end"
 
 # Skip partitions with labels used for the OS
