post_install() {
  cat <<'MSG'
mbp143-audio: the speakers come up through WirePlumber after
  systemctl --user restart pipewire pipewire-pulse wireplumber
or the next login (after a reboot, if the snd-hda-macbookpro driver was
installed with it). It acts on a MacBookPro14,3 only; anywhere else its
rules match nothing. Without the snd-hda-macbookpro driver there is no
sound card for it to act on.
MSG
}

post_upgrade() {
  echo 'mbp143-audio: restart pipewire, pipewire-pulse and wireplumber to load the new graph.'
}
