pkgname=cachyos-i3wm-settings
pkgdesc='CachyOS i3wm settings'
pkgver=1.0.5
pkgrel=2
arch=('any')
url="https://github.com/cachyos/$pkgname"
license=(GPL-1.0-only)
makedepends=('coreutils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
sha512sums=('64d9827d0a27a1436c6c5736cf80993417fc44f1cf6bd425b6a9988cc9465f8e95cc1e2763234f0e0ce1fc4103372c1e7429e3dec034545bf636ba50fc4169e8')
depends=('cachyos-zsh-config'
    'cachyos-alacritty-config'
    'cachyos-picom-config'
    'feh'
    'pamixer'
    'i3lock-color'
    'polkit-gnome'
    'dunst'
    'rofi'
    'jq'
    'polybar'
    'xob'
    'dex'
    'capitaine-cursors'
    'ttf-fantasque-nerd'
    'noto-fonts'
    'ttf-hack'
    'ttf-fira-sans')
install=$pkgname.install
provides=('cachyos-desktop-settings')
conflicts=('cachyos-desktop-settings')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"

  # Stop selecting the retired GTK theme; leave GTK defaults in effect.
  sed -i '/^gtk-theme-name=.*cachyos-nord/d' \
    etc/skel/.gtkrc-2.0 \
    etc/skel/.config/gtk-3.0/settings.ini
}

package() {
    install -d $pkgdir/etc
    cp -rf $srcdir/$pkgname-$pkgver/etc $pkgdir
}
