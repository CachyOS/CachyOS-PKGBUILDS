pkgname=cachyos-gaming-meta
pkgver=1.0.0
pkgrel=10
epoch=1
arch=(any)
pkgdesc='Meta package for Gaming dependencies'
depends=(
  alsa-plugins
  giflib
  glfw
  gst-plugins-base-libs
  lib32-alsa-plugins
  lib32-gtk3
  lib32-libjpeg-turbo
  lib32-libva
  lib32-ocl-icd
  lib32-opencl-icd-loader
  libjpeg-turbo
  libva
  libxslt
  mpg123
  opencl-icd-loader
  openal
  proton-cachyos-slr
  umu-launcher
  protontricks
  ttf-liberation
  wine-cachyos-opt
  winetricks
  vulkan-tools
)

source=(
  '99-splitlock.conf'
  '72-dstm.rules'
)
sha256sums=('76cded15c34773ab77672fba4bf3e00452256b09f9b58e59334b9b8848cddcba'
            'fa7865af53d9d85bbb0b9b97592c2e836c8c16975c6337cfd50d5a2340469478')

package() {
  install -Dm644 "${srcdir}/99-splitlock.conf" "${pkgdir}/usr/lib/sysctl.d/99-splitlock.conf"
  install -Dm644 "${srcdir}/72-dstm.rules" "${pkgdir}/usr/lib/udev/rules.d/72-dstm.rules"
}
