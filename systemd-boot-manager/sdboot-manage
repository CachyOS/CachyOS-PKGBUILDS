#!/usr/bin/env bash
#
# sdboot-manage provides automation for systemd-boot on systems with multiple kernels
set -euo pipefail

declare -r OVERRIDE_START="## ATTENTION! START OF SYSTEMD-BOOT-MANAGER GENERATED OVERRIDE, DO NOT EDIT"
declare -r OVERRIDE_END="## ATTENTION! END OF SYSTEMD-BOOT-MANAGER GENERATED OVERRIDE, DO NOT EDIT"

die() {
  echo -e "$@" >&2
  exit 1
}

usage() {
    cat << EOF
Usage: $0 [OPTIONS]... [ACTION]

Actions:
  gen     Generates entries for systemd-boot based on installed kernels
  remove  Removes orphaned systemd-boot entries
  setup   Installs systemd-boot and generate initial entries
  update  Updates systemd-boot

Options:
  -e,--esp-path=<path>  Specify <path> to be used for esp
  -c,--config=<path>    Location of config file
EOF
exit 0
}

# set defaults for optional arguments if they are not passed on the command-line
ESP="$(bootctl -p 2>/dev/null || echo /boot)"
config="/etc/sdboot-manage.conf"

# parse the options
for i in "$@"; do
    case $i in
    -e=* | --esp-path=*)
        ESP="${i#*=}"
        shift
        ;;
    -c=* | --config=*)
        config="${i#*=}"
        shift
        ;;
    # handle unknown options
    -*)
        usage
        ;;
    # printing usage is handled later
    *)
        true
        ;;
    esac
done

# config variables
export LINUX_OPTIONS="" \
    USE_UKI="no" \
    DEFAULT_ENTRY="manual" \
    KERNEL_PATTERN="vmlinuz-*" \
    REMOVE_EXISTING="yes" \
    OVERWRITE_EXISTING="no" \
    REMOVE_OBSOLETE="yes" \
    PRESERVE_FOREIGN="no" \
    NO_AUTOGEN="no" \
    NO_AUTOUPDATE="no" \
    INITRD_PREFIX=initramfs \
    INITRD_ENTRIES

[ -f "${config}" ] && . "${config}"

# Sources additional config files
# Firstly loads from /usr/lib/sdboot-manage.conf.d then /etc/sdboot-manage.conf.d
# Files should be loaded alphabetically
# These files are loaded after and therefore overwrite the main config use += if you want to append
for file in /usr/lib/sdboot-manage.conf.d/*.conf /etc/sdboot-manage.conf.d/*.conf; do
    #Source files if exists
    [ -f "${file}" ] && . "${file}"
done

get_entry_root() {
    echo -n "$ESP/loader/entries/"
}

get_installed_kernels() {
    LC_ALL=C.UTF-8 find /usr/lib/modules -maxdepth 2 -type f -regex ".*/pkgbase$" \
        | grep -Po "^/usr/lib/modules/\K(.*)(?=/pkgbase$)" \
        | uniq \
        | sort
}

check_preset() {
    local preset="/etc/mkinitcpio.d/${1}.preset"
    local -n start="$2" end="$3"

    if [ ! -e "${preset}" ]; then
        echo "Preset ${preset} not found"
        return 1
    fi

    start="$(grep -nx "${OVERRIDE_START}" "${preset}" | head -n1 | cut -d ':' -f 1 || echo -1)"
    end="$(grep -nx "${OVERRIDE_END}" "${preset}" | tail -n1 | cut -d ':' -f 1 || echo -1)"

    return $((!(end > 0 && start > 0 && end > start)))
}

# Workaround, to make sure that regular calls of mkinitcpio will create UKI
# images instead of default ones.
add_uki_in_preset() {
    local preset="/etc/mkinitcpio.d/${1}.preset"

    if [ ! -e "${preset}" ]; then
        echo "Preset ${preset} not found"
        return 1
    fi

    echo -e "\n${OVERRIDE_START}" >> "${preset}"
    cat <<< '
function _systemd_boot_manager_uki_override() {
    local pkgbase pkgver token esp

    [ -n "$ALL_kver" ] || return 0
    pkgbase="${ALL_kver##*/}"
    pkgbase="${pkgbase#vmlinuz-}"

    [ -n "$pkgbase" ] || return 0
    pkgver="$(grep -lx "$pkgbase" /usr/lib/modules/*/pkgbase)"
    pkgver="${pkgver%\/pkgbase}"
    pkgver="${pkgver##*/}"

    esp="$(bootctl -p 2>/dev/null || echo /boot)"
    token="$(cat /etc/kernel/entry-token 2>/dev/null || cat /etc/machine-id 2>/dev/null)"

    [ -n "$token" ] || return 0
    pkgbase="${pkgbase%vmlinuz-}"
    default_uki="${esp}/EFI/Linux/${token}-${pkgver}.efi"
    default_image=
    ALL_kver="/usr/lib/modules/${pkgver}/vmlinuz"
}

_systemd_boot_manager_uki_override
unset -f _systemd_boot_manager_uki_override
' >> "${preset}"
    echo "${OVERRIDE_END}" >> "${preset}"
}

# removes a systemd-boot entry
remove_entry() {
    [[ ${1} =~ ^$(get_entry_root "${ESP}").* || "${PRESERVE_FOREIGN,,}" != "yes" ]] && rm -f "$1"
}

# installs and configures systemd-boot
setup_sdboot() {
    if bootctl is-installed &>/dev/null; then
        die "systemd-boot already installed"
    fi

    # install systemd-boot
    bootctl --esp-path="${ESP}" install

    # create a simple loader.conf
    echo "timeout 3" > "${ESP}/loader/loader.conf"

    # generate entries, ensure an initial set of entries is generated
    [ "${DEFAULT_ENTRY}" != "oldest" ] && DEFAULT_ENTRY="latest"
    generate_entries
}

append_initrd_entries() {
    local kernel_entry="$1"
    local initrd="$2"

    for entry in "${INITRD_ENTRIES[@]}"; do
        echo "initrd $entry" >> "$kernel_entry"
    done

    echo "initrd ${initrd}" >> "$kernel_entry"
}

generate_cmdline() {
    srcdev="$(findmnt -no SOURCE /)"
    srcdev_uuid="$(findmnt -no UUID /)"
    srcdev_partuuid="$(findmnt -no PARTUUID /)"
    srcdev_fsroot="$(findmnt -no FSROOT /)"
    root_fstype="$(findmnt -no FSTYPE /)"

    if [ -n "$srcdev_uuid" ]; then
        sdoptions="root=UUID=${srcdev_uuid} rw"
    elif [ -n "$srcdev_partuuid" ]; then
        sdoptions="root=PARTUUID=${srcdev_partuuid} rw"
    else
        sdoptions="root=${srcdev} rw"
    fi

    # generate an appropriate options line
    case "${root_fstype}" in
        zfs)
            sdoptions="zfs=${srcdev} rw"
            ;;
        btrfs)
            sdoptions+=" rootflags=subvol=${srcdev_fsroot}"
            ;;
    esac

    # Search for a crypt device
    top_level_uuid="${srcdev_uuid}"
    # get the UUID for the crypt root - requires special handling for zfs
    if [ "${root_fstype}" = "zfs" ]; then
        zpool="${srcdev%%/*}"
        zpool_device="$(zpool status -LP "${zpool}" | grep "/dev/" | awk '{print $1}')"
        top_level_uuid="$(lsblk -no UUID "${zpool_device}")"
    fi

    # now that we have the UUID search all the devices above it to find a cryptroot
    while read -r devname devtype; do
        if [ "$devtype" = "crypt" ]; then
            # handle cryptdevice
            cryptdevice_uuid="$(blkid -o value -s UUID "$(cryptsetup status "${devname}" | grep device | awk '{print $2}')")"
            if grep -q '^HOOKS=\(.*sd-encrypt.*\)$' /etc/mkinitcpio.conf 2>/dev/null; then
                sdoptions+=" rd.luks.name=${cryptdevice_uuid}=${devname}"
            else
                sdoptions+=" cryptdevice=UUID=${cryptdevice_uuid}:${devname}"
            fi
        fi
    done < <(lsblk -nslo NAME,TYPE /dev/disk/by-uuid/"${top_level_uuid}" 2>/dev/null)

    echo "${sdoptions} ${LINUX_OPTIONS}"
}

generate_uki_entries() {
    local machine kernel pkgver token entry uki entry_root uki_staging preset_copy
    local -i _start _end
    local -i preset_created=0
    local -i rebuild=0
    local -i failed=0

    if [ ! -e /etc/kernel/entry-token ]; then
        machine="$(cat /etc/machine-id || echo "")"
        [ -n "$machine" ] && echo "$machine" > /etc/kernel/entry-token
    fi

    token="$(cat /etc/kernel/entry-token 2>/dev/null || cat /etc/machine-id 2>/dev/null)"
    entry_root="$(get_entry_root "$ESP")"

    # Remove stale staging files from an interrupted previous run.
    rm -f -- "${ESP}"/EFI/Linux/.sdboot-manage-new.* \
        "${ESP}"/EFI/Linux/.sdboot-manage-preset.* 2>/dev/null || true

    # Create presets for each installed kernel and build its UKI
    while read -r pkgver; do
        kernel="$(cat "/usr/lib/modules/${pkgver}/pkgbase")"
        entry="${entry_root}/${kernel}.conf"
        fallback_entry="${entry_root}/${kernel}-fallback.conf"
        uki="${ESP}/EFI/Linux/${token}-${pkgver}.efi"
        preset_created=0

        if ! check_preset "${kernel}" _start _end; then
            if add_uki_in_preset "${kernel}"; then
                preset_created=1
            fi
        fi

        # On the first switch, always regenerate. A preexisting image must not
        # authorize deleting the regular boot path without verification.
        rebuild=0
        if ((preset_created)) || [[ "${REBUILD_UKI:-no}" = "yes" || ! -e "${uki}" ]]; then
            rebuild=1
        fi

        # Generate to a non-.efi staging path. The old UKI stays at its
        # original path until a non-empty replacement is verified.
        if ((rebuild)); then
            uki_staging="${ESP}/EFI/Linux/.sdboot-manage-new.$$"
            preset_copy="${ESP}/EFI/Linux/.sdboot-manage-preset.$$"
            rm -f -- "${uki_staging}" "${preset_copy}"
            if ! cp -f "/etc/mkinitcpio.d/${kernel}.preset" "${preset_copy}"; then
                echo "Error: failed to stage preset for ${kernel}, preserving existing boot entries" >&2
                failed=1
                continue
            fi
            printf '\ndefault_uki="%s"\ndefault_image=\n' "${uki_staging}" >>"${preset_copy}"
            if ! mkinitcpio -p "${preset_copy}"; then
                rm -f -- "${uki_staging}" "${preset_copy}"
                echo "Error: failed to generate UKI for ${kernel}, preserving existing boot entries" >&2
                failed=1
                continue
            fi
            if [[ ! -s "${uki_staging}" ]]; then
                rm -f -- "${uki_staging}" "${preset_copy}"
                echo "Error: UKI ${uki_staging} is missing or empty, preserving existing boot entries" >&2
                failed=1
                continue
            fi
            if ! mv -f -- "${uki_staging}" "${uki}"; then
                rm -f -- "${uki_staging}" "${preset_copy}"
                echo "Error: failed to install ${uki}, preserving existing boot entries" >&2
                failed=1
                continue
            fi
            rm -f -- "${preset_copy}"
        fi

        # A failed or interrupted generation can leave an empty or partial UKI.
        # Never drop the regular boot path unless this run produced a usable UKI.
        if [[ ! -s "${uki}" ]]; then
            echo "Error: UKI ${uki} is missing or empty, preserving existing boot entries" >&2
            failed=1
            continue
        fi

        # Remove existing entries to not create duplicates with UKI
        if ((preset_created)); then
            rm -f "${ESP}/initramfs-${kernel}.img" "${ESP}/vmlinuz-${kernel}" || true
            remove_entry "${entry}" || true

            # Drop leftovers from older versions
            remove_entry "${fallback_entry}" || true
        fi
    done < <(get_installed_kernels)

    if ((failed)); then
        die "Error: failed to generate one or more UKI images"
    fi

    if ! compgen -G "${ESP}/EFI/Linux/*.efi" >/dev/null; then
        die "Error: There are no UKI images after entry generation"
    fi
}

entry_references_valid() {
    local entry_file="$1" name="$2" linux_path initrd_path
    local -i initrd_count=0

    linux_path="$(awk '$1 == "linux" { print $2; exit }' "${entry_file}")"
    [[ -n "${linux_path}" ]] || return 1
    [[ "${linux_path}" == /* ]] || linux_path="/${linux_path}"
    case "/${linux_path#/}/" in
        *"/../"*) return 1 ;;
    esac
    [[ "${linux_path##*/}" == "vmlinuz-${name}" ]] || return 1
    [[ -s "${ESP}${linux_path}" ]] || return 1

    while read -r _ initrd_path; do
        [[ -n "${initrd_path}" ]] || continue
        initrd_count+=1
        [[ "${initrd_path}" == /* ]] || initrd_path="/${initrd_path}"
        case "/${initrd_path#/}/" in
            *"/../"*) return 1 ;;
        esac
        [[ -s "${ESP}${initrd_path}" ]] || return 1
    done < <(awk '$1 == "initrd" { print $1, $2 }' "${entry_file}")

    ((initrd_count > 0)) || return 1
    return 0
}

generate_regular_entries() {
    local cmdline pkgver kernel entry entry_root entry_path initramfs title kernelpath tmp final
    local -a staged_files=() staged_finals=()
    local -A new_entries=()
    local -i override_start override_end
    local -i failed=0
    local -i available=0

    # First, ensure we have a valid config
    if [ ! -f "${ESP}/loader/loader.conf" ]; then
        die "Error: ${ESP}/loader/loader.conf does not exist"
    fi

    # only build entries if there is some place to put them
    if [ ! -d "${ESP}/loader/entries" ]; then
        die "Error: ${ESP}/loader/entries does not exist"
    fi

    if [[ -s "/etc/kernel/cmdline" ]]; then
        cmdline="$(cat /etc/kernel/cmdline)"
    fi

    # Fallback
    if [[ -z "${cmdline:-}" ]]; then
        cmdline="$(generate_cmdline)"
    else
        cmdline="${cmdline} ${LINUX_OPTIONS}"
    fi

    # Remove UKI presets if any
    while read -r pkgver; do
        kernel="$(cat "/usr/lib/modules/${pkgver}/pkgbase")"

        # Regenerate initramfs if preset was changed before
        if check_preset "${kernel}" override_start override_end; then
            # Keep the UKI as a fallback. Removing it before the regular boot
            # path was proven was the bug; verified removal is a follow-up.
            if ! echo "/usr/lib/modules/${pkgver}/" | /usr/share/libalpm/scripts/depmod; then
                echo "Error: depmod failed for ${kernel}, preserving UKI" >&2
                failed=1
                continue
            fi

            sed -i "$((override_start)),$((override_end))d" "/etc/mkinitcpio.d/${kernel}.preset"

            if [[ ! -s "${ESP}/vmlinuz-${kernel}" || ! -s "${ESP}/${INITRD_PREFIX}-${kernel}.img" ]]; then
                if ! echo "/usr/lib/modules/${pkgver}/vmlinuz" | /usr/share/libalpm/scripts/mkinitcpio install; then
                    echo "Error: failed to regenerate regular images for ${kernel}, preserving UKI" >&2
                    if ! add_uki_in_preset "${kernel}"; then
                        echo "Error: failed to restore UKI preset override for ${kernel}" >&2
                    fi
                    failed=1
                    continue
                fi
            fi

            if [[ ! -s "${ESP}/vmlinuz-${kernel}" || ! -s "${ESP}/${INITRD_PREFIX}-${kernel}.img" ]]; then
                echo "Error: regular images for ${kernel} are missing or empty, preserving UKI" >&2
                if ! add_uki_in_preset "${kernel}"; then
                    echo "Error: failed to restore UKI preset override for ${kernel}" >&2
                fi
                failed=1
                continue
            fi
        fi
    done < <(get_installed_kernels)

    # Stage every new entry before touching the existing ones. If any write
    # fails, the old entries (including a rescue entry) remain untouched.
    while read -r kernel; do
        entry="${kernel##*/}"
        entry="${entry#vmlinuz-}"
        entry_root="$(get_entry_root "$ESP")"
        entry_path="${entry_root}${entry}"
        initramfs="${kernel//vmlinuz/${INITRD_PREFIX}}"

        # first validate we don't already have an entry for this kernel
        if [[ "${OVERWRITE_EXISTING,,}" != "yes" && -f "${entry_path}.conf" ]]; then
            if entry_references_valid "${entry_path}.conf" "${entry}"; then
                new_entries["${entry_path}.conf"]=1
                available+=1
                continue
            fi
            echo "Error: existing entry ${entry_path}.conf is not usable; preserving existing entries" >&2
            failed=1
            continue
        fi

        # generate entry title (WIP)
        title="$(echo -e "$entry" | sed -e 's/-/ /g' -e 's/\b\(.\)/\u\1/g')"
        title="${title/\//}"
        title="${title//Rt/(Realtime)}"
        title="${title//Cachyos/CachyOS}"

        # get the kernel location so the initrd can be written to the same location as the kernel
        [[ $(dirname "$kernel") == "/" ]] && kernelpath="" || kernelpath="$(dirname "$kernel")"

        # Do not stage an entry that points to a missing or empty initramfs.
        if [[ ! -s "${ESP}${kernelpath}${initramfs}.img" ]]; then
            echo "Warning: no usable initramfs for ${kernel}, preserving existing entries" >&2
            failed=1
            continue
        fi

        tmp="${entry_path}.conf.sdboot-manage-new.$$"
        rm -f -- "${tmp}"
        if ! printf 'title %s\noptions %s\nlinux %s\n' "${title}" "${cmdline}" "${kernel}" >"${tmp}"; then
            echo "Error: failed to write staged entry for ${kernel}, preserving existing entries" >&2
            rm -f -- "${tmp}"
            failed=1
            continue
        fi
        if ! append_initrd_entries "${tmp}" "${kernelpath}${initramfs}.img"; then
            echo "Error: failed to append initrd for ${kernel}, preserving existing entries" >&2
            rm -f -- "${tmp}"
            failed=1
            continue
        fi
        if [[ ! -s "${tmp}" ]]; then
            echo "Error: staged entry for ${kernel} is empty, preserving existing entries" >&2
            rm -f -- "${tmp}"
            failed=1
            continue
        fi

        staged_files+=("${tmp}")
        staged_finals+=("${entry_path}.conf")
        available+=1
    done < <(LC_ALL=C.UTF-8 find "${ESP}" -maxdepth 1 -type f -name "${KERNEL_PATTERN}" -printf "/%P\n")

    if ((available == 0)) && [ "${REMOVE_EXISTING,,}" = "yes" ]; then
        echo "Error: no usable regular entries were generated; preserving existing entries" >&2
        failed=1
    fi

    # Install the validated entries. A failed install leaves the old entries
    # and the rescue entry in place because cleanup has not run yet.
    if ((failed == 0)); then
        local -i i
        for i in "${!staged_files[@]}"; do
            final="${staged_finals[$i]}"
            if ! mv -f -- "${staged_files[$i]}" "${final}"; then
                echo "Error: failed to install ${final}, preserving existing entries" >&2
                failed=1
                break
            fi
            new_entries["${final}"]=1
        done
    fi

    # Only now, after every new entry is in place, honor REMOVE_EXISTING.
    if ((failed == 0)) && [ "${REMOVE_EXISTING,,}" = "yes" ] && ((available > 0)); then
        while read -r entry; do
            [[ -n "${new_entries["${entry}"]+x}" ]] || remove_entry "${entry}"
        done < <(LC_ALL=C.UTF-8 find "${ESP}/loader/entries" -type f -name "*.conf")
    fi

    for tmp in "${staged_files[@]}"; do
        [[ -e "${tmp}" ]] && rm -f -- "${tmp}"
    done

    if ((failed)); then
        die "Error: failed to regenerate one or more regular boot images"
    fi

    if [ -z "$(ls -A "${ESP}/loader/entries")" ]; then
        die "Error: There are no boot loader entries after entry generation"
    fi
}

generate_entries() {
    if [[ "${USE_UKI,,}" = "yes" ]]; then
        generate_uki_entries
    else
        generate_regular_entries
    fi
}

# removes entries for kernels which are no longer installed
remove_orphan_entries() {
    [[ "${REMOVE_OBSOLETE,,}" != "yes" ]] && return

    # find and remove all the entries with unmatched kernels
    for kernel in $(comm -13 <(LC_ALL=C.UTF-8 find "${ESP}" -maxdepth 2 -type f -name "${KERNEL_PATTERN}" -printf "/%P\n" \
            | uniq | sort) <(cat "${ESP}"/loader/entries/* | grep -i "^linux" | awk '{print $2}' \
            | uniq | sort)); do
        while read -r entry; do
            local kerneldir="${entry%.*}"
            if [ ! -d "/usr/src/${kerneldir##*/}" ]; then
                remove_entry "${entry}"
            fi
        done < <(grep -l "${kernel}" "${ESP}"/loader/entries/*)
    done
}

# make sure we are root
if [ "$EUID" -ne 0 ]; then
    die "sdboot-manage must be run as root"
fi

if ! bootctl status &>/dev/null && [ "$1" != "setup" ]; then
    die "systemd-boot not installed\nTry sdboot-manage setup to install"
fi

case "${1:-}" in
    autogen)
        [ "${NO_AUTOGEN,,}" != "yes" ] && generate_entries
        ;;
    autoupdate)
        [ "${NO_AUTOUPDATE,,}" != "yes" ] && bootctl --esp-path="${ESP}" update
        ;;
    gen)
        REBUILD_UKI="yes" generate_entries
        ;;
    remove)
        remove_orphan_entries
        ;;
    setup)
        setup_sdboot
        ;;
    update)
        bootctl --esp-path="${ESP}" update
        ;;
    *)
        usage
        ;;
esac

exit 0
