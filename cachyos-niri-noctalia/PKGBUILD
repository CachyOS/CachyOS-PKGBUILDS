pkgname=cachyos-niri-noctalia
pkgdesc='CachyOS Niri (+Noctalia) settings'
pkgver=1.4.0
pkgrel=1
arch=('any')
url="https://github.com/cachyos/$pkgname"
license=(GPL-3.0-only)
makedepends=('coreutils' 'git')
source=(git+$url#tag=${pkgver})
sha512sums=('cbecb424b8b26e4cc4f5fcca563c459524891d720a2789ef2ec101f7d2cc582cb4d53003cd43e036dd4fe3f5d06a47b28e25955d3c92b197c7ee30aca7dddedb')
depends=(
  adw-gtk-theme
  cachyos-alacritty-config
  capitaine-cursors
  gnome-keyring
  niri
  noctalia
  noto-fonts
  noto-fonts-emoji
  wl-clipboard
  xdg-desktop-portal-gnome
  xdg-desktop-portal-gtk
  xwayland-satellite
)
provides=('cachyos-desktop-settings')
conflicts=('cachyos-desktop-settings')

package() {
  install -d "${pkgdir}/etc"
  cp -rf "${srcdir}/${pkgname}/etc" "${pkgdir}"
}
