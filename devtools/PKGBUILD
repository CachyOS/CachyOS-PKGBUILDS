prepare() {
  cd ${pkgname}-${pkgver}

  # makechrootpkg: add paccache flag
  patch -Np1 -i ../3892c591abc18a0cae03c600ff1ce410d12cf070.patch

  # makechrootpkg: add -V to build with private net
  patch -Np1 -i ../b0ed72249d22bfa927de2ce4c8ca639add3657cb.patch

  # makechrootpkg: suppress networkd verbose output
  patch -Np1 -i ../33db0fc2f09ad048c7610bde58f9e17ec6d0a938.patch
}

build() {
  cd ${pkgname}-${pkgver}
  make BUILDTOOLVER="${epoch}:${pkgver}-${pkgrel}-${arch}" PREFIX=/usr
}

check() {
  cd ${pkgname}-${pkgver}
  make PREFIX=/usr test
}

package() {
  cd ${pkgname}-${pkgver}
  make PREFIX=/usr DESTDIR="${pkgdir}" install
}

