post_install() {
  cat <<'EOF'
lsfg-vk requires Lossless Scaling from Steam, with its "lsfg-vk" beta branch selected.
Configure it using lsfg-vk-ui, then run lsfg-vk-cli validate as your normal user.
Setup instructions: https://lsfg-vk.dev/docs/getting-started/
EOF
}

post_upgrade() {
  if (( $(vercmp "$2" '1:2.0.0-1') < 0 )); then
    cat <<'EOF'
lsfg-vk 2.0 uses a new configuration format; the version 1 configuration is incompatible.
Run lsfg-vk-cli healthcheck as your normal user to check for leftover manual installations.
EOF
    post_install
  fi
}
