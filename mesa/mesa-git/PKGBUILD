# Maintainer: Peter Jung <admin@ptr1337.dev>
# Originally based on AUR pkgbuilds from Lone_Wolf <lonewolf at xs4all dot nl> - https://aur.archlinux.org/packages/mesa-git/ - https://aur.archlinux.org/packages/lib32-mesa-git/
# and on mesa-git from Tk-Glitch <ti3nou at gmail dot com>

_where="${_where:-$PWD}"

source "$_where"/customization.cfg

# Optional overrides of customization.cfg values
if [[ -e "$_where/mesa-userpatches/user.cfg" ]]; then
  source "$_where/mesa-userpatches/user.cfg"
elif [[ -e "$_EXT_CONFIG_PATH" ]]; then
  source "$_EXT_CONFIG_PATH"
fi

pkgname=('mesa-git')
[[ $_lib32 == true ]] && pkgname+=('lib32-mesa-git')
pkgver=0
pkgrel=1
pkgdesc="Open-source OpenGL drivers, git version"
arch=('x86_64')
url="https://www.mesa3d.org"
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')
makedepends=('cbindgen' 'clang' 'cmake' 'elfutils' 'expat' 'git' 'glslang' 'libclc'
             'libdisplay-info' 'libdrm' 'libglvnd' 'libva' 'libx11' 'libxcb' 'libxdamage'
             'libxext' 'libxml2' 'libxrandr' 'libxshmfence' 'libxxf86vm' 'llvm' 'lm_sensors' 'meson'
             'python-mako' 'python-packaging' 'python-ply' 'python-pycparser' 'python-yaml'
             'rust' 'rust-bindgen' 'spirv-llvm-translator' 'spirv-tools' 'systemd-libs'
             'valgrind' 'vulkan-icd-loader' 'wayland' 'wayland-protocols' 'xcb-util-keysyms'
             'xorgproto' 'zlib' 'zstd')
if [[ $_lib32 == true ]]; then
  makedepends+=('lib32-expat' 'lib32-gcc-libs' 'lib32-libdisplay-info' 'lib32-libdrm' 'lib32-libelf'
                'lib32-clang' 'lib32-libglvnd' 'lib32-libva' 'lib32-libx11' 'lib32-libxcb' 'lib32-libxdamage'
                'lib32-libxext' 'lib32-libxml2' 'lib32-libxrandr' 'lib32-libxshmfence'
                'lib32-libxxf86vm' 'lib32-llvm' 'lib32-lm_sensors' 'lib32-rust-libs' 'lib32-spirv-llvm-translator'
                'lib32-spirv-tools' 'lib32-systemd' 'lib32-vulkan-icd-loader' 'lib32-wayland'
                'lib32-xcb-util-keysyms' 'lib32-zlib' 'lib32-zstd')
fi
optdepends=('opengl-man-pages: for the OpenGL API man pages')

options=('!debug')
_debug_re='(^|[[:space:]])(--buildtype[=[:space:]]+|-D[[:space:]]*buildtype=)debug([[:space:]]|$)'
if [[ $_additional_meson_flags =~ $_debug_re ]]; then
  options=('debug' '!strip')
fi
[[ $_lto != true ]] && options+=('!lto')

_mesa_srcdir="mesa"
# In-tree build dirs: bindgen's output_inline_wrapper emits broken #include paths when
# the build directory is a sibling of the source tree (meson#13227, mesa#11178).
_build64="${_mesa_srcdir}/_build64"
_build32="${_mesa_srcdir}/_build32"

if [[ -n $_mesa_commit ]]; then
  _mesa_ref="#commit=${_mesa_commit}"
else
  _mesa_ref="#branch=${_mesa_branch}"
fi

source=("mesa::git+${_mesa_source}${_mesa_ref}"
        'LICENSE'
        'llvm32.native')
b2sums=('SKIP'
        'cc60238726b35133b5b729fb4ed1e76e04136588533615d84b4a54656d5b41727d5e7ff06ef4de3eb102eed6669d6c5c5cb8ac9fbdf6fc25aa477877c5c3ba87'
        '0f3a4ab5dc94adca1824e6634edfbef616f127eba78c1e4ad42b015f31412ffdf14e8ae25e4e7e071057ed667799a5d7e8b9b3227c002c12735d9c64e47940ab')

pkgver() {
  cd "$_mesa_srcdir"
  local _ver=$(<VERSION)
  echo "${_ver/-/_}.$(git rev-list --count HEAD).$(git rev-parse --short HEAD)"
}

_apply_userpatches() {
  local _reverts=() _patches=() _p _ans

  shopt -s nullglob
  _reverts=("$_where"/mesa-userpatches/*.mymesarevert "$_where"/*.mymesarevert)
  _patches=("$_where"/mesa-userpatches/*.mymesapatch "$_where"/*.mymesapatch)
  shopt -u nullglob

  # Community patches (https://github.com/Frogging-Family/community-patches)
  if [[ -n $_community_patches ]]; then
    local _cpdir="$_where/../community-patches"
    [[ -d $_cpdir ]] || git clone https://github.com/Frogging-Family/community-patches.git "$_cpdir"
    for _p in $_community_patches; do
      case $_p in
        *.mymesarevert) _reverts+=("$_cpdir/mesa-git/$_p") ;;
        *)              _patches+=("$_cpdir/mesa-git/$_p") ;;
      esac
    done
  fi

  # Pending merge requests
  for _p in $_mesa_prs; do
    curl -fL -o "$srcdir/mr-$_p.mymesapatch" \
      "https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/$_p.diff"
    _patches+=("$srcdir/mr-$_p.mymesapatch")
  done

  (( ${#_reverts[@]} + ${#_patches[@]} )) || return 0

  if [[ $_user_patches_no_confirm != true ]]; then
    msg2 "Found userpatches:"
    printf '    %s\n' "${_reverts[@]/#/revert: }" "${_patches[@]/#/apply:  }"
    read -rp "Apply them? - Be careful with that ;) [y/N] " _ans
    [[ $_ans == [yY] ]] || return 0
  fi

  for _p in "${_reverts[@]}"; do
    msg2 "Reverting ${_p##*/}"
    patch -Np1 -R -i "$_p"
    echo "Reverted ${_p}" >> "$_where"/last_build_config.log
  done
  for _p in "${_patches[@]}"; do
    msg2 "Applying ${_p##*/}"
    patch -Np1 -i "$_p"
    echo "Applied ${_p}" >> "$_where"/last_build_config.log
  done
}

prepare() {
  cd "$_mesa_srcdir"
  git reset --hard HEAD
  git clean -xdf -e /_build64 -e /_build32

  {
    echo -e "# Last ${pkgbase:-mesa-git} ${pkgver} configuration - $(date):\n"
    echo "Gallium drivers: ${_gallium_drivers}"
    echo -e "Vulkan drivers: ${_vulkan_drivers}\n"
  } > "$_where"/last_build_config.log

  [[ $_user_patches == true ]] && _apply_userpatches

  # Done here rather than in build() to respect makepkg --noextract
  cd "$srcdir"
  if [[ $_NUKR != false ]]; then
    local _dir
    for _dir in "$_build64" "$_build32"; do
      [[ -d $_dir ]] || continue
      if [[ $_additional_meson_flags =~ b_pgo=use ]]; then
        find "$_dir" -type f ! -name '*.gcda' -delete
      else
        rm -rf "$_dir"
      fi
    done
  fi
}

build() {
  if [[ -n $_custom_opt_flags ]]; then
    export CFLAGS="$_custom_opt_flags"
    export CXXFLAGS="$_custom_opt_flags"
  fi

  local _cc=gcc _cxx=g++
  if [[ $_compiler == clang ]]; then
    _cc=clang _cxx=clang++
  elif [[ -n $CUSTOM_GCC_PATH ]]; then
    msg2 "CUSTOM_GCC_PATH = ${CUSTOM_GCC_PATH}"
    export PATH="$CUSTOM_GCC_PATH/bin:$PATH"
  fi

  local _lto_flags=(-D b_lto=false)
  if [[ $_lto == true ]]; then
    _lto_flags=(-D b_lto=true)
    [[ $_compiler != clang ]] && warning "LTO with GCC is known to cause issues with mesa. Consider using Clang instead."
    # LTO hits `too many open files` with low limits
    ulimit -Sn 4096
  fi

  local _gallium_va=enabled
  if [[ ! $_gallium_drivers =~ r600|radeonsi|nouveau ]]; then
    warning "Gallium VA disabled (gallium driver r600, radeonsi or nouveau required)"
    _gallium_va=disabled
  fi

  local _layers=device-select,overlay
  [[ $_antilag == true ]] && _layers+=,anti-lag

  local _intel_rt=disabled
  [[ ,$_vulkan_drivers, == *,intel,* ]] && _intel_rt=enabled

  # shellcheck disable=SC2054
  local _meson_common=(
    --wrap-mode=nofallback
    --force-fallback-for=syn,paste,rustc-hash
    -D android-libbacktrace=disabled
    -D b_ndebug=true
    -D egl=enabled
    -D gallium-drivers="$_gallium_drivers"
    -D gallium-extra-hud=true
    -D gallium-mediafoundation=disabled
    -D gallium-va=$_gallium_va
    -D gbm=enabled
    -D gles1=disabled
    -D gles2=enabled
    -D glvnd=enabled
    -D glx=dri
    -D libunwind=disabled
    -D llvm=enabled
    -D lmsensors=enabled
    -D microsoft-clc=disabled
    -D opengl=true
    -D platforms=x11,wayland
    -D video-codecs="$_codecs"
    -D vulkan-layers="$_layers"
    -D zstd=enabled
  )

  export CC="$_cc" CXX="$_cxx"

  arch-meson "$_mesa_srcdir" "$_build64" \
    "${_meson_common[@]}" \
    "${_lto_flags[@]}" \
    -D gallium-rusticl="$_rusticl" \
    -D intel-rt=$_intel_rt \
    -D valgrind=enabled \
    -D vulkan-drivers="$_vulkan_drivers" \
    $_additional_meson_flags $_additional_meson_flags_64

  meson configure "$_build64" --no-pager
  ninja $NINJAFLAGS -C "$_build64"

  [[ $_lib32 == true ]] || return 0

  local _vulkan_drivers32=$_vulkan_drivers _rusticl32 _crossfile
  if [[ $_rusticl32_bypass == true ]]; then
    _rusticl32=$_rusticl
    _crossfile=(--cross-file lib32)
    if [[ $_compiler == clang ]]; then
      warning "LTO forcefully disabled on lib32 because _rusticl32_bypass=\"true\""
      _lto_flags=(-D b_lto=false)
    fi
  else
    _rusticl32=false
    _crossfile=(--native-file "$srcdir/llvm32.native")
    # lib32 nvk fails with the native file
    warning "lib32 nvk forcefully disabled because _rusticl32_bypass=\"false\""
    _vulkan_drivers32=${_vulkan_drivers32//,nouveau/}
  fi

  export CC="$_cc -m32" CXX="$_cxx -m32"
  export PKG_CONFIG=/usr/bin/i686-pc-linux-gnu-pkg-config
  export BINDGEN_EXTRA_CLANG_ARGS="--target=i686-unknown-linux-gnu"

  arch-meson "$_mesa_srcdir" "$_build32" \
    "${_crossfile[@]}" \
    --libdir=/usr/lib32 \
    "${_meson_common[@]}" \
    "${_lto_flags[@]}" \
    -D gallium-rusticl="$_rusticl32" \
    -D intel-rt=disabled \
    -D valgrind=disabled \
    -D vulkan-drivers="$_vulkan_drivers32" \
    $_additional_meson_flags $_additional_meson_flags_32

  meson configure "$_build32" --no-pager
  ninja $NINJAFLAGS -C "$_build32"
}

package_mesa-git() {
  depends=('expat' 'glibc' 'libdisplay-info' 'libdrm' 'libelf' 'libgcc' 'libglvnd' 'libstdc++'
           'libx11' 'libxcb' 'libxext' 'libxshmfence' 'libxxf86vm' 'lm_sensors' 'spirv-tools'
           'llvm-libs' 'systemd-libs' 'vulkan-icd-loader' 'wayland' 'xcb-util-keysyms' 'zlib' 'zstd')
  if [[ $_rusticl == true ]]; then
    depends+=('clang' 'libclc' 'spirv-llvm-translator')
  fi
  provides=("mesa=$pkgver-$pkgrel"
            "opencl-mesa=$pkgver-$pkgrel"
            "libva-mesa-driver=$pkgver-$pkgrel"
            "mesa-libgl=$pkgver-$pkgrel"
            "vulkan-intel=$pkgver-$pkgrel"
            "vulkan-radeon=$pkgver-$pkgrel"
            "vulkan-nouveau=$pkgver-$pkgrel"
            "vulkan-swrast=$pkgver-$pkgrel"
            "vulkan-mesa-layers=$pkgver-$pkgrel"
            "vulkan-mesa-implicit-layers=$pkgver-$pkgrel"
            "vulkan-mesa-device-select=$pkgver-$pkgrel"
            "mesa-vulkan-layers=$pkgver-$pkgrel"
            'libva-driver' 'opencl-driver' 'opengl-driver' 'vulkan-driver')
  conflicts=('mesa' 'opencl-mesa' 'libva-mesa-driver'
             'vulkan-intel' 'vulkan-radeon' 'vulkan-nouveau' 'vulkan-swrast'
             'vulkan-mesa-layers' 'vulkan-mesa-implicit-layers' 'vulkan-mesa-device-select'
             'mesa-vulkan-layers')

  DESTDIR="$pkgdir" ninja $NINJAFLAGS -C "$_build64" install

  # https://gitlab.freedesktop.org/mesa/mesa/issues/2230
  rm -f "$pkgdir"/usr/bin/mesa-overlay-control.py

  # indirect rendering
  ln -s /usr/lib/libGLX_mesa.so.0 "$pkgdir"/usr/lib/libGLX_indirect.so.0

  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}

package_lib32-mesa-git() {
  depends=('lib32-expat' 'lib32-gcc-libs' 'lib32-glibc' 'lib32-libdisplay-info' 'lib32-libdrm'
           'lib32-libelf' 'lib32-libglvnd' 'lib32-libx11' 'lib32-libxcb' 'lib32-libxext'
           'lib32-libxshmfence' 'lib32-libxxf86vm' 'lib32-lm_sensors' 'lib32-spirv-tools'
           'lib32-systemd' 'lib32-vulkan-icd-loader' 'lib32-wayland' 'lib32-xcb-util-keysyms'
           'lib32-llvm-libs' 'lib32-zlib' 'lib32-zstd' 'mesa')
  if [[ $_rusticl == true && $_rusticl32_bypass == true ]]; then
    depends+=('lib32-clang' 'lib32-spirv-llvm-translator')
  fi
  provides=("lib32-mesa=$pkgver-$pkgrel"
            "lib32-opencl-mesa=$pkgver-$pkgrel"
            "lib32-libva-mesa-driver=$pkgver-$pkgrel"
            "lib32-mesa-libgl=$pkgver-$pkgrel"
            "lib32-vulkan-intel=$pkgver-$pkgrel"
            "lib32-vulkan-radeon=$pkgver-$pkgrel"
            "lib32-vulkan-nouveau=$pkgver-$pkgrel"
            "lib32-vulkan-swrast=$pkgver-$pkgrel"
            "lib32-vulkan-mesa-layers=$pkgver-$pkgrel"
            "lib32-vulkan-mesa-implicit-layers=$pkgver-$pkgrel"
            "lib32-vulkan-mesa-device-select=$pkgver-$pkgrel"
            "lib32-mesa-vulkan-layers=$pkgver-$pkgrel"
            'lib32-libva-driver' 'lib32-opencl-driver' 'lib32-opengl-driver' 'lib32-vulkan-driver')
  conflicts=('lib32-mesa' 'lib32-opencl-mesa' 'lib32-libva-mesa-driver'
             'lib32-vulkan-intel' 'lib32-vulkan-radeon' 'lib32-vulkan-nouveau' 'lib32-vulkan-swrast'
             'lib32-vulkan-mesa-layers' 'lib32-vulkan-mesa-implicit-layers'
             'lib32-vulkan-mesa-device-select' 'lib32-mesa-vulkan-layers')

  DESTDIR="$pkgdir" ninja $NINJAFLAGS -C "$_build32" install

  # Files provided by mesa-git
  rm -rf "$pkgdir"/etc \
         "$pkgdir"/usr/bin \
         "$pkgdir"/usr/include \
         "$pkgdir"/usr/share/glvnd \
         "$pkgdir"/usr/share/drirc.d \
         "$pkgdir"/usr/share/vulkan/explicit_layer.d \
         "$pkgdir"/usr/share/vulkan/implicit_layer.d/VkLayer_MESA_{device_select,anti_lag}.json

  # indirect rendering
  ln -s /usr/lib32/libGLX_mesa.so.0 "$pkgdir"/usr/lib32/libGLX_indirect.so.0

  install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
