# Maintainer: loathingkernel at cachyos dot org

pkgname=rare-bin
pkgver=1.12.0.221
pkgrel=1
pkgdesc="Open source alternative for Epic Games Launcher, using Legendary"
arch=('any')
url="https://github.com/RareDevs/Rare"
license=('GPL3')
depends=(
  gcc-libs
)
makedepends=(
)
optdepends=(
  "wine: run Windows games"
  "proton: run Windows games"
)
provides=(${pkgname%-bin})
conflicts=(${pkgname%-bin})
source=("https://github.com/RareDevs/Rare/releases/download/${pkgver}/Rare-${pkgver}-x86_64-linux.zip"
        "https://raw.githubusercontent.com/RareDevs/Rare/refs/tags/${pkgver}/packaging/rare.desktop"
        rare.sh)
sha256sums=('99ba873e8985a81b405deb1b2765d6f978e14eaeab86ce87f91ede3839074881'
            'c7b0339bdb57ff147580757b86fa8c07777a9e26e7e166f4bb6f8c5092918b6d'
            '175c6284247bd9f40b2057d80a33498f8b54d1249468bbb2d0c26b497f912e43')

package() {
  cd Rare-$pkgver-x86_64-linux
  install -Dm755 "$srcdir/rare.sh" "$pkgdir/usr/bin/rare"
  install -Dm644 "$srcdir/${pkgname%-bin}.desktop" "$pkgdir/usr/share/applications/${pkgname%-bin}.desktop"
  install -Dm644 "rare/resources/images/Rare.png" "$pkgdir/usr/share/pixmaps/${pkgname%-bin}.png"
  find . -type f -exec install -Dm 644 "{}" "$pkgdir/opt/rare/{}" \;
  chmod 755 "$pkgdir/opt/rare/Rare.bin"
}

