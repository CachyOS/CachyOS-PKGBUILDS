# Maintainer: Vladislav Nepogodin <vnepogodin@cachyos.org>
# Maintainer: Peter Jung <ptr1337@cachyos.org>

pkgname=cachyos-packageinstaller
pkgver=2.0.0
pkgrel=1
pkgdesc="Small app store for CachyOS: install, remove and update packages, with AUR support"
arch=(aarch64 x86_64)
url="https://github.com/cachyos/packageinstaller"
license=(GPL-3.0-or-later)
depends=(
  'appstream-qt'
  'archlinux-appstream-data'
  'glibc'
  'hicolor-icon-theme'
  'kimageformats'
  'libelf'
  'libgcc' 'libgcc_s.so'
  'libjxl'
  'libstdc++' 'libstdc++.so'
  'pacman' 'libalpm.so'
  'polkit'
  'qt6-base'
  'qt6-declarative'
)
makedepends=(
  'clang'
  'cmake'
  'git'
  'lld'
  'llvm'
  'ninja'
  'qt6-tools'
  'vulkan-headers'
)
optdepends=(
  'paru: build packages from the AUR'
  'git: review and build packages from the AUR'
  'flatpak: install Flatpak apps'
  'fuse2: start most AppImages'
  'pacman-contrib: see updates without refreshing the system databases'
  'cachyos-rate-mirrors: rank the mirrors by speed from the settings'
  'vulkan-icd-loader: render with Vulkan instead of OpenGL'
)
groups=('cachyos')
source=("packageinstaller::git+$url.git#tag=v${pkgver}?signed")
sha256sums=('82941879cc5439dab745774d01dc97a5c23f2406ab70a66d893ce472eba5813c')
validpgpkeys=(
  'B1B70BB1CD56047DEF31DE2EB62C3D10C54D5DA9'  # Vladislav Nepogodin <nepogodin.vlad@gmail.com>
)

build() {
  cd ${srcdir}/packageinstaller

  # keep CPM's downloads of rapidyaml, fmt, spdlog and backward-cpp in $srcdir
  export CPM_SOURCE_CACHE="${srcdir}/cpm"

  # we are building with llvm stack here
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  cmake -S . -Bbuild \
        -GNinja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build --parallel
}

package() {
  cd ${srcdir}/packageinstaller

  # we are building with llvm stack here
  export AR=llvm-ar
  export CC=clang
  export CXX=clang++
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 THIRD-PARTY.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY.md"
}

