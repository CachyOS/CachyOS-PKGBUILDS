# Maintainer: Natalie Vock <natalie dot vock at gmx dot de>

pkgbase=kcgroups
pkgname=('kcgroups' 'plasma-foreground-booster')
_tag=dmemcg-experimental
_kcgroups_commit=d106f1c8f44c1f231a9050b2bf82a34bb7d5db32
_booster_commit=0553351dd13af58dcfccff52c930cc9bf719d928
pkgver=0.0.${_tag//-/.}
pkgrel=5
pkgdesc="KDE library to manipulate cgroups (and boost foreground apps)"
arch=('x86_64')
url="https://invent.kde.org/libraries/kcgroups.git"
license=('LGPL-2.1-or-later')
makedepends=('qt6-base' 'plasma-workspace' 'kwindowsystem' 'kconfig' 'kdbusaddons' 'cmake' 'extra-cmake-modules' 'git')
source=("kcgroups::git+https://github.com/pixelcluster/kcgroups.git#commit=${_kcgroups_commit}"
	"plasma-foreground-booster::git+https://github.com/pixelcluster/kcgroups.git#commit=${_booster_commit}")
sha256sums=('fc231c52a9a0b135870b73ce51849a64ea84f80eb8f921c0c0d85af8e12fde28'
            'c1a8cca3ee3522019955d5a62a84d02fb1200287d2dd0eaaeb7166160c048845')

prepare() {
  mkdir -p kcgroups-build
  mkdir -p kcgroups-install
  mkdir -p plasma-foreground-booster-build

  # Order after kwin_wayland like the other plasma-workspace.target services,
  # otherwise it can start before WAYLAND_DISPLAY exists and abort in
  # QGuiApplication (no platform plugin). After=graphical-session.target was
  # dropped upstream to break an ordering cycle, but left no ordering at all.
  sed -i '/^PartOf=graphical-session.target/a After=plasma-core.target' \
    plasma-foreground-booster/plasma-foreground-booster.service.in
}

build () {
    cd kcgroups-build
    cmake ../kcgroups \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DBUILD_WITH_QT6=ON
    make
    # HACK: plasma-foreground-booster needs an install of kcgroups to build.
    # Install it to a temporary directory inside the build area.
    make DESTDIR="../kcgroups-install" install

    cd ../plasma-foreground-booster-build
    CMAKE_PREFIX_PATH=../kcgroups-install/usr \
    cmake ../plasma-foreground-booster \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo
    make
}

package_kcgroups() {
    depends=('qt6-base' 'kwindowsystem' 'kconfig' 'kdbusaddons')
    provides=('kcgroups-dmemcg')
    cd "kcgroups-build"
    make DESTDIR="${pkgdir}" install
}

package_plasma-foreground-booster() {
    provides=('plasma-foreground-booster-dmemcg')
    depends=('kcgroups')
    cd "plasma-foreground-booster-build"
    make DESTDIR="${pkgdir}" install
}
